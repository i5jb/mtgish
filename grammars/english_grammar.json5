    "You gain {{Digits}} life for each {{Eachable}}. Prevent all combat damage that would be dealt this turn by {{Creatures}}": "ActionList([GainLifeForEach({{Digits[0]}}, {{Eachable[0]}}), CreatePreventDamageUntil(CombatDamageWouldBeDealtByACreature({{Creatures[0]}}), [PreventThatDamage], UntilEndOfTurn)])",
    "You gain {{Digits}} life for each {{Eachable}}. Prevent all damage that would be dealt to you this turn": "ActionList([GainLifeForEach({{Digits[0]}}, {{Eachable[0]}}), CreatePreventDamageUntil(DamageWouldBeDealtToRecipient(Player(You)), [PreventThatDamage], UntilEndOfTurn)])",
    "You gain {{Digits}} life for each {{Permanent}} target opponent controls": "Targeted([TargetPlayer(Opponent)], ActionList([GainLifeForEach({{Digits[0]}}, TheNumberOfPermanentsOnTheBattlefield(And([{{Permanent[0]}}, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))])))]))",
    "You gain {{Digits}} life for each {{Permanent}} target player controls": "Targeted([TargetPlayer(AnyPlayer)], ActionList([GainLifeForEach({{Digits[0]}}, TheNumberOfPermanentsOnTheBattlefield(And([{{Permanent[0]}}, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))])))]))",
