  "{{TriggerActions[WhenAPlayerTapsAPermanentForMana](~Permanent)}}": {
    "that player adds one mana of any type that land produced, and this enchantment deals {{Digits}} damage to the player": "ActionList([AddMana(Trigger_AnyManaTypeProduced), PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Player(Trigger_ThatPlayer))])"
  },
  "{{TriggerActions[WhenAPlayerTapsAPermanentForMana]}}": {
    "that player adds one mana of any type that land produced": "ActionList([PlayerAction(Trigger_ThatPlayer, AddMana(Trigger_AnyManaTypeProduced))])",
    "that player adds one mana of any type that land produced. That land doesn't untap during its controller's next untap step": "ActionList([PlayerAction(Trigger_ThatPlayer, AddMana(Trigger_AnyManaTypeProduced)), PermanentDoesntUntapDuringControllersNextUntap(Trigger_ThatPermanent)])",
    "that player adds one mana of any type that land produced. Then that land deals {{Digits}} damage to that player": "ActionList([PlayerAction(Trigger_ThatPlayer, AddMana(Trigger_AnyManaTypeProduced)), PermanentDealsDamage(Trigger_ThatPermanent, {{Digits[0]}}, Player(Trigger_ThatPlayer))])",
    "that player adds one mana of any type that permanent produced": "ActionList([PlayerAction(Trigger_ThatPlayer, AddMana(Trigger_AnyManaTypeProduced))])"
  },
  "{{TriggerActions[WhenASourceDealsDamage](~Permanent)}}": {
    "that source's controller gains control of this creature": "ActionList([PlayerAction(Trigger_ControllerOfThatSource, GainControlOfPermanent({{~Permanent}}))])",
    "you may have this creature deal {{Digits}} damage to that source's controller": "ActionList([MayAction(HavePermanentDealDamage({{~Permanent}}, {{Digits[0]}}, Player(Trigger_ControllerOfThatSource)))])"
  },
  "{{TriggerActions[WhenASourceDealsDamage]}}": {
    "that source's controller exiles a card from their hand at random. If it's {{a}} {{SpecificCard}}, you may put it onto the battlefield under your control. Otherwise, you may cast it without paying its mana cost": "ActionList([PlayerAction(Trigger_ControllerOfThatSource, ExileACardFromHandAtRandom), IfElse(ACardWasExiledThisWay({{SpecificCard[0]}}), [MayAction(PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersUnderPlayersControl(You)]))], [MayAction(CastExiledCardWithoutPaying(TheCardExiledThisWay))])])",
    "that source's controller gets a poison counter": "ActionList([PlayerAction(Trigger_ControllerOfThatSource, GetAPoisonCounter)])",
    "that source's controller loses that much life unless they sacrifice that many {{Permanents}} of their choice": "ActionList([PlayerMayCost(Trigger_ControllerOfThatSource, SacrificeNumberPermanents(Trigger_ThatMuch, {{Permanents[0]}})), Unless(CostWasPaid, [PlayerAction(Trigger_ControllerOfThatSource, LoseLife(Trigger_ThatMuch))])])",
    "that source's controller loses {{Digits}} life unless they pay {{ManaCost}}": "ActionList([PlayerMayCost(Trigger_ControllerOfThatSource, PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [PlayerAction(Trigger_ControllerOfThatSource, LoseLife({{Digits[0]}}))])])",
    "that source's controller mills that many cards": "ActionList([PlayerAction(Trigger_ControllerOfThatSource, MillNumberCards(Trigger_ThatMuch))])",
    "that source's controller sacrifices that many {{Permanents}} of their choice": "ActionList([PlayerAction(Trigger_ControllerOfThatSource, SacrificeNumberPermanents(Trigger_ThatMuch, {{Permanents[0]}}))])"
  },
  "{{TriggerActions[WhenASpellOrAbilityCausesAPermanentToBePutIntoAGraveyard]}}": {
    "return that card to the battlefield": "ActionList([PutGraveyardCardOntoBattlefield(Trigger_ThatGraveyardCard, [EntersNormally])])"
  },
