    "Whenever {{a}} {{Creature}} other than {{~Permanent}} attacks or dies, {{TriggerActions(~Permanent,ThatCreature)}}": "TriggerA(Or([WhenACreatureAttacks(And([Other({{~Permanent}}), {{Creature[0]}}])), WhenACreatureOrPlaneswalkerDies(And([Other({{~Permanent}}), {{Creature[0]}}]))]), {{TriggerActions(~Permanent=^~Permanent,ThatCreature=Trigger_ThatCreature)[0]}})",
    "Whenever {{a}} {{DamageSource(~Permanent)}} deals damage to an opponent, {{TriggerActions(~Permanent)}}": "TriggerA(WhenASourceDealsDamageToAPlayer({{DamageSource(~Permanent=^~Permanent)[0]}}, Opponent), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
