    "Search your library for a creature or land card and reveal it. Put it onto the battlefield tapped if it's a land card. Otherwise, put it into your hand. Then shuffle": "ActionList([SearchLibrary([FindACardOfType(Or([IsCardtype(Creature), IsCardtype(Land)])), RevealFoundCards, IfElse(ACardOfTypeWasFoundThisWay(IsCardtype(Land)), [PutFoundCardsOntoBattlefield([EntersTapped])], [PutFoundCardsIntoHand]), Shuffle])])",
    "Search your library for a creature, instant, or sorcery card with mana value less than or equal to {{GameNumber[ThisSpell]}}, exile that card, then shuffle. You may cast that card without paying its mana cost": "ActionList([SearchLibrary([FindACardOfType(And([Or([IsCardtype(Creature), IsCardtype(Instant), IsCardtype(Sorcery)]), ManaValueIs(LessThanOrEqualTo({{GameNumber[ThisSpell][0]}}))])), ExileFoundCards, Shuffle]), MayAction(CastSpellFromExileWithoutPaying(AnySpell, TheCardExiledThisWay))])",
    "Search your library for a land card of each basic land type, put those cards onto the battlefield, then shuffle": "ActionList([SearchLibrary([FindAnyNumberOfGroupCards(IsCardtype(Land), EachBasicLandType), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle])])",
    "Search your library for a permanent card with the same name as target {{Permanent}}, put that card onto the battlefield, then shuffle": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([SearchLibrary([FindACardOfType(And([IsPermanent, SharesANameWithPermanent(Ref_TargetPermanent)])), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle])]))",
    "Search your library for an instant card with mana value 3, reveal it, and put it into your hand. Then repeat this process for instant cards with mana values 2 and 1. Then shuffle": "ActionList([SearchLibrary([FindCardsOfType([And([IsCardtype(Instant), ManaValueIs(EqualTo(Integer(3)))]), And([IsCardtype(Instant), ManaValueIs(EqualTo(Integer(2)))]), And([IsCardtype(Instant), ManaValueIs(EqualTo(Integer(1)))])]), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])",
