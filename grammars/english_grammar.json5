    "When this creature becomes the target of a spell or ability an opponent controls, you may exile this creature, then return it to the battlefield under its owner's control": "TriggerA(WhenAPermanentBecomesTheTargetOfASpellOrAbility(SinglePermanent(ThisPermanent), ControlledByAPlayer(Opponent)), ActionList([MayCost(ExilePermanent(ThisPermanent)), If(CostWasPaid, [PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersUnderOwnersControl])])]))",
    "When this creature becomes the target of a spell or ability, {{TriggerActions(ThatPermanent)}}": "TriggerA(WhenAPermanentBecomesTheTargetOfASpellOrAbility(SinglePermanent(ThisPermanent), AnySpellOrAbility), {{TriggerActions(ThatPermanent=Trigger_ThatPermanent)[0]}})",
    "When this creature deals combat damage to a player, sacrifice it": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(ThisPermanent), AnyPlayer), ActionList([SacrificePermanent(Trigger_ThatPermanent)]))",
    "When this creature deals combat damage to a player, you may have it deal damage equal to its power to target creature that player controls": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(ThisPermanent), AnyPlayer), Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(Trigger_ThatPlayer))]))], ActionList([MayAction(HavePermanentDealDamage(Trigger_ThatCreature, PowerOfPermanent(Trigger_ThatCreature), Permanent(Ref_TargetPermanent)))])))",
    "When this creature deals combat damage, sacrifice it": "TriggerA(WhenACreatureDealsCombatDamage(SinglePermanent(ThisPermanent)), ActionList([SacrificePermanent(Trigger_ThatPermanent)]))",
    "When this creature dies or is put into exile from the battlefield, return it to its owner's hand": "TriggerModalA([TriggerAndActions(WhenACreatureOrPlaneswalkerDies(SinglePermanent(ThisPermanent)), ActionList([PutGraveyardCardIntoHand(Trigger_ThatGraveyardCard)])), TriggerAndActions(WhenAPermanentIsExiled(SinglePermanent(ThisPermanent)), ActionList([PutExiledCardIntoOwnersHand(Trigger_ThatExiledCard)]))])",
    "When this creature dies or is put into exile, return it to its owner's hand and create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}}": "TriggerA(WhenACreatureOrPlaneswalkerDies(SinglePermanent(ThisPermanent)), ActionList([ReturnDeadGraveyardCardToHand, CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])])])), TriggerA(WhenAPermanentIsExiled(SinglePermanent(ThisPermanent)), ActionList([PutExiledCardIntoOwnersHand(Trigger_ThatExiledCard), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])])]))",
    "When this creature dies, put a number of {{CounterType}} counters equal to its power on up to one target {{Permanent}}": "TriggerA(WhenACreatureOrPlaneswalkerDies(SinglePermanent(ThisPermanent)), Targeted([UptoOneTargetPermanent({{Permanent[0]}})], ActionList([PutNumberCountersOfTypeOnPermanent(PowerOfPermanent(Trigger_ThatPermanent), {{CounterType[0]}}, Ref_TargetPermanent)])))",
    "When this creature dies, you may pay {{ManaCost}}. If you do, return this card to the battlefield under your control": "TriggerA(WhenACreatureOrPlaneswalkerDies(SinglePermanent(ThisPermanent)), ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [ReturnDeadGraveyardCardToBattlefield([EntersUnderPlayersControl(You)])])]))",
    "When this creature dies, you may put X {{CounterType}} counters on target {{Permanent}}, where X is this creature's power": "TriggerA(WhenACreatureOrPlaneswalkerDies(SinglePermanent(ThisPermanent)), Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreateValueX(PowerOfDeadPermanent), MayAction(PutNumberCountersOfTypeOnPermanent(ValueX, {{CounterType[0]}}, Ref_TargetPermanent))])))",
