    "This spell costs {{CostReduce}} less to cast": "CastEffect(ReduceCastingCost({{CostReduce[0]}}))",
    "This spell costs {{ManaCost}} more to cast": "CastEffect(AdditionalCastingCost(PayMana({{ManaCost[0]}})))",
    "When this card leaves your graveyard, {{TriggerActions}}": "FromGraveyard(TriggerA(WhenAGraveyardCardLeaves(SingleGraveyardCard(ThisGraveyardCard)), {{TriggerActions[0]}}))",
    "When this creature dies, you may shuffle it into its owner's library if it's in your graveyard. If you do, investigate": "TriggerA(WhenACreatureOrPlaneswalkerDies(SinglePermanent(ThisPermanent)), ActionList([MayCost(ShuffleGraveyardCardIntoLibrary(Trigger_ThatGraveyardCard)), If(CostWasPaid, [Investigate])]))",
    "When this creature dies, {{TriggerActions}}": "TriggerA(WhenACreatureOrPlaneswalkerDies(SinglePermanent(ThisPermanent)), {{TriggerActions[0]}})",
    "When this creature enters, {{TriggerActions}}": "TriggerA(WhenAPermanentEntersTheBattlefield(SinglePermanent(ThisPermanent)), {{TriggerActions[0]}})",
    "When this land enters, {{TriggerActions}}": "TriggerA(WhenAPermanentEntersTheBattlefield(SinglePermanent(ThisPermanent)), {{TriggerActions[0]}})",
    "When this permanent enters, exile target {{Permanent}} until this permanent leaves the battlefield": "TriggerA(WhenAPermanentEntersTheBattlefield(SinglePermanent(ThisPermanent)), Targeted([TargetPermanent({{Permanent[0]}})], ActionList([ExilePermanentUntil(Ref_TargetPermanent, UntilPermanentLeavesBattlefield(ThisPermanent))])))",
    "When this permanent enters, {{TriggerActions}}": "TriggerA(WhenAPermanentEntersTheBattlefield(SinglePermanent(ThisPermanent)), {{TriggerActions[0]}})",
    "When you cast this spell, create a Treasure token and this spell perpetually loses this ability": "FromStack(TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), SingleSpell(ThisSpell)), ActionList([CreateTokens([TreasureToken]), CreatePerpetualSpellEffect(ThisSpell, [LosesAbility(ThisAbility)])])))",
    "When you cast this spell, it deals {{Digits}} damage to each opponent": "FromStack(TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), SingleSpell(ThisSpell)), ActionList([SpellDealsDamage(ThisSpell, {{Digits[0]}}, EachPlayer(Opponent))])))",
    "When you cast this spell, {{TriggerActions}}": "FromStack(TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), SingleSpell(ThisSpell)), {{TriggerActions[0]}}))",
    "When you cast this spell, {{TriggerActions(ThatSpell)}}": "FromStack(TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), SingleSpell(ThisSpell)), {{TriggerActions(ThatSpell=Trigger_ThatSpell)[0]}}))",
    "Whenever a creature you control with greater mana value than this card dies, return this card from your graveyard to the battlefield tapped": "FromGraveyard(TriggerA(WhenACreatureOrPlaneswalkerDies(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), ManaValueIs(GreaterThanOrEqualTo(ManaValueOfGraveyardCard(ThisGraveyardCard)))])), ActionList([PutGraveyardCardOntoBattlefield(ThisGraveyardCard, [EntersTapped])])))",
    "Whenever an equipped creature you control deals combat damage to a player or planeswalker, return this card from your graveyard to the battlefield tapped": "FromGraveyard(TriggerA(Or([WhenACreatureDealsCombatDamageToAPlayer(And([IsEquipped, IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]), AnyPlayer), WhenACreatureDealsCombatDamageToAPermanent(And([IsEquipped, IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]), AnyPermanent)]), ActionList([PutGraveyardCardOntoBattlefield(ThisGraveyardCard, [EntersTapped])])))",
    "Whenever this creature becomes the target of a spell or ability, draw a card. This ability triggers only once each turn": "TriggerOnceEachTurn(WhenAPermanentBecomesTheTargetOfASpellOrAbility(SinglePermanent(ThisPermanent), AnySpellOrAbility), ActionList([DrawACard]))",
    "Whenever this creature deals combat damage to a player, you may cast target {{SpecificCard}} from your graveyard without paying its mana cost. If you do, this creature perpetually loses this ability": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(ThisPermanent), AnyPlayer), Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([MayCost(CastGraveyardCardWithoutPaying(Ref_TargetGraveyardCard)), If(CostWasPaid, [CreatePerpetualPermanentEffect(ThisPermanent, [LosesAbility(ThisAbility)])])])))",
    "Whenever this land becomes tapped, {{TriggerActions}}": "TriggerA(WhenAPermanentBecomesTapped(SinglePermanent(ThisPermanent)), {{TriggerActions[0]}})",
    "Whenever this land is tapped for mana, add an additional {{ManaProduceSymbol}}": "TriggerA(WhenAPermanentIsTappedForMana(SinglePermanent(ThisPermanent)), ActionList([AddMana({{ManaProduceSymbol[0]}})]))",
    "You may pay {{ManaCostX}} rather than pay this spell's mana cost, where X is its mana value": "CastEffect(AlternateCastingCost(PayManaX({{ManaCostX[0]}}, ManaValueOfSpell(ThisSpell))))",
    "You may pay {{ManaCost}} rather than pay this spell's mana cost": "CastEffect(AlternateCastingCost(PayMana({{ManaCost[0]}})))",
    "You may spend mana as though it were mana of any color to cast this spell": "CastEffect(MaySpendManaAsThoughAnyColorToCast)",
    "{{Creatures}} get {{PTMod}}": "EachPermanentLayerEffect({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})])",
    "{{EnchantedCreature}} gets {{PTMod}}": "PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}})])",
    "{{ManaCost}}, Exile this artifact: {{ActivatedActions}}": "Activated(And([PayMana({{ManaCost[0]}}), ExilePermanent(ThisPermanent)]), {{ActivatedActions[0]}})",
    "{{ManaCost}}, Exile this card from your graveyard: Create {{a}} {{PTX}} {{CreatureToken}}, where X is this card's power. Activate only as a sorcery": "FromGraveyard(ActivatedWithModifiers(And([PayMana({{ManaCost[0]}}), ExileGraveyardCard(ThisGraveyardCard)]), ActionList([CreateTokens([TokenWithPT(PTX({{PTX[0]}}, PowerOfTheExiledCreature), {{CreatureToken[0]}}, [])])]), ActivateOnlyAsASorcery))",
    "{{ManaCost}}, Exile this card from your graveyard: Shuffle it into its owner's library. Create a token that's a copy of it, except it's {{a}} {{PT}} {{Black}} {{Zombie}} in addition to its other types. Activate only as a sorcery": "FromGraveyard(ActivatedWithModifiers(And([PayMana({{ManaCost[0]}}), ExileGraveyardCard(ThisGraveyardCard)]), ActionList([ShuffleExiledCardIntoLibrary(TheCardExiledThisWay), CreateTokens([TokenCopyOfExiledCard(TheCardExiledThisWay, TokenCopyEffects([SetPT({{PT[0]}}), AddColor(SimpleColorList([{{Black[0]}}])), AddCreatureTypes([{{Zombie[0]}}])]))])]), ActivateOnlyAsASorcery))",
    "{{ManaCost}}, Sacrifice this permanent: {{ActivatedActions}}": "Activated(And([PayMana({{ManaCost[0]}}), SacrificePermanent(ThisPermanent)]), {{ActivatedActions[0]}})",
    "{{ManaCost}}, {{TapSelfCost}}, Sacrifice this creature: {{ActivatedActions}}": "Activated(And([PayMana({{ManaCost[0]}}), {{TapSelfCost[0]}}, SacrificePermanent(ThisPermanent)]), {{ActivatedActions[0]}})",
    "{{ManaCost}}, {{TapSelfCost}}, Sacrifice this land: {{ActivatedActions}}": "Activated(And([PayMana({{ManaCost[0]}}), {{TapSelfCost[0]}}, SacrificePermanent(ThisPermanent)]), {{ActivatedActions[0]}})",
    "{{ManaCost}}: Untap this creature": "Activated(PayMana({{ManaCost[0]}}), ActionList([UntapPermanent(ThisPermanent)]))",
    "{{TapSelfCost}}: Add {{ManaProduceSymbol}}{{ManaProduceSymbol}}": "Activated({{TapSelfCost[0]}}, ActionList([AddMana(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}]))]))"
