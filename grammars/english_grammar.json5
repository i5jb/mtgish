    "Whenever {{a}} {{Zombie}} you control attacks, if {{~Permanent}} attacked this combat, target {{Creature}} blocks that {{Zombie}} this combat if able": "TriggerI(WhenACreatureAttacks(And([IsCreatureType({{Zombie[0]}}), ControlledByAPlayer(SinglePlayer(You))])), PermanentPassesFilter({{~Permanent}}, AttackedThisCombat), Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [MustBlockAttacker(Trigger_ThatPermanent)], UntilEndOfCombat)])))",
    "Whenever {{~Permanent}} and at least one other {{Permanent}} attack, {{TriggerActions}}": "TriggerA(WhenASingleCreatureAndANumberOfOtherCreaturesAttack({{~Permanent}}, GreaterThanOrEqualTo(Integer(1)), {{Permanent[0]}}), {{TriggerActions[0]}})",
    "Whenever {{~Permanent}} and at least one {{Creature}} attack, {{TriggerActions(~Permanent)}}": "TriggerA(WhenASingleCreatureAndANumberOfOtherCreaturesAttack({{~Permanent}}, GreaterThanOrEqualTo(Integer(1)), {{Creature[0]}}), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
