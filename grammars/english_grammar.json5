    "Whenever you attack with one or more {{Creatures}}, this Case deals that much damage divided as you choose among any number of targets": "TriggerA(WhenAPlayerAttacksWithAnyNumberOfCreatures(SinglePlayer(You), {{Creatures[0]}}), TargetedDistributed([AnyNumberOfAnyTargets], DistributeNumberAmongTargets(Trigger_ThatMuch), ActionList([PermanentDealsDistributedDamage(ThisPermanent)])))",
    "You may look at the top card of your library any time and you may play lands and cast {{PotentialSpells}} from the top of your library": "PlayerEffect(You, [MayLookAtTopCardOfLibraryAnyTime, MayPlayLandsFromTopOfLibrary(AnyCard), MayCastSpellsFromTopOfLibrary({{PotentialSpells[0]}})])",
    "You may look at the top card of your library any time, and you may play lands and cast {{PotentialSpells}} from the top of your library": "PlayerEffect(You, [MayLookAtTopCardOfLibraryAnyTime, MayPlayLandsFromTopOfLibrary(AnyCard), MayCastSpellsFromTopOfLibrary({{PotentialSpells[0]}})])",
    "{{Creatures}} get {{PTMod}}": "EachPermanentLayerEffect({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})])",
