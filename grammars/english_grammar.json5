    "As long as {{ThisPermanent}} is attached to a creature, the first time you would create one or more tokens each turn, you may instead create that many tokens that are copies of equipped creature": "If(PermanentPassesFilter(ThisPermanent, AttachedToAPermanent(IsCardtype(Creature))), [ReplaceAPlayerWouldCreateTokens(APlayerWouldCreateTokensForTheFirstTimeEachTurn(SinglePlayer(You), AnyPermanent), [ChooseAnAction([[CreateTokensInstead([NumberTokens(WouldCreateTokens_NumberTokens, TokenCopyOfPermanent(HostPermanent, NoTokenCopyEffects))])], [CreateTokensInstead([ThoseTokens])]])])])",
    "As long as {{a}} {{SpecificCard}} with {{CheckHasable}} is in a graveyard, this creature has {{Hasable}}. The same is true for {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, and {{CheckHasable}}": "PermanentLayerEffect({{~Permanent}}, [AddAbilityFromCardsInAPlayersGraveyardHasable({{SpecificCard[0]}}, AnyPlayer, [{{CheckHasable[0]}}, {{CheckHasable[1]}}, {{CheckHasable[2]}}, {{CheckHasable[3]}}, {{CheckHasable[4]}}, {{CheckHasable[5]}}, {{CheckHasable[6]}}, {{CheckHasable[7]}}, {{CheckHasable[8]}}, {{CheckHasable[9]}}, {{CheckHasable[10]}}, {{CheckHasable[11]}}, {{CheckHasable[12]}}])])",
    "As long as {{~Permanent}} is attached to a creature, {{~Permanent}} can't be attacked and has \"Whenever equipped creature deals combat damage during your turn, put that many {{CounterType}} counters on {{~Permanent}}\"": "If(PermanentPassesFilter(ThisPermanent, AttachedToAPermanent(IsCardtype(Creature))), [PermanentRuleEffect(ThisPermanent, [PlaneswalkerCantBeAttacked]), PermanentLayerEffect(ThisPermanent, [AddAbility([TriggerA(If(IsPlayersTurn(You), WhenACreatureDealsCombatDamage(SinglePermanent(HostPermanent))), ActionList([PutNumberCountersOfTypeOnPermanent(Trigger_ThatMuch, {{CounterType[0]}}, ThisPermanent)]))])])])",
    "As long as {{~Permanent}} is on the battlefield, it has all activated abilities of all {{SpecificCards}} in your graveyard": "PermanentLayerEffect({{~Permanent}}, [AddAbilityFromCardsInPlayersGraveyardHasable({{SpecificCards[0]}}, You, [ActivatedAbility])])",
    "As long as {{~Permanent}} is paired with another creature, each of those creatures has \"{{QuotedAbility}}\"": "If(PermanentPassesFilter({{~Permanent}}, IsPaired), [EachPermanentLayerEffect(Or([SinglePermanent({{~Permanent}}), SinglePermanent(TheCreaturePairedWithPermanent({{~Permanent}}))]), [AddAbility([{{QuotedAbility[0]}}])])])",
    "Creatures with power greater than this creature's power can't block it": "EachPermanentRuleEffect(And([IsCardtype(Creature), PowerIs(GreaterThan(PowerOfPermanent({{~Permanent}})))]), [CantBlockAttacker({{~Permanent}})])",
    "Creatures with power less than this creature's power can't block it": "EachPermanentRuleEffect(And([IsCardtype(Creature), PowerIs(LessThan(PowerOfPermanent({{~Permanent}})))]), [CantBlockAttacker({{~Permanent}})])",
    "Creatures with power less than this creature's power can't block {{Creatures}}": "EachPermanentRuleEffect(And([IsCardtype(Creature), PowerIs(LessThan(PowerOfPermanent({{~Permanent}})))]), [CantBlockAttackers({{Creatures[0]}})])",
    "Damage that would be dealt by this creature can't be prevented": "DamageFromPermanentCantBePrevented({{~Permanent}})",
    "Double all damage {{~Permanent}} would deal": "ReplaceWouldDealDamage(DamageWouldBeDealtByPermanent({{~Permanent}}), [DealDamageInstead(Twice(WouldDealDamage_ThatMuchDamage))])",
    "During each player's turn, that player may cast a spell from among the cards they don't own exiled with {{~Permanent}}, and mana of any type can be spent to cast it": "EachPlayerEffect(AnyPlayer, [MayCastASpellFromAmongExiledCardsAndMaySpendManaAsThoughAnyColorToCastOnceEachPlayersTurn(AnySpell, And([OwnedByAPlayer(Other(ActionPlayer)), WasExiledWithPermanent({{~Permanent}})]), EachablePlayer)])",
    "During each player's turn, that player may play a land or cast a spell from among cards exiled with this enchantment, and they may spend mana as though it were mana of any color to cast that spell. When they do, exile the top card of their library": "EachPlayerEffect(AnyPlayer, [MayPlayALandOrCastASpellFromAmongExiledCardsAndMaySpendManaAsThoughAnyColorToCastOnceEachPlayersTurnWithTrigger(IsCardtype(Land), AnySpell, WasExiledWithPermanent({{~Permanent}}), EachablePlayer, ActionList([ExileTheTopCardOfPlayersLibrary(EachablePlayer)]))])",
    "During turns other than yours, this Vehicle is an artifact creature": "If(IsAPlayersTurn(Other(You)), [PermanentLayerEffect({{~Permanent}}, [SetCardtypes([Artifact, Creature])])])",
    "During turns other than yours, this artifact is {{a}} {{PT}} {{Zombie}} artifact creature with {{Hasable}}": "If(IsAPlayersTurn(Other(You)), [PermanentLayerEffect({{~Permanent}}, [SetPT({{PT[0]}}), SetCreatureType({{Zombie[0]}}), SetCardtypes([Artifact, Creature]), AddAbility([{{Hasable[0]}}])])])",
    "During turns other than yours, this creature gets {{PTMod}}": "If(IsAPlayersTurn(Other(You)), [PermanentLayerEffect({{~Permanent}}, [AdjustPT({{PTMod[0]}})])])",
    "During your turn, as long as you haven't activated an exhaust ability this turn, you may activate exhaust abilities as though they haven't been activated": "If(And([IsPlayersTurn(You), PlayerPassesFilter(You, HasNotActivatedAnExhaustAbilityThisTurn)]), [PlayerEffect(You, [MayActivateExhaustAbilitiesAsThoughTheyHaventBeenActivated])])",
    "During your turn, as long as {{Condition}}, you may play cards exiled with {{ThisPermanent}}": "If(And([IsPlayersTurn(You), {{Condition[0]}}]), [PlayerEffect(You, [MayPlayExiledCards(WasExiledWithPermanent({{~Permanent}}))])])",
    "During your turn, as long as {{~Permanent}} has one or more {{CounterType}} counters on him, he's {{a}} {{PT}} {{Zombie}} creature and has {{Hasable}}": "If(And([IsPlayersTurn(You), PermanentPassesFilter({{~Permanent}}, HasACounterOfType({{CounterType[0]}}))]), [PermanentLayerEffect({{~Permanent}}, [SetPT({{PT[0]}}), SetCreatureType({{Zombie[0]}}), SetCardtype(Creature), AddAbility([{{Hasable[0]}}])])])",
    "During your turn, as long as {{~Permanent}} is equipped, it has {{Hasable}} and {{Hasable}}": "If(And([IsPlayersTurn(You), PermanentPassesFilter({{~Permanent}}, IsEquipped)]), [PermanentLayerEffect({{~Permanent}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])])])",
    "During your turn, if {{Condition}}, you may play lands and cast spells from among cards exiled with this enchantment": "If(And([IsPlayersTurn(You), {{Condition[0]}}]), [PlayerEffect(You, [MayPlayLandsFromAmongExiled(WasExiledWithPermanent({{~Permanent}})), MayCastSpellsFromAmongExiled(AnySpell, WasExiledWithPermanent({{~Permanent}}))])])",
    "During your turn, prevent all damage that would be dealt to this creature": "If(IsPlayersTurn(You), [PreventDamage(DamageWouldBeDealtToRecipient(Permanent({{~Permanent}})), [PreventThatDamage])])",
    "During your turn, prevent all damage that would be dealt to {{~Permanent}}": "If(IsPlayersTurn(You), [PreventDamage(DamageWouldBeDealtToRecipient(Permanent({{~Permanent}})), [PreventThatDamage])])",
    "During your turn, this creature gets {{PTMod}}": "If(IsPlayersTurn(You), [PermanentLayerEffect({{~Permanent}}, [AdjustPT({{PTMod[0]}})])])",
    "During your turn, this creature gets {{PTMod}} and has {{Hasable}}": "If(IsPlayersTurn(You), [PermanentLayerEffect({{~Permanent}}, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])])])",
    "During your turn, this creature has base power and toughness {{PT}}": "If(IsPlayersTurn(You), [PermanentLayerEffect({{~Permanent}}, [SetPT({{PT[0]}})])])",
    "During your turn, this creature has {{Hasable}}": "If(IsPlayersTurn(You), [PermanentLayerEffect({{~Permanent}}, [AddAbility([{{Hasable[0]}}])])])",
    "During your turn, this creature has {{Hasable}} and {{Hasable}}": "If(IsPlayersTurn(You), [PermanentLayerEffect({{~Permanent}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])])])",
    "During your turn, this creature is {{a}} {{Zombie}} with base power and toughness {{PT}}": "If(IsPlayersTurn(You), [PermanentLayerEffect({{~Permanent}}, [SetCreatureType({{Zombie[0]}}), SetPT({{PT[0]}})])])",
    "During your turn, you and this creature have hexproof": "If(IsPlayersTurn(You), [PlayerEffect(You, [Hexproof]), PermanentLayerEffect({{~Permanent}}, [AddAbility([Hexproof])])])",
    "During your turn, you may cast cards exiled with {{~Permanent}} and you may cast them as though they had flash. Mana of any type can be spent to cast those spells": "If(IsPlayersTurn(You), [PlayerEffect(You, [MayCastSpellsFromAmongExiledAndMaySpendManaAsThoughAnyTypeToCastAndAsThoughTheyHadFlash(AnySpell, WasExiledWithPermanent({{~Permanent}}))])])",
    "During your turn, you may cast creature spells from among cards you own exiled with {{ThisPermanent}} by removing {{Number}} counters from among creatures you control in addition to paying their other costs": "If(IsPlayersTurn(You), [PlayerEffect(You, [MayCastSpellsFromAmongExiledForAdditionalCost(IsCardtype(Creature), TheExiledCards, RemoveNumberCountersFromAmongPermanents({{Number[0]}}, And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))])))])])",
    "During your turn, you may cast {{PotentialSpells}} from your graveyard by paying {{Digits}} life in addition to their other costs": "If(IsPlayersTurn(You), [PlayerEffect(You, [MayCastSpellsFromGraveyardForAdditionalCost({{PotentialSpells[0]}}, You, PayLife({{Digits[0]}}))])])",
    "During your turn, you may play cards exiled with {{~Permanent}}": "If(IsPlayersTurn(You), [PlayerEffect(You, [MayPlayExiledCards(WasExiledWithPermanent({{~Permanent}}))])])",
    "During your turn, you may play cards exiled with {{~Permanent}}. If you cast a spell this way, pay life equal to its mana value rather than pay its mana cost": "If(IsPlayersTurn(You), [PlayerEffect(You, [MayPlayExiledCardsAndPayAlternateCostToCast(TheExiledCards, PayLifeEqualToItsManaValue)])])",
    "During your turn, {{~Permanent}} and other {{Zombies}} you control have {{Hasable}}": "If(IsPlayersTurn(You), [EachPermanentLayerEffect(Or([SinglePermanent(ThisPermanent), And([Other(ThisPermanent), IsCreatureType({{Zombies[0]}}), ControlledByAPlayer(SinglePlayer(You))])]), [AddAbility([{{Hasable[0]}}])])])",
    "During your turn, {{~Permanent}} and {{Permanents}} have {{Hasable}}, {{Hasable}}, and {{Hasable}}": "If(IsPlayersTurn(You), [EachPermanentLayerEffect(Or([SinglePermanent({{~Permanent}}), {{Permanents[0]}}]), [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}]), AddAbility([{{Hasable[2]}}])])])",
    "During your turn, {{~Permanent}} has {{Hasable}}": "If(IsPlayersTurn(You), [PermanentLayerEffect({{~Permanent}}, [AddAbility([{{Hasable[0]}}])])])",
    "During your turn, {{~Permanent}} has {{Hasable}} and {{Hasable}}": "If(IsPlayersTurn(You), [PermanentLayerEffect({{~Permanent}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])])])",
    "During your turn, {{~Permanent}} is {{a}} {{PT}} {{Zombie}} {{Zombie}} creature with {{Hasable}} that's still a planeswalker": "If(IsPlayersTurn(You), [PermanentLayerEffect({{~Permanent}}, [SetPT({{PT[0]}}), SetCreatureTypes([{{Zombie[0]}}, {{Zombie[1]}}]), AddCardtype(Creature), AddAbility([{{Hasable[0]}}])])])",
    "During your turn, {{~Permanent}}'s power and toughness are each equal to {{Digits}} plus {{GameNumber}}. During turns other than yours, {{~Permanent}}'s power and toughness are each {{Digits}}": "IfElse(IsPlayersTurn(You), [PermanentLayerEffect({{~Permanent}}, [SetPowerAndToughnessBoth(Plus({{Digits[0]}}, {{GameNumber[0]}}))])], [PermanentLayerEffect({{~Permanent}}, [SetPowerAndToughnessBoth({{Digits[1]}})])])",
    "Each other creature you control enters with a number of additional {{CounterType}} counters on it equal to {{GameNumber(~Permanent)}}": "ReplaceWouldEnter(APermanentWouldEnterTheBattlefield(And([Other({{~Permanent}}), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))])), [EntersWithNumberCounters({{GameNumber(~Permanent=^~Permanent)[0]}}, {{CounterType[0]}})])",
    "Each other creature you control enters with a number of additional {{CounterType}} counters on it equal to {{GameNumber(~Permanent)}} and as {{a}} {{Zombie}} in addition to its other types": "ReplaceWouldEnter(APermanentWouldEnterTheBattlefield(And([Other({{~Permanent}}), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))])), [EntersWithNumberCounters({{GameNumber(~Permanent=^~Permanent)[0]}}, {{CounterType[0]}}), EntersWithLayerEffect([AddCreatureType({{Zombie[0]}})])])",
    "Each other creature you control has hexproof from each of its colors": "EachPermanentLayerEffect(And([Other(ThisPermanent), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]), [AddAbility([HexproofFrom(FromColor(ItsOwnColors))])])",
    "Each other {{Creature}} gets {{PTModX}}, where X is {{GameNumber(~Permanent)}}": "EachPermanentLayerEffect(And([Other(ThisPermanent), {{Creature[0]}}]), [AdjustPTX({{PTModX[0]}}, {{GameNumber(~Permanent=^~Permanent)[0]}})])",
    "Each other {{Permanent}} enters with an additional X {{CounterType}} counters on it, where X is {{GameNumber(~Permanent)}}": "ReplaceWouldEnter(APermanentWouldEnterTheBattlefield(And([Other({{~Permanent}}), {{Permanent[0]}}])), [EntersWithNumberCounters({{GameNumber(~Permanent=^~Permanent)[0]}}, {{CounterType[0]}})])",
    "Each other {{Permanent}} has the loyalty abilities of {{~Permanent}}": "EachPermanentLayerEffect(And([Other({{~Permanent}}), {{Permanent[0]}}]), [AddAbilityFromPermanentHasable({{~Permanent}}, [LoyaltyAbility])])",
    "Each player may look at cards they exiled with this enchantment, and they may play lands and cast spells from among those cards": "EachPlayerEffect(AnyPlayer, [MayPlayLandsFromAmongExiled(WasExiledByPlayerWithPermanent(EachablePlayer, {{~Permanent}})), MayCastSpellsFromAmongExiled(AnySpell, WasExiledByPlayerWithPermanent(EachablePlayer, {{~Permanent}}))])",
    "Each player may play lands and cast spells from among cards they exiled with this artifact this turn": "EachPlayerEffect(AnyPlayer, [MayPlayLandsFromAmongExiled(WasExiledByPlayerWithPermanentThisTurn(EachablePlayer, {{~Permanent}})), MayCastSpellsFromAmongExiled(AnySpell, WasExiledByPlayerWithPermanentThisTurn(EachablePlayer, {{~Permanent}}))])",
    "Each {{Artifact}} loses all abilities and becomes an artifact creature with power and toughness each equal to {{GameNumber(ThatPermanent)}}. If this enchantment leaves the battlefield, this effect continues until end of turn": "EachPermanentStickyLayerEffect({{Artifact[0]}}, [LosesAllAbilities, AddCardtype(Artifact), AddCardtype(Creature), SetPowerAndToughnessBoth({{GameNumber(ThatPermanent=EachablePermanent)[0]}})], UntilEndOfTurn)",
    "Each {{Permanent}} enters as a copy of this creature": "ReplaceWouldEnter(APermanentWouldEnterTheBattlefield({{Permanent[0]}}), [EnterAsACopyOfPermanent({{~Permanent}}, NoCopyEffects)])",
    "Equip abilities you activate of other Equipment cost {{CostReduce}} less to activate": "PlayerEffect(You, [ReduceActivatedCost(And([EquipAbility, AbilityOfAPermanent(And([Other({{~Permanent}}), IsArtifactType(Equipment)]))]), {{CostReduce[0]}})])",
    "Equip abilities you activate that target this creature cost {{CostReduce}} less to activate": "PlayerEffect(You, [DecreaseEquipAbilityCostWhenTargetingPermanent({{CostReduce[0]}}, {{~Permanent}})])",
    "Equip abilities you activate that target {{~Permanent}} cost {{CostReduce}} less to activate": "PlayerEffect(You, [DecreaseEquipAbilityCostWhenTargetingPermanent({{CostReduce[0]}}, {{~Permanent}})])",
    "For each 1 damage that would be dealt to this creature, if it has {{a}} {{CounterType}} counter on it, remove {{a}} {{CounterType}} counter from it and prevent that 1 damage": "PreventDamage(EachDamageWouldBeDealtToRecipient(Permanent({{~Permanent}})), [If(PermanentPassesFilter({{~Permanent}}, HasACounterOfType({{CounterType[0]}})), [RemoveACounterOfTypeFromPermanent({{CounterType[1]}}, {{~Permanent}}), PreventThatDamage])])",
    "For each basic land type among lands you control, this creature has landwalk of that type": "PermanentLayerEffect({{~Permanent}}, [AddAbility([Landwalk(IsLandTypeVariable(AnyBasicLandTypeAmongPermanents(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You))]))))])])",
    "For each kind of counter on {{~Permanent}}, each other {{Permanent}} enters with a counter of that kind on it": "If(PermanentPassesFilter({{~Permanent}}, HasACounter), [ReplaceWouldEnter(APermanentWouldEnterTheBattlefield(And([Other({{~Permanent}}), {{Permanent[0]}}])), [EntersWithACounterOfTypeForEachKindOfCounterOnPermanent({{~Permanent}})])])",
    "If a creature an opponent controls would die, instead exile it and put a number of {{CounterType}} counters equal to that creature's power on this creature": "ReplaceWouldPutIntoGraveyard(APermanentWouldDie(And([IsCardtype(Creature), ControlledByAPlayer(Opponent)])), [ExileItInstead, PutNumberCountersOfTypeOnPermanent(PowerOfPermanent(ThePermanentExiledThisWay), {{CounterType[0]}}, {{~Permanent}})])",
    "If a creature card with {{CheckHasable}} was exiled with this creature's delve ability, this creature has {{Hasable}}. The same is true for {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, and {{CheckHasable}}": "PermanentLayerEffect({{~Permanent}}, [AddAbilityFromAnExiledHasable(WasExiledWithPermanentsDelveAbility({{~Permanent}}), [{{CheckHasable[0]}}, {{CheckHasable[1]}}, {{CheckHasable[2]}}, {{CheckHasable[3]}}, {{CheckHasable[4]}}, {{CheckHasable[5]}}, {{CheckHasable[6]}}, {{CheckHasable[7]}}, {{CheckHasable[8]}}, {{CheckHasable[9]}}, {{CheckHasable[10]}}])])",
    "If a creature dealt damage by this creature this turn would die, exile it instead": "ReplaceWouldPutIntoGraveyard(APermanentWouldDie(And([IsCardtype(Creature), WasDealtDamageByPermanentThisTurn({{~Permanent}})])), [ExileItInstead])",
    "If a creature dealt damage by {{~Permanent}} this turn would die, exile it instead": "ReplaceWouldPutIntoGraveyard(APermanentWouldDie(And([IsCardtype(Creature), WasDealtDamageByPermanentThisTurn({{~Permanent}})])), [ExileItInstead])",
    "If a creature you control attacks, this creature also attacks if able": "PermanentRuleEffect({{~Permanent}}, [MustAttackIfAnotherCreatureAttacks(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))])",
    "If a cycling ability of another nonland card would cause you to draw a card, instead exile cards from the top of your library until you exile a card that shares a card type with the cycled card. You may cast that card without paying its mana cost. Then put the exiled cards that weren't cast this way on the bottom of your library in a random order": "ReplaceWouldDraw(ACyclingAbilityOfAPermanentWouldCausePlayerToDrawACard(And([Other(ThisPermanent), IsNonCardtype(Land)]), You), [ExileCardsFromTheTopOfLibraryUntilACardOfTypeIsExiled(SharesACardtypeWithTheCycledCard), MayAction(CastExiledCardWithoutPaying(TheExiledCardFoundThisWay)), PutEachExiledCardOnTheBottomOfTheirOwnersLibraryInARandomOrder(TheCardsExiledThisWay)])",
    "If a triggered ability of another {{Zombie}} you control triggers, it triggers an additional time": "AbilitiesTriggerAnAdditionalTime(AbilityOfAPermanent(And([Other(ThisPermanent), IsCreatureType({{Zombie[0]}}), ControlledByAPlayer(SinglePlayer(You))])))",
    "If one or more {{CounterType}} counters would be put on {{~Permanent}}, that many plus {{Number}} {{CounterType}} counters are put on it instead": "ReplaceWouldPutCounters(CountersOfTypeWouldBePointOnAPermanent({{CounterType[0]}}, SinglePermanent({{~Permanent}})), [PutNewAmountOfType(Plus(WouldPutCounters_NumberOfCounters, {{Number[0]}}), {{CounterType[0]}})])",
    "If this creature attacks, all {{Creatures}} attack if able": "PermanentRuleEffect({{~Permanent}}, [AttackingCausesOthersToAttack({{Creatures[0]}})])",
    "If this creature is unblocked, you may have it assign its combat damage to a creature defending player controls": "If(PermanentPassesFilter({{~Permanent}}, IsUnblocked), [PermanentRuleEffect({{~Permanent}}, [MayAssignCombatDamageToAPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(DefendingPlayer))]))])])",
    "If this creature would be destroyed, regenerate it": "ReplaceWouldDestroy(PermanentWouldBeDestroyed({{~Permanent}}), [RegeneratePermanent(WouldBeDestroyed_ThatPermanent)])",
    "If this creature would die, exile it instead": "ReplaceWouldPutIntoGraveyard(APermanentWouldDie(SinglePermanent({{~Permanent}})), [ExileItInstead])",
    "If this creature would die, put it on the bottom of its owner's library instead": "ReplaceWouldPutIntoGraveyard(APermanentWouldDie(SinglePermanent({{~Permanent}})), [PutItOnBottomOfOwnersLibraryInstead])",
    "If this creature would die, put it on top of its owner's library instead": "ReplaceWouldPutIntoGraveyard(APermanentWouldDie(SinglePermanent({{~Permanent}})), [PutItOnTopOfOwnersLibraryInstead])",
    "If this creature would die, return it to its owner's hand instead. Until that player's next turn, that player plays with that card revealed in their hand and can't play it": "ReplaceWouldPutIntoGraveyard(APermanentWouldDie(SinglePermanent({{~Permanent}})), [PutItInOwnersHandInstead, CreatePlayerEffectUntil(OwnerOfTheCardReturnedToHandThisWay, [PlaysWithCardInHandRevealed(TheCardReturnedToHandThisWay), CantPlayCardInHand(TheCardReturnedToHandThisWay)], UntilPlayersNextTurn(OwnerOfTheCardReturnedToHandThisWay))])",
    "If you removed a creature card with {{CheckHasable}} from the draft with cards named {{NamedCard}}, this creature has {{Hasable}}. The same is true for {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, and {{CheckHasable}}": "PermanentLayerEffect({{~Permanent}}, [AddAbilityFromCardsRemovedFromDraftWithCardsNamedHasable(IsCardtype(Creature), {{NamedCard[0]}}, [{{CheckHasable[0]}}, {{CheckHasable[1]}}, {{CheckHasable[2]}}, {{CheckHasable[3]}}, {{CheckHasable[4]}}, {{CheckHasable[5]}}, {{CheckHasable[6]}}, {{CheckHasable[7]}}, {{CheckHasable[8]}}, {{CheckHasable[9]}}, {{CheckHasable[10]}}])])",
    "If you would begin your turn while this artifact is tapped, you may skip that turn instead. If you do, untap this artifact": "If(PermanentPassesFilter({{~Permanent}}, IsTapped), [ReplaceWouldBeginATurn(PlayerWouldBeginTheirTurn(You), [MayCost(SkipThisTurn), If(CostWasPaid, [UntapPermanent({{~Permanent}})])])])",
    "If you would draw a card while {{Condition}}, instead put {{Number}} {{CounterType}} counters on {{~Permanent}}": "If({{Condition[0]}}, [ReplaceWouldDraw(APlayerWouldDrawACard(SinglePlayer(You)), [PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[0]}}, {{~Permanent}})])])",
    "If you would draw a card, you may put {{a}} {{CounterType}} counter on this enchantment instead": "ReplaceWouldDraw(APlayerWouldDrawACard(SinglePlayer(You)), [ChooseAnAction([[PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{~Permanent}})], [DrawACard]])])",
    "If you would roll one or more six-sided dice, instead roll them and you may exchange one result with this creature's base power or base toughness": "ReplaceWouldRollDice(APlayerWouldRollANumberOfD6(SinglePlayer(You)), [RollThatManyAndMayExchangeOneWithPermanentsBasePowerOrBaseToughness({{~Permanent}})])",
    "If your life total would be reduced to {{Digits}} or less, instead transform this creature and your life total becomes {{Digits}}. Then if this creature didn't transform this way, you lose the game": "ReplaceWouldReduceLife(PlayersLifeTotalWouldBeReducedToNumberOrLess(You, {{Digits[0]}}), [TransformPermanent({{~Permanent}}), SetLifeTotal({{Digits[0]}}), Unless(PermanentTransformedThisWay({{~Permanent}}), [LoseTheGame])])",
    "If {{Condition(~Permanent)}}, you may exert it as it attacks. When you do, {{TriggerActions(ThatPermanent)}}": "If({{Condition(~Permanent=^~Permanent)[0]}}, [PermanentRuleEffect({{~Permanent}}, [MayBeExertedAsItAttacksWithTrigger({{TriggerActions(ThatPermanent=^~Permanent)[0]}})])])",
    "If {{~Permanent}} would be put into a graveyard from the battlefield, instead exile it and take an extra turn after this one": "ReplaceWouldPutIntoGraveyard(APermanentWouldBePutIntoAGraveyard(SinglePermanent({{~Permanent}})), [ExileItInstead, TakeAnExtraTurn])",
    "If {{~Permanent}} would die, instead exile it with {{Number}} {{CounterType}} counters on it": "ReplaceWouldPutIntoGraveyard(APermanentWouldDie(SinglePermanent({{~Permanent}})), [ExileItWithNumberCountersInstead({{Number[0]}}, {{CounterType[0]}})])",
    "If {{~Permanent}} would die, shuffle it into your library instead": "ReplaceWouldPutIntoGraveyard(APermanentWouldDie(SinglePermanent({{~Permanent}})), [ShuffleItIntoLibraryInstead])",
    "Mana abilities of this land cost an additional {{Digits}} life to activate": "ActivatedAbilityEffect(And([ManaAbility, AbilityOfPermanent({{~Permanent}})]), AdditionalCost(PayLife({{Digits[0]}})))",
    "Mana abilities of {{~Permanent}} cost an additional {{Digits}} life to activate": "ActivatedAbilityEffect(And([ManaAbility, AbilityOfPermanent({{~Permanent}})]), AdditionalCost(PayLife({{Digits[0]}})))",
    "Mana of any type can be spent to activate {{~Permanent}}'s abilities": "EachPlayerEffect(AnyPlayer, [MaySpendManaAsThoughItWasAnyTypeToActivateAbilities(And([AbilityOfPermanent({{~Permanent}}), NonManaAbility]))])",
    "Max speed - This creature gets {{PTMod}}": "MaxSpeed(PermanentLayerEffect(ThisPermanent, [AdjustPT({{PTMod[0]}})]))",
    "Max speed - This creature gets {{PTMod}} and has {{Hasable}}": "MaxSpeed(PermanentLayerEffect(ThisPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])]))",
    "Max speed - This creature has {{Hasable}}": "MaxSpeed(PermanentLayerEffect(ThisPermanent, [AddAbility([{{Hasable[0]}}])]))",
    "Max speed - This creature has {{Hasable}} and {{Hasable}}": "MaxSpeed(PermanentLayerEffect(ThisPermanent, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])]))",
    "Max speed - {{~Permanent}} has {{Hasable}}. Other {{Permanents}} have {{Hasable}}": "MaxSpeed(PermanentLayerEffect({{~Permanent}}, [AddAbility([{{Hasable[0]}}])])), MaxSpeed(EachPermanentLayerEffect(And([Other(ThisPermanent), {{Permanents[0]}}]), [AddAbility([{{Hasable[1]}}])]))",
    "No more than one creature can attack {{~Permanent}} each combat": "NoMoreThanNumberCreaturesCanAttackPermanent(Integer(1), {{~Permanent}})",
