    "Whenever one or more {{Creatures}} attack one of your opponents, {{TriggerActions(ThosePermanents)}}": "TriggerA(WhenAnyNumberOfCreaturesAttackAPlayer({{Creatures[0]}}, Opponent), {{TriggerActions(ThosePermanents=Trigger_ThoseCreatures)[0]}})",
    "Whenever one or more {{Creatures}} attack one or more players, you and those players each draw a card, then discard a card at random": "TriggerA(WhenAnyNumberOfCreaturesAttackAnyNumberOfPlayers({{Creatures[0]}}, AnyPlayer), ActionList([EachPlayerActions(Or([SinglePlayer(You), Trigger_ThosePlayers]), [DrawACard, DiscardACardAtRandom])]))",
