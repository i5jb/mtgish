  "{{PregameEffect(~Pregame)}}": {
    "Any time you could mulligan and this card is in your hand, you may exile all the cards from your hand, then draw that many cards": "IfCardIsInOpeningHand([If(PlayerPassesFilter(You, CouldMulligan), [MayCost(ExileHand), If(CostWasPaid, [DrawNumberCards(NumHandCardsExiledThisWay)])])])",
    "If this card is in your opening hand and you're not the starting player, you may begin the game with {{~Pregame}} on the battlefield with {{a}} {{CounterType}} counter on it. If you do, exile a card from your hand": "IfCardIsInOpeningHand([If(PlayerPassesFilter(You, IsNotTheStartingPlayer), [MayCost(BeginGameWithCardOnBattlefield({{~Pregame}}, [EntersWithACounter({{CounterType[0]}})])), If(CostWasPaid, [ExileACardFromHand])])])",
    "If this card is in your opening hand, you may begin the game with it on the battlefield": "IfCardIsInOpeningHand([MayAction(BeginGameWithCardOnBattlefield({{~Pregame}}, [EntersNormally]))])",
    "If {{~Pregame}} is in your opening hand, you may begin the game with him on the battlefield": "IfCardIsInOpeningHand([MayAction(BeginGameWithCardOnBattlefield({{~Pregame}}, [EntersNormally]))])",
    "If {{~Pregame}} is your commander, choose a color before the game begins. {{~Pregame}} is the chosen color": "DeckBuildingIfCommander([ChooseAColor(AnyColor)]), SelfEffect([SetColor(TheChosenColor)])"
  },
  "{{PregameEffect[ChooseANumber]}}": {
    "Before drawing your opening hand, choose 1, 2, or 3": "BeforeDrawingOpeningHand([ChooseANumberBetween(1, 3)])"
  },
  "{{PregameEffect[CircleColors]}}": {
    "As you create your deck, circle two of the colors below": "AsGameBegins([CircleNumberColors(Integer(2), AnyColor)])"
  },
  "{{PregameEffect}}": {
    "Before you shuffle your deck to start the game, you may reveal this card from your deck and exile {{Number}} or more {{SpecificCards}} you drafted that aren't in your deck": "BeforeShufflingDeckToStartTheGame([MayActions([RevealCardFromDeck, ExileNumberDraftedCardsNotInDeck({{Number[0]}}, {{SpecificCards[0]}})])])",
    "Before you shuffle your deck to start the game, you may reveal this card from your deck and exile {{a}} {{SpecificCard}} you drafted that isn't in your deck": "BeforeShufflingDeckToStartTheGame([MayActions([RevealCardFromDeck, ExileADraftedCardNotInDeck])])",
    "Draw an additional hand of seven cards as the game begins. Before taking mulligans, shuffle all but one of your hands into your library": "DrawAnAdditionalHandBeforeMulligans",
    "You are the starting player. If multiple players would be the starting player, one of those players is chosen at random": "YouAreTheStartingPlayer",
    "You begin the game with {{a}} {{PT}} {{CreatureToken}} on the battlefield. It has \"{{TokenQuotedAbility}}\"": "AsGameBegins([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{TokenQuotedAbility[0]}}])])])",
    "You may reveal this card from your opening hand. If you do, at the beginning of the first upkeep, {{TriggerActions}}": "IfCardIsInOpeningHand([MayCost(RevealCardFromHand(ThisCardInHand)), If(CostWasPaid, [CreateFutureTrigger(AtTheBeginningOfTheFirstUpkeep, {{TriggerActions[0]}})])])",
    "You may reveal this card from your opening hand. If you do, at the beginning of your first main phase of the game, {{TriggerActions}}": "IfCardIsInOpeningHand([MayCost(RevealCardFromHand(ThisCardInHand)), If(CostWasPaid, [CreateFutureTrigger(AtTheBeginningOfPlayersFirstMainPhaseOfTheGame(You), {{TriggerActions[0]}})])])",
    "You may reveal this card from your opening hand. If you do, at the beginning of your first upkeep, {{TriggerActions}}": "IfCardIsInOpeningHand([MayCost(RevealCardFromHand(ThisCardInHand)), If(CostWasPaid, [CreateFutureTrigger(AtTheBeginningOfPlayersFirstUpkeep(You), {{TriggerActions[0]}})])])",
    "You may reveal this card from your opening hand. If you do, when each opponent casts their first spell of the game, {{TriggerActions(ThatSpell,ThatPlayer)}}": "IfCardIsInOpeningHand([MayCost(RevealCardFromHand(ThisCardInHand)), If(CostWasPaid, [ActionForEachPlayer(Opponent, [CreateFutureTrigger(WhenPlayerCastsTheirNextSpellThisGame(EachablePlayer, AnySpell), {{TriggerActions(ThatSpell=Trigger_ThatSpell,ThatPlayer=Trigger_ThatPlayer)[0]}})])])])",
    "You may reveal this card from your opening hand. If you do, {{TriggerActions}} at the beginning of your first upkeep": "IfCardIsInOpeningHand([MayCost(RevealCardFromHand(ThisCardInHand)), If(CostWasPaid, [CreateFutureTrigger(AtTheBeginningOfPlayersFirstUpkeep(You), {{TriggerActions[0]}})])])"
  },
  "{{Protectable[Color]}}": {
    "each color": "FromColor(AnyColor)",
    "each color that's not in your commander's color identity": "FromColor(NotAColorInCommanderColorIdentity)",
    "monocolored": "FromColor(Monocolored)",
    "multicolored": "FromColor(Multicolored)",
    "the colors of permanents you control": "FromColor(ColorsOfPermanents(ControlledByAPlayer(SinglePlayer(You))))",
    "{{Black}}": "FromColor(Colors([{{Black[0]}}]))"
  },
  "{{Protectable[Everything]}}": {
    "everything": "FromEverything"
  },
  "{{Protectable[ManaValue]}}": {
    "each mana value among artifacts you control": "FromManaValue(AnyManaValueAmongPermanents(And([IsCardtype(Artifact), ControlledByAPlayer(SinglePlayer(You))])))",
    "even mana values": "FromManaValue(Even)",
    "mana value {{Digits}} or greater": "FromManaValue(GreaterThanOrEqualTo({{Digits[0]}}))",
    "mana value {{Digits}} or less": "FromManaValue(LessThanOrEqualTo({{Digits[0]}}))",
    "odd mana values": "FromManaValue(Odd)"
  },
  "{{Protectable[Permanents]}}": {
    "Ring-bearers": "FromPermanents(IsARingBearer)",
    "noncreature permanents": "FromPermanents(IsNonCardtype(Creature))",
    "permanents that were cast this turn": "FromPermanents(WasCastThisTurn)",
    "permanents with {{CounterType}} counters on them": "FromPermanents(HasACounterOfType({{CounterType[0]}}))"
  },
  "{{Protectable[Spells]}}": {
    "spells": "FromSpells(AnySpell)",
    "spells that are one or more colors": "FromColor(Colored)"
  },
  "{{Protectable[Types]}}": {
    "Arcane": "FromTypes(IsSpellType(Arcane))",
    "artifacts": "FromTypes(IsCardtype(Artifact))",
    "creatures": "FromTypes(IsCardtype(Creature))",
    "creatures with two or more creature types": "FromTypes(And([IsCardtype(Creature), NumCreatureTypesIs(GreaterThanOrEqualTo(Integer(2)))]))",
    "each of the exiled card's card types": "FromTypes(IsCardtypeVariable(CardtypeOfExiled(TheExiledCard)))",
    "enchantments": "FromTypes(IsCardtype(Enchantment))",
    "instants": "FromTypes(IsCardtype(Instant))",
    "lands": "FromTypes(IsCardtype(Land))",
    "legendary creatures": "FromTypes(And([IsSupertype(Legendary), IsCardtype(Creature)]))",
    "non-{{Zombie}} creatures": "FromTypes(And([IsNonCreatureType({{Zombie[0]}}), IsCardtype(Creature)]))",
    "planeswalkers": "FromTypes(IsCardtype(Planeswalker))",
    "snow": "FromTypes(IsSupertype(Snow))",
    "{{Zombies}}": "FromTypes(IsCreatureType({{Zombies[0]}}))",
    "{{Zombie}} creatures": "FromTypes(And([IsCreatureType({{Zombie[0]}}), IsCardtype(Creature)]))"
  },
  "{{Protectable}}": {
    "{{Protectable[Color]}}": "{{Protectable[Color][0]}}",
    "{{Protectable[Everything]}}": "{{Protectable[Everything][0]}}",
    "{{Protectable[ManaValue]}}": "{{Protectable[ManaValue][0]}}",
    "{{Protectable[Permanents]}}": "{{Protectable[Permanents][0]}}",
    "{{Protectable[Spells]}}": "{{Protectable[Spells][0]}}",
    "{{Protectable[Types]}}": "{{Protectable[Types][0]}}"
  },
  "{{PutACardFromHandIntoLibraryCost}}": {
    "Put a card from your hand on top of your library": "PutACardFromHandOnTopOfLibrary"
  },
  "{{PutACounterOnSelfCost(~Permanent)}}": {
    "Put {{a}} {{CounterType}} counter on this artifact": "PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{~Permanent}})",
    "Put {{a}} {{CounterType}} counter on this creature": "PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{~Permanent}})",
    "Put {{a}} {{CounterType}} counter on {{~Permanent}}": "PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{~Permanent}})"
  },
  "{{PutAnExiledCardIntoGraveyardCost(~Permanent)}}": {
    "Put a card exiled with this artifact into its owner's graveyard": "PutAnExiledCardIntoOwnersGraveyard(WasExiledWithPermanent({{~Permanent}}))",
    "Put a card exiled with this creature into its owner's graveyard": "PutAnExiledCardIntoOwnersGraveyard(WasExiledWithPermanent({{~Permanent}}))",
    "Put a creature card exiled with {{~Permanent}} into its owner's graveyard": "PutAnExiledCardIntoOwnersGraveyard(And([IsCardtype(Creature), WasExiledWithPermanent({{~Permanent}})]))"
  },
  "{{PutAnExiledCardIntoGraveyardCost}}": {
    "Put a card an opponent owns from exile into that player's graveyard": "PutAnExiledCardIntoOwnersGraveyard(OwnedByAPlayer(Opponent))"
  },
  "{{PutCountersOnAPermanentCost}}": {
    "Put {{a}} {{CounterType}} counter on {{a}} {{Permanent}}": "PutACounterOfTypeOnAPermanent({{CounterType[0]}}, {{Permanent[0]}})"
  },
  "{{PutGraveyardCardsIntoLibraryCost}}": {
    "Put {{Number}} cards from a single graveyard on the bottom of their owner's library": "PutNumberCardsFromASinglePlayersGraveyardOnBottomOfLibrary({{Number[0]}}, AnyPlayer)",
    "Put {{Number}} cards from your graveyard on the bottom of your library": "PutNumberCardsFromPlayersGraveyardOnBottomOfLibrary({{Number[0]}}, You)"
  },
  "{{PutSelfIntoLibraryCost(~Permanent)}}": {
    "Put this creature on the bottom of its owner's library": "PutPermanentOnBottomOfOwnersLibrary({{~Permanent}})"
  },
  "{{QuotedAbility(~Guest)}}": {
    "At the beginning of your end step, sacrifice this permanent and attach {{~Guest}} to {{a}} {{Permanent}}": "TriggerA(AtTheBeginningOfAPlayersEndStep(SinglePlayer(You)), ActionList([SacrificePermanent(ThisPermanent), AttachPermanentToAPermanent({{~Guest}}, {{Permanent[0]}})]))",
    "Unattach {{~Guest}}: Prevent all combat damage that would be dealt to this creature this turn": "Activated(UnattachPermanent({{~Guest}}), ActionList([CreatePreventDamageUntil(CombatDamageWouldBeDealtToRecipient(Permanent(ThisPermanent)), [PreventThatDamage], UntilEndOfTurn)]))",
    "Whenever this creature attacks, create {{a}} {{PT}} {{CreatureToken}}. Put {{a}} {{CounterType}} counter on that token for each Aura and Equipment attached to this creature other than {{~Guest}}": "TriggerA(WhenACreatureAttacks(SinglePermanent(ThisPermanent)), ActionList([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])]), PutNumberCountersOfTypeOnPermanent(TheNumberOfPermanentsOnTheBattlefield(And([Or([IsEnchantmentType(Aura), IsArtifactType(Equipment)]), AttachedToPermanent(ThisPermanent), Other({{~Guest}})])), {{CounterType[0]}}, TheTokenCreatedThisWay)]))",
    "Whenever this creature attacks, you may sacrifice an artifact other than {{~Guest}}. When you do, this creature deals damage equal to its power to target {{Creature}}": "TriggerA(WhenACreatureAttacks(SinglePermanent(ThisPermanent)), ActionList([MayCost(SacrificeAPermanent(And([IsCardtype(Artifact), Other({{~Guest}})]))), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPermanent({{Creature[0]}})], ActionList([PermanentDealsDamage(ThisPermanent, PowerOfPermanent(ThisPermanent), Permanent(Ref_TargetPermanent))])))])]))",
    "Whenever this creature attacks, you may sacrifice {{~Guest}}. When you do, this creature deals {{Digits}} damage to any target": "TriggerA(WhenACreatureAttacks(SinglePermanent(ThisPermanent)), ActionList([MayCost(SacrificePermanent({{~Guest}})), If(CostWasPaid, [ReflexiveTrigger(Targeted([AnyTarget], ActionList([PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, Ref_AnyTarget)])))])]))",
    "Whenever this creature deals combat damage to a player, you may sacrifice {{~Guest}}. If you do, create a token that's a copy of this creature": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(ThisPermanent), AnyPlayer), ActionList([MayCost(SacrificePermanent({{~Guest}})), If(CostWasPaid, [CreateTokens([TokenCopyOfPermanent(ThisPermanent, NoTokenCopyEffects)])])]))",
    "{{ManaCost}}, Exile {{~Guest}}: {{ActivatedActions}}. {{ActivateModifiers}}. {{ActivateModifiers}}": "ActivatedWithModifiers(And([PayMana({{ManaCost[0]}}), ExilePermanent({{~Guest}})]), {{ActivatedActions[0]}}, And([{{ActivateModifiers[0]}}, {{ActivateModifiers[1]}}]))",
    "{{ManaCost}}, {{TapSelfCost}}, Sacrifice {{~Guest}}: {{ActivatedActions}}": "Activated(And([PayMana({{ManaCost[0]}}), {{TapSelfCost[0]}}, SacrificePermanent({{~Guest}})]), {{ActivatedActions[0]}})",
    "{{ManaCost}}, {{TapSelfCost}}, Sacrifice {{~Guest}}: {{~Guest}} deals {{Digits}} damage to any target": "Activated(And([PayMana({{ManaCost[0]}}), {{TapSelfCost[0]}}, SacrificePermanent({{~Guest}})]), Targeted([AnyTarget], ActionList([PermanentDealsDamage({{~Guest}}, {{Digits[0]}}, Ref_AnyTarget)])))",
    "{{ManaCost}}, {{TapSelfCost}}, Tap {{~Guest}}: Put {{a}} {{CounterType}} counter on {{~Guest}}": "Activated(And([PayMana({{ManaCost[0]}}), {{TapSelfCost[0]}}, TapPermanent({{~Guest}})]), ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{~Guest}})]))",
    "{{ManaCost}}, {{TapSelfCost}}, Unattach {{~Guest}}: It deals {{Digits}} damage to any target. Return {{~Guest}} to its owner's hand": "Activated(And([PayMana({{ManaCost[0]}}), {{TapSelfCost[0]}}, UnattachPermanent({{~Guest}})]), Targeted([AnyTarget], ActionList([PermanentDealsDamage({{~Guest}}, {{Digits[0]}}, Ref_AnyTarget), PutPermanentIntoItsOwnersHand({{~Guest}})])))",
    "{{ManaCost}}, {{TapSelfCost}}: Tap target {{Permanent}}. Return {{~Guest}} to its owner's hand": "Activated(And([PayMana({{ManaCost[0]}}), {{TapSelfCost[0]}}]), Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), PutPermanentIntoItsOwnersHand({{~Guest}})])))",
    "{{TapSelfCost}}, Remove all {{CounterType}} counters from {{~Guest}}: This creature deals damage to any target equal to the number of {{CounterType}} counters removed this way": "Activated(And([{{TapSelfCost[0]}}, RemoveAllCountersOfTypeFromPermanent({{CounterType[0]}}, {{~Guest}})]), Targeted([AnyTarget], ActionList([PermanentDealsDamage(ThisPermanent, NumberOfCountersRemovedThisWay, Ref_AnyTarget)])))",
    "{{TapSelfCost}}, Sacrifice {{a}} {{Permanent}}: Put {{a}} {{CounterType}} counter on {{~Guest}}": "Activated(And([{{TapSelfCost[0]}}, SacrificeAPermanent({{Permanent[0]}})]), ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{~Guest}})]))",
    "{{TapSelfCost}}, Sacrifice {{~Guest}}: {{~Guest}} deals {{Digits}} damage to any target": "Activated(And([{{TapSelfCost[0]}}, SacrificePermanent({{~Guest}})]), Targeted([AnyTarget], ActionList([PermanentDealsDamage({{~Guest}}, {{Digits[0]}}, Ref_AnyTarget)])))",
    "{{TapSelfCost}}, Unattach {{~Guest}}: It deals {{Digits}} damage to any target. Return {{~Guest}} to its owner's hand": "Activated(And([{{TapSelfCost[0]}}, UnattachPermanent({{~Guest}})]), Targeted([AnyTarget], ActionList([PermanentDealsDamage(ThisGuest, {{Digits[0]}}, Ref_AnyTarget), PutPermanentIntoItsOwnersHand(ThisGuest)])))",
    "{{TapSelfCost}}, Unattach {{~Guest}}: This creature deals damage equal to its power to target {{PlayerOrPlaneswalker}}": "Activated(And([{{TapSelfCost[0]}}, UnattachPermanent({{~Guest}})]), Targeted([TargetPlayerOrPermanent({{PlayerOrPlaneswalker[0]}})], ActionList([PermanentDealsDamage(ThisPermanent, PowerOfPermanent(ThisPermanent), Ref_TargetPlayerOrPermanent)])))",
    "{{TapSelfCost}}, Unattach {{~Guest}}: {{ActivatedActions}}": "Activated(And([{{TapSelfCost[0]}}, UnattachPermanent({{~Guest}})]), {{ActivatedActions[0]}})",
    "{{TapSelfCost}}, Unattach {{~Guest}}: {{~Guest}} deals {{Digits}} damage to target {{Creature}}. That creature's controller gains control of {{~Guest}} unless it was unattached from {{a}} {{Creature}}": "Activated(And([{{TapSelfCost[0]}}, UnattachPermanent({{~Guest}})]), Targeted([TargetPermanent({{Creature[0]}})], ActionList([PermanentDealsDamage({{~Guest}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent)), If(GuestWasUnattachedFromAPermanentThisWay({{Creature[1]}}), [CreatePermanentLayerEffect({{~Guest}}, [SetController(ControllerOfTargetPermanent)])])])))",
    "{{TapSelfCost}}: Put {{a}} {{CounterType}} counter on {{~Guest}}": "Activated({{TapSelfCost[0]}}, ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{~Guest}})]))",
    "{{TapSelfCost}}: This creature deals X damage to target {{Creature}}, where X is the number of {{CounterType}} counters on {{~Guest}}": "Activated({{TapSelfCost[0]}}, Targeted([TargetPermanent({{Creature[0]}})], ActionList([PermanentDealsDamage(ThisPermanent, NumCountersOfTypeOnPermanent({{CounterType[0]}}, {{~Guest}}), Permanent(Ref_TargetPermanent))])))"
  },
  "{{QuotedAbility(~Permanent)}}": {
    "{{~Permanent}}'s base power is equal to {{GameNumber}}": "PermanentLayerEffect({{~Permanent}}, [SetPower({{GameNumber[0]}})])",
    "{{TapSelfCost}}: {{~Permanent}} deals damage equal to his power to any other target":
      "Activated({{TapSelfCost[0]}}, Targeted([AnyTargetExceptPermanent(ThisPermanent)], ActionList([PermanentDealsDamage(ThisPermanent, PowerOfPermanent(ThisPermanent), Ref_AnyTarget)])))",
    "Creatures dealt damage by this creature this turn can't be regenerated this turn": "EachPermanentRuleEffect(And([IsCardtype(Creature), WasDealtDamageByPermanentThisTurn({{~Permanent}})]), [CantBeRegenerated])",
    "Pay {{Digits}} life: Regenerate this creature": "Activated(PayLife({{Digits[0]}}), ActionList([RegeneratePermanent({{~Permanent}})]))",
    "Whenever this creature deals combat damage to a player, you may cast {{a}} {{Spell}} from among cards exiled with this creature without paying its mana cost": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent({{~Permanent}}), AnyPlayer), ActionList([MayAction(CastASpellFromExileWithoutPaying({{Spell[0]}}, WasExiledWithPermanent({{~Permanent}})))]))",
    "Whenever this creature deals damage to {{a}} {{Creature}}, destroy that creature": "TriggerA(WhenAPermanentDealsDamageToAPermanent(SinglePermanent({{~Permanent}}), {{Creature[0]}}), ActionList([DestroyPermanent(Trigger_ThatOtherPermanent)]))",
    "Whenever this creature deals damage, you gain that much life": "TriggerA(WhenAPermanentDealsDamage(SinglePermanent({{~Permanent}})), ActionList([GainLife(Trigger_ThatMuch)]))",
    "Whenever {{~Permanent}} deals combat damage to a player, exile the top card of your library. You may play that card this turn": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent({{~Permanent}}), AnyPlayer), ActionList([ExileTopCardOfLibrary, CreatePlayerEffectUntil(You, [MayPlayExiledCard(TheCardExiledThisWay)], UntilEndOfTurn)]))",
    "Whenever {{~Permanent}} deals combat damage to an opponent, you draw that many cards and {{~Permanent}} deals that much damage to each other opponent": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent({{~Permanent}}), Opponent), ActionList([DrawNumberCards(Trigger_ThatMuch), PermanentDealsDamage({{~Permanent}}, Trigger_ThatMuch, EachPlayer(And([Other(Trigger_ThatPlayer), Opponent])))]))",
    "this creature can't be blocked": "PermanentRuleEffect({{~Permanent}}, [CantBeBlocked])",
    "{{ManaCost}}: Regenerate this creature": "Activated(PayMana({{ManaCost[0]}}), ActionList([RegeneratePermanent({{~Permanent}})]))",
    "{{ManaCost}}: This creature gets {{PTMod}} until end of turn": "Activated(PayMana({{ManaCost[0]}}), ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)]))",
    "{{~Permanent}} can't attack": "PermanentRuleEffect({{~Permanent}}, [CantAttack])"
  },
  "{{QuotedAbility[ThisCreature]}}": {
    "As long as {{Condition}}, this creature gets {{PTMod}} and has {{Hasable}}": "If({{Condition[0]}}, [PermanentLayerEffect(ThisPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])])])",
    "At the beginning of combat on your turn, you may pay {{ManaCost}}. If you do, put {{a}} {{CounterType}} counter on this creature": "TriggerA(AtTheBeginningOfCombatDuringAPlayersTurn(SinglePlayer(You)), ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [PutACounterOfTypeOnPermanent({{CounterType[0]}}, ThisPermanent)])]))",
    "At the beginning of your end step, return this creature to its owner's hand": "TriggerA(AtTheBeginningOfAPlayersEndStep(SinglePlayer(You)), ActionList([PutPermanentIntoItsOwnersHand(ThisPermanent)]))",
    "At the beginning of your end step, sacrifice this creature unless it attacked this turn": "TriggerA(AtTheBeginningOfAPlayersEndStep(SinglePlayer(You)), ActionList([Unless(PermanentPassesFilter(ThisPermanent, AttackedThisTurn), [SacrificePermanent(ThisPermanent)])]))",
    "At the beginning of your end step, tap this creature": "TriggerA(AtTheBeginningOfAPlayersEndStep(SinglePlayer(You)), ActionList([TapPermanent(ThisPermanent)]))",
    "At the beginning of your upkeep, destroy this creature unless you pay {{ManaCost}}": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), ActionList([MayCost(PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [DestroyPermanent(ThisPermanent)])]))",
    "At the beginning of your upkeep, destroy this creature unless you pay {{ManaCost}} for each {{Eachable(ThatPermanent)}}": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), ActionList([MayCost(PayManaForEach({{ManaCost[0]}}, {{Eachable(ThatPermanent=ThisPermanent)[0]}})), Unless(CostWasPaid, [DestroyPermanent(ThisPermanent)])]))",
    "At the beginning of your upkeep, exile the top card of your library. This creature gets {{PTModX}} until end of turn, where X is that card's mana value. You may play that card this turn": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), ActionList([ExileTopCardOfLibrary, CreatePermanentLayerEffectUntil(ThisPermanent, [AdjustPTX({{PTModX[0]}}, ManaValueOfTheCardExiledThisWay)], UntilEndOfTurn), CreatePlayerEffectUntil(You, [MayPlayExiledCard(TheCardExiledThisWay)], UntilEndOfTurn)]))",
    "At the beginning of your upkeep, exile this creature unless you pay {{Digits}} life": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), ActionList([MayCost(PayLife({{Digits[0]}})), Unless(CostWasPaid, [ExilePermanent(ThisPermanent)])]))",
    "At the beginning of your upkeep, if this creature isn't a token, create a token that's a copy of this creature": "TriggerI(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), PermanentPassesFilter(ThisPermanent, IsNonToken), ActionList([CreateTokens([TokenCopyOfPermanent(ThisPermanent, NoTokenCopyEffects)])]))",
    "At the beginning of your upkeep, put {{a}} {{CounterType}} counter on this creature": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, ThisPermanent)]))",
    "At the beginning of your upkeep, remove {{a}} {{CounterType}} counter from this creature": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), ActionList([RemoveACounterOfTypeFromPermanent({{CounterType[0]}}, ThisPermanent)]))",
    "At the beginning of your upkeep, sacrifice this creature": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), ActionList([SacrificePermanent(ThisPermanent)]))",
    "At the beginning of your upkeep, sacrifice this creature unless you discard a card": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), ActionList([MayCost(DiscardACard), Unless(CostWasPaid, [SacrificePermanent(ThisPermanent)])]))",
    "At the beginning of your upkeep, sacrifice this creature unless you pay its mana cost": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), ActionList([MayCost(PayManaCostOfPermanent(ThisPermanent)), Unless(CostWasPaid, [SacrificePermanent(ThisPermanent)])]))",
    "At the beginning of your upkeep, sacrifice this creature unless you pay {{Digits}} life": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), ActionList([MayCost(PayLife({{Digits[0]}})), Unless(CostWasPaid, [SacrificePermanent(ThisPermanent)])]))",
    "At the beginning of your upkeep, sacrifice this creature unless you pay {{ManaCost}}": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), ActionList([MayCost(PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [SacrificePermanent(ThisPermanent)])]))",
    "At the beginning of your upkeep, target opponent gains control of this creature unless you sacrifice a land": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), Targeted([TargetPlayer(Opponent)], ActionList([MayCost(SacrificeAPermanent(IsCardtype(Land))), Unless(CostWasPaid, [PlayerAction(Ref_TargetPlayer, GainControlOfPermanent(ThisPermanent))])])))",
    "At the beginning of your upkeep, you lose {{Digits}} life unless you sacrifice this creature": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), ActionList([MayCost(SacrificePermanent(ThisPermanent)), Unless(CostWasPaid, [LoseLife({{Digits[0]}})])]))",
    "At the beginning of your upkeep, you may have this creature become a copy of target creature, except it doesn't copy that creature's color and it has this ability": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), Targeted([TargetPermanent(IsCardtype(Creature))], ActionList([MayAction(CreatePermanentLayerEffect(ThisPermanent, [IsACopyOfPermanent(Ref_TargetPermanent, CopyEffects([KeepColor, AddAbilityVariable(ThisAbility)]))]))])))",
    "At the beginning of your upkeep, you may put another {{CounterType}} counter on this creature": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), ActionList([MayAction(PutACounterOfTypeOnPermanent({{CounterType[0]}}, ThisPermanent))]))",
    "At the beginning of your upkeep, you may turn this creature face down": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), ActionList([MayAction(TurnPermanentFaceDown(ThisPermanent))]))",
    "Boast - {{ManaCost}}: Put {{a}} {{CounterType}} counter on this creature": "ActivatedWithModifiers(PayMana({{ManaCost[0]}}), ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, ThisPermanent)]), Boast)",
    "Discard a card: This creature gets {{PTMod}} until end of turn": "Activated(DiscardACard, ActionList([CreatePermanentLayerEffectUntil(ThisPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)]))",
    "During your turn, this creature has {{Hasable}}": "If(IsPlayersTurn(You), [PermanentLayerEffect(ThisPermanent, [AddAbility([{{Hasable[0]}}])])])",
    "If this creature would deal combat damage to a player, prevent that damage. This creature's controller and that player each draw half that many cards, rounded down": "PreventDamage(CombatDamageWouldBeDealtByACreatureToARecipient(SinglePermanent(ThisPermanent), APlayer(AnyPlayer)), [PreventThatDamage, EachPlayerAction(Or([SinglePlayer(You), SinglePlayer(WouldDealDamage_DamageRecipientPlayer)]), DrawNumberCards(TheAmountOfDamagePreventedThisWay))])",
    "If this creature would die, exile it instead": "ReplaceWouldPutIntoGraveyard(APermanentWouldDie(SinglePermanent(ThisPermanent)), [ExileItInstead])",
    "If this creature would leave the battlefield, exile it instead of putting it anywhere else": "ReplaceWouldLeaveTheBattlefield(PermanentWouldLeaveTheBattlefield(ThisPermanent), [ExileItInstead])",
    "If this creature would untap during your untap step, remove {{a}} {{CounterType}} counter from it instead. If you do, untap it": "ReplaceWouldUntap(APermanentWouldUntapDuringsItsControllersUntapStep(SinglePermanent(ThisPermanent)), [MustCost(RemoveACounterOfTypeFromPermanent({{CounterType[0]}}, WouldUntapDuringsItsControllersUntapStep_ThatPermanent)), If(CostWasPaid, [UntapPermanent(WouldUntapDuringsItsControllersUntapStep_ThatPermanent)])])",
    "Other creatures with the same name as this creature are goaded": "EachPermanentRuleEffect(And([Other(ThisPermanent), IsCardtype(Creature), SharesANameWithPermanent(ThisPermanent)]), [IsGoadedByPlayer(You)])",
    "Other {{Creatures}} enter with an additional {{CounterType}} counter on them": "ReplaceWouldEnter(APermanentWouldEnterTheBattlefield(And([Other(ThisPermanent), {{Creatures[0]}}])), [EntersWithACounter({{CounterType[0]}})])",
    "Other {{Permanents}} have {{Hasable}}": "EachPermanentLayerEffect(And([Other(ThisPermanent), {{Permanents[0]}}]), [AddAbility([{{Hasable[0]}}])])",
    "Remove {{Number}} {{CounterType}} counters from this creature: {{ActivatedActions}}": "Activated(RemoveNumberCountersOfTypeFromPermanent({{Number[0]}}, {{CounterType[0]}}, ThisPermanent), {{ActivatedActions[0]}})",
    "Remove {{a}} {{CounterType}} counter from this creature: Regenerate this creature": "Activated(RemoveACounterOfTypeFromPermanent({{CounterType[0]}}, ThisPermanent), ActionList([RegeneratePermanent(ThisPermanent)]))",
    "Sacrifice a creature: This creature gets {{PTMod}} until end of turn": "Activated(SacrificeAPermanent(IsCardtype(Creature)), ActionList([CreatePermanentLayerEffectUntil(ThisPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)]))",
    "Sacrifice this creature: It deals {{Digits}} damage to any target": "Activated(SacrificePermanent(ThisPermanent), Targeted([AnyTarget], ActionList([SacrificedPermanentDealsDamage({{Digits[0]}}, Ref_AnyTarget)])))",
    "Sacrifice this creature: This creature deals {{Digits}} damage to any target": "Activated(SacrificePermanent(ThisPermanent), Targeted([AnyTarget], ActionList([SacrificedPermanentDealsDamage({{Digits[0]}}, Ref_AnyTarget)])))",
    "Sacrifice {{Number}} other creatures: Regenerate this creature": "Activated(SacrificeNumberPermanents({{Number[0]}}, And([Other(ThisPermanent), IsCardtype(Creature)])), ActionList([RegeneratePermanent(ThisPermanent)]))",
    "Spells your opponents cast that target this creature cost {{ManaCost}} more to cast": "EachPlayerEffect(Opponent, [IncreaseSpellCost(TargetsPermanent(ThisPermanent), PayMana({{ManaCost[0]}}))])",
    "This creature assigns combat damage equal to its toughness rather than its power": "PermanentRuleEffect(ThisPermanent, [AssignsToughnessCombatDamage])",
