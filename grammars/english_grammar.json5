    "You may pay {{ManaCost}} rather than pay the mana cost for {{PotentialSpells}} you cast": "PlayerEffect(You, [MayPayAlternateCostForSpells(PayMana({{ManaCost[0]}}), {{PotentialSpells[0]}})])",
    "You may pay {{Number}} {{EnergyCounters}} rather than pay the mana cost for {{PotentialSpells}} you cast": "PlayerEffect(You, [MayPayAlternateCostForSpells(PayEnergy({{Number[0]}}), {{PotentialSpells[0]}})])",
    "You may play an additional land on each of your turns": "PlayerEffect(You, [MayPlayAnAdditionalLand])",
    "You may play any colored card from your hand as a copy of a basic land card chosen at random that can produce mana of one of the card's colors": "PlayerEffect(You, [MayPlayColoredCardsFromHandAsRandomBasicLandOfThatCouldProduceOneOfThoseColors])",
    "You may play any number of lands on each of your turns": "PlayerEffect(You, [MayPlayAnyNumberOfLandsDuringThierTurn])",
    "You may play historic lands and cast historic spells from the top of your library": "PlayerEffect(You, [MayPlayLandsFromTopOfLibrary(IsHistoric), MayCastSpellsFromTopOfLibrary(IsHistoric)])",
    "You may play lands and cast spells from among cards in your graveyard you've surveilled this turn. If you cast a spell this way, you pay life equal to its mana value rather than paying its mana cost": "PlayerEffect(You, [MayPlayLandsFromAmongCardsInPlayersGraveyard(WasSurveilledThisTurn, You), MayCastSpellsFromAmongCardsInPlayersGraveyard(AnySpell, WasSurveilledThisTurn, You), MayCastSpellsFromAmongCardsInPlayersGraveyardForAlternateCost(AnySpell, WasSurveilledThisTurn, You, PayLifeEqualToItsManaValue)])",
    "You may play lands and cast spells from among cards you own in exile with {{CounterType}} counters on them": "PlayerEffect(You, [MayPlayLandsFromAmongExiled(And([OwnedByAPlayer(SinglePlayer(You)), HasACounterOfType({{CounterType[0]}})])), MayCastSpellsFromAmongExiled(AnySpell, And([OwnedByAPlayer(SinglePlayer(You)), HasACounterOfType({{CounterType[0]}})]))])",
    "You may play lands and cast spells from the top of any player's library": "PlayerEffect(You, [MayPlayLandsFromTopOfPlayersLibrary(AnyPlayer), MayCastSpellsFromTopOfPlayersLibrary(AnySpell, AnyPlayer)])",
    "You may play lands and cast spells from the top of your library. If you cast a spell this way, pay life equal to its mana value rather than pay its mana cost": "PlayerEffect(You, [MayPlayLandsFromTopOfLibrary(AnyCard), MayCastSpellsFromTopOfLibraryForAlternateCost(AnySpell, PayLifeEqualToItsManaValue)])",
    "You may play lands and cast spells from your graveyard": "PlayerEffect(You, [MayPlayLandsFromGraveyard(And([IsCardtype(Land), InAPlayersGraveyard(SinglePlayer(You))])), MayCastSpellsFromGraveyard(AnySpell)])",
    "You may play lands and cast creature spells from your graveyard. If you cast a spell this way, that creature enters with {{a}} {{CounterType}} counter on it": "PlayerEffect(You, [MayPlayLandsFromGraveyard(And([IsCardtype(Land), InAPlayersGraveyard(SinglePlayer(You))])), MayCastSpellsFromGraveyardWithEffect(IsCardtype(Creature), InAPlayersGraveyard(SinglePlayer(You)), [EntersWithACounter({{CounterType[0]}})])])",
    "You may play lands and cast {{PotentialSpells}} from among cards you exiled that have {{CounterType}} counters on them, and you may spend mana as though it were mana of any color to cast those spells": "PlayerEffect(You, [MayPlayLandsFromAmongExiled(And([WasExiledByPlayer(You), HasACounterOfType({{CounterType[0]}})])), MayCastSpellsFromAmongExiledAndMaySpendManaAsThoughAnyColorToCast({{PotentialSpells[0]}}, And([WasExiledByPlayer(You), HasACounterOfType({{CounterType[0]}})]))])",
