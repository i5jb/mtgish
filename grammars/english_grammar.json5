    "The next time {{a}} {{DamageSource}} of your choice would deal damage to you this turn, prevent that damage": "ActionList([ChooseADamageSource({{DamageSource[0]}}), CreateFuturePreventDamage(NextTimeDamageWouldBeDealtThisTurnBySourceToRecipient(TheChosenDamageSource, Player(You)), [PreventThatDamage])])",
    "The next time {{a}} {{DamageSource}} of your choice would deal damage to you this turn, prevent that damage. You gain life equal to the damage prevented this way": "ActionList([ChooseADamageSource({{DamageSource[0]}}), CreateFuturePreventDamage(NextTimeDamageWouldBeDealtThisTurnBySourceToRecipient(TheChosenDamageSource, Player(You)), [PreventThatDamage, GainLife(TheAmountOfDamagePreventedThisWay)])])",
    "The next time {{a}} {{DamageSource}} of your choice would deal damage to you this turn, prevent that damage. You gain life equal to the damage prevented this way.\nAt the beginning of your next upkeep, pay {{ManaCost}}. If you don't, you lose the game": "ActionList([ChooseADamageSource({{DamageSource[0]}}), CreateFuturePreventDamage(NextTimeDamageWouldBeDealtThisTurnBySourceToRecipient(TheChosenDamageSource, Player(You)), [PreventThatDamage, GainLife(TheAmountOfDamagePreventedThisWay)]), CreateFutureTrigger(AtTheBeginningOfPlayersNextUpkeep(You), ActionList([MustCost(PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [LoseTheGame])]))])",
    "The next {{CreatureSpell}} you cast this turn can be cast as though it had flash. That spell can't be countered. That creature enters with an additional {{CounterType}} counter on it": "ActionList([CreateFuturePlayerEffect(You, MayCastTheirNextSpellThisTurnAsThoughItHadFlashWithEffects({{CreatureSpell[0]}}, [CantBeCountered, EntersWithACounter({{CounterType[0]}})]))])",
    "The next {{Digits}} damage that would be dealt to target {{Creature}} this turn is dealt to another target {{Creature}} instead.\nDraw a card": "Targeted([TargetPermanent({{Creature[0]}}), TargetPermanent(And([Other(Ref_TargetPermanent1), {{Creature[1]}}]))], ActionList([CreateFutureReplaceWouldDealDamage(NextAmountOfDamageThatWouldBeDealtThisTurnToRecipient({{Digits[0]}}, Permanent(Ref_TargetPermanent1)), [DealToCreatureOrPlaneswalkerInstead(Ref_TargetPermanent2)]), DrawACard]))",
    "The next {{Digits}} damage that {{a}} {{DamageSource}} of your choice would deal to you and/or permanents you control this turn is dealt to any target instead": "Targeted([AnyTarget], ActionList([ChooseADamageSource({{DamageSource[0]}}), CreateFutureReplaceWouldDealDamage(NextAmountOfDamageThatWouldBeDealtThisTurnBySourceToARecipient({{Digits[0]}}, TheChosenDamageSource, APlayerOrAPermanent(SinglePlayer(You), ControlledByAPlayer(SinglePlayer(You)))), [DealToAnyTargetInstead(Ref_AnyTarget)])]))",
    "The next {{PotentialSpell}} you cast this turn can be cast as though it had flash. When you next cast {{a}} {{Spell}} this turn, put X {{CounterType}} counters on up to one target {{Creature}}, where X is {{GameNumber(ThatSpell)}}": "ActionList([CreateFuturePlayerEffect(You, MayCastTheirNextSpellThisTurnAsThoughItHadFlash({{PotentialSpell[0]}})), CreateFutureTrigger(WhenPlayerCastsTheirNextSpellThisTurn(You, {{Spell[0]}}), Targeted([UptoOneTargetPermanent({{Creature[0]}})], ActionList([PutNumberCountersOfTypeOnPermanent({{GameNumber(ThatSpell=Trigger_ThatSpell)[0]}}, {{CounterType[0]}}, Ref_TargetPermanent)])))])",
    "The next {{PotentialSpell}} you cast this turn can be cast as though it had flash. {{Reminder}}\nDraw a card": "ActionList([CreateFuturePlayerEffect(You, MayCastTheirNextSpellThisTurnAsThoughItHadFlash({{PotentialSpell[0]}})), DrawACard])",
    "The next {{PotentialSpell}} you cast this turn can't be countered.\nDraw a card": "ActionList([CreateFutureSpellEffect(TheNextSpellPlayerCastsThisTurn({{PotentialSpell[0]}}, You), [CantBeCountered]), DrawACard])",
    "The next {{SpecificCard}} you play this turn can be played as though it had flash.\nDraw a card": "ActionList([CreateFuturePlayerEffect(You, NextCardPlayedThisCanCanBePlayedAsThoughItHadFlash({{SpecificCard[0]}})), DrawACard])",
    "The owner of target {{Permanent}} puts it into their library {{Nth}} from the top or on the bottom": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PlayerChooseAnAction(OwnerOfPermanent(Ref_TargetPermanent), [PutPermanentInOwnersLibraryNthFromTheTop(Ref_TargetPermanent, {{Nth[0]}}), PutPermanentOnBottomOfOwnersLibrary(Ref_TargetPermanent)])]))",
    "The owner of target {{Permanent}} puts it into their library {{Nth}} from the top or on the bottom. You create a Clue token": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PlayerChooseAnAction(OwnerOfPermanent(Ref_TargetPermanent), [PutPermanentInOwnersLibraryNthFromTheTop(Ref_TargetPermanent, {{Nth[0]}}), PutPermanentOnBottomOfOwnersLibrary(Ref_TargetPermanent)]), CreateTokens([ClueToken])]))",
    "The owner of target {{Permanent}} puts it on the top or bottom of their library": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PlayerAction(OwnerOfPermanent(Ref_TargetPermanent), ReturnPermanentToTopOrBottomOfLibrary(Ref_TargetPermanent))]))",
    "The owner of target {{Permanent}} puts it on their choice of the top or bottom of their library": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PlayerAction(OwnerOfPermanent(Ref_TargetPermanent), ReturnPermanentToTopOrBottomOfLibrary(Ref_TargetPermanent))]))",
    "The owner of target {{Permanent}} shuffles it into their library, then draws {{Number}} cards": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PlayerActions(OwnerOfPermanent(Ref_TargetPermanent), [ShufflePermanentIntoLibrary(Ref_TargetPermanent), DrawNumberCards({{Number[0]}})])]))",
    "The owner of target {{Permanent}} shuffles it into their library, then exiles the top card of their library. If it's {{a}} {{SpecificCard}}, they put it onto the battlefield. Otherwise, they may cast it without paying its mana cost": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PlayerActions(OwnerOfPermanent(Ref_TargetPermanent), [ShufflePermanentIntoLibrary(Ref_TargetPermanent), ExileTopCardOfLibrary]), IfElse(ACardWasExiledThisWay({{SpecificCard[0]}}), [PlayerAction(OwnerOfPermanent(Ref_TargetPermanent), PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersNormally]))], [PlayerMayAction(OwnerOfPermanent(Ref_TargetPermanent), CastSpellFromExileWithoutPaying(AnySpell, TheCardExiledThisWay))])]))",
    "The owner of target {{Permanent}} shuffles it into their library, then reveals the top card of their library. If it's {{a}} {{SpecificCard}}, they put it onto the battlefield": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PlayerActions(OwnerOfPermanent(Ref_TargetPermanent), [ShufflePermanentIntoLibrary(Ref_TargetPermanent), RevealTopCardOfLibrary, PutTopCardOfLibraryOfTypeOnBattlefield({{SpecificCard[0]}}, [EntersNormally])])]))",
    "The owner of target {{Permanent}} shuffles it into their library. Then that player discovers X, where X is its mana value": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PlayerActions(OwnerOfPermanent(Ref_TargetPermanent), [ShufflePermanentIntoLibrary(Ref_TargetPermanent), Discover(ManaValueOfPermanent(Ref_TargetPermanent))])]))",
    "The owner of target {{Permanent}} shuffles it into their library. You may shuffle up to {{Number}} target cards from your graveyard into your library": "Targeted([TargetPermanent({{Permanent[0]}}), UptoNumberTargetGraveyardCards({{Number[0]}}, InAPlayersGraveyard(SinglePlayer(You)))], ActionList([PlayerAction(OwnerOfPermanent(Ref_TargetPermanent), ShufflePermanentIntoLibrary(Ref_TargetPermanent)), MayAction(ShuffleEachGraveyardCardIntoLibrary(Ref_TargetGraveyardCards))]))",
    "The owner of target {{Spell}} or {{Permanent}} puts it on their choice of the top or bottom of their library": "Targeted_Modal([Targeted([TargetSpell({{Spell[0]}})], ActionList([ReturnSpellToTopOrBottomOfLibrary(Ref_TargetSpell)])), Targeted([TargetPermanent({{Permanent[0]}})], ActionList([ReturnPermanentToTopOrBottomOfLibrary(Ref_TargetPermanent)]))])",
    "The owner of target {{Spell}}, {{Permanent}}, or card in a graveyard puts it on their choice of the top or bottom of their library": "Targeted_Modal([Targeted([TargetSpell({{Spell[0]}})], ActionList([ReturnSpellToTopOrBottomOfLibrary(Ref_TargetSpell)])), Targeted([TargetPermanent({{Permanent[0]}})], ActionList([ReturnPermanentToTopOrBottomOfLibrary(Ref_TargetPermanent)])), Targeted([TargetGraveyardCard(InAPlayersGraveyard(SinglePlayer(You)))], ActionList([ReturnGraveyardCardToTopOrBottomOfLibrary(Ref_TargetGraveyardCard)]))])",
    "Then return {{a}} {{SpecificCard}} with mana value X or less from your graveyard to the battlefield, where X is {{GameNumber[ThisSpell]}}": "ActionList([ReturnACardFromPlayersGraveyardToBattlefield(And([{{SpecificCard[0]}}, ManaValueIs(LessThanOrEqualTo({{GameNumber[ThisSpell][0]}}))]), You, [EntersNormally])])",
    "This spell deals damage equal to its intensity to target {{CreatureOrPlaneswalker}}.\nAll {{SpecificCards}} you own intensify by {{Digits}}": "Targeted([TargetPermanent({{CreatureOrPlaneswalker[0]}})], ActionList([SpellDealsDamage(ThisSpell, IntensityOfSpell(ThisSpell), Permanent(Ref_TargetPermanent)), PerpetuallyIncreaseIntensityOfCardsOwnedByPlayer({{SpecificCards[0]}}, You, {{Digits[0]}})]))",
    "This spell deals {{Digits}} damage to target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([SpellDealsDamage(ThisSpell, {{Digits[0]}}, Permanent(Ref_TargetPermanent))]))",
    "This turn and next turn, {{Creatures}} can't attack, and players and permanents can't be the targets of spells or activated abilities": "ActionList([CreateEachPermanentRuleEffectUntil({{Creatures[0]}}, [CantAttack], UntilEndOfTheNextTurn), CreateEachPlayerEffectUntil(AnyPlayer, [CantBeTheTargetOfSpellsOrAbilities(Or([IsSpell(AnySpell), ActivatedAbility]))], UntilEndOfTheNextTurn), CreateEachPermanentRuleEffectUntil(AnyPermanent, [CantBeTheTargetOfSpellsOrAbilities(Or([IsSpell(AnySpell), ActivatedAbility]))], UntilEndOfTheNextTurn)])",
    "This turn, instead of declaring blockers, each defending player chooses any number of creatures they control and divides them into a number of piles equal to the number of attacking creatures for whom that player is the defending player. Creatures those players control that can block additional creatures may likewise be put into additional piles. Assign each pile to a different one of those attacking creatures at random. Each creature in a pile that can block the creature that pile is assigned to does so": "ActionList([CreateGameEffect(UntilEndOfTurn, DefendingPlayersChooseCreaturesToDefendAttackersAtRandom)])",
    "This turn, whenever an attacking creature deals combat damage to you, it deals that much damage to its controller": "ActionList([CreateTriggerUntil(WhenACreatureDealsCombatDamageToAPlayer(And([IsAttacking, IsCardtype(Creature)]), SinglePlayer(You)), ActionList([PermanentDealsDamage(Trigger_ThatCreature, Trigger_ThatMuch, Player(ControllerOfPermanent(Trigger_ThatCreature)))]), UntilEndOfTurn)])",
    "Time travel": "ActionList([TimeTravel])",
    "Time travel. {{Reminder}}\nDraw a card": "ActionList([TimeTravel, DrawACard])",
    "Transform all {{Creatures}}. Prevent all combat damage that would be dealt this turn by creatures other than {{Zombies}} and {{Zombies}}": "ActionList([TransformEachPermanent({{Creatures[0]}}), CreatePreventDamageUntil(CombatDamageWouldBeDealtByACreature(And([IsCardtype(Creature), ExceptFor(Or([IsCreatureType({{Zombies[0]}}), IsCreatureType({{Zombies[1]}})]))])), [PreventThatDamage], UntilEndOfTurn)])",
    "Transform up to one target {{Creature}}. {{Permanents}} gain {{Hasable}} until end of turn": "Targeted([UptoOneTargetPermanent({{Creature[0]}})], ActionList([TransformPermanent(Ref_TargetPermanent), CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Triple target {{Creature}}'s power and toughness until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([TripleCreaturesPowerAndToughnessUntilEndOfTurn(Ref_TargetPermanent)]))",
    "Turn target {{Creature}} face down": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([TurnPermanentFaceDown(Ref_TargetPermanent)]))",
    "Turn target {{Creature}} face down. It's {{a}} {{PT}} {{Zombie}} artifact creature": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([TurnPermanentFaceDownAsArtifactCreature(Ref_TargetPermanent, {{PT[0]}}, {{Zombie[0]}})]))",
    "Turn target {{Creature}} face up": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([TurnPermanentFaceUp(Ref_TargetPermanent)]))",
    "Two target players exchange life totals. You create {{a}} {{PTX}} {{CreatureToken}}, where X is the difference between those players' life totals": "Targeted([TargetPlayer(AnyPlayer), TargetPlayer(Other(Ref_TargetPlayer1))], ActionList([PlayersExchangeLifeTotals(Ref_TargetPlayer1, Ref_TargetPlayer2), CreateTokens([TokenWithPT(PTX({{PTX[0]}}, DifferenceBetween(LifeTotalOfPlayer(Ref_TargetPlayer1), LifeTotalOfPlayer(Ref_TargetPlayer2))), {{CreatureToken[0]}}, [])])]))",
    "Unattach all {{Permanents}} from target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([UnattachEachPermanentFromPermanent({{Permanents[0]}}, Ref_TargetPermanent)]))",
    "Unless any player pays {{ManaCost}}, search your library for a card, put that card into your hand, then shuffle": "ActionList([AnyPlayerMayCost(AnyPlayer, PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [SearchLibrary([FindAGenericCard, PutFoundCardsIntoHand, Shuffle])])])",
    "Unless target player pays {{ManaCost}}, that player loses {{Digits}} life and you gain {{Digits}} life": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerMayCost(Ref_TargetPlayer, PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [PlayerAction(Ref_TargetPlayer, LoseLife({{Digits[0]}})), GainLife({{Digits[1]}})])]))",
    "Untap all creatures target player controls": "Targeted([TargetPlayer(AnyPlayer)], ActionList([UntapEachPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]))]))",
    "Untap all creatures you control and all creatures target opponent controls. You and that opponent each gain control of all creatures the other controls until end of turn. Those creatures gain {{Hasable}} until end of turn": "Targeted([TargetPlayer(Opponent)], ActionList([UntapEachPermanent(Or([And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]), And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))])])), ExchangeControlOfEachPermanentWithPlayerUntil(IsCardtype(Creature), Ref_TargetPlayer, UntilEndOfTurn), CreateEachPermanentLayerEffectUntil(ThePermanentsGainedControlOfThisWay, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Untap all {{Permanents}}": "ActionList([UntapEachPermanent({{Permanents[0]}})])",
    "Untap all {{Permanents}} and gain control of them until end of turn. They gain {{Hasable}} until end of turn": "ActionList([UntapEachPermanent({{Permanents[0]}}), GainControlOfEachPermanentUntil({{Permanents[0]}}, UntilEndOfTurn), CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "Untap all {{Permanents}}.\nDraw a card": "ActionList([UntapEachPermanent({{Permanents[0]}}), DrawACard])",
    "Untap all {{Permanents}}.\nWhenever {{a}} {{Creature}} blocks this turn, it gets {{PTMod}} until end of turn": "ActionList([UntapEachPermanent({{Permanents[0]}}), CreateTriggerUntil(WhenACreatureBlocks({{Creature[0]}}), ActionList([CreatePermanentLayerEffectUntil(Trigger_ThatCreature, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)]), UntilEndOfTurn)])",
    "Untap all {{Permanents}}. After this main phase, there is an additional combat phase followed by an additional main phase": "ActionList([UntapEachPermanent({{Permanents[0]}}), ThereIsAnAdditionalCombatPhaseAndAnAdditionalMainPhase])",
    "Untap all {{Permanents}}. After this phase, there is an additional combat phase": "ActionList([UntapEachPermanent({{Permanents[0]}}), ThereIsAnAdditionalCombatPhase])",
    "Untap all {{Permanents}}. If it's your combat phase, there is an additional combat phase after this phase": "ActionList([UntapEachPermanent({{Permanents[0]}}), If(And([IsPlayersTurn(You), IsDuringCombat]), [ThereIsAnAdditionalCombatPhase])])",
    "Untap all {{Permanents}}. If {{Condition}}, there is an additional combat phase after this phase, followed by an additional main phase": "ActionList([UntapEachPermanent({{Permanents[0]}}), If({{Condition[0]}}, [ThereIsAnAdditionalCombatPhaseAndAnAdditionalMainPhase])])",
    "Untap all {{Permanents}}. They gain {{Hasable}} and {{Hasable}} until end of turn": "ActionList([UntapEachPermanent({{Permanents[0]}}), CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)])",
    "Untap all {{Permanents}}. Until end of turn, whenever {{a}} {{Creature}} blocks, draw a card.\nDraw a card": "ActionList([UntapEachPermanent({{Permanents[0]}}), CreateTriggerUntil(WhenACreatureBlocks({{Creature[0]}}), ActionList([DrawACard]), UntilEndOfTurn), DrawACard])",
    "Untap all {{Permanents}}. {{Creatures}} get {{PTMod}} until end of turn": "ActionList([UntapEachPermanent({{Permanents[0]}}), CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])",
    "Untap any number of target {{Creatures}}. Prevent all combat damage that would be dealt to and dealt by those creatures this turn": "Targeted([AnyNumberOfTargetPermanents({{Creatures[0]}})], ActionList([UntapEachPermanent(Ref_TargetPermanents), CreatePreventDamageUntil(Or([CombatDamageWouldBeDealtByACreature(Ref_TargetPermanents), CombatDamageWouldBeDealtToARecipient(APermanent(Ref_TargetPermanents))]), [PreventThatDamage], UntilEndOfTurn)]))",
    "Untap one or two target {{Permanents}}. They each get {{PTMod}} until end of turn": "Targeted([OneOrTwoTargetPermanents({{Permanents[0]}})], ActionList([UntapEachPermanent(Ref_TargetPermanents), CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)]))",
    "Untap target {{Creature}} and each other {{Creature}} that shares a color with it. Those creatures get {{PTMod}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([UntapEachPermanent(Or([SinglePermanent(Ref_TargetPermanent), And([Other(Ref_TargetPermanent), {{Creature[1]}}, SharesAColorWithPermanent(Ref_TargetPermanent)])])), CreateEachPermanentLayerEffectUntil(WasUntappedThisWay, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)]))",
    "Untap target {{Creature}} and gain control of it until end of turn. That creature gains {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent), GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Untap target {{Creature}} and gain control of it until end of turn. That creature gains {{Hasable}} until end of turn. When you lose control of the creature, tap it": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent), GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), CreateFutureTrigger(WhenPlayerLosesControlOfPermanent(You, Ref_TargetPermanent), ActionList([TapPermanent(Trigger_ThatPermanent)]))]))",
    "Untap target {{Creature}} and gain control of it. It gains {{Hasable}} until end of turn. At the beginning of the next end step, sacrifice it. If you do, you gain life equal to {{GameNumber(ThatCreature)}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent), GainControlOfPermanent(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([MustCost(SacrificePermanent(Ref_TargetPermanent)), If(CostWasPaid, [GainLife({{GameNumber(ThatCreature=Ref_TargetPermanent)[0]}})])]))]))",
    "Untap target {{Creature}} and remove it from combat. Gain control of that creature until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent), RemoveCreatureFromCombat(Ref_TargetPermanent), GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn)]))",
    "Untap target {{Creature}}. It gets {{PTMod}} and gains {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Untap target {{Creature}}. It gets {{PTMod}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)]))",
    "Untap target {{Creature}}. It gets {{PTMod}} until end of turn and can block an additional creature this turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [CanBlockAnAdditionalCreature], UntilEndOfTurn)]))",
    "Untap target {{Creature}}. Prevent all combat damage that would be dealt to and dealt by that creature this turn.\nDraw a card at the beginning of the next turn's upkeep": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent), CreatePreventDamageUntil(Or([CombatDamageWouldBeDealtToRecipient(Permanent(Ref_TargetPermanent)), CombatDamageWouldBeDealtByCreature(Ref_TargetPermanent)]), [PreventThatDamage], UntilEndOfTurn), CreateFutureTrigger(AtTheBeginningOfTheNextTurnsUpkeep, ActionList([DrawACard]))]))",
    "Untap target {{Creature}}. Prevent all damage that would be dealt to it this turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent), CreatePreventDamageUntil(DamageWouldBeDealtToRecipient(Permanent(Ref_TargetPermanent)), [PreventThatDamage], UntilEndOfTurn)]))",
    "Untap target {{Creature}}. That creature blocks this turn if able.\nDraw a card": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent), CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [MustBlock], UntilEndOfTurn), DrawACard]))",
    "Untap target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent)]))",
    "Untap target {{Permanent}} and gain control of it until end of turn. It gains {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent), GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Untap target {{Permanent}}.\nDraw a card": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent), DrawACard]))",
    "Untap target {{Permanent}}.\nDraw a card at the beginning of the next turn's upkeep": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent), CreateFutureTrigger(AtTheBeginningOfTheNextTurnsUpkeep, ActionList([DrawACard]))]))",
    "Untap target {{Permanent}}. After this main phase, there is an additional combat phase followed by an additional main phase": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent), ThereIsAnAdditionalCombatPhaseAndAnAdditionalMainPhase]))",
    "Untap target {{Permanent}}. Until end of turn, it gains {{Hasable}}, {{Hasable}}, and \"{{QuotedAbility}}\"": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}]), AddAbility([{{QuotedAbility[0]}}])], UntilEndOfTurn)]))",
    "Untap up to {{Number}} target {{Creatures}}. They each get {{PTMod}} until end of turn": "Targeted([UptoNumberTargetPermanents({{Number[0]}}, {{Creatures[0]}})], ActionList([UntapEachPermanent(Ref_TargetPermanents), CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)]))",
