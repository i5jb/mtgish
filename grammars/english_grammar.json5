    "you may untap all {{Permanents}}. If you do, you can't cast spells until your next turn": "ActionList([MayCost(UntapEachPermanent({{Permanents[0]}})), If(CostWasPaid, [CreatePlayerEffectUntil(You, [CantCastSpells(AnySpell)], UntilPlayersNextTurn(You))])])",
    "you may untap target {{Creature}} and gain control of it until end of turn. That creature gains {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent), GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "you may untap target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([MayAction(UntapPermanent(Ref_TargetPermanent))]))",
    "you mill {{Number}} cards": "ActionList([MillNumberCards({{Number[0]}})])",
    "you mill {{Number}} cards, draw a card, and lose {{Digits}} life": "ActionList([MillNumberCards({{Number[0]}}), DrawACard, LoseLife({{Digits[0]}})])",
    "you put {{a}} {{CounterType}} counter on target {{Permanent}} and create a Food token": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([MayActions([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent), CreateTokens([FoodToken])])]))",
    "you scry {{Digits}}": "ActionList([Scry({{Digits[0]}})])",
