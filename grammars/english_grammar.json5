    "you may reveal cards from the top of your library until you reveal {{a}} {{SpecificCard}}. Put that card into your hand and the rest on the bottom of your library in a random order": "ActionList([MayAction(RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed({{SpecificCard[0]}}, [PutTheCardFoundThisWayIntoHand, PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder]))])",
    "you may reveal the top card of your library and put it into your hand. If you do, you lose life equal to its mana value": "ActionList([MayCost(RevealTopCardOfLibrary), If(CostWasPaid, [PutTopOfLibraryInHand, LoseLife(ManaValueOfTheCardRevealedThisWay)])])",
    "you may reveal the top card of your library. If it's {{a}} {{SpecificCard}}, you may put it onto the battlefield. If you revealed a card but didn't put it onto the battlefield, put it on the bottom of your library": "ActionList([MayCost(RevealTopCardOfLibrary), If(CostWasPaid, [MayCost(PutTopCardOfLibraryOfTypeOnBattlefield({{SpecificCard[0]}}, [EntersNormally])), Unless(CostWasPaid, [PutTopOfLibraryOnBottomOfLibrary])])])",
    "you may reveal the top card of your library. If you do, each opponent loses life equal to that card's mana value": "ActionList([MayCost(RevealTopCardOfLibrary), If(CostWasPaid, [EachPlayerAction(Opponent, LoseLife(ManaValueOfTheCardRevealedThisWay))])])",
    "you may reveal the top card of your library. If {{a}} {{SpecificCard}} is revealed this way, put it onto the battlefield tapped": "ActionList([MayActions([RevealTopCardOfLibrary, If(ACardWasRevealedThisWay({{SpecificCard[0]}}), [PutTopOfLibraryOnBattlefield([EntersTapped])])])])",
    "you may reveal your hand and put all {{SpecificCards}} from it onto the battlefield. If you do, discard your hand": "ActionList([MayCost(RevealHandAndPutEachCardOnBattlefield({{SpecificCards[0]}}, [EntersNormally])), If(CostWasPaid, [DiscardHand])])",
    "you may reveal your hand. If you do, you win the game if {{Condition}}": "ActionList([MayCost(RevealHand), If(CostWasPaid, [If({{Condition[0]}}, [WinTheGame])])])",
    "you may reveal {{a}} card you own named {{NamedCard}} from outside the game and put it into your hand": "ActionList([MayAction(RevealCardFromOutsideGameAndPutInHand(IsNamed(NamedCard({{NamedCard[0]}}))))])",
    "you may reveal {{a}} {{SpecificCard}} from your hand. If you do, you gain {{Digits}} life": "ActionList([MayCost(RevealACardOfTypeFromHand({{SpecificCard[0]}})), If(CostWasPaid, [GainLife({{Digits[0]}})])])",
    "you may sacrifice X {{Permanents}}. When you do, up to X target {{Permanents}} each get {{PTMod}} and gain {{Hasable}} and {{Hasable}} until end of turn": "ActionList([MayCost(SacrificeAnyNumberOfPermanents({{Permanents[0]}})), If(CostWasPaid, [ReflexiveTrigger(Targeted([UptoNumberTargetPermanents(TheNumberOfPermanentsSacrificedThisWay, {{Permanents[1]}})], ActionList([CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)])))])])",
    "you may sacrifice one or more {{Permanents}}. When you do, up to that many target {{Permanents}} gain {{Hasable}} until end of turn": "ActionList([MayCost(SacrificeAnyNumberOfPermanents({{Permanents[0]}})), If(CostWasPaid, [ReflexiveTrigger(Targeted([UptoNumberTargetPermanents(TheNumberOfPermanentsSacrificedThisWay, {{Permanents[1]}})], ActionList([CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])))])])",
    "you may sacrifice up to {{Number}} {{Permanents}}. When you sacrifice one or more {{Permanents}} this way, each opponent sacrifices that many {{Permanents}} of their choice": "ActionList([MayCost(SacrificeUptoNumberPermanents({{Number[0]}}, {{Permanents[0]}})), If(CostWasPaid, [ReflexiveTrigger(ActionList([EachPlayerAction(Opponent, SacrificeNumberPermanents(TheNumberOfPermanentsSacrificedThisWay, {{Permanents[2]}}))]))])])",
    "you may sacrifice {{Number}} {{Permanents}}. If you do, you may put {{a}} {{SpecificCard}} from your hand onto the battlefield tapped and attacking. It gains {{Hasable}} until end of turn": "ActionList([MayCost(SacrificeNumberPermanents({{Number[0]}}, {{Permanents[0]}})), If(CostWasPaid, [MayCost(PutACardFromHandOnBattlefield({{SpecificCard[0]}}, [EntersTapped, EntersAttacking])), If(CostWasPaid, [CreatePermanentLayerEffectUntil(ThePermanentPutOnTheBattlefieldThisWay, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])])])",
    "you may sacrifice {{a}} {{Creature}}. If you do, create X {{PT}} {{CreatureTokens}}, where X is the sacrificed creature's toughness": "ActionList([MayCost(SacrificeAPermanent({{Creature[0]}})), If(CostWasPaid, [CreateTokens([NumberTokens(ToughnessOfCreatureSacrificedThisWay, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])])])",
    "you may sacrifice {{a}} {{Creature}}. If you do, draw X cards, then mill X cards, where X is that creature's power": "ActionList([MayCost(SacrificeAPermanent({{Creature[0]}})), If(CostWasPaid, [CreateValueX(PowerOfTheSacrificedCreature), DrawNumberCards(ValueX), MillNumberCards(ValueX)])])",
    "you may sacrifice {{a}} {{Creature}}. If you do, look at the top X cards of your library, where X is that creature's mana value. You may put {{a}} {{SpecificCard}} from among them onto the battlefield. Put the rest on the bottom of your library in a random order": "ActionList([MayCost(SacrificeAPermanent({{Creature[0]}})), If(CostWasPaid, [LookAtTheTopNumberCardsOfLibrary(ManaValueOfTheSacrificedPermanent, [MayPutACardOfTypeOntoTheBattlefield({{SpecificCard[0]}}, [EntersNormally]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])])",
    "you may sacrifice {{a}} {{Permanent}} or discard {{a}} {{SpecificCard}}. If you do, draw a card": "ActionList([MayCost(Or([SacrificeAPermanent({{Permanent[0]}}), DiscardACardOfType({{SpecificCard[0]}})])), If(CostWasPaid, [DrawACard])])",
    "you may sacrifice {{a}} {{Permanent}} or pay {{ManaCost}}. When you do, tap target {{Permanent}}": "ActionList([MayCost(Or([SacrificeAPermanent({{Permanent[0]}}), PayMana({{ManaCost[0]}})])), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPermanent({{Permanent[1]}})], ActionList([TapPermanent(Ref_TargetPermanent)])))])])",
    "you may sacrifice {{a}} {{Permanent}} or {{a}} {{Permanent}}. If you do, you gain {{Digits}} life": "ActionList([MayCost(SacrificeAPermanent(Or([{{Permanent[0]}}, {{Permanent[1]}}]))), If(CostWasPaid, [GainLife({{Digits[0]}})])])",
    "you may sacrifice {{a}} {{Permanent}}. If you do, draft a card from {{Spellbook}} and put it onto the battlefield tapped": "ActionList([MayCost(SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [DraftACardFromSpellBook({{Spellbook[0]}}), PutCardFromHandOnBattlefield(TheCardDraftedThisWay, [EntersTapped])])])",
    "you may sacrifice {{a}} {{Permanent}}. If you do, draw a card": "ActionList([MayCost(SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [DrawACard])])",
    "you may sacrifice {{a}} {{Permanent}}. If you do, each opponent may sacrifice a permanent of their choice that shares a card type with it. For each opponent who doesn't, that player loses {{Digits}} life and you draw a card": "ActionList([MayCost(SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [ActionForEachPlayer(Opponent, [PlayerMayCost(EachablePlayer, SacrificeAPermanent(SharesACardtypeWithTheSacrificedPermanent)), Unless(CostWasPaid, [PlayerAction(EachablePlayer, LoseLife({{Digits[0]}})), DrawACard])])])])",
    "you may sacrifice {{a}} {{Permanent}}. If you do, mill {{Number}} cards. You may put {{a}} {{SpecificCard}} from among them into your hand": "ActionList([MayCost(SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [MillNumberCards({{Number[0]}}), MayAction(PutACardOfTypeMilledThisWayIntoHand({{SpecificCard[0]}}))])])",
