  "{{Activated(~Permanent)}}": {
    "Blight X, Return {{ThisPermanent}} to its owner's hand: {{ActivatedActions(X)}}. {{ActivateModifiersX}}. {{ActivateModifiers}}": "ActivatedWithModifiers(And([BlightX, PutPermanentIntoItsOwnersHand(ThisPermanent)]), {{ActivatedActions(X=ValueX)[0]}}, {{ActivateModifiersX[0]}})",
    "Boast - {{ManaCost}}: {{ActivatedActions(~Permanent)}}": "ActivatedWithModifiers(PayMana({{ManaCost[0]}}), {{ActivatedActions(~Permanent=^~Permanent)[0]}}, Boast)",
    "Boast - {{SacrificeAPermanentCost(ThatPermanent)}}: {{ActivatedActions[TheSacrificedPermanent](~Permanent)}}": "ActivatedWithModifiers({{SacrificeAPermanentCost(ThatPermanent=^~Permanent)[0]}}, {{ActivatedActions[TheSacrificedPermanent](~Permanent=^~Permanent)[0]}}, Boast)",
    "Exhaust - Waterbend {{ManaCost}}: {{ActivatedActions(~Permanent)}}": "ActivatedWithModifiers(Waterbend({{ManaCost[0]}}), {{ActivatedActions(~Permanent=^~Permanent)[0]}}, Exhaust)",
    "Exhaust - Waterbend {{ManaCost}}: {{ActivatedActions}}": "ActivatedWithModifiers(Waterbend({{ManaCost[0]}}), {{ActivatedActions[0]}}, Exhaust)",
    "Exhaust - {{EnergyCost}}: {{ActivatedActions(~Permanent)}}": "ActivatedWithModifiers({{EnergyCost[0]}}, {{ActivatedActions(~Permanent=^~Permanent)[0]}}, Exhaust)",
    "Exhaust - {{ManaCostX}}, {{TapSelfCost}}: {{ActivatedActions(X)}}": "ActivatedWithModifiers(And([PayManaX({{ManaCostX[0]}}, ValueX), {{TapSelfCost[0]}}]), {{ActivatedActions(X=ValueX)[0]}}, Exhaust)",
    "Exhaust - {{ManaCostX}}: {{ActivatedActions(~Permanent,X)}}": "ActivatedWithModifiers(PayManaX({{ManaCostX[0]}}, ValueX), {{ActivatedActions(~Permanent=^~Permanent,X=ValueX)[0]}}, Exhaust)",
    "Exhaust - {{ManaCost}}, {{TapSelfCost}}, {{ExileGraveyardCostX}}: Each other {{Creature}} gets {{PTModX}} until end of turn": "ActivatedWithModifiers(And([PayMana({{ManaCost[0]}}), {{TapSelfCost[0]}}, {{ExileGraveyardCostX[0]}}]), ActionList([CreateEachPermanentLayerEffectUntil(And([Other(ThisPermanent), {{Creature[0]}}]), [AdjustPTX({{PTModX[0]}}, ValueX)], UntilEndOfTurn)]), Exhaust)",
