    "Mill {{Number}} cards, then you may put {{a}} {{SpecificCard}} from your graveyard onto the battlefield tapped": "ActionList([MillNumberCards({{Number[0]}}), MayAction(PutACardFromPlayersGraveyardOnBattlefield({{SpecificCard[0]}}, You, [EntersTapped]))])",
    "Mill {{Number}} cards, then you may return {{a}} {{SpecificCard}} from among them to your hand": "ActionList([MillNumberCards({{Number[0]}}), PutACardFromGraveyardIntoHand(CardsOfTypeMilledThisWay({{SpecificCard[0]}}))])",
    "Mill {{Number}} cards, then you may return {{a}} {{SpecificCard}} from your graveyard to your hand": "ActionList([MillNumberCards({{Number[0]}}), MayAction(PutACardFromGraveyardIntoHand({{SpecificCard[0]}}))])",
    "Mill {{Number}} cards.\nDraw a card": "ActionList([MillNumberCards({{Number[0]}}), DrawACard])",
    "Mill {{Number}} cards. At the beginning of the next end step, exile {{Number}} cards from your graveyard": "ActionList([MillNumberCards({{Number[0]}}), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([ExileNumberGraveyardCards({{Number[0]}}, InAPlayersGraveyard(SinglePlayer(You)))]))])",
