  },
  "{{TriggerEffect[ExileACard](~Permanent)}}": {
    "When this Equipment enters, {{TriggerActions[ExileACard]}}": "TriggerA(WhenAPermanentEntersTheBattlefield(SinglePermanent({{~Permanent}})), {{TriggerActions[ExileACard][0]}})",
    "When this artifact enters, if {{Condition[ThatEnteringPermanent]}}, {{TriggerActions[ExileACard]}}": "TriggerI(WhenAPermanentEntersTheBattlefield(SinglePermanent({{~Permanent}})), {{Condition[ThatEnteringPermanent][0]}}, {{TriggerActions[ExileACard][0]}})",
    "When this artifact enters, {{TriggerActions[ExileACard]}}": "TriggerA(WhenAPermanentEntersTheBattlefield(SinglePermanent({{~Permanent}})), {{TriggerActions[ExileACard][0]}})",
    "When this creature enters, {{TriggerActions[ExileACard](~Permanent)}}": "TriggerA(WhenAPermanentEntersTheBattlefield(SinglePermanent({{~Permanent}})), {{TriggerActions[ExileACard](~Permanent=^~Permanent)[0]}})",
    "When this creature enters, {{TriggerActions[ExileACard]}}": "TriggerA(WhenAPermanentEntersTheBattlefield(SinglePermanent({{~Permanent}})), {{TriggerActions[ExileACard][0]}})",
    "When this enchantment enters, {{TriggerActions[ExileACard](~Permanent)}}": "TriggerA(WhenAPermanentEntersTheBattlefield(SinglePermanent({{~Permanent}})), {{TriggerActions[ExileACard](~Permanent=^~Permanent)[0]}})",
    "When this enchantment enters, {{TriggerActions[ExileACard]}}": "TriggerA(WhenAPermanentEntersTheBattlefield(SinglePermanent({{~Permanent}})), {{TriggerActions[ExileACard][0]}})",
    "When this land enters, {{TriggerActions[ExileACard]}}": "TriggerA(WhenAPermanentEntersTheBattlefield(SinglePermanent({{~Permanent}})), {{TriggerActions[ExileACard][0]}})",
    "When {{~Permanent}} enters, {{TriggerActions[ExileACard](~Permanent)}}": "TriggerA(WhenAPermanentEntersTheBattlefield(SinglePermanent({{~Permanent}})), {{TriggerActions[ExileACard](~Permanent=^~Permanent)[0]}})",
    "When {{~Permanent}} enters, {{TriggerActions[ExileACard]}}": "TriggerA(WhenAPermanentEntersTheBattlefield(SinglePermanent({{~Permanent}})), {{TriggerActions[ExileACard][0]}})",
    "Whenever this creature trains, {{TriggerActions[ExileACard](ThatPermanent)}}": "TriggerA(WhenAPermanentTrains(SinglePermanent({{~Permanent}})), {{TriggerActions[ExileACard](ThatPermanent=Trigger_ThatPermanent)[0]}})"
  },
  "{{TriggerEffect[ExileCards](~Permanent)}}": {
    "When this land enters, exile up to {{Number}} target cards from graveyards": "TriggerA(WhenAPermanentEntersTheBattlefield(SinglePermanent({{~Permanent}})), Targeted([UptoNumberTargetGraveyardCards({{Number[0]}}, AnyCardInAnyGraveyard)], ActionList([ExileEachGraveyardCard(Ref_TargetGraveyardCards)])))"
  },
  "{{TriggerEffect[FortifiedLand]}}": {
    "Whenever {{FortifiedLand}} becomes tapped, {{TriggerActions}}": "TriggerA(WhenAPermanentBecomesTapped(SinglePermanent(HostPermanent)), {{TriggerActions[0]}})",
    "Whenever {{FortifiedLand}} is tapped for mana, put {{a}} {{CounterType}} counter on target {{Creature}}. If that creature shares a color with the mana that land produced, create a Junk token": "TriggerA(WhenAPermanentIsTappedForMana(SinglePermanent(HostPermanent)), Targeted([TargetPermanent({{Creature[0]}})], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent), If(PermanentPassesFilter(Ref_TargetPermanent, SharesAColorWithAnyManaColorProduced), [CreateTokens([JunkToken])])])))"
  },
  "{{TriggerEffect[GraveyardActions](~GraveyardCard)}}": {
    "At the beginning of combat on your turn, if {{Condition}}, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerI(AtTheBeginningOfCombatDuringAPlayersTurn(SinglePlayer(You)), {{Condition[0]}}, {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "At the beginning of combat on your turn, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(AtTheBeginningOfCombatDuringAPlayersTurn(SinglePlayer(You)), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "At the beginning of each end step, if {{Condition}}, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerI(AtTheBeginningOfAPlayersEndStep(AnyPlayer), {{Condition[0]}}, {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "At the beginning of your end step, if {{Condition}}, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerI(AtTheBeginningOfAPlayersEndStep(SinglePlayer(You)), {{Condition[0]}}, {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "At the beginning of your first main phase, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(AtTheBeginningOfAPlayersFirstMainPhase(SinglePlayer(You)), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "At the beginning of your upkeep, if {{Condition}}, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerI(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), {{Condition[0]}}, {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "At the beginning of your upkeep, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "When the Ring tempts you, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(WhenTheRingTemptsAPlayer(SinglePlayer(You)), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "When you cast a spell for its warp cost, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), WasCastForItsWarpCost), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "When you cast your commander, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), IsYourCommander), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "When you draw your third card in a turn, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(WhenAPlayerDrawsTheirNthCardEachTurn(SinglePlayer(You), EqualTo(Integer(3))), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "When you gain life for the first time each turn, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(WhenAPlayerGainsLifeForTheFirstTimeEachTurn(SinglePlayer(You)), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "When you proliferate, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(WhenAPlayerProliferates(SinglePlayer(You)), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "When you roll a natural 20, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(WhenAPlayerRollsANatural20(SinglePlayer(You)), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "When you sacrifice {{a}} {{Permanent}}, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(WhenAPlayerSacrificesAPermanent(SinglePlayer(You), {{Permanent[0]}}), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "When {{a}} {{Creature}} enters, {{TriggerActions(~GraveyardCard,ThatCreature)}}": "FromGraveyard(TriggerA(WhenAPermanentEntersTheBattlefield({{Creature[0]}}), {{TriggerActions(~GraveyardCard=ThisGraveyardCard,ThatCreature=Trigger_ThatPermanent)[0]}}))",
    "When {{a}} {{Permanent}} enters, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(WhenAPermanentEntersTheBattlefield({{Permanent[0]}}), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "Whenever an opponent draws their second card each turn, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(WhenAPlayerDrawsTheirNthCardEachTurn(Opponent, EqualTo(Integer(2))), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "Whenever an opponent gains life, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(WhenAPlayerGainsLife(Opponent), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "Whenever an opponent is dealt damage by {{a}} {{Spell}} or by {{a}} {{Permanent}}, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(Or([WhenASpellDealsDamageToAPlayer({{Spell[0]}}, Opponent), WhenAPermanentDealsDamageToAPlayer({{Permanent[0]}}, AnyPlayer)]), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "Whenever another {{Creature}} dies, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(WhenACreatureOrPlaneswalkerDies(And([Other(ThisPermanent), {{Creature[0]}}])), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "Whenever another {{Permanent}} is put into your graveyard from the battlefield, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(WhenAPermanentIsPutIntoAPlayersGraveyard(And([Other(ThisPermanent), {{Permanent[0]}}]), SinglePlayer(You)), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "Whenever day becomes night or night becomes day, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(WhenDayBecomesNightOrNightBecomesDay, {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "Whenever one or more {{CounterType}} counters are put on {{a}} {{Permanent}}, if {{~GraveyardCard}} is in your graveyard, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerI(WhenAnyNumberOfCountersOfTypeArePutOnAPermanent({{CounterType[0]}}, {{Permanent[0]}}), CardIsInPlayersGraveyard({{~GraveyardCard}}, You), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "Whenever one or more {{Permanents}} deal combat damage to a player, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(WhenAnyNumberOfCreaturesDealCombatDamageToAPlayer({{Permanents[0]}}, AnyPlayer), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "Whenever you activate an exhaust ability, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(WhenAPlayerActivatesAnAbility(SinglePlayer(You), ExhaustAbility), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "Whenever you attack with one or more {{Creatures}}, if {{Condition}}, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerI(WhenAPlayerAttacksWithAnyNumberOfCreatures(SinglePlayer(You), {{Creatures[0]}}), {{Condition[0]}}, {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "Whenever you attack with one or more {{Creatures}}, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(WhenAPlayerAttacksWithAnyNumberOfCreatures(SinglePlayer(You), {{Creatures[0]}}), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "Whenever you attack with three or more creatures, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(WhenAPlayerAttacksWithANumberOfCreatures(SinglePlayer(You), GreaterThanOrEqualTo(Integer(3)), IsCardtype(Creature)), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "Whenever you cast {{a}} {{Spell}} from anywhere other than your hand, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), And([{{Spell[0]}}, WasntCastFromTheirHand])), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "Whenever you cast {{a}} {{Spell}}, if {{Condition(ThatSpell)}}, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerI(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), {{Condition(ThatSpell=Trigger_ThatSpell)[0]}}, {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "Whenever you cast {{a}} {{Spell}}, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "Whenever you commit a crime, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(WhenAPlayerCommitsACrime(SinglePlayer(You)), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "Whenever you complete a dungeon, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(WhenAPlayerCompletesADungeon(SinglePlayer(You)), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "Whenever you cycle another card, {{TriggerActions(~GraveyardCard)}}": "FromAnyZone(TriggerA(WhenAPlayerCyclesACard(SinglePlayer(You), Other(ThisCardInHand)), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "Whenever you draw your second card each turn, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(WhenAPlayerDrawsTheirNthCardEachTurn(SinglePlayer(You), EqualTo(Integer(2))), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "Whenever you put a name sticker on {{a}} {{Permanent}}, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(WhenAPlayerPutsANameStickerOnAPermanent(SinglePlayer(You), {{Permanent[0]}}), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "Whenever you put an art sticker on {{a}} {{Permanent}}, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(WhenAPlayerPutsAnArtStickerOnAPermanent(SinglePlayer(You), {{Permanent[0]}}), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "Whenever you roll to visit your Attractions, if you roll a 6, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerI(WhenAPlayerRollsToVisitTheirAttractions(SinglePlayer(You)), DiceResultIs(EqualTo(Integer(6))), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "Whenever you scry, if {{Condition}}, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerI(WhenAPlayerScrys(SinglePlayer(You)), {{Condition[0]}}, {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "Whenever your commander enters or attacks, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(Or([WhenAPermanentEntersTheBattlefield(IsYourCommander), WhenACreatureAttacks(IsYourCommander)]), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "Whenever {{a}} {{Creature}} enters, {{TriggerActions(~GraveyardCard,ThatCreature)}}": "FromGraveyard(TriggerA(WhenAPermanentEntersTheBattlefield({{Creature[0]}}), {{TriggerActions(~GraveyardCard=ThisGraveyardCard,ThatCreature=Trigger_ThatPermanent)[0]}}))",
    "Whenever {{a}} {{Permanent}} deals combat damage to a player, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(WhenACreatureDealsCombatDamageToAPlayer({{Permanent[0]}}, AnyPlayer), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "Whenever {{a}} {{Permanent}} enters and whenever you fully unlock a Room, {{TriggerActions(~GraveyardCard)}}": "TriggerA(Or([WhenAPermanentEntersTheBattlefield({{Permanent[0]}}), WhenAPlayerFullyUnlocksARoom(SinglePlayer(You), IsEnchantmentType(Room))]), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}})",
    "Whenever {{a}} {{Permanent}} enters, if {{Condition[ThatEnteringPermanent]}}, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerI(WhenAPermanentEntersTheBattlefield({{Permanent[0]}}), {{Condition[ThatEnteringPermanent][0]}}, {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "Whenever {{a}} {{Permanent}} enters, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(WhenAPermanentEntersTheBattlefield({{Permanent[0]}}), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "Whenever {{a}} {{Permanent}} is turned face up, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(WhenAPermanentIsTurnedFaceUp({{Permanent[0]}}), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "Whenever {{a}} {{SpecificCard}} is put into a graveyard from anywhere, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(WhenACardIsPutIntoAPlayersGraveyardFromAnywhere({{SpecificCard[0]}}, AnyPlayer), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "Whenever {{a}} {{SpecificCard}} leaves an opponent's graveyard, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(WhenAGraveyardCardLeaves(And([{{SpecificCard[0]}}, InAPlayersGraveyard(Opponent)])), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "Whenever {{a}} {{Spell}} deals damage to an opponent or battle, {{TriggerActions(~GraveyardCard)}}": "FromGraveyard(TriggerA(Or([WhenASpellDealsDamageToAPlayer({{Spell[0]}}, Opponent), WhenASpellDealsDamageToAPermanent({{Spell[0]}}, IsCardtype(Battle))]), {{TriggerActions(~GraveyardCard=^~GraveyardCard)[0]}}))"
  },
  "{{TriggerEffect[GraveyardCondition](~GraveyardCard)}}": {
    "At the beginning of the end step, if this card is in your graveyard with {{a}} {{SpecificCard}} directly above it, you may return this card to your hand": "FromGraveyard(TriggerI(AtTheBeginningOfAPlayersEndStep(AnyPlayer), CardIsInPlayersGraveyardWithACardAboveIt({{~GraveyardCard}}, You, {{SpecificCard[0]}}), ActionList([MayAction(ReturnGraveyardCardToHand({{~GraveyardCard}}))])))",
    "At the beginning of your upkeep, if this card is in your graveyard with {{Number}} or more {{SpecificCards}} above it, you may put this card onto the battlefield": "FromGraveyard(TriggerI(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), CardIsInPlayersGraveyardWithANumberOfCardsAboveIt({{~GraveyardCard}}, You, GreaterThanOrEqualTo({{Number[0]}}), {{SpecificCards[0]}}), ActionList([MayAction(PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersNormally]))])))",
    "At the beginning of your upkeep, if this card is in your graveyard with {{a}} {{SpecificCard}} directly above it, you may pay {{ManaCost}}. If you do, return this card to your hand": "FromGraveyard(TriggerI(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), CardIsInPlayersGraveyardWithACardAboveIt({{~GraveyardCard}}, You, {{SpecificCard[0]}}), ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [ReturnGraveyardCardToHand({{~GraveyardCard}})])])))",
    "At the beginning of your upkeep, if this card is in your graveyard, you may discard a card. If you do, return this card to your hand": "FromGraveyard(TriggerI(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), CardIsInPlayersGraveyard({{~GraveyardCard}}, You), ActionList([MayCost(DiscardACard), If(CostWasPaid, [PutGraveyardCardIntoHand({{~GraveyardCard}})])])))",
    "At the beginning of your upkeep, if this card is in your graveyard, you may exile {{a}} {{Black}} creature card other than this card from your graveyard. If you do, return this card to the battlefield": "FromGraveyard(TriggerI(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), CardIsInPlayersGraveyard({{~GraveyardCard}}, You), ActionList([MayCost(Exile([AGraveyardCard(And([IsColor({{Black[0]}}), IsCardtype(Creature), Other({{~GraveyardCard}}), InAPlayersGraveyard(SinglePlayer(You))]))])), If(CostWasPaid, [PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersNormally])])])))",
    "At the beginning of your upkeep, if this card is in your graveyard, you may pay {{Digits}} life. If you do, return it to your hand": "FromGraveyard(TriggerI(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), CardIsInPlayersGraveyard({{~GraveyardCard}}, You), ActionList([MayCost(PayLife({{Digits[0]}})), If(CostWasPaid, [PutGraveyardCardIntoHand({{~GraveyardCard}})])])))",
    "At the beginning of your upkeep, if this card is in your graveyard, you may pay {{ManaCost}}. If you do, return it to your hand": "FromGraveyard(TriggerI(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), CardIsInPlayersGraveyard({{~GraveyardCard}}, You), ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [PutGraveyardCardIntoHand({{~GraveyardCard}})])])))",
    "At the beginning of your upkeep, if this card is in your graveyard, {{TriggerActions}}": "FromGraveyard(TriggerI(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), CardIsInPlayersGraveyard({{~GraveyardCard}}, You), {{TriggerActions[0]}}))",
    "At the beginning of your upkeep, if this card is the only {{SpecificCard}} in your graveyard, you may return this card to the battlefield": "FromGraveyard(TriggerI(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), CardIsOnlyCardInPlayersGraveyard({{~GraveyardCard}}, {{SpecificCard[0]}}, You), ActionList([MayAction(PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersNormally]))])))",
    "When {{a}} {{Permanent}} is put into an opponent's graveyard from the battlefield, if this card is in your graveyard, exile this card": "FromGraveyard(TriggerI(WhenAPermanentIsPutIntoAPlayersGraveyard({{Permanent[0]}}, Opponent), CardIsInPlayersGraveyard({{~GraveyardCard}}, You), ActionList([ExileGraveyardCard({{~GraveyardCard}})])))",
    "Whenever an opponent mills {{a}} {{SpecificCard}}, if this card is in your graveyard, you may return it to your hand": "FromGraveyard(TriggerI(WhenAPlayerMillsASpecificCard(Opponent, {{SpecificCard[0]}}), CardIsInPlayersGraveyard({{~GraveyardCard}}, You), ActionList([MayAction(PutGraveyardCardIntoHand({{~GraveyardCard}}))])))",
    "Whenever combat damage is dealt to you or a planeswalker you control, if this card is in your graveyard, destroy target {{Permanent}}, then put this card on top of your library": "FromGraveyard(TriggerI(Or([WhenAPlayerIsDealtCombatDamage(SinglePlayer(You)), WhenAPermanentIsDealtCombatDamage(And([IsCardtype(Planeswalker), ControlledByAPlayer(SinglePlayer(You))]))]), CardIsInPlayersGraveyard({{~GraveyardCard}}, You), Targeted([TargetPermanent({{Permanent[0]}})], ActionList([DestroyPermanent(Ref_TargetPermanent), PutGraveyardCardOnTopOfLibrary({{~GraveyardCard}})]))))",
    "Whenever one or more {{CounterType}} counters are put on {{a}} {{Permanent}}, if this card is in your graveyard, you may put this card on top of your library": "FromGraveyard(TriggerI(WhenAnyNumberOfCountersOfTypeArePutOnAPermanent({{CounterType[0]}}, {{Permanent[0]}}), CardIsInPlayersGraveyard({{~GraveyardCard}}, You), ActionList([MayAction(PutGraveyardCardOnTopOfLibrary({{~GraveyardCard}}))])))",
    "Whenever one or more {{Creatures}} deal combat damage to a player, if this card is in your graveyard, you may pay {{ManaCost}}. If you do, return this card to your hand": "FromGraveyard(TriggerI(WhenAnyNumberOfCreaturesDealCombatDamageToAPlayer({{Creatures[0]}}, AnyPlayer), CardIsInPlayersGraveyard({{~GraveyardCard}}, You), ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [PutGraveyardCardIntoHand({{~GraveyardCard}})])])))",
    "Whenever one or more {{Creatures}} deal combat damage to a player, if this card is in your graveyard, you may pay {{ManaCost}}. If you do, you may cast it without paying its mana cost": "FromGraveyard(TriggerI(WhenAnyNumberOfCreaturesDealCombatDamageToAPlayer({{Creatures[0]}}, AnyPlayer), CardIsInPlayersGraveyard({{~GraveyardCard}}, You), ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [MayAction(CastGraveyardCardWithoutPaying({{~GraveyardCard}}))])])))",
    "Whenever you cast {{a}} {{Spell}}, if {{~GraveyardCard}} is in your graveyard, put {{a}} {{CounterType}} counter on {{~GraveyardCard}} for each {{Eachable(ThatSpell)}}. If {{~GraveyardCard}} has {{Number}} or more {{CounterType}} counters on it, return it to the battlefield and it perpetually gets {{PTMod}}": "FromGraveyard(TriggerI(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), CardIsInPlayersGraveyard({{~GraveyardCard}}, You), ActionList([PutNumberCountersOnGraveyardCard({{Eachable(ThatSpell=Trigger_ThatSpell)[0]}}, {{CounterType[0]}}, {{~GraveyardCard}}), If(GraveyardCardHasNumCounters({{~GraveyardCard}}, GreaterThanOrEqualTo({{Number[0]}}), {{CounterType[1]}}), [PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersNormally]), CreatePerpetualPermanentEffect(ThePermanentPutOnTheBattlefieldThisWay, [AdjustPT({{PTMod[0]}})])])])))",
    "Whenever you surveil, if this card is in your graveyard, you may pay {{Digits}} life. If you do, return this card to your hand": "FromGraveyard(TriggerI(WhenAPlayerSurveils(SinglePlayer(You)), CardIsInPlayersGraveyard({{~GraveyardCard}}, You), ActionList([MayCost(PayLife({{Digits[0]}})), If(CostWasPaid, [PutGraveyardCardIntoHand({{~GraveyardCard}})])])))",
    "Whenever {{a}} {{Creature}} deals combat damage to a player, if this card is in your graveyard, you may return this card to your hand": "FromGraveyard(TriggerI(WhenACreatureDealsCombatDamageToAPlayer({{Creature[0]}}, AnyPlayer), CardIsInPlayersGraveyard({{~GraveyardCard}}, You), ActionList([MayAction(PutGraveyardCardIntoHand({{~GraveyardCard}}))])))",
    "Whenever {{a}} {{Permanent}} an opponent controls dies while {{~GraveyardCard}} is in your graveyard, {{TriggerActions(ThatPlayer)}}": "FromGraveyard(TriggerA(If(CardIsInPlayersGraveyard({{~GraveyardCard}}, You), WhenACreatureOrPlaneswalkerDies(And([{{Permanent[0]}}, ControlledByAPlayer(Opponent)]))), {{TriggerActions(ThatPlayer=Trigger_ControllerOfThatPermanent)[0]}}))",
    "Whenever {{a}} {{Permanent}} dies while this card is in your graveyard, you may pay {{ManaCost}}. If you do, return this card from your graveyard to the battlefield": "FromGraveyard(TriggerA(If(CardIsInPlayersGraveyard({{~GraveyardCard}}, You), WhenACreatureOrPlaneswalkerDies({{Permanent[0]}})), ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersNormally])])])))",
    "Whenever {{a}} {{Permanent}} dies while this card is in your graveyard, you may pay {{ManaCost}}. If you do, return this card from your graveyard to your hand": "FromGraveyard(TriggerA(If(CardIsInPlayersGraveyard({{~GraveyardCard}}, You), WhenACreatureOrPlaneswalkerDies({{Permanent[0]}})), ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [PutGraveyardCardIntoHand({{~GraveyardCard}})])])))",
    "Whenever {{a}} {{Permanent}} enters, if this card is in your graveyard and it's your turn, you may cast it from your graveyard this turn": "FromGraveyard(TriggerI(WhenAPermanentEntersTheBattlefield({{Permanent[0]}}), And([CardIsInPlayersGraveyard({{~GraveyardCard}}, You), PlayerPassesFilter(You, IsTheirTurn)]), ActionList([CreatePlayerEffectUntil(You, [MayCastGraveyardCard({{~GraveyardCard}})], UntilEndOfTurn)])))",
    "Whenever {{a}} {{Permanent}} is put into your graveyard from the battlefield, if this card is in your graveyard, {{TriggerActions}}": "FromGraveyard(TriggerI(WhenAPermanentIsPutIntoAPlayersGraveyard({{Permanent[0]}}, SinglePlayer(You)), CardIsInPlayersGraveyard({{~GraveyardCard}}, You), {{TriggerActions[0]}}))"
  },
  "{{TriggerEffect[GraveyardZoneChange](~GraveyardCard)}}": {
    "When enchanted creature dies, mill cards equal to its power. Return this card to its owner's hand and up to one creature card milled this way to the battlefield under your control": "TriggerA(WhenACreatureOrPlaneswalkerDies(SinglePermanent(HostPermanent)), ActionList([MillNumberCards(PowerOfPermanent(Trigger_ThatPermanent)), ReturnEnchantingGraveyardCardToHand, MayAction(PutACardOfTypeMilledThisWayOntoTheBattlefield(IsCardtype(Creature), [EntersUnderPlayersControl(You)]))]))",
    "When this card is put into your graveyard from your library, you may put it onto the battlefield": "FromGraveyard(TriggerA(WhenACardIsPutIntoAPlayersGraveyardFromTheirLibrary(SingleCard(ThisCard), SinglePlayer(You)), ActionList([MayAction(PutGraveyardCardOntoBattlefield(Trigger_ThatGraveyardCard, [EntersNormally]))])))",
    "When this card is put into your graveyard from your library, {{TriggerActions}}": "FromGraveyard(TriggerA(WhenACardIsPutIntoAPlayersGraveyardFromTheirLibrary(SingleCard(ThisCard), SinglePlayer(You)), {{TriggerActions[0]}}))",
    "When this card is put into your hand from your graveyard, {{TriggerActions}}": "FromGraveyard(TriggerA(WhenAGraveyardCardIsPutIntoHand(And([SingleGraveyardCard({{~GraveyardCard}}), InAPlayersGraveyard(SinglePlayer(You))])), {{TriggerActions[0]}}))",
    "When {{EnchantedCreature}} dies, you may return this card from your graveyard to the battlefield attached to a creature that shares a creature type with that creature": "TriggerA(WhenACreatureOrPlaneswalkerDies(SinglePermanent(HostPermanent)), ActionList([ReturnEnchantingGraveyardCardToBattlefield([EntersAttachedToAPermanent(And([IsCardtype(Creature), SharesACreatureTypeWithDeadPermanent]))])]))",
    "When {{EnchantedPermanent}} dies, if {{Condition[WhenACreatureOrPlaneswalkerDies]}}, return this card to its owner's hand": "TriggerI(WhenACreatureOrPlaneswalkerDies(SinglePermanent(HostPermanent)), {{Condition[WhenACreatureOrPlaneswalkerDies][0]}}, ActionList([ReturnEnchantingGraveyardCardToHand]))",
    "When {{EnchantedPermanent}} dies, return this card from your graveyard to the battlefield": "TriggerA(WhenACreatureOrPlaneswalkerDies(SinglePermanent(HostPermanent)), ActionList([ReturnEnchantingGraveyardCardToBattlefield([EntersNormally])]))",
    "When {{EnchantedPermanent}} dies, return this card to its owner's hand": "TriggerA(WhenACreatureOrPlaneswalkerDies(SinglePermanent(HostPermanent)), ActionList([ReturnEnchantingGraveyardCardToHand]))",
    "When {{EnchantedPermanent}} dies, return this card to the battlefield at the beginning of the next end step": "TriggerA(WhenACreatureOrPlaneswalkerDies(SinglePermanent(HostPermanent)), ActionList([CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([ReturnEnchantingGraveyardCardToBattlefield([EntersNormally])]))]))",
    "When {{EnchantedPermanent}} dies, return this card to the battlefield transformed under your control": "TriggerA(WhenACreatureOrPlaneswalkerDies(SinglePermanent(HostPermanent)), ActionList([ReturnEnchantingGraveyardCardToBattlefield([EntersTransformed, EntersUnderPlayersControl(You)])]))",
    "When {{EnchantedPermanent}} dies, return this card to the battlefield transformed under your control attached to target opponent": "TriggerA(WhenACreatureOrPlaneswalkerDies(SinglePermanent(HostPermanent)), Targeted([TargetPlayer(Opponent)], ActionList([ReturnEnchantingGraveyardCardToBattlefield([EntersTransformed, EntersUnderPlayersControl(You), EntersAttachedToPlayer(Ref_TargetPlayer)])])))",
    "When {{EnchantedPermanent}} is put into a graveyard, you may return this card from your graveyard to your hand": "TriggerA(WhenACreatureOrPlaneswalkerDies(SinglePermanent(HostPermanent)), ActionList([MayAction(ReturnEnchantingGraveyardCardToHand)]))",
    "When {{EnchantedPermanent}} is put into a graveyard, you may return {{~GraveyardCard}} from your graveyard to your hand": "TriggerA(WhenACreatureOrPlaneswalkerDies(SinglePermanent(HostPermanent)), ActionList([MayAction(ReturnEnchantingGraveyardCardToHand)]))",
    "When {{~LibraryCard}} is put into your graveyard from your library, you may exile it. If you do, {{~Exiled}} deals {{Digits}} damage to each opponent and you gain {{Digits}} life": "FromGraveyard(TriggerA(WhenACardIsPutIntoAPlayersGraveyardFromTheirLibrary(SingleCard(ThisCard), SinglePlayer(You)), ActionList([MayCost(ExileGraveyardCard(Trigger_ThatGraveyardCard)), If(CostWasPaid, [ExiledCardDealsDamage(TheCardExiledThisWay, {{Digits[0]}}, EachPlayer(Opponent)), GainLife({{Digits[1]}})])])))"
  },
  "{{TriggerEffect[Haunt](~Exiled)}}": {
    "When the creature this card haunts dies, {{TriggerActions}}": "FromExile(TriggerA(WhenACreatureOrPlaneswalkerDies(SinglePermanent(TheCreatureHauntedByExiledCard({{~Exiled}}))), {{TriggerActions[0]}}))"
  },
  "{{TriggerEffect[Haunt](~Permanent)}}": {
    "When this creature enters or the creature it haunts dies, {{TriggerActions[WhenPermanentEntersTheBattlefieldOrTheCreatureItHauntsDies]}}": "TriggerA(WhenAPermanentEntersTheBattlefieldOrTheCreatureItHauntsDies(SinglePermanent({{~Permanent}})), {{TriggerActions[WhenPermanentEntersTheBattlefieldOrTheCreatureItHauntsDies][0]}})",
    "When this creature enters or the creature it haunts dies, {{TriggerActions}}": "TriggerA(WhenAPermanentEntersTheBattlefieldOrTheCreatureItHauntsDies(SinglePermanent({{~Permanent}})), {{TriggerActions[0]}})"
  },
  "{{TriggerEffect[Kicker](~Permanent)}}": {
    "At the beginning of the end step, if this creature wasn't kicked, {{TriggerActions(ThatPermanent)}}": "TriggerI(AtTheBeginningOfAPlayersEndStep(AnyPlayer), PermanentPassesFilter({{~Permanent}}, WasntKicked), {{TriggerActions(ThatPermanent=^~Permanent)[0]}})"
  },
  "{{TriggerEffect[Multikicker](~Permanent)}}": {
    "When this creature enters, {{TriggerActions[Multikicker](~Permanent)}}": "TriggerA(WhenAPermanentEntersTheBattlefield(SinglePermanent({{~Permanent}})), {{TriggerActions[Multikicker](~Permanent=^~Permanent)[0]}})",
    "When this creature enters, {{TriggerActions[Multikicker]}}": "TriggerA(WhenAPermanentEntersTheBattlefield(SinglePermanent({{~Permanent}})), {{TriggerActions[Multikicker][0]}})",
    "When this enchantment enters, {{TriggerActions[Multikicker](~Permanent)}}": "TriggerA(WhenAPermanentEntersTheBattlefield(SinglePermanent({{~Permanent}})), {{TriggerActions[Multikicker](~Permanent=^~Permanent)[0]}})",
    "When {{~Permanent}} enters, {{TriggerActions[Multikicker](~Permanent)}}": "TriggerA(WhenAPermanentEntersTheBattlefield(SinglePermanent({{~Permanent}})), {{TriggerActions[Multikicker](~Permanent=^~Permanent)[0]}})"
  },
  "{{TriggerEffect[TheChosenColor,TheChosenPlayer](~Permanent)}}": {
    "When the chosen color isn't the most common color among nontoken permanents the chosen player controls or is tied for most common, {{TriggerActions(~Permanent)}}": "TriggerA(WhenAColorIsntTheMostCommonOrTiedForMostCommonColorAmongPermanents(TheChosenColor, And([IsNonToken, ControlledByAPlayer(SinglePlayer(TheChosenPlayer))])), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "When the chosen player controls no nontoken permanents of the chosen color, {{TriggerActions(~Permanent)}}": "TriggerA(WhenAPlayerControlsNoPermanents(SinglePlayer(TheChosenPlayer), And([IsNonToken, IsColor(TheChosenColor)])), {{TriggerActions(~Permanent=^~Permanent)[0]}})"
  },
  "{{TriggerEffect[TheChosenColor](~Permanent)}}": {
    "At the beginning of each opponent's upkeep, {{TriggerActions[TheChosenColor](~Permanent,ThatPlayer)}}": "TriggerA(AtTheBeginningOfAPlayersUpkeep(Opponent), {{TriggerActions[TheChosenColor](~Permanent=^~Permanent,ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "When you control no permanents of the chosen color, {{TriggerActions(~Permanent)}}": "TriggerA(WhenAPlayerControlsNoPermanents(SinglePlayer(You), IsColor(TheChosenColor)), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "Whenever a creature of the chosen color deals damage to you or {{a}} {{Creature}}, {{TriggerActions(~Permanent,ThatMuch,ThatCreature)}}": "TriggerA(Or([WhenAPermanentDealsDamageToAPlayer(And([IsCardtype(Creature), IsColor(TheChosenColor)]), SinglePlayer(You)), WhenAPermanentDealsDamageToAPermanent(And([IsCardtype(Creature), IsColor(TheChosenColor)]), {{Creature[0]}})]), {{TriggerActions(~Permanent=^~Permanent,ThatMuch=Trigger_AmountOfDamageDealt,ThatCreature=Trigger_ThatPermanent)[0]}})",
    "Whenever you cast a spell of the chosen color, {{TriggerActions(~Permanent)}}": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), IsColor(TheChosenColor)), {{TriggerActions(~Permanent=^~Permanent)[0]}})"
  },
  "{{TriggerEffect[TheChosenColor]}}": {
    "Whenever a player casts a spell of the chosen color, {{TriggerActions(ThatPlayer)}}": "TriggerA(WhenAPlayerCastsASpell(AnyPlayer, IsColor(TheChosenColor)), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "Whenever a player casts a spell of the chosen color, {{TriggerActions}}": "TriggerA(WhenAPlayerCastsASpell(AnyPlayer, IsColor(TheChosenColor)), {{TriggerActions[0]}})",
    "Whenever a source of the chosen color deals damage to you, {{TriggerActions}}": "TriggerA(WhenASourceDealsDamageToAPlayer(IsColor(TheChosenColor), SinglePlayer(You)), {{TriggerActions[0]}})",
    "Whenever you cast a spell of the chosen color, {{TriggerActions}}": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), IsColor(TheChosenColor)), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Permanent}} is tapped for mana of the chosen color, its controller adds an additional one mana of that color": "TriggerA(WhenAPermanentIsTappedForManaOfColor({{Permanent[0]}}, ManaOfTheChosenColor), ActionList([PlayerAction(Trigger_ControllerOfThatPermanent, AddMana(ManaOfTheChosenColor))]))",
    "Whenever {{a}} {{Permanent}}'s ability causes you to add one or more mana of the chosen color, add an additional one mana of that color": "TriggerA(WhenAnAbilityCausesAPlayerToAddMana(AbilityOfAPermanent({{Permanent[0]}}), SinglePlayer(You), ManaOfTheChosenColor), ActionList([AddMana(ManaOfTheChosenColor)]))"
  },
  "{{TriggerEffect[TheChosenColors]}}": {
    "Whenever you cast {{a}} {{Spell}}, if {{Condition[TheChosenColors](ThatSpell)}}, {{TriggerActions[TheChosenColors](ThatSpell)}}": "TriggerI(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), {{Condition[TheChosenColors](ThatSpell=Trigger_ThatSpell)[0]}}, {{TriggerActions[TheChosenColors](ThatSpell=Trigger_ThatSpell)[0]}})"
  },
  "{{TriggerEffect[TheChosenCreatureType](~Permanent)}}": {
    "When this creature enters, {{TriggerActions[TheChosenCreatureType]}}": "TriggerA(WhenAPermanentEntersTheBattlefield(SinglePermanent({{~Permanent}})), {{TriggerActions[TheChosenCreatureType][0]}})",
    "When {{~Permanent}} enters, {{TriggerActions[TheChosenCreatureType](ThatPermanent)}}": "TriggerA(WhenAPermanentEntersTheBattlefield(SinglePermanent({{~Permanent}})), {{TriggerActions[TheChosenCreatureType](ThatPermanent=Trigger_ThatPermanent)[0]}})",
    "Whenever a permanent you control of the chosen type enters, {{TriggerActions(~Permanent)}}": "TriggerA(WhenAPermanentEntersTheBattlefield(And([IsPermanent, ControlledByAPlayer(SinglePlayer(You)), IsCreatureTypeVariable(TheChosenCreatureType)])), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "Whenever another creature you control of the chosen type enters, {{TriggerActions(~Permanent)}}": "TriggerA(WhenAPermanentEntersTheBattlefield(And([Other(ThisPermanent), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), IsCreatureTypeVariable(TheChosenCreatureType)])), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "Whenever you cast a spell of the chosen type, {{TriggerActions(~Permanent)}}": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), IsCreatureTypeVariable(TheChosenCreatureType)), {{TriggerActions(~Permanent=^~Permanent)[0]}})"
  },
  "{{TriggerEffect[TheChosenCreatureType]}}": {
    "At the beginning of your end step, {{TriggerActions[TheChosenCreatureType]}}": "TriggerA(AtTheBeginningOfAPlayersEndStep(SinglePlayer(You)), {{TriggerActions[TheChosenCreatureType][0]}})",
    "At the beginning of your upkeep, {{TriggerActions[TheChosenCreatureType]}}": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), {{TriggerActions[TheChosenCreatureType][0]}})",
    "Whenever a creature an opponent controls of the noted type dies, {{TriggerActions}}": "TriggerA(WhenACreatureOrPlaneswalkerDies(And([IsCardtype(Creature), ControlledByAPlayer(Opponent), IsCreatureTypeVariable(TheNotedCreatureType)])), {{TriggerActions[0]}})",
    "Whenever a creature of the chosen type dies, {{TriggerActions}}": "TriggerA(WhenACreatureOrPlaneswalkerDies(And([IsCardtype(Creature), IsCreatureTypeVariable(TheChosenCreatureType)])), {{TriggerActions[0]}})",
    "Whenever a creature you control of the chosen type enters or attacks, {{TriggerActions}}": "TriggerA(Or([WhenAPermanentEntersTheBattlefield(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), IsCreatureTypeVariable(TheChosenCreatureType)])), WhenACreatureAttacks(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), IsCreatureTypeVariable(TheChosenCreatureType)]))]), {{TriggerActions[0]}})",
    "Whenever a nontoken creature you control of the chosen type enters, {{TriggerActions(ThatCreature)}}": "TriggerA(WhenAPermanentEntersTheBattlefield(And([IsNonToken, IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), IsCreatureTypeVariable(TheChosenCreatureType)])), {{TriggerActions(ThatCreature=ThatEnteringPermanent)[0]}})",
    "Whenever a permanent you control of the chosen type enters, {{TriggerActions}}": "TriggerA(WhenAPermanentEntersTheBattlefield(And([IsPermanent, ControlledByAPlayer(SinglePlayer(You)), IsCreatureTypeVariable(TheChosenCreatureType)])), {{TriggerActions[0]}})",
    "Whenever you cast a creature spell of the chosen type, {{TriggerActions}}": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), And([IsCardtype(Creature), IsCreatureTypeVariable(TheChosenCreatureType)])), {{TriggerActions[0]}})",
    "Whenever you cast a spell of the chosen type, {{TriggerActions(ThatSpell)}}": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), IsCreatureTypeVariable(TheChosenCreatureType)), {{TriggerActions(ThatSpell=Trigger_ThatSpell)[0]}})",
    "Whenever you cast a spell of the chosen type, {{TriggerActions}}": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), IsCreatureTypeVariable(TheChosenCreatureType)), {{TriggerActions[0]}})"
  },
  "{{TriggerEffect[TheChosenLandType]}}": {
    "Whenever a land of the chosen type an opponent controls becomes tapped, {{TriggerActions}}": "TriggerA(WhenAPermanentBecomesTapped(And([IsCardtype(Land), IsLandTypeVariable(TheChosenLandType)])), {{TriggerActions[0]}})"
  },
  "{{TriggerEffect[TheChosenName]}}": {
    "Whenever a creature you control with the chosen name attacks, {{TriggerActions(ThatCreature)}}": "TriggerA(WhenACreatureAttacks(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), IsNamed(TheChosenName)])), {{TriggerActions(ThatCreature=Trigger_ThatCreature)[0]}})",
    "Whenever a creature you control with the chosen name deals combat damage to a player, {{TriggerActions}}": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), IsNamed(TheChosenName)]), AnyPlayer), {{TriggerActions[0]}})",
    "Whenever a creature you control with the chosen name enters, {{TriggerActions[TheChosenName]}}": "TriggerA(WhenAPermanentEntersTheBattlefield(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), IsNamed(TheChosenName)])), {{TriggerActions[TheChosenName][0]}})",
    "Whenever an opponent casts a spell with the chosen name, {{TriggerActions(ThatPlayer)}}": "TriggerA(WhenAPlayerCastsASpell(Opponent, IsNamed(TheChosenName)), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "Whenever you cast an instant or sorcery spell with the chosen name, {{TriggerActions(ThatSpell)}}": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), And([Or([IsCardtype(Instant), IsCardtype(Sorcery)]), IsNamed(TheChosenName)])), {{TriggerActions(ThatSpell=Trigger_ThatSpell)[0]}})",
    "Whenever you cast an instant or sorcery spell with the chosen name, {{TriggerActions}}": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), And([Or([IsCardtype(Instant), IsCardtype(Sorcery)]), IsNamed(TheChosenName)])), {{TriggerActions[0]}})",
    "Whenever you cast {{a}} {{Spell}}, if {{Condition[TheChosenName](ThatSpell)}}, {{TriggerActions(ThatSpell)}}": "TriggerI(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), {{Condition[TheChosenName](ThatSpell=Trigger_ThatSpell)[0]}}, {{TriggerActions(ThatSpell=Trigger_ThatSpell)[0]}})"
  },
  "{{TriggerEffect[TheChosenNumber](~Permanent)}}": {
    "When an opponent casts a spell with mana value equal to the chosen number, sacrifice {{~Permanent}}. If you do, copy that spell, and you may choose new targets for the copy": "TriggerA(WhenAPlayerCastsASpell(Opponent, ManaValueIs(EqualTo(TheChosenNumber))), ActionList([MustCost(SacrificePermanent({{~Permanent}})), If(CostWasPaid, [CopySpellAndMayChooseNewTargets(Trigger_ThatSpell)])]))"
  },
  "{{TriggerEffect[TheChosenNumber]}}": {
    "At the beginning of your upkeep, {{TriggerActions[ChooseANumber]}}": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), {{TriggerActions[ChooseANumber][0]}})",
    "Whenever an opponent casts a spell with mana value, power, or toughness equal to the chosen number, {{TriggerActions(ThatPlayer)}}": "TriggerA(WhenAPlayerCastsASpell(Opponent, Or([ManaValueIs(EqualTo(TheChosenNumber)), PowerIs(EqualTo(TheChosenNumber)), ToughnessIs(EqualTo(TheChosenNumber))])), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "Whenever one or more creatures attack one of your opponents, if any of those creatures have power or toughness equal to the chosen number, {{~Permanent}} deals damage equal to its power to defending player": "TriggerI(WhenAnyNumberOfCreaturesAttackAPlayer(IsCardtype(Creature), Opponent), APermanentPassesFilter(Trigger_ThosePermanents, And([PowerIs(EqualTo(TheChosenNumber)), ToughnessIs(EqualTo(TheChosenNumber))])), ActionList([PermanentDealsDamage(ThisPermanent, PowerOfPermanent(ThisPermanent), Player(Trigger_ThatPlayer))]))"
  },
  "{{TriggerEffect[TheChosenPermanent](~Permanent)}}": {
    "When this creature leaves the battlefield, sacrifice the chosen creature": "TriggerA(WhenAPermanentLeavesTheBattlefield(SinglePermanent({{~Permanent}})), ActionList([SacrificePermanent(TheChosenPermanent)]))"
  },
  "{{TriggerEffect[TheChosenPlayer](~Permanent)}}": {
    "At the beginning of the chosen player's upkeep, {{TriggerActions(~Permanent,ThatPlayer)}}": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(TheChosenPlayer)), {{TriggerActions(~Permanent=^~Permanent,ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "Whenever this creature is dealt damage, {{TriggerActions[TheChosenPlayer](ThatPermanent,ThatMuch)}}": "TriggerA(WhenAPermanentIsDealtDamage(SinglePermanent({{~Permanent}})), {{TriggerActions[TheChosenPlayer](ThatPermanent=Trigger_ThatCreatureOrPlaneswalker,ThatMuch=Trigger_AmountOfDamageDealt)[0]}})"
  },
  "{{TriggerEffect[TheChosenPlayer]}}": {
    "Whenever the chosen player casts {{a}} {{Spell}}, {{TriggerActions(ThatPlayer)}}": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(TheChosenPlayer), {{Spell[0]}}), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "Whenever {{a}} {{Creature}} deals combat damage to a player, {{TriggerActions[TheChosenPlayer](ThatPermanent,ThatMuch)}}": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer({{Creature[0]}}, AnyPlayer), {{TriggerActions[TheChosenPlayer](ThatPermanent=Trigger_ThatCreature,ThatMuch=Trigger_ThatMuch)[0]}})"
  },
  "{{TriggerEffect[TheChosenTwoPlayers]}}": {
    "Whenever damage is dealt to one of the chosen players, the other chosen player also loses that much life": "TriggerA(WhenAPlayerIsDealtDamage(TheChosenPlayers), ActionList([PlayerAction(TheOtherChosenPlayer(Trigger_ThatPlayer), LoseLife(Trigger_AmountOfDamageDealt))]))"
  },
  "{{TriggerEffect[TheExiledCard](~Permanent)}}": {
    "When this creature leaves the battlefield, {{TriggerActions[TheExiledCard]}}": "TriggerA(WhenAPermanentLeavesTheBattlefield(SinglePermanent({{~Permanent}})), {{TriggerActions[TheExiledCard][0]}})",
    "When this enchantment leaves the battlefield, {{TriggerActions[TheExiledCard]}}": "TriggerA(WhenAPermanentLeavesTheBattlefield(SinglePermanent({{~Permanent}})), {{TriggerActions[TheExiledCard][0]}})",
    "Whenever a land an opponent controls with the same name as the exiled card enters, {{TriggerActions(~Permanent,ThatPlayer)}}": "TriggerA(WhenAPermanentEntersTheBattlefieldUnderAPlayersControl(And([IsCardtype(Land), SharesANameWithExiled(TheExiledCard)]), Opponent), {{TriggerActions(~Permanent=^~Permanent,ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "Whenever a player plays a land or casts a spell, if it shares a card type with the exiled card, {{TriggerActions(~Permanent,ThatPlayer)}}": "TriggerI(WhenAPlayerPlaysALand(AnyPlayer, IsCardtype(Land)), PermanentPassesFilter(Trigger_ThatPermanent, SharesACardtypeWithExiledCard(TheExiledCard)), {{TriggerActions(~Permanent=^~Permanent,ThatPlayer=Trigger_ThatPlayer)[0]}}), TriggerI(WhenAPlayerCastsASpell(AnyPlayer, AnySpell), SpellPassesFilter(Trigger_ThatSpell, SharesACardtypeWithExiledCard(TheExiledCard)), {{TriggerActions(~Permanent=^~Permanent,ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "Whenever this Vehicle deals combat damage to a player, {{TriggerActions[TheExiledCard](~Permanent)}}": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(HostPermanent), AnyPlayer), {{TriggerActions[TheExiledCard](~Permanent=^~Permanent)[0]}})",
    "Whenever this creature attacks, create a tapped and attacking token that's a copy of the exiled card, except it's {{a}} {{Zombie}} in addition to its other types. Sacrifice that token at end of combat": "TriggerA(WhenACreatureAttacks(SinglePermanent({{~Permanent}})), ActionList([CreateTokensWithFlags([TokenCopyOfExiledCard(TheExiledCard, TokenCopyEffects([AddCreatureTypes([{{Zombie[0]}}])]))], [EntersTapped, EntersAttacking]), CreateFutureTrigger(AtTheNextEndOfCombat, ActionList([SacrificePermanent(TheCreatedToken)]))]))",
    "Whenever this creature attacks, if a card is exiled with it, it gets {{PTModX}} until end of turn, where X is the power of the exiled card": "TriggerI(WhenACreatureAttacks(SinglePermanent({{~Permanent}})), ACardWasExiledThisWay(AnyCard), ActionList([CreatePermanentLayerEffectUntil(Trigger_ThatPermanent, [AdjustPTX({{PTModX[0]}}, PowerOfTheExiledCreature)], UntilEndOfTurn)]))",
    "Whenever this creature attacks, if a card is exiled with it, you may cast the exiled card without paying its mana cost": "TriggerI(WhenACreatureAttacks(SinglePermanent({{~Permanent}})), AnExiledCardPassesFilter(TheExiledCards, AnyCard), ActionList([MayAction(CastAnyNumberOfExiledCardsWithoutPaying(TheExiledCards))]))",
    "Whenever this creature deals combat damage to a player, if there are cards exiled with it, you may play one of them without paying its mana cost": "TriggerI(WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent({{~Permanent}}), AnyPlayer), AnExiledCardPassesFilter(TheExiledCards, InExile), ActionList([MayAction(PlayACardFromExileWithoutPaying(TheExiledCards))]))",
    "Whenever this creature deals combat damage, {{TriggerActions[TheExiledCard](ThatPermanent)}}": "TriggerA(WhenACreatureDealsCombatDamage(SinglePermanent({{~Permanent}})), {{TriggerActions[TheExiledCard](ThatPermanent=Trigger_ThatCreature)[0]}})",
    "Whenever {{~Permanent}} becomes crewed, {{TriggerActions[TheExiledCard](ThatPermanent)}}": "TriggerA(WhenAVehicleBecoemsCrewed(SinglePermanent(ThisPermanent)), {{TriggerActions[TheExiledCard](ThatPermanent=Trigger_ThatPermanent)[0]}})"
  },
  "{{TriggerEffect[TheExiledCard]}}": {
    "At the beginning of combat on your turn, {{TriggerActions[TheExiledCard]}}": "TriggerA(AtTheBeginningOfCombatDuringAPlayersTurn(SinglePlayer(You)), {{TriggerActions[TheExiledCard][0]}})",
    "At the beginning of your upkeep, {{TriggerActions[TheExiledCard]}}": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), {{TriggerActions[TheExiledCard][0]}})",
    "Whenever a land with the same name as the exiled card is tapped for mana, {{TriggerActions[WhenAPermanentIsTappedForMana](ThatLand)}}": "TriggerA(WhenAPermanentIsTappedForMana(And([IsCardtype(Land), SharesANameWithExiled(TheExiledCard)])), {{TriggerActions[WhenAPermanentIsTappedForMana](ThatLand=Trigger_ThatPermanent)[0]}})",
    "Whenever you attack with one or more {{Creatures}}, {{TriggerActions[TheExiledCard](ThatMuch)}}": "TriggerA(WhenAPlayerAttacksWithAnyNumberOfCreatures(SinglePlayer(You), {{Creatures[0]}}), {{TriggerActions[TheExiledCard](ThatMuch=Trigger_NumberOfCreatures)[0]}})",
    "Whenever you cast {{a}} {{Spell}}, {{TriggerActions[TheExiledCard]}}": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), {{TriggerActions[TheExiledCard][0]}})",
    "Whenever you draw your first card during each of your draw steps, {{TriggerActions[TheExiledCard]}}": "TriggerA(WhenAPlayerDrawsTheirNthCardDuringTheirDrawStep(SinglePlayer(You), EqualTo(Integer(1))), {{TriggerActions[TheExiledCard][0]}})",
    "Whenever you play a land or cast a spell, if it shares a card type with the exiled card, {{TriggerActions}}": "TriggerI(WhenAPlayerPlaysALand(AnyPlayer, IsCardtype(Land)), PermanentPassesFilter(Trigger_ThatPermanent, SharesACardtypeWithExiledCard(TheExiledCard)), {{TriggerActions[0]}}), TriggerI(WhenAPlayerCastsASpell(AnyPlayer, AnySpell), SpellPassesFilter(Trigger_ThatSpell, SharesACardtypeWithExiledCard(TheExiledCard)), {{TriggerActions[0]}})"
  },
  "{{TriggerEffect[TheTwoChosenNames]}}": {
    "Whenever you cast a creature spell with one of the chosen names, you may search your library for a creature card with the other chosen name, reveal it, put it into your hand, then shuffle": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), And([IsCardtype(Creature), IsNamed(OneOfTheChosenNames)])), ActionList([MayAction(SearchLibrary([FindACardOfType(And([IsCardtype(Creature), IsNamed(OneOfTheChosenNames), Not(SharesANameWithSpell(Trigger_ThatSpell))])), RevealFoundCards, PutFoundCardsIntoHand, Shuffle]))]))"
  },
  "{{TriggerEffect[ThisScheme,ChooseAPlayer]}}": {
    "When you set this scheme in motion, {{TriggerActions[ChooseAPlayer]}}": "TriggerA(WhenAPlayerSetsASchemeInMotion(SinglePlayer(You), SingleScheme(ThisScheme)), {{TriggerActions[ChooseAPlayer][0]}})"
  },
  "{{TriggerEffect[ThisScheme,TheChosenPlayer]}}": {
    "When the chosen player is attacked or becomes the target of a spell or ability, {{TriggerActions[ThisScheme]}}": "TriggerA(WhenAPlayerIsAttacked(SinglePlayer(TheChosenPlayer)), {{TriggerActions[ThisScheme][0]}}), TriggerA(WhenAPlayerBecomesTheTargetOfASpellOrAbility(SinglePlayer(TheChosenPlayer), AnySpellOrAbility), {{TriggerActions[ThisScheme][0]}})"
  },
  "{{TriggerEffect[ThisScheme]}}": {
    "At the beginning of each end step, if {{Condition}}, {{TriggerActions[ThisScheme]}}": "TriggerI(AtTheBeginningOfAPlayersEndStep(AnyPlayer), {{Condition[0]}}, {{TriggerActions[ThisScheme][0]}})",
    "At the beginning of each opponent's end step, if {{Condition(ThatPlayer)}}, {{TriggerActions[ThisScheme]}}": "TriggerI(AtTheBeginningOfAPlayersEndStep(Opponent), {{Condition(ThatPlayer=Trigger_ThatPlayer)[0]}}, {{TriggerActions[ThisScheme][0]}})",
    "At the beginning of your end step, if {{Condition}}, {{TriggerActions[ThisScheme]}}": "TriggerI(AtTheBeginningOfAPlayersEndStep(SinglePlayer(You)), {{Condition[0]}}, {{TriggerActions[ThisScheme][0]}})",
    "At the beginning of your end step, {{TriggerActions[ThisScheme]}}": "TriggerA(AtTheBeginningOfAPlayersEndStep(SinglePlayer(You)), {{TriggerActions[ThisScheme][0]}})",
    "At the beginning of your opponents' end step, if {{Condition(ThatPlayer)}}, {{TriggerActions[ThisScheme]}}": "TriggerI(AtTheBeginningOfAPlayersEndStep(Opponent), {{Condition(ThatPlayer=Trigger_ThatPlayer)[0]}}, {{TriggerActions[ThisScheme][0]}})",
    "At the beginning of your opponents' end step, {{TriggerActions[ThisScheme](ThatPlayer)}}": "TriggerA(AtTheBeginningOfAPlayersEndStep(Opponent), {{TriggerActions[ThisScheme](ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "At the beginning of your upkeep, if {{Condition}}, {{TriggerActions[ThisScheme]}}": "TriggerI(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), {{Condition[0]}}, {{TriggerActions[ThisScheme][0]}})",
    "At the beginning of your upkeep, {{TriggerActions[ThisScheme]}}": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), {{TriggerActions[ThisScheme][0]}})",
    "When combat damage is dealt to you, {{TriggerActions[ThisScheme]}}": "TriggerA(WhenAPlayerIsDealtCombatDamage(SinglePlayer(You)), {{TriggerActions[ThisScheme][0]}})",
    "When four or more {{Creatures}} attack you, {{TriggerActions[ThisScheme]}}": "TriggerA(WhenANumberOfCreaturesAttackAPlayer(GreaterThanOrEqualTo(Integer(4)), {{Creatures[0]}}, SinglePlayer(You)), {{TriggerActions[ThisScheme][0]}})",
    "When you set this scheme in motion, if {{Condition}}, {{TriggerActions}}": "TriggerI(WhenAPlayerSetsASchemeInMotion(SinglePlayer(You), SingleScheme(ThisScheme)), {{Condition[0]}}, {{TriggerActions[0]}})",
    "When you set this scheme in motion, {{TriggerActions(ThatScheme)}}": "TriggerA(WhenAPlayerSetsASchemeInMotion(SinglePlayer(You), SingleScheme(ThisScheme)), {{TriggerActions(ThatScheme=ThisScheme)[0]}})",
    "When you set this scheme in motion, {{TriggerActions[ThisScheme]}}": "TriggerA(WhenAPlayerSetsASchemeInMotion(SinglePlayer(You), SingleScheme(ThisScheme)), {{TriggerActions[ThisScheme][0]}})",
    "When you set this scheme in motion, {{TriggerActions}}": "TriggerA(WhenAPlayerSetsASchemeInMotion(SinglePlayer(You), SingleScheme(ThisScheme)), {{TriggerActions[0]}})",
    "When your commander leaves the battlefield, {{TriggerActions[ThisScheme]}}": "TriggerA(WhenAPermanentLeavesTheBattlefield(IsYourCommander), {{TriggerActions[ThisScheme][0]}})",
    "When {{a}} {{Creature[ThisScheme]}} dies, {{TriggerActions[ThisScheme]}}": "TriggerA(WhenACreatureOrPlaneswalkerDies({{Creature[ThisScheme][0]}}), {{TriggerActions[ThisScheme][0]}})",
    "When {{a}} {{Creature}} dies, {{TriggerActions[ThisScheme]}}": "TriggerA(WhenACreatureOrPlaneswalkerDies({{Creature[0]}}), {{TriggerActions[ThisScheme][0]}})",
    "Whenever you cast a spell, you may abandon this scheme. If you do, copy that spell, and you may choose new targets for the copy": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), AnySpell), ActionList([MayCost(AbandonScheme(ThisScheme)), If(CostWasPaid, [CopySpellAndMayChooseNewTargets(Trigger_ThatSpell)])]))",
    "Whenever you set a non-ongoing scheme in motion, {{TriggerActions[WhenAPlayerSetsASchemeInMotion,TheSchemeSetInMotion!=ThisScheme]}}": "TriggerA(WhenAPlayerSetsASchemeInMotion(SinglePlayer(You), IsNonSupertype(Ongoing)), {{TriggerActions[WhenAPlayerSetsASchemeInMotion,TheSchemeSetInMotion!=ThisScheme][0]}})"
  },
  "{{TriggerEffect}}": {
    "Whenever you cast a spell that targets one or more creatures, those creatures gain {{Hasable}} until end of turn":
      "TriggerA(WhenAPlayerCastsASpellThatTargetsAnyNumberOfPermanents(SinglePlayer(You), AnySpell, IsCardtype(Creature)), ActionList([CreateEachPermanentLayerEffectUntil(Trigger_ThosePermanents, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Whenever a player or permanent becomes the target of an ability you control, {{TriggerActions}}. This ability triggers only once each turn":
      "TriggerOnceEachTurn(Or([WhenAPlayerBecomesTheTargetOfAnAbility(AnyPlayer, ControlledByAPlayer(SinglePlayer(You))), WhenAPermanentBecomesTheTargetOfAnAbility(IsPermanent, ControlledByAPlayer(SinglePlayer(You)))]), {{TriggerActions[0]}})",
    "At end of combat on your turn, if you attacked this turn, create a Junk token for each opponent you attacked": "TriggerI(If(IsPlayersTurn(You), AtTheEndOfCombat), PlayerPassesFilter(You, AttackedThisTurn), ActionList([CreateTokens([NumberTokens(TheNumberOfPlayersAttackedByPlayerThisCombat(Opponent, You), JunkToken)])]))",
    "At end of combat on your turn, if {{Condition}}, {{TriggerActions}}": "TriggerI(If(IsPlayersTurn(You), AtTheEndOfCombat), {{Condition[0]}}, {{TriggerActions[0]}})",
    "At end of combat, {{TriggerActions[AtEndOfCombat]}}": "TriggerA(AtTheEndOfCombat, {{TriggerActions[AtEndOfCombat][0]}})",
    "At end of combat, {{TriggerActions}}": "TriggerA(AtTheEndOfCombat, {{TriggerActions[0]}})",
    "At the beginning of combat on each opponent's turn, if {{Condition}}, {{TriggerActions(ThatPlayer)}}": "TriggerI(AtTheBeginningOfCombatDuringAPlayersTurn(Opponent), {{Condition[0]}}, {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "At the beginning of combat on each opponent's turn, {{TriggerActions(ThatPlayer)}}": "TriggerA(AtTheBeginningOfCombatDuringAPlayersTurn(Opponent), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "At the beginning of combat on each player's turn, {{TriggerActions(ThatPlayer)}}": "TriggerA(AtTheBeginningOfCombatDuringAPlayersTurn(AnyPlayer), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "At the beginning of combat on your turn, if you control {{Number}} or more {{Swamps}}, create that many {{PT}} {{CreatureTokens}}. They gain {{Hasable}}": "TriggerI(AtTheBeginningOfCombatDuringAPlayersTurn(SinglePlayer(You)), PlayerPassesFilter(You, ControlsNum(GreaterThanOrEqualTo({{Number[0]}}), IsLandType({{Swamps[0]}}))), ActionList([CreateTokens([NumberTokens(TheNumberOfPermanentsOnTheBattlefield(And([IsLandType({{Swamps[0]}}), ControlledByAPlayer(SinglePlayer(You))])), TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])]))",
    "At the beginning of combat on your turn, if {{Condition}}, {{TriggerActions}}": "TriggerI(AtTheBeginningOfCombatDuringAPlayersTurn(SinglePlayer(You)), {{Condition[0]}}, {{TriggerActions[0]}})",
    "At the beginning of combat on your turn, {{TriggerActions[EachPossibleDefendingPlayer]}}": "TriggerA(AtTheBeginningOfCombatDuringAPlayersTurn(SinglePlayer(You)), {{TriggerActions[EachPossibleDefendingPlayer][0]}})",
    "At the beginning of combat on your turn, {{TriggerActions}}": "TriggerA(AtTheBeginningOfCombatDuringAPlayersTurn(SinglePlayer(You)), {{TriggerActions[0]}})",
    "At the beginning of each combat, {{TriggerActions}}": "TriggerA(AtTheBeginningOfCombatDuringAPlayersTurn(AnyPlayer), {{TriggerActions[0]}})",
    "At the beginning of each end step, if all lands on the battlefield are {{Swamps}}, remove all {{CounterType}} counters from them": "TriggerI(AtTheBeginningOfAPlayersEndStep(AnyPlayer), AllPermanentsPassFilter(IsCardtype(Land), IsLandType({{Swamps[0]}})), ActionList([RemoveAllCountersOfTypeFromEachPermanent({{CounterType[0]}}, IsCardtype(Land))]))",
    "At the beginning of each end step, if {{Condition}}, {{TriggerActions}}": "TriggerI(AtTheBeginningOfAPlayersEndStep(AnyPlayer), {{Condition[0]}}, {{TriggerActions[0]}})",
    "At the beginning of each end step, {{TriggerActions}}": "TriggerA(AtTheBeginningOfAPlayersEndStep(AnyPlayer), {{TriggerActions[0]}})",
    "At the beginning of each of your main phases, if {{Condition[HaventAddedManaWithThisAbility]}}, {{TriggerActions}}": "TriggerI(AtTheBeginningOfAPlayersMainPhases(SinglePlayer(You)), {{Condition[HaventAddedManaWithThisAbility][0]}}, {{TriggerActions[0]}})",
    "At the beginning of each of your main phases, {{TriggerActions}}": "TriggerA(AtTheBeginningOfAPlayersMainPhases(SinglePlayer(You)), {{TriggerActions[0]}})",
    "At the beginning of each of your postcombat main phases, if {{Condition}}, {{TriggerActions}}": "TriggerI(AtTheBeginningOfAPlayersPostcombatMainPhase(SinglePlayer(You)), {{Condition[0]}}, {{TriggerActions[0]}})",
    "At the beginning of each of your postcombat main phases, {{TriggerActions}}": "TriggerA(AtTheBeginningOfAPlayersPostcombatMainPhase(SinglePlayer(You)), {{TriggerActions[0]}})",
    "At the beginning of each opponent's end step, if {{Condition(ThatPlayer)}}, {{TriggerActions}}": "TriggerI(AtTheBeginningOfAPlayersEndStep(Opponent), {{Condition(ThatPlayer=Trigger_ThatPlayer)[0]}}, {{TriggerActions[0]}})",
    "At the beginning of each opponent's end step, {{TriggerActions(ThatPlayer)}}": "TriggerA(AtTheBeginningOfAPlayersEndStep(Opponent), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "At the beginning of each opponent's upkeep, if {{Condition(ThatPlayer)}}, {{TriggerActions(ThatPlayer)}}": "TriggerI(AtTheBeginningOfAPlayersUpkeep(Opponent), {{Condition(ThatPlayer=Trigger_ThatPlayer)[0]}}, {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "At the beginning of each opponent's upkeep, if {{Condition}}, {{TriggerActions(ThatPlayer)}}": "TriggerI(AtTheBeginningOfAPlayersUpkeep(Opponent), {{Condition[0]}}, {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "At the beginning of each opponent's upkeep, if {{Condition}}, {{TriggerActions}}": "TriggerI(AtTheBeginningOfAPlayersUpkeep(Opponent), {{Condition[0]}}, {{TriggerActions[0]}})",
    "At the beginning of each opponent's upkeep, {{TriggerActions(ThatPlayer)}}": "TriggerA(AtTheBeginningOfAPlayersUpkeep(Opponent), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "At the beginning of each opponent's upkeep, {{TriggerActions}}": "TriggerA(AtTheBeginningOfAPlayersUpkeep(Opponent), {{TriggerActions[0]}})",
    "At the beginning of each other player's draw step, {{TriggerActions(ThatPlayer)}}": "TriggerA(AtTheBeginningOfAPlayersDrawStep(Other(You)), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "At the beginning of each other player's first upkeep, {{TriggerActions(ThatPlayer)}}": "TriggerA(AtTheBeginningOfAPlayersFirstUpkeepOfTheGame(Other(You)), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "At the beginning of each player's draw step, {{TriggerActions(ThatPlayer)}}": "TriggerA(AtTheBeginningOfAPlayersDrawStep(AnyPlayer), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "At the beginning of each player's end step, if {{Condition}}, {{TriggerActions(ThatPlayer)}}": "TriggerI(AtTheBeginningOfAPlayersEndStep(AnyPlayer), {{Condition[0]}}, {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "At the beginning of each player's end step, if {{Condition}}, {{TriggerActions}}": "TriggerI(AtTheBeginningOfAPlayersEndStep(AnyPlayer), {{Condition[0]}}, {{TriggerActions[0]}})",
