    "return up to {{Number}} target creature cards with power {{Digits}} or less from your graveyard to the battlefield. Put {{a}} {{CounterType}} counter on each of those creatures": "Targeted([UptoNumberTargetGraveyardCards({{Number[0]}}, And([IsCardtype(Creature), PowerIs(LessThanOrEqualTo({{Digits[0]}})), InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutEachGraveyardCardOntoBattlefield(Ref_TargetGraveyardCards, [EntersNormally]), PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, ThePermanentsPutOnTheBattlefieldThisWay)]))",
    "return up to {{Number}} target {{Permanents}} to their owners' hands": "Targeted([UptoNumberTargetPermanents({{Number[0]}}, {{Permanents[0]}})], ActionList([PutEachPermanentIntoItsOwnersHand(Ref_TargetPermanents)]))",
    "return up to {{Number}} target {{SpecificCards}} from your graveyard to the battlefield": "Targeted([UptoNumberTargetGraveyardCards({{Number[0]}}, And([{{SpecificCards[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutEachGraveyardCardOntoBattlefield(Ref_TargetGraveyardCards, [EntersNormally])]))",
    "return up to {{Number}} target {{SpecificCards}} from your graveyard to your hand": "Targeted([UptoNumberTargetGraveyardCards({{Number[0]}}, And([{{SpecificCards[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutEachGraveyardCardIntoHand(Ref_TargetGraveyardCards)]))",
    "return up to {{Number}} target {{SpecificCards}} with total mana value {{Digits}} or less from your graveyard to the battlefield": "Targeted([UptoNumberTargetGroupGraveyardCards({{Number[0]}}, And([{{SpecificCards[0]}}, InAPlayersGraveyard(SinglePlayer(You))]), TotalManaValueIs(LessThanOrEqualTo({{Digits[0]}})))], ActionList([ReturnEachGraveyardCardToBattlefield(Ref_TargetGraveyardCards, [EntersNormally])]))",
    "return up to {{Number}} {{Permanents}} to their owner's hand": "ActionList([ReturnUptoNumberPermanentsToOwnersHand({{Number[0]}}, {{Permanents[0]}})])",
    "return {{Number}} target {{Permanents}} to their owner's hand": "Targeted([NumberTargetPermanents({{Number[0]}}, {{Permanents[0]}})], ActionList([PutEachPermanentIntoItsOwnersHand(Ref_TargetPermanents)]))",
    "return {{Number}} target {{Permanents}} to their owners' hands": "Targeted([NumberTargetPermanents({{Number[0]}}, {{Permanents[0]}})], ActionList([PutEachPermanentIntoItsOwnersHand(Ref_TargetPermanents)]))",
