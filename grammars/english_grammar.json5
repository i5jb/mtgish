    "untap each {{Permanent}}. After this phase, there is an additional combat phase": "ActionList([UntapEachPermanent({{Permanent[0]}}), ThereIsAnAdditionalCombatPhase])",
    "untap each {{Permanent}}. If {{Condition}}, there is an additional combat phase after this phase": "ActionList([UntapEachPermanent({{Permanent[0]}}), If({{Condition[0]}}, [ThereIsAnAdditionalCombatPhase])])",
