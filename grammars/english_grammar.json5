    "Exile the top {{Number}} cards of your library. You may play them this turn": "ActionList([ExileTheTopNumberCardsOfLibrary({{Number[0]}}), CreatePlayerEffectUntil(You, [MayPlayExiledCards(TheCardsExiledThisWay)], UntilEndOfTurn)])",
    "Exile the top {{Number}} cards of your library. You may play them this turn without paying their mana costs": "ActionList([ExileTheTopNumberCardsOfLibrary({{Number[0]}}), CreatePlayerEffectUntil(You, [MayPlayExiledCardsWithoutPaying(TheCardsExiledThisWay)], UntilEndOfTurn)])",
    "Exile the top {{Number}} cards of your library. You may play those cards this turn": "ActionList([ExileTheTopNumberCardsOfLibrary({{Number[0]}}), CreatePlayerEffectUntil(You, [MayPlayExiledCards(TheCardsExiledThisWay)], UntilEndOfTurn)])",
    "Exile the top {{Number}} cards of your library. You may put any number of {{SpecificCards}} from among them onto the battlefield": "ActionList([ExileTheTopNumberCardsOfLibrary({{Number[0]}}), PutAnyNumberOfCardsFromAmongExileOntoBattlefield({{SpecificCards[0]}}, TheCardsExiledThisWay, [EntersNormally])])",
    "Exile the top {{Number}} cards of your library. {{SpecificCards}} exiled this way gain \"{{ExiledQuotedAbility}}\"": "ActionList([ExileTheTopNumberCardsOfLibrary({{Number[0]}}), CreateEachExiledCardEffect(TheCardsExiledThisWay, [AddAbility([{{ExiledQuotedAbility[0]}}])])])",
    "Exile up to one target card from a graveyard. Draw a card": "Targeted([UptoOneTargetGraveyardCard(AnyCardInAnyGraveyard)], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard), DrawACard]))",
    "Exile up to one target {{Permanent}}. Return that card to the battlefield under its owner's control at the beginning of that player's next end step": "Targeted([UptoOneTargetPermanent({{Permanent[0]}})], ActionList([ExilePermanent(Ref_TargetPermanent), CreateFutureTrigger(AtTheBeginningOfPlayersNextEndStep(OwnerOfExiledCard(TheCardExiledThisWay)), ActionList([PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersUnderOwnersControl])]))]))",
    "Exile up to {{Number}} target cards from a single graveyard": "Targeted([UptoNumberTargetGroupGraveyardCards({{Number[0]}}, AnyCardInAnyGraveyard, ShareAGraveyard)], ActionList([ExileEachGraveyardCard(Ref_TargetGraveyardCards)]))",
    "Exile up to {{Number}} target cards from a single graveyard. You gain {{Digits}} life if at least one {{SpecificCard}} was exiled this way": "Targeted([UptoNumberTargetGroupGraveyardCards({{Number[0]}}, AnyCardInAnyGraveyard, ShareAGraveyard)], ActionList([ExileEachGraveyardCard(Ref_TargetGraveyardCards), If(ACardWasExiledThisWay({{SpecificCard[0]}}), [GainLife({{Digits[0]}})])]))",
    "Exile up to {{Number}} target cards from graveyards": "Targeted([UptoNumberTargetGraveyardCards({{Number[0]}}, AnyCardInAnyGraveyard)], ActionList([ExileEachGraveyardCard(Ref_TargetGraveyardCards)]))",
    "Exile up to {{Number}} target cards from graveyards. You gain {{Digits}} life for each {{SpecificCard}} exiled this way": "Targeted([UptoNumberTargetGraveyardCards({{Number[0]}}, AnyCardInAnyGraveyard)], ActionList([ExileEachGraveyardCard(Ref_TargetGraveyardCards), GainLifeForEach({{Digits[0]}}, NumGraveyardCardsOfTypeExiledThisWay({{SpecificCard[0]}}))]))",
    "Exile up to {{Number}} target {{Permanents}}. For each permanent exiled this way, its controller creates {{a}} {{PT}} {{CreatureToken}}": "Targeted([UptoNumberTargetPermanents({{Number[0]}}, {{Permanents[0]}})], ActionList([ExileEachPermanent(Ref_TargetPermanents), ActionForEachPermanentExiledThisWayByController([PlayerAction(ControllerOfEachableExiledPermanent, CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])]))])]))",
    "Exile {{Number}} target cards from a single graveyard. Draw a card": "Targeted([NumberTargetGroupGraveyardCards({{Number[0]}}, AnyCardInAnyGraveyard, ShareAGraveyard)], ActionList([ExileEachGraveyardCard(Ref_TargetGraveyardCards)]))",
    "Flip a coin": "ActionList([FlipACoin])",
    "Flip a coin. If you win the flip, create a Treasure token": "ActionList([FlipACoin_OnWin([CreateTokens([TreasureToken])])])",
    "Flip a coin. If you win the flip, create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}} named {{NamedCard}}. If you lose the flip, destroy all {{Permanents}}": "ActionList([FlipACoin_OnWinAndLose([CreateTokens([NamedTokenWithPT({{NamedCard[0]}}, {{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])])], [DestroyEachPermanent({{Permanents[0]}})])])",
    "Flip a coin. If you win the flip, destroy all {{Permanents}}": "ActionList([FlipACoin_OnWin([DestroyEachPermanent({{Permanents[0]}})])])",
    "Flip a coin. If you win the flip, destroy target {{Permanent}}. If you lose the flip, destroy target {{Permanent}} unless you pay {{ManaCost}} and repeat this process": "Targeted([TargetPermanent({{Permanent[0]}}), TargetPermanent({{Permanent[1]}})], ActionList([RepeatableActions([FlipACoin_OnWinAndLose([DestroyPermanent(Ref_TargetPermanent2)], [MayCost(PayMana({{ManaCost[0]}})), IfElse(CostWasPaid, [RepeatThisProcess], [DestroyPermanent(Ref_TargetPermanent2)])])])]))",
    "Flip a coin. If you win the flip, target {{Creature}} gets {{PTMod}} until end of turn. If you lose the flip, it gets {{PTMod}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([FlipACoin_OnWinAndLose([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)], [CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[1]}})], UntilEndOfTurn)])]))",
    "Flip a coin. If you win the flip, you gain {{Digits}} life": "ActionList([FlipACoin_OnWin([GainLife({{Digits[0]}})])])",
    "Flip {{Number}} coins. Take an extra turn after this one for each coin that comes up heads": "ActionList([FlipCoins({{Number[0]}}), TakeANumberOfExtraTurns(TheNumberOfCoinsThatCameUpHeads)])",
    "Flip {{Number}} coins. Target opponent skips their next X turns, where X is the number of coins that came up heads": "Targeted([TargetPlayer(Opponent)], ActionList([FlipCoins({{Number[0]}}), PlayerAction(Ref_TargetPlayer, SkipNextNumberTurns(TheNumberOfCoinsThatCameUpHeads))]))",
    "For each color among monocolored permanents you control, add one mana of that color": "ActionList([AddMana(EachManaColorAmongPermanents(And([IsMonocolored, IsPermanent, ControlledByAPlayer(SinglePlayer(You))])))])",
    "For each color among permanents you control, add one mana of that color": "ActionList([AddMana(EachManaColorAmongPermanents(ControlledByAPlayer(SinglePlayer(You))))])",
    "For each opponent who controls a creature, create a token that's a copy of a card named {{NamedCard}} and attach it to a creature that player controls chosen at random": "ActionList([ActionForEachPlayer(And([Opponent, ControlsA(IsCardtype(Creature))]), [ChooseAPermanentAtRandom(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(EachablePlayer))])), CreateTokensWithFlags([TokenCopyOfNamedCard({{NamedCard[0]}}, NoTokenCopyEffects)], [EntersAttachedToPermanent(TheChosenPermanent)])])])",
    "For each opponent, return up to one target {{Permanent}} that player controls to its owner's hand": "Targeted([UptoOneTargetPermanentEachPlayerControls({{Permanent[0]}}, Opponent)], ActionList([PutEachPermanentIntoItsOwnersHand(Ref_TargetPermanents)]))",
    "For each opponent, you mill a card, then return that card from your graveyard to your hand unless that player pays {{Digits}} life": "ActionList([ActionForEachPlayer(Opponent, [MillACard, PlayerMayCost(ActionForEachPlayer_ThatPlayer, PayLife({{Digits[0]}})), Unless(CostWasPaid, [ReturnGraveyardCardToHand(TheCardMilledThisWay)])])])",
    "For each player, choose a creature that player controls. Each player sacrifices all creatures they control not chosen this way": "ActionList([ChooseAPermanentForEachPlayer(AnyPlayer, IsCardtype(Creature)), EachPlayerAction(AnyPlayer, SacrificeEachPermanent(NotChosenThisWay))])",
    "For each player, search that player's library for {{a}} {{SpecificCard}} and exile it, then that player shuffles. You may cast those cards without paying their mana costs": "ActionList([ForEachPlayerSearchLibrary(AnyPlayer, [FindACardOfType({{SpecificCard[0]}}), ExileFoundCards, Shuffle]), MayAction(CastAnyNumberOfExiledCardsWithoutPaying(TheCardsExiledThisWay))])",
    "For each {{Creature}}, create a token that's a copy of that creature": "ActionList([CreateTokens([TokenCopyOfEachPermanent({{Creature[0]}}, NoTokenCopyEffects)])])",
    "For each {{Creature}}, its controller may pay {{ManaCost}}. If that player doesn't, {{Creatures}} blocking that creature gain {{Hasable}} until end of turn": "ActionList([ActionForEachPermanent({{Creature[0]}}, [PlayerMayCost(ControllerOfPermanent(EachablePermanent), PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [CreateEachPermanentLayerEffectUntil(And([{{Creatures[0]}}, IsBlockingAttacker(EachablePermanent)]), [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])])])",
    "For each {{Creature}}, prevent all combat damage that would be dealt by that creature this turn unless its controller pays {{ManaCost}}": "ActionList([CreatePreventDamageUntil(CombatDamageWouldBeDealtByACreature({{Creature[0]}}), [PlayerMayCost(WouldDealDamage_ControllerOfDamageSource, PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [PreventThatDamage])], UntilEndOfTurn)])",
    "For each {{Eachable}}, create {{a}} {{PT}} {{CreatureToken}} with \"{{TokenQuotedAbility}}\"": "ActionList([CreateTokens([NumberTokens({{Eachable[0]}}, TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{TokenQuotedAbility[0]}}]))])])",
    "For each {{Eachable}}, put {{a}} {{CounterType}} counter on each {{Permanent}}": "ActionList([PutNumberCountersOfTypeOnEachPermanent({{Eachable[0]}}, {{CounterType[0]}}, {{Permanent[0]}})])",
    "For each {{Permanent}}, create a token that's a copy of it. Those tokens gain {{Hasable}}. Exile those tokens at the beginning of the next end step": "ActionList([CreateTokens([TokenCopyOfEachPermanent({{Permanent[0]}}, NoTokenCopyEffects)]), CreateEachPermanentLayerEffect(TheCreatedTokens, [AddAbility([{{Hasable[0]}}])]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([ExileEachPermanent(TheCreatedTokens)]))])",
    "For each {{Planeswalker}}, you may activate one of its loyalty abilities once this turn as though none of its loyalty abilities have been activated this turn": "ActionList([CreatePlayerEffectUntil(You, [MayActivateLoyaltyAbilityOfPlanewalkersAnAdditionalTime({{Planeswalker[0]}})], UntilEndOfTurn)])",
    "For each {{SpecificCard}} in your graveyard, create a token that's a copy of it, except it's {{a}} {{PT}} {{Black}} and {{Black}} {{Zombie}}": "ActionList([CreateTokens([TokenCopyOfEachGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]), TokenCopyEffects([SetPT({{PT[0]}}), SetColor(SimpleColorList([{{Black[0]}}, {{Black[1]}}])), SetCreatureTypes([{{Zombie[0]}}])]))])])",
    "For one spell this turn, you may spend mana as though it were mana of any type to pay that spell's mana cost": "ActionList([CreatePlayerEffectUntil(You, [MayActionOnce(CastASpellAndMaySpendManaAsThoughAnyColorToCast(AnySpell))], UntilEndOfTurn)])",
    "Gain control of all {{Permanents}} target opponent controls": "Targeted([TargetPlayer(Opponent)], ActionList([GainControlOfEachPermanent(And([{{Permanents[0]}}, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]))]))",
    "Gain control of all {{Permanents}} target player controls": "Targeted([TargetPlayer(AnyPlayer)], ActionList([GainControlOfEachPermanent(And([{{Permanents[0]}}, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]))]))",
    "Gain control of all {{Permanents}} until end of turn. Untap them. They gain {{Hasable}} until end of turn": "ActionList([GainControlOfEachPermanentUntil({{Permanents[0]}}, UntilEndOfTurn), UntapEachPermanent(ThePermanentsGainedControlOfThisWay), CreateEachPermanentLayerEffectUntil(ThePermanentsGainedControlOfThisWay, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "Gain control of all {{Permanents}}. Put all commanders from the command zone onto the battlefield under your control": "ActionList([GainControlOfEachPermanent({{Permanents[0]}}), PutEachCommanderFromCommandZoneOntoBattlefield(IsACommander, [EntersUnderPlayersControl(You)])])",
    "Gain control of each {{Permanent}}": "ActionList([GainControlOfEachPermanent({{Permanent[0]}})])",
    "Gain control of target {{Creature}} for as long as that creature is enchanted": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilItIsNoLongerEnchanted)]))",
    "Gain control of target {{Creature}} until end of turn. Untap that creature. It gains {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Gain control of target {{Creature}}. It becomes {{a}} {{Zombie}} in addition to its other types": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([GainControlOfPermanent(Ref_TargetPermanent), CreatePermanentLayerEffect(Ref_TargetPermanent, [AddCreatureType({{Zombie[0]}})])]))",
    "Gain control of target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([GainControlOfPermanent(Ref_TargetPermanent)]))",
    "Gain control of target {{Permanent}} until end of turn": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn)]))",
    "Gain control of target {{Permanent}} until end of turn. Untap it and put {{a}} {{CounterType}} counter on it. It gains {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), UntapPermanent(Ref_TargetPermanent), PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Gain control of target {{Permanent}} until end of turn. Untap it. It gains {{Hasable}} until end of turn. Sacrifice it at the beginning of the next end step if {{Condition(ThatPermanent)}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([If({{Condition(ThatPermanent=Ref_TargetPermanent)[0]}}, [SacrificePermanent(Ref_TargetPermanent)])]))]))",
    "Gain control of up to {{Number}} target {{Permanents}}": "Targeted([UptoNumberTargetPermanents({{Number[0]}}, {{Permanents[0]}})], ActionList([GainControlOfEachPermanent(Ref_TargetPermanents)]))",
    "Goad target creature an opponent controls. That player draws a card. You add {{ManaProduceSymbol}}": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(Opponent)]))], ActionList([GoadCreature(Ref_TargetPermanent), PlayerAction(ControllerOfPermanent(Ref_TargetPermanent), DrawACard), AddMana({{ManaProduceSymbol[0]}})]))",
    "Goad target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([GoadCreature(Ref_TargetPermanent)]))",
    "Goad target {{Creature}}. Whenever that creature attacks one of your opponents this turn, you draw a card": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([GoadCreature(Ref_TargetPermanent), CreateTriggerUntil(WhenACreatureAttacksAPlayer(SinglePermanent(Ref_TargetPermanent), Opponent), ActionList([DrawACard]), UntilEndOfTurn)]))",
    "If any {{DamageSource}} would deal damage to a permanent or player this turn, it deals double that damage to that permanent or player instead": "ActionList([CreateReplaceWouldDealDamageUntil(DamageWouldBeDealtByASourceToARecipient({{DamageSource[0]}}, APlayerOrAPermanent(AnyPlayer, AnyPermanent)), [DealDamageInstead(Twice(WouldDealDamage_ThatMuchDamage))], UntilEndOfTurn)])",
    "If it's night, it becomes day. Otherwise, it becomes night": "ActionList([IfElse(ItsNight, [BecomeDay], [BecomeNight])])",
    "If target player has fewer than nine poison counters, they get a number of poison counters equal to the difference": "Targeted([TargetPlayer(AnyPlayer)], ActionList([If(PlayerPassesFilter(Ref_TargetPlayer, HasANumberOfPoisonCounters(LessThanOrEqualTo(Integer(9)))), [PlayerAction(Ref_TargetPlayer, GetNumberPoisonCounters(Minus(Integer(9), TheNumberOfPoisonCountersPlayerHas(ActionPlayer))))])]))",
    "If target {{Permanent}} is tapped for mana, it produces colorless mana instead of {{Black}} mana": "ActionList([CreateReplaceWouldProduceManaUntil(TappingPermanentWouldProduceMana(Ref_TargetPermanent), [WouldProduceMana_ReplaceType(ManaProduceC)], UntilPermanentLeavesBattlefield(Ref_TargetPermanent))])",
    "If the top card of target player's graveyard is {{a}} {{SpecificCard}}, put that card on top of that player's library": "Targeted([TargetPlayer(AnyPlayer)], ActionList([If(GraveyardCardPassesFilter(TopCardOfTypeOfPlayersGraveyard(AnyCard, Ref_TargetPlayer), {{SpecificCard[0]}}), [PutGraveyardCardOnTopOfLibrary(TopCardOfTypeOfPlayersGraveyard(AnyCard, Ref_TargetPlayer))])]))",
    "If you control Equipment named {{NamedCard}}, {{NamedCard}}, and {{NamedCard}}, create {{NamedCard}}, a legendary {{PT}} colorless {{Zombie}} creature token. Attach those Equipment to it": "ActionList([If(PlayerPassesFilter(You, And([ControlsA(And([IsArtifactType(Equipment), IsNamed(NamedCard({{NamedCard[0]}}))])), ControlsA(And([IsArtifactType(Equipment), IsNamed(NamedCard({{NamedCard[1]}}))])), ControlsA(And([IsArtifactType(Equipment), IsNamed(NamedCard({{NamedCard[2]}}))]))])), [CreateTokens([NamedTokenWithPT({{NamedCard[3]}}, {{PT[0]}}, Colorless, [Legendary], [Creature], SubtypesList([{{Zombie[0]}}]), [])]), AttachEachPermanentToPermanent(And([IsArtifactType(Equipment), ControlledByAPlayer(SinglePlayer(You)), Or([IsNamed(NamedCard({{NamedCard[0]}})), IsNamed(NamedCard({{NamedCard[1]}})), IsNamed(NamedCard({{NamedCard[2]}}))])]), TheCreatedToken)])])",
    "If {{Condition}}, create {{NamedCard}}, a legendary {{PT}} {{Black}} {{Zombie}} creature token": "ActionList([If({{Condition[0]}}, [CreateTokens([NamedTokenWithPT({{NamedCard[0]}}, {{PT[0]}}, Colors([{{Black[0]}}]), [Legendary], [Creature], SubtypesList([{{Zombie[0]}}]), [])])])])",
    "If {{Condition}}, target opponent looks at the top {{Number}} cards of your library and separates them into two face-down piles. Exile one of those piles. Search the other pile for a card, put it into your hand, then shuffle the rest of that pile into your library": "Targeted([TargetPlayer(Opponent)], ActionList([PlayerAction(Ref_TargetPlayer, LookAtTheTopNumberCardsOfPlayersLibrary(You, {{Number[0]}}, [SeparateIntoTwoFaceDownPiles, PlayerExilesAPile(You), PlayerLooksAtRemainingCardsAndPutsAGenericCardIntoHand(You), PutTheRemainingCardsBackIntoLibraryAndShuffle]))]))",
    "If {{a}} {{DamageSource}} would deal damage to an opponent this turn, it deals double that damage to that player instead": "ActionList([CreateReplaceWouldDealDamageUntil(DamageWouldBeDealtByASourceToARecipient({{DamageSource[0]}}, APlayer(Opponent)), [DealDamageInstead(Twice(WouldDealDamage_ThatMuchDamage))], UntilEndOfTurn)])",
    "Incubate {{Digits}}": "ActionList([Incubate({{Digits[0]}})])",
    "Investigate": "ActionList([Investigate])",
    "Investigate. You gain {{Digits}} life": "ActionList([Investigate, GainLife({{Digits[0]}})])",
    "Learn": "ActionList([Learn])",
    "Lock or unlock a door of target Room you control": "Targeted([TargetPermanent(And([IsEnchantmentType(Room), ControlledByAPlayer(SinglePlayer(You))]))], ActionList([LockOrUnlockADoorOfPermanent(Ref_TargetPermanent)]))",
    "Look at a card at random in target player's hand. You draw a card at the beginning of the next turn's upkeep": "Targeted([TargetPlayer(AnyPlayer)], ActionList([LookAtARandomCardInPlayersHand(Ref_TargetPlayer), CreateFutureTrigger(AtTheBeginningOfTheNextTurnsUpkeep, ActionList([DrawACard]))]))",
    "Look at target face-down creature": "Targeted([TargetPermanent(And([IsFaceDown, IsCardtype(Creature)]))], ActionList([LookAtFaceDownPermanent(Ref_TargetPermanent)]))",
    "Look at target opponent's hand and exile those cards face down. You may play those cards this turn, and mana of any type can be spent to cast them. Until end of turn, whenever you play a land or cast a spell this way, its owner draws a card. At the beginning of the next end step, return the exiled cards to their owner's hand": "Targeted([TargetPlayer(Opponent)], ActionList([LookAtPlayersHand(Ref_TargetPlayer), ExilePlayersHandFaceDown(Ref_TargetPlayer), CreatePlayerEffectUntil(You, [MayPlayExiledCardsAndMaySpendManaAsThoughAnyTypeToCastWithTrigger(TheCardsExiledThisWay, ActionList([PlayerAction(Ref_TargetPlayer, DrawACard)]))], UntilEndOfTurn), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([ReturnEachExiledCardToOwnersHand(TheCardsExiledThisWay)]))]))",
    "Look at target player's hand": "Targeted([TargetPlayer(AnyPlayer)], ActionList([LookAtPlayersHand(Ref_TargetPlayer)]))",
    "Look at target player's hand and choose a card from it. That player discards that card": "Targeted([TargetPlayer(AnyPlayer)], ActionList([LookAtPlayersHandAndChooseACardToDiscard(Ref_TargetPlayer, AnyCard)]))",
    "Look at the top X cards of your library, where X is {{GameNumber}}, then put them back in any order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{GameNumber[0]}}, [PutTheRemainingCardsOnTopOfLibraryInAnyOrder])])",
    "Look at the top X cards of your library, where X is {{GameNumber}}. Put one of those cards into your hand and the rest on the bottom of your library in a random order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{GameNumber[0]}}, [PutAGenericCardIntoHand, PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "Look at the top X cards of your library, where X is {{GameNumber}}. You may cast {{a}} {{PotentialSpell}} from among them without paying its mana cost. Put the rest on the bottom of your library in a random order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{GameNumber[0]}}, [MayCastASpellFromAmongThemWithoutPaying({{PotentialSpell[0]}}), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "Look at the top X cards of your library, where X is {{GameNumber}}. You may put any number of {{SpecificCards}} from among them onto the battlefield. Then shuffle": "ActionList([CreateValueX({{GameNumber[0]}}), LookAtTheTopNumberCardsOfLibrary(ValueX, [MayPutAnyNumberOfCardsOntoTheBattlefield({{SpecificCards[0]}}, [EntersNormally]), PutTheRemainingCardsBackIntoLibraryAndShuffle])])",
    "Look at the top X cards of your library, where X is {{GameNumber}}. You may put {{a}} {{SpecificCard}} from among them onto the battlefield. Put the rest on the bottom of your library in any order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{GameNumber[0]}}, [MayPutACardOfTypeOntoTheBattlefield({{SpecificCard[0]}}, [EntersNormally]), PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder])])",
    "Look at the top card of target player's library": "Targeted([TargetPlayer(AnyPlayer)], ActionList([LookAtTheTopCardOfPlayersLibrary(Ref_TargetPlayer)]))",
    "Look at the top card of target player's library. Draw a card at the beginning of the next turn's upkeep": "Targeted([TargetPlayer(AnyPlayer)], ActionList([LookAtTheTopCardOfPlayersLibrary(Ref_TargetPlayer), CreateFutureTrigger(AtTheBeginningOfTheNextTurnsUpkeep, ActionList([DrawACard]))]))",
    "Look at the top card of target player's library. If it's {{a}} {{SpecificCard}}, you may pay {{Digits}} life. If you do, put it into that player's graveyard": "Targeted([TargetPlayer(AnyPlayer)], ActionList([LookAtTheTopCardOfPlayersLibrary(Ref_TargetPlayer), MayPutTheTopCardOfPlayersLibraryOfTypeInGraveyardForCost(Ref_TargetPlayer, {{SpecificCard[0]}}, PayLife({{Digits[0]}}))]))",
    "Look at the top card of target player's library. You may put that card into that player's graveyard": "Targeted([TargetPlayer(AnyPlayer)], ActionList([LookAtTheTopCardOfPlayersLibrary(Ref_TargetPlayer), MayAction(PutTheTopCardOfPlayersLibraryInGraveyard(Ref_TargetPlayer))]))",
    "Look at the top card of target player's library. You may put that card on the bottom of that player's library": "Targeted([TargetPlayer(AnyPlayer)], ActionList([LookAtTheTopCardOfPlayersLibrary(Ref_TargetPlayer), MayAction(PutTheTopCardOfPlayersLibraryOnTheBottomOfTheirLibrary(Ref_TargetPlayer))]))",
    "Look at the top card of your library": "ActionList([LookAtTopOfLibrary])",
    "Look at the top card of your library, then exile it face down": "ActionList([LookAtTopOfLibrary, ExileTopCardOfLibraryFaceDown])",
    "Look at the top card of your library. If it's {{a}} {{SpecificCard}}, you may put it onto the battlefield tapped. If you don't put the card onto the battlefield, you may put it on the bottom of your library": "ActionList([LookAtTopOfLibrary, MayCost(PutTopCardOfLibraryOfTypeOnBattlefield({{SpecificCard[0]}}, [EntersTapped])), Unless(CostWasPaid, [PutTopOfLibraryOnBottomOfLibrary])])",
    "Look at the top card of your library. If it's {{a}} {{SpecificCard}}, you may put it onto the battlefield. If it's {{a}} {{SpecificCard}}, you may reveal it and put it into your hand. Otherwise, you may put it into your graveyard": "ActionList([LookAtTopOfLibrary, ChooseAnAction([[PutTopCardOfLibraryOfTypeOnBattlefield({{SpecificCard[0]}}, [EntersNormally])], [RevealTopCardOfLibraryAndPutIntoHand({{SpecificCard[1]}})], [PutTopOfLibraryInGraveyard], [DoNothing]])])",
    "Look at the top card of your library. If it's {{a}} {{SpecificCard}}, you may put it onto the battlefield. If you don't put the card onto the battlefield, put it into your hand": "ActionList([LookAtTopOfLibrary, MayCost(PutTopCardOfLibraryOfTypeOnBattlefield({{SpecificCard[0]}}, [EntersNormally])), Unless(CostWasPaid, [PutTopOfLibraryInHand])])",
    "Look at the top card of your library. If it's {{a}} {{SpecificCard}}, you may put it onto the battlefield. If you don't put the card onto the battlefield, you may put it on the bottom of your library": "ActionList([LookAtTopOfLibrary, MayCost(PutTopCardOfLibraryOfTypeOnBattlefield({{SpecificCard[0]}}, [EntersNormally])), Unless(CostWasPaid, [PutTopOfLibraryOnBottomOfLibrary])])",
    "Look at the top card of your library. If it's {{a}} {{SpecificCard}}, you may reveal it and put it into your hand": "ActionList([LookAtTheTopCardOfPlayersLibrary(You), MayAction(RevealTopCardOfLibraryAndPutIntoHand({{SpecificCard[0]}}))])",
    "Look at the top card of your library. If it's {{a}} {{SpecificCard}}, you may reveal it and put it into your hand. If you don't put it into your hand, you may put it on the bottom of your library": "ActionList([LookAtTopOfLibrary, MayCost(RevealTopCardOfLibraryAndPutIntoHand({{SpecificCard[0]}})), Unless(CostWasPaid, [MayAction(PutTopOfLibraryOnBottomOfLibrary)])])",
    "Look at the top card of your library. If it's {{a}} {{SpecificCard}}, you may reveal it and put it into your hand. If you don't put the card into your hand, put it on the bottom of your library": "ActionList([LookAtTopOfLibrary, MayCost(RevealTopCardOfLibraryAndPutIntoHand({{SpecificCard[0]}})), Unless(CostWasPaid, [PutTopOfLibraryOnBottomOfLibrary])])",
    "Look at the top card of your library. If it's {{a}} {{SpecificCard}}, you may reveal it and put it into your hand. If you don't put the card into your hand, you may put it into your graveyard": "ActionList([LookAtTopOfLibrary, MayCost(RevealTopCardOfLibraryAndPutIntoHand({{SpecificCard[0]}})), Unless(CostWasPaid, [MayAction(PutTopOfLibraryInGraveyard)])])",
    "Look at the top card of your library. If that card is snow, you may reveal it and put it into your hand": "ActionList([LookAtTheTopCardOfPlayersLibrary(You), MayAction(RevealTopCardOfLibraryAndPutIntoHand(IsSupertype(Snow)))])",
    "Look at the top card of your library. You may exile it face down": "ActionList([LookAtTopOfLibrary, MayAction(ExileTopCardOfLibraryFaceDown)])",
    "Look at the top card of your library. You may exile that card": "ActionList([LookAtTopOfLibrary, MayAction(ExileTopCardOfLibrary)])",
    "Look at the top card of your library. You may reveal that card and put it into your hand. If you do, you lose life equal to its mana value": "ActionList([LookAtTheTopCardOfPlayersLibrary(You), MayCost(RevealTopCardOfLibrary), If(CostWasPaid, [PutTopOfLibraryInHand, LoseLife(ManaValueOfTheCardRevealedThisWay)])])",
    "Look at the top three cards of your library. Put two of them into your hand and the other into your graveyard": "ActionList([LookAtTheTopNumberCardsOfLibrary(Integer(3), [PutNumberGenericCardsIntoHand(Integer(2)), PutTheRemainingCardsIntoGraveyard])])",
    "Look at the top two cards of target opponent's library, then exile one of them": "Targeted([TargetPlayer(Opponent)], ActionList([LookAtTheTopNumberCardsOfPlayersLibrary(Ref_TargetPlayer, Integer(2), [ExileAGenericCard, PutTheRemainingCardsOnTopOfLibraryInAnyOrder])]))",
    "Look at the top two cards of your library. Exile one of them and put the other into your hand": "ActionList([LookAtTheTopNumberCardsOfLibrary(Integer(2), [ExileAGenericCard, PutTheRemainingCardsIntoHand])])",
    "Look at the top two cards of your library. Put one of them into your graveyard": "ActionList([LookAtTheTopNumberCardsOfLibrary(Integer(2), [PutAGenericCardIntoGraveyard, PutTheRemainingCardsOnTopOfLibraryInAnyOrder])])",
    "Look at the top two cards of your library. Put one of them into your hand and the other into your graveyard": "ActionList([LookAtTheTopNumberCardsOfLibrary(Integer(2), [PutAGenericCardIntoHand, PutTheRemainingCardsIntoGraveyard])])",
    "Look at the top two cards of your library. Put one of them into your hand and the other on the bottom of your library": "ActionList([LookAtTheTopNumberCardsOfLibrary(Integer(2), [PutAGenericCardIntoHand, PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder])])",
    "Look at the top two cards of your library. Put one of those cards into your hand and the other into your graveyard": "ActionList([LookAtTheTopNumberCardsOfLibrary(Integer(2), [PutAGenericCardIntoHand, PutTheRemainingCardsIntoGraveyard])])",
    "Look at the top {{Number}} cards of target player's library": "Targeted([TargetPlayer(AnyPlayer)], ActionList([LookAtTheTopNumberCardsOfPlayersLibrary(Ref_TargetPlayer, {{Number[0]}}, [LeaveRemainingCardsOnTopOfLibraryInSameOrder])]))",
    "Look at the top {{Number}} cards of target player's library, then put them back in any order": "Targeted([TargetPlayer(AnyPlayer)], ActionList([LookAtTheTopNumberCardsOfPlayersLibrary(Ref_TargetPlayer, {{Number[0]}}, [PutTheRemainingCardsOnTopOfLibraryInAnyOrder])]))",
    "Look at the top {{Number}} cards of your library, put one of them into your hand, and exile the rest": "ActionList([LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [PutAGenericCardIntoHand, ExileTheRemainingCards])])",
    "Look at the top {{Number}} cards of your library, then put them back in any order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [PutTheRemainingCardsOnTopOfLibraryInAnyOrder])])",
    "Look at the top {{Number}} cards of your library. Exile one face down and put the rest on the bottom of your library in any order. For as long as it remains exiled, you may cast it if it's a creature spell": "ActionList([LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [ExileAGenericCardFaceDown, PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder]), CreatePlayerEffectUntil(You, [MayLookAtFaceDownExiledCard(TheCardExiledThisWay), MayCastExiledSpell(TheCardExiledThisWay, IsCardtype(Creature))], UntilCardIsNoLongerExiled(TheCardExiledThisWay))])",
    "Look at the top {{Number}} cards of your library. Exile {{Number}} of them at random, then put the rest on top of your library in any order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [ExileNumberGenericCardsAtRandom({{Number[1]}}), PutTheRemainingCardsOnTopOfLibraryInAnyOrder])])",
    "Look at the top {{Number}} cards of your library. Put one of them into your hand and the rest on the bottom of your library in any order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [PutAGenericCardIntoHand, PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder])])",
    "Look at the top {{Number}} cards of your library. Put {{Number}} of them into your hand and the rest on the bottom of your library in a random order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [PutNumberGenericCardsIntoHand({{Number[1]}}), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "Look at the top {{Number}} cards of your library. You may cast {{a}} {{PotentialSpell}} from among them without paying its mana cost. Put the rest on the bottom of your library in a random order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [MayCastASpellFromAmongThemWithoutPaying({{PotentialSpell[0]}}), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "Look at the top {{Number}} cards of your library. You may put any number of {{SpecificCards}} from among them onto the battlefield. Put the rest on the bottom of your library in a random order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [MayPutAnyNumberOfCardsOntoTheBattlefield({{SpecificCards[0]}}, [EntersNormally]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "Look at the top {{Number}} cards of your library. You may put {{a}} {{SpecificCard}} from among them onto the battlefield with {{a}} {{CounterType}} counter on it. Put the rest on the bottom of your library in a random order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [MayPutACardOfTypeOntoTheBattlefield({{SpecificCard[0]}}, [EntersWithACounter({{CounterType[0]}})]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "Look at the top {{Number}} cards of your library. You may put {{a}} {{SpecificCard}} from among them onto the battlefield. Put the rest on the bottom of your library in a random order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [MayPutACardOfTypeOntoTheBattlefield({{SpecificCard[0]}}, [EntersNormally]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "Look at the top {{Number}} cards of your library. You may put {{a}} {{SpecificCard}} from among them onto the battlefield. Put the rest on the bottom of your library in any order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [MayPutACardOfTypeOntoTheBattlefield({{SpecificCard[0]}}, [EntersNormally]), PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder])])",
    "Look at the top {{Number}} cards of your library. You may reveal up to {{Number}} {{SpecificCards}} from among them and put them into your hand. Put the rest on the bottom of your library in a random order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [MayRevealUptoNumberCardsOfTypeAndPutIntoHand({{Number[1]}}, {{SpecificCards[0]}}), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "Look at the top {{Number}} cards of your library. You may reveal {{a}} {{SpecificCard}} and/or {{a}} {{SpecificCard}} from among them and put them into your hand. Put the rest on the bottom of your library in a random order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [MayRevealMultipleCardsOfTypeAndPutIntoHand([{{SpecificCard[0]}}, {{SpecificCard[1]}}]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "Look at the top {{Number}} cards of your library. You may reveal {{a}} {{SpecificCard}} from among them and put it into your hand. If it's legendary, you gain {{Digits}} life. Put the rest on the bottom of your library in a random order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [MayRevealACardOfTypeAndPutIntoHand({{SpecificCard[0]}}), If(ACardWasRevealedThisWay(IsSupertype(Legendary)), [GainLife({{Digits[0]}})]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "Look at the top {{Number}} cards of your library. You may reveal {{a}} {{SpecificCard}} from among them and put it into your hand. Put the rest on the bottom of your library in a random order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [MayRevealACardOfTypeAndPutIntoHand({{SpecificCard[0]}}), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "Look at the top {{Number}} cards of your library. You may reveal {{a}} {{SpecificCard}} from among them and put it into your hand. Put the rest on the bottom of your library in any order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [MayRevealACardOfTypeAndPutIntoHand({{SpecificCard[0]}}), PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder])])",
    "Look at the top {{Number}} cards of your library. You may reveal {{a}} {{SpecificCard}} from among them and put it into your hand. Then put the rest on the bottom of your library in a random order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [MayRevealACardOfTypeAndPutIntoHand({{SpecificCard[0]}}), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "Look at the top {{Number}} cards of your library. You may reveal {{a}} {{SpecificCard}} from among them and put it onto the battlefield. Put the rest on the bottom in a random order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [MayRevealAndPutACardOfTypeOntoTheBattlefield({{SpecificCard[0]}}, [EntersNormally]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "Look at the top {{Number}} cards of your library. You may reveal {{a}} {{SpecificCard}} from among them and put that card into your hand. Put the rest on the bottom of your library in a random order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [MayRevealACardOfTypeAndPutIntoHand({{SpecificCard[0]}}), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "Manifest a card from your hand": "ActionList([ManifestACardFromHand])",
