    "non-{{Swamp}}, non-{{Swamp}} land card": "And([IsNonLandType({{Swamp[0]}}), IsNonLandType({{Swamp[1]}}), IsCardtype(Land)])",
    "non-{{Zombie}} card": "IsNonCreatureType({{Zombie[0]}})",
