    "colorless permanent you control": "TheNumberOfPermanentsOnTheBattlefield(And([IsColorless, IsPermanent, ControlledByAPlayer(SinglePlayer(You))]))",
    "counter among players and permanents": "Plus(TheTotalNumberOfCountersPlayersHave(AnyPlayer), TheTotalNumberOfCountersOnPermanents(AnyPermanent))",
    "creature and/or Vehicle you control": "TheNumberOfPermanentsOnTheBattlefield(And([Or([IsCardtype(Creature), IsArtifactType(Vehicle)]), ControlledByAPlayer(SinglePlayer(You))]))",
    "creature and/or enchantment you control": "TheNumberOfPermanentsOnTheBattlefield(And([Or([IsCardtype(Creature), IsCardtype(Enchantment)]), ControlledByAPlayer(SinglePlayer(You))]))",
    "creature attacking you": "TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), IsAttackingPlayer(You)]))",
    "creature card in your graveyard": "TheNumberOfGraveyardCards(And([IsCardtype(Creature), InAPlayersGraveyard(SinglePlayer(You))]))",
    "creature card in your opponents' graveyards": "TheNumberOfGraveyardCards(And([IsCardtype(Creature), InAPlayersGraveyard(Opponent)]))",
    "creature card you own in exile and in your graveyard": "Plus(NumCardsInExile(And([IsCardtype(Creature), OwnedByAPlayer(SinglePlayer(You))])), TheNumberOfGraveyardCards(And([IsCardtype(Creature), InAPlayersGraveyard(SinglePlayer(You))])))",
    "creature in your party": "NumCreaturesInPlayersParty(You)",
    "creature on the battlefield": "TheNumberOfPermanentsOnTheBattlefield(IsCardtype(Creature))",
    "creature put into your graveyard from the battlefield this turn": "TheNumberOfPermanentsPutIntoPlayersGraveyardThisTurn(IsCardtype(Creature), You)",
    "creature that attacked this turn": "TheNumberOfCreaturesThatAttackedThisTurn(IsCardtype(Creature))",
    "creature that died this turn": "NumCreaturesOrPlaneswalkersThatDiedThisTurn(IsCardtype(Creature))",
    "creature that died under your control this turn": "NumCreaturesOrPlaneswalkersThatDiedThisTurn(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))",
    "creature that left the battlefield under your control this turn": "TheNumberOfPermanentsThatLeftTheBattlefieldUnderPlayersControlThisTurn(IsCardtype(Creature), You)",
    "creature token you control": "TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), IsToken, ControlledByAPlayer(SinglePlayer(You))]))",
    "creature type among creatures you control": "TheNumberOfCreatureTypesAmongPermanents(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))",
    "creature with power {{Digits}} or greater you control": "TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), PowerIs(GreaterThanOrEqualTo({{Digits[0]}})), ControlledByAPlayer(SinglePlayer(You))]))",
    "creature with power {{Digits}} or greater your opponents control": "TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), PowerIs(GreaterThanOrEqualTo({{Digits[0]}})), ControlledByAPlayer(Opponent)]))",
    "creature with {{CheckHasable}} you control": "TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), HasAbility({{CheckHasable[0]}}), ControlledByAPlayer(SinglePlayer(You))]))",
    "creature you attacked with this turn": "NumCreaturesPlayerAttackedWithThisTurn(IsCardtype(Creature), You)",
    "creature you control": "TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))",
    "creature you control but don't own": "TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), OwnedByAPlayer(Other(You))]))",
    "creature you control named {{NamedCard}}": "TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), IsNamed(NamedCard({{NamedCard[0]}}))]))",
    "creature you control that's {{a}} {{Zombie}} or {{a}} {{Zombie}}": "TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), Or([IsCreatureType({{Zombie[0]}}), IsCreatureType({{Zombie[0]}})])]))",
    "creature you control that's {{a}} {{Zombie}}, {{Zombie}}, {{Zombie}}, or {{Zombie}}": "TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), Or([IsCreatureType({{Zombie[0]}}), IsCreatureType({{Zombie[1]}}), IsCreatureType({{Zombie[2]}}), IsCreatureType({{Zombie[3]}})])]))",
    "creature you control with base power and toughness {{PT}}": "TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), BasePowerAndToughnessIsEqualTo({{PT[0]}})]))",
    "creature you control with base power or toughness {{Digits}}": "TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), Or([BasePowerIs(EqualTo({{Digits[0]}})), BaseToughnessIs(EqualTo({{Digits[0]}}))])]))",
    "creature you control with power {{Digits}} or greater": "TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), PowerIs(GreaterThanOrEqualTo({{Digits[0]}}))]))",
    "creature you control with toughness greater than its power": "TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), PowerIsLessThanToughness]))",
    "creature you control with {{CheckHasable}}": "TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), HasAbility({{CheckHasable[0]}})]))",
    "creature you control with {{CheckHasable}} or {{CheckHasable}}": "TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), Or([HasAbility({{CheckHasable[0]}}), HasAbility({{CheckHasable[1]}})])]))",
    "creature you control with {{a}} {{CounterType}} counter on it": "TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), HasACounterOfType({{CounterType[0]}})]))",
    "creature you controlled that dealt combat damage to a player this turn": "TheNumberOfCreaturesThatDealtCombatDamageToAPlayer(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]), AnyPlayer)",
    "creature your opponents control": "TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), ControlledByAPlayer(Opponent)]))",
    "different mana cost among nonland cards in your graveyard": "TheNumberOfDifferentManaCostsAmongCardsInPlayersGraveyard(IsNonCardtype(Land), You)",
    "different mana value among cards in your graveyard": "NumDifferentManaValueAmongCardsInPlayersGraveyard(AnyCard, You)",
    "different mana value among instant and sorcery cards in your graveyard": "NumDifferentManaValueAmongCardsInPlayersGraveyard(Or([IsCardtype(Instant), IsCardtype(Sorcery)]), You)",
    "different mana value among nonland cards in your graveyard": "NumDifferentManaValueAmongCardsInPlayersGraveyard(IsNonCardtype(Land), You)",
    "different mana value among nonland cards you own in exile with {{CounterType}} counters on them": "NumDifferentManaValuesAmongCardsInExile(And([IsNonCardtype(Land), OwnedByAPlayer(SinglePlayer(You)), HasACounterOfType({{CounterType[0]}})]))",
    "different mana value among nonland permanents you control": "NumDifferentManaValuesAmongPermanents(And([IsNonCardtype(Land), IsPermanent, ControlledByAPlayer(SinglePlayer(You))]))",
    "different power among creatures you control": "NumDifferentlyPoweredCreaturesAmongPermanents(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))",
    "differently named dungeon you've completed": "NumDifferentlyNamedDungeonsPlayerHasComplete(You)",
    "enchantment on the battlefield": "TheNumberOfPermanentsOnTheBattlefield(IsCardtype(Enchantment))",
    "enchantment you control": "TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Enchantment), ControlledByAPlayer(SinglePlayer(You))]))",
    "equipped attacking creature you control": "TheNumberOfPermanentsOnTheBattlefield(And([IsEquipped, IsAttacking, IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))",
    "experience counter you have": "NumCountersOfTypePlayerHas(ExperienceCounter, You)",
    "face-down creature on the battlefield": "TheNumberOfPermanentsOnTheBattlefield(And([IsFaceDown, IsCardtype(Creature)]))",
    "foretold card you own in exile": "NumCardsInExile(And([IsForetold, OwnedByAPlayer(SinglePlayer(You))]))",
    "goaded creature you control": "TheNumberOfPermanentsOnTheBattlefield(And([HasBeenGoaded, IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))",
    "historic card in your graveyard": "TheNumberOfGraveyardCards(And([IsHistoric, InAPlayersGraveyard(SinglePlayer(You))]))",
    "instant and sorcery card in your graveyard": "TheNumberOfGraveyardCards(And([Or([IsCardtype(Instant), IsCardtype(Sorcery)]), InAPlayersGraveyard(SinglePlayer(You))]))",
    "instant and sorcery spell you've cast this turn": "NumSpellsCastByPlayerThisTurn(Or([IsCardtype(Instant), IsCardtype(Sorcery)]), You)",
    "kind of counter among permanents you control": "TheNumberOfCounterTypesAmongPermanents(ControlledByAPlayer(SinglePlayer(You)))",
    "land card in your graveyard": "TheNumberOfGraveyardCards(And([IsCardtype(Land), InAPlayersGraveyard(SinglePlayer(You))]))",
    "land that entered the battlefield under your control this turn": "NumEnteredTheBattlefieldThisTurn(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You))]))",
    "land you control": "TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You))]))",
    "land you control but don't own": "TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You)), OwnedByAPlayer(Other(You))]))",
    "land you control named {{NamedCard}}": "TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You)), IsNamed(NamedCard({{NamedCard[0]}}))]))",
    "land you control with {{a}} {{CounterType}} counter on it": "TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You)), HasACounterOfType({{CounterType[0]}})]))",
    "land you had enter the battlefield under your control this turn": "NumEnteredTheBattlefieldThisTurn(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You))]))",
    "land your opponents control that could produce {C}": "TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Land), ControlledByAPlayer(Opponent), CouldProduce(ManaProduceC)]))",
    "legendary creature and planeswalker you control": "TheNumberOfPermanentsOnTheBattlefield(And([IsSupertype(Legendary), Or([IsCardtype(Creature), IsCardtype(Planeswalker)]), ControlledByAPlayer(SinglePlayer(You))]))",
    "legendary creature you control": "TheNumberOfPermanentsOnTheBattlefield(And([IsSupertype(Legendary), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))",
    "legendary enchantment you control": "TheNumberOfPermanentsOnTheBattlefield(And([IsSupertype(Legendary), IsCardtype(Enchantment), ControlledByAPlayer(SinglePlayer(You))]))",
    "modified creature you control": "TheNumberOfPermanentsOnTheBattlefield(And([IsModified, IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))",
    "multicolored permanent you control": "TheNumberOfPermanentsOnTheBattlefield(And([IsMulticolored, IsPermanent, ControlledByAPlayer(SinglePlayer(You))]))",
    "nonbasic land your opponents control": "TheNumberOfPermanentsOnTheBattlefield(And([IsNonSupertype(Basic), IsCardtype(Land), ControlledByAPlayer(Opponent)]))",
    "noncreature token you control": "TheNumberOfPermanentsOnTheBattlefield(And([IsNonCardtype(Creature), IsToken, ControlledByAPlayer(SinglePlayer(You))]))",
    "noncreature, nonland card in your graveyard": "TheNumberOfGraveyardCards(And([IsNonCardtype(Creature), IsNonCardtype(Land), InAPlayersGraveyard(SinglePlayer(You))]))",
    "nontoken attacking creature": "TheNumberOfPermanentsOnTheBattlefield(And([IsNonToken, IsAttacking, IsCardtype(Creature)]))",
    "nontoken creature put into your graveyard from the battlefield this turn": "TheNumberOfPermanentsPutIntoPlayersGraveyardThisTurn(And([IsNonToken, IsCardtype(Creature)]), You)",
    "nontoken creature that died this turn": "NumCreaturesOrPlaneswalkersThatDiedThisTurn(And([IsNonToken, IsCardtype(Creature)]))",
    "nontoken creature that died under your control this turn": "NumCreaturesOrPlaneswalkersThatDiedThisTurn(And([IsNonToken, IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))",
    "nontoken creature you control": "TheNumberOfPermanentsOnTheBattlefield(And([IsNonToken, IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))",
    "nontoken creature you controlled that died this turn": "NumCreaturesOrPlaneswalkersThatDiedThisTurn(And([IsNonToken, IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))",
    "nontoken {{Zombie}} you control": "TheNumberOfPermanentsOnTheBattlefield(And([IsNonToken, IsCreatureType({{Zombie[0]}}), ControlledByAPlayer(SinglePlayer(You))]))",
    "of your opponents who lost life this turn": "NumPlayers(And([Opponent, LostLifeThisTurn]))",
    "opponent who controls fewer creatures than you": "NumPlayers(ControlsLessPermanentThanPlayer(You, IsCardtype(Creature)))",
    "opponent who drew {{Number}} or more cards this turn": "NumPlayers(And([Opponent, NumCardsDrawnThisTurnIs(GreaterThanOrEqualTo({{Number[0]}}))]))",
    "opponent who had {{Number}} or more lands enter the battlefield under their control this turn": "NumPlayers(And([Opponent, HadANumberOfPermanentsEnterTheBattlefieldUnderTheirControlThisTurn(GreaterThanOrEqualTo({{Number[0]}}), IsCardtype(Land))]))",
    "opponent who has less life than you": "NumPlayers(And([Opponent, LifeTotalIs(LessThan(LifeTotalOfPlayer(You)))]))",
    "opponent who has more cards in hand than you": "NumPlayers(And([Opponent, NumCardsInHandIs(GreaterThan(TheNumberOfCardsInPlayersHand(You)))]))",
    "opponent who has more cards in their hand than you": "NumPlayers(And([Opponent, NumCardsInHandIs(GreaterThan(TheNumberOfCardsInPlayersHand(You)))]))",
    "opponent who has one or fewer cards in hand": "NumPlayers(And([Opponent, NumCardsInHandIs(LessThanOrEqualTo(Integer(1)))]))",
    "opponent who lost life this turn": "NumPlayers(And([Opponent, LostLifeThisTurn]))",
    "opponent who was dealt damage this turn": "NumPlayers(And([Opponent, WasDealtDamageThisTurn]))",
    "opponent whose life total is less than half their starting life total": "NumPlayers(LifeTotalIs(LessThan(HalfRoundedUp(LifeTotalOfPlayer(NumPlayers_ThatPlayer)))))",
    "opponent with {{Number}} or more poison counters": "NumPlayers(And([Opponent, HasANumberOfPoisonCounters(GreaterThanOrEqualTo({{Number[0]}}))]))",
    "opponent you attacked this turn": "NumPlayers(And([Opponent, AttackedByPlayerThisTurn(You)]))",
    "opponent you have": "NumPlayers(Opponent)",
    "opponent you're attacking": "NumPlayers(And([Opponent, IsAttackedByPlayer(You)]))",
    "permanent card in your graveyard": "TheNumberOfGraveyardCards(And([IsPermanent, InAPlayersGraveyard(SinglePlayer(You))]))",
    "permanent sacrificed this turn": "TheNumberOfPermanentsSacrificedThisTurn(IsPermanent)",
    "permanent you control": "TheNumberOfPermanentsOnTheBattlefield(ControlledByAPlayer(SinglePlayer(You)))",
    "permanent you control but don't own": "TheNumberOfPermanentsOnTheBattlefield(And([IsPermanent, ControlledByAPlayer(SinglePlayer(You)), OwnedByAPlayer(Other(You))]))",
    "permanent you control with {{CounterType}} counters on it": "TheNumberOfPermanentsOnTheBattlefield(And([IsPermanent, ControlledByAPlayer(SinglePlayer(You)), HasACounterOfType({{CounterType[0]}})]))",
    "permanent you own that your opponents control": "TheNumberOfPermanentsOnTheBattlefield(And([IsPermanent, OwnedByAPlayer(SinglePlayer(You)), ControlledByAPlayer(Opponent)]))",
    "planeswalker you control": "TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Planeswalker), ControlledByAPlayer(SinglePlayer(You))]))",
    "player": "NumPlayers(AnyPlayer)",
    "player being attacked": "NumPlayers(IsAttacked)",
    "player who discarded a card this turn": "NumPlayers(DiscardedACardThisTurn)",
    "player who has lost the game": "TheNumberOfPlayersThatHaveLostTheGame",
    "player who lost life this turn": "NumPlayers(LostLifeThisTurn)",
    "player who was dealt combat damage this turn": "NumPlayers(WasDealtCombatDamageThisTurn)",
    "poison counter your opponents have": "NumCountersOfTypePlayersHave(PoisonCounter, Opponent)",
    "rad counter you have": "TheTotalNumberOfRadCountersAmongPlayers(SinglePlayer(You))",
    "spell or ability that caused one or more players to guess or to group cards or permanents into a pile this turn": "TheNumberOfSpellsOrAbilitiesThatCausedAnyNumberOfPlayersToGuessOrToGroupCardsOrPermanentsIntoAPileThisTurn(AnySpellOrAbility, AnyPlayer)",
    "spell you've cast this turn": "NumSpellsCastByPlayerThisTurn(AnySpell, You)",
    "spell you've cast this turn from anywhere other than your hand": "NumSpellsCastByPlayerThisTurn(WasntCastFromTheirHand, You)",
    "spell you've cast this turn other than the first": "NumSpellsCastByPlayerThisTurn(Other(TheNthSpellCastByPlayerThisTurn(Integer(1), AnySpell, You)), You)",
    "spell your opponents have cast this turn": "NumSpellsCastByAnyPlayerThisTurn(AnySpell, Opponent)",
    "suspended card you own": "NumCardsInExile(And([IsSuspended, OwnedByAPlayer(SinglePlayer(You))]))",
    "tapped artifact, creature, and land you control": "TheNumberOfPermanentsOnTheBattlefield(And([IsTapped, Or([IsCardtype(Artifact), IsCardtype(Creature), IsCardtype(Land)]), ControlledByAPlayer(SinglePlayer(You))]))",
    "tapped creature you control": "TheNumberOfPermanentsOnTheBattlefield(And([IsTapped, IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))",
    "tapped creature your opponents control": "TheNumberOfPermanentsOnTheBattlefield(And([IsTapped, IsCardtype(Creature), ControlledByAPlayer(Opponent)]))",
    "tapped land your opponents control": "TheNumberOfPermanentsOnTheBattlefield(And([IsTapped, IsCardtype(Land), ControlledByAPlayer(Opponent)]))",
    "tapped {{Zombie}}, {{Zombie}}, and/or Vehicle you control": "TheNumberOfPermanentsOnTheBattlefield(And([IsTapped, Or([IsCreatureType({{Zombie[0]}}), IsCreatureType({{Zombie[1]}}), IsArtifactType(Vehicle)]), ControlledByAPlayer(SinglePlayer(You))]))",
    "time you've cast a commander from the command zone this game": "NumTimesPlayerHasCastACommanderFromCommandZone(You)",
    "time you've cast your commander from the command zone this game": "NumTimesPlayerHasCastTheirCommanderFromCommandZone(You)",
    "token you control": "TheNumberOfPermanentsOnTheBattlefield(And([IsToken, ControlledByAPlayer(SinglePlayer(You))]))",
    "transformed permanent you control": "TheNumberOfPermanentsOnTheBattlefield(And([IsTransformed, ControlledByAPlayer(SinglePlayer(You))]))",
    "unspent {{Black}} mana you have": "AmountOfUnspentManaOfColorPlayerHas({{Black[0]}}, You)",
    "untapped creature you control": "TheNumberOfPermanentsOnTheBattlefield(And([IsUntapped, IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))",
    "untapped permanent your opponents control": "TheNumberOfPermanentsOnTheBattlefield(And([IsUntapped, ControlledByAPlayer(Opponent)]))",
    "{{Black}} creature card in your graveyard": "TheNumberOfGraveyardCards(And([IsColor({{Black[0]}}), IsCardtype(Creature), InAPlayersGraveyard(SinglePlayer(You))]))",
    "{{Black}} creature you control": "TheNumberOfPermanentsOnTheBattlefield(And([IsColor({{Black[0]}}), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))",
    "{{Black}} creature your opponents control": "TheNumberOfPermanentsOnTheBattlefield(And([IsColor({{Black[0]}}), IsCardtype(Creature), ControlledByAPlayer(Opponent)]))",
    "{{Black}} mana symbol in the mana costs of permanents you control": "NumColorManaSymbolsInCostsOfPermanents({{Black[0]}}, ControlledByAPlayer(SinglePlayer(You)))",
    "{{Black}} permanent you control": "TheNumberOfPermanentsOnTheBattlefield(And([IsColor({{Black[0]}}), ControlledByAPlayer(SinglePlayer(You))]))",
    "{{Black}} permanent your opponents control": "TheNumberOfPermanentsOnTheBattlefield(And([IsColor({{Black[0]}}), ControlledByAPlayer(Opponent)]))",
    "{{CounterType}} counter among Sagas you control": "NumCountersOfTypeOnPermanents({{CounterType[0]}}, And([IsEnchantmentType(Saga), ControlledByAPlayer(SinglePlayer(You))]))",
    "{{CounterType}} counter among permanents you control": "NumCountersOfTypeOnPermanents({{CounterType[0]}}, And([IsPermanent, ControlledByAPlayer(SinglePlayer(You))]))",
    "{{CounterType}} counter on creatures you control": "NumCountersOfTypeOnPermanents({{CounterType[0]}}, And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))",
    "{{CounterType}} counter on planeswalkers you control": "NumCountersOfTypeOnPermanents({{CounterType[0]}}, And([IsCardtype(Planeswalker), ControlledByAPlayer(SinglePlayer(You))]))",
    "{{CounterType}} counter you've put on creatures under your control this turn": "NumCountersOfTypePlayerHasPutOnPermanentsThisTurn({{CounterType[0]}}, You, And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))",
    "{{EnergyCounter}} you've paid or lost this turn": "TheAmountOfEnergyPaidOrLostByPlayersThisTurn(SinglePlayer(You))",
    "{{Swamp}} card in your graveyard": "TheNumberOfGraveyardCards(And([IsLandType({{Swamp[0]}}), InAPlayersGraveyard(SinglePlayer(You))]))",
    "{{Swamp}} land you control": "TheNumberOfPermanentsOnTheBattlefield(And([IsLandType({{Swamp[0]}}), IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You))]))",
    "{{Swamp}} on the battlefield": "TheNumberOfPermanentsOnTheBattlefield(IsLandType({{Swamp[0]}}))",
    "{{Swamp}} you control": "TheNumberOfPermanentsOnTheBattlefield(And([IsLandType({{Swamp[0]}}), ControlledByAPlayer(SinglePlayer(You))]))",
    "{{Swamp}} your opponents control": "TheNumberOfPermanentsOnTheBattlefield(And([IsLandType({{Swamp[0]}}), ControlledByAPlayer(Opponent)]))",
    "{{Zombie}} and/or {{Zombie}} you control": "TheNumberOfPermanentsOnTheBattlefield(And([Or([IsCreatureType({{Zombie[0]}}), IsCreatureType({{Zombie[1]}})]), ControlledByAPlayer(SinglePlayer(You))]))",
    "{{Zombie}} card in your graveyard": "TheNumberOfGraveyardCards(And([IsCreatureType({{Zombie[0]}}), InAPlayersGraveyard(SinglePlayer(You))]))",
    "{{Zombie}} card in your hand": "TheNumberOfCardsOfTypeInPlayersHand(IsCreatureType({{Zombie[0]}}), You)",
    "{{Zombie}} card in your library": "NumCardsOfTypeInPlayersLibrary(IsCreatureType({{Zombie[0]}}), You)",
    "{{Zombie}} on the battlefield": "TheNumberOfPermanentsOnTheBattlefield(IsCreatureType({{Zombie[0]}}))",
    "{{Zombie}} or {{Zombie}} you control": "TheNumberOfPermanentsOnTheBattlefield(And([Or([IsCreatureType({{Zombie[0]}}), IsCreatureType({{Zombie[1]}})]), ControlledByAPlayer(SinglePlayer(You))]))",
    "{{Zombie}} that died this turn": "NumCreaturesOrPlaneswalkersThatDiedThisTurn(IsCreatureType({{Zombie[0]}}))",
    "{{Zombie}} you control": "TheNumberOfPermanentsOnTheBattlefield(And([IsCreatureType({{Zombie[0]}}), ControlledByAPlayer(SinglePlayer(You))]))",
    "{{Zombie}}, Equipment, and/or Vehicle you control": "TheNumberOfPermanentsOnTheBattlefield(And([Or([IsCreatureType({{Zombie[0]}}), IsArtifactType(Equipment), IsArtifactType(Vehicle)]), ControlledByAPlayer(SinglePlayer(You))]))"
  },
  "{{EmblemQuotedAbility}}": {
    "As long as {{Condition}}, you can't lose the game and your opponents can't win the game": "If({{Condition[0]}}, [PlayerEffect(You, [CantLoseTheGame]), EachPlayerEffect(Opponent, [CantWinTheGame])])",
    "At the beginning of combat on your turn, {{TriggerActions}}": "TriggerA(AtTheBeginningOfCombatDuringAPlayersTurn(SinglePlayer(You)), {{TriggerActions[0]}})",
    "At the beginning of each end step, {{TriggerActions}}": "TriggerA(AtTheBeginningOfAPlayersEndStep(AnyPlayer), {{TriggerActions[0]}})",
    "At the beginning of each opponent's upkeep, that player sacrifices a creature of their choice": "TriggerA(AtTheBeginningOfAPlayersUpkeep(Opponent), ActionList([PlayerAction(Trigger_ThatPlayer, SacrificeAPermanent(IsCardtype(Creature)))]))",
    "At the beginning of your draw step, {{TriggerActions}}": "TriggerA(AtTheBeginningOfAPlayersDrawStep(SinglePlayer(You)), {{TriggerActions[0]}})",
    "At the beginning of your end step, {{TriggerActions}}": "TriggerA(AtTheBeginningOfAPlayersEndStep(SinglePlayer(You)), {{TriggerActions[0]}})",
    "At the beginning of your upkeep, this emblem deals {{Digits}} damage to you": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), ActionList([EmblemDealsDamage(ThisEmblem, {{Digits[0]}}, Player(You))]))",
    "At the beginning of your upkeep, {{TriggerActions}}": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), {{TriggerActions[0]}})",
    "At the end of the first combat phase on your turn, untap target {{Permanent}}. After this phase, there is an additional combat phase": "TriggerA(If(IsPlayersTurn(You), AtTheEndOfTheFirstCombat), Targeted([TargetPermanent({{Permanent[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent), ThereIsAnAdditionalCombatPhase])))",
    "Creatures you control of the chosen type get {{PTMod}} and have {{Hasable}} and {{Hasable}}": "EachPermanentLayerEffect(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), IsCreatureTypeVariable(TheChosenCreatureType)]), [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])])",
    "If a source would deal damage to you or a planeswalker you control, prevent all but {{Digits}} of that damage": "PreventDamage(DamageWouldBeDealtByASourceToARecipient(AnyDamageSource, APlayerOrAPermanent(SinglePlayer(You), And([IsCardtype(Planeswalker), ControlledByAPlayer(SinglePlayer(You))]))), [PreventAllButSomeOfThatDamage({{Digits[0]}})])",
    "If {{Condition}}, damage that would reduce your life total to less than {{Digits}} reduces it to {{Digits}} instead": "If({{Condition[0]}}, [PlayerEffect(You, [DamageThatWouldReduceLifeTotalToLessThanNumberReducesItToThatNumberInstead({{Digits[0]}})])])",
    "Instant and sorcery cards in your graveyard have retrace": "EachCardInGraveyardEffect(Or([IsCardtype(Instant), IsCardtype(Sorcery)]), You, [AddAbility([Retrace])])",
    "Untap all permanents you control during each opponent's untap step": "PlayerEffect(You, [UntapsPermanentsDuringEachPlayersUntapSteps(ControlledByAPlayer(SinglePlayer(You)), Opponent)])",
    "Whenever a card is put into your graveyard from anywhere, you may return it to your hand": "TriggerA(WhenACardIsPutIntoAPlayersGraveyardFromAnywhere(AnyCard, SinglePlayer(You)), ActionList([MayAction(ReturnGraveyardCardToHand(Trigger_ThatGraveyardCard))]))",
    "Whenever a creature attacks you, {{TriggerActions(ThatPermanent)}}": "TriggerA(WhenACreatureAttacksAPlayer(IsCardtype(Creature), SinglePlayer(You)), {{TriggerActions(ThatPermanent=Trigger_ThatCreature)[0]}})",
    "Whenever a creature dies, return it to the battlefield under your control at the beginning of the next end step": "TriggerA(WhenACreatureOrPlaneswalkerDies(IsCardtype(Creature)), ActionList([CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutGraveyardCardOntoBattlefield(Trigger_ThatGraveyardCard, [EntersUnderPlayersControl(You)])]))]))",
    "Whenever a creature dies, target opponent loses {{Digits}} life and you gain {{Digits}} life": "TriggerA(WhenACreatureOrPlaneswalkerDies(IsCardtype(Creature)), Targeted([TargetPlayer(Opponent)], ActionList([PlayerAction(Ref_TargetPlayer, LoseLife({{Digits[0]}})), GainLife({{Digits[1]}})])))",
    "Whenever a creature you control deals combat damage to a player, {{TriggerActions(ThatPlayer)}}": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]), AnyPlayer), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "Whenever a creature you control enters, {{TriggerActions(ThatCreature)}}": "TriggerA(WhenAPermanentEntersTheBattlefield(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))])), {{TriggerActions(ThatCreature=Trigger_ThatPermanent)[0]}})",
    "Whenever a creature you control enters, {{TriggerActions(ThatPermanent)}}": "TriggerA(WhenAPermanentEntersTheBattlefield(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))])), {{TriggerActions(ThatPermanent=Trigger_ThatPermanent)[0]}})",
    "Whenever a player casts {{a}} {{Spell}}, {{TriggerActions}}": "TriggerA(WhenAPlayerCastsASpell(AnyPlayer, {{Spell[0]}}), {{TriggerActions[0]}})",
    "Whenever a player draws a card, {{TriggerActions}}": "TriggerA(WhenAPlayerDrawsACard(AnyPlayer), {{TriggerActions[0]}})",
    "Whenever an artifact is put into your graveyard from the battlefield, {{TriggerActions[WhenAPermanentIsPutIntoAGraveyard]}}": "TriggerA(WhenAPermanentIsPutIntoAPlayersGraveyard(IsCardtype(Artifact), SinglePlayer(You)), {{TriggerActions[WhenAPermanentIsPutIntoAGraveyard][0]}})",
    "Whenever an artifact you control enters, this emblem deals {{Digits}} damage to any target": "TriggerA(WhenAPermanentEntersTheBattlefield(And([IsCardtype(Artifact), ControlledByAPlayer(SinglePlayer(You))])), Targeted([AnyTarget], ActionList([EmblemDealsDamage(ThisEmblem, {{Digits[0]}}, Ref_AnyTarget)])))",
    "Whenever an opponent casts their {{Nth}} {{Spell}} each turn, counter that spell": "TriggerA(WhenAPlayerCastsTheirNthSpellInATurn(Opponent, EqualTo({{Nth[0]}}), {{Spell[0]}}), ActionList([CounterSpell(Trigger_ThatSpell)]))",
    "Whenever an opponent is dealt combat damage by one or more creatures you control, if that player lost less than {{Digits}} life this turn, they lose life equal to the difference": "TriggerI(WhenAnyNumberOfCreaturesDealCombatDamageToAPlayer(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]), Opponent), PlayerPassesFilter(Trigger_ThatPlayer, LostLifeAmountThisTurn(LessThan({{Digits[0]}}))), ActionList([PlayerAction(Trigger_ThatPlayer, LoseLife(Minus({{Digits[0]}}, LifeLostByPlayerThisTurn(Trigger_ThatPlayer))))]))",
    "Whenever you activate an ability that isn't a mana ability, copy it. You may choose new targets for the copy": "TriggerA(WhenAPlayerActivatesAnAbility(SinglePlayer(You), NonManaAbility), ActionList([CopyAbilityAndMayChooseNewTargets(Trigger_ThatActivatedAbility)]))",
    "Whenever you cast a spell that targets one or more permanents, gain control of those permanents": "TriggerA(WhenAPlayerCastsASpellThatTargetsAnyNumberOfPermanents(SinglePlayer(You), AnySpell, AnyPermanent), ActionList([GainControlOfEachPermanent(Trigger_ThosePermanents)]))",
    "Whenever you cast {{a}} {{CreatureSpell}}, it gains {{Hasable}} until end of turn and you draw {{Number}} cards": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), {{CreatureSpell[0]}}), ActionList([CreatePermanentSpellLayerEffect(UntilEndOfTurn, Trigger_ThatSpell, [AddAbility([{{Hasable[0]}}])]), DrawNumberCards({{Number[0]}})]))",
    "Whenever you cast {{a}} {{Spell}}, this emblem deals X damage to any target, where X is {{GameNumber(ThatSpell)}}": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), Targeted([AnyTarget], ActionList([EmblemDealsDamage(ThisEmblem, {{GameNumber(ThatSpell=Trigger_ThatSpell)[0]}}, Ref_AnyTarget)])))",
    "Whenever you cast {{a}} {{Spell}}, this emblem deals {{Digits}} damage to any target": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), Targeted([AnyTarget], ActionList([EmblemDealsDamage(ThisEmblem, {{Digits[0]}}, Ref_AnyTarget)])))",
    "Whenever you cast {{a}} {{Spell}}, this emblem deals {{Digits}} damage to any target and you draw {{Number}} cards": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), Targeted([AnyTarget], ActionList([EmblemDealsDamage(ThisEmblem, {{Digits[0]}}, Ref_AnyTarget), DrawNumberCards({{Number[0]}})])))",
    "Whenever you cast {{a}} {{Spell}}, {{TriggerActions(ThatSpell)}}": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), {{TriggerActions(ThatSpell=Trigger_ThatSpell)[0]}})",
    "Whenever you cast {{a}} {{Spell}}, {{TriggerActions}}": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), {{TriggerActions[0]}})",
    "Whenever you draw a card, exile target {{Permanent}}": "TriggerA(WhenAPlayerDrawsACard(SinglePlayer(You)), Targeted([TargetPermanent({{Permanent[0]}})], ActionList([ExilePermanent(Ref_TargetPermanent)])))",
    "Whenever you gain life, target opponent loses that much life": "TriggerA(WhenAPlayerGainsLife(SinglePlayer(You)), Targeted([TargetPlayer(Opponent)], ActionList([PlayerAction(Ref_TargetPlayer, LoseLife(Trigger_ThatMuch))])))",
    "Whenever {{a}} {{Creature}} deals combat damage to a player, {{TriggerActions}}": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer({{Creature[0]}}, AnyPlayer), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Permanent}} becomes tapped, {{TriggerActions}}": "TriggerA(WhenAPermanentBecomesTapped({{Permanent[0]}}), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Permanent}} enters, {{TriggerActions}}": "TriggerA(WhenAPermanentEntersTheBattlefield({{Permanent[0]}}), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Swamp}} you control enters, this emblem deals {{Digits}} damage to any target": "TriggerA(WhenAPermanentEntersTheBattlefield(And([IsLandType({{Swamp[0]}}), ControlledByAPlayer(SinglePlayer(You))])), Targeted([AnyTarget], ActionList([EmblemDealsDamage(ThisEmblem, {{Digits[0]}}, Ref_AnyTarget)])))",
    "You draw a card during each opponent's draw step": "PlayerEffect(You, [DrawsACardDuringEachPlayersUntapStep(Opponent)])",
    "You have no maximum hand size": "PlayerEffect(You, [HasNoMaximumHandSize])",
    "You may activate loyalty abilities of planeswalkers you control on any player's turn any time you could cast an instant": "PlayerEffect(You, [MayActivateLoyaltyAbilityOfPlaneswalkersDuringEachPlayersTurnAndAnyTimeTheyCouldCastAnInstant(And([IsCardtype(Planeswalker), ControlledByAPlayer(SinglePlayer(You))]), AnyPlayer)])",
    "You may cast instant and sorcery spells from your graveyard. If a spell cast this way would be put into your graveyard, exile it instead": "PlayerEffect(You, [MayCastSpellsFromGraveyardIntoExile(Or([IsCardtype(Instant), IsCardtype(Sorcery)]))])",
    "You may cast spells from your hand without paying their mana costs": "PlayerEffect(You, [MayCastSpellsFromHandWithoutPaying])",
    "You may play lands and cast permanent spells from your graveyard": "PlayerEffect(You, [MayPlayLandsFromGraveyard(IsCardtype(Land)), MayCastSpellsFromGraveyard(IsPermanent)])",
    "Your opponents can't cast {{PotentialSpells}}": "EachPlayerEffect(Opponent, [CantCastSpells({{PotentialSpells[0]}})])",
    "Your opponents can't untap more than {{Number}} permanents during their untap steps": "EachPlayerEffect(Opponent, [CantUntapMoreThanNumberPermanentsDuringTheirUntapStep({{Number[0]}}, AnyPermanent)])",
    "{{Creatures}} get {{PTMod}}": "EachPermanentLayerEffect({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})])",
    "{{Creatures}} get {{PTMod}} and have {{Hasable}}": "EachPermanentLayerEffect({{Creatures[0]}}, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])])",
    "{{Creatures}} get {{PTMod}} and have {{Hasable}}, {{Hasable}}, and {{Hasable}}": "EachPermanentLayerEffect({{Creatures[0]}}, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}]), AddAbility([{{Hasable[2]}}])])",
    "{{Creatures}} have base power and toughness {{PT}}": "EachPermanentLayerEffect({{Creatures[0]}}, [SetPT({{PT[0]}})])",
    "{{Creatures}} have {{Hasable}} and '{{QuotedAbility[ThisCreature]}}'": "EachPermanentLayerEffect({{Creatures[0]}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{QuotedAbility[ThisCreature][0]}}])])",
    "{{Creatures}} have {{Hasable}} and {{Hasable}} and get {{PTMod}} for each {{Eachable}}": "EachPermanentLayerEffect({{Creatures[0]}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}]), AdjustPTForEach({{PTMod[0]}}, {{Eachable[0]}})])",
    "{{ManaCost}}, Sacrifice a creature: You gain X life and draw X cards, where X is the sacrificed creature's power": "Activated(And([PayMana({{ManaCost[0]}}), SacrificeAPermanent(IsCardtype(Creature))]), ActionList([GainLife(PowerOfPermanent(ThePermanentSacrificedThisWay)), DrawNumberCards(PowerOfPermanent(ThePermanentSacrificedThisWay))]))",
    "{{Permanents}} have '{{QuotedAbility}}'": "EachPermanentLayerEffect({{Permanents[0]}}, [AddAbility([{{QuotedAbility[0]}}])])",
    "{{Permanents}} have {{Hasable}}": "EachPermanentLayerEffect({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])])",
    "{{Permanents}} have {{Hasable}}, {{Hasable}}, {{Hasable}}, and {{Hasable}}": "EachPermanentLayerEffect({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}]), AddAbility([{{Hasable[2]}}]), AddAbility([{{Hasable[3]}}])])",
    "{{PotentialSpells}} you cast cost {{CostReduce}} less to cast": "StackSpellsEffect(And([{{PotentialSpells[0]}}, CastByPlayer(You)]), [DecreaseManaCost({{CostReduce[0]}})])",
    "{{PotentialSpells}} you cast have storm": "StackSpellsEffect(And([{{PotentialSpells[0]}}, CastByPlayer(You)]), [Storm])",
    "{{TapAPermanentCost}}: This emblem deals {{Digits}} damage to any target": "Activated({{TapAPermanentCost[0]}}, Targeted([AnyTarget], ActionList([EmblemDealsDamage(ThisEmblem, {{Digits[0]}}, Ref_AnyTarget)])))"
  },
  "{{Enchantments}}": {
    "Auras": "IsEnchantmentType(Aura)",
    "Auras attached to attacking creatures your opponents control": "And([IsEnchantmentType(Aura), AttachedToAPermanent(And([IsAttacking, IsCardtype(Creature), ControlledByAPlayer(Opponent)]))])",
    "Auras attached to permanents you control": "And([IsEnchantmentType(Aura), AttachedToAPermanent(ControlledByAPlayer(SinglePlayer(You)))])",
    "Auras you control": "And([IsEnchantmentType(Aura), ControlledByAPlayer(SinglePlayer(You))])",
    "Auras you own attached to attacking creatures your opponents control": "And([IsEnchantmentType(Aura), OwnedByAPlayer(SinglePlayer(You)), AttachedToAPermanent(And([IsAttacking, IsCardtype(Creature), ControlledByAPlayer(Opponent)]))])",
    "Auras you own attached to permanents you control": "And([IsEnchantmentType(Aura), OwnedByAPlayer(SinglePlayer(You)), AttachedToAPermanent(ControlledByAPlayer(SinglePlayer(You)))])",
    "Curses attached to you": "And([IsEnchantmentType(Curse), AttachedToPlayer(You)])",
    "Sagas you control": "And([IsEnchantmentType(Saga), ControlledByAPlayer(SinglePlayer(You))])",
    "Shards you control": "And([IsEnchantmentType(Shard), ControlledByAPlayer(SinglePlayer(You))])",
    "enchantments": "IsCardtype(Enchantment)",
    "enchantments you both own and control": "And([IsCardtype(Enchantment), OwnedByAPlayer(SinglePlayer(You)), ControlledByAPlayer(SinglePlayer(You))])",
    "enchantments you control": "And([IsCardtype(Enchantment), ControlledByAPlayer(SinglePlayer(You))])",
    "enchantments you don't control": "And([IsCardtype(Enchantment), ControlledByAPlayer(Other(You))])",
    "enchantments your opponents control": "And([IsCardtype(Enchantment), ControlledByAPlayer(Opponent)])",
    "non-Aura enchantments": "And([IsEnchantmentType(Aura), IsCardtype(Enchantment)])",
    "{{Black}} Auras you own": "And([IsColor({{Black[0]}}), IsEnchantmentType(Aura), OwnedByAPlayer(SinglePlayer(You))])",
    "{{Black}} enchantments": "And([IsColor({{Black[0]}}), IsCardtype(Enchantment)])",
    "{{NonBlack}} enchantments": "And([IsNonColor({{NonBlack[0]}}), IsCardtype(Enchantment)])"
  },
  "{{Enchantment}}": {
    "Aura": "IsEnchantmentType(Aura)",
    "Aura attached to a creature": "And([IsEnchantmentType(Aura), AttachedToAPermanent(IsCardtype(Creature))])",
    "Aura attached to a creature you control": "And([IsEnchantmentType(Aura), AttachedToAPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))])",
    "Aura attached to a land": "And([IsEnchantmentType(Aura), AttachedToAPermanent(IsCardtype(Land))])",
    "Aura you control": "And([IsEnchantmentType(Aura), ControlledByAPlayer(SinglePlayer(You))])",
    "Cartouche you control": "And([IsEnchantmentType(Cartouche), ControlledByAPlayer(SinglePlayer(You))])",
    "Curse": "IsEnchantmentType(Curse)",
    "Curse attached to you": "And([IsEnchantmentType(Curse), AttachedToPlayer(You)])",
    "Saga you control": "And([IsEnchantmentType(Saga), ControlledByAPlayer(SinglePlayer(You))])",
    "Shrine": "IsEnchantmentType(Shrine)",
    "Shrine you control": "And([IsEnchantmentType(Shrine), ControlledByAPlayer(SinglePlayer(You))])",
    "enchantment": "IsCardtype(Enchantment)",
    "enchantment an opponent controls": "And([IsCardtype(Enchantment), ControlledByAPlayer(Opponent)])",
    "enchantment with mana value {{Digits}} or greater": "And([IsCardtype(Enchantment), ManaValueIs(GreaterThanOrEqualTo({{Digits[0]}}))])",
    "enchantment you control": "And([IsCardtype(Enchantment), ControlledByAPlayer(SinglePlayer(You))])",
    "enchantment you control that doesn't have the same name as another permanent you control": "And([IsCardtype(Enchantment), ControlledByAPlayer(SinglePlayer(You)), DoesntShareANameWithAPermanent(And([IsToken, ControlledByAPlayer(SinglePlayer(You))]))])",
    "non-Aura enchantment": "And([IsNonEnchantmentType(Aura), IsCardtype(Enchantment)])",
    "non-Aura enchantment you control": "And([IsNonEnchantmentType(Aura), IsCardtype(Enchantment), ControlledByAPlayer(SinglePlayer(You))])",
    "nonlegendary enchantment you control": "And([IsNonSupertype(Legendary), IsCardtype(Enchantment), ControlledByAPlayer(SinglePlayer(You))])",
    "nontoken Shrine you control": "And([IsNonToken, IsEnchantmentType(Shrine), ControlledByAPlayer(SinglePlayer(You))])",
    "nontoken enchantment": "And([IsNonToken, IsCardtype(Enchantment)])",
    "nontoken enchantment you control": "And([IsNonToken, IsCardtype(Enchantment), ControlledByAPlayer(SinglePlayer(You))])",
    "{{Black}} enchantment you control that doesn't have cumulative upkeep": "And([IsColor({{Black[0]}}), IsCardtype(Enchantment), ControlledByAPlayer(SinglePlayer(You)), DoesntHaveAbility(AnyCumulativeUpkeep)])",
    "{{Black}} or {{Black}} enchantment you control": "And([Or([IsColor({{Black[0]}}), IsColor({{Black[1]}})]), IsCardtype(Enchantment), ControlledByAPlayer(SinglePlayer(You))])"
  },
