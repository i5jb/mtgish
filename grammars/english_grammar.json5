    "you win the game": "ActionList([WinTheGame])",
    "your life total becomes half your starting life total, rounded up": "ActionList([SetLifeTotal(HalfRoundedUp(StartingLifeTotalOfPlayer(You)))])",
    "your life total becomes {{Digits}}": "ActionList([SetLifeTotal({{Digits[0]}})])",
