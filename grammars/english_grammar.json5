    "scry {{Digits}}. If this is the second time this ability has resolved this turn, draw a card instead": "ActionList([IfElse(TimesThisAbilityHasResolvedThisTurnIs(EqualTo(Integer(2))), [DrawACard], [Scry({{Digits[0]}})])])",
    "scry {{Digits}}. If this is the second time this ability has resolved this turn, the Ring tempts you": "ActionList([Scry({{Digits[0]}}), If(TimesThisAbilityHasResolvedThisTurnIs(EqualTo(Integer(2))), [TemptWithRing])])",
