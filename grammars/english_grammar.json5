    "Move a counter from target {{Permanent}} onto a second target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}}), TargetPermanent(And([Other(Ref_TargetPermanent1), {{Permanent[1]}}]))], ActionList([MoveACounterFromPermanentOntoAnotherPermanent(Ref_TargetPermanent1, Ref_TargetPermanent2)]))",
    "Move a counter from target {{Permanent}} onto target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}}), TargetPermanent({{Permanent[1]}})], ActionList([MoveACounterFromPermanentOntoAnotherPermanent(Ref_TargetPermanent1, Ref_TargetPermanent2)]))",
    "Move all {{CounterType}} counters from target {{Permanent}} onto target {{Permanent}}. If one or more {{CounterType}} counters are moved this way, you gain that much life and draw a card": "Targeted([TargetPermanent({{Permanent[0]}}), TargetPermanent({{Permanent[1]}})], ActionList([MoveAllCountersOfTypeFromPermanentOntoPermanent({{CounterType[0]}}, Ref_TargetPermanent1, Ref_TargetPermanent2), If(ANumberOfCountersOfTypeWereMovedThisWay(GreaterThanOrEqualTo(Integer(1)), {{CounterType[1]}}), [GainLife(TheNumberOfCountersOfTypeMovedThisWay({{CounterType[1]}})), DrawACard])]))",
    "Move any number of counters from target {{Permanent}} onto a second target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}}), TargetPermanent(And([Other(Ref_TargetPermanent1), {{Permanent[0]}}]))], ActionList([MoveAnyNumberOfCountersFromPermanentOntoNewPermanent(Ref_TargetPermanent1, Ref_TargetPermanent2)]))",
    "Move {{a}} {{CounterType}} counter from target {{Permanent}} onto a second target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}}), TargetPermanent(And([Other(Ref_TargetPermanent1), {{Permanent[1]}}]))], ActionList([MoveACounterOfTypeFromPermanentOntoAnotherPermanent({{CounterType[0]}}, Ref_TargetPermanent1, Ref_TargetPermanent2)]))",
    "Move {{a}} {{CounterType}} counter from target {{Permanent}} onto another target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}}), TargetPermanent(And([Other(Ref_TargetPermanent1), {{Permanent[1]}}]))], ActionList([MoveACounterOfTypeFromPermanentOntoAnotherPermanent({{CounterType[0]}}, Ref_TargetPermanent1, Ref_TargetPermanent2)]))",
    "Move {{a}} {{CounterType}} counter from target {{Permanent}} onto another target {{Permanent}} with the same controller": "Targeted([TargetPermanent({{Permanent[0]}}), TargetPermanent(And([Other(Ref_TargetPermanent1), {{Permanent[0]}}, ControlledByPlayer(ControllerOfPermanent(Ref_TargetPermanent1))]))], ActionList([MoveACounterOfTypeFromPermanentOntoAnotherPermanent({{CounterType[0]}}, Ref_TargetPermanent1, Ref_TargetPermanent2)]))",
    "Note the name of target {{SpecificCard}} in your graveyard and put it onto the battlefield face down. It's {{a}} {{PT}} creature with \"{{QuotedAbility}}\" and \"{{QuotedAbility}}\"": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersAsFaceDownCreatureWithAbilitiesAndNotedName({{PT[0]}}, [{{QuotedAbility[0]}}, {{QuotedAbility[1]}}], NameOfGraveyardCard(Ref_TargetGraveyardCard))])]))",
    "Pay any amount of mana. Look at that many cards from the top of your library, then put one of those cards into your hand and the rest on the bottom of your library in a random order": "ActionList([PayAnyAmountOfMana, LookAtTheTopNumberCardsOfLibrary(AmountOfManaPaidThisWay, [PutAGenericCardIntoHand, PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
