  "{{TokenDescription}}": {
    "A colorless Aura Role enchantment named {{NamedCard}} with enchant creature and \"{{TokenQuotedAbility}}\".": "NamedToken({{NamedCard[0]}}, Colorless, [], [Enchantment], SubtypesList([Aura, Role]), [EnchantPermanent(IsCardtype(Creature)), {{TokenQuotedAbility[0]}}])",
    "A colorless Aura Role enchantment named {{NamedCard}} with enchant creature, \"{{TokenQuotedAbility}}\", and \"{{TokenQuotedAbility}}\".": "NamedToken({{NamedCard[0]}}, Colorless, [], [Enchantment], SubtypesList([Aura, Role]), [EnchantPermanent(IsCardtype(Creature)), {{TokenQuotedAbility[0]}}, {{TokenQuotedAbility[1]}}])",
    "A colorless {{Clue}} artifact with \"{{TokenQuotedAbility}}\".": "Token(Colorless, [], [Artifact], SubtypesList([{{Clue[0]}}]), [{{TokenQuotedAbility[0]}}])",
    "A colorless {{Clue}} artifact with {{Hasable}} and \"{{TokenQuotedAbility}}\".": "Token(Colorless, [], [Artifact], SubtypesList([{{Clue[0]}}]), [{{Hasable[0]}}, {{TokenQuotedAbility[0]}}])",
    "A colorless {{Curse}} enchantment with \"{{TokenQuotedAbility}}\".": "Token(Colorless, [], [Enchantment], SubtypesList([{{Curse[0]}}]), [{{TokenQuotedAbility[0]}}])",
    "A double-faced token.\nIts front face is a colorless {{Clue}} artifact with \"{{TokenQuotedAbility}}\".\nIts back face is {{a}} {{PT}} colorless {{Zombie}} artifact creature.": "TransformingToken(Token(Colorless, [], [Artifact], SubtypesList([{{Clue[0]}}]), [{{TokenQuotedAbility[0]}}]), TokenWithPT({{PT[0]}}, Colorless, [], [Artifact, Creature], SubtypesList([{{Zombie[0]}}]), []))",
    "A {{PT}} {{Black}} {{Zombie}} creature named {{NamedCard}}.": "NamedTokenWithPT({{NamedCard[0]}}, {{PT[0]}}, Colors([{{Black[0]}}]), [], [Creature], SubtypesList([{{Zombie[0]}}]), [])",
    "A {{PT}} {{Black}} {{Zombie}} creature.": "TokenWithPT({{PT[0]}}, Colors([{{Black[0]}}]), [], [Creature], SubtypesList([{{Zombie[0]}}]), [])",
