    "{{LifeCost}}: {{ActivatedActions(~GraveyardCard)}}. {{ActivateModifiers}}": "FromGraveyard(ActivatedWithModifiers({{LifeCost[0]}}, {{ActivatedActions(~GraveyardCard=^~GraveyardCard)[0]}}, {{ActivateModifiers[0]}}))",
    "{{ManaCostX}}, {{ExileSelfGraveyardCost}}: {{ActivatedActions(X)}}. {{ActivateModifiers}}": "FromGraveyard(ActivatedWithModifiers(And([PayManaX({{ManaCostX[0]}}, ValueX), {{ExileSelfGraveyardCost[0]}}]), {{ActivatedActions(X=ValueX)[0]}}, {{ActivateModifiers[0]}}))",
    "{{ManaCostX}}: {{ActivatedActions(~GraveyardCard,X)}}": "FromGraveyard(Activated(PayManaX({{ManaCostX[0]}}, ValueX), {{ActivatedActions(~GraveyardCard=^~GraveyardCard,X=ValueX)[0]}}))",
    "{{ManaCost}}, Blight {{Digits}}: {{ActivatedActions(~GraveyardCard)}}. {{ActivateModifiers}}": "FromGraveyard(ActivatedWithModifiers(And([PayMana({{ManaCost[0]}}), Blight({{Digits[0]}})]), {{ActivatedActions(~GraveyardCard=^~GraveyardCard)[0]}}, {{ActivateModifiers[0]}}))",
