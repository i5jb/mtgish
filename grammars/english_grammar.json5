    "Return {{a}} {{SpecificCard}} from your graveyard to the battlefield": "ActionList([ReturnACardFromPlayersGraveyardToBattlefield({{SpecificCard[0]}}, You, [EntersNormally])])",
    "Reveal a card from your hand or the top card of your library. If you reveal {{a}} {{SpecificCard}} this way, put it onto the battlefield": "ActionList([ChooseAnAction([[RevealACardFromHand, If(ACardWasRevealedThisWay({{SpecificCard[0]}}), [PutCardFromHandOnBattlefield(TheCardRevealedFromHandThisWay, [EntersNormally])])], [RevealTopCardOfLibrary, If(ACardWasRevealedThisWay({{SpecificCard[0]}}), [PutTopOfLibraryOnBattlefield([EntersNormally])])]])])",
    "Reveal any number of {{SpecificCards}} from your hand. Add {{ManaProduceSymbol}} for each card revealed this way": "ActionList([RevealAnyNumberOfCardsOfTypeFromHand({{SpecificCards[0]}}), AddManaRepeated({{ManaProduceSymbol[0]}}, TheNumberOfCardsInHandRevealedThisWay)])",
    "Reveal any number of {{SpecificCards}} in your hand. Add {{ManaProduceSymbol}}{{ManaProduceSymbol}} for each card revealed this way": "ActionList([RevealAnyNumberOfCardsOfTypeFromHand({{SpecificCards[0]}}), AddManaRepeated(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}]), TheNumberOfCardsInHandRevealedThisWay)])",
    "Reveal any number of {{SpecificCards}} in your hand. Add {{ManaProduceSymbol}}{{ManaProduceSymbol}} for each card revealed this way. Spend this mana only on costs that contain {X}": "ActionList([RevealAnyNumberOfCardsOfTypeFromHand({{SpecificCards[0]}}), AddManaRepeatedWithModifiers(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}]), TheNumberOfCardsInHandRevealedThisWay, CanOnlySpendOnXCost)])",
    "Reveal any number of {{SpecificCards}} in your hand. Counter target {{Spell}} unless its controller pays {{ManaCost}} for each card revealed this way": "Targeted([TargetSpell({{Spell[0]}})], ActionList([RevealAnyNumberOfCardsOfTypeFromHand({{SpecificCards[0]}}), PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), PayManaForEach({{ManaCost[0]}}, TheNumberOfCardsInHandRevealedThisWay)), Unless(CostWasPaid, [CounterSpell(Ref_TargetSpell)])]))",
    "Reveal any number of {{SpecificCards}} in your hand. Target {{Creature}} gets {{PTModX}} until end of turn, where X is the number of cards revealed this way": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([RevealAnyNumberOfCardsOfTypeFromHand({{SpecificCards[0]}}), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTX({{PTModX[0]}}, TheNumberOfCardsInHandRevealedThisWay)], UntilEndOfTurn)]))",
    "Reveal any number of {{SpecificCards}} in your hand. You gain {{Digits}} life for each card revealed this way": "ActionList([RevealAnyNumberOfCardsOfTypeFromHand({{SpecificCards[0]}}), GainLifeForEach({{Digits[0]}}, TheNumberOfCardsInHandRevealedThisWay)])",
    "Reveal cards from the top of your library until you reveal {{a}} {{SpecificCard}}. Put that card into your hand and all other cards revealed this way into your graveyard": "ActionList([RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed({{SpecificCard[0]}}, [PutTheCardFoundThisWayIntoHand, PutTheRemainingCardsIntoGraveyard])])",
    "Reveal cards from the top of your library until you reveal {{a}} {{SpecificCard}}. Put that card into your hand and exile all other cards revealed this way": "ActionList([RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed({{SpecificCard[0]}}, [PutTheCardFoundThisWayIntoHand, ExileTheRemainingCards])])",
    "Reveal cards from the top of your library until you reveal {{a}} {{SpecificCard}}. Put that card into your hand and the rest on the bottom of your library in a random order": "ActionList([RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed({{SpecificCard[0]}}, [PutTheCardFoundThisWayIntoHand, PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "Reveal cards from the top of your library until you reveal {{a}} {{SpecificCard}}. Put that card onto the battlefield and the rest on the bottom of your library in a random order": "ActionList([RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed({{SpecificCard[0]}}, [PutTheCardFoundThisWayOntoTheBattlefield([EntersNormally]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "Reveal cards from the top of your library until you reveal {{a}} {{SpecificCard}}. You may cast that card without paying its mana cost. Put all revealed cards not cast this way on the bottom of your library in a random order": "ActionList([RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed({{SpecificCard[0]}}, [MayCastTheCardFoundThisWayWithoutPaying, PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "Reveal target face-down permanent. If it's a creature card, you may turn it face up": "Targeted([TargetPermanent(And([IsFaceDown, IsPermanent]))], ActionList([RevealFaceDownPermanent(Ref_TargetPermanent), If(ACardWasRevealedThisWay(IsCardtype(Creature)), [MayAction(TurnPermanentFaceUp(Ref_TargetPermanent))])]))",
    "Reveal the top card of your library and put that card into your hand. Each opponent loses life equal to its mana value": "ActionList([RevealTopCardOfLibrary, PutTopOfLibraryInHand, EachPlayerAction(Opponent, LoseLife(ManaValueOfTheCardRevealedThisWay))])",
    "Reveal the top card of your library. If it has the same name as a card in your graveyard, put it into your graveyard. Otherwise, draw a card": "ActionList([RevealTopCardOfLibrary, IfElse(ACardWasRevealedThisWay(SharesANameWithAGraveyardCard(InAPlayersGraveyard(SinglePlayer(You)))), [PutTopOfLibraryInGraveyard], [DrawACard])])",
    "Reveal the top card of your library. If it isn't {{a}} {{SpecificCard}}, put it into your graveyard. Otherwise, put that card onto the battlefield. That creature gains {{Hasable}}. Sacrifice it at the beginning of the next end step": "ActionList([RevealTopCardOfLibrary, IfElse(ACardWasRevealedThisWay({{SpecificCard[0]}}), [PutTopOfLibraryOnBattlefield([EntersNormally]), CreatePermanentLayerEffect(ThePermanentPutOnTheBattlefieldThisWay, [AddAbility([{{Hasable[0]}}])]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([SacrificePermanent(ThePermanentPutOnTheBattlefieldThisWay)]))], [PutTopOfLibraryInGraveyard])])",
    "Reveal the top card of your library. If it's {{a}} {{SpecificCard}}, create {{a}} {{PT}} {{CreatureToken}}. If it's {{a}} {{SpecificCard}}, put that card onto the battlefield under your control. If it's {{a}} {{SpecificCard}}, you gain {{Digits}} life": "ActionList([RevealTopCardOfLibrary, If(ACardWasRevealedThisWay({{SpecificCard[0]}}), [CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])]), If(ACardWasRevealedThisWay({{SpecificCard[1]}}), [PutTopOfLibraryOnBattlefield([EntersUnderPlayersControl(You)])]), If(ACardWasRevealedThisWay({{SpecificCard[2]}}), [GainLife({{Digits[0]}})])])",
    "Reveal the top card of your library. If it's {{a}} {{SpecificCard}}, draw a card": "ActionList([RevealTopCardOfLibrary, If(ACardWasRevealedThisWay({{SpecificCard[0]}}), [DrawACard])])",
    "Reveal the top card of your library. If it's {{a}} {{SpecificCard}}, put it into your hand. Otherwise, put it on the bottom of your library": "ActionList([RevealTopCardOfLibrary, IfElse(ACardWasRevealedThisWay({{SpecificCard[0]}}), [PutTopOfLibraryInHand], [PutTopOfLibraryOnBottomOfLibrary])])",
    "Reveal the top card of your library. If it's {{a}} {{SpecificCard}}, put it into your hand. Otherwise, you may put it into your graveyard": "ActionList([RevealTopCardOfLibrary, IfElse(ACardWasRevealedThisWay({{SpecificCard[0]}}), [PutTopOfLibraryInHand], [MayAction(PutTopOfLibraryInGraveyard)])])",
    "Reveal the top card of your library. If it's {{a}} {{SpecificCard}}, put it into your hand. Otherwise, you may put it on the bottom of your library": "ActionList([RevealTopCardOfLibrary, IfElse(ACardWasRevealedThisWay({{SpecificCard[0]}}), [PutTopOfLibraryInHand], [MayAction(PutTopOfLibraryOnBottomOfLibrary)])])",
    "Reveal the top card of your library. If it's {{a}} {{SpecificCard}}, put it onto the battlefield. Otherwise, put it into your graveyard": "ActionList([RevealTopCardOfLibrary, IfElse(ACardWasRevealedThisWay({{SpecificCard[0]}}), [PutTopOfLibraryOnBattlefield([EntersNormally])], [PutTopOfLibraryInGraveyard])])",
    "Reveal the top card of your library. If it's {{a}} {{SpecificCard}}, put it onto the battlefield. Otherwise, put it into your hand": "ActionList([RevealTopCardOfLibrary, IfElse(ACardWasRevealedThisWay({{SpecificCard[0]}}), [PutTopOfLibraryOnBattlefield([EntersNormally])], [PutTopOfLibraryInHand])])",
    "Reveal the top card of your library. You may play that card without paying its mana cost. If you don't, exile it": "ActionList([RevealTopCardOfLibrary, MayCost(PlayTopCardOfLibraryWithoutPaying), Unless(CostWasPaid, [ExileTopCardOfLibrary])])",
    "Reveal the top three cards of your library. Target opponent chooses one of those cards. Put that card into your graveyard, then draw two cards": "Targeted([TargetPlayer(Opponent)], ActionList([RevealTheTopNumberCardsOfLibrary(Integer(3), [APlayerChoosesAGenericCard(SinglePlayer(Ref_TargetPlayer)), PutTheChosenCardIntoGraveyard, LeaveTheRemainingCardsOnTopOfLibraryInTheSameOrder]), DrawNumberCards(Integer(2))]))",
    "Reveal the top two cards of your library. An opponent chooses one of them. Put that card into your hand and exile the other with {{a}} {{CounterType}} counter on it": "ActionList([RevealTheTopNumberCardsOfLibrary(Integer(2), [APlayerChoosesAGenericCard(Opponent), PutTheChosenCardIntoHand, ExileTheRemainingCardsWithACounterOfType({{CounterType[0]}})])])",
    "Reveal the top {{Number}} cards of your library. An opponent separates those cards into two piles. Put one pile into your hand and the other on the bottom of your library in any order": "ActionList([RevealTheTopNumberCardsOfLibrary({{Number[0]}}, [APlayerSeparatesThoseCardsIntoTwoPiles(Opponent), PutAPileIntoHand, PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder])])",
    "Reveal the top {{Number}} cards of your library. Put all {{SpecificCards}} from among them onto the battlefield and the rest into your hand": "ActionList([RevealTheTopNumberCardsOfLibrary({{Number[0]}}, [PutEachCardOfTypeOntoTheBattlefield({{SpecificCards[0]}}, [EntersNormally]), PutTheRemainingCardsIntoHand])])",
    "Reveal the top {{Number}} cards of your library. Put all {{SpecificCards}} revealed this way into your hand and the rest into your graveyard": "ActionList([RevealTheTopNumberCardsOfLibrary({{Number[0]}}, [PutEachCardOfTypeIntoHand({{SpecificCards[0]}}), PutTheRemainingCardsIntoGraveyard])])",
    "Reveal the top {{Number}} cards of your library. Put all {{SpecificCards}} revealed this way into your hand and the rest on the bottom of your library in any order": "ActionList([RevealTheTopNumberCardsOfLibrary({{Number[0]}}, [PutEachCardOfTypeIntoHand({{SpecificCards[0]}}), PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder])])",
    "Reveal the top {{Number}} cards of your library. Put any number of {{SpecificCards}} from among them into your hand and the rest into your graveyard. Create a Treasure token for each card put into your graveyard this way": "ActionList([RevealTheTopNumberCardsOfLibrary({{Number[0]}}, [MayPutAnyNumberOfCardsOfTypeIntoHand({{SpecificCards[0]}}), PutTheRemainingCardsIntoGraveyard]), CreateTokens([NumberTokens(NumberOfCardsPutIntoGraveyardThisWay, TreasureToken)])])",
    "Reveal the top {{Number}} cards of your library. Put {{a}} {{SpecificCard}} from among them into your hand and the rest on the bottom of your library in a random order. If you didn't put a card into your hand this way, draw a card": "ActionList([RevealTheTopNumberCardsOfLibrary({{Number[0]}}, [PutACardOfTypeIntoHand({{SpecificCard[0]}}), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder]), Unless(ALibraryCardWasPutIntoHandThisWay, [DrawACard])])",
    "Reveal the top {{Number}} cards of your library. You may put {{a}} {{SpecificCard}} and/or {{a}} {{SpecificCard}} from among them into your hand. Put the rest into your graveyard": "ActionList([RevealTheTopNumberCardsOfLibrary({{Number[0]}}, [MayPutMultipleCardsOfTypeIntoHand([{{SpecificCard[0]}}, {{SpecificCard[1]}}]), PutTheRemainingCardsIntoGraveyard])])",
    "Reveal the top {{Number}} cards of your library. You may put {{a}} {{SpecificCard}} from among them into your hand. Put the rest into your graveyard": "ActionList([RevealTheTopNumberCardsOfLibrary({{Number[0]}}, [MayPutACardOfTypeIntoHand({{SpecificCard[0]}}), PutTheRemainingCardsIntoGraveyard])])",
    "Reveal the top {{Number}} cards of your library. You may put {{a}} {{SpecificCard}} from among them onto the battlefield tapped. Put the rest into your graveyard": "ActionList([RevealTheTopNumberCardsOfLibrary({{Number[0]}}, [MayPutACardOfTypeOntoTheBattlefield({{SpecificCard[0]}}, [EntersTapped]), PutTheRemainingCardsIntoGraveyard])])",
    "Reveal your hand and discard a card of target opponent's choice. Then that player reveals their hand and discards a card of your choice": "Targeted([TargetPlayer(Opponent)], ActionList([RevealHand, PlayerAction(Ref_TargetPlayer, ChooseACardFromPlayersRevealedHand(AnyCard, You)), DiscardCard(TheCardChosenThisWay), PlayerAction(Ref_TargetPlayer, RevealHand), ChooseACardFromPlayersRevealedHand(AnyCard, Ref_TargetPlayer), PlayerAction(Ref_TargetPlayer, DiscardCard(TheCardChosenThisWay))]))",
    "Reveal {{a}} {{SpecificCard}} in your hand. Search your library for a card with the same name as that card, reveal it, put it into your hand, then shuffle": "ActionList([RevealACardOfTypeFromHand({{SpecificCard[0]}}), SearchLibrary([FindACardOfType(SharesANameWithTheCardRevealedThisWay), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])",
    "Reverse the game's turn order": "ActionList([ReverseTurnOrder])",
    "Roll X six-sided dice, where X is {{GameNumber}}. Create a tapped Treasure token for each even result. If you rolled 6 exactly seven times, you win the game": "ActionList([RollNumberD6({{GameNumber[0]}}), CreateTokensWithFlags([NumberTokens(TheNumberOfDiceResults(Even), TreasureToken)], [EntersTapped]), If(ANumberDiceValuesAre(EqualTo(Integer(7)), EqualTo(Integer(6))), [WinTheGame])])",
    "Roll a d10. Put target {{Permanent}} into its owner's library just beneath the top X cards of that library, where X is the result": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([RollAD10, PutPermanentInOwnersLibraryBeneathNumberCards(Ref_TargetPermanent, TheDiceResult)]))",
    "Roll a d20 and subtract {{GameNumber}}. If the result is 0 or less, discard your hand.\n{{RawDigits}}-{{RawDigits}} | Return a card at random from your graveyard to your hand.\n{{RawDigits}}-{{RawDigits}} | Draw {{Number}} cards.\n{{RawDigits}} | Put {{a}} {{SpecificCard}} from any graveyard onto the battlefield under your control. When that creature dies, its owner loses the game": "ActionList([RollAD20, ValueActions(Minus(TheDiceResult, {{GameNumber[0]}}), [ValueAction(ValueOrSmaller(0), [DiscardHand]), ValueAction(BetweenValues({{RawDigits[0]}}, {{RawDigits[1]}}), [PutACardFromGraveyardIntoHandAtRandom(InAPlayersGraveyard(SinglePlayer(You)))]), ValueAction(BetweenValues({{RawDigits[2]}}, {{RawDigits[3]}}), [DrawNumberCards({{Number[0]}})]), ValueAction(ExactValue({{RawDigits[4]}}), [PutACardFromAGraveyardOnBattlefield({{SpecificCard[0]}}, AnyPlayer, [EntersUnderPlayersControl(You)]), CreateFutureTrigger(WhenCreatureOrPlaneswalkerDies(ThePermanentPutOnTheBattlefieldThisWay), ActionList([PlayerAction(OwnerOfPermanent(Trigger_ThatCreatureOrPlaneswalker), LoseTheGame)]))])])])",
    "Roll a d20.\n{{RawDigits}} | {{FlavorWord}} - You lose {{Digits}} life.\n{{RawDigits}}-{{RawDigits}} | Create {{Number}} Treasure tokens.\n{{RawDigits}}-{{RawDigits}} | You gain {{Digits}} life and draw {{Number}} cards.\n{{RawDigits}} | Search your library for a card. If it's {{a}} {{SpecificCard}}, you may put it onto the battlefield. Otherwise, put that card into your hand. Then shuffle":
      "ActionList([RollAD20, ValueActions(TheDiceResult, [ValueAction(ExactValue({{RawDigits[0]}}), [LoseLife({{Digits[0]}})]), ValueAction(BetweenValues({{RawDigits[1]}}, {{RawDigits[2]}}), [CreateTokens([NumberTokens({{Number[0]}}, TreasureToken)])]), ValueAction(BetweenValues({{RawDigits[3]}}, {{RawDigits[4]}}), [GainLife({{Digits[1]}}), DrawNumberCards({{Number[1]}})]), ValueAction(ExactValue({{RawDigits[5]}}), [SearchLibrary([FindAGenericCard, If(ACardOfTypeWasFoundThisWay({{SpecificCard[0]}}), [MayPutFoundCardsOntoBattlefield([EntersNormally])]), PutFoundCardsIntoHand, Shuffle])])])])",
    "Roll a d20.\n{{RawDigits}}-{{RawDigits}} | Draw a card.\n{{RawDigits}}-{{RawDigits}} | Look at the top {{Number}} cards of your library. Put one of them into your hand and the rest on the bottom of your library in any order": "ActionList([RollAD20, ValueActions(TheDiceResult, [ValueAction(BetweenValues({{RawDigits[0]}}, {{RawDigits[1]}}), [DrawACard]), ValueAction(BetweenValues({{RawDigits[2]}}, {{RawDigits[3]}}), [LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [PutAGenericCardIntoHand, PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder])])])])",
    "Roll a d20.\n{{RawDigits}}-{{RawDigits}} | Each opponent loses {{Digits}} life.\n{{RawDigits}}-{{RawDigits}} | Each opponent loses {{Digits}} life and you gain {{Digits}} life.\n{{RawDigits}} | Each opponent loses {{Digits}} life and you gain {{Digits}} life. Create {{Number}} Treasure tokens": "ActionList([RollAD20, ValueActions(TheDiceResult, [ValueAction(BetweenValues({{RawDigits[0]}}, {{RawDigits[1]}}), [EachPlayerAction(Opponent, LoseLife({{Digits[0]}}))]), ValueAction(BetweenValues({{RawDigits[2]}}, {{RawDigits[3]}}), [EachPlayerAction(Opponent, LoseLife({{Digits[1]}})), GainLife({{Digits[2]}})]), ValueAction(ExactValue({{RawDigits[4]}}), [EachPlayerAction(Opponent, LoseLife({{Digits[3]}})), GainLife({{Digits[4]}}), CreateTokens([NumberTokens({{Number[0]}}, TreasureToken)])])])])",
    "Roll a d20. Each opponent exiles cards from the top of their library until they exile {{a}} {{SpecificCard}}, then shuffles the rest into their library. You may cast up to X {{PotentialSpells}} from among cards exiled this way without paying their mana costs.\n{{RawDigits}}-{{RawDigits}} | X is {{Number}}.\n{{RawDigits}}-{{RawDigits}} | X is {{Number}}.\n{{RawDigits}} | X is {{Number}}": "ActionList([RollAD20, EachPlayerActions(Opponent, [ExileCardsFromTheTopOfLibraryUntilACardOfTypeIsExiled({{SpecificCard[0]}}), ShuffleEachExiledCardIntoLibrary(TheNonSpecificCardsExiledThisWay)]), ValueActions(TheDiceResult, [ValueAction(BetweenValues({{RawDigits[0]}}, {{RawDigits[1]}}), [MayAction(CastUptoNumberExiledCardsWithoutPaying({{Number[0]}}, TheSpecificCardsExiledThisWay))]), ValueAction(BetweenValues({{RawDigits[2]}}, {{RawDigits[3]}}), [MayAction(CastUptoNumberExiledCardsWithoutPaying({{Number[1]}}, TheSpecificCardsExiledThisWay))]), ValueAction(ExactValue({{RawDigits[4]}}), [MayAction(CastUptoNumberExiledCardsWithoutPaying({{Number[2]}}, TheSpecificCardsExiledThisWay))])])])",
    "Roll a d8. Reveal cards from the top of your library until you reveal {{a}} {{SpecificCard}} with mana value equal to the result. Put that card onto the battlefield and the rest on the bottom of your library in a random order": "ActionList([RollAD8, RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed(And([{{SpecificCard[0]}}, ManaValueIs(EqualTo(TheDiceResult))]), [PutTheCardFoundThisWayOntoTheBattlefield([EntersNormally]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "Roll a six-sided die": "ActionList([RollAD6])",
    "Roll a six-sided die plus an additional six-sided die for each mana from Treasures spent to activate this ability": "ActionList([RollNumberD6(Plus(Integer(1), TheAmountOfManaFromATreasureSpentToActivateThisAbility))])",
    "Roll a six-sided die. You gain life equal to the result": "ActionList([RollAD6, GainLife(TheDiceResult)])",
    "Roll the planar die": "ActionList([RollThePlanarDie])",
    "Sacrifice {{a}} {{Permanent}}. If you do, return target {{SpecificCard}} from your graveyard to the battlefield": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([MustCost(SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersNormally])])]))",
    "Sacrifice {{a}} {{Permanent}}. If you do, search your library for {{a}} {{SpecificCard}}, reveal it, put it into your hand, then shuffle": "ActionList([MustCost(SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])])",
    "Scry {{Digits}}": "ActionList([Scry({{Digits[0]}})])",
    "Scry {{Digits}}, then draw a card": "ActionList([Scry({{Digits[0]}}), DrawACard])",
    "Scry {{Digits}}, then reveal the top card of your library. If it's {{a}} {{SpecificCard}}, put it onto the battlefield tapped. Otherwise, draw a card": "ActionList([Scry({{Digits[0]}}), RevealTopCardOfLibrary, IfElse(ACardWasRevealedThisWay({{SpecificCard[0]}}), [PutTopOfLibraryOnBattlefield([EntersTapped])], [DrawACard])])",
    "Scry {{Digits}}, then you get {{Energy}}": "ActionList([Scry({{Digits[0]}}), GetEnergy(Integer({{Energy[0]}}))])",
    "Scry {{Digits}}, then you may reveal the top card of your library. If {{a}} {{SpecificCard}} is revealed this way, put it onto the battlefield tapped": "ActionList([Scry({{Digits[0]}}), MayCost(RevealTopCardOfLibrary), If(CostWasPaid, [If(ACardWasRevealedThisWay({{SpecificCard[0]}}), [PutTopOfLibraryOnBattlefield([EntersTapped])])])])",
    "Scry {{Digits}}. Each opponent loses {{Digits}} life and you gain {{Digits}} life": "ActionList([Scry({{Digits[0]}}), EachPlayerAction(Opponent, LoseLife({{Digits[0]}})), GainLife({{Digits[1]}})])",
    "Scry {{Digits}}. If {{Condition}}, draw a card": "ActionList([Scry({{Digits[0]}}), If({{Condition[0]}}, [DrawACard])])",
    "Scry {{Digits}}. Target opponent gets a one-time boon with \"{{OneTimeBoonQuotedAbility}}\"": "Targeted([TargetPlayer(Opponent)], ActionList([Scry({{Digits[0]}}), PlayerAction(Ref_TargetPlayer, GetOneTimeBoon({{OneTimeBoonQuotedAbility[0]}}))]))",
    "Scry {{Digits}}. You may tap {{a}} {{Permanent}}. If you do, draw a card": "ActionList([Scry({{Digits[0]}}), MayCost(TapAPermanent({{Permanent[0]}})), If(CostWasPaid, [DrawACard])])",
    "Search target opponent's library for a card and exile it. Then that player shuffles. Until the beginning of your next upkeep, you may play that card. At the beginning of your next upkeep, if you haven't played it, put it into its owner's graveyard": "Targeted([TargetPlayer(Opponent)], ActionList([SearchPlayersLibrary(Ref_TargetPlayer, [FindAGenericCard, ExileFoundCards, Shuffle]), CreatePlayerEffectUntil(You, [MayPlayExiledCard(TheCardExiledThisWay)], UntilNextUpkeep(You)), CreateFutureTriggerI(AtTheBeginningOfPlayersNextUpkeep(You), TheCardExiledThisWayIsStillExiled, ActionList([PutExiledCardIntoOwnersGraveyard(TheCardExiledThisWay)]))]))",
    "Search target player's library for up to {{Number}} cards and exile them. Then that player shuffles": "Targeted([TargetPlayer(AnyPlayer)], ActionList([SearchPlayersLibrary(Ref_TargetPlayer, [FindUptoNumberGenericCards({{Number[0]}}), ExileFoundCards, Shuffle])]))",
    "Search target player's library for {{Number}} cards and exile them. Then that player shuffles": "Targeted([TargetPlayer(AnyPlayer)], ActionList([SearchPlayersLibrary(Ref_TargetPlayer, [FindNumberGenericCards({{Number[0]}}), ExileFoundCards, Shuffle])]))",
    "Search your graveyard and library for any number of {{SpecificCards}}, exile them, then shuffle. You may cast them this turn. Add {{Number}} {{ManaProduceSymbol}}":
      "ActionList([SearchLibraryAndGraveyard([FindAnyNumberOfCardsOfType({{SpecificCards[0]}}), ExileFoundCards, Shuffle]), CreatePlayerEffectUntil(You, [MayCastSpellsFromAmongExiled(AnySpell, TheCardsExiledThisWay)], UntilEndOfTurn), AddManaRepeated({{ManaProduceSymbol[0]}}, {{Number[0]}})])",
    "Search your graveyard and/or library for {{a}} {{SpecificCard}} and put it onto the battlefield attached to target {{Permanent}}. If you search your library this way, shuffle": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([SearchLibraryAndOrGraveyard([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersAttachedToPermanent(Ref_TargetPermanent)]), ShuffleLibraryIfSearched])]))",
    "Search your graveyard, hand, and/or library for {{a}} {{SpecificCard}} and put it onto the battlefield. If you search your library this way, shuffle": "ActionList([SearchLibraryAndOrGraveyard([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersNormally]), ShuffleLibraryIfSearched])])",
    "Search your library and/or graveyard for {{a}} {{SpecificCard}} and put it onto the battlefield. If you search your library this way, shuffle": "ActionList([SearchLibraryAndOrGraveyard([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersNormally]), ShuffleLibraryIfSearched])])",
    "Search your library and/or graveyard for {{a}} {{SpecificCard}}, reveal it, and put it into your hand. If you search your library this way, shuffle": "ActionList([SearchLibraryAndOrGraveyard([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsIntoHand, ShuffleLibraryIfSearched])])",
    "Search your library for a card, put it into your hand, then shuffle": "ActionList([SearchLibrary([FindAGenericCard, PutFoundCardsIntoHand, Shuffle])])",
    "Search your library for a card, put that card into your hand, then shuffle": "ActionList([SearchLibrary([FindAGenericCard, PutFoundCardsIntoHand, Shuffle])])",
    "Search your library for a card, then shuffle and put that card on top": "ActionList([SearchLibrary([FindAGenericCard, SetAsideFoundCards, Shuffle, PutSetAsideCardsOnTopOfLibrary])])",
    "Search your library for an instant or sorcery card that shares a color with this planeswalker, exile that card, then shuffle. You may cast that card without paying its mana cost": "ActionList([SearchLibrary([FindACardOfType(And([Or([IsCardtype(Instant), IsCardtype(Sorcery)]), SharesAColorWithPermanent(ThisPermanent)])), ExileFoundCards, Shuffle]), MayAction(CastSpellFromExileWithoutPaying(AnySpell, TheCardExiledThisWay))])",
    "Search your library for any number of {{LandCards}}, put them onto the battlefield, then shuffle. Those lands become {{PT}} {{Zombie}} creatures with {{Hasable}}. They're still lands": "ActionList([SearchLibrary([FindAnyNumberOfCardsOfType({{LandCards[0]}}), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle]), CreateEachPermanentLayerEffect(ThePermanentsPutOnTheBattlefieldThisWay, [SetPT({{PT[0]}}), SetCreatureType({{Zombie[0]}}), AddCardtype(Creature), AddAbility([{{Hasable[0]}}])])])",
    "Search your library for any number of {{SpecificCards}}, exile them, then create that many {{PT}} {{CreatureTokens}}. Then shuffle": "ActionList([SearchLibrary([FindAnyNumberOfCardsOfType({{SpecificCards[0]}}), ExileFoundCards, CreateTokens([NumberTokens(TheNumberOfLibraryCardsExiledThisWay, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))]), Shuffle])])",
    "Search your library for any number of {{SpecificCards}}, exile them, then shuffle. Until end of turn, you may cast those cards without paying their mana costs": "ActionList([SearchLibrary([FindAnyNumberOfCardsOfType({{SpecificCards[0]}}), ExileFoundCards, Shuffle]), CreatePlayerEffectUntil(You, [MayPlayExiledCardsWithoutPaying(TheCardsExiledThisWay)], UntilEndOfTurn)])",
    "Search your library for any number of {{SpecificCards}}, put them onto the battlefield, then shuffle": "ActionList([SearchLibrary([FindAnyNumberOfCardsOfType({{SpecificCards[0]}}), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle])])",
    "Search your library for up to X {{SpecificCards}}, where X is {{GameNumber}}. Put those cards onto the battlefield tapped, then shuffle": "ActionList([SearchLibrary([FindNumberCardsOfType({{GameNumber[0]}}, {{SpecificCards[0]}}), PutFoundCardsOntoBattlefield([EntersTapped]), Shuffle])])",
    "Search your library for up to X {{SpecificCards}}, where X is {{GameNumber}}. Put those cards onto the battlefield, then shuffle": "ActionList([SearchLibrary([FindNumberCardsOfType({{GameNumber[0]}}, {{SpecificCards[0]}}), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle])])",
    "Search your library for up to {{Number}} {{SpecificCards}} and/or {{SpecificCards}}, reveal those cards, put one onto the battlefield tapped and the other into your hand, then shuffle": "ActionList([SearchLibrary([FindNumberCardsOfType({{Number[0]}}, Or([{{SpecificCards[0]}}, {{SpecificCards[1]}}])), RevealFoundCards, PutAFoundCardOntoBattlefield([EntersTapped]), PutFoundCardsIntoHand, Shuffle])])",
    "Search your library for up to {{Number}} {{SpecificCards}} that share a land type, put them onto the battlefield tapped, then shuffle": "ActionList([SearchLibrary([FindNumberGroupCards({{Number[0]}}, {{SpecificCards[0]}}, ShareALandType), PutFoundCardsOntoBattlefield([EntersTapped]), Shuffle])])",
    "Search your library for up to {{Number}} {{SpecificCards}} with different names, put them onto the battlefield, then shuffle": "ActionList([SearchLibrary([FindNumberGroupCards({{Number[0]}}, {{SpecificCards[0]}}, DifferentNames), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle])])",
    "Search your library for up to {{Number}} {{SpecificCards}}, put them onto the battlefield tapped, then shuffle": "ActionList([SearchLibrary([FindNumberCardsOfType({{Number[0]}}, {{SpecificCards[0]}}), PutFoundCardsOntoBattlefield([EntersTapped]), Shuffle])])",
    "Search your library for up to {{Number}} {{SpecificCards}}, put them onto the battlefield, then shuffle": "ActionList([SearchLibrary([FindNumberCardsOfType({{Number[0]}}, {{SpecificCards[0]}}), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle])])",
    "Search your library for up to {{Number}} {{SpecificCards}}, reveal them, put them into your hand, then shuffle": "ActionList([SearchLibrary([FindNumberCardsOfType({{Number[0]}}, {{SpecificCards[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}} and cast that card without paying its mana cost. Then shuffle":
      "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), CastFoundCardsWithoutPaying, Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}} and reveal it. If {{Condition}}, you may put that card onto the battlefield tapped. If you don't put the card onto the battlefield, put it into your hand. Then shuffle":
      "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, If({{Condition[0]}}, [MayPutFoundCardsOntoBattlefield([EntersTapped])]), PutFoundCardsIntoHand, Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}} and reveal that card. Put it into your hand, then discard a card at random. Then shuffle": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsIntoHand, DiscardACardAtRandom, Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}} and {{a}} {{SpecificCard}}, put them onto the battlefield tapped, then shuffle": "ActionList([SearchLibrary([FindCardsOfType([{{SpecificCard[0]}}, {{SpecificCard[1]}}]), PutFoundCardsOntoBattlefield([EntersTapped]), Shuffle])])",
