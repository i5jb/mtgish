    "{{ManaCost}}, {{DiscardACardCost}}: {{ActivatedActions(~GraveyardCard)}}. {{ActivateModifiers}}": "FromGraveyard(ActivatedWithModifiers(And([PayMana({{ManaCost[0]}}), {{DiscardACardCost[0]}}]), {{ActivatedActions(~GraveyardCard=^~GraveyardCard)[0]}}, {{ActivateModifiers[0]}}))",
    "{{ManaCost}}, {{DiscardCardsCost}}: {{ActivatedActions(~GraveyardCard)}}": "FromGraveyard(Activated(And([PayMana({{ManaCost[0]}}), {{DiscardCardsCost[0]}}]), {{ActivatedActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "{{ManaCost}}, {{ExileGraveyardCost}}: {{ActivatedActions(~GraveyardCard)}}": "FromGraveyard(Activated(And([PayMana({{ManaCost[0]}}), {{ExileGraveyardCost[0]}}]), {{ActivatedActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "{{ManaCost}}, {{ExileOtherGraveyardCost(~GraveyardCard)}}: {{ActivatedActions(~GraveyardCard)}}": "FromGraveyard(Activated(And([PayMana({{ManaCost[0]}}), {{ExileOtherGraveyardCost(~GraveyardCard=^~GraveyardCard)[0]}}]), {{ActivatedActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "{{ManaCost}}, {{ExileSelfGraveyardCost}}: It deals {{Digits}} damage to target player or planeswalker and {{Digits}} damage to up to one target creature that player or that planeswalker's controller controls": "FromGraveyard(Activated(And([PayMana({{ManaCost[0]}}), {{ExileSelfGraveyardCost[0]}}]), Targeted([TargetPlayerOrPermanent(AnyPlayer, IsCardtype(Planeswalker)), UptoOneTargetPermanent(And([IsCardtype(Creature), ControlledByPlayer(PlayerOrControllerOfPermanent(Ref_TargetPlayerOrPermanent))]))], ActionList([GraveyardCardDealsMultipleDamage(ThisGraveyardCard, [DamageToRecipients({{Digits[0]}}, Ref_TargetPlayerOrPermanent), DamageToRecipients({{Digits[1]}}, Permanent(Ref_TargetPermanent))])]))))",
    "{{ManaCost}}, {{ExileSelfGraveyardCost}}: {{ActivatedActions(ThatGraveyardCard)}}": "FromGraveyard(Activated(And([PayMana({{ManaCost[0]}}), {{ExileSelfGraveyardCost[0]}}]), {{ActivatedActions(ThatGraveyardCard=^~GraveyardCard)[0]}}))",
