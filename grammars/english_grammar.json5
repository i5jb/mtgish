    "Put X {{CounterType}} counters on target {{Creature}}, where X is {{Number}} plus {{GameNumber}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([PutNumberCountersOfTypeOnPermanent(Plus({{Number[0]}}, {{GameNumber[0]}}), {{CounterType[0]}}, Ref_TargetPermanent)]))",
    "Put target {{SpecificCard}} from a graveyard onto the battlefield under your control": "Targeted([TargetGraveyardCard({{SpecificCard[0]}})], ActionList([PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersUnderPlayersControl(You)])]))",
