{
  "{{AbilitySources}}": {
    "artifact sources": "IsCardtype(Artifact)",
    "land sources": "IsCardtype(Land)",
    "outlaw sources": "IsAnOutlaw",
    "{{Black}} sources": "IsColor({{Black[0]}})",
    "{{NonBlack}} sources": "IsNonColor({{NonBlack[0]}})"
  },
  "{{AbilitySource}}": {
    "artifact or enchantment source": "Or([IsCardtype(Artifact), IsCardtype(Enchantment)])",
    "artifact source": "IsCardtype(Artifact)",
    "creature source": "IsCardtype(Creature)",
    "colorless source": "IsColorless",
    "enchantment source": "IsCardtype(Enchantment)",
    "{{Zombie}} source": "IsCreatureType({{Zombie[0]}})"
  },
  "{{Ability}}": {
    "activated ability": "ActivatedAbility",
    "activated or triggered ability": "Or([ActivatedAbility, TriggeredAbility])",
    "activated or triggered ability from a noncreature source": "And([Or([ActivatedAbility, TriggeredAbility]), AbilityOfASource(IsNonCardtype(Creature))])",
    "activated or triggered ability you don't control": "And([Or([ActivatedAbility, TriggeredAbility]), ControlledByAPlayer(Other(You))])"
  },
  "{{ActivateModifiers(~Exiled)}}": {
    "Activate only if this card is suspended": "ActivateOnlyIf(ExiledCardPassesFilter({{~Exiled}}, IsSuspended))"
  },
  "{{ActivateModifiers(~GraveyardCard)}}": {
    "Activate only during your upkeep and only if {{Number}} or more creature cards are above this card": "And([ActivateOnlyIf(PlayerPassesFilter(You, IsTheirUpkeep)), ActivateOnlyIf(CardIsInPlayersGraveyardWithANumberOfCardsAboveIt({{~GraveyardCard}}, You, GreaterThanOrEqualTo({{Number[0]}}), IsCardtype(Creature)))])",
    "Activate only if this card is in your graveyard": "ActivateOnlyIf(CardIsInPlayersGraveyard({{~GraveyardCard}}, You))",
    "Activate only if {{~GraveyardCard}} is in your graveyard and its toughness is {{Digits}} or greater": "ActivateOnlyIf(And([CardIsInPlayersGraveyard({{~GraveyardCard}}, You), GraveyardCardPassesFilter({{~GraveyardCard}}, ToughnessIs(GreaterThanOrEqualTo({{Digits[0]}})))]))"
  },
  "{{ActivateModifiers(~Permanent)}}": {
    "Activate only during the declare blockers step, only if at least one creature is blocking this creature, and only once each turn": "And([ActivateOnlyIf(IsDuringDeclareBlockersStep), ActivateOnlyIf(APermanentPassesFilter(IsCardtype(Creature), IsBlockingAttacker({{~Permanent}}))), ActivateOnlyOnceEachTurn])",
    "Activate only during your upkeep and only if {{~Permanent}} isn't enchanted": "And([ActivateOnlyIf(And([IsPlayersTurn(You), IsDuringUpkeep])), ActivateOnlyIf(PermanentPassesFilter({{~Permanent}}, IsntEnchanted))])",
    "Activate only if it has no {{CounterType}} counters on it and only as a sorcery": "And([ActivateOnlyIf(PermanentPassesFilter({{~Permanent}}, HasNoCountersOfType({{CounterType[0]}}))), ActivateOnlyAsASorcery])",
    "Activate only if the number of other {{Swamps}} you control plus the number of {{Swamp}} cards in your graveyard is {{Number}} or greater": "ActivateOnlyIf(ValueIs(Plus(TheNumberOfPermanentsOnTheBattlefield(And([Other({{~Permanent}}), IsLandType({{Swamps[0]}}), ControlledByAPlayer(SinglePlayer(You))])), TheNumberOfGraveyardCards(And([IsLandType({{Swamp[0]}}), InAPlayersGraveyard(SinglePlayer(You))]))), GreaterThanOrEqualTo({{Number[0]}})))",
    "Activate only if there are no {{CounterType}} counters on this artifact": "ActivateOnlyIf(PermanentPassesFilter({{~Permanent}}, HasNumCountersOfType(EqualTo(Integer(0)), {{CounterType[0]}})))",
    "Activate only if there are {{Number}} colors among permanents you control": "ActivateOnlyIf(PlayerPassesFilter(You, ControlsNumColorsOfPermanents(EqualTo({{Number[0]}}))))",
    "Activate only if there are {{Number}} or more {{CounterType}} counters on this artifact": "ActivateOnlyIf(PermanentPassesFilter({{~Permanent}}, HasNumCountersOfType(GreaterThanOrEqualTo({{Number[0]}}), {{CounterType[0]}})))",
    "Activate only if there is {{a}} {{Zombie}} card in your graveyard": "ActivateOnlyIf(PlayerPassesFilter(You, HasACardInGraveyard(IsCreatureType({{Zombie[0]}}))))",
    "Activate only if you control another {{Permanent}}": "ActivateOnlyIf(PlayerPassesFilter(You, ControlsA(And([Other({{~Permanent}}), {{Permanent[0]}}]))))",
    "Activate only if you've controlled {{ThisPermanent}} continuously since the beginning of your most recent turn": "ActivateOnlyIf(PermanentPassesFilter({{~Permanent}}, ControlledSinceBeginningOfMostRecentTurn))",
    "Activate only if {{ThisPermanent}} blocked or was blocked by {{a}} {{Creature}} this turn": "ActivateOnlyIf(PermanentPassesFilter({{~Permanent}}, Or([WasBlockedByADefenderThisTurn({{Creature[0]}}), BlockedAnAttackerThisTurn({{Creature[0]}})])))",
    "Activate only if {{ThisPermanent}} doesn't have {{CheckHasable}}": "ActivateOnlyIf(PermanentPassesFilter({{~Permanent}}, DoesntHaveAbility({{CheckHasable[0]}})))",
    "Activate only if {{ThisPermanent}} entered this turn or if you control a basic land": "ActivateOnlyIf(Or([PermanentPassesFilter({{~Permanent}}, EnteredTheBattlefieldThisTurn), PlayerPassesFilter(You, ControlsA(And([IsSupertype(Basic), IsCardtype(Land)])))]))",
    "Activate only if {{ThisPermanent}} entered this turn": "ActivateOnlyIf(PermanentPassesFilter({{~Permanent}}, EnteredTheBattlefieldThisTurn))",
    "Activate only if {{ThisPermanent}} has {{Number}} or more {{CounterType}} counters on it": "ActivateOnlyIf(PermanentPassesFilter({{~Permanent}}, HasNumCountersOfType(GreaterThanOrEqualTo({{Number[0]}}), {{CounterType[0]}})))",
    "Activate only if {{ThisPermanent}} has {{a}} {{CounterType}} counter on it": "ActivateOnlyIf(PermanentPassesFilter({{~Permanent}}, HasACounterOfType({{CounterType[0]}})))",
    "Activate only if {{ThisPermanent}} is a creature": "ActivateOnlyIf(PermanentPassesFilter({{~Permanent}}, IsCardtype(Creature)))",
    "Activate only if {{ThisPermanent}} is attacking": "ActivateOnlyIf(PermanentPassesFilter({{~Permanent}}, IsAttacking))",
    "Activate only if {{ThisPermanent}} is attacking or blocking and only once each turn": "And([ActivateOnlyIf(PermanentPassesFilter({{~Permanent}}, Or([IsAttacking, IsBlocking]))), ActivateOnlyOnceEachTurn])",
    "Activate only if {{ThisPermanent}} is blocked": "ActivateOnlyIf(PermanentPassesFilter({{~Permanent}}, IsBlocked))",
    "Activate only if {{ThisPermanent}} is {{Black}} and only once": "And([ActivateOnlyIf(PermanentPassesFilter({{~Permanent}}, IsColor({{Black[0]}}))), ActivateOnlyOnce])",
    "Activate only if {{ThisPermanent}} or another {{Permanent}} entered the battlefield under your control this turn": "ActivateOnlyIf(APermanentEnteredTheBattlefieldUnderAPlayersControlThisTurn(Or([SinglePermanent({{~Permanent}}), And([Other({{~Permanent}}), {{Permanent[0]}}])]), SinglePlayer(You)))",
    "Activate only if {{ThisPermanent}}'s power is {{Digits}} or greater": "ActivateOnlyIf(PermanentPassesFilter({{~Permanent}}, PowerIs(GreaterThanOrEqualTo({{Digits[0]}}))))",
    "Activate only if {{a}} {{Permanent}} entered the battlefield under your control this turn": "ActivateOnlyIf(APermanentEnteredTheBattlefieldUnderAPlayersControlThisTurn({{Permanent[0]}}, SinglePlayer(You)))",
    "Activate only if {{~Permanent}} is attacking": "ActivateOnlyIf(PermanentPassesFilter({{~Permanent}}, IsAttacking))",
    "Activate only if {{~Permanent}} isn't {{a}} {{Zombie}}": "ActivateOnlyIf(PermanentPassesFilter({{~Permanent}}, IsCreatureType({{Zombie[0]}})))",
    "Activate only if {{~Permanent}}'s power is {{Digits}} or greater": "ActivateOnlyIf(PermanentPassesFilter({{~Permanent}}, PowerIs(GreaterThanOrEqualTo({{Digits[0]}}))))",
    "Activate only once each turn and only if this permanent is a creature": "And([ActivateOnlyOnceEachTurn, ActivateOnlyIf(PermanentPassesFilter({{~Permanent}}, IsCardtype(Creature)))])",
    "Only the player this creature is attacking may activate this ability and only during the declare attackers step": "And([OnlyPlayerMayActivate(PlayerCreatureIsAttacking({{~Permanent}})), ActivateOnlyIf(IsDuringDeclareAttackersStep)])",
    "Only this creature's owner may activate this ability": "OnlyPlayerMayActivate(OwnerOfPermanent({{~Permanent}}))",
    "This ability costs {{CostReduce}} less to activate for each {{Eachable(ThatPermanent)}}": "ReduceCostForEach({{CostReduce[0]}}, {{Eachable(ThatPermanent=^~Permanent)[0]}})",
    "This ability costs {{CostReduce}} less to activate for each {{Eachable(~Permanent)}}": "ReduceCostForEach({{CostReduce[0]}}, {{Eachable(~Permanent=^~Permanent)[0]}})",
    "This ability costs {{CostReduce}} less to activate for each {{Eachable(~Permanent)}}. Activate only as a sorcery": "And([ReduceCostForEach({{CostReduce[0]}}, {{Eachable(~Permanent=^~Permanent)[0]}}), ActivateOnlyAsASorcery])"
  },
  "{{ActivateModifiersX(~Permanent)}}": {
    "X is {{GameNumber(~Permanent)}}": "XIs({{GameNumber(~Permanent=^~Permanent)[0]}})"
  },
  "{{ActivateModifiersX}}": {
    "Spend only {{Black}} mana on X": "SpendOnlyColoredManaOnX({{Black[0]}})",
    "X can't be 0": "XCantBeZero",
    "X can't be greater than {{GameNumber}}": "XCantBeGreaterThan({{GameNumber[0]}})",
    "X is the number of cards in an opponent's hand": "XIs(ANumberOfCardsInAPlayersHand(Opponent))"
  },
  "{{ActivateModifiers[EnchantedPermanent]}}": {
    "Activate only if {{EnchantedPermanent}} is untapped": "ActivateOnlyIf(PermanentPassesFilter(HostPermanent, IsUntapped))",
    "Activate only if {{EnchantedPermanent}} is {{Black}} and untapped and only once each turn": "And([ActivateOnlyIf(PermanentPassesFilter(HostPermanent, And([IsColor({{Black[0]}}), IsUntapped]))), ActivateOnlyOnceEachTurn])",
    "Only the controller of the {{EnchantedPermanent}} may activate this ability": "OnlyPlayerMayActivate(ControllerOfPermanent(HostPermanent))"
  },
  "{{ActivateModifiers[HandActivated]}}": {
    "Activate only as a sorcery": "ActivateOnlyAsASorcery",
    "Activate only during your turn": "ActivateOnlyIf(PlayerPassesFilter(You, IsTheirTurn))",
    "This ability costs {{CostReduce}} less to activate for each {{Eachable}}": "ReduceCostForEach({{CostReduce[0]}}, {{Eachable[0]}})"
  },
  "{{ActivateModifiers}}": {
    "Activate no more than twice each turn": "ActivateNoMoreThanNumberTimesEachTurn(Integer(2))",
    "Activate no more than {{Number}} times each turn": "ActivateNoMoreThanNumberTimesEachTurn({{Number[0]}})",
    "Activate no more times each turn than {{GameNumber}}": "ActivateNoMoreThanNumberTimesEachTurn({{GameNumber[0]}})",
    "Activate only as a sorcery": "ActivateOnlyAsASorcery",
    "Activate only as a sorcery and only if an opponent has {{Number}} or more cards in their graveyard": "And([ActivateOnlyAsASorcery, ActivateOnlyIf(APlayerPassesFilter(Opponent, NumCardsInGraveyardIs(GreaterThanOrEqualTo({{Number[0]}}), AnyCard)))])",
    "Activate only as a sorcery and only if there are {{Number}} or more cards in your graveyard": "And([ActivateOnlyAsASorcery, ActivateOnlyIf(PlayerPassesFilter(You, NumCardsInGraveyardIs(GreaterThanOrEqualTo({{Number[0]}}), AnyCard)))])",
    "Activate only as a sorcery and only if there are {{Number}} or more {{SpecificCards}} in your graveyard": "And([ActivateOnlyAsASorcery, ActivateOnlyIf(PlayerPassesFilter(You, NumCardsInGraveyardIs(GreaterThanOrEqualTo({{Number[0]}}), {{SpecificCards[0]}})))])",
    "Activate only as a sorcery and only if you have one or fewer cards in hand": "And([ActivateOnlyAsASorcery, ActivateOnlyIf(PlayerPassesFilter(You, NumCardsInHandIs(LessThanOrEqualTo(Integer(1)))))])",
    "Activate only as a sorcery and only if you have {{Number}} or more cards in hand": "And([ActivateOnlyAsASorcery, ActivateOnlyIf(PlayerPassesFilter(You, NumCardsInHandIs(GreaterThanOrEqualTo({{Number[0]}}))))])",
    "Activate only as a sorcery and only if you've cast an instant or sorcery spell this turn": "And([ActivateOnlyAsASorcery, ActivateOnlyIf(PlayerPassesFilter(You, CastASpellThisTurn(Or([IsCardtype(Instant), IsCardtype(Sorcery)]))))])",
    "Activate only as a sorcery and only if you've cast {{Number}} or more instant and/or sorcery spells this turn": "And([ActivateOnlyAsASorcery, ActivateOnlyIf(APlayerPassesFilter(Opponent, CastNumSpellsThisTurn(GreaterThanOrEqualTo({{Number[0]}}), Or([IsCardtype(Instant), IsCardtype(Sorcery)]))))])",
    "Activate only as a sorcery and only once": "And([ActivateOnlyAsASorcery, ActivateOnlyOnce])",
    "Activate only as a sorcery and only once each turn": "And([ActivateOnlyAsASorcery, ActivateOnlyOnceEachTurn])",
    "Activate only as an instant": "ActivateOnlyAsAnInstant",
    "Activate only before attackers are declared": "ActivateOnlyIf(IsBeforeAttackersDeclared)",
    "Activate only before blockers are declared": "ActivateOnlyIf(IsBeforeBlockersDeclared)",
    "Activate only before the combat damage step": "ActivateOnlyIf(IsBeforeCombatDamageStep)",
    "Activate only before the end of combat step": "ActivateOnlyIf(IsBeforeEndOfCombatStep)",
    "Activate only during an opponent's turn": "ActivateOnlyIf(IsAPlayersTurn(Opponent))",
    "Activate only during an opponent's turn and only before combat": "And([ActivateOnlyIf(IsAPlayersTurn(Opponent)), ActivateOnlyIf(IsBeforeCombat)])",
    "Activate only during an opponent's turn, before attackers are declared": "And([ActivateOnlyIf(IsAPlayersTurn(Opponent)), ActivateOnlyIf(IsBeforeAttackersDeclared)])",
    "Activate only during an opponent's upkeep": "ActivateOnlyIf(And([IsDuringUpkeep, IsAPlayersTurn(Opponent)]))",
    "Activate only during any upkeep step": "ActivateOnlyIf(IsDuringUpkeep)",
    "Activate only during combat": "ActivateOnlyIf(IsDuringCombat)",
    "Activate only during combat after blockers are declared": "ActivateOnlyIf(And([IsDuringCombat, IsAfterBlockersAreDeclared]))",
    "Activate only during combat and only if defending player controls a snow land": "ActivateOnlyIf(And([IsDuringCombat, PlayerPassesFilter(DefendingPlayer, ControlsA(And([IsSupertype(Snow), IsCardtype(Land)])))]))",
    "Activate only during combat and only if defending player controls no {{Permanents}}": "ActivateOnlyIf(And([IsDuringCombat, PlayerPassesFilter(DefendingPlayer, ControlsNo({{Permanents[0]}}))]))",
    "Activate only during the declare attackers step and only if you're attacking two or more opponents": "And([ActivateOnlyIf(IsDuringDeclareAttackersStep), ActivateOnlyIf(PlayerPassesFilter(You, IsAttackingNumberPlayers(GreaterThanOrEqualTo(Integer(2)), Opponent)))])",
    "Activate only during the declare attackers step and only if you've been attacked this step": "And([ActivateOnlyIf(IsDuringDeclareAttackersStep), ActivateOnlyIf(PlayerPassesFilter(You, IsAttacked))])",
    "Activate only during the declare blockers step": "ActivateOnlyIf(IsDuringDeclareBlockersStep)",
    "Activate only during the end of combat step": "ActivateOnlyIf(IsDuringEndOfCombatStep)",
    "Activate only during your turn": "ActivateOnlyIf(PlayerPassesFilter(You, IsTheirTurn))",
    "Activate only during your turn and only if a card left your graveyard this turn": "And([ActivateOnlyIf(PlayerPassesFilter(You, IsTheirTurn)), ActivateOnlyIf(ACardLeftPlayersGraveyardThisTurn(AnyCard, You))])",
    "Activate only during your turn and only if an opponent lost life this turn": "And([ActivateOnlyIf(PlayerPassesFilter(You, IsTheirTurn)), ActivateOnlyIf(APlayerPassesFilter(Opponent, LostLifeThisTurn))])",
    "Activate only during your turn and only if there are at least {{Number}} {{SpecificCards}} in your graveyard": "And([ActivateOnlyIf(IsPlayersTurn(You)), ActivateOnlyIf(PlayerPassesFilter(You, NumCardsInGraveyardIs(GreaterThanOrEqualTo({{Number[0]}}), {{SpecificCards[0]}})))])",
    "Activate only during your turn and only once": "And([ActivateOnlyIf(PlayerPassesFilter(You, IsTheirTurn)), ActivateOnlyOnce])",
    "Activate only during your turn and only once each turn": "And([ActivateOnlyIf(PlayerPassesFilter(You, IsTheirTurn)), ActivateOnlyOnceEachTurn])",
    "Activate only during your turn, before attackers are declared": "ActivateOnlyIf(And([PlayerPassesFilter(You, IsTheirTurn), IsBeforeAttackersDeclared]))",
    "Activate only during your upkeep": "ActivateOnlyIf(PlayerPassesFilter(You, IsTheirUpkeep))",
    "Activate only during your upkeep and only if you control {{Number}} or more {{Permanents}}": "And([ActivateOnlyIf(PlayerPassesFilter(You, IsTheirUpkeep)), ActivateOnlyIf(PlayerPassesFilter(You, ControlsNum(GreaterThanOrEqualTo({{Number[0]}}), {{Permanents[0]}})))])",
    "Activate only during your upkeep and only if you control {{a}} {{Permanent}}": "ActivateOnlyIf(PlayerPassesFilter(You, And([IsTheirUpkeep, ControlsA({{Permanent[0]}})])))",
    "Activate only during your upkeep and only once each turn": "And([ActivateOnlyIf(PlayerPassesFilter(You, IsTheirUpkeep)), ActivateOnlyOnceEachTurn])",
    "Activate only if a creature died this turn": "ActivateOnlyIf(ACreatureOrPlaneswalkerDiedThisTurn(IsCardtype(Creature)))",
    "Activate only if a non-{{Zombie}} creature died under your control this turn": "ActivateOnlyIf(ACreatureOrPlaneswalkerDiedThisTurn(And([IsNonCreatureType({{Zombie[0]}}), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))])))",
    "Activate only if a player has {{Number}} or fewer cards in hand and only as a sorcery": "And([ActivateOnlyIf(APlayerPassesFilter(AnyPlayer, NumCardsInHandIs(LessThanOrEqualTo({{Number[0]}})))), ActivateOnlyAsASorcery])",
    "Activate only if an opponent controls at least {{Number}} more lands than you": "ActivateOnlyIf(APlayerPassesFilter(Opponent, ControlsNum(GreaterThanOrEqualTo(Plus(TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You))])), {{Number[0]}})), IsCardtype(Land))))",
    "Activate only if an opponent controls more {{Permanents}} than you": "ActivateOnlyIf(APlayerPassesFilter(Opponent, ControlsMorePermanentThanPlayer(You, {{Permanents[0]}})))",
    "Activate only if an opponent controls {{Number}} or more {{Permanents}}": "ActivateOnlyIf(APlayerPassesFilter(Opponent, ControlsNum(GreaterThanOrEqualTo({{Number[0]}}), {{Permanents[0]}})))",
    "Activate only if an opponent has {{Number}} or more cards in their graveyard": "ActivateOnlyIf(APlayerPassesFilter(Opponent, NumCardsInGraveyardIs(GreaterThanOrEqualTo({{Number[0]}}), AnyCard)))",
    "Activate only if an opponent has {{Number}} or more poison counters": "ActivateOnlyIf(APlayerPassesFilter(Opponent, HasANumberOfPoisonCounters(GreaterThanOrEqualTo({{Number[0]}}))))",
    "Activate only if an opponent has {{Number}} or more poison counters and only once each turn": "And([ActivateOnlyIf(APlayerPassesFilter(Opponent, HasANumberOfPoisonCounters(GreaterThanOrEqualTo({{Number[0]}})))), ActivateOnlyOnceEachTurn])",
    "Activate only if an opponent lost life this turn": "ActivateOnlyIf(APlayerPassesFilter(Opponent, LostLifeThisTurn))",
    "Activate only if an opponent lost life this turn and only once each turn": "And([ActivateOnlyIf(APlayerPassesFilter(Opponent, LostLifeThisTurn)), ActivateOnlyOnceEachTurn])",
    "Activate only if an opponent was dealt combat damage by a legendary creature this turn": "ActivateOnlyIf(APlayerPassesFilter(Opponent, WasDealtCombatDamageByAPermanentThisTurn(And([IsSupertype(Legendary), IsCardtype(Creature)]))))",
    "Activate only if an opponent was dealt damage this turn": "ActivateOnlyIf(APlayerPassesFilter(Opponent, WasDealtDamageThisTurn))",
    "Activate only if it's not your turn": "ActivateOnlyIf(IsAPlayersTurn(Other(You)))",
    "Activate only if there are {{Number}} or more card types among cards in your graveyard": "ActivateOnlyIf(ThereAreNumberCardTypesInPlayersGraveyard(GreaterThanOrEqualTo({{Number[0]}}), You))",
    "Activate only if there are {{Number}} or more card types among cards in your graveyard and only as a sorcery": "ActivateOnlyIf(ThereAreNumberCardTypesInPlayersGraveyard(GreaterThanOrEqualTo({{Number[0]}}), You))",
    "Activate only if there are {{Number}} or more cards in your graveyard": "ActivateOnlyIf(PlayerPassesFilter(You, NumCardsInGraveyardIs(GreaterThanOrEqualTo({{Number[0]}}), AnyCard)))",
    "Activate only if there are {{Number}} or more cards in your graveyard and only once": "And([ActivateOnlyIf(PlayerPassesFilter(You, NumCardsInGraveyardIs(GreaterThanOrEqualTo({{Number[0]}}), AnyCard))), ActivateOnlyOnce])",
    "Activate only if there are {{Number}} or more lands with different names among the basic, {{Swamp}}, and {{Swamp}} lands you control": "ActivateOnlyIf(PlayerPassesFilter(You, ControlsNumWithDifferentNames(GreaterThanOrEqualTo({{Number[0]}}), And([Or([IsSupertype(Basic), IsLandType({{Swamp[0]}}), IsLandType({{Swamp[1]}})]), ControlledByAPlayer(SinglePlayer(You))]))))",
    "Activate only if there are {{Number}} or more permanent types among cards in your graveyard": "ActivateOnlyIf(ThereAreANumberOfPermanentTypesAmongCardsInPlayersGraveyards(GreaterThanOrEqualTo({{Number[0]}}), SinglePlayer(You)))",
    "Activate only if there are {{Number}} or more {{SpecificCards}} in your graveyard": "ActivateOnlyIf(PlayerPassesFilter(You, NumCardsInGraveyardIs(GreaterThanOrEqualTo({{Number[0]}}), {{SpecificCards[0]}})))",
    "Activate only if there are {{Number}} or more {{SpecificCards}} in your graveyard and only as a sorcery": "And([ActivateOnlyIf(PlayerPassesFilter(You, NumCardsInGraveyardIs(GreaterThanOrEqualTo({{Number[0]}}), {{SpecificCards[0]}}))), ActivateOnlyAsASorcery])",
    "Activate only if you attacked this turn": "ActivateOnlyIf(PlayerPassesFilter(You, AttackedThisTurn))",
    "Activate only if you attacked with {{Number}} or more creatures this turn": "ActivateOnlyIf(PlayerPassesFilter(You, AttackedWithNumCreaturesThisTurn(GreaterThanOrEqualTo({{Number[0]}}), IsCardtype(Creature))))",
    "Activate only if you attacked with {{Number}} or more creatures this turn and only as a sorcery": "And([ActivateOnlyIf(PlayerPassesFilter(You, AttackedWithNumCreaturesThisTurn(GreaterThanOrEqualTo({{Number[0]}}), IsCardtype(Creature)))), ActivateOnlyAsASorcery])",
    "Activate only if you control a creature that fought this turn": "ActivateOnlyIf(PlayerPassesFilter(You, ControlsA(And([IsCardtype(Creature), FoughtThisTurn]))))",
    "Activate only if you control an enchantment and only as a sorcery": "And([ActivateOnlyIf(PlayerPassesFilter(You, ControlsA(IsCardtype(Enchantment)))), ActivateOnlyAsASorcery])",
    "Activate only if you control no {{Permanents}}": "ActivateOnlyIf(PlayerPassesFilter(You, ControlsNo({{Permanents[0]}})))",
    "Activate only if you control no {{Permanents}} and only during your turn": "And([ActivateOnlyIf(PlayerPassesFilter(You, ControlsNo({{Permanents[0]}}))), ActivateOnlyIf(PlayerPassesFilter(You, IsTheirTurn))])",
    "Activate only if you control no {{Permanents}} and only once each turn": "And([ActivateOnlyIf(PlayerPassesFilter(You, ControlsNo({{Permanents[0]}}))), ActivateOnlyOnceEachTurn])",
    "Activate only if you control {{Number}} or more {{Creatures}} with different powers": "ActivateOnlyIf(PlayerPassesFilter(You, ControlsNumWithDifferentPowers(GreaterThanOrEqualTo({{Number[0]}}), {{Creatures[0]}})))",
    "Activate only if you control {{Number}} or more {{Permanents}}": "ActivateOnlyIf(PlayerPassesFilter(You, ControlsNum(GreaterThanOrEqualTo({{Number[0]}}), {{Permanents[0]}})))",
    "Activate only if you control {{Number}} or more {{Permanents}} and only as a sorcery": "And([ActivateOnlyIf(PlayerPassesFilter(You, ControlsNum(GreaterThanOrEqualTo({{Number[0]}}), {{Permanents[0]}}))), ActivateOnlyAsASorcery])",
    "Activate only if you control {{Number}} or more {{Permanents}} with the same name": "ActivateOnlyIf(PlayerPassesFilter(You, ControlsNumThatShareAName(GreaterThanOrEqualTo({{Number[0]}}), {{Permanents[0]}})))",
    "Activate only if you control {{a}} {{Permanent}}": "ActivateOnlyIf(PlayerPassesFilter(You, ControlsA({{Permanent[0]}})))",
    "Activate only if you control {{a}} {{Permanent}} or there is {{a}} {{SpecificCard}} in your graveyard": "ActivateOnlyIf(Or([PlayerPassesFilter(You, ControlsA({{Permanent[0]}})), PlayerPassesFilter(You, HasACardInGraveyard({{SpecificCard[0]}}))]))",
    "Activate only if you control {{a}} {{Permanent}} or {{a}} {{Permanent}}": "ActivateOnlyIf(PlayerPassesFilter(You, ControlsA(Or([{{Permanent[0]}}, {{Permanent[1]}}]))))",
    "Activate only if you created a token this turn": "ActivateOnlyIf(PlayerPassesFilter(You, CreatedATokenThisTurn))",
    "Activate only if you gained life this turn": "ActivateOnlyIf(PlayerPassesFilter(You, GainedLifeThisTurn))",
    "Activate only if you had {{a}} {{Permanent}} enter the battlefield under your control this turn": "ActivateOnlyIf(PlayerPassesFilter(You, HadAPermanentEnterTheBattlefieldUnderTheirControlThisTurn({{Permanent[0]}})))",
    "Activate only if you have at least {{Digits}} life more than your starting life total": "ActivateOnlyIf(PlayerPassesFilter(You, LifeTotalIs(GreaterThanOrEqualTo(Plus(StartingLifeTotalOfPlayer(You), {{Digits[0]}})))))",
    "Activate only if you have at least {{Digits}} life more than your starting life total and only as a sorcery": "And([ActivateOnlyIf(PlayerPassesFilter(You, LifeTotalIs(GreaterThanOrEqualTo(Plus(StartingLifeTotalOfPlayer(You), {{Digits[0]}}))))), ActivateOnlyAsASorcery])",
    "Activate only if you have exactly {{Number}} cards in hand": "ActivateOnlyIf(PlayerPassesFilter(You, NumCardsInHandIs(EqualTo({{Number[0]}}))))",
    "Activate only if you have exactly {{Number}} or {{Number}} cards in hand": "ActivateOnlyIf(PlayerPassesFilter(You, Or([NumCardsInHandIs(EqualTo({{Number[0]}})), NumCardsInHandIs(EqualTo({{Number[1]}}))])))",
    "Activate only if you have more cards in hand than each opponent": "ActivateOnlyIf(PlayerPassesFilter(You, HasHighestNumberOfCardsInHandAmongPlayers(Opponent)))",
    "Activate only if you have no cards in hand": "ActivateOnlyIf(PlayerPassesFilter(You, NumCardsInHandIs(EqualTo(Integer(0)))))",
    "Activate only if you have the city's blessing": "ActivateOnlyIf(PlayerPassesFilter(You, HasTheCitysBlessing))",
    "Activate only if you have {{Digits}} or more life": "ActivateOnlyIf(PlayerPassesFilter(You, LifeTotalIs(GreaterThanOrEqualTo({{Digits[0]}}))))",
    "Activate only if you have {{Number}} or more cards in your hand": "ActivateOnlyIf(PlayerPassesFilter(You, NumCardsInHandIs(GreaterThanOrEqualTo({{Number[0]}}))))",
    "Activate only if you own a card in exile": "ActivateOnlyIf(PlayerPassesFilter(You, OwnsACardInExile(AnyExiledCard)))",
    "Activate only if you've cast {{Number}} or more spells this turn": "ActivateOnlyIf(PlayerPassesFilter(You, CastNumSpellsThisTurn(GreaterThanOrEqualTo({{Number[0]}}), AnySpell)))",
    "Activate only if you've cast {{a}} {{Spell}} this turn": "ActivateOnlyIf(PlayerPassesFilter(You, CastASpellThisTurn({{Spell[0]}})))",
    "Activate only if you've completed a dungeon": "ActivateOnlyIf(PlayerPassesFilter(You, CompletedADungeon))",
    "Activate only if you've discarded a card this turn": "ActivateOnlyIf(PlayerPassesFilter(You, DiscardedACardThisTurn))",
    "Activate only if you've paid or lost {{Number}} or more {{EnergyCounters}} this turn": "ActivateOnlyIf(PlayerPassesFilter(You, PaidOrLostAnAmountOfEnergyThisTurn(GreaterThanOrEqualTo({{Number[0]}}))))",
    "Activate only if you've sacrificed an artifact this turn": "ActivateOnlyIf(PlayerPassesFilter(You, SacrificedAPermanentThisTurn(IsCardtype(Artifact))))",
    "Activate only if {{Black}} sources you controlled dealt {{Digits}} or more noncombat damage this turn and only as a sorcery": "And([ActivateOnlyIf(SourcesDealtNonCombatDamageThisTurn(And([IsColor({{Black[0]}}), ControlledByAPlayer(SinglePlayer(You))]), GreaterThanOrEqualTo({{Digits[0]}}))), ActivateOnlyAsASorcery])",
    "Activate only if {{Creatures}} have total power {{Digits}} or greater": "ActivateOnlyIf(TotalPowerOfPermanentsIs(GreaterThanOrEqualTo({{Digits[0]}}), {{Creatures[0]}}))",
    "Activate only if {{Number}} or more cards are in your graveyard": "ActivateOnlyIf(PlayerPassesFilter(You, NumCardsInGraveyardIs(GreaterThanOrEqualTo({{Number[0]}}), AnyCard)))",
    "Activate only if {{Number}} or more cards left your graveyard this turn or if you've sacrificed a Food this turn": "ActivateOnlyIf(Or([ANumberOfGraveyardCardsLeftThisTurn(GreaterThanOrEqualTo({{Number[0]}}), InAPlayersGraveyard(SinglePlayer(You))), PlayerPassesFilter(You, SacrificedAPermanentThisTurn(IsArtifactType(Food)))]))",
    "Activate only if {{Number}} or more creatures died this turn": "ActivateOnlyIf(ANumberOfPermanentsDiedThisTurn(GreaterThanOrEqualTo({{Number[0]}}), IsCardtype(Creature)))",
    "Activate only if {{Number}} or more creatures entered the battlefield under your control this turn": "ActivateOnlyIf(PlayerPassesFilter(You, HadANumberOfPermanentsEnterTheBattlefieldUnderTheirControlThisTurn(GreaterThanOrEqualTo({{Number[0]}}), IsCardtype(Creature))))",
    "Activate only if {{Number}} or more {{Zombie}} cards are in your graveyard": "ActivateOnlyIf(PlayerPassesFilter(You, NumCardsInGraveyardIs(GreaterThanOrEqualTo({{Number[0]}}), IsCreatureType({{Zombie[0]}}))))",
    "Activate only if {{a}} {{CounterType}} counter was removed from a permanent you controlled this turn or a permanent with {{a}} {{CounterType}} counter on it was put into a graveyard this turn": "ActivateOnlyIf(Or([ACounterOfTypeWasRemovedFromAPermanentThisTurn({{CounterType[0]}}, And([IsPermanent, ControlledByAPlayer(SinglePlayer(You))])), APermanentWasPutIntoAPlayersGraveyardThisTurn(And([IsPermanent, HasACounterOfType({{CounterType[1]}})]), AnyPlayer)]))",
    "Activate only once": "ActivateOnlyOnce",
    "Activate only once and only during your turn": "And([ActivateOnlyOnce, ActivateOnlyIf(PlayerPassesFilter(You, IsTheirTurn))])",
    "Activate only once and only if you control {{a}} {{Permanent}}": "And([ActivateOnlyOnce, ActivateOnlyIf(PlayerPassesFilter(You, ControlsA({{Permanent[0]}})))])",
    "Activate only once each turn": "ActivateOnlyOnceEachTurn",
    "Activate only once each turn and only if an opponent controls {{a}} {{Permanent}}": "And([ActivateOnlyOnceEachTurn, ActivateOnlyIf(APlayerPassesFilter(Opponent, ControlsA({{Permanent[0]}})))])",
    "Activate only once each turn and only if there are {{Number}} or more cards in your graveyard": "And([ActivateOnlyOnceEachTurn, ActivateOnlyIf(PlayerPassesFilter(You, NumCardsInGraveyardIs(GreaterThanOrEqualTo({{Number[0]}}), AnyCard)))])",
    "For each mana in this ability's activation cost, you may tap an untapped creature you control rather than pay that mana. Activate only as a sorcery": "And([ReduceManaCostForEachAlternateCost(TapAPermanent(And([IsUntapped, IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))), ActivateOnlyAsASorcery])",
    "This ability costs {{CostReduceX}} less to activate, where X is the power of the creature it targets": "ReduceCostX({{CostReduceX[0]}}, PowerOfTheCreatureItTargets)",
    "This ability costs {{CostReduceX}} less to activate, where X is this creature's power": "ReduceCostX({{CostReduceX[0]}}, PowerOfPermanent(ThisPermanent))",
    "This ability costs {{CostReduceX}} less to activate, where X is {{GameNumber}}": "ReduceCostX({{CostReduceX[0]}}, {{GameNumber[0]}})",
    "This ability costs {{CostReduce}} less to activate during your turn": "ReduceCostIf(IsPlayersTurn(You), {{CostReduce[0]}})",
    "This ability costs {{CostReduce}} less to activate for each {{Eachable}}": "ReduceCostForEach({{CostReduce[0]}}, {{Eachable[0]}})",
    "This ability costs {{CostReduce}} less to activate if {{Condition}}": "ReduceCostIf({{Condition[0]}}, {{CostReduce[0]}})",
    "This ability costs {{CostReduce}} less to activate if {{Condition}}. Activate only once each turn": "And([ReduceCostIf({{Condition[0]}}, {{CostReduce[0]}}), ActivateOnlyOnceEachTurn])",
    "This ability costs {{ManaCost}} more to activate for each {{Eachable}}": "IncreaseManaCostForEach({{ManaCost[0]}}, {{Eachable[0]}})",
    "You can't activate this ability during combat": "CantActivateIf(IsDuringCombat)"
  },
  "{{Activated(~Command)}}": {
    "{{ManaCost}}: Put {{~Command}} onto the battlefield from the command zone": "FromCommandZone(Activated(PayMana({{ManaCost[0]}}), ActionList([PutCommanderFromCommandZoneOntoBattlefield({{~Command}}, [EntersNormally])])))"
