    "{{Lands}} are {{Swamps}} in addition to their other types": "EachPermanentLayerEffect({{Lands[0]}}, [AddLandType({{Swamps[0]}})])",
    "{{Permanents}} are artifacts in addition to their other types": "EachPermanentLayerEffect({{Permanents[0]}}, [AddCardtype(Artifact)])",
    "{{Permanents}} are artifacts in addition to their other types. The same is true for {{StackSpells}} and {{SpecificCards}} you own that aren't on the battlefield": "EachPermanentLayerEffect({{Permanents[0]}}, [AddCardtype(Artifact)]), StackSpellsEffect({{StackSpells[0]}}, [AddCardtype(Artifact)]), CardEffect(And([{{SpecificCards[0]}}, OwnedByAPlayer(SinglePlayer(You))]), [AddCardtype(Artifact)])",
    "{{Permanents}} are snow": "EachPermanentLayerEffect({{Permanents[0]}}, [AddSupertype(Snow)])",
    "{{Permanents}} are {{Black}}. The same is true for {{StackSpells}} and {{SpecificCards}} you own that aren't on the battlefield": "EachPermanentLayerEffect({{Permanents[0]}}, [SetColor(SimpleColorList([{{Black[0]}}]))]), StackSpellsEffect({{StackSpells[0]}}, [SetColor(SimpleColorList([{{Black[0]}}]))]), CardEffect(And([{{SpecificCards[0]}}, OwnedByAPlayer(SinglePlayer(You))]), [SetColor(SimpleColorList([{{Black[0]}}]))])",
    "{{Permanents}} can be the targets of spells and abilities you control as though they didn't have hexproof": "EachPermanentRuleEffect({{Permanents[0]}}, [CanBeTheTargetOfSpellsAndAbilitiesAsThoughTheyDidntHaveHexproof(ControlledByAPlayer(SinglePlayer(You)))])",
    "{{Permanents}} can't be blocked by more than one creature": "EachPermanentRuleEffect({{Permanents[0]}}, [CantBeBlockedByMoreThanOne])",
    "{{Permanents}} can't be the targets of {{Black}} spells or abilities from {{Black}} sources": "EachPermanentRuleEffect({{Permanents[0]}}, [CantBeTheTargetOfSpells(IsColor({{Black[0]}})), CantBeTheTargetOfAbilities(AbilityOfASource(IsColor({{Black[1]}})))])",
    "{{Permanents}} can't be the targets of {{PotentialSpells}}": "EachPermanentRuleEffect({{Permanents[0]}}, [CantBeTheTargetOfSpells({{PotentialSpells[0]}})])",
    "{{Permanents}} can't be turned face up during your turn": "If(IsPlayersTurn(You), [EachPermanentRuleEffect({{Permanents[0]}}, [CantBeTurnedFaceUp])])",
    "{{Permanents}} can't have {{CounterType}} counters put on them": "EachPermanentRuleEffect({{Permanents[0]}}, [CantHaveAnyCountersOfTypePutOnIt({{CounterType[0]}})])",
    "{{Permanents}} can't transform": "EachPermanentRuleEffect({{Permanents[0]}}, [CantTransform])",
    "{{Permanents}} don't untap during their controllers' untap steps": "EachPermanentRuleEffect({{Permanents[0]}}, [DoesntUntapDuringControllersUntap])",
    "{{Permanents}} each player controls have {{Hasable}} as long as that player controls {{Number}} or fewer lands": "EachPermanentLayerEffect(And([{{Permanents[0]}}, ControlledByAPlayer(ControlsNum(LessThanOrEqualTo({{Number[0]}}), IsCardtype(Land)))]), [AddAbility([{{Hasable[0]}}])])",
    "{{Permanents}} enter tapped": "ReplaceWouldEnter(APermanentWouldEnterTheBattlefield({{Permanents[0]}}), [EntersTapped])",
    "{{Permanents}} enter the battlefield untapped": "ReplaceWouldEnter(APermanentWouldEnterTheBattlefield({{Permanents[0]}}), [EntersUntapped])",
    "{{Permanents}} enter untapped": "ReplaceWouldEnter(APermanentWouldEnterTheBattlefield({{Permanents[0]}}), [EntersUntapped])",
    "{{Permanents}} enter with an additional {{CounterType}} counter on them": "ReplaceWouldEnter(APermanentWouldEnterTheBattlefield({{Permanents[0]}}), [EntersWithACounter({{CounterType[0]}})])",
    "{{Permanents}} enter with an additional {{CounterType}} counter on them for each {{Eachable}}": "ReplaceWouldEnter(APermanentWouldEnterTheBattlefield({{Permanents[0]}}), [EntersWithNumberCounters({{Eachable[0]}}, {{CounterType[0]}})])",
    "{{Permanents}} enter with {{Number}} additional {{CounterType}} counters on them": "ReplaceWouldEnter(APermanentWouldEnterTheBattlefield({{Permanents[0]}}), [EntersWithNumberCounters({{Number[0]}}, {{CounterType[0]}})])",
    "{{Permanents}} enter with {{a}} {{CounterType}} counter on them": "ReplaceWouldEnter(APermanentWouldEnterTheBattlefield({{Permanents[0]}}), [EntersWithACounter({{CounterType[0]}})])",
    "{{Permanents}} have \"{{QuotedAbility}}\"": "EachPermanentLayerEffect({{Permanents[0]}}, [AddAbility([{{QuotedAbility[0]}}])])",
    "{{Permanents}} have \"{{QuotedAbility}}\" and \"{{QuotedAbility}}\"": "EachPermanentLayerEffect({{Permanents[0]}}, [AddAbility([{{QuotedAbility[0]}}]), AddAbility([{{QuotedAbility[1]}}])])",
    "{{Permanents}} have {{Hasable}}": "EachPermanentLayerEffect({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])])",
    "{{Permanents}} have {{Hasable}} and \"{{QuotedAbility}}\"": "EachPermanentLayerEffect({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{QuotedAbility[0]}}])])",
    "{{Permanents}} have {{Hasable}} and can't be blocked by {{Zombies}}": "EachPermanentLayerEffect({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])]), EachPermanentRuleEffect({{Permanents[0]}}, [CantBeBlockedByDefenders(IsCreatureType({{Zombies[0]}}))])",
    "{{Permanents}} have {{Hasable}} and {{Hasable}}": "EachPermanentLayerEffect({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])])",
    "{{Permanents}} have {{Hasable}} as long as {{Condition}}": "If({{Condition[0]}}, [EachPermanentLayerEffect({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])])])",
    "{{Permanents}} have {{Hasable}}, {{Hasable}}, and {{Hasable}}": "EachPermanentLayerEffect({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}]), AddAbility([{{Hasable[2]}}])])",
    "{{Permanents}} have {{Hasable}}, {{Hasable}}, {{Hasable}}, {{Hasable}}, {{Hasable}}, and {{Hasable}}": "EachPermanentLayerEffect({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}]), AddAbility([{{Hasable[2]}}]), AddAbility([{{Hasable[3]}}]), AddAbility([{{Hasable[4]}}]), AddAbility([{{Hasable[5]}}])])",
    "{{Permanents}} lose all abilities": "EachPermanentLayerEffect({{Permanents[0]}}, [LosesAllAbilities])",
    "{{Permanents}} lose {{CheckHasable}}": "EachPermanentLayerEffect({{Permanents[0]}}, [LosesAbility({{CheckHasable[0]}})])",
    "{{Permanents}} lose {{CheckHasable}} and can't have or gain {{CheckHasable}}": "EachPermanentLayerEffect({{Permanents[0]}}, [LosesAbility({{CheckHasable[0]}})]), EachPermanentRuleEffect({{Permanents[0]}}, [CantGainAbility({{CheckHasable[1]}})])",
    "{{Permanents}} on the battlefield and {{SpecificCards}} in graveyards can't be the targets of {{PotentialSpellsOrAbilities}}": "EachPermanentRuleEffect({{Permanents[0]}}, [CantBeTheTargetOfSpellsOrAbilities({{PotentialSpellsOrAbilities[0]}})]), EachCardInAGraveyardEffect({{SpecificCards[0]}}, AnyPlayer, [CantBeTheTargetOfSpellsOrAbilities({{PotentialSpellsOrAbilities[0]}})])",
    "{{PotentialSpells}} and {{PotentialSpells}} cost {{ManaCost}} more to cast": "StackSpellsEffect(Or([{{PotentialSpells[0]}}, {{PotentialSpells[1]}}]), [IncreaseManaCost({{ManaCost[0]}})])",
    "{{PotentialSpells}} and {{PotentialSpells}} you cast cost {{CostReduce}} less to cast": "PlayerEffect(You, [DecreaseSpellCost(Or([{{PotentialSpells[0]}}, {{PotentialSpells[0]}}]), {{CostReduce[0]}})])",
    "{{PotentialSpells}} can't be cast": "StackSpellsEffect({{PotentialSpells[0]}}, [CantBeCast])",
    "{{PotentialSpells}} cost {{CostReduce}} less to cast": "EachPlayerEffect(AnyPlayer, [DecreaseSpellCost({{PotentialSpells[0]}}, {{CostReduce[0]}})])",
    "{{PotentialSpells}} cost {{ManaCost}} more to cast": "EachPlayerEffect(AnyPlayer, [IncreaseSpellCost({{PotentialSpells[0]}}, PayMana({{ManaCost[0]}}))])",
    "{{PotentialSpells}} have convoke": "EachPlayerEffect(AnyPlayer, [SpellsCastHaveAbility({{PotentialSpells[0]}}, [Convoke])])",
    "{{PotentialSpells}} players cast have demonstrate": "EachPlayerEffect(AnyPlayer, [SpellsCastHaveAbility({{PotentialSpells[0]}}, [Demonstrate])])",
    "{{PotentialSpells}} you cast but don't own cost {{CostReduce}} less to cast": "PlayerEffect(You, [DecreaseSpellCost(And([{{PotentialSpells[0]}}, OwnedByAPlayer(Other(You))]), {{CostReduce[0]}})])",
    "{{PotentialSpells}} you cast cost {{CostReduceX}} less to cast, where X is {{GameNumber}}": "PlayerEffect(You, [DecreaseSpellCostX({{PotentialSpells[0]}}, {{CostReduceX[0]}}, {{GameNumber[0]}})])",
    "{{PotentialSpells}} you cast cost {{CostReduce}} less to cast": "PlayerEffect(You, [DecreaseSpellCost({{PotentialSpells[0]}}, {{CostReduce[0]}})])",
    "{{PotentialSpells}} you cast cost {{CostReduce}} less to cast and can't be countered": "PlayerEffect(You, [DecreaseSpellCost({{PotentialSpells[0]}}, {{CostReduce[0]}}), SpellsCastHaveAbility({{PotentialSpells[0]}}, [CantBeCountered])])",
    "{{PotentialSpells}} you cast cost {{CostReduce}} less to cast as long as {{Condition}}": "If({{Condition[0]}}, [PlayerEffect(You, [DecreaseSpellCost({{PotentialSpells[0]}}, {{CostReduce[0]}})])])",
    "{{PotentialSpells}} you cast cost {{CostReduce}} less to cast for each {{Eachable}}": "PlayerEffect(You, [DecreaseSpellCostForEach({{PotentialSpells[0]}}, {{CostReduce[0]}}, {{Eachable[0]}})])",
    "{{PotentialSpells}} you cast cost {{CostReduce}} less to cast. This effect reduces only the amount of colored mana you pay": "PlayerEffect(You, [DecreaseSpellCostOnlyColored({{PotentialSpells[0]}}, {{CostReduce[0]}})])",
    "{{PotentialSpells}} you cast cost {{ManaCost}} more to cast": "PlayerEffect(You, [IncreaseSpellCost({{PotentialSpells[0]}}, PayMana({{ManaCost[0]}}))])",
    "{{PotentialSpells}} you cast from your hand have blitz {{ManaCost}}": "PlayerEffect(You, [SpellsCastFromHandHaveAbility({{PotentialSpells[0]}}, [Blitz(PayMana({{ManaCost[0]}}))])])",
    "{{PotentialSpells}} you cast from your hand have cascade": "PlayerEffect(You, [SpellsCastFromHandHaveAbility({{PotentialSpells[0]}}, [Cascade])])",
    "{{PotentialSpells}} you cast have affinity for Auras": "StackSpellsEffect({{PotentialSpells[0]}}, [Affinity(IsEnchantmentType(Aura))])",
    "{{PotentialSpells}} you cast have affinity for artifacts": "StackSpellsEffect({{PotentialSpells[0]}}, [Affinity(IsCardtype(Artifact))])",
    "{{PotentialSpells}} you cast have affinity for creatures": "StackSpellsEffect({{PotentialSpells[0]}}, [Affinity(IsCardtype(Creature))])",
    "{{PotentialSpells}} you cast have cascade": "StackSpellsEffect(And([{{PotentialSpells[0]}}, CastByPlayer(You)]), [Cascade])",
    "{{PotentialSpells}} you cast have convoke": "StackSpellsEffect(And([{{PotentialSpells[0]}}, CastByPlayer(You)]), [Convoke])",
    "{{PotentialSpells}} you cast have demonstrate": "StackSpellsEffect(And([{{PotentialSpells[0]}}, CastByPlayer(You)]), [Demonstrate])",
    "{{PotentialSpells}} you cast have freerunning {{ManaCost}}": "StackSpellsEffect(And([{{PotentialSpells[0]}}, CastByPlayer(You)]), [Freerunning({{ManaCost[0]}})])",
    "{{PotentialSpells}} you cast have improvise": "StackSpellsEffect(And([{{PotentialSpells[0]}}, CastByPlayer(You)]), [Improvise])",
    "{{PotentialSpells}} you cast have prowl {{ManaCost}}": "StackSpellsEffect(And([{{PotentialSpells[0]}}, CastByPlayer(You)]), [Prowl({{ManaCost[0]}})])",
    "{{PotentialSpells}} you cast have sticker kicker {{ManaCost}}": "StackSpellsEffect(And([{{PotentialSpells[0]}}, CastByPlayer(You)]), [StickerKicker(PayMana({{ManaCost[0]}}))])",
    "{{PotentialSpells}} you cast have storm": "StackSpellsEffect(And([{{PotentialSpells[0]}}, CastByPlayer(You)]), [Storm])",
    "{{PotentialSpells}} your opponents cast cost {{ManaCost}} more to cast": "EachPlayerEffect(Opponent, [IncreaseSpellCost({{PotentialSpells[0]}}, PayMana({{ManaCost[0]}}))])",
    "{{PotentialSpells}} your opponents cast during your turn cost {{ManaCost}} more to cast": "If(IsPlayersTurn(You), [EachPlayerEffect(Opponent, [IncreaseSpellCost({{PotentialSpells[0]}}, PayMana({{ManaCost[0]}}))])])",
    "{{SpecificCards}} and {{SpecificCards}} in your hand have warp {{ManaCost}}": "EachCardInPlayersHandEffect(Or([{{SpecificCards[0]}}, {{SpecificCards[0]}}]), You, [AddAbility([Warp(PayMana({{ManaCost[0]}}))])])",
    "{{SpecificCards}} in graveyards and libraries can't enter the battlefield": "CardsInEachPlayersGraveyardsCantEnterTheBattlefield({{SpecificCards[0]}}, AnyPlayer), CardsInEachPlayersLibrariesCantEnterTheBattlefield({{SpecificCards[0]}}, AnyPlayer)",
    "{{SpecificCards}} in graveyards can't enter the battlefield": "CardsInEachPlayersGraveyardsCantEnterTheBattlefield({{SpecificCards[0]}}, AnyPlayer)",
    "{{SpecificCards}} in graveyards have flashback. The flashback cost is equal to the card's mana cost": "EachCardInGraveyardEffect({{SpecificCards[0]}}, You, [AddAbility([Flashback(ItsManaCost)])])",
    "{{SpecificCards}} in your graveyard have dredge {{Digits}}": "EachCardInGraveyardEffect({{SpecificCards[0]}}, You, [AddAbility([Dredge({{Digits[0]}})])])",
    "{{SpecificCards}} in your graveyard have retrace": "EachCardInGraveyardEffect({{SpecificCards[0]}}, You, [AddAbility([Retrace])])",
    "{{SpecificCards}} in your graveyard have sneak {{ManaCost}}": "EachCardInGraveyardEffect({{SpecificCards[0]}}, You, [AddAbility([Sneak(PayMana({{ManaCost[0]}}))])])",
    "{{SpecificCards}} in your graveyard have unearth. The unearth cost is equal to the card's mana cost": "EachCardInGraveyardEffect({{SpecificCards[0]}}, You, [AddAbility([Unearth(ItsManaCost)])])",
    "{{SpecificCards}} in your hand have warp {{ManaCost}}": "EachCardInPlayersHandEffect({{SpecificCards[0]}}, You, [AddAbility([Warp(PayMana({{ManaCost[0]}}))])])",
    "{{StackSpells}} can't be countered": "StackSpellsEffect({{StackSpells[0]}}, [CantBeCountered])",
    "{{StackSpells}} have deathtouch": "StackSpellsEffect({{StackSpells[0]}}, [Deathtouch])",
    "{{StackSpells}} have lifelink": "StackSpellsEffect({{StackSpells[0]}}, [Lifelink])",
    "{{StackSpells}} have rebound": "StackSpellsEffect({{StackSpells[0]}}, [Rebound])",
    "{{StaticEffect[APlayerWouldCreateAToken]}}": "{{StaticEffect[APlayerWouldCreateAToken][0]}}",
    "{{StaticEffect[PlayerWouldCreateTokens]}}": "{{StaticEffect[PlayerWouldCreateTokens][0]}}",
    "{{StaticEffect[WouldCreateTokensUnderPlayersControl]}}": "{{StaticEffect[WouldCreateTokensUnderPlayersControl][0]}}",
    "{{StaticEffect[WouldCreateTokens]}}": "{{StaticEffect[WouldCreateTokens][0]}}",
    "{{StaticEffect[WouldDealDamage](ThatPermanent)}}": "{{StaticEffect[WouldDealDamage](ThatPermanent=ThisPermanent)[0]}}",
    "{{StaticEffect[WouldDealDamage][ThisSource]}}": "{{StaticEffect[WouldDealDamage][ThisSource][0]}}",
    "{{StaticEffect[WouldDealDamage]}}": "{{StaticEffect[WouldDealDamage][0]}}",
    "{{StaticEffect[WouldRollPlanarDice]}}": "{{StaticEffect[WouldRollPlanarDice][0]}}",
    "{{Zombie}} creatures you control and Lesson spells you control have lifelink": "EachPermanentLayerEffect(And([IsCreatureType({{Zombie[0]}}), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]), [AddAbility([Lifelink])]), StackSpellsEffect(And([IsSpellType(Lesson), ControlledByAPlayer(SinglePlayer(You))]), [Lifelink])",
    "{{Zombie}} permanent spells you cast from your hand gain evoke {{ManaCost}} as you cast them": "PlayerEffect(You, [SpellsCastFromHandHaveAbility(And([IsCreatureType({{Zombie[0]}}), IsPermanent]), [Evoke(PayMana({{ManaCost[0]}}))])])"
  },
  "{{StickerSheetAbility}}": {
    "{{TicketCost}} - {{AbilityWord}} - {{QuotedAbility}}.": "AbilitySticker({{TicketCost[0]}}, [{{QuotedAbility[0]}}])",
    "{{TicketCost}} - {{Keyword}}": "AbilitySticker({{TicketCost[0]}}, [{{Keyword[0]}}])",
    "{{TicketCost}} - {{Keyword}} {{Reminder}}": "AbilitySticker({{TicketCost[0]}}, [{{Keyword[0]}}])",
    "{{TicketCost}} - {{Keyword}}, {{Keyword}}": "AbilitySticker({{TicketCost[0]}}, [{{Keyword[0]}}, {{Keyword[1]}}])",
    "{{TicketCost}} - {{Keyword}}, {{Keyword}} {{Reminder}}": "AbilitySticker({{TicketCost[0]}}, [{{Keyword[0]}}, {{Keyword[1]}}])",
    "{{TicketCost}} - {{QuotedAbility}}.": "AbilitySticker({{TicketCost[0]}}, [{{QuotedAbility[0]}}])",
    "{{TicketCost}} - {{QuotedAbility}}.\n{{QuotedAbility}}.": "AbilitySticker({{TicketCost[0]}}, [{{QuotedAbility[0]}}, {{QuotedAbility[1]}}])",
    "{{TicketCost}} - {{QuotedAbility}}. {{Reminder}}": "AbilitySticker({{TicketCost[0]}}, [{{QuotedAbility[0]}}])"
  },
  "{{StickerSheetPT}}": {
    "{{TicketCost}} - {{CardPT}}": "PTSticker({{TicketCost[0]}}, {{CardPT[0]}})"
  },
  "{{TapAPermanentCost(ThatPermanent)}}": {
    "Tap another {{Permanent}}": "TapAPermanent(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))"
  },
  "{{TapAPermanentCost(~Permanent)}}": {
    "Tap an untapped {{Black}} creature you control other than this creature": "TapAPermanent(And([IsUntapped, IsColor({{Black[0]}}), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), Other({{~Permanent}})]))"
  },
  "{{TapAPermanentCost}}": {
    "Tap {{a}} {{Permanent}}": "TapAPermanent({{Permanent[0]}})",
    "Untap {{a}} {{Permanent}}": "UntapAPermanent({{Permanent[0]}})"
  },
  "{{TapPermanentCost[EnchantedPermanent]}}": {
    "Tap {{EnchantedPermanent}}": "TapPermanent(HostPermanent)"
  },
  "{{TapPermanentsCost(~Permanent)}}": {
    "Tap any number of untapped creatures you control other than this creature with total power {{Digits}} or greater": "TapAnyNumberOfGroupPermanents(And([IsUntapped, IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), Other({{~Permanent}})]), TotalPowerIs(GreaterThanOrEqualTo({{Digits[0]}})))",
    "Tap {{Number}} other {{Permanents}}": "TapNumberPermanents({{Number[0]}}, And([Other({{~Permanent}}), {{Permanents[0]}}]))"
  },
  "{{TapPermanentsCostX}}": {
    "Tap X {{Permanents}}": "TapNumberPermanents(ValueX, {{Permanents[0]}})"
  },
  "{{TapPermanentsCost}}": {
    "Tap {{Number}} {{Permanents}}": "TapNumberPermanents({{Number[0]}}, {{Permanents[0]}})",
    "Tap {{Number}} {{Permanents}} that share a creature type": "TapNumberGroupPermanents({{Number[0]}}, {{Permanents[0]}}, ShareACreatureType)",
    "Untap {{Number}} {{Permanents}}": "UntapNumberPermanents({{Number[0]}}, {{Permanents[0]}})"
  },
  "{{TapSelfCost}}": {
    "{Q}": "UntapPermanent(ThisPermanent)",
    "{T}": "TapPermanent(ThisPermanent)"
  },
