    "you may have it deal {{Digits}} damage to any target": "Targeted([AnyTarget], ActionList([MayAction(HaveDeadPermanentDealDamage({{Digits[0]}}, Ref_AnyTarget))]))",
    "you may pay X life, where X is {{GameNumber[WhenACreatureOrPlaneswalkerDies]}}. If you do, draw X cards": "ActionList([CreateValueX({{GameNumber[WhenACreatureOrPlaneswalkerDies][0]}}), MayCost(PayLife(ValueX)), If(CostWasPaid, [DrawNumberCards(ValueX)])])",
    "you may pay any amount of {{ManaCostSymbol}}. When you do, it deals that much damage to any target": "ActionList([MayCost(PayManaAnyNumberOfTimes([{{ManaCostSymbol[0]}}])), If(CostWasPaid, [ReflexiveTrigger(Targeted([AnyTarget], ActionList([DeadPermanentDealsDamage(NumTimesPaidMana, Ref_AnyTarget)])))])])",
    "you may pay {{Digits}} life and exile it. If you do, create a token that's a copy of that creature, except it's {{PT}} and has {{Hasable}}": "ActionList([MayCost(And([PayLife({{Digits[0]}}), ExileGraveyardCard(Trigger_ThatGraveyardCard)])), If(CostWasPaid, [CreateTokens([TokenCopyOfPermanent(Trigger_ThatPermanent, TokenCopyEffects([SetPT({{PT[0]}}), AddAbility([{{Hasable[0]}}])]))])])])",
    "you may pay {{ManaCostX}}. If you do, return another target {{Zombie}} creature card with mana value X from your graveyard to the battlefield": "WithX(AnyManaValueAmongCardsInPlayersGraveyard(And([Other(Trigger_ThatGraveyardCard), IsCreatureType({{Zombie[0]}}), IsCardtype(Creature)]), You), Targeted([TargetGraveyardCard(And([Other(Trigger_ThatGraveyardCard), IsCreatureType({{Zombie[0]}}), IsCardtype(Creature), ManaValueIs(EqualTo(ValueX)), InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([MayCost(PayManaX({{ManaCostX[0]}}, ValueX)), If(CostWasPaid, [PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersNormally])])])))",
    "you may pay {{ManaCost}} and exile it. If you do, create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}}. It gains \"When this token deals combat damage to a player, sacrifice it and return the exiled card to the battlefield tapped\"": "ActionList([MayCost(And([PayMana({{ManaCost[0]}}), ExileGraveyardCard(Trigger_ThatGraveyardCard)])), If(CostWasPaid, [CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])]), CreatePermanentLayerEffect(TheCreatedToken, [AddAbility([TriggerA(WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(ThisPermanent), AnyPlayer), ActionList([SacrificePermanent(ThisPermanent), PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersTapped])]))])])])])",
    "you may pay {{ManaCost}}. If you do, return another target {{SpecificCard}} from your graveyard to your hand": "Targeted([TargetGraveyardCard(And([Other(Trigger_ThatGraveyardCard), {{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [PutGraveyardCardIntoHand(Ref_TargetGraveyardCard)])]))",
    "you may pay {{ManaCost}}. If you do, return it to its owner's hand": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [PutGraveyardCardIntoHand(Trigger_ThatGraveyardCard)])])",
    "you may pay {{ManaCost}}. If you do, return it to the battlefield tapped under its owner's control": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [PutGraveyardCardOntoBattlefield(Trigger_ThatGraveyardCard, [EntersTapped, EntersUnderOwnersControl])])])",
    "you may pay {{ManaCost}}. If you do, return that card to the battlefield tapped under your control. It's a Treasure artifact with \"{{QuotedAbility}}\", and it loses all other card types": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [PutGraveyardCardOntoBattlefield(Trigger_ThatGraveyardCard, [EntersTapped, EntersUnderPlayersControl(You), EntersWithLayerEffect([AddArtifactType(Treasure), SetCardtype(Artifact), AddAbilityAndLoseAllOtherAbilities([{{QuotedAbility[0]}}])])])])])",
    "you may pay {{ManaCost}}. If you do, return that card to the battlefield under your control. If it's a creature, it's {{a}} {{Zombie}} in addition to its other creature types": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [PutGraveyardCardOntoBattlefield(Trigger_ThatGraveyardCard, [EntersUnderPlayersControl(You)]), If(DeadPermanentPassesFilter(IsCardtype(Creature)), [CreatePermanentLayerEffect(ThePermanentPutOnTheBattlefieldThisWay, [AddCreatureType({{Zombie[0]}})])])])])",
    "you may put a permanent card with mana value less than or equal to that creature's power from your hand onto the battlefield": "ActionList([MayAction(PutACardFromHandOnBattlefield(And([IsPermanent, ManaValueIs(LessThanOrEqualTo(PowerOfPermanent(Trigger_ThatPermanent)))]), [EntersNormally]))])",
    "you may put it into its owner's library {{Nth}} from the top": "ActionList([MayAction(PutGraveyardCardInOwnersLibraryNthFromTheTop(Trigger_ThatGraveyardCard, {{Nth[0]}}))])",
    "you may put it on top of its owner's library": "ActionList([MayAction(PutDeadPermanentOnTopOfLibrary)])",
    "you may put it on your choice of the top or bottom of its owner's library": "ActionList([MayAction(PutDeadPermanentOnTopOfLibraryOrOnBottomOfLibrary)])",
    "you may return it to the battlefield face down under its owner's control. It's {{a}} {{Swamp}} land": "ActionList([MayAction(PutGraveyardCardOntoBattlefield(Trigger_ThatGraveyardCard, [EntersAsFaceDownLand({{Swamp[0]}})]))])",
    "you may return that card to the battlefield under your control": "ActionList([MayAction(ReturnDeadGraveyardCardToBattlefield([EntersUnderPlayersControl(You)]))])",
    "you may reveal cards from the top of your library until you reveal a creature card that shares a creature type with it. Put that card into your hand and the rest on the bottom of your library in a random order": "ActionList([MayAction(RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed(And([IsCardtype(Creature), SharesACreatureTypeWithDeadPermanent]), [PutTheCardFoundThisWayIntoHand, PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder]))])",
    "you may search your library for a card with the same name as that creature, reveal it, put it into your hand, then shuffle": "ActionList([MayAction(SearchLibrary([FindACardOfType(SharesANameWithDeadPermanent), RevealFoundCards, PutFoundCardsIntoHand, Shuffle]))])",
    "you may shuffle it into its owner's library": "ActionList([MayAction(ShuffleGraveyardCardIntoLibrary(Trigger_ThatGraveyardCard))])"
  },
  "{{TriggerActions[WhenAPermanentEntersTheBattlefield=ThatLand]}}": {
    "you may return target {{SpecificCard}} from your graveyard to your hand. If that land is {{a}} {{Swamp}}, you may return that {{SpecificCard}} to the battlefield instead": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([IfElse(EnteringPermanentPassesFilter(IsLandType({{Swamp[0]}})), [MayAction(PutGraveyardCardIntoHandOrOntoBattlefield(Ref_TargetGraveyardCard, [EntersNormally]))], [MayAction(PutGraveyardCardIntoHand(Ref_TargetGraveyardCard))])]))"
  },
  "{{TriggerActions[WhenAPermanentEntersTheBattlefield=~](~Permanent)}}": {
    "choose up to {{Number}} other target {{Permanents}}. For each {{Eachable[ThatEnteringPermanent=~]}}, put {{a}} {{CounterType}} counter on each of them": "Targeted([UptoNumberTargetPermanents({{Number[0]}}, {{Permanents[0]}})], ActionList([PutNumberCountersOfTypeOnEachPermanent({{Eachable[ThatEnteringPermanent=~][0]}}, {{CounterType[0]}}, Ref_TargetPermanents)]))",
    "discard a card, then draw a card. If {{Condition[WhenAPermanentEntersTheBattlefield,ThatEnteringPermanent=~](~Permanent)}}, instead discard your hand, then draw {{Number}} cards": "ActionList([IfElse({{Condition[WhenAPermanentEntersTheBattlefield,ThatEnteringPermanent=~](~Permanent=^~Permanent)[0]}}, [DiscardHand, DrawNumberCards({{Number[0]}})], [DiscardACard, DrawACard])])",
    "each player exiles the top X cards of their library, where X is {{GameNumber[ThatEnteringPermanent=~]}}": "ActionList([EachPlayerAction(AnyPlayer, ExileTheTopNumberCardsOfLibrary({{GameNumber[ThatEnteringPermanent=~][0]}}))])",
    "search your library for an Aura card that could enchant it. If this creature is still on the battlefield, put that Aura card onto the battlefield attached to it. Otherwise, reveal the Aura card and put it into your hand. Then shuffle": "ActionList([IfElse(EnteringPermanentPassesFilter(OnTheBattlefield), [SearchLibrary([FindACardOfType(And([IsEnchantmentType(Aura), CanEnchantThatEnteringPermanent])), PutFoundCardsOntoBattlefield([EntersAttachedToPermanent(ThatEnteringPermanent)]), Shuffle])], [SearchLibrary([FindACardOfType(And([IsEnchantmentType(Aura), CanEnchantThatEnteringPermanent])), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])])",
    "tap target {{Permanent}}. If {{Condition[WhenAPermanentEntersTheBattlefield,ThatEnteringPermanent=~](~Permanent)}}, that permanent doesn't untap during its controller's next untap step": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), If({{Condition[WhenAPermanentEntersTheBattlefield,ThatEnteringPermanent=~](~Permanent=^~Permanent)[0]}}, [PermanentDoesntUntapDuringControllersNextUntap(Ref_TargetPermanent)])]))",
    "you get {{Energy}}. Then if you cast it from your hand, exile cards from the top of your library until you exile {{a}} {{SpecificCard}}. You may cast that card by paying an amount of {{EnergyCounters}} equal to its mana value rather than paying its mana cost": "ActionList([GetEnergy(Integer({{Energy[0]}})), If(EnteringPermanentPassesFilter(WasCastFromTheirHand), [ExileTopCardsOfLibraryUntilASingleCardOfTypeIsExiled({{SpecificCard[0]}}), MayAction(CastExiledCardForAlternateCost(TheSpecificCardExiledThisWay, PayEnergy(ManaValueOfExiled(TheSpecificCardExiledThisWay))))])])"
  },
  "{{TriggerActions[WhenAPermanentEntersTheBattlefield]}}": {
    "create a Treasure token for each {{Eachable[ThatEnteringPermanent]}}": "ActionList([CreateTokens([NumberTokens({{Eachable[ThatEnteringPermanent][0]}}, TreasureToken)])])",
    "create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}} for each {{Eachable[ThatEnteringPermanent]}}": "ActionList([CreateTokens([NumberTokens({{Eachable[ThatEnteringPermanent][0]}}, TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}]))])])",
    "draw a card if {{Condition[ThatEnteringPermanent]}}": "ActionList([If({{Condition[ThatEnteringPermanent][0]}}, [DrawACard])])",
    "draw a card. If {{Condition[ThatEnteringPermanent]}}, draw {{Number}} cards instead": "ActionList([IfElse({{Condition[ThatEnteringPermanent][0]}}, [DrawNumberCards({{Number[0]}})], [DrawACard])])",
    "each opponent loses X life and you gain X life, where X is {{GameNumber[WhenAPermanentEntersTheBattlefield]}}": "ActionList([CreateValueX({{GameNumber[WhenAPermanentEntersTheBattlefield][0]}}), EachPlayerAction(Opponent, LoseLife(ValueX)), GainLife(ValueX)])",
    "for each {{Eachable[ThatEnteringPermanent]}}, draw a card": "ActionList([DrawNumberCards({{Eachable[ThatEnteringPermanent][0]}})])",
    "for each {{Eachable[ThatEnteringPermanent]}}, each opponent discards a card": "ActionList([EachPlayerAction(Opponent, DiscardNumberCards({{Eachable[ThatEnteringPermanent][0]}}))])",
    "for each {{Eachable[ThatEnteringPermanent]}}, it gets {{PTMod}} and gains {{Hasable}} and {{Hasable}} until end of turn": "ActionList([CreatePermanentLayerEffectUntil(ThatEnteringPermanent, [AdjustPTForEach({{PTMod[0]}}, {{Eachable[ThatEnteringPermanent][0]}}), AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)])",
    "put {{Number}} {{CounterType}} counters on each other {{Permanent}}": "ActionList([PutNumberCountersOfTypeOnEachPermanent({{Number[0]}}, {{CounterType[0]}}, And([Other(ThatEnteringPermanent), {{Permanent[0]}}]))])",
    "reveal the top {{Number}} cards of your library. You may put a card that shares a creature type with it from among them into your hand. Put the rest on the bottom of your library in a random order": "ActionList([RevealTheTopNumberCardsOfLibrary({{Number[0]}}, [MayPutACardOfTypeIntoHand(SharesACreatureTypeWithPermanent(ThatEnteringPermanent)), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "sacrifice it unless {{Condition[ThatEnteringPermanent]}}": "ActionList([Unless({{Condition[ThatEnteringPermanent][0]}}, [SacrificePermanent(ThatEnteringPermanent)])])",
    "you may search your library for a card with the same name as another creature you control, reveal it, put it into your hand, then shuffle": "ActionList([MayAction(SearchLibrary([FindACardOfType(SharesANameWithAPermanent(And([Other(ThatEnteringPermanent), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))), RevealFoundCards, PutFoundCardsIntoHand, Shuffle]))])"
  },
  "{{TriggerActions[WhenAPermanentExploitsAnotherPermanent]}}": {
    "draw a card. If the exploited creature had power {{Digits}} or greater, create a Treasure token": "ActionList([DrawACard, If(ACreatureWasExploitedThisWay(PowerIs(GreaterThanOrEqualTo({{Digits[0]}}))), [CreateTokens([TreasureToken])])])",
    "return to their owners' hands all creatures your opponents control with toughness less than the exploited creature's toughness": "ActionList([PutEachPermanentIntoItsOwnersHand(And([IsCardtype(Creature), ControlledByAPlayer(Opponent), ToughnessIs(LessThan(ToughnessOfPermanent(Trigger_ThatOtherPermanent)))]))])"
  },
  "{{TriggerActions[WhenAPermanentIsPutIntoAGraveyard](ThatPlayer)}}": {
    "put that card onto the battlefield under your control unless that opponent pays {{Digits}} life": "ActionList([PlayerMayCost({{ThatPlayer}}, PayLife({{Digits[0]}})), Unless(CostWasPaid, [PutGraveyardCardOntoBattlefield(Trigger_ThatGraveyardCard, [EntersUnderPlayersControl(You)])])])"
  },
  "{{TriggerActions[WhenAPermanentIsPutIntoAGraveyard](~GraveyardCard)}}": {
    "at the beginning of each of your upkeeps for the rest of the game, remove all {{CounterType}} counters from a land that {{a}} {{CounterType}} counter was put onto with this artifact but that {{a}} {{CounterType}} counter has not been removed from with this artifact": "ActionList([CreateTrigger(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), ActionList([RemoveAllCountersOfTypeFromAPermanent({{CounterType[0]}}, And([IsCardtype(Land), HasACounterOfTypeFromPermanent({{CounterType[1]}}, ThisPermanent), HasntHadACounterOfTypeRemovedWithThisEffect({{CounterType[2]}})]))]))])",
    "at the beginning of the next end step, you lose {{Digits}} life and return this card to your hand": "ActionList([CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([LoseLife({{Digits[0]}}), ReturnGraveyardCardToHand(Trigger_ThatGraveyardCard)]))])",
    "return this card to its owner's hand": "ActionList([ReturnGraveyardCardToHand(Trigger_ThatGraveyardCard)])",
    "you may shuffle {{~GraveyardCard}} into your library": "ActionList([ShuffleGraveyardCardIntoLibrary(Trigger_ThatGraveyardCard)])"
  },
  "{{TriggerActions[WhenAPermanentIsPutIntoAGraveyard](~Permanent)}}": {
    "return that card to your hand unless target opponent has this enchantment deal {{Digits}} damage to them": "Targeted([TargetPlayer(Opponent)], ActionList([PlayerMayCost(Ref_TargetPlayer, HavePermanentDealDamage({{~Permanent}}, {{Digits[0]}}, Player(ActionPlayer))), Unless(CostWasPaid, [ReturnGraveyardCardToHand(Trigger_ThatGraveyardCard)])]))",
    "you may pay {{ManaCost}}. If you do, return that card to the battlefield and attach this Equipment to it": "ActionList([MayCost(SacrificePermanent({{~Permanent}})), If(CostWasPaid, [PutGraveyardCardOntoBattlefield(Trigger_ThatGraveyardCard, [EntersNormally]), AttachPermanentToPermanent({{~Permanent}}, ThePermanentPutOnTheBattlefieldThisWay)])])",
    "you may return that card to the battlefield at the beginning of the next end step if {{~Permanent}} is still on the battlefield": "ActionList([CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([If(PermanentPassesFilter({{~Permanent}}, OnTheBattlefield), [PutGraveyardCardOntoBattlefield(Trigger_ThatGraveyardCard, [EntersNormally])])]))])",
    "you may sacrifice this enchantment. If you do, return that card to the battlefield": "ActionList([MayCost(SacrificePermanent({{~Permanent}})), If(CostWasPaid, [PutGraveyardCardOntoBattlefield(Trigger_ThatGraveyardCard, [EntersNormally])])])"
  },
  "{{TriggerActions[WhenAPermanentIsPutIntoAGraveyard]}}": {
    "each opponent sacrifices a permanent of their choice that shares a card type with it": "ActionList([EachPlayerAction(Opponent, SacrificeAPermanent(SharesACardtypeWithThatDeadPermanent))])",
    "exile it and the top {{Number}} cards of your library in a face-down pile. If you do, shuffle that pile and put it back on top of your library": "ActionList([MustCost(And([ExileGraveyardCardFaceDown(Trigger_ThatGraveyardCard), ExileTheTopNumberCardsOfLibraryFaceDown({{Number[0]}})])), If(CostWasPaid, [ShuffleExiledCardsAndPutOnTopOfLibrary(TheCardsExiledThisWay)])])",
    "exile it and you gain {{Digits}} life": "ActionList([ExileGraveyardCard(Trigger_ThatGraveyardCard), GainLife({{Digits[0]}})])",
    "exile it. Until the end of your next turn, you may cast that card": "ActionList([ExileGraveyardCard(Trigger_ThatGraveyardCard), CreatePlayerEffectUntil(You, [MayCastExiledCard(TheCardExiledThisWay)], UntilEndOfTurn)])",
    "exile that card": "ActionList([ExileGraveyardCard(Trigger_ThatGraveyardCard)])",
    "it deals {{Digits}} damage to any target": "Targeted([AnyTarget], ActionList([DeadPermanentDealsDamage({{Digits[0]}}, Ref_AnyTarget)]))",
    "its owner shuffles it into their library": "ActionList([ShuffleGraveyardCardIntoLibrary(Trigger_ThatGraveyardCard)])",
    "put it into your library {{Nth}} from the top": "ActionList([PutGraveyardCardInOwnersLibraryNthFromTheTop(Trigger_ThatGraveyardCard, {{Nth[0]}})])",
    "put that card on top of your library": "ActionList([PutGraveyardCardOnTopOfLibrary(Trigger_ThatGraveyardCard)])",
    "return all cards exiled with it to the battlefield under their owners' control": "ActionList([PutEachExiledCardOntoTheBattlefield(WasExiledWithPermanent(Trigger_ThatPermanent), [EntersUnderOwnersControl])])",
    "return it to its owner's hand": "ActionList([ReturnGraveyardCardToHand(Trigger_ThatGraveyardCard)])",
    "return it to the battlefield attached to you at the beginning of the next end step": "ActionList([CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutGraveyardCardOntoBattlefield(Trigger_ThatGraveyardCard, [EntersAttachedToPlayer(You)])]))])",
    "return it to your hand": "ActionList([ReturnGraveyardCardToHand(Trigger_ThatGraveyardCard)])",
    "return that card to its owner's hand": "ActionList([ReturnGraveyardCardToHand(Trigger_ThatGraveyardCard)])",
    "return that card to the battlefield at the beginning of the next end step": "ActionList([CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutGraveyardCardIntoHand(Trigger_ThatGraveyardCard)]))])",
    "return to your hand target artifact card in your graveyard with lesser mana value": "Targeted([TargetGraveyardCard(And([IsCardtype(Artifact), ManaValueIs(LessThanOrEqualTo(ManaValueOfPermanent(Trigger_ThatPermanent))), InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardIntoHand(Ref_TargetGraveyardCard)]))",
    "you gain life equal to its toughness": "ActionList([GainLife(ToughnessOfDeadPermanent)])",
    "you lose {{Digits}} life for each {{CounterType}} counter on it": "ActionList([LoseLifeForEach({{Digits[0]}}, NumCountersOfTypeOnDeadPermanent({{CounterType[0]}}))])",
    "you may exile it": "ActionList([MayAction(ExileGraveyardCard(Trigger_ThatGraveyardCard))])",
    "you may pay {{ManaCost}}. If you do, return that card to your hand": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [PutGraveyardCardIntoHand(Trigger_ThatGraveyardCard)])])",
    "you may put it on top of your library": "ActionList([MayAction(PutGraveyardCardOnTopOfLibrary(Trigger_ThatGraveyardCard))])",
    "you may return it to your hand": "ActionList([MayAction(ReturnGraveyardCardToHand(Trigger_ThatGraveyardCard))])",
    "you may return that card to its owner's hand at the beginning of the next end step": "ActionList([CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([MayAction(PutGraveyardCardIntoHand(Trigger_ThatGraveyardCard))]))])"
  },
  "{{TriggerActions[WhenAPermanentIsTappedForMana](ThatLand)}}": {
    "add an additional one mana of any type that land produced for each other land you control with the same name as it": "ActionList([AddManaRepeated(Trigger_AnyManaTypeProduced, TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatLand}}), IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You)), SharesANameWithPermanent({{ThatLand}})])))])",
    "its controller adds one mana of any type that land produced": "ActionList([PlayerAction(ControllerOfPermanent({{ThatLand}}), AddMana(Trigger_AnyManaTypeProduced))])"
  },
  "{{TriggerActions[WhenAPermanentLeavesTheBattlefield,TheLeavingPermanent=EnchantedCreature](~GraveyardCard)}}": {
    "that creature's controller returns this card from its owner's graveyard to the battlefield": "ActionList([PlayerAction(ControllerOfPermanent(HostPermanent), PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersNormally]))])"
  },
  "{{TriggerActions[WhenAPermanentLeavesTheBattlefield,TheLeavingPermanent=EnchantingPermanent]}}": {
    "destroy {{EnchantedCreature}}. That creature can't be regenerated": "ActionList([DestroyPermanentNoRegen(HostPermanent)])",
    "{{EnchantedPermanent}}'s controller sacrifices it": "ActionList([PlayerAction(ControllerOfPermanent(HostPermanent), SacrificePermanent(HostPermanent))])"
  },
  "{{TriggerActions[WhenAPermanentLeavesTheBattlefield](~Permanent)}}": {
    "destroy all tokens created with this enchantment. They can't be regenerated": "ActionList([DestroyEachPermanentNoRegen(And([IsToken, CreatedByPermanent({{~Permanent}})]))])",
    "each player draws cards equal to the amount of damage dealt to {{~Permanent}} this turn by sources they controlled": "ActionList([EachPlayerAction(AnyPlayer, DrawNumberCards(TheAmountOfDamageDealtToPermanentThisTurnBySources({{~Permanent}}, ControlledByAPlayer(SinglePlayer(EachablePlayer)))))])",
    "exile all tokens created with this enchantment": "ActionList([ExileEachPermanent(And([IsToken, CreatedByPermanent({{~Permanent}})]))])",
    "exile the creature put onto the battlefield with this enchantment": "ActionList([ExilePermanent(ThePermanentPutOnTheBattlefieldThisWay)])",
    "sacrifice {{a}} {{Permanent}} and this creature deals {{Digits}} damage to you": "ActionList([SacrificeAPermanent({{Permanent[0]}}), PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Player(You))])",
    "target opponent creates {{a}} {{PTX}} {{CreatureToken}} with {{Hasable}}, where X is {{GameNumber(~Permanent)}}": "Targeted([TargetPlayer(Opponent)], ActionList([CreateTokens([TokenWithPT(PTX({{PTX[0]}}, {{GameNumber(~Permanent=^~Permanent)[0]}}), {{CreatureToken[0]}}, [{{Hasable[0]}}])])]))",
    "you may discard your hand. If you do, draw cards equal to {{~Permanent}}'s intensity": "ActionList([MayCost(DiscardHand), If(CostWasPaid, [DrawNumberCards(IntensityOfPermanent({{~Permanent}}))])])",
    "you may pay {{ManaCostX}}. When you do, he deals X damage to target player": "ActionList([MayCost(PayManaAnyX({{ManaCostX[0]}})), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPlayer(AnyPlayer)], ActionList([PermanentDealsDamage(ThisPermanent, ValueX, Player(Ref_TargetPlayer))])))])])"
  },
  "{{TriggerActions[WhenAPermanentLeavesTheBattlefield]}}": {
    "exile all tokens with the same name as that creature": "ActionList([ExileEachPermanent(SharesANameWithTheLeavingPermanent)])"
  },
  "{{TriggerActions[WhenAPlayerAttacks]}}": {
    "spells you cast from exile this turn cost {{CostReduceX}} less to cast, where X is the number of players being attacked. Exile the top X cards of your library. Until end of turn, you may cast spells from among those exiled cards": "ActionList([CreateValueX(Trigger_NumberOfPlayersBeingAttacked), CreateEachSpellEffect(And([CastByPlayer(You), WasCastFromExile]), [DecreaseManaCostX({{CostReduceX[0]}}, ValueX)], UntilEndOfTurn), ExileTheTopNumberCardsOfLibrary(ValueX), CreatePlayerEffectUntil(You, [MayCastSpellsFromAmongExiled(AnySpell, TheCardsExiledThisWay)], UntilEndOfTurn)])",
    "surveil X, where X is the number of opponents being attacked": "ActionList([Surveil(NumPlayers(And([Opponent, IsAttacked])))])",
    "untap all {{Creatures}}. They gain {{Hasable}} until end of turn. After this phase, there is an additional combat phase": "ActionList([UntapEachPermanent({{Creatures[0]}}), CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), ThereIsAnAdditionalCombatPhase])"
  },
  "{{TriggerActions[WhenAPlayerDiscardsACard](ThatPlayer)}}": {
    "they choose another player. That player conjures a duplicate of that card into their hand. It perpetually gains \"{{PerpetualQuotedAbility}}\"": "ActionList([PlayerAction({{ThatPlayer}}, ChooseAPlayer(Other({{ThatPlayer}}))), PlayerAction(TheChosenPlayer, ConjureDuplicateOfGraveyardCardIntoHand(Trigger_ThatGraveyardCard)), CreatePerpetualCardInHandEffect(TheCardConjuredIntoHandThisWay, [AddAbility([{{PerpetualQuotedAbility[0]}}])])])"
  },
  "{{TriggerActions[WhenAPlayerDiscardsACard](~Permanent)}}": {
    "you may sacrifice this creature. If you do, return the discarded card from your graveyard to your hand": "ActionList([MayCost(SacrificePermanent({{~Permanent}})), If(CostWasPaid, [ReturnGraveyardCardToHand(Trigger_ThatGraveyardCard)])])"
  },
  "{{TriggerActions[WhenAPlayerDiscardsACard]}}": {
    "exile that card from your graveyard": "ActionList([ExileGraveyardCard(Trigger_ThatGraveyardCard)])",
    "you may cast it from your graveyard": "ActionList([MayAction(CastGraveyardCard(Trigger_ThatGraveyardCard))])",
    "you may exile that card from your graveyard": "ActionList([MayAction(ExileGraveyardCard(Trigger_ThatGraveyardCard))])",
    "you may exile that card from your graveyard. If you do, you may play that card this turn": "ActionList([MayCost(ExileGraveyardCard(Trigger_ThatGraveyardCard)), If(CostWasPaid, [CreatePlayerEffectUntil(You, [MayPlayExiledCard(TheCardExiledThisWay)], UntilEndOfTurn)])])",
    "you may exile that card from your graveyard. If you do, until the end of your next turn, you may play that card": "ActionList([MayCost(ExileGraveyardCard(Trigger_ThatGraveyardCard)), If(CostWasPaid, [CreatePlayerEffectUntil(You, [MayPlayExiledCard(TheCardExiledThisWay)], UntilTheEndOfPlayersNextTurn(You))])])",
    "you may pay {{ManaCost}}. If you do, create a tapped token that's a copy of that card, except it's {{a}} {{PT}} {{Black}} {{Zombie}}": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [CreateTokensWithFlags([TokenCopyOfDiscardedCard(Trigger_ThatDiscardedCard, TokenCopyEffects([SetPT({{PT[0]}}), SetColor(SimpleColorList([{{Black[0]}}])), SetCreatureTypes([{{Zombie[0]}}])]))], [EntersTapped])])])"
  },
  "{{TriggerActions[WhenAPlayerDiscardsCards]}}": {
    "exile them from your graveyard": "ActionList([ExileCardsInGraveyardDiscardedThisWay])",
    "seek a card that shares a card type with one of the discarded cards": "ActionList([SeekACard(SharesACardtypeWithCardsDiscardedThisWay)])",
    "target creature gets {{PTMod}} until end of turn for each card discarded this way. Whenever that creature deals combat damage to a player this turn, you draw a card": "Targeted([TargetPermanent(IsCardtype(Creature))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTForEach({{PTMod[0]}}, Trigger_ThatMuch)], UntilEndOfTurn), CreateTriggerUntil(WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(Ref_TargetPermanent), AnyPlayer), ActionList([DrawACard]), UntilEndOfTurn)]))",
    "you may exile one of them from your graveyard. If you do, you may cast it this turn": "ActionList([MayCost(ExileAGraveyardCard(Trigger_ThoseGraveyardCards)), If(CostWasPaid, [CreatePlayerEffectUntil(You, [MayCastExiledCard(TheCardExiledThisWay)], UntilEndOfTurn)])])"
