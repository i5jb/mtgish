  },
  "{{SpellActions(SpellDefendingPlayer)}}": {
    "Remove target creature defending player controls from combat. Creatures it was blocking that had become blocked by only that creature this combat become unblocked. You may have it block an attacking creature of your choice": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer({{SpellDefendingPlayer}})]))], ActionList([RemoveCreatureFromCombatAndUnblockBlockers(Ref_TargetPermanent), MayAction(ChooseAnAttackingCreatureForBlockerToBlock(And([IsAttacking, IsCardtype(Creature)]), Ref_TargetPermanent))]))",
