    "{{~Permanent}} can't be the target of {{NonBlack}} spells your opponents control or abilities from {{NonBlack}} sources your opponents control": "PermanentRuleEffect({{~Permanent}}, [CantBeTheTargetOfSpells(And([IsNonColor({{NonBlack[0]}}), ControlledByAPlayer(Opponent)])), CantBeTheTargetOfAbilities(AbilityOfASource(And([IsNonColor({{NonBlack[0]}}), ControlledByAPlayer(Opponent)])))])",
    "{{~Permanent}} can't be the target of {{PotentialSpells}}": "PermanentRuleEffect({{~Permanent}}, [CantBeTheTargetOfSpells({{PotentialSpells[0]}})])",
    "{{~Permanent}} can't block": "PermanentRuleEffect({{~Permanent}}, [CantBlock])",
    "{{~Permanent}} can't block {{Creatures}}": "PermanentRuleEffect({{~Permanent}}, [CantBlockAttackers({{Creatures[0]}})])",
    "{{~Permanent}} can't have more than {{Number}} {{CounterType}} counters on it": "PermanentRuleEffect({{~Permanent}}, [CantHaveMoreThanNumberCountersOfType({{Number[0]}}, {{CounterType[0]}})])",
    "{{~Permanent}} crews Vehicles as though its power were {{Digits}} greater": "PermanentRuleEffect({{~Permanent}}, [CrewsVehiclesAsThoughPowerWereGreater({{Digits[0]}})])",
    "{{~Permanent}} doesn't untap during your untap step": "PermanentRuleEffect({{~Permanent}}, [DoesntUntapDuringControllersUntap])",
    "{{~Permanent}} doesn't untap during your untap step if {{Condition}}": "If({{Condition[0]}}, [PermanentRuleEffect({{~Permanent}}, [DoesntUntapDuringControllersUntap])])",
    "{{~Permanent}} gets {{PTModX}}, where X is {{GameNumber(ThatPermanent)}}": "PermanentLayerEffect({{~Permanent}}, [AdjustPTX({{PTModX[0]}}, {{GameNumber(ThatPermanent=^~Permanent)[0]}})])",
    "{{~Permanent}} gets {{PTModX}}, where X is {{GameNumber}}": "PermanentLayerEffect({{~Permanent}}, [AdjustPTX({{PTModX[0]}}, {{GameNumber[0]}})])",
    "{{~Permanent}} gets {{PTMod}} as long as {{Condition}}": "If({{Condition[0]}}, [PermanentLayerEffect({{~Permanent}}, [AdjustPT({{PTMod[0]}})])])",
    "{{~Permanent}} gets {{PTMod}} for each {{Eachable(ThatPermanent)}}": "PermanentLayerEffect({{~Permanent}}, [AdjustPTForEach({{PTMod[0]}}, {{Eachable(ThatPermanent=^~Permanent)[0]}})])",
    "{{~Permanent}} gets {{PTMod}} for each {{Eachable(ThatPermanent)}} and each {{Eachable}}": "PermanentLayerEffect({{~Permanent}}, [AdjustPTForEach({{PTMod[0]}}, Plus({{Eachable(ThatPermanent=^~Permanent)[0]}}, {{Eachable[0]}}))])",
    "{{~Permanent}} gets {{PTMod}} for each {{Eachable}}": "PermanentLayerEffect({{~Permanent}}, [AdjustPTForEach({{PTMod[0]}}, {{Eachable[0]}})])",
    "{{~Permanent}} gets {{PTMod}} for each {{Eachable}} and each {{Eachable}}": "PermanentLayerEffect({{~Permanent}}, [AdjustPTForEach({{PTMod[0]}}, Plus({{Eachable[0]}}, {{Eachable[1]}}))])",
    "{{~Permanent}} has all abilities of ability stickers on other permanents you own and cards in your graveyard": "PermanentLayerEffect({{~Permanent}}, [AddAbilityFromEachPermanentHasable(And([Other({{~Permanent}}), IsPermanent, OwnedByAPlayer(SinglePlayer(You))]), [StickerAbility]), AddAbilityFromCardsInPlayersGraveyardHasable(AnyCard, You, [StickerAbility])])",
    "{{~Permanent}} has all activated abilities of all cards in exile with {{CounterType}} counters on them": "PermanentLayerEffect({{~Permanent}}, [AddAbilityFromAnExiledHasable(HasACounterOfType({{CounterType[0]}}), [ActivatedAbility])])",
    "{{~Permanent}} has all activated abilities of all cards you own in exile with {{CounterType}} counters on them. You may activate each of those abilities only once each turn": "PermanentLayerEffect({{~Permanent}}, [AddAbilityFromAnExiledHasable_MayOnlyActivateOnecEachTurn(And([OwnedByAPlayer(SinglePlayer(You)), HasACounterOfType({{CounterType[0]}})]), [ActivatedAbility])])",
    "{{~Permanent}} has all activated abilities of all creatures your opponents control. You may spend mana as though it were mana of any color to activate those abilities": "PermanentLayerEffect({{~Permanent}}, [AddActivatedAbilitiesAndMaySpendManaAsThoughItWasAnyColorToActivate(AbilityOfAPermanent(And([IsCardtype(Creature), ControlledByAPlayer(Opponent)])))])",
    "{{~Permanent}} has all activated abilities of creatures you control that don't have the same name as this creature": "PermanentLayerEffect({{~Permanent}}, [AddAbilityFromEachPermanentHasable(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), DoesntShareANameWithAPermanent(SinglePermanent(ThisPermanent))]), [ActivatedAbility])])",
    "{{~Permanent}} has all activated abilities of each other {{Permanent}}": "PermanentLayerEffect({{~Permanent}}, [AddAbilityFromEachPermanentHasable(And([Other({{~Permanent}}), {{Permanent[0]}}]), [ActivatedAbility])])",
    "{{~Permanent}} has all activated abilities of lands your opponents control except mana abilities": "PermanentLayerEffect({{~Permanent}}, [AddAbilityFromEachPermanentHasable(And([IsCardtype(Land), ControlledByAPlayer(Opponent)]), [And([ActivatedAbility, NonManaAbility])])])",
    "{{~Permanent}} has all loyalty abilities of all other {{Permanents}} on the battlefield": "PermanentLayerEffect({{~Permanent}}, [AddAbilityFromEachPermanentHasable({{Permanents[0]}}, [LoyaltyAbility])])",
    "{{~Permanent}} has annihilator X, where X is {{GameNumber(ThatPermanent)}}": "PermanentLayerEffect({{~Permanent}}, [AddAbility([AnnihilatorX({{GameNumber(ThatPermanent=^~Permanent)[0]}})])])",
    "{{~Permanent}} has each activated ability of the exiled cards used to craft it. You may activate each of those abilities only once each turn": "PermanentLayerEffect({{~Permanent}}, [AddAbilityFromAnExiledHasable_MayOnlyActivateOnecEachTurn(UsedToCraftPermanent({{~Permanent}}), [ActivatedAbility])])",
    "{{~Permanent}} has {{Hasable}}": "PermanentLayerEffect({{~Permanent}}, [AddAbility([{{Hasable[0]}}])])",
    "{{~Permanent}} has {{Hasable}} and {{Hasable}} as long as {{Condition(ThatPermanent)}}": "If({{Condition(ThatPermanent=^~Permanent)[0]}}, [PermanentLayerEffect({{~Permanent}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])])])",
    "{{~Permanent}} has {{Hasable}} and {{Hasable}} as long as {{Condition}}": "If({{Condition[0]}}, [PermanentLayerEffect({{~Permanent}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])])])",
    "{{~Permanent}} has {{Hasable}} as long as {{Condition(ThatPermanent)}}": "If({{Condition(ThatPermanent=^~Permanent)[0]}}, [PermanentLayerEffect({{~Permanent}}, [AddAbility([{{Hasable[0]}}])])])",
    "{{~Permanent}} has {{Hasable}} as long as {{Condition}}": "If({{Condition[0]}}, [PermanentLayerEffect({{~Permanent}}, [AddAbility([{{Hasable[0]}}])])])",
    "{{~Permanent}} has {{Hasable}} if {{Condition(ThatPermanent)}}": "If({{Condition(ThatPermanent=^~Permanent)[0]}}, [PermanentLayerEffect({{~Permanent}}, [AddAbility([{{Hasable[0]}}])])])",
    "{{~Permanent}} has {{Hasable}} unless {{Condition(ThatPermanent)}}": "Unless({{Condition(ThatPermanent=^~Permanent)[0]}}, [PermanentLayerEffect({{~Permanent}}, [AddAbility([{{Hasable[0]}}])])])",
    "{{~Permanent}} has {{Hasable}}, {{Hasable}}, and {{Hasable}} as long as {{Condition}}": "If({{Condition[0]}}, [PermanentLayerEffect({{~Permanent}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}]), AddAbility([{{Hasable[2]}}])])])",
    "{{~Permanent}} isn't a creature unless {{Condition}}": "If({{Condition[0]}}, [PermanentLayerEffect({{~Permanent}}, [RemoveCardtype(Creature)])])",
    "{{~Permanent}} isn't legendary if {{Condition(ThatPermanent)}}": "If({{Condition(ThatPermanent=^~Permanent)[0]}}, [PermanentLayerEffect({{~Permanent}}, [RemoveSupertype(Legendary)])])",
    "{{~Permanent}} must be blocked if able": "PermanentRuleEffect({{~Permanent}}, [MustBeBlocked])",
    "{{~Permanent}} must be blocked if able, and {{~Permanent}} must be blocked by two or more creatures if able": "PermanentRuleEffect({{~Permanent}}, [MustBeBlocked, MustBeBlockedByAtLeastNumberDefenders(Integer(2))])"
  },
  "{{StaticEffect(~PermanentOrCommandCard)}}": {
    "As long as {{~PermanentOrCommandCard}} is in the command zone or on the battlefield, other {{PotentialSpells}} you cast cost {{CostReduce}} less to cast": "FromCommandZoneOrBattlefield(PlayerEffect(You, [DecreaseSpellCost(And([Other(ThisSpell), {{PotentialSpells[0]}}]), {{CostReduce[0]}})]))"
  },
  "{{StaticEffect(~Plane)}}": {
    "During your turn, you may play lands and cast spells from among cards exiled with {{~Plane}}": "If(IsPlayersTurn(You), [PlayerEffect(You, [MayPlayLandsFromAmongExiled(WasExiledWithPlane({{~Plane}})), MayCastSpellsFromAmongExiled(AnySpell, WasExiledWithPlane({{~Plane}}))])])"
  },
  "{{StaticEffect[APlayerWouldCreateAToken]}}": {
    "If you would create a Clue, Food, or Treasure token, instead create one of each": "ReplaceAPlayerWouldCreateAToken(APlayerWouldCreateAToken(SinglePlayer(You), Or([IsArtifactType(Clue), IsArtifactType(Food), IsArtifactType(Treasure)])), [CreateTokensInstead([ClueToken, FoodToken, TreasureToken])])",
    "If you would create a Fish token, create {{a}} {{PT}} {{CreatureToken}} instead": "ReplaceAPlayerWouldCreateAToken(APlayerWouldCreateAToken(SinglePlayer(You), IsCreatureType(Fish)), [CreateTokensInstead([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])])",
    "If you would create a Shark token, create {{a}} {{PT}} {{CreatureToken}} instead": "ReplaceAPlayerWouldCreateAToken(APlayerWouldCreateAToken(SinglePlayer(You), IsCreatureType(Shark)), [CreateTokensInstead([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])])"
  },
  "{{StaticEffect[EnchantedCreature](~Permanent)}}": {
    "All {{Creatures}} able to block this creature or {{EnchantedCreature}} do so": "EachPermanentRuleEffect(Or([SinglePermanent({{~Permanent}}), SinglePermanent(HostPermanent)]), [AllCreaturesMustBlockIt({{Creatures[0]}})])",
    "This creature and {{EnchantedCreature}} each get {{PTModX}}, where X is {{GameNumber}}": "EachPermanentLayerEffect(Or([SinglePermanent({{~Permanent}}), SinglePermanent(HostPermanent)]), [AdjustPTX({{PTModX[0]}}, {{GameNumber[0]}})])",
    "This creature and {{EnchantedCreature}} each get {{PTMod}} for each {{Eachable}} and {{PTMod}} for each {{Eachable}}": "EachPermanentLayerEffect(Or([SinglePermanent({{~Permanent}}), SinglePermanent(HostPermanent)]), [AdjustPTForEach({{PTMod[0]}}, {{Eachable[0]}}), AdjustPTForEach({{PTMod[1]}}, {{Eachable[1]}})])"
  },
  "{{StaticEffect[EnchantedPermanent,TheChosenColor](~Permanent)}}": {
    "{{EnchantedPermanent}} has protection from the chosen color. This effect doesn't remove this Aura": "PermanentLayerEffect(HostPermanent, [AddAbility([ProtectionAndDoesntRemovePermanents(FromColor(TheChosenColor), SinglePermanent({{~Permanent}}))])])"
  },
  "{{StaticEffect[EnchantedPermanent,TheChosenColor]}}": {
    "Prevent all damage that would be dealt to {{EnchantedCreature}} by sources of the chosen color": "PreventDamage(DamageWouldBeDealtByASourceToRecipient(IsColor(TheChosenColor), Permanent(HostPermanent)), [PreventThatDamage])",
    "Prevent all damage that would be dealt to {{EnchantedCreature}} by sources of the last chosen color": "PreventDamage(DamageWouldBeDealtByASourceToRecipient(IsColor(TheChosenColor), Permanent(HostPermanent)), [PreventThatDamage])",
    "{{EnchantedPermanent}} has protection from the chosen color. This effect doesn't remove Auras and Equipment you control that are already attached to it": "PermanentLayerEffect(HostPermanent, [AddAbility([ProtectionAndDoesntRemovePermanents(FromColor(TheChosenColor), Or([IsEnchantmentType(Aura), IsArtifactType(Equipment)]))])])",
    "{{EnchantedPermanent}} is the chosen color": "PermanentLayerEffect(HostPermanent, [SetColor(TheChosenColor)])"
  },
  "{{StaticEffect[EnchantedPermanent,TheChosenLandType]}}": {
    "{{EnchantedCreature}} has landwalk of the chosen type": "PermanentLayerEffect(HostPermanent, [AddAbility([Landwalk(IsLandTypeVariable(TheChosenLandType))])])"
  },
  "{{StaticEffect[EnchantedPermanent,TheChosenPermanent]}}": {
    "{{EnchantedPermanent}} is a copy of the chosen creature": "PermanentLayerEffect(HostPermanent, [IsACopyOf_TheObjectChosenToCopy(NoStaticCopyEffects)])"
  },
  "{{StaticEffect[EnchantedPermanent](~Permanent)}}": {
    "As long as another player controls {{EnchantedCreature}}, it can't attack or block. Otherwise, this Aura has {{Hasable}}": "IfElse(APlayerPassesFilter(Other(You), ControlsA(SinglePermanent(HostPermanent))), [PermanentRuleEffect(HostPermanent, [CantAttack, CantBlock])], [PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[0]}}])])])",
    "As long as {{Condition(~Permanent)}}, {{EnchantedCreature}} has {{Hasable}}": "If({{Condition(~Permanent=^~Permanent)[0]}}, [PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[0]}}])])])",
    "If {{EnchantedLand}} would be destroyed, instead sacrifice this Aura and that land gains {{Hasable}} until end of turn": "ReplaceWouldDestroy(PermanentWouldBeDestroyed(HostPermanent), [SacrificePermanent({{~Permanent}}), CreatePermanentLayerEffectUntil(WouldBeDestroyed_ThatPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "{{EnchantedCreature}} can't attack or block and has \"{{ManaCost}}: {{~Guest}}'s controller sacrifices it and draws a card. Activate only as a sorcery\"": "PermanentRuleEffect(HostPermanent, [CantAttack, CantBlock]), PermanentLayerEffect(HostPermanent, [AddAbility([ActivatedWithModifiers(PayMana({{ManaCost[0]}}), ActionList([PlayerAction(ControllerOfPermanent(ThePermanentThatGrantedThisAbility), SacrificePermanent(ThePermanentThatGrantedThisAbility)), DrawACard]), ActivateOnlyAsASorcery)])])",
    "{{EnchantedCreature}} gets {{PTMod}} and has protection from enchantments. This effect doesn't remove this Aura": "PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([ProtectionAndDoesntRemovePermanents(FromTypes(IsCardtype(Enchantment)), SinglePermanent({{~Permanent}}))])])",
    "{{EnchantedCreature}} gets {{PTMod}} for each {{Eachable(~Permanent)}}": "PermanentLayerEffect(HostPermanent, [AdjustPTForEach({{PTMod[0]}}, {{Eachable(~Permanent=^~Permanent)[0]}})])",
    "{{EnchantedCreature}} gets {{PTMod}} for each {{Eachable(~Permanent)}} and has {{Hasable}} and {{Hasable}}": "PermanentLayerEffect(HostPermanent, [AdjustPTForEach({{PTMod[0]}}, {{Eachable(~Permanent=^~Permanent)[0]}}), AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])])",
    "{{EnchantedPermanent}} can't attack or block. It loses all abilities and has \"{{TapSelfCost}}: Remove {{a}} {{CounterType}} counter from {{~Guest}}. Then if it has no {{CounterType}} counters on it, destroy {{~Guest}}\"": "PermanentRuleEffect(HostPermanent, [CantAttack, CantBlock]), PermanentLayerEffect(HostPermanent, [LosesAllAbilities, AddAbility([Activated({{TapSelfCost[0]}}, ActionList([RemoveACounterOfTypeFromPermanent({{CounterType[0]}}, ThePermanentThatGrantedThisAbility), If(PermanentPassesFilter(ThePermanentThatGrantedThisAbility, HasNoCountersOfType({{CounterType[1]}})), [DestroyPermanent(ThePermanentThatGrantedThisAbility)])]))])])",
    "{{EnchantedPermanent}} doesn't untap during its controller's untap step if {{Condition(~Permanent)}}": "If({{Condition(~Permanent=^~Permanent)[0]}}, [PermanentRuleEffect(HostPermanent, [DoesntUntapDuringControllersUntap])])",
    "{{EnchantedPermanent}} doesn't untap during your untap step if {{Condition(~Permanent)}}": "If({{Condition(~Permanent=^~Permanent)[0]}}, [PermanentRuleEffect(HostPermanent, [DoesntUntapDuringControllersUntap])])",
    "{{EnchantedPermanent}} has protection from the colors of permanents you control. This effect doesn't remove this Aura": "PermanentLayerEffect(HostPermanent, [AddAbility([ProtectionAndDoesntRemovePermanents(FromColor(ColorsOfPermanents(ControlledByAPlayer(SinglePlayer(You)))), SinglePermanent({{~Permanent}}))])])",
    "{{EnchantedPermanent}} has protection from {{Black}}. This effect doesn't remove this Aura": "PermanentLayerEffect(HostPermanent, [AddAbility([ProtectionAndDoesntRemovePermanents(FromColor(Colors([{{Black[0]}}])), SinglePermanent({{~Permanent}}))])])"
  },
  "{{StaticEffect[EnchantedPermanent]}}": {
    "Activated abilities of {{EnchantedPermanent}} cost {{ManaCost}} more to activate": "ActivatedAbilityEffect(AbilityOfPermanent(HostPermanent), IncreaseManaCost({{ManaCost[0]}}))",
    "All creatures able to block {{EnchantedCreature}} do so": "PermanentRuleEffect(HostPermanent, [AllCreaturesMustBlockIt(IsCardtype(Creature))])",
    "All damage that would be dealt to you is dealt to {{EnchantedCreature}} instead": "ReplaceWouldDealDamage(DamageWouldBeDealtToRecipient(Player(You)), [DealToCreatureOrPlaneswalkerInstead(HostPermanent)])",
    "All damage that would be dealt to {{EnchantedPermanent}} is dealt to its controller instead": "ReplaceWouldDealDamage(DamageWouldBeDealtToRecipient(Permanent(HostPermanent)), [DealToPlayerInstead(ControllerOfPermanent(HostPermanent))])",
    "All {{Creatures}} attack {{EnchantedPermanent}}'s controller each combat if able": "EachPermanentRuleEffect({{Creatures[0]}}, [MustAttackPlayer(ControllerOfPermanent(HostPermanent))])",
    "As long as another Aura is attached to {{EnchantedPermanent}}, it has {{Hasable}} and {{Hasable}}": "If(APermanentPassesFilter(And([Other(ThisPermanent), IsEnchantmentType(Aura)]), AttachedToPermanent(HostPermanent)), [PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])])])",
    "As long as {{Condition(ThatPermanent)}}, {{EnchantedPermanent}} doesn't untap during its controller's untap step": "If({{Condition(ThatPermanent=ThisPermanent)[0]}}, [PermanentRuleEffect(HostPermanent, [DoesntUntapDuringControllersUntap])])",
    "As long as {{Condition[EnchantedPermanent]}}, it assigns combat damage equal to its toughness rather than its power": "If({{Condition[EnchantedPermanent][0]}}, [PermanentRuleEffect(HostPermanent, [AssignsToughnessCombatDamage])])",
    "As long as {{Condition[EnchantedPermanent]}}, it can't be blocked": "If({{Condition[EnchantedPermanent][0]}}, [PermanentRuleEffect(HostPermanent, [CantBeBlocked])])",
    "As long as {{Condition[EnchantedPermanent]}}, it can't be turned face up": "If({{Condition[EnchantedPermanent][0]}}, [PermanentRuleEffect(HostPermanent, [CantBeTurnedFaceUp])])",
    "As long as {{Condition[EnchantedPermanent]}}, it doesn't untap during its controller's untap step": "If({{Condition[EnchantedPermanent][0]}}, [PermanentRuleEffect(HostPermanent, [DoesntUntapDuringControllersUntap])])",
    "As long as {{Condition[EnchantedPermanent]}}, it gets {{PTMod}}": "If({{Condition[EnchantedPermanent][0]}}, [PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}})])])",
    "As long as {{Condition[EnchantedPermanent]}}, it gets {{PTMod}} and all {{Creatures}} able to block it do so": "If({{Condition[EnchantedPermanent][0]}}, [PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}})]), PermanentRuleEffect(HostPermanent, [AllCreaturesMustBlockIt({{Creatures[0]}})])])",
    "As long as {{Condition[EnchantedPermanent]}}, it gets {{PTMod}} and can't be blocked": "If({{Condition[EnchantedPermanent][0]}}, [PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}})]), PermanentRuleEffect(HostPermanent, [CantBeBlocked])])",
    "As long as {{Condition[EnchantedPermanent]}}, it gets {{PTMod}} and can't block": "If({{Condition[EnchantedPermanent][0]}}, [PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}})]), PermanentRuleEffect(HostPermanent, [CantBlock])])",
    "As long as {{Condition[EnchantedPermanent]}}, it gets {{PTMod}} and has \"{{QuotedAbility}}\"": "If({{Condition[EnchantedPermanent][0]}}, [PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{QuotedAbility[0]}}])])])",
    "As long as {{Condition[EnchantedPermanent]}}, it gets {{PTMod}} and has {{Hasable}}": "If({{Condition[EnchantedPermanent][0]}}, [PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])])])",
    "As long as {{Condition[EnchantedPermanent]}}, it gets {{PTMod}} and has {{Hasable}} and \"{{QuotedAbility}}\"": "If({{Condition[EnchantedPermanent][0]}}, [PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}]), AddAbility([{{QuotedAbility[0]}}])])])",
    "As long as {{Condition[EnchantedPermanent]}}, it gets {{PTMod}} and loses {{CheckHasable}}": "If({{Condition[EnchantedPermanent][0]}}, [PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}}), LosesAbility({{CheckHasable[0]}})])])",
    "As long as {{Condition[EnchantedPermanent]}}, it gets {{PTMod}} for each {{Eachable}}": "If({{Condition[EnchantedPermanent][0]}}, [PermanentLayerEffect(HostPermanent, [AdjustPTForEach({{PTMod[0]}}, {{Eachable[0]}})])])",
    "As long as {{Condition[EnchantedPermanent]}}, it gets {{PTMod}}. Otherwise, it can't block": "IfElse({{Condition[EnchantedPermanent][0]}}, [PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}})])], [PermanentRuleEffect(HostPermanent, [CantBlock])])",
    "As long as {{Condition[EnchantedPermanent]}}, it has \"{{QuotedAbility}}\"": "If({{Condition[EnchantedPermanent][0]}}, [PermanentLayerEffect(HostPermanent, [AddAbility([{{QuotedAbility[0]}}])])])",
    "As long as {{Condition[EnchantedPermanent]}}, it has base power and toughness {{PT}}": "If({{Condition[EnchantedPermanent][0]}}, [PermanentLayerEffect(HostPermanent, [SetPT({{PT[0]}})])])",
    "As long as {{Condition[EnchantedPermanent]}}, it has {{Hasable}}": "If({{Condition[EnchantedPermanent][0]}}, [PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[0]}}])])])",
    "As long as {{Condition[EnchantedPermanent]}}, it loses all abilities": "If({{Condition[EnchantedPermanent][0]}}, [PermanentLayerEffect(HostPermanent, [LosesAllAbilities])])",
    "As long as {{Condition[EnchantedPermanent]}}, it's a creature in addition to its other types": "If({{Condition[EnchantedPermanent][0]}}, [PermanentLayerEffect(HostPermanent, [AddCardtype(Creature)])])",
    "As long as {{Condition[EnchantedPermanent]}}, it's an artifact creature with power and toughness each equal to {{GameNumber(ThatPermanent)}}": "If({{Condition[EnchantedPermanent][0]}}, [PermanentLayerEffect(HostPermanent, [AddCardtype(Artifact), AddCardtype(Creature), SetPowerAndToughnessBoth({{GameNumber(ThatPermanent=HostPermanent)[0]}})])])",
    "As long as {{Condition[EnchantedPermanent]}}, {{Permanents}} get {{PTMod}}": "If({{Condition[EnchantedPermanent][0]}}, [EachPermanentLayerEffect({{Permanents[0]}}, [AdjustPT({{PTMod[0]}})])])",
    "As long as {{Condition}}, all creatures able to block {{EnchantedCreature}} do so": "If({{Condition[0]}}, [PermanentRuleEffect(HostPermanent, [AllCreaturesMustBlockIt(IsCardtype(Creature))])])",
    "As long as {{Condition}}, {{EnchantedCreature}} gets an additional {{PTMod}} and has {{Hasable}}": "If({{Condition[0]}}, [PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])])])",
    "Aura spells you cast that target {{EnchantedPermanent}} cost {{CostReduce}} less to cast": "PlayerEffect(You, [DecreaseSpellCost(And([IsEnchantmentType(Aura), TargetsPermanent(HostPermanent)]), {{CostReduce[0]}})])",
    "Creatures you control other than enchanted creature get {{PTMod}}": "EachPermanentLayerEffect(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), Other(HostPermanent)]), [AdjustPT({{PTMod[0]}})])",
    "Enchanted creature attacks each combat if able": "PermanentRuleEffect(HostPermanent, [MustAttack])",
    "Enchanted creature attacks each combat if able and can't attack you": "PermanentRuleEffect(HostPermanent, [MustAttack, CantAttackPlayer(You)])",
    "Enchanted creature can attack as though it had haste": "PermanentRuleEffect(HostPermanent, [CanAttackAsThoughItHadHaste])",
    "Enchanted creature can block any number of creatures": "PermanentRuleEffect(HostPermanent, [CanBlockAnyNumberOfCreatures])",
    "Enchanted creature can block only {{Creatures}}": "PermanentRuleEffect(HostPermanent, [CanBlockOnly({{Creatures[0]}})])",
    "Enchanted creature can't attack": "PermanentRuleEffect(HostPermanent, [CantAttack])",
    "Enchanted creature can't attack or block": "PermanentRuleEffect(HostPermanent, [CantAttack, CantBlock])",
    "Enchanted creature can't attack or block unless its controller pays {{ManaCost}}": "PermanentRuleEffect(HostPermanent, [CantBlockUnlessCost(PayMana({{ManaCost[0]}})), CantAttackUnlessCost(PayMana({{ManaCost[0]}}))])",
    "Enchanted creature can't attack or block unless its controller pays {{ManaCost}} for each {{Eachable}}": "PermanentRuleEffect(HostPermanent, [CantBlockUnlessCost(PayManaForEach({{ManaCost[0]}}, {{Eachable[0]}})), CantAttackUnlessCost(PayManaForEach({{ManaCost[0]}}, {{Eachable[0]}}))])",
    "Enchanted creature can't attack unless its controller pays {{ManaCost}}": "PermanentRuleEffect(HostPermanent, [CantAttackUnlessCost(PayMana({{ManaCost[0]}}))])",
    "Enchanted creature can't attack you or planeswalkers you control": "PermanentRuleEffect(HostPermanent, [CantAttackPlayerOrPlaneswalkerControlledBy(You)])",
    "Enchanted creature can't attack, block, or crew Vehicles": "PermanentRuleEffect(HostPermanent, [CantAttack, CantBlock, CantCrew])",
