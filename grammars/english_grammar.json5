    "Whenever you put one or more counters on a permanent or player, {{TriggerActions(~Permanent,ThatMuch)}}": "TriggerA(Or([WhenAPlayerPutsAnyNumberOfGenericCountersOnAPermanent(SinglePlayer(You), AnyPermanent), WhenAPlayerPutsAnyCountersOnAPlayer(SinglePlayer(You), AnyPlayer)]), {{TriggerActions(~Permanent=^~Permanent,ThatMuch=Trigger_ThatMuch)[0]}})",
    "Whenever you put one or more counters on {{~Permanent}}, put one of each of those kinds of counters on up to one other target {{Permanent}}": "TriggerA(WhenAPlayerPutsAnyNumberOfGenericCountersOnAPermanent(SinglePlayer(You), SinglePermanent({{~Permanent}})), Targeted([UptoOneTargetPermanent(And([Other(Trigger_ThatPermanent), {{Permanent[0]}}]))], ActionList([PutACounterOfEachTypeOnPermanent(Trigger_ThoseCounterTypes, Ref_TargetPermanent)])))",
    "Whenever you put one or more counters on another creature, if it's not {{a}} {{Zombie}}, you may put the same number and kind of counters on {{~Permanent}}":
      "TriggerI(WhenAPlayerPutsAnyNumberOfGenericCountersOnAPermanent(SinglePlayer(You), And([Other({{~Permanent}}), IsCardtype(Creature)])), PermanentPassesFilter(Trigger_ThatPermanent, IsNonCreatureType({{Zombie[0]}})), ActionList([MayAction(PutDuplicateCountersOnPermanent(ThisPermanent))]))",
    "Whenever you put one or more {{CounterType}} counters on another {{Permanent}}, {{TriggerActions(~Permanent)}}": "TriggerA(WhenAPlayerPutsAnyNumberOfCountersOfTypeOnAPermanent(SinglePlayer(You), {{CounterType[0]}}, And([Other({{~Permanent}}), {{Permanent[0]}}])), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
