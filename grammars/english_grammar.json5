    "creature that player controls": "TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))",
    "creature they control": "TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))",
    "nonland card in that player's graveyard that was put there from the battlefield this turn": "TheNumberOfCardsInPlayersGraveyardThatWerePutThereFromTheBattlefieldThisTurn(IsNonCardtype(Land), {{ThatPlayer}})",
    "poison counter they have": "NumCountersOfTypePlayerHas(PoisonCounter, {{ThatPlayer}})",
    "spell they've cast this turn": "NumSpellsCastByPlayerThisTurn(AnySpell, {{ThatPlayer}})",
    "tapped artifact they control": "TheNumberOfPermanentsOnTheBattlefield(And([IsTapped, IsCardtype(Artifact), ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))",
    "time they've cast a commander from the command zone this game": "NumTimesPlayerHasACastACommanderFromCommandZone({{ThatPlayer}})",
    "untapped land that player controls": "TheNumberOfPermanentsOnTheBattlefield(And([IsUntapped, IsCardtype(Land), ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))",
