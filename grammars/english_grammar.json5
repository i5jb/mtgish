  "{{TokenQuotedAbility(~Permanent)}}": {
    "This token's power and toughness are each equal to the number of {{CounterType}} counters on {{~Permanent}}": "CDA_Power(NumCountersOfTypeOnPermanent({{CounterType[0]}}, {{~Permanent}})), CDA_Toughness(NumCountersOfTypeOnPermanent({{CounterType[0]}}, ThePermanentThatCreatedIt))"
  },
  "{{TokenQuotedAbility[TheExiledDeadPermanent]}}": {
    "When this token leaves the battlefield, return the exiled card to its owner's graveyard": "TriggerA(WhenAPermanentLeavesTheBattlefield(SinglePermanent(ThisPermanent)), ActionList([ReturnTheExiledDeadPermanentToGraveyard]))"
  },
  "{{TokenQuotedAbility}}": {
    "Enchanted creature has base power and toughness {{PT}}": "PermanentLayerEffect(HostPermanent, [SetPT({{PT[0]}})])",
    "Enchanted creature gets {{PTMod}}": "PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}})])",
    "Enchanted creature gets {{PTMod}} and has {{Hasable}}": "PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])])",
    "Enchanted creature gets {{PTMod}} for each {{Eachable}}": "PermanentLayerEffect(HostPermanent, [AdjustPTForEach({{PTMod[0]}}, {{Eachable[0]}})])",
    "Enchanted creature gets {{PTMod}} and has '{{QuotedAbility}}'": "PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{QuotedAbility[0]}}])])",
    "Enchanted creature has '{{QuotedAbility}}'": "PermanentLayerEffect(HostPermanent, [AddAbility([{{QuotedAbility[0]}}])])",
    "At end of combat, exile this token": "TriggerA(AtTheEndOfCombat, ActionList([ExilePermanent(ThisPermanent)]))",
    "At the beginning of combat on your turn, if {{Condition}}, put {{a}} {{CounterType}} counter on this token": "TriggerI(AtTheBeginningOfCombatDuringAPlayersTurn(SinglePlayer(You)), {{Condition[0]}}, ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, ThisPermanent)]))",
    "At the beginning of the end step, exile this token": "TriggerA(AtTheBeginningOfAPlayersEndStep(AnyPlayer), ActionList([ExilePermanent(ThisPermanent)]))",
    "At the beginning of the end step, sacrifice this token": "TriggerA(AtTheBeginningOfAPlayersEndStep(AnyPlayer), ActionList([SacrificePermanent(ThisPermanent)]))",
    "At the beginning of your upkeep, sacrifice another creature. If you can't, this token deals {{Digits}} damage to you": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), ActionList([MustCost(SacrificeAPermanent(And([Other(ThisPermanent), IsCardtype(Creature)]))), If(CostWasntPaid, [PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, Player(You))])]))",
    "At the beginning of your upkeep, sacrifice this token and return target {{SpecificCard}} from your graveyard to the battlefield. It gains {{Hasable}} until end of turn": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([SacrificePermanent(ThisPermanent), PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersNormally]), CreatePermanentLayerEffectUntil(ThePermanentPutOnTheBattlefieldThisWay, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])))",
    "At the beginning of your upkeep, this token deals {{Digits}} damage to you": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), ActionList([PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, Player(You))]))",
    "Cumulative upkeep {{ManaCost}}": "CumulativeUpkeep(PayMana({{ManaCost[0]}}))",
    "Equipped creature gets {{PTMod}}": "PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}})])",
    "Equipped creature gets {{PTMod}} and has {{Hasable}}": "PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])])",
    "Equipped creature gets {{PTMod}} and has {{Hasable}}, {{Hasable}}, and {{Hasable}}": "PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}]), AddAbility([{{Hasable[2]}}])])",
    "Equipped creature gets {{PTMod}} for each {{Eachable}}": "PermanentLayerEffect(HostPermanent, [AdjustPTForEach({{PTMod[0]}}, {{Eachable[0]}})])",
    "Equipped creature has '{{ManaCost}}, {{TapSelfCost}}, Sacrifice {{NamedCard}}: This creature deals {{Digits}} damage to any target'": "PermanentLayerEffect(HostPermanent, [AddAbility([Activated(And([PayMana({{ManaCost[0]}}), {{TapSelfCost[0]}}, SacrificePermanent(GuestPermanent)]), Targeted([AnyTarget], ActionList([PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, Ref_AnyTarget)])))])])",
    "Prevent all damage that would be dealt to this token": "PreventDamage(DamageWouldBeDealtToRecipient(Permanent(ThisPermanent)), [PreventThatDamage])",
    "Sacrifice this token: This token deals {{Digits}} damage to any target": "Activated(SacrificePermanent(ThisPermanent), Targeted([AnyTarget], ActionList([SacrificedPermanentDealsDamage({{Digits[0]}}, Ref_AnyTarget)])))",
    "Sacrifice this token: {{ActivatedActions}}": "Activated(SacrificePermanent(ThisPermanent), {{ActivatedActions[0]}})",
    "Spells you cast cost {{CostReduce}} less to cast": "PlayerEffect(You, [DecreaseSpellCost(AnySpell, {{CostReduce[0]}})])",
    "This Equipment's equip abilities cost {{CostReduce}} less to activate": "EachPlayerEffect(AnyPlayer, [ReduceActivatedCost(And([AbilityOfAPermanent(SinglePermanent(ThisPermanent)), EquipAbility]), {{CostReduce[0]}})])",
    "This creature can't block": "PermanentRuleEffect(ThisPermanent, [CantBlock])",
    "This creature gets {{PTMod}} for each {{Eachable}}": "PermanentLayerEffect(ThisPermanent, [AdjustPTForEach({{PTMod[0]}}, {{Eachable[0]}})])",
    "This token attacks each combat if able": "PermanentRuleEffect(ThisPermanent, [MustAttack])",
    "This token can block only creatures with {{CheckHasable}}": "PermanentRuleEffect(ThisPermanent, [CanBlockOnly(And([IsCardtype(Creature), HasAbility({{CheckHasable[0]}})]))])",
    "This token can't attack or block alone": "PermanentRuleEffect(ThisPermanent, [CantAttackAlone, CantBlockAlone])",
    "This token can't be blocked": "PermanentRuleEffect(ThisPermanent, [CantBeBlocked])",
    "This token can't be blocked by more than one creature": "PermanentRuleEffect(ThisPermanent, [CantBeBlockedByMoreThanOne])",
    "This token can't be enchanted": "PermanentRuleEffect(ThisPermanent, [CantBeEnchanted])",
    "This token can't block": "PermanentRuleEffect(ThisPermanent, [CantBlock])",
    "This token can't block or be blocked by {{Permanents}}": "PermanentRuleEffect(ThisPermanent, [CantBlockAttackers({{Permanents[0]}}), CantBeBlockedByDefenders({{Permanents[0]}})])",
    "This token crews Vehicles as though its power were {{Digits}} greater": "PermanentRuleEffect(ThisPermanent, [CrewsVehiclesAsThoughPowerWereGreater({{Digits[0]}})])",
    "This token gets {{PTMod}} as long as {{Condition}}": "If({{Condition[0]}}, [PermanentLayerEffect(ThisPermanent, [AdjustPT({{PTMod[0]}})])])",
    "This token gets {{PTMod}} for each {{Eachable(ThatPermanent)}}": "PermanentLayerEffect(ThisPermanent, [AdjustPTForEach({{PTMod[0]}}, {{Eachable(ThatPermanent=ApplyPermanentEffect_It)[0]}})])",
    "This token gets {{PTMod}} for each {{Eachable}}": "PermanentLayerEffect(ThisPermanent, [AdjustPTForEach({{PTMod[0]}}, {{Eachable[0]}})])",
    "This token saddles Mounts and crews Vehicles as though its power were {{Digits}} greater": "PermanentRuleEffect(ThisPermanent, [CrewsVehiclesAsThoughPowerWereGreater({{Digits[0]}}), SaddlesMountsAsThoughPowerWereGreater({{Digits[0]}})])",
    "When enchanted creature dies, it deals {{Digits}} damage to its controller and you create a Treasure token": "TriggerA(WhenACreatureOrPlaneswalkerDies(SinglePermanent(HostPermanent)), ActionList([DeadPermanentDealsDamage({{Digits[0]}}, Player(ControllerOfPermanent(Trigger_ThatDeadPermanent))), CreateTokens([TreasureToken])]))",
    "When this creature dies, {{TriggerActions[WhenACreatureOrPlaneswalkerDies]}}": "TriggerA(WhenACreatureOrPlaneswalkerDies(SinglePermanent(ThisPermanent)), {{TriggerActions[WhenACreatureOrPlaneswalkerDies][0]}})",
    "When this token becomes the target of a spell, sacrifice it": "TriggerA(WhenAPermanentBecomesTheTargetOfASpell(SinglePermanent(ThisPermanent), AnySpell), ActionList([SacrificePermanent(ThisPermanent)]))",
    "When this token deals damage, {{TriggerActions(ThatPermanent)}}": "TriggerA(WhenAPermanentDealsDamage(SinglePermanent(ThisPermanent)), {{TriggerActions(ThatPermanent=Trigger_ThatPermanent)[0]}})",
    "When this token dies, {{TriggerActions[WhenACreatureOrPlaneswalkerDies]}}": "TriggerA(WhenACreatureOrPlaneswalkerDies(SinglePermanent(ThisPermanent)), {{TriggerActions[WhenACreatureOrPlaneswalkerDies][0]}})",
    "When this token dies, {{TriggerActions}}": "TriggerA(WhenACreatureOrPlaneswalkerDies(SinglePermanent(ThisPermanent)), {{TriggerActions[0]}})",
    "When this token enters, if {{Condition(ThatPermanent)}}, {{TriggerActions(ThatPermanent)}}": "TriggerI(WhenAPermanentEntersTheBattlefield(SinglePermanent(ThisPermanent)), {{Condition(ThatPermanent=ThatEnteringPermanent)[0]}}, {{TriggerActions(ThatPermanent=Trigger_ThatPermanent)[0]}})",
    "When this token enters, {{TriggerActions(ThatPermanent)}}": "TriggerA(WhenAPermanentEntersTheBattlefield(SinglePermanent(ThisPermanent)), {{TriggerActions(ThatPermanent=Trigger_ThatPermanent)[0]}})",
    "When this token leaves the battlefield, it deals {{Digits}} damage to any target": "TriggerA(WhenAPermanentLeavesTheBattlefield(SinglePermanent(ThisPermanent)), Targeted([AnyTarget], ActionList([PermanentDealsDamage(Trigger_ThatPermanent, {{Digits[0]}}, Ref_AnyTarget)])))",
    "When this token leaves the battlefield, {{TriggerActions}}": "TriggerA(WhenAPermanentLeavesTheBattlefield(SinglePermanent(ThisPermanent)), {{TriggerActions[0]}})",
    "When this token is put into a graveyard from the battlefield, {{TriggerActions}}": "TriggerA(WhenAPermanentIsPutIntoAPlayersGraveyard(SinglePermanent(ThisPermanent), AnyPlayer), {{TriggerActions[0]}})",
    "Whenever a land you control enters, this token gets {{PTMod}} until end of turn": "TriggerA(WhenAPermanentEntersTheBattlefield(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You))])), ActionList([CreatePermanentLayerEffectUntil(ThisPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)]))",
    "{{AbilityWord}} - Whenever a land you control enters, put {{a}} {{CounterType}} counter on this token": "TriggerA(WhenAPermanentEntersTheBattlefield(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You))])), ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, ThisPermanent)]))",
    "Whenever an opponent casts {{a}} {{Spell}}, this token isn't a creature until end of turn": "TriggerA(WhenAPlayerCastsASpell(Opponent, {{Spell[0]}}), ActionList([CreatePermanentLayerEffectUntil(ThisPermanent, [RemoveCardtype(Creature)], UntilEndOfTurn)]))",
    "Whenever this creature deals damage to a player, {{TriggerActions(ThatPlayer)}}": "TriggerA(WhenAPermanentDealsDamageToAPlayer(SinglePermanent(ThisPermanent), AnyPlayer), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "Whenever this token and at least one other {{Creature}} attack, put {{a}} {{CounterType}} counter on this token": "TriggerA(WhenASingleCreatureAndANumberOfOtherCreaturesAttack(ThisPermanent, GreaterThanOrEqualTo(Integer(1)), {{Creature[0]}}), ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, ThisPermanent)]))",
    "Whenever this token attacks or blocks, {{TriggerActions}}": "TriggerA(Or([WhenACreatureAttacks(SinglePermanent(ThisPermanent)), WhenACreatureBlocks(SinglePermanent(ThisPermanent))]), {{TriggerActions[0]}})",
    "Whenever this token attacks, {{TriggerActions(ThatPermanent)}}": "TriggerA(WhenACreatureAttacks(SinglePermanent(ThisPermanent)), {{TriggerActions(ThatPermanent=Trigger_ThatCreature)[0]}})",
    "Whenever this token attacks, {{TriggerActions}}": "TriggerA(WhenACreatureAttacks(SinglePermanent(ThisPermanent)), {{TriggerActions[0]}})",
    "Whenever this token becomes tapped, {{TriggerActions(ThatPermanent)}}": "TriggerA(WhenAPermanentBecomesTapped(SinglePermanent(ThisPermanent)), {{TriggerActions(ThatPermanent=ThatEnteringPermanent)[0]}})",
    "Whenever this token blocks a creature, that creature doesn't untap during its controller's next untap step": "TriggerA(WhenACreatureBlocksACreature(SinglePermanent(ThisPermanent), IsCardtype(Creature)), ActionList([PermanentDoesntUntapDuringControllersNextUntap(Trigger_ThatOtherCreature)]))",
    "Whenever this token deals combat damage to a player, {{TriggerActions(ThatPlayer)}}": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(ThisPermanent), AnyPlayer), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "Whenever this token deals damage to a planeswalker, destroy that planeswalker": "TriggerA(WhenAPermanentDealsDamageToAPermanent(SinglePermanent(ThisPermanent), IsCardtype(Planeswalker)), ActionList([DestroyPermanent(Trigger_ThatOtherPermanent)]))",
    "Whenever you cast {{a}} {{Spell}}, note one of its creature types that hasn't been noted for this token": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), ActionList([NoteAnUnnotedCreatureType(CreatureTypesOfSpell(Trigger_ThatSpell))]))",
    "Whenever you cast {{a}} {{Spell}}, this token deals {{Digits}} damage to any target": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), Targeted([AnyTarget], ActionList([PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, Ref_AnyTarget)])))",
    "Whenever you cast {{a}} {{Spell}}, this token deals {{Digits}} damage to each opponent": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), ActionList([PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, EachPlayer(Opponent))]))",
    "Whenever you cast {{a}} {{Spell}}, {{TriggerActions}}": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), {{TriggerActions[0]}})",
    "Whenever you draw a card, put {{a}} {{CounterType}} counter on this token": "TriggerA(WhenAPlayerDrawsACard(SinglePlayer(You)), ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, ThisPermanent)]))",
    "Whenever you gain life, put {{a}} {{CounterType}} counter on this token": "TriggerA(WhenAPlayerGainsLife(SinglePlayer(You)), ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, ThisPermanent)]))",
    "Whenever {{EnchantedCreature}} attacks, {{TriggerActions(ThatPermanent)}}": "TriggerA(WhenACreatureAttacks(SinglePermanent(HostPermanent)), {{TriggerActions(ThatPermanent=Trigger_ThatCreature)[0]}})",
    "Whenever {{EquippedCreature}} attacks, {{TriggerActions(DefendingPlayer)}}": "TriggerA(WhenACreatureAttacks(SinglePermanent(HostPermanent)), {{TriggerActions(DefendingPlayer=Trigger_DefendingPlayer)[0]}})",
    "bands with other creatures named {{NamedCard}}": "BandsWithOthers(And([IsCardtype(Creature), IsNamed(NamedCard({{NamedCard[0]}}))]))",
    "{{Creatures}} attack each combat if able": "EachPermanentRuleEffect({{Creatures[0]}}, [MustAttack])",
    "{{ManaCost}}, Sacrifice this token: This token deals {{Digits}} damage to target {{Creature}}": "Activated(And([PayMana({{ManaCost[0]}}), SacrificePermanent(ThisPermanent)]), Targeted([TargetPermanent({{Creature[0]}})], ActionList([PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, Permanent(Ref_TargetPermanent))])))",
    "{{ManaCost}}, Sacrifice this token: {{ActivatedActions}}": "Activated(And([PayMana({{ManaCost[0]}}), SacrificePermanent(ThisPermanent)]), {{ActivatedActions[0]}})",
    "{{ManaCost}}, {{TapSelfCost}}, Sacrifice this token: {{ActivatedActions}}. {{ActivateModifiers}}": "ActivatedWithModifiers(And([PayMana({{ManaCost[0]}}), {{TapSelfCost[0]}}, SacrificePermanent(ThisPermanent)]), {{ActivatedActions[0]}}, {{ActivateModifiers[0]}})",
    "{{ManaCost}}, {{TapSelfCost}}, Sacrifice this token: {{ActivatedActions}}": "Activated(And([PayMana({{ManaCost[0]}}), {{TapSelfCost[0]}}, SacrificePermanent(ThisPermanent)]), {{ActivatedActions[0]}})",
    "{{ManaCost}}, {{TapSelfCost}}: {{ActivatedActions}}": "Activated(And([PayMana({{ManaCost[0]}}), {{TapSelfCost[0]}}]), {{ActivatedActions[0]}})",
    "{{ManaCost}}, {{TapSelfCost}}, {{DiscardACardCost}}, Sacrifice this token: {{ActivatedActions}}": "Activated(And([PayMana({{ManaCost[0]}}), {{TapSelfCost[0]}}, {{DiscardACardCost[0]}}, SacrificePermanent(ThisPermanent)]), {{ActivatedActions[0]}})",
    "{{ManaCost}}: Regenerate this token": "Activated(PayMana({{ManaCost[0]}}), ActionList([RegeneratePermanent(ThisPermanent)]))",
    "{{ManaCost}}: Transform this token": "Activated(PayMana({{ManaCost[0]}}), ActionList([TransformPermanent(ThisPermanent)]))",
    "{{ManaCost}}: This creature gets {{PTMod}} until end of turn": "Activated(PayMana({{ManaCost[0]}}), ActionList([CreatePermanentLayerEffectUntil(ThisPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)]))",
    "{{ManaCost}}: This token gets {{PTMod}} until end of turn": "Activated(PayMana({{ManaCost[0]}}), ActionList([CreatePermanentLayerEffectUntil(ThisPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)]))",
    "{{Permanents}} have {{Hasable}}": "EachPermanentLayerEffect({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])])",
    "{{TapSelfCost}}, Sacrifice this token: {{ActivatedActions}}. {{ActivateModifiers}}": "ActivatedWithModifiers(And([{{TapSelfCost[0]}}, SacrificePermanent(ThisPermanent)]), {{ActivatedActions[0]}}, {{ActivateModifiers[0]}})",
    "{{TapSelfCost}}, Sacrifice this token: {{ActivatedActions}}": "Activated(And([{{TapSelfCost[0]}}, SacrificePermanent(ThisPermanent)]), {{ActivatedActions[0]}})",
    "{{TapSelfCost}}: {{ActivatedActions}}": "Activated({{TapSelfCost[0]}}, {{ActivatedActions[0]}})",
    "{{TapSelfCost}}: {{ActivatedActions}}. {{ActivateModifiers}}": "ActivatedWithModifiers({{TapSelfCost[0]}}, {{ActivatedActions[0]}}, {{ActivateModifiers[0]}})",
    "{{Zombie}} spells you cast cost {{CostReduce}} less to cast": "PlayerEffect(You, [DecreaseSpellCost(IsCreatureType({{Zombie[0]}}), {{CostReduce[0]}})])"
  },
  "{{TokenQuotedCDA_PT_0_0}}": {
    "This creature's power and toughness are each equal to {{GameNumber}}": "CDA_Power({{GameNumber[0]}}), CDA_Toughness({{GameNumber[0]}})",
    "This token's power and toughness are each equal to twice {{GameNumber}}": "CDA_Power(Twice({{GameNumber[0]}})), CDA_Toughness(Twice({{GameNumber[0]}}))",
    "This token's power and toughness are each equal to {{GameNumber(ThatPermanent)}}": "CDA_Power({{GameNumber(ThatPermanent=ThisPermanent)[0]}}), CDA_Toughness({{GameNumber(ThatPermanent=ThisPermanent)[0]}})",
    "This token's power and toughness are each equal to {{GameNumber}}": "CDA_Power({{GameNumber[0]}}), CDA_Toughness({{GameNumber[0]}})",
    "This token's power and toughness are each equal to {{GameNumber}} plus {{GameNumber}}": "CDA_Power(Plus({{GameNumber[0]}}, {{GameNumber[1]}})), CDA_Toughness(Plus({{GameNumber[0]}}, {{GameNumber[1]}}))",
  },
  "{{TokenQuotedCDA_PT_0_1}}": {
    "This token's power is equal to {{GameNumber}} and its toughness is equal to that number plus 1": "CDA_Power({{GameNumber[0]}}), CDA_Toughness(Plus({{GameNumber[0]}}, Integer(1)))"
  },
  "{{TriggerActions(DamageDealt)}}": {
    "create {{a}} {{PTX}} {{CreatureToken}} with {{Hasable}}, where X is the amount of damage those creatures dealt to that player": "ActionList([CreateTokens([TokenWithPT(PTX({{PTX[0]}}, {{DamageDealt}}), {{CreatureToken[0]}}, [{{Hasable[0]}}])])])"
  },
  "{{TriggerActions(DefendingPlayer)}}": {
    "choose a card in your hand. Defending player guesses whether that card's mana value is greater than {{GameNumber}}. If they guessed wrong, you may cast it without paying its mana cost. If you don't cast a spell this way, investigate": "ActionList([ChooseACardInHand(AnyCard), PlayerAction({{DefendingPlayer}}, GuessIfCardInHandPassesFilter(TheCardInHandChosenThisWay, ManaValueIs(GreaterThan({{GameNumber[0]}})))), If(PlayerGuessedWrong, [MayAction(CastCardInHandWithoutPaying(TheCardInHandChosenThisWay))]), If(ASpellWasntCastThisWay, [Investigate])])",
    "clash with defending player": "ActionList([Clash(SinglePlayer({{DefendingPlayer}}), [DoNothing], [DoNothing])])",
    "creatures defending player controls get {{PTMod}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil(And([IsCardtype(Creature), ControlledByPlayer({{DefendingPlayer}})]), [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])",
    "defending player can't cast spells this turn": "ActionList([CreatePlayerEffectUntil({{DefendingPlayer}}, [CantCastSpells(AnySpell)], UntilEndOfTurn)])",
    "defending player chooses {{a}} {{CreatureCard}} in your graveyard. You return that card to the battlefield with an additional {{CounterType}} counter on it. The creature is {{a}} {{Zombie}} in addition to its other types": "ActionList([PlayerAction(DefendingPlayer, ChooseACardInPlayersGraveyard({{CreatureCard[0]}}, You)), PutGraveyardCardOntoBattlefield(TheChosenGraveyardCard, [EntersWithACounter({{CounterType[0]}}), EntersWithLayerEffect([AddCreatureType({{Zombie[0]}})])])])",
    "defending player discards a card": "ActionList([PlayerAction({{DefendingPlayer}}, DiscardACard)])",
    "defending player discards a card at random": "ActionList([PlayerAction({{DefendingPlayer}}, DiscardACardAtRandom)])",
    "defending player discards all the cards in their hand, then draws that many cards": "ActionList([PlayerActions({{DefendingPlayer}}, [DiscardHand, DrawNumberCards(NumCardsDiscardedThisWay)])])",
    "defending player exiles the top {{Number}} cards of their library": "ActionList([PlayerAction({{DefendingPlayer}}, ExileTheTopNumberCardsOfLibrary({{Number[0]}}))])",
    "defending player exiles {{Number}} permanents they control": "ActionList([PlayerAction({{DefendingPlayer}}, ExileNumberPermanents({{Number[0]}}, ControlledByAPlayer(SinglePlayer(ActionPlayer))))])",
    "defending player faces a villainous choice - That player sacrifices {{a}} {{Permanent}} of their choice, or you gain control of {{a}} {{Permanent}} of your choice that player controls until end of turn. If you gain control of a creature this way, tap it, and it's attacking that player": "ActionList([PlayerAction({{DefendingPlayer}}, FaceAVillianousChoice([[PlayerAction({{DefendingPlayer}}, SacrificeAPermanent({{Permanent[0]}}))], [GainControlOfAPermanentUntil(And([{{Permanent[1]}}, ControlledByAPlayer(SinglePlayer({{DefendingPlayer}}))]), UntilEndOfTurn), TapPermanent(ThePermanentGainedControlOfThisWay), SetAttackAssignmentOfCreature(ThePermanentGainedControlOfThisWay, Player({{DefendingPlayer}}))]]))])",
    "defending player gets a poison counter": "ActionList([PlayerAction({{DefendingPlayer}}, GetAPoisonCounter)])",
    "defending player gets {{Number}} rad counters": "ActionList([PlayerAction({{DefendingPlayer}}, GetNumberRadCounters({{Number[0]}}))])",
    "defending player loses X life and you create X Treasure tokens, where X is {{GameNumber}}": "ActionList([PlayerAction({{DefendingPlayer}}, LoseLife({{GameNumber[0]}})), CreateTokens([NumberTokens({{GameNumber[0]}}, TreasureToken)])])",
    "defending player loses half their life, rounded up": "ActionList([PlayerAction({{DefendingPlayer}}, LoseLife(HalfRoundedUp(LifeTotalOfPlayer(PlayerAction_ThatPlayer))))])",
    "defending player loses {{Digits}} life": "ActionList([PlayerAction({{DefendingPlayer}}, LoseLife({{Digits[0]}}))])",
    "defending player loses {{Digits}} life and you gain {{Digits}} life": "ActionList([PlayerAction({{DefendingPlayer}}, LoseLife({{Digits[0]}})), GainLife({{Digits[0]}})])",
    "defending player loses {{Digits}} life for each {{Eachable(ThatPlayer)}}": "ActionList([PlayerAction({{DefendingPlayer}}, LoseLifeForEach({{Digits[0]}}, {{Eachable(ThatPlayer=^DefendingPlayer)[0]}}))])",
    "defending player may draw a card": "ActionList([PlayerMayAction({{DefendingPlayer}}, DrawACard)])",
    "defending player mills half their library, rounded down": "ActionList([PlayerAction({{DefendingPlayer}}, MillNumberCards(HalfRoundedDown(NumCardsInPlayersLibrary(PlayerAction_ThatPlayer))))])",
    "defending player mills half their library, rounded up": "ActionList([PlayerAction({{DefendingPlayer}}, MillNumberCards(HalfRoundedUp(NumCardsInPlayersLibrary(PlayerAction_ThatPlayer))))])",
    "defending player mills {{Number}} cards": "ActionList([PlayerAction({{DefendingPlayer}}, MillNumberCards({{Number[0]}}))])",
    "defending player reveals the top card of their library. If it's {{a}} {{SpecificCard}}, that player puts it into their hand": "ActionList([PlayerAction({{DefendingPlayer}}, RevealTopCardOfLibrary), If(ACardWasRevealedThisWay({{SpecificCard[0]}}), [PlayerAction({{DefendingPlayer}}, PutTopOfLibraryInHand)])])",
    "defending player sacrifices a creature with the least power among creatures they control": "ActionList([PlayerAction({{DefendingPlayer}}, SacrificeAPermanent(And([IsCardtype(Creature), PowerIs(EqualTo(TheLeastPowerAmongPermanents(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(ActionPlayer))]))))])))])",
    "defending player sacrifices {{a}} {{Permanent}} of their choice": "ActionList([PlayerAction({{DefendingPlayer}}, SacrificeAPermanent({{Permanent[0]}}))])",
    "defending player sacrifices {{a}} {{Permanent}} of their choice. If they do, you create a Walker token": "ActionList([PlayerMustCost({{DefendingPlayer}}, SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [CreateTokens([WalkerToken])])])",
    "destroy target {{Permanent(DefendingPlayer)}}": "Targeted([TargetPermanent({{Permanent(DefendingPlayer=^DefendingPlayer)[0]}})], ActionList([DestroyPermanent(Ref_TargetPermanent)]))",
    "draw cards equal to the number of cards in defending player's hand minus the number of cards in your hand. If you didn't draw cards this way, you may put {{a}} {{SpecificCard}} from your hand onto the battlefield": "ActionList([DrawNumberCards(Minus(TheNumberOfCardsInPlayersHand({{DefendingPlayer}}), TheNumberOfCardsInPlayersHand(You))), If(PlayerDidntDrawACardThisWay, [MayAction(PutACardFromHandOnBattlefield({{SpecificCard[0]}}, [EntersNormally]))])])",
    "each {{SpecificCard}} in defending player's hand perpetually gains \"{{PerpetualQuotedAbility}}\"": "ActionList([CreatePerpetualCardsInPlayersHandEffect({{SpecificCard[0]}}, {{DefendingPlayer}}, [AddAbility([{{PerpetualQuotedAbility[0]}}])])])",
    "exile target card from defending player's graveyard": "Targeted([TargetGraveyardCard(InAPlayersGraveyard(SinglePlayer({{DefendingPlayer}})))], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard)]))",
    "exile up to one target instant or sorcery card from defending player's graveyard. If you do, copy it. You may cast the copy by paying {{ManaCost}} rather than paying its mana cost": "Targeted([UptoOneTargetGraveyardCard(And([Or([IsCardtype(Instant), IsCardtype(Sorcery)]), InAPlayersGraveyard(SinglePlayer({{DefendingPlayer}}))]))], ActionList([MayCost(ExileGraveyardCard(Ref_TargetGraveyardCard)), If(CostWasPaid, [CopyExiledCard(TheCardExiledThisWay), MayAction(CastCopiedCardForAlternateCost(PayMana({{ManaCost[0]}})))])]))",
    "look at defending player's hand. You may put {{a}} {{SpecificCard}} from it onto the battlefield under your control tapped and attacking that player or a planeswalker they control. Return that creature to its owner's hand at the beginning of the next end step": "ActionList([LookAtPlayersHandAndChooseACardToPutOnBattlefield({{DefendingPlayer}}, {{SpecificCard[0]}}, [EntersUnderPlayersControl(You), EntersTapped, EntersAttackingPlayerOrPlaneswalkerControlledBy({{DefendingPlayer}})]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutPermanentIntoItsOwnersHand(ThePermanentPutOnTheBattlefieldThisWay)]))])",
    "look at the top card of defending player's library. You may put that card on the bottom of that player's library": "ActionList([LookAtTheTopCardOfPlayersLibrary({{DefendingPlayer}}), MayAction(PutTheTopCardOfPlayersLibraryOnTheBottomOfTheirLibrary({{DefendingPlayer}}))])",
    "look at the top {{Number}} cards of your library. Exile any number of them in a face-down pile and the rest in a face-up pile. Defending player chooses one of those piles. Put that pile into your hand": "ActionList([LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [ExileAnyNumberOfGenericCardsInAFaceDownPile, ExileTheRemainingCardsInAFaceUpPile, APlayerChoosesAPileTopPutIntoHand(SinglePlayer({{DefendingPlayer}}))])])",
    "put target {{SpecificCard}} from defending player's graveyard onto the battlefield under your control": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer({{DefendingPlayer}}))]))], ActionList([PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersUnderPlayersControl(You)])]))",
    "put target {{SpecificCard}} from defending player's graveyard onto the battlefield under your control tapped and attacking": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer({{DefendingPlayer}}))]))], ActionList([PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersUnderPlayersControl(You), EntersTapped, EntersAttacking])]))",
    "put {{a}} {{CounterType}} counter on target {{Permanent}} defending player controls": "Targeted([TargetPermanent(And([{{Permanent[0]}}, ControlledByPlayer({{DefendingPlayer}})]))], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent)]))",
    "put {{a}} {{CounterType}} counter on target {{Permanent}} of defending player's choice": "Targeted([TargetPermanentOfPlayersChoice({{Permanent[0]}}, {{DefendingPlayer}})], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent)]))",
    "remove {{a}} {{CounterType}} counter from target {{Permanent}} and put {{a}} {{CounterType}} counter on up to one target creature defending player controls": "Targeted([TargetPermanent({{Permanent[0]}}), UptoOneTargetPermanent(And([IsCardtype(Creature), ControlledByPlayer({{DefendingPlayer}})]))], ActionList([RemoveACounterOfTypeFromPermanent({{CounterType[0]}}, Ref_TargetPermanent1), PutACounterOfTypeOnPermanent({{CounterType[1]}}, Ref_TargetPermanent2)]))",
    "tap all creatures defending player controls": "ActionList([TapEachPermanent(And([IsCardtype(Creature), ControlledByPlayer({{DefendingPlayer}})]))])",
    "tap all lands defending player controls": "ActionList([TapEachPermanent(And([IsCardtype(Land), ControlledByPlayer({{DefendingPlayer}})]))])",
    "tap target creature defending player controls and put {{a}} {{CounterType}} counter on it. Then you may remove up to {{Number}} {{CounterType}} counters from among all permanents. Draw cards equal to the number of {{CounterType}} counters removed this way": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer({{DefendingPlayer}}))]))], ActionList([TapPermanent(Ref_TargetPermanent), PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent), RemoveUptoNumberCountersOfTypeFromAmongPermanents({{Number[0]}}, {{CounterType[1]}}, AnyPermanent), DrawNumberCards(NumberOfCountersRemovedThisWay)]))",
    "tap target {{Permanent(DefendingPlayer)}}": "Targeted([TargetPermanent({{Permanent(DefendingPlayer=^DefendingPlayer)[0]}})], ActionList([TapPermanent(Ref_TargetPermanent)]))",
    "target creature defending player controls gets {{PTMod}} and loses {{CheckHasable}} until your next turn": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByPlayer({{DefendingPlayer}})]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}}), LosesAbility({{CheckHasable[0]}})], UntilPlayersNextTurn(You))]))",
    "target creature defending player controls gets {{PTMod}} until end of turn": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByPlayer({{DefendingPlayer}})]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)]))",
    "target creature defending player controls loses all abilities and has base power and toughness {{PT}} until end of turn": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByPlayer({{DefendingPlayer}})]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [LosesAllAbilities, SetPT({{PT[0]}})], UntilEndOfTurn)]))",
    "untap all creatures defending player controls": "ActionList([UntapEachPermanent(And([IsCardtype(Creature), ControlledByPlayer({{DefendingPlayer}})]))])",
    "until the end of defending player's next turn, that player gets {{Number}} rad counters whenever they cast a spell": "ActionList([CreateTriggerUntil(WhenAPlayerCastsASpell(SinglePlayer({{DefendingPlayer}}), AnySpell), ActionList([PlayerAction({{DefendingPlayer}}, GetNumberRadCounters({{Number[0]}}))]), UntilTheEndOfPlayersNextTurn({{DefendingPlayer}}))])",
    "you may destroy target {{Permanent(DefendingPlayer)}}": "Targeted([TargetPermanent({{Permanent(DefendingPlayer=^DefendingPlayer)[0]}})], ActionList([MayAction(DestroyPermanent(Ref_TargetPermanent))]))",
    "you may discard a card. When you do, target creature defending player controls gets {{PTModX}} until end of turn, where X is {{GameNumber}} plus {{GameNumber}}": "ActionList([MayCost(DiscardACard), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByPlayer({{DefendingPlayer}})]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTX({{PTModX[0]}}, Plus({{GameNumber[0]}}, {{GameNumber[1]}}))], UntilEndOfTurn)])))])])",
    "you may goad target {{Permanent(DefendingPlayer)}}": "Targeted([TargetPermanent({{Permanent(DefendingPlayer=^DefendingPlayer)[0]}})], ActionList([MayAction(GoadCreature(Ref_TargetPermanent))]))",
    "you may look at defending player's hand": "ActionList([MayAction(LookAtPlayersHand({{DefendingPlayer}}))])",
    "you may pay {{Energy}}. When you do, destroy target {{Permanent}} defending player controls, and creatures that player controls without {{CheckHasable}} can't block this turn": "ActionList([MayCost(PayEnergy(Integer({{Energy[0]}}))), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPermanent(And([{{Permanent[0]}}, ControlledByAPlayer(SinglePlayer({{DefendingPlayer}}))]))], ActionList([DestroyPermanent(Ref_TargetPermanent), CreateEachPermanentRuleEffectUntil(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer({{DefendingPlayer}})), DoesntHaveAbility({{CheckHasable[0]}})]), [CantBlock], UntilEndOfTurn)])))])])",
    "you may return target {{Permanent(DefendingPlayer)}} to its owner's hand": "Targeted([TargetPermanent({{Permanent(DefendingPlayer=^DefendingPlayer)[0]}})], ActionList([MayAction(PutPermanentIntoItsOwnersHand(Ref_TargetPermanent))]))",
    "you may tap target {{Permanent(DefendingPlayer)}}": "Targeted([TargetPermanent({{Permanent(DefendingPlayer=^DefendingPlayer)[0]}})], ActionList([MayAction(TapPermanent(Ref_TargetPermanent))]))"
  },
  "{{TriggerActions(OtherThanThisPlayer)}}": {
    "each other player may draw up to {{Number}} cards": "ActionList([EachPlayerMayAction(Other({{OtherThanThisPlayer}}), DrawUptoNumberCards({{Number[0]}}))])",
    "each other player may put {{a}} {{SpecificCard}} from their hand onto the battlefield": "ActionList([EachPlayerMayAction(Other({{OtherThanThisPlayer}}), PutACardFromHandOnBattlefield({{SpecificCard[0]}}, [EntersNormally]))])",
    "each other player may put {{a}} {{SpecificCard}} onto the battlefield from their hand": "ActionList([EachPlayerMayAction(Other({{OtherThanThisPlayer}}), PutACardFromHandOnBattlefield({{SpecificCard[0]}}, [EntersNormally]))])",
    "each other player may return {{a}} {{SpecificCard}} from their graveyard to the battlefield": "ActionList([EachPlayerMayAction(Other({{OtherThanThisPlayer}}), ReturnACardFromGraveyardToBattlefield({{SpecificCard[0]}}, [EntersNormally]))])",
    "each other player sacrifices {{a}} {{Permanent}} of their choice": "ActionList([EachPlayerAction(Other({{OtherThanThisPlayer}}), SacrificeAPermanent({{Permanent[0]}}))])"
  },
  "{{TriggerActions(ThatActivatedAbility)}}": {
    "copy that ability. You may choose new targets for the copy": "ActionList([CopyAbilityAndMayChooseNewTargets(Trigger_ThatActivatedAbility)])",
    "you may pay {{ManaCost}}. If you do, copy that ability. You may choose new targets for the copy": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [CopyAbilityAndMayChooseNewTargets(Trigger_ThatActivatedAbility)])])"
  },
  "{{TriggerActions(ThatArtifact)}}": {
    "gain control of that artifact until the end of your next turn": "ActionList([GainControlOfPermanentUntil({{ThatArtifact}}, UntilTheEndOfPlayersNextTurn(You))])",
    "that Vehicle gains {{Hasable}} until end of turn": "ActionList([CreatePermanentLayerEffectUntil({{ThatArtifact}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "that Vehicle gets {{PTMod}} until end of turn": "ActionList([CreatePermanentLayerEffectUntil({{ThatArtifact}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])",
    "that Vehicle perpetually gets {{PTMod}}": "ActionList([CreatePerpetualPermanentEffect({{ThatArtifact}}, [AdjustPT({{PTMod[0]}})])])",
    "you may attach that Equipment to target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([MayAction(AttachPermanentToPermanent({{ThatArtifact}}, Ref_TargetPermanent))]))",
    "you may pay {{ManaCost}}. If you do, create a token that's a copy of that artifact": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [CreateTokens([TokenCopyOfPermanent({{ThatArtifact}}, NoTokenCopyEffects)])])])"
  },
  "{{TriggerActions(ThatCreature)}}": {
    "add an amount of {{ManaProduceSymbol}} equal to {{GameNumber(ThatCreature)}}. Until end of turn, you don't lose this mana as steps and phases end": "ActionList([AddManaRepeatedWithModifiers({{ManaProduceSymbol[0]}}, {{GameNumber(ThatCreature=^ThatCreature)[0]}}, DontLoseAsStepsAndPhasesEnd(UntilEndOfTurn))])",
    "all {{Creatures}} block that creature this turn if able": "ActionList([CreatePermanentRuleEffectUntil({{ThatCreature}}, [MustBeBlockedByEachDefender({{Creatures[0]}})], UntilEndOfTurn)])",
    "create X {{PT}} {{CreatureTokens}}, where X is that creature's power": "ActionList([CreateTokens([NumberTokens(PowerOfPermanent({{ThatCreature}}), TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])])",
    "create a tapped and attacking token that's a copy of another target attacking creature. If that creature is {{a}} {{Zombie}}, {{Zombie}}, {{Zombie}}, or {{Zombie}}, create two of those tokens instead": "Targeted([TargetPermanent(And([Other({{ThatCreature}}), IsAttacking, IsCardtype(Creature)]))], ActionList([IfElse(PermanentPassesFilter(Ref_TargetPermanent, Or([IsCreatureType({{Zombie[0]}}), IsCreatureType({{Zombie[1]}}), IsCreatureType({{Zombie[2]}}), IsCreatureType({{Zombie[3]}})])), [CreateTokensWithFlags([NumberTokens(Integer(2), TokenCopyOfPermanent(Ref_TargetPermanent, NoTokenCopyEffects))], [EntersTapped, EntersAttacking])], [CreateTokensWithFlags([TokenCopyOfPermanent(Ref_TargetPermanent, NoTokenCopyEffects)], [EntersTapped, EntersAttacking])])]))",
    "create a token that's a copy of a random Equipment card with mana value less than {{GameNumber(ThatCreature)}}. Attach that Equipment to that creature": "ActionList([CreateTokens([TokenCopyOfACardAtRandom(And([IsArtifactType(Equipment), ManaValueIs(LessThan({{GameNumber(ThatCreature=^ThatCreature)[0]}}))]))]), AttachPermanentToPermanent(TheCreatedToken, {{ThatCreature}})])",
    "create a token that's a copy of it, except it isn't legendary": "ActionList([CreateTokens([TokenCopyOfPermanent({{ThatCreature}}, TokenCopyEffects([RemoveSupertypes([Legendary])]))])])",
    "create a token that's a copy of it, except the token isn't legendary": "ActionList([CreateTokens([TokenCopyOfPermanent({{ThatCreature}}, TokenCopyEffects([RemoveSupertypes([Legendary])]))])])",
    "create a token that's a copy of that creature": "ActionList([CreateTokens([TokenCopyOfPermanent({{ThatCreature}}, NoTokenCopyEffects)])])",
    "create a token that's a copy of that creature, except it's {{a}} {{PT}} {{Black}} {{Zombie}}": "ActionList([CreateTokens([TokenCopyOfPermanent({{ThatCreature}}, TokenCopyEffects([SetPT({{PT[0]}}), SetColor(SimpleColorList([{{Black[0]}}])), SetCreatureTypes([{{Zombie[0]}}])]))])])",
    "create a token that's a copy of that creature. That token gains {{Hasable}}. Exile it at the beginning of the next end step": "ActionList([CreateTokens([TokenCopyOfPermanent({{ThatCreature}}, NoTokenCopyEffects)]), CreatePermanentLayerEffect(ThePermanentPutOnTheBattlefieldThisWay, [AddAbility([{{Hasable[0]}}])]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([ExilePermanent(ThePermanentPutOnTheBattlefieldThisWay)]))])",
    "create {{Number}} tapped {{PT}} {{CreatureTokens}} with {{Hasable}}. If that creature is legendary, instead create {{Number}} of those tokens that are tapped and attacking": "ActionList([IfElse(PermanentPassesFilter({{ThatCreature}}, IsSupertype(Legendary)), [CreateTokensWithFlags([NumberTokens({{Number[1]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}]))], [EntersTapped, EntersAttacking])], [CreateTokensWithFlags([NumberTokens({{Number[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}]))], [EntersTapped])])])",
    "create {{a}} {{PT}} {{CreatureToken}} that's blocking that creature": "ActionList([CreateTokensWithFlags([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])], [EntersBlockingAttacker({{ThatCreature}})])])",
    "create {{a}} {{PT}} {{CreatureToken}} unless that creature's controller pays {{ManaCost}}": "ActionList([PlayerMayCost(ControllerOfPermanent({{ThatCreature}}), PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])])])",
    "create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}} that's blocking that creature": "ActionList([CreateTokensWithFlags([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])], [EntersBlockingAttacker({{ThatCreature}})])])",
    "destroy all Auras attached to that creature": "ActionList([DestroyEachPermanent(And([IsEnchantmentType(Aura), AttachedToPermanent({{ThatCreature}})]))])",
    "destroy all Equipment attached to that creature at end of combat": "ActionList([CreateFutureTrigger(AtTheNextEndOfCombat, ActionList([DestroyEachPermanent(And([IsArtifactType(Equipment), AttachedToPermanent({{ThatCreature}})]))]))])",
    "destroy that creature": "ActionList([DestroyPermanent({{ThatCreature}})])",
    "destroy that creature at end of combat": "ActionList([CreateFutureTrigger(AtTheNextEndOfCombat, ActionList([DestroyPermanent({{ThatCreature}})]))])",
    "destroy that creature if {{Condition(ThatPermanent)}}": "ActionList([If({{Condition(ThatPermanent=^ThatCreature)[0]}}, [DestroyPermanent({{ThatCreature}})])])",
    "destroy that creature unless its controller pays {{ManaCost}}": "ActionList([PlayerMayCost(ControllerOfPermanent({{ThatCreature}}), PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [DestroyPermanent({{ThatCreature}})])])",
    "destroy that creature. Create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}}": "ActionList([DestroyPermanent({{ThatCreature}}), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])])])",
    "destroy that creature. It can't be regenerated": "ActionList([DestroyPermanentNoRegen({{ThatCreature}})])",
    "destroy that creature. The creature can't be regenerated": "ActionList([DestroyPermanentNoRegen({{ThatCreature}})])",
    "destroy that creature. You gain life equal to {{GameNumber(ThatCreature)}}": "ActionList([DestroyPermanent({{ThatCreature}}), GainLife({{GameNumber(ThatCreature=^ThatCreature)[0]}})])",
    "destroy that {{Zombie}} at end of combat": "ActionList([CreateFutureTrigger(AtTheNextEndOfCombat, ActionList([DestroyPermanent({{ThatCreature}})]))])",
    "double its power until end of turn": "ActionList([DoubleCreaturesPowerUntilEndOfTurn({{ThatCreature}})])",
    "draw a card and reveal it. The creature gets {{PTModX}} until end of turn and you lose X life, where X is that card's mana value": "ActionList([DrawACard, RevealTheCardsDrawnThisWay, CreatePermanentLayerEffectUntil({{ThatCreature}}, [AdjustPTX({{PTModX[0]}}, ManaValueOfTheCardRevealedThisWay)], UntilEndOfTurn), LoseLife(ManaValueOfTheCardRevealedThisWay)])",
    "draw cards equal to {{GameNumber(ThatCreature)}}": "ActionList([DrawNumberCards({{GameNumber(ThatCreature=^ThatCreature)[0]}})])",
    "each other nontoken creature you control becomes a copy of that creature": "ActionList([CreateEachPermanentLayerEffect(And([Other({{ThatCreature}}), IsNonToken, IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]), [IsACopyOfPermanent({{ThatCreature}}, NoCopyEffects)])])",
    "each {{Permanent}} deals {{Digits}} damage to that creature": "ActionList([EachPermanentDealsDamage({{Permanent[0]}}, {{Digits[0]}}, Permanent({{ThatCreature}}))])",
    "exile target {{Creature}} with greater power. {{Creatures}} gain protection from each of that creature's colors until end of turn": "Targeted([TargetPermanent(And([{{Creature[0]}}, PowerIs(GreaterThan(PowerOfPermanent({{ThatCreature}})))]))], ActionList([ExilePermanent(Ref_TargetPermanent), CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AddAbility([Protection(FromColor(ColorsOfPermanent(ThePermanentExiledThisWay)))])], UntilEndOfTurn)]))",
    "exile that creature": "ActionList([ExilePermanent({{ThatCreature}})])",
    "flip a coin until you lose a flip. For each flip you won, create a token that's a copy of that creature. Those tokens gain {{Hasable}}. Exile them at the beginning of the next end step": "ActionList([FlipACoinUntilLose, CreateTokens([NumberTokens(FlipACoinUntilLose_NumFlipsWon, TokenCopyOfPermanent({{ThatCreature}}, NoTokenCopyEffects))]), CreateEachPermanentLayerEffect(TheCreatedTokens, [AddAbility([{{Hasable[0]}}])]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([ExileEachPermanent(TheCreatedTokens)]))])",
    "flip a coin. If you win the flip, destroy that creature": "ActionList([FlipACoin_OnWin([DestroyPermanent({{ThatCreature}})])])",
    "flip a coin. If you win the flip, the next time that creature would deal combat damage this turn, it deals double that damage instead. If you lose the flip, the next time that creature would deal combat damage this turn, prevent that damage": "ActionList([FlipACoin_OnWinAndLose([CreateFutureReplaceWouldDealDamage(NextTimeCombatDamageWouldBeDealtThisTurnByCreature({{ThatCreature}}), [DealDamageInstead(Twice(WouldDealDamage_ThatMuchDamage))])], [CreateFuturePreventDamage(NextTimeCombatDamageWouldBeDealtThisTurnByCreature({{ThatCreature}}), [PreventThatDamage])])])",
    "gain control of that creature at end of combat": "ActionList([GainControlOfPermanentUntil({{ThatCreature}}, UntilEndOfCombat)])",
    "it and other {{Creatures}} that share a creature type with it each get {{PTMod}} and gain {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil(Or([SinglePermanent({{ThatCreature}}), And([{{Creatures[0]}}, SharesACreatureTypeWithPermanent({{ThatCreature}})])]), [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "it deals damage equal to {{GameNumber(ThatCreature)}} to any target": "Targeted([AnyTarget], ActionList([PermanentDealsDamage({{ThatCreature}}, {{GameNumber(ThatCreature=^ThatCreature)[0]}}, Ref_AnyTarget)]))",
    "it deals damage equal to {{GameNumber(ThatCreature)}} to each opponent": "ActionList([PermanentDealsDamage({{ThatCreature}}, {{GameNumber(ThatCreature=^ThatCreature)[0]}}, EachPlayer(Opponent))])",
    "it deals damage equal to {{GameNumber(ThatCreature)}} to each {{Creature}}": "ActionList([PermanentDealsDamage({{ThatCreature}}, {{GameNumber(ThatCreature=^ThatCreature)[0]}}, EachPermanent({{Creature[0]}}))])",
    "it deals damage equal to {{GameNumber(ThatCreature)}} to target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([PermanentDealsDamage({{ThatCreature}}, {{GameNumber(ThatCreature=^ThatCreature)[0]}}, Permanent(Ref_TargetPermanent))]))",
    "it deals damage equal to {{GameNumber(ThatCreature)}} to target {{PlayerOrPlaneswalker}}": "Targeted([TargetPlayerOrPermanent({{PlayerOrPlaneswalker[0]}})], ActionList([PermanentDealsDamage({{ThatCreature}}, {{GameNumber(ThatCreature=^ThatCreature)[0]}}, Ref_TargetPlayerOrPermanent)]))",
    "it deals damage equal to {{GameNumber(ThatCreature)}} to the player or planeswalker it's attacking": "ActionList([PermanentDealsDamage({{ThatCreature}}, {{GameNumber(ThatCreature=^ThatCreature)[0]}}, PlayerOrPlaneswalkerPermanentIsAttacking({{ThatCreature}}))])",
    "it deals damage equal to {{GameNumber(ThatCreature)}} to up to one other target {{Creature}}. Excess damage is dealt to that creature's controller instead": "Targeted([UptoOneTargetPermanent(And([Other({{ThatCreature}}), {{Creature[0]}}]))], ActionList([PermanentDealsDamageExcessReplacable({{ThatCreature}}, {{GameNumber(ThatCreature=^ThatCreature)[0]}}, Permanent(Ref_TargetPermanent), [WouldDealExcessDamage_DealExcessToPlayerInstead(ControllerOfPermanent(Ref_TargetPermanent))])]))",
    "it deals damage equal to {{GameNumber(ThatCreature)}} to up to one target {{Creature}}": "Targeted([UptoOneTargetPermanent({{Creature[0]}})], ActionList([PermanentDealsDamage({{ThatCreature}}, {{GameNumber(ThatCreature=^ThatCreature)[0]}}, Permanent(Ref_TargetPermanent))]))",
    "it deals {{Digits}} damage to each {{Creature}} blocking it": "ActionList([PermanentDealsDamage({{ThatCreature}}, {{Digits[0]}}, EachPermanent(And([{{Creature[0]}}, IsBlockingAttacker({{ThatCreature}})])))])",
    "it fights up to one target {{Creature}} with the same mana value": "Targeted([UptoOneTargetPermanent(And([{{Creature[0]}}, ManaValueIs(EqualTo(ManaValueOfPermanent({{ThatCreature}})))]))], ActionList([HaveCreaturesFight({{ThatCreature}}, Ref_TargetPermanent)]))",
    "it gains \"{{QuotedAbility[ThisCreature]}}\" until end of turn": "ActionList([CreatePermanentLayerEffectUntil({{ThatCreature}}, [AddAbility([{{QuotedAbility[ThisCreature][0]}}])], UntilEndOfTurn)])",
    "it gets {{PTMod}} until end of turn and deals {{Digits}} damage to each opponent": "ActionList([CreatePermanentLayerEffectUntil({{ThatCreature}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), PermanentDealsDamage({{ThatCreature}}, {{Digits[0]}}, EachPlayer(Opponent))])",
    "look at the top X cards of your library, where X is that creature's mana value. You may reveal a creature card that doesn't share a creature type with a creature you control from among those cards and put it into your hand. Put the rest on the bottom of your library in a random order": "ActionList([LookAtTheTopNumberCardsOfLibrary(ManaValueOfPermanent({{ThatCreature}}), [MayRevealACardOfTypeAndPutIntoHand(And([IsCardtype(Creature), SharesACreatureTypeWithPermanents(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))])), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "look at the top X cards of your library, where X is {{GameNumber(ThatCreature)}}. You may put a permanent card with mana value X or less from among them onto the battlefield. Put the rest on the bottom of your library in a random order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{GameNumber(ThatCreature=^ThatCreature)[0]}}, [MayPutACardOfTypeOntoTheBattlefield(And([IsPermanent, ManaValueIs(LessThanOrEqualTo({{GameNumber(ThatCreature=^ThatCreature)[0]}}))]), [EntersNormally]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "look at the top {{Number}} cards of your library. You may reveal a card that shares a creature type with that creature from among them and put it into your hand. Put the rest on the bottom of your library in a random order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [MayRevealACardOfTypeAndPutIntoHand(SharesACreatureTypeWithPermanent({{ThatCreature}})), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "put that creature on top of its owner's library": "ActionList([PutPermanentOnTopOfOwnersLibrary({{ThatCreature}})])",
    "put {{CounterType}} counters on that creature equal to its power": "ActionList([PutNumberCountersOfTypeOnPermanent(PowerOfPermanent({{ThatCreature}}), {{CounterType[0]}}, {{ThatCreature}})])",
    "put {{Number}} {{CounterType}} counters on that creature": "ActionList([PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[0]}}, {{ThatCreature}})])",
    "put {{a}} {{CounterType}} counter on that creature": "ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{ThatCreature}})])",
    "put {{a}} {{CounterType}} counter on that creature and create a Blood token": "ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{ThatCreature}}), CreateTokens([BloodToken])])",
    "put {{a}} {{CounterType}} counter on that creature and each other creature you control that shares a creature type with it": "ActionList([PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, Or([SinglePermanent({{ThatCreature}}), And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), SharesACreatureTypeWithPermanent({{ThatCreature}})])]))])",
    "put {{a}} {{CounterType}} counter on that creature and you gain {{Digits}} life": "ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{ThatCreature}}), GainLife({{Digits[0]}})])",
    "remove all {{CounterType}} counters from it and destroy it. That creature deals {{Digits}} damage to its controller": "ActionList([RemoveAllCountersOfTypeFromPermanent({{CounterType[0]}}, {{ThatCreature}}), DestroyPermanent({{ThatCreature}}), PermanentDealsDamage({{ThatCreature}}, {{Digits[0]}}, Player(ControllerOfPermanent({{ThatCreature}})))])",
    "remove {{a}} {{CounterType}} counter from that creature": "ActionList([RemoveACounterOfTypeFromPermanent({{CounterType[0]}}, {{ThatCreature}})])",
    "return that creature to its owner's hand": "ActionList([PutPermanentIntoItsOwnersHand({{ThatCreature}})])",
    "reveal cards from the top of your library until you reveal {{a}} {{SpecificCard}}. Put that card onto the battlefield attached to that creature, then put the rest on the bottom of your library in a random order": "ActionList([RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed({{SpecificCard[0]}}, [PutTheCardFoundThisWayOntoTheBattlefield([EntersAttachedToPermanent({{ThatCreature}})]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "reveal the top card of your library. If it's {{a}} {{SpecificCard}}, remove that creature from combat. Then put the revealed card on the bottom of your library": "ActionList([RevealTopCardOfLibrary, If(ACardWasRevealedThisWay({{SpecificCard[0]}}), [RemoveCreatureFromCombat({{ThatCreature}}), PutTopOfLibraryOnBottomOfLibrary])])",
    "roll a six-sided die. That creature gets {{PTModX}} until end of turn, where X is the result. Then if it has the greatest power or is tied for greatest power among creatures on the battlefield, draw a card": "ActionList([RollAD6, CreatePermanentLayerEffectUntil({{ThatCreature}}, [AdjustPTX({{PTModX[0]}}, TheDiceResult)], UntilEndOfTurn), If(PermanentPassesFilter({{ThatCreature}}, PowerIs(EqualTo(TheGreatestPowerAmongPermanents(IsCardtype(Creature))))), [DrawACard])])",
    "scry X, where X is {{GameNumber(ThatCreature)}}": "ActionList([CreateValueX({{GameNumber(ThatCreature=^ThatCreature)[0]}}), Scry(ValueX)])",
    "suspect that creature. It perpetually gains this ability": "ActionList([SuspectEachPermanent(SinglePermanent({{ThatCreature}})), CreatePerpetualPermanentEffect({{ThatCreature}}, [AddAbilityVariable(ThisAbility)])])",
    "tap that creature": "ActionList([TapPermanent({{ThatCreature}})])",
    "tap that creature and goad it. It gains {{Hasable}} until your next turn": "ActionList([TapPermanent({{ThatCreature}}), GoadCreature({{ThatCreature}}), CreatePermanentLayerEffectUntil({{ThatCreature}}, [AddAbility([{{Hasable[0]}}])], UntilPlayersNextTurn(You))])",
    "tap that creature and it doesn't untap during its controller's next untap step": "ActionList([TapPermanent({{ThatCreature}}), PermanentDoesntUntapDuringControllersNextUntap({{ThatCreature}})])",
    "tap that creature. It doesn't untap during its controller's next untap step": "ActionList([TapPermanent({{ThatCreature}}), PermanentDoesntUntapDuringControllersNextUntap({{ThatCreature}})])",
    "tap that creature. That creature doesn't untap during its controller's next untap step": "ActionList([TapPermanent({{ThatCreature}}), PermanentDoesntUntapDuringControllersNextUntap({{ThatCreature}})])",
    "that creature becomes {{Black}}": "ActionList([CreatePermanentLayerEffect({{ThatCreature}}, [AddColor(SimpleColorList([{{Black[0]}}]))])])",
    "that creature can't be regenerated this turn": "ActionList([CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [CantBeRegenerated], UntilEndOfTurn)])",
    "that creature deals X damage to target {{Creature}}, where X is a number chosen at random from 0 to 4": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([ChooseANumberBetweenAtRandom(Integer(0), Integer(4)), PermanentDealsDamage({{ThatCreature}}, TheChosenNumber, Permanent(Ref_TargetPermanent))]))",
    "that creature deals damage equal to {{GameNumber(ThatCreature)}} to any target": "Targeted([AnyTarget], ActionList([PermanentDealsDamage({{ThatCreature}}, {{GameNumber(ThatCreature=^ThatCreature)[0]}}, Ref_AnyTarget)]))",
    "that creature deals damage equal to {{GameNumber(ThatCreature)}} to each opponent": "ActionList([PermanentDealsDamage({{ThatCreature}}, {{GameNumber(ThatCreature=^ThatCreature)[0]}}, EachPlayer(Opponent))])",
    "that creature doesn't untap during its controller's next untap step": "ActionList([PermanentDoesntUntapDuringControllersNextUntap({{ThatCreature}})])",
    "that creature fights target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([Fight({{ThatCreature}}, Ref_TargetPermanent)]))",
    "that creature gains {{Hasable}} until end of turn": "ActionList([CreatePermanentLayerEffectUntil({{ThatCreature}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "that creature gets {{PTModX}} until end of turn, where X is half the creature's power, rounded down": "ActionList([CreatePermanentLayerEffectUntil({{ThatCreature}}, [AdjustPTX({{PTModX[0]}}, HalfRoundedDown(PowerOfPermanent({{ThatCreature}})))], UntilEndOfTurn)])",
    "that creature gets {{PTMod}} and gains {{Hasable}} until end of turn": "ActionList([CreatePermanentLayerEffectUntil({{ThatCreature}}, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "that creature gets {{PTMod}} until end of turn": "ActionList([CreatePermanentLayerEffectUntil({{ThatCreature}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])",
    "that creature loses all abilities until end of turn": "ActionList([CreatePermanentLayerEffectUntil({{ThatCreature}}, [LosesAllAbilities], UntilEndOfTurn)])",
    "that creature loses {{CheckHasable}} until end of turn": "ActionList([CreatePermanentLayerEffectUntil({{ThatCreature}}, [LosesAbility({{CheckHasable[0]}})], UntilEndOfTurn)])",
    "that creature perpetually gains {{PerpetualHasable}} if {{Condition(ThatPermanent)}}. If {{Condition(ThatPermanent)}}, you gain {{Digits}} life. If {{Condition(ThatPermanent)}}, seek {{a}} {{SpecificCard}}": "ActionList([If({{Condition(ThatPermanent=^ThatCreature)[0]}}, [CreatePerpetualPermanentEffect({{ThatCreature}}, [AddAbility([{{PerpetualHasable[0]}}])])]), If({{Condition(ThatPermanent=^ThatCreature)[1]}}, [GainLife({{Digits[0]}})]), If({{Condition(ThatPermanent=^ThatCreature)[2]}}, [SeekACard({{SpecificCard[0]}})])])",
    "that creature perpetually gets {{PTMod}}": "ActionList([CreatePerpetualPermanentEffect({{ThatCreature}}, [AdjustPT({{PTMod[0]}})])])",
    "that creature's controller creates {{a}} {{PT}} {{CreatureToken}}": "ActionList([PlayerAction(ControllerOfPermanent({{ThatCreature}}), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])]))])",
    "that creature's controller draws a card": "ActionList([PlayerAction(ControllerOfPermanent({{ThatCreature}}), DrawACard)])",
    "that creature's controller loses {{Digits}} life": "ActionList([PlayerAction(ControllerOfPermanent({{ThatCreature}}), LoseLife({{Digits[0]}}))])",
    "that creature's controller loses {{Digits}} life and you gain {{Digits}} life": "ActionList([PlayerAction(ControllerOfPermanent({{ThatCreature}}), LoseLife({{Digits[0]}})), GainLife({{Digits[1]}})])",
    "that creature's controller loses {{Digits}} life unless they pay {{ManaCost}}": "ActionList([PlayerMayCost(ControllerOfPermanent({{ThatCreature}}), PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [LoseLife({{Digits[0]}})])])",
    "that creature's controller may have it deal damage equal to {{GameNumber(ThatCreature)}} to any target of their choice": "Targeted([AnyTargetOfPlayersChoice(ControllerOfPermanent({{ThatCreature}}))], ActionList([PlayerMayAction(ControllerOfPermanent({{ThatCreature}}), HavePermanentDealDamage({{ThatCreature}}, {{GameNumber(ThatCreature=^ThatCreature)[0]}}, Ref_AnyTarget))]))",
    "that creature's controller may have target {{Creature}} of their choice get {{PTMod}} until end of turn": "Targeted([TargetPermanentOfPlayersChoice({{Creature[0]}}, ControllerOfPermanent({{ThatCreature}}))], ActionList([PlayerMayAction(ControllerOfPermanent({{ThatCreature}}), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn))]))",
    "that creature's controller mills {{Number}} cards": "ActionList([PlayerAction(ControllerOfPermanent({{ThatCreature}}), MillNumberCards({{Number[0]}}))])",
    "that creature's controller sacrifices it at end of combat. If the player does, they create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}}": "ActionList([CreateFutureTrigger(AtTheNextEndOfCombat, ActionList([PlayerMustCost(ControllerOfPermanent({{ThatCreature}}), SacrificePermanent({{ThatCreature}})), If(CostWasPaid, [CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])])])]))])",
    "that {{Zombie}} gets {{PTMod}} until end of turn for each {{Eachable(ThatPermanent)}}": "ActionList([CreatePermanentLayerEffectUntil({{ThatCreature}}, [AdjustPTForEach({{PTMod[0]}}, {{Eachable(ThatPermanent=^ThatCreature)[0]}})], UntilEndOfTurn)])",
    "untap it and it can't be blocked by creatures with greater power this combat": "ActionList([UntapPermanent({{ThatCreature}}), CreatePermanentRuleEffectUntil({{ThatCreature}}, [CantBeBlockedByDefenders(And([IsCardtype(Creature), PowerIs(GreaterThan(PowerOfPermanent({{ThatCreature}})))]))], UntilEndOfCombat)])",
    "untap that creature": "ActionList([UntapPermanent({{ThatCreature}})])",
    "untap that creature. After this phase, there is an additional combat phase": "ActionList([UntapPermanent({{ThatCreature}}), ThereIsAnAdditionalCombatPhase])",
    "up to one target {{Creature}} blocks it this combat if able": "Targeted([UptoOneTargetPermanent({{Creature[0]}})], ActionList([CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [MustBlockAttacker({{ThatCreature}})], UntilEndOfCombat)]))",
    "you gain life equal to {{GameNumber(ThatCreature)}}": "ActionList([GainLife({{GameNumber(ThatCreature=^ThatCreature)[0]}})])",
    "you gain {{Digits}} life and that creature fights up to one target {{Creature}}": "Targeted([UptoOneTargetPermanent({{Creature[0]}})], ActionList([GainLife({{Digits[0]}}), Fight({{ThatCreature}}, Ref_TargetPermanent)]))",
    "you gain {{Digits}} life unless that creature's controller pays {{ManaCost}}": "ActionList([PlayerMayCost(ControllerOfPermanent({{ThatCreature}}), PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [GainLife({{Digits[0]}})])])",
    "you may conjure a duplicate of that creature into the top {{Number}} cards of your library at random. The duplicate perpetually gets {{PTMod}} and gains {{PerpetualHasable}}": "ActionList([MayActions([ConjureDuplicateOfPermanentIntoTopNumberCardsOfPlayersLibraryAtRandom({{ThatCreature}}, {{Number[0]}}, You), CreatePerpetualCardInLibraryEffect(TheCardConjureIntoLibraryThisWay, [AdjustPT({{PTMod[0]}}), AddAbility([{{PerpetualHasable[0]}}])])])])",
    "you may create a token that's a copy of that creature. Exile that token at end of combat": "ActionList([MayCost(CreateTokens([TokenCopyOfPermanent({{ThatCreature}}, NoTokenCopyEffects)])), If(CostWasPaid, [CreateFutureTrigger(AtTheNextEndOfCombat, ActionList([ExilePermanent(TheCreatedToken)]))])])",
    "you may discard a card. If you do, put {{a}} {{CounterType}} counter on that creature, it gains {{Hasable}} until end of turn, and it becomes {{a}} {{Zombie}} in addition to its other types": "ActionList([MayCost(DiscardACard), If(CostWasPaid, [PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{ThatCreature}}), CreatePermanentLayerEffectUntil({{ThatCreature}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), CreatePermanentLayerEffect({{ThatCreature}}, [AddCreatureType({{Zombie[0]}})])])])",
    "you may gain life equal to {{GameNumber(ThatCreature)}}": "ActionList([MayAction(GainLife({{GameNumber(ThatCreature=^ThatCreature)[0]}}))])",
    "you may have it become {{a}} {{Black}} {{Zombie}} with base power and toughness {{PT}} in addition to its other colors and types until end of turn": "ActionList([MayAction(CreatePermanentLayerEffectUntil({{ThatCreature}}, [AddColor(SimpleColorList([{{Black[0]}}])), AddCreatureType({{Zombie[0]}}), SetPT({{PT[0]}})], UntilEndOfTurn))])",
    "you may have it deal damage equal to {{GameNumber(ThatCreature)}} to any target": "Targeted([AnyTarget], ActionList([MayAction(HavePermanentDealDamage({{ThatCreature}}, {{GameNumber(ThatCreature=^ThatCreature)[0]}}, Ref_AnyTarget))]))",
    "you may have it deal damage equal to {{GameNumber(ThatCreature)}} to you and any target": "Targeted([AnyTarget], ActionList([MayAction(HavePermanentDealDamage({{ThatCreature}}, {{GameNumber(ThatCreature=^ThatCreature)[0]}}, MultipleRecipients([Player(You), Ref_AnyTarget])))]))",
    "you may have that creature deal {{Digits}} damage to target {{PlayerOrPlaneswalker}}": "Targeted([TargetPlayerOrPermanent({{PlayerOrPlaneswalker[0]}})], ActionList([MayAction(HavePermanentDealDamage({{ThatCreature}}, {{Digits[0]}}, Ref_TargetPlayerOrPermanent))]))",
    "you may look at the top X cards of your library, where X is {{GameNumber(ThatCreature)}}. If you do, put one of those cards on top of your library and the rest on the bottom of your library in any order": "ActionList([MayAction(LookAtTheTopNumberCardsOfLibrary({{GameNumber(ThatCreature=^ThatCreature)[0]}}, [PutAGenericCardOnTopOfLibrary, PutTheRemainingCardsOnTopOfLibraryInAnyOrder]))])",
    "you may pay {{Energy}}. If you do, put your choice of {{a}} {{CounterType}}, {{CounterType}}, or {{CounterType}} counter on that creature": "ActionList([MayCost(PayEnergy(Integer({{Energy[0]}}))), If(CostWasPaid, [PutACounterOfChoiceOnPermanent([{{CounterType[0]}}, {{CounterType[1]}}, {{CounterType[2]}}], {{ThatCreature}})])])",
    "you may pay {{ManaCostX}}. When you do, put X {{CounterType}} counters on that creature": "ActionList([MayCost(PayManaAnyX({{ManaCostX[0]}})), If(CostWasPaid, [ReflexiveTrigger(ActionList([PutNumberCountersOfTypeOnPermanent(ValueX, {{CounterType[0]}}, {{ThatCreature}})]))])])",
    "you may pay {{ManaCostX}}. When you do, you may cast target instant or sorcery card with mana value X from a graveyard without paying its mana cost. If that spell would be put into a graveyard, exile it instead": "ActionList([MayCost(PayManaAnyX({{ManaCostX[0]}})), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetGraveyardCard(And([Or([IsCardtype(Instant), IsCardtype(Sorcery)]), ManaValueIs(EqualTo(ValueX))]))], ActionList([MayAction(CastGraveyardCardWithoutPayingIntoExile(Ref_TargetGraveyardCard))])))])])",
    "you may pay {{ManaCost}}. If you do, create a token that's a copy of that creature": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [CreateTokens([TokenCopyOfPermanent({{ThatCreature}}, NoTokenCopyEffects)])])])",
    "you may pay {{ManaCost}}. If you do, create a token that's a copy of that creature, except it has {{Hasable}} and \"{{QuotedAbility}}\"": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [CreateTokens([TokenCopyOfPermanent({{ThatCreature}}, TokenCopyEffects([AddAbility([{{Hasable[0]}}]), AddAbility([{{QuotedAbility[0]}}])]))])])])",
    "you may pay {{ManaCost}}. If you do, create a token that's a copy of that creature. That token gains {{Hasable}}. Exile it at the beginning of the next end step": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [CreateTokens([TokenCopyOfPermanent({{ThatCreature}}, NoTokenCopyEffects)]), CreatePermanentLayerEffect(TheCreatedToken, [AddAbility([{{Hasable[0]}}])]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([ExilePermanent(TheCreatedToken)]))])])",
    "you may pay {{ManaCost}}. If you do, create a token that's a copy of that {{Zombie}}. The token gains {{Hasable}}. Exile it at the beginning of the next end step": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [CreateTokens([TokenCopyOfPermanent({{ThatCreature}}, NoTokenCopyEffects)]), CreatePermanentLayerEffect(TheCreatedToken, [AddAbility([{{Hasable[0]}}])]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([ExilePermanent(TheCreatedToken)]))])])",
    "you may pay {{ManaCost}}. If you do, put {{a}} {{CounterType}} counter on that creature": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{ThatCreature}})])])",
    "you may pay {{ManaCost}}. If you do, that creature deals damage equal to {{GameNumber(ThatCreature)}} to any target": "Targeted([AnyTarget], ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [PermanentDealsDamage({{ThatCreature}}, {{GameNumber(ThatCreature=^ThatCreature)[0]}}, Ref_AnyTarget)])]))",
    "you may pay {{ManaCost}}. If you do, that creature gains {{Hasable}} until end of turn": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [CreatePermanentLayerEffectUntil({{ThatCreature}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])])",
    "you may pay {{ManaCost}}. If you do, that creature's controller creates a token that's a copy of that creature": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [PlayerAction(ControllerOfPermanent({{ThatCreature}}), CreateTokens([TokenCopyOfPermanent({{ThatCreature}}, NoTokenCopyEffects)]))])])",
    "you may pay {{ManaCost}}. If you do, you may put a creature card with mana value less than that creature's mana value from your hand onto the battlefield tapped and attacking": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [MayAction(PutACardFromHandOnBattlefield(And([IsCardtype(Creature), ManaValueIs(LessThan(ManaValueOfPermanent({{ThatCreature}})))]), [EntersTapped, EntersAttacking]))])])",
    "you may pay {{ManaCost}}. When you do, put {{a}} {{CounterType}} counter on that creature": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [ReflexiveTrigger(ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{ThatCreature}})]))])])",
    "you may pay {{ManaCost}}. When you do, that creature deals damage equal to {{GameNumber(ThatCreature)}} to target {{Creature}}": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPermanent({{Creature[0]}})], ActionList([PermanentDealsDamage({{ThatCreature}}, {{GameNumber(ThatCreature=^ThatCreature)[0]}}, Permanent(Ref_TargetPermanent))])))])])",
    "you may put a creature card with lesser power from your hand onto the battlefield tapped and attacking": "ActionList([MayAction(PutACardFromHandOnBattlefield(And([IsCardtype(Creature), PowerIs(LessThan(PowerOfPermanent({{ThatCreature}})))]), [EntersTapped, EntersAttacking]))])",
    "you may return {{a}} {{Land}} to its owner's hand. If you do, the creature gets {{PTMod}} until end of turn": "ActionList([MayCost(PutAPermanentIntoItsOwnersHand({{Land[0]}})), If(CostWasPaid, [CreatePermanentLayerEffectUntil({{ThatCreature}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])])",
    "you may sacrifice a creature that saddled it this turn. If you do, draw X cards, then put up to X {{SpecificCards}} from your hand onto the battlefield tapped, where X is the sacrificed creature's power": "ActionList([MayCost(SacrificeAPermanent(And([IsCardtype(Creature), SaddledPermanentThisTurn({{ThatCreature}})]))), If(CostWasPaid, [DrawNumberCards(PowerOfTheSacrificedCreature), PutUptoNumberCardsFromHandOntoBattlefield(PowerOfTheSacrificedCreature, {{SpecificCards[0]}}, [EntersTapped])])])",
    "you may sacrifice {{a}} {{Land}}. If you do, that creature gains {{Hasable}} until end of turn": "ActionList([MayCost(SacrificeAPermanent({{Land[0]}})), If(CostWasPaid, [CreatePermanentLayerEffectUntil({{ThatCreature}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])])",
    "you may sacrifice {{a}} {{Permanent}}. If you do, it gets {{PTMod}} until end of turn": "ActionList([MayCost(SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [CreatePermanentLayerEffectUntil({{ThatCreature}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])])",
    "you may search your library for a creature card with the same total power and toughness, put it onto the battlefield, then shuffle": "ActionList([MayAction(SearchLibrary([FindACardOfType(And([IsCardtype(Creature), SharesTotalPowerAndToughnessWithPermanent({{ThatCreature}})])), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle]))])",
    "you may search your library for an Aura card that could enchant that creature, put it onto the battlefield attached to that creature, then shuffle": "ActionList([MayAction(SearchLibrary([FindACardOfType(And([IsEnchantmentType(Aura), CanEnchantPermanent({{ThatCreature}})])), PutFoundCardsOntoBattlefield([EntersAttachedToPermanent({{ThatCreature}})]), Shuffle]))])",
    "you may untap that creature and remove it from combat": "ActionList([MayActions([UntapPermanent({{ThatCreature}}), RemoveCreatureFromCombat({{ThatCreature}})])])"
  },
  "{{TriggerActions(ThatCreature,DefendingPlayer)}}": {
    "defending player reveals cards from the top of their library until they reveal {{a}} {{SpecificCard}}. The creature gets {{PTMod}} until end of turn for each card revealed this way. That player puts the revealed cards into their graveyard": "ActionList([PlayerAction({{DefendingPlayer}}, RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed({{SpecificCard[0]}}, [PutTheRemainingCardsIntoGraveyard])), CreatePermanentLayerEffectUntil({{ThatCreature}}, [AdjustPTForEach({{PTMod[0]}}, NumLibraryCardsRevealedThisWay(AnyCard))], UntilEndOfTurn)])",
    "it deals {{Digits}} damage to target creature defending player controls": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByPlayer({{DefendingPlayer}})]))], ActionList([PermanentDealsDamage({{ThatCreature}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent))]))",
    "it fights target creature defending player controls": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByPlayer({{DefendingPlayer}})]))], ActionList([HaveCreaturesFight({{ThatCreature}}, Ref_TargetPermanent)]))",
    "it gets {{PTModX}} until end of turn, where X is the number of creature cards in defending player's graveyard": "ActionList([CreatePermanentLayerEffectUntil({{ThatCreature}}, [AdjustPTX({{PTModX[0]}}, TheNumberOfGraveyardCards(And([IsCardtype(Creature), InAPlayersGraveyard(SinglePlayer({{DefendingPlayer}}))])))], UntilEndOfTurn)])",
    "it gets {{PTModX}} until end of turn, where X is the number of lands defending player controls": "ActionList([CreatePermanentLayerEffectUntil({{ThatCreature}}, [AdjustPTX({{PTModX[0]}}, TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Land), ControlledByPlayer({{DefendingPlayer}})])))], UntilEndOfTurn)])",
    "it gets {{PTMod}} until end of turn for each Blood token defending player controls": "ActionList([CreatePermanentLayerEffectUntil({{ThatCreature}}, [AdjustPTForEach({{PTMod[0]}}, TheNumberOfPermanentsOnTheBattlefield(And([IsArtifactType(Blood), IsToken, ControlledByPlayer({{DefendingPlayer}})])))], UntilEndOfTurn)])",
    "it gets {{PTMod}} until end of turn for each land defending player controls": "ActionList([CreatePermanentLayerEffectUntil({{ThatCreature}}, [AdjustPTForEach({{PTMod[0]}}, TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Land), ControlledByPlayer({{DefendingPlayer}})])))], UntilEndOfTurn)])",
    "target creature defending player controls blocks it this combat if able": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByPlayer({{DefendingPlayer}})]))], ActionList([CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [MustBlockAttacker({{ThatCreature}})], UntilEndOfCombat)]))",
    "up to one target creature defending player controls blocks it this combat if able": "Targeted([UptoOneTargetPermanent(And([IsCardtype(Creature), ControlledByPlayer({{DefendingPlayer}})]))], ActionList([CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [MustBlockAttacker({{ThatCreature}})], UntilEndOfCombat)]))",
    "you may pay {{Energy}}. If you do, put {{a}} {{CounterType}} counter on it and tap up to one target {{Permanent(DefendingPlayer)}}": "Targeted([UptoOneTargetPermanent({{Permanent(DefendingPlayer=^DefendingPlayer)[0]}})], ActionList([MayCost(PayEnergy(Integer({{Energy[0]}}))), If(CostWasPaid, [PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{ThatCreature}}), TapPermanent(Ref_TargetPermanent)])]))",
    "you may sacrifice it. If you do, destroy target creature defending player controls. It can't be regenerated": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByPlayer({{DefendingPlayer}})]))], ActionList([MayCost(SacrificePermanent({{ThatCreature}})), If(CostWasPaid, [DestroyPermanentNoRegen(Ref_TargetPermanent)])]))"
  },
  "{{TriggerActions(ThatCreature,ThatMuch)}}": {
    "it connives X, where X is the amount of damage it dealt to that player": "ActionList([CreatureConnivesNumber({{ThatCreature}}, {{ThatMuch}})])",
    "put that many {{CounterType}} counters on that creature": "ActionList([PutNumberCountersOfTypeOnPermanent({{ThatMuch}}, {{CounterType[0]}}, {{ThatCreature}})])",
    "roll a d12. If the result is greater than the damage dealt or the result is {{Digits}}, double the number of {{CounterType}} counters on that creature": "ActionList([RollAD12, If(Or([DiceResultIs(GreaterThan({{ThatMuch}})), DiceResultIs(EqualTo({{Digits[0]}}))]), [DoubleCountersOfTypeOnPermanent({{CounterType[0]}}, {{ThatCreature}})])])",
    "that creature's controller loses that much life": "ActionList([PlayerAction(ControllerOfPermanent({{ThatCreature}}), LoseLife({{ThatMuch}}))])"
  },
  "{{TriggerActions(ThatEnchantment)}}": {
    "create {{a}} {{PT}} {{CreatureToken}}. If that enchantment is an Aura, you may attach it to the token": "ActionList([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])]), If(PermanentPassesFilter({{ThatEnchantment}}, IsEnchantmentType(Aura)), [MayAction(AttachPermanentToPermanent({{ThatEnchantment}}, TheCreatedToken))])])"
  },
  "{{TriggerActions(ThatMuch)}}": {
    "a random {{SpecificCard}} in your hand perpetually gets {{PTModX}}, where X is the amount of life you gained": "ActionList([ChooseACardInHandAtRandom({{SpecificCard[0]}}), CreatePerpetualCardInHandEffect(TheChosenCardInHand, [AdjustPTX({{PTModX[0]}}, {{ThatMuch}})])])",
    "add that much mana in any combination of {{ManaProduceSymbol}} and/or {{ManaProduceSymbol}}. Until end of turn, you don't lose this mana as steps and phases end": "ActionList([AddCombinationManaWithModifers(Or([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}]), {{ThatMuch}}, DontLoseAsStepsAndPhasesEnd(UntilEndOfTurn))])",
    "add that much {{ManaProduceSymbol}}. Until end of turn, you don't lose this mana as steps and phases end": "ActionList([AddManaRepeatedWithModifiers({{ManaProduceSymbol[0]}}, {{ThatMuch}}, DontLoseAsStepsAndPhasesEnd(UntilEndOfTurn))])",
    "add twice that much {{ManaProduceSymbol}}": "ActionList([AddManaRepeated({{ManaProduceSymbol[0]}}, Twice({{ThatMuch}}))])",
    "amass Orcs X, where X is that excess damage": "ActionList([Amass({{ThatMuch}}, Orc)])",
    "choose a suspended card you own and remove that many {{CounterType}} counters from it": "ActionList([RemoveNumberCountersOfTypeFromAnExiledCard({{ThatMuch}}, {{CounterType[0]}}, And([IsSuspended, OwnedByAPlayer(SinglePlayer(You))]))])",
    "create that many Blood tokens": "ActionList([CreateTokens([NumberTokens({{ThatMuch}}, BloodToken)])])",
    "create that many Treasure tokens": "ActionList([CreateTokens([NumberTokens({{ThatMuch}}, TreasureToken)])])",
    "create that many tapped Treasure tokens": "ActionList([CreateTokensWithFlags([NumberTokens({{ThatMuch}}, TreasureToken)], [EntersTapped])])",
    "create that many tapped {{PT}} {{CreatureTokens}}": "ActionList([CreateTokensWithFlags([NumberTokens({{ThatMuch}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))], [EntersTapped])])",
    "create that many {{PT}} {{CreatureTokens}}": "ActionList([CreateTokens([NumberTokens({{ThatMuch}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])])",
    "create that many {{PT}} {{CreatureTokens}} that are tapped and attacking": "ActionList([CreateTokensWithFlags([NumberTokens({{ThatMuch}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))], [EntersTapped, EntersAttacking])])",
    "create that many {{PT}} {{CreatureTokens}} with {{Hasable}}": "ActionList([CreateTokens([NumberTokens({{ThatMuch}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}]))])])",
    "create that many {{PT}} {{CreatureTokens}} with {{Hasable}} and {{Hasable}}": "ActionList([CreateTokens([NumberTokens({{ThatMuch}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}, {{Hasable[1]}}]))])])",
    "create that many {{PT}} {{CreatureTokens}}. They have \"{{TokenQuotedAbility}}\"": "ActionList([CreateTokens([NumberTokens({{ThatMuch}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{TokenQuotedAbility[0]}}]))])])",
    "discard that many cards": "ActionList([DiscardNumberCards({{ThatMuch}})])",
    "discard that many cards. Then if {{Condition}}, you lose the game": "ActionList([DiscardNumberCards({{ThatMuch}}), If({{Condition[0]}}, [LoseTheGame])])",
    "discover X, where X is that damage": "ActionList([Discover({{ThatMuch}})])",
    "draw a card, then you may cast a spell from your hand with mana value less than or equal to that damage without paying its mana cost": "ActionList([DrawACard, MayAction(CastASpellFromHandWithoutPaying(ManaValueIs(LessThanOrEqualTo({{ThatMuch}}))))])",
    "draw that many cards": "ActionList([DrawNumberCards({{ThatMuch}})])",
    "draw that many cards, then discard a card": "ActionList([DrawNumberCards({{ThatMuch}}), DiscardACard])",
    "draw that many cards, then discard that many cards. You gain that much life": "ActionList([DrawNumberCards({{ThatMuch}}), DiscardNumberCards({{ThatMuch}}), GainLife({{ThatMuch}})])",
    "draw that many cards, then you may put {{a}} {{SpecificCard}} from your hand onto the battlefield": "ActionList([DrawNumberCards({{ThatMuch}}), MayAction(PutACardFromHandOnBattlefield({{SpecificCard[0]}}, [EntersNormally]))])",
    "each opponent gains that much life": "ActionList([EachPlayerAction(Opponent, GainLife({{ThatMuch}}))])",
    "each opponent loses that much life and you gain that much life": "ActionList([EachPlayerAction(Opponent, LoseLife({{ThatMuch}})), GainLife({{ThatMuch}})])",
    "each {{Creature}} gains {{Hasable}} and gets {{PTModX}} until end of turn, where X is the amount of life you gained": "ActionList([CreateEachPermanentLayerEffectUntil({{Creature[0]}}, [AddAbility([{{Hasable[0]}}]), AdjustPTX({{PTModX[0]}}, {{ThatMuch}})], UntilEndOfTurn)])",
    "exile that many cards from the bottom of your library": "ActionList([ExileTheBottomNumberCardsOfLibrary({{ThatMuch}})])",
    "exile that many cards from the top of your library. Choose one of them. Until the end of your next turn, you may play that card": "ActionList([ExileTheTopNumberCardsOfLibrary({{ThatMuch}}), ChooseAnExiledCard(TheCardsExiledThisWay), CreatePlayerEffectUntil(You, [MayPlayExiledCard(TheChosenExiledCard)], UntilEndOfNextTurn(You))])",
    "exile that many cards from the top of your library. Until end of turn, you may cast spells from among those exiled cards": "ActionList([ExileTheTopNumberCardsOfLibrary({{ThatMuch}}), CreatePlayerEffectUntil(You, [MayCastSpellsFromAmongExiled(AnySpell, TheCardsExiledThisWay)], UntilEndOfTurn)])",
    "for each 1 life you lost, exile a permanent you control or a card from your hand or graveyard": "ActionList([ExileNumberPermanentsCardsFromHandOrCardsFromGraveyard({{ThatMuch}}, ControlledByAPlayer(SinglePlayer(You)), AnyCard, AnyCard)])",
    "investigate that many times": "ActionList([InvestigateTimes({{ThatMuch}})])",
    "look at that many cards from the top of your library. Exile up to one {{SpecificCard}} from among them and put the rest on the bottom of your library in a random order. You may cast the exiled card without paying its mana cost": "ActionList([LookAtTheTopNumberCardsOfLibrary({{ThatMuch}}, [MayExileACardOfType({{SpecificCard[0]}}), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder]), MayAction(CastExiledCardWithoutPaying(TheCardExiledThisWay))])",
    "look at that many cards from the top of your library. Put one of them into your hand and the rest into your graveyard": "ActionList([LookAtTheTopNumberCardsOfLibrary({{ThatMuch}}, [PutAGenericCardIntoHand, PutTheRemainingCardsIntoGraveyard])])",
    "look at that many cards from the top of your library. You may exile {{a}} {{SpecificCard}} from among them. Put the rest on the bottom of your library in a random order. You may cast the exiled card without paying its mana cost": "ActionList([LookAtTheTopNumberCardsOfLibrary({{ThatMuch}}, [MayExileACardOfType({{SpecificCard[0]}}), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder]), MayAction(CastExiledCardWithoutPaying(TheCardExiledThisWay))])",
    "look at that many cards from the top of your library. You may put one of them into your hand. Then put any number of land cards from among them onto the battlefield tapped and the rest into your graveyard": "ActionList([LookAtTheTopNumberCardsOfLibrary({{ThatMuch}}, [MayPutAGenericCardIntoHand, PutAnyNumberOfCardsOntoTheBattlefield(IsCardtype(Land), [EntersTapped]), PutTheRemainingCardsIntoGraveyard])])",
    "look at that many cards from the top of your library. You may reveal {{a}} {{SpecificCard}} from among them and put it into your hand. Put the rest on the bottom of your library in a random order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{ThatMuch}}, [MayRevealACardOfTypeAndPutIntoHand({{SpecificCard[0]}}), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "look at that many cards from the top of your library. You may reveal {{a}} {{SpecificCard}} or {{SpecificCard}} from among them and put it into your hand. Put the rest on the bottom of your library in a random order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{ThatMuch}}, [MayRevealACardOfTypeAndPutIntoHand(Or([{{SpecificCard[0]}}, {{SpecificCard[1]}}])), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "look at the top card of your library. You may play a land from the top of your library or cast a spell with mana value less than or equal to the damage dealt from the top of your library without paying its mana cost. If you don't, put that card into your hand": "ActionList([LookAtTopOfLibrary, MayCost(Or([PlayALandFromTopOfLibrary(IsCardtype(Land)), CastTopSpellOfLibraryWithoutPaying(ManaValueIs(LessThanOrEqualTo({{ThatMuch}})))])), Unless(CostWasPaid, [PutTopOfLibraryInHand])])",
    "put that many {{CounterType}} counters on target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutNumberCountersOfTypeOnPermanent({{ThatMuch}}, {{CounterType[0]}}, Ref_TargetPermanent)]))",
    "put {{a}} {{CounterType}} counter on each of up to X target {{Permanents}}, where X is the number of cards looked at while scrying this way": "Targeted([UptoNumberTargetPermanents({{ThatMuch}}, {{Permanents[0]}})], ActionList([PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, Ref_TargetPermanents)]))",
    "reveal that many cards from the top of your library. Put any number of {{SpecificCards}} from among them onto the battlefield and the rest on the bottom of your library in a random order": "ActionList([RevealTheTopNumberCardsOfLibrary({{ThatMuch}}, [MayPutAnyNumberOfCardsOfTypeOntoTheBattlefield({{SpecificCards[0]}}, [EntersNormally]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "reveal that many cards from the top of your library. You may put {{a}} {{SpecificCard}} and/or {{a}} {{SpecificCard}} from among them onto the battlefield. Put the rest on the bottom in a random order": "ActionList([RevealTheTopNumberCardsOfLibrary({{ThatMuch}}, [MayPutACardOfTypeOntoTheBattlefield({{SpecificCard[0]}}, [EntersNormally]), MayPutACardOfTypeOntoTheBattlefield({{SpecificCard[1]}}, [EntersNormally]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "sacrifice that many {{Permanents}}": "ActionList([SacrificeNumberPermanents({{ThatMuch}}, {{Permanents[0]}})])",
    "sacrifice that many {{Permanents}}. If you can't, you lose the game": "ActionList([MustCost(SacrificeNumberPermanents({{ThatMuch}}, {{Permanents[0]}})), Unless(CostWasPaid, [LoseTheGame])])",
    "sacrifice {{a}} {{Permanent}} for each 1 life you lost": "ActionList([SacrificeNumberPermanents({{ThatMuch}}, {{Permanent[0]}})])",
    "seek a card with mana value equal to that damage": "ActionList([SeekACard(ManaValueIs(EqualTo({{ThatMuch}})))])",
    "seek that many {{SpecificCards}}. At the beginning of your next end step, discard those cards": "ActionList([SeekNumberCards({{ThatMuch}}, {{SpecificCards[0]}}), CreateFutureTrigger(AtTheBeginningOfPlayersNextEndStep(You), ActionList([DiscardCards(TheCardsSeekedThisWay)]))])",
    "tap up to X target {{Permanents}}, where X is the number of cards looked at while scrying this way": "Targeted([UptoNumberTargetPermanents({{ThatMuch}}, {{Permanents[0]}})], ActionList([TapEachPermanent(Ref_TargetPermanents)]))",
    "target opponent loses that much life": "Targeted([TargetPlayer(Opponent)], ActionList([PlayerAction(Ref_TargetPlayer, LoseLife({{ThatMuch}}))]))",
    "target player mills that many cards": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, MillNumberCards({{ThatMuch}}))]))",
    "the next {{PotentialSpell}} you cast this turn costs {{CostReduceX}} less to cast, where X is the number of cards looked at while scrying this way": "ActionList([CreateFutureSpellEffect(TheNextSpellPlayerCastsThisTurn({{PotentialSpell[0]}}, You), [DecreaseManaCostX({{CostReduceX[0]}}, {{ThatMuch}})])])",
    "you draw that many cards": "ActionList([DrawNumberCards({{ThatMuch}})])",
    "you gain that much life": "ActionList([GainLife({{ThatMuch}})])",
    "you gain that much life and attacking player loses that much life": "ActionList([GainLife({{ThatMuch}}), PlayerAction(AttackingPlayer, LoseLife({{ThatMuch}}))])",
    "you gain twice that much life": "ActionList([GainLife(Twice({{ThatMuch}}))])",
    "you gain {{Digits}} life for each 1 life you lost": "ActionList([GainLifeForEach({{Digits[0]}}, {{ThatMuch}})])",
    "you get that many additional upkeep steps after this phase": "ActionList([ThereAreNumberAdditionalUpkeepSteps({{ThatMuch}})])",
    "you get that many {{EnergyCounters}}": "ActionList([GetEnergy({{ThatMuch}})])",
    "you lose that much life": "ActionList([LoseLife({{ThatMuch}})])",
    "you may cast {{a}} {{PotentialSpell}} from your hand with mana value less than or equal to that damage without paying its mana cost": "ActionList([MayAction(CastASpellFromHandWithoutPaying(And([{{PotentialSpell[0]}}, ManaValueIs(LessThanOrEqualTo({{ThatMuch}}))])))])",
    "you may create that many {{PT}} {{CreatureTokens}}": "ActionList([MayAction(CreateTokens([NumberTokens({{ThatMuch}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))]))])",
    "you may draw that many cards": "ActionList([MayAction(DrawNumberCards({{ThatMuch}}))])",
    "you may exile that many cards from the top of your library. You may play those cards this turn": "ActionList([MayActions([ExileTheTopNumberCardsOfLibrary({{ThatMuch}}), CreatePlayerEffectUntil(You, [MayPlayExiledCards(TheCardsExiledThisWay)], UntilEndOfTurn)])])",
    "you may mill that many cards. If you do, you may put {{a}} {{SpecificCard}} from among them into your hand": "ActionList([MayCost(MillNumberCards({{ThatMuch}})), If(CostWasPaid, [MayAction(PutACardOfTypeMilledThisWayIntoHand({{SpecificCard[0]}}))])])",
    "you may mill that many cards. Put any number of {{SpecificCards}} from among them onto the battlefield tapped": "ActionList([MayAction(MillNumberCards({{ThatMuch}})), PutAnyNumberOfCardsOfTypeMilledThisWayOntoTheBattlefield({{SpecificCards[0]}}, [EntersTapped])])",
    "you may pay {{ManaCostX}}, where X is less than or equal to the amount of life you gained. If you do, draw X cards": "ActionList([MayCost(PayManaAnyXRestricted({{ManaCostX[0]}}, LessThanOrEqualTo({{ThatMuch}}))), If(CostWasPaid, [DrawNumberCards(ValueX)])])",
    "you may pay {{ManaCost}}. If you do, put {{a}} {{CounterType}} counter on target {{Permanent}} for each 1 life you gained": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [PutNumberCountersOfTypeOnPermanent({{ThatMuch}}, {{CounterType[0]}}, Ref_TargetPermanent)])]))",
    "you may pay {{ManaCost}}. When you do, target creature gets {{PTModX}} until end of turn, where X is the amount of life you gained": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPermanent(IsCardtype(Creature))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTX({{PTModX[0]}}, {{ThatMuch}})], UntilEndOfTurn)])))])])",
    "you may put an artifact card with mana value less than or equal to that damage from your hand onto the battlefield": "ActionList([MayAction(PutACardFromHandOnBattlefield(And([IsCardtype(Artifact), ManaValueIs(LessThanOrEqualTo({{ThatMuch}}))]), [EntersNormally]))])",
    "you may put that many {{CounterType}} counters on target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([MayAction(PutNumberCountersOfTypeOnPermanent({{ThatMuch}}, {{CounterType[0]}}, Ref_TargetPermanent))]))",
    "you may reveal that many cards from the top of your library. Put {{a}} {{SpecificCard}} revealed this way into your hand and the rest into your graveyard": "ActionList([MayAction(RevealTheTopNumberCardsOfLibrary({{ThatMuch}}, [PutACardOfTypeIntoHand({{SpecificCard[0]}}), PutTheRemainingCardsIntoGraveyard]))])",
    "you mill that many cards. You may put {{a}} {{SpecificCard}} and/or {{a}} {{SpecificCard}} from among them onto the battlefield": "ActionList([MillNumberCards({{ThatMuch}}), MayAction(PutACardOfTypeAndOrACardOfTypeMilledThisWayOntoTheBattlefield([{{SpecificCard[0]}}, {{SpecificCard[1]}}], [EntersNormally]))])"
  },
  "{{TriggerActions(ThatMuch,ThatPlayer)}}": {
    "any number of target players each mill that many cards. Then you may collect evidence {{Digits}}. When you do, you may cast target {{SpecificCard}} from defending player's graveyard without paying its mana cost": "Targeted([AnyNumberOfTargetPlayers(AnyPlayer)], ActionList([EachPlayerAction(Ref_TargetPlayers, MillNumberCards({{ThatMuch}})), MayCost(CollectEvidence({{Digits[0]}})), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer({{ThatPlayer}}))]))], ActionList([MayAction(CastGraveyardCardWithoutPaying(Ref_TargetGraveyardCard))])))])]))",
    "return up to that many target permanents that player controls to their owner's hand": "Targeted([UptoNumberTargetPermanents({{ThatMuch}}, ControlledByAPlayer(SinglePlayer({{ThatPlayer}})))], ActionList([PutEachPermanentIntoItsOwnersHand(Ref_TargetPermanents)]))"
  },
  "{{TriggerActions(ThatPermanent)}}": {
    "airbend another target {{Permanent}}": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))], ActionList([AirbendPermanent(Ref_TargetPermanent)]))",
    "airbend up to one other target {{Permanent}}": "Targeted([UptoOneTargetPermanent(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))], ActionList([AirbendPermanent(Ref_TargetPermanent)]))",
    "all damage that would be dealt to it this turn is dealt to target {{Creature}} instead": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreateReplaceWouldDealDamageUntil(DamageWouldBeDealtToRecipient(Permanent({{ThatPermanent}})), [DealToCreatureOrPlaneswalkerInstead(Ref_TargetPermanent)], UntilEndOfTurn)]))",
    "all other {{Creatures}} get {{PTMod}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil(And([Other({{ThatPermanent}}), {{Creatures[0]}}]), [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])",
    "all other {{Creatures}} get {{PTMod}} until end of turn. Other {{Permanents}} gain {{Hasable}} until end of turn. Untap each other {{Permanent}}": "ActionList([CreateEachPermanentLayerEffectUntil(And([Other({{ThatPermanent}}), {{Creatures[0]}}]), [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), CreateEachPermanentLayerEffectUntil(And([Other({{ThatPermanent}}), {{Permanents[0]}}]), [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), UntapEachPermanent(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))])",
    "all {{Creatures}} banded with it gain {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil(And([{{Creatures[0]}}, BandedWith({{ThatPermanent}})]), [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "an opponent gains control of it": "ActionList([ChooseAPlayer(Opponent), PlayerAction(TheChosenPlayer, GainControlOfPermanent({{ThatPermanent}}))])",
    "another target creature attacking the same player or planeswalker gains {{Hasable}} until end of turn": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), IsCardtype(Creature), IsAttackingTheSamePlayerOrPlaneswalkerAsCreature({{ThatPermanent}})]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "another target {{Creature}} can't be blocked this turn": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), {{Creature[0]}}]))], ActionList([CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [CantBeBlocked], UntilEndOfTurn)]))",
    "another target {{Creature}} gains {{Hasable}} and gets {{PTModX}} until end of turn, where X is {{GameNumber(ThatCreature)}}": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), {{Creature[0]}}]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}]), AdjustPTX({{PTModX[0]}}, {{GameNumber(ThatCreature=Ref_TargetPermanent)[0]}})], UntilEndOfTurn)]))",
    "another target {{Creature}} gets {{PTModX}} until end of turn, where X is {{GameNumber}}": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), {{Creature[0]}}]))], ActionList([CreateValueX({{GameNumber[0]}}), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTX({{PTModX[0]}}, ValueX)], UntilEndOfTurn)]))",
    "another target {{Creature}} gets {{PTMod}} and gains {{Hasable}} and {{Hasable}} until end of turn": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), {{Creature[0]}}]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)]))",
    "another target {{Creature}} gets {{PTMod}} and gains {{Hasable}} until end of turn": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), {{Creature[0]}}]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "another target {{Creature}} gets {{PTMod}} and loses all abilities until end of turn": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), {{Creature[0]}}]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}}), LosesAllAbilities], UntilEndOfTurn)]))",
    "another target {{Creature}} gets {{PTMod}} until end of turn for each {{Eachable}}": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), {{Creature[0]}}]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTForEach({{PTMod[0]}}, {{Eachable[0]}})], UntilEndOfTurn)]))",
    "another target {{Creature}} gets {{PTMod}} until end of turn. Untap that creature": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), {{Creature[0]}}]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), UntapPermanent(Ref_TargetPermanent)]))",
    "another target {{Permanent}} gains {{Hasable}} and {{Hasable}} until end of turn": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)]))",
    "another target {{Permanent}} gains {{Hasable}} until end of turn": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "another target {{Permanent}} gets {{PTMod}} until end of turn": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)]))",
    "any number of other target {{Permanents}} phase out": "Targeted([AnyNumberOfTargetPermanents(And([Other({{ThatPermanent}}), {{Permanents[0]}}]))], ActionList([PhaseOutEachPermanent(Ref_TargetPermanents)]))",
    "at end of combat, destroy it and all {{Creatures}} it blocked this turn": "ActionList([CreateFutureTrigger(AtTheNextEndOfCombat, ActionList([DestroyEachPermanent(Or([SinglePermanent({{ThatPermanent}}), And([{{Creatures[0]}}, BlockedAttackerThisTurn({{ThatPermanent}})])]))]))])",
    "at end of combat, exile it and up to one creature that saddled it this turn, then return those cards to the battlefield under their owner's control": "ActionList([CreateFutureTrigger(AtTheEndOfThisCombat, ActionList([Exile([Permanent({{ThatPermanent}}), UptoOnePermanent(And([IsCardtype(Creature), SaddledPermanentThisTurn({{ThatPermanent}})]))]), PutEachExiledCardOntoTheBattlefield(TheCardsExiledThisWay, [EntersUnderOwnersControl])]))])",
    "at end of combat, sacrifice it and it deals {{Digits}} damage to you": "ActionList([CreateFutureTrigger(AtTheNextEndOfCombat, ActionList([SacrificePermanent({{ThatPermanent}}), PermanentDealsDamage({{ThatPermanent}}, {{Digits[0]}}, Player(You))]))])",
    "attach all {{Permanents}} on the battlefield to it": "ActionList([AttachEachPermanentToPermanent({{Permanents[0]}}, {{ThatPermanent}})])",
    "attach it to target {{Creature}}. If that creature is {{a}} {{Zombie}}, it gains {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([AttachPermanentToPermanent({{ThatPermanent}}, Ref_TargetPermanent), If(PermanentPassesFilter(Ref_TargetPermanent, IsCreatureType({{Zombie[0]}})), [CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])]))",
    "attach it to target {{Creature}}. That creature deals damage equal to its power to up to one target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}}), UptoOneTargetPermanent({{Creature[1]}})], ActionList([AttachPermanentToPermanent({{ThatPermanent}}, Ref_TargetPermanent1), PermanentDealsDamage(Ref_TargetPermanent1, PowerOfPermanent(Ref_TargetPermanent1), Permanent(Ref_TargetPermanent2))]))",
    "attach it to target {{Creature}}. That creature gains {{Hasable}} and {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([AttachPermanentToPermanent({{ThatPermanent}}, Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)]))",
    "attach it to target {{Creature}}. That creature gains {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([AttachPermanentToPermanent({{ThatPermanent}}, Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "attach it to target {{Creature}}. Untap that creature": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([AttachPermanentToPermanent({{ThatPermanent}}, Ref_TargetPermanent), UntapPermanent(Ref_TargetPermanent)]))",
    "attach it to target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([AttachPermanentToPermanent({{ThatPermanent}}, Ref_TargetPermanent)]))",
    "attach it to up to one target {{Permanent}}. Destroy up to one other target {{Permanent}}": "Targeted([UptoOneTargetPermanent({{Permanent[0]}}), UptoOneTargetPermanent(And([Other(Ref_TargetPermanent1), {{Permanent[1]}}]))], ActionList([AttachPermanentToPermanent({{ThatPermanent}}, Ref_TargetPermanent1), DestroyPermanent(Ref_TargetPermanent2)]))",
    "attach it to up to one target {{Permanent}}. Tap all creatures target opponent controls": "Targeted([UptoOneTargetPermanent({{Permanent[0]}}), TargetPlayer(Opponent)], ActionList([AttachPermanentToPermanent({{ThatPermanent}}, Ref_TargetPermanent), TapEachPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]))]))",
    "attach up to one target {{Artifact}} to that creature": "Targeted([UptoOneTargetPermanent({{Artifact[0]}})], ActionList([AttachPermanentToPermanent(Ref_TargetPermanent, {{ThatPermanent}})]))",
    "choose a nonlegendary creature that saddled it this turn and create a tapped and attacking token that's a copy of it. Sacrifice that token at the beginning of the next end step. Repeat this process once": "ActionList([RepeatableActionsNumTimes(Integer(2), [ChooseAPermanent(And([IsNonSupertype(Legendary), IsCardtype(Creature), SaddledPermanentThisTurn({{ThatPermanent}})])), CreateTokensWithFlags([TokenCopyOfPermanent(ThePermanentChosenThisWay, NoTokenCopyEffects)], [EntersTapped, EntersAttacking]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([SacrificeEachPermanent(TheTokensCreatedThisWay)])), RepeatThisProcess])])",
    "choose one -\n* Scry {{Digits}}.\n* You gain {{Digits}} life.\n* Exile another target creature you own. Return it to the battlefield under your control at the beginning of the next end step": "Modal_ChooseOne([ActionList([Scry({{Digits[0]}})]), ActionList([GainLife({{Digits[1]}})]), Targeted([TargetPermanent(And([Other({{ThatPermanent}}), IsCardtype(Creature), OwnedByAPlayer(SinglePlayer(You))]))], ActionList([ExilePermanent(Ref_TargetPermanent), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersUnderPlayersControl(You)])]))]))])",
    "choose one -\n* {{FlavorWord}} - {{TriggerActions_Modal(ThatPermanent)}}.\n* {{FlavorWord}} - {{TriggerActions_Modal}}.\n* {{FlavorWord}} - {{TriggerActions_Modal}}": "Modal_ChooseOne([{{TriggerActions_Modal(ThatPermanent=^ThatPermanent)[0]}}, {{TriggerActions_Modal[0]}}, {{TriggerActions_Modal[1]}}])",
    "choose one -\n* {{FlavorWord}} - {{TriggerActions_Modal}}.\n* {{FlavorWord}} - {{TriggerActions_Modal(ThatPermanent)}}.\n* {{FlavorWord}} - {{TriggerActions_Modal}}": "Modal_ChooseOne([{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal(ThatPermanent=^ThatPermanent)[0]}}, {{TriggerActions_Modal[1]}}])",
    "choose one -\n* {{TriggerActions_Modal(ThatPermanent)}}.\n* {{TriggerActions_Modal(ThatPermanent)}}": "Modal_ChooseOne([{{TriggerActions_Modal(ThatPermanent=^ThatPermanent)[0]}}, {{TriggerActions_Modal(ThatPermanent=^ThatPermanent)[1]}}])",
    "choose one -\n* {{TriggerActions_Modal(ThatPermanent)}}.\n* {{TriggerActions_Modal(ThatPermanent)}}.\n* {{TriggerActions_Modal(ThatPermanent)}}": "Modal_ChooseOne([{{TriggerActions_Modal(ThatPermanent=^ThatPermanent)[0]}}, {{TriggerActions_Modal(ThatPermanent=^ThatPermanent)[1]}}, {{TriggerActions_Modal(ThatPermanent=^ThatPermanent)[2]}}])",
    "choose one -\n* {{TriggerActions_Modal(ThatPermanent)}}.\n* {{TriggerActions_Modal}}": "Modal_ChooseOne([{{TriggerActions_Modal(ThatPermanent=^ThatPermanent)[0]}}, {{TriggerActions_Modal[0]}}])",
    "choose one -\n* {{TriggerActions_Modal(ThatPermanent)}}.\n* {{TriggerActions_Modal}}. {{Reminder}}\n* {{TriggerActions_Modal}}": "Modal_ChooseOne([{{TriggerActions_Modal(ThatPermanent=^ThatPermanent)[0]}}, {{TriggerActions_Modal[0]}}, {{TriggerActions_Modal[1]}}])",
    "choose one -\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal(ThatPermanent)}}": "Modal_ChooseOne([{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal(ThatPermanent=^ThatPermanent)[0]}}])",
    "choose one -\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal(ThatPermanent)}}.\n* {{TriggerActions_Modal}}": "Modal_ChooseOne([{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal(ThatPermanent=^ThatPermanent)[0]}}, {{TriggerActions_Modal[1]}}])",
    "choose up to one -\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal(ThatPermanent)}}": "Modal_ChooseOne([{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal(ThatPermanent=^ThatPermanent)[0]}}])",
