  "{{TriggerActions_Modal(ThatPermanent)}}": {
    "Airbend another target {{Permanent}}": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))], ActionList([AirbendPermanent(Ref_TargetPermanent)]))",
    "Another target {{Creature}} fights target {{Creature}}": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), {{Creature[0]}}])), TargetPermanent({{Creature[0]}})], ActionList([HaveCreaturesFight(Ref_TargetPermanent1, Ref_TargetPermanent2)]))",
    "Create a Monster Role token attached to that creature": "ActionList([CreateTokensWithFlags([MonsterRoleToken], [EntersAttachedToPermanent({{ThatPermanent}})])])",
    "Create a Royal Role token attached to that creature": "ActionList([CreateTokensWithFlags([RoyalRoleToken], [EntersAttachedToPermanent({{ThatPermanent}})])])",
    "Create a Sorcerer Role token attached to that creature": "ActionList([CreateTokensWithFlags([SorcererRoleToken], [EntersAttachedToPermanent({{ThatPermanent}})])])",
    "Destroy another target {{Permanent}}. Its controller draws a card": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([DestroyPermanent(Ref_TargetPermanent), PlayerAction(ControllerOfDestroyedPermanent, DrawACard)]))",
    "Exile another target creature you control. Return that card to the battlefield under its owner's control at the beginning of the next end step": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))], ActionList([ExilePermanent(Ref_TargetPermanent), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersUnderOwnersControl])]))]))",
    "It fights target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([HaveCreaturesFight({{ThatPermanent}}, Ref_TargetPermanent)]))",
    "It gains {{Hasable}} and {{Hasable}} until end of turn": "ActionList([CreatePermanentLayerEffectUntil({{ThatPermanent}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)])",
