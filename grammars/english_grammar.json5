    "Enchanted creature gets {{PTMod}} and can't be blocked by {{Creatures}}": "PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}})]), PermanentRuleEffect(HostPermanent, [CantBeBlockedByDefenders({{Creatures[0]}})])",
    "Enchanted creature gets {{PTMod}} and can't be blocked except by {{Creatures}}": "PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}})]), PermanentRuleEffect(HostPermanent, [CantBeBlockedExceptByDefenders({{Creatures[0]}})])",
    "Enchanted creature gets {{PTMod}} and can't be blocked unless it's attacking its owner or a permanent its owner controls": "PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}})]), Unless(PermanentPassesFilter(HostPermanent, Or([IsAttackingAPlayer(SinglePlayer(OwnerOfPermanent(HostPermanent))), IsAttackingAPermanent(ControlledByAPlayer(SinglePlayer(OwnerOfPermanent(HostPermanent))))])), [PermanentRuleEffect(HostPermanent, [CantBeBlocked])])",
    "Enchanted creature gets {{PTMod}} and can't be the target of {{PotentialSpells}}": "PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}})]), PermanentRuleEffect(HostPermanent, [CantBeTheTargetOfSpells({{PotentialSpells[0]}})])",
    "Enchanted creature gets {{PTMod}} and can't become suspected": "PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}})]), PermanentRuleEffect(HostPermanent, [CantBecomeSuspected])",
