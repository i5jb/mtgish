    "{{ManaCost}}, {{ExileSelfGraveyardCost}}: {{ActivatedActions}}. {{ActivateModifiers}}": "FromGraveyard(ActivatedWithModifiers(And([PayMana({{ManaCost[0]}}), {{ExileSelfGraveyardCost[0]}}]), {{ActivatedActions[0]}}, {{ActivateModifiers[0]}}))",
    "{{ManaCost}}, {{MillNumberCardsCost}}: {{ActivatedActions(~GraveyardCard)}}. {{ActivateModifiers}}": "FromGraveyard(ActivatedWithModifiers(And([PayMana({{ManaCost[0]}}), {{MillNumberCardsCost[0]}}]), {{ActivatedActions(~GraveyardCard=^~GraveyardCard)[0]}}, {{ActivateModifiers[0]}}))",
    "{{ManaCost}}, {{ReturnPermanentToHandCost}}: {{ActivatedActions(~GraveyardCard)}}": "FromGraveyard(Activated(And([PayMana({{ManaCost[0]}}), {{ReturnPermanentToHandCost[0]}}]), {{ActivatedActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
