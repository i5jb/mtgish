    "secretly choose a card in your graveyard and conjure a duplicate of it into your hand. If the duplicate isn't a land card, it perpetually gains flash": "ActionList([SecretlyChooseAGraveyardCard(InAPlayersGraveyard(SinglePlayer(You))), ConjureDuplicateOfGraveyardCardIntoHand(TheGraveyardCardChosenThisWay), If(TheCardInHandPassesFilter(TheCardConjuredThisWay, IsNonCardtype(Land)), [CreatePerpetualCardInHandEffect(TheCardConjuredIntoHandThisWay, [AddAbility([Flash])])])])",
    "secretly choose land or nonland. Seek {{Number}} cards of the chosen kind": "ActionList([SecretlyChooseLibraryFilter([IsCardtype(Land), IsNonCardtype(Land)]), SeekNumberCards({{Number[0]}}, TheChosenLibraryFilter)])",
    "seek a card with the highest mana value among cards in your library with mana value less than or equal to {{GameNumber}}": "ActionList([SeekACard(ManaValueIs(EqualTo(MinimumOf(TheHighestManaValueAmongCardsInPlayersLibrary(AnyCard, You), {{GameNumber[0]}}))))])",
    "seek two {{SpecificCards}}. Put one of them onto the battlefield and shuffle the other into your library": "ActionList([SeekNumberCards(Integer(2), {{SpecificCards[0]}}), PutACardFromHandOnBattlefield(TheCardsSeekedThisWay, [EntersNormally]), ShuffleCardsFromHandIntoLibrary(TheCardsSeekedThisWay)])",
    "seek {{Number}} {{SpecificCards}} and put them onto the battlefield": "ActionList([SeekNumberCards({{Number[0]}}, {{SpecificCards[0]}}), PutCardsFromHandOnBattlefield(TheCardsSeekedThisWay, [EntersNormally])])",
    "seek {{Number}} {{SpecificCards}} and put them into your graveyard": "ActionList([SeekNumberCards({{Number[0]}}, {{SpecificCards[0]}}), PutCardsInHandIntoGraveyard(TheCardsSeekedThisWay)])",
    "seek {{Number}} {{SpecificCards}}, then discard a card": "ActionList([SeekNumberCards({{Number[0]}}, {{SpecificCards[0]}}), DiscardACard])",
