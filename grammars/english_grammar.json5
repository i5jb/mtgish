    "This creature can't block": "PermanentRuleEffect(ThisPermanent, [CantBlock])",
    "This creature doesn't untap during your untap step if it has {{a}} {{CounterType}} counter on it": "If(PermanentPassesFilter(ThisPermanent, HasACounterOfType({{CounterType[0]}})), [PermanentRuleEffect(ThisPermanent, [DoesntUntapDuringControllersUntap])])",
    "This creature enters with an additional {{CounterType}} counter on it": "AsPermanentEnters(ThisPermanent, [EntersWithACounter({{CounterType[0]}})])",
