    "Whenever this creature deals damage, {{TriggerActions(ThatPermanent,ThatMuch)}}": "TriggerA(WhenAPermanentDealsDamage(SinglePermanent(ThisPermanent)), {{TriggerActions(ThatPermanent=Trigger_ThatPermanent,ThatMuch=Trigger_ThatMuch)[0]}})",
    "Whenever this creature is dealt damage, it deals that much damage to target player or planeswalker": "TriggerA(WhenAPermanentIsDealtDamage(SinglePermanent(ThisPermanent)), Targeted([TargetPlayerOrPermanent(AnyPlayer, IsCardtype(Planeswalker))], ActionList([PermanentDealsDamage(ThisPermanent, Trigger_ThatMuch, Ref_TargetPlayerOrPermanent)])))",
    "Whenever this creature is dealt damage, put that many {{CounterType}} counters on it": "TriggerA(WhenAPermanentIsDealtDamage(SinglePermanent(ThisPermanent)), ActionList([PutNumberCountersOfTypeOnPermanent(Trigger_ThatMuch, {{CounterType[0]}}, Trigger_ThatPermanent)]))",
    "Whenever this creature is dealt damage, put {{a}} {{CounterType}} counter on it": "TriggerA(WhenAPermanentIsDealtDamage(SinglePermanent(ThisPermanent)), ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Trigger_ThatPermanent)]))",
    "Whenever this creature is dealt damage, sacrifice that many permanents": "TriggerA(WhenAPermanentIsDealtDamage(SinglePermanent(ThisPermanent)), ActionList([SacrificeNumberPermanents(Trigger_ThatMuch, AnyPermanent)]))",
    "Whenever this creature is dealt damage, you draw that many cards and lose that much life": "TriggerA(WhenAPermanentIsDealtDamage(SinglePermanent(ThisPermanent)), ActionList([DrawNumberCards(Trigger_ThatMuch), LoseLife(Trigger_ThatMuch)]))",
    "Whenever this creature or another creature with the same name deals combat damage to a player, {{TriggerActions}}": "TriggerA(Or([WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(ThisPermanent), AnyPlayer), WhenACreatureDealsCombatDamageToAPlayer(And([Other(ThisPermanent), IsCardtype(Creature), SharesANameWithPermanent(ThisPermanent)]), AnyPlayer)]), {{TriggerActions[0]}})",
    "Whenever you cast a spell that shares a creature type with this creature, {{TriggerActions}}. This ability triggers only once each turn": "TriggerOnceEachTurn(WhenAPlayerCastsASpell(SinglePlayer(You), SharesACreatureTypeWithPermanent(ThisPermanent)), {{TriggerActions[0]}})",
    "Whenever you cast {{a}} {{Spell}} and whenever you draw your third card each turn, put {{a}} {{CounterType}} counter on this creature": "TriggerA(Or([WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), WhenAPlayerDrawsTheirNthCardEachTurn(SinglePlayer(You), EqualTo(Integer(3)))]), ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, ThisPermanent)]))",
    "Whenever you cast {{a}} {{Spell}} from exile, this creature deals damage equal to that spell's mana value to target opponent": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), And([{{Spell[0]}}, WasCastFromExile])), Targeted([TargetPlayer(Opponent)], ActionList([PermanentDealsDamage(ThisPermanent, ManaValueOfSpell(Trigger_ThatSpell), Player(Ref_TargetPlayer))])))",
    "Whenever you cast {{a}} {{Spell}}, this creature deals {{Digits}} damage to each opponent": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), ActionList([PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, EachPlayer(Opponent))]))",
    "Whenever you cast {{a}} {{Spell}}, this creature gets {{PTModX}} until end of turn, where X is the amount of generic mana in that spell's mana cost": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), ActionList([CreateValueX(AmountOfGenericManaInSpellsManaCost(Trigger_ThatSpell)), CreatePermanentLayerEffectUntil(ThisPermanent, [AdjustPTX({{PTModX[0]}}, ValueX)], UntilEndOfTurn)]))",
    "Whenever you cast {{a}} {{Spell}}, this creature gets {{PTMod}} until end of turn": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), ActionList([CreatePermanentLayerEffectUntil(ThisPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)]))",
    "Whenever you draw a card, this creature gets {{PTMod}} and gains {{Hasable}} until end of turn": "TriggerA(WhenAPlayerDrawsACard(SinglePlayer(You)), ActionList([CreatePermanentLayerEffectUntil(ThisPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Whenever you gain life, put that many {{CounterType}} counters on this creature": "TriggerA(WhenAPlayerGainsLife(SinglePlayer(You)), ActionList([PutNumberCountersOfTypeOnPermanent(Trigger_ThatMuch, {{CounterType[0]}}, ThisPermanent)]))",
    "Whenever you gain life, this creature gets {{PTModX}} until end of turn, where X is the amount of life you gained": "TriggerA(WhenAPlayerGainsLife(SinglePlayer(You)), ActionList([CreatePermanentLayerEffectUntil(ThisPermanent, [AdjustPTX({{PTModX[0]}}, Trigger_AmountOfLifeGained)], UntilEndOfTurn)]))",
    "Whenever {{a}} {{Creature}} blocks or becomes blocked by this creature, destroy that creature": "TriggerA(Or([WhenACreatureBlocksACreature({{Creature[0]}}, SinglePermanent(ThisPermanent)), WhenACreatureBecomesBlockedByACreature({{Creature[0]}}, SinglePermanent(ThisPermanent))]), ActionList([DestroyPermanent(Trigger_ThatCreature)]))",
    "Whenever {{a}} {{Creature}} dies, untap this creature": "TriggerA(WhenACreatureOrPlaneswalkerDies({{Creature[0]}}), ActionList([UntapPermanent(ThisPermanent)]))",
    "Whenever {{a}} {{Permanent}} enters, this creature gets {{PTMod}} until end of turn": "TriggerA(WhenAPermanentEntersTheBattlefield({{Permanent[0]}}), ActionList([CreatePermanentLayerEffectUntil(ThisPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)]))",
    "You may have this creature assign its combat damage as though it weren't blocked": "PermanentRuleEffect(ThisPermanent, [MayAssignCombatDamageAsThoughNotBlocked])",
    "{{ManaCostX}}: This creature gets {{PTModX}} until end of turn": "Activated(PayManaX({{ManaCostX[0]}}, ValueX), ActionList([CreatePermanentLayerEffectUntil(ThisPermanent, [AdjustPTX({{PTModX[0]}}, ValueX)], UntilEndOfTurn)]))",
    "{{ManaCostX}}: This creature has base power and toughness {{PTX}}": "Activated(PayManaX({{ManaCostX[0]}}, ValueX), ActionList([CreatePermanentLayerEffect(ThisPermanent, [SetPT(PTX({{PTX[0]}}, ValueX))])]))",
    "{{ManaCost}}, Discard a card: Untap this creature": "Activated(And([PayMana({{ManaCost[0]}}), DiscardACard]), ActionList([UntapPermanent(ThisPermanent)]))",
    "{{ManaCost}}, Put {{a}} {{CounterType}} counter on this creature: Untap this creature": "Activated(And([PayMana({{ManaCost[0]}}), PutACounterOfTypeOnPermanent({{CounterType[0]}}, ThisPermanent)]), ActionList([UntapPermanent(ThisPermanent)]))",
    "{{ManaCost}}, Sacrifice a permanent: This creature gains {{Hasable}} until end of turn": "Activated(And([PayMana({{ManaCost[0]}}), SacrificeAPermanent(AnyPermanent)]), ActionList([CreatePermanentLayerEffectUntil(ThisPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "{{ManaCost}}, Sacrifice this creature: Draw a card": "Activated(And([PayMana({{ManaCost[0]}}), SacrificePermanent(ThisPermanent)]), ActionList([DrawACard]))",
    "{{ManaCost}}, Sacrifice this creature: It deals X damage divided as you choose among any number of target {{Creatures}}, where X is its power": "Activated(And([PayMana({{ManaCost[0]}}), SacrificePermanent(ThisPermanent)]), TargetedDistributed([AnyNumberOfTargetPermanents({{Creatures[0]}})], DistributeNumberAmongTargets(PowerOfTheSacrificedCreature), ActionList([SacrificedPermanentDealsDistributedDamage])))",
    "{{ManaCost}}, Sacrifice this creature: It deals damage equal to its power to any target": "Activated(And([PayMana({{ManaCost[0]}}), SacrificePermanent(ThisPermanent)]), Targeted([AnyTarget], ActionList([PermanentDealsDamage(ThePermanentSacrificedThisWay, PowerOfTheSacrificedCreature, Ref_AnyTarget)])))",
    "{{ManaCost}}, Sacrifice this creature: You gain {{Digits}} life": "Activated(And([PayMana({{ManaCost[0]}}), SacrificePermanent(ThisPermanent)]), ActionList([GainLife({{Digits[0]}})]))",
    "{{ManaCost}}, {{SacrificeAPermanentCost(ThatPermanent)}}: This creature deals {{Digits}} damage to any target": "Activated(And([PayMana({{ManaCost[0]}}), {{SacrificeAPermanentCost(ThatPermanent=ThisPermanent)[0]}}]), Targeted([AnyTarget], ActionList([PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, Ref_AnyTarget)])))",
    "{{ManaCost}}, {{SacrificeAPermanentCost}}: Put {{a}} {{CounterType}} counter on this creature and draw a card": "Activated(And([PayMana({{ManaCost[0]}}), {{SacrificeAPermanentCost[0]}}]), ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, ThisPermanent), DrawACard]))",
    "{{ManaCost}}, {{TapSelfCost}}: Destroy target creature with the same name as this creature": "Activated(And([PayMana({{ManaCost[0]}}), {{TapSelfCost[0]}}]), Targeted([TargetPermanent(And([IsCardtype(Creature), SharesANameWithPermanent(ThisPermanent)]))], ActionList([DestroyPermanent(Ref_TargetPermanent)])))",
    "{{ManaCost}}, {{TapSelfCost}}: Other {{Creatures}} gain {{Hasable}} and get {{PTModX}} until end of turn, where X is this creature's power": "Activated(And([PayMana({{ManaCost[0]}}), {{TapSelfCost[0]}}]), ActionList([CreateEachPermanentLayerEffectUntil(And([Other(ThisPermanent), {{Creatures[0]}}]), [AddAbility([{{Hasable[0]}}]), AdjustPTX({{PTModX[0]}}, PowerOfPermanent(ThisPermanent))], UntilEndOfTurn)]))",
    "{{ManaCost}}, {{TapSelfCost}}: This creature deals {{Digits}} damage to any target": "Activated(And([PayMana({{ManaCost[0]}}), {{TapSelfCost[0]}}]), Targeted([AnyTarget], ActionList([PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, Ref_AnyTarget)])))",
    "{{ManaCost}}, {{TapSelfCost}}: This creature deals {{Digits}} damage to target {{Creature}}. If {{a}} {{Creature}} is dealt damage this way, tap it": "Activated(And([PayMana({{ManaCost[0]}}), {{TapSelfCost[0]}}]), Targeted([TargetPermanent({{Creature[0]}})], ActionList([PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, Permanent(Ref_TargetPermanent)), If(PermanentDealtDamageToACreatureOrPlaneswalkerThisWay(ThisPermanent, {{Creature[1]}}), [TapPermanent(Ref_TargetPermanent)])])))",
    "{{ManaCost}}, {{TapSelfCost}}: This creature gets {{PTMod}} until end of turn": "Activated(And([PayMana({{ManaCost[0]}}), {{TapSelfCost[0]}}]), ActionList([CreatePermanentLayerEffectUntil(ThisPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)]))",
    "{{ManaCost}}: Double the number of {{CounterType}} counters on this creature": "Activated(PayMana({{ManaCost[0]}}), ActionList([DoubleCountersOfTypeOnPermanent({{CounterType[0]}}, ThisPermanent)]))",
    "{{ManaCost}}: Exile this creature, then return it to the battlefield under your control": "Activated(PayMana({{ManaCost[0]}}), ActionList([ExilePermanent(ThisPermanent), PutExiledCardOntoBattlefield(TheExiledCard, [EntersUnderPlayersControl(You)])]))",
    "{{ManaCost}}: Regenerate this creature": "Activated(PayMana({{ManaCost[0]}}), ActionList([RegeneratePermanent(ThisPermanent)]))",
    "{{ManaCost}}: Remove {{a}} {{CounterType}} counter from this creature": "Activated(PayMana({{ManaCost[0]}}), ActionList([RemoveACounterOfTypeFromPermanent({{CounterType[0]}}, ThisPermanent)]))",
    "{{ManaCost}}: Return this creature to its owner's hand": "Activated(PayMana({{ManaCost[0]}}), ActionList([PutPermanentIntoItsOwnersHand(ThisPermanent)]))",
    "{{ManaCost}}: Switch this creature's power and toughness until end of turn": "Activated(PayMana({{ManaCost[0]}}), ActionList([CreatePermanentLayerEffectUntil(ThisPermanent, [SwitchPT], UntilEndOfTurn)]))",
    "{{ManaCost}}: Target {{Creature}} can't block this creature this turn": "Activated(PayMana({{ManaCost[0]}}), Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [CantBlockAttacker(ThisPermanent)], UntilEndOfTurn)])))",
    "{{ManaCost}}: This creature becomes a copy of another target {{Creature}}": "Activated(PayMana({{ManaCost[0]}}), Targeted([TargetPermanent(And([Other(ThisPermanent), {{Creature[0]}}]))], ActionList([CreatePermanentLayerEffect(ThisPermanent, [IsACopyOfPermanent(Ref_TargetPermanent, NoCopyEffects)])])))",
    "{{ManaCost}}: This creature can't be blocked this turn except by {{Creatures}}": "Activated(PayMana({{ManaCost[0]}}), ActionList([CreatePermanentRuleEffectUntil(ThisPermanent, [CantBeBlockedExceptByDefenders({{Creatures[0]}})], UntilEndOfTurn)]))",
    "{{ManaCost}}: This creature deals {{Digits}} damage to target creature that's blocking it": "Activated(PayMana({{ManaCost[0]}}), Targeted([TargetPermanent(And([IsCardtype(Creature), IsBlockingAttacker(ThisPermanent)]))], ActionList([PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, Permanent(Ref_TargetPermanent))])))",
    "{{ManaCost}}: This creature fights target {{Creature}}": "Activated(PayMana({{ManaCost[0]}}), Targeted([TargetPermanent({{Creature[0]}})], ActionList([HaveCreaturesFight(ThisPermanent, Ref_TargetPermanent)])))",
    "{{ManaCost}}: This creature gains {{Hasable}} until end of turn": "Activated(PayMana({{ManaCost[0]}}), ActionList([CreatePermanentLayerEffectUntil(ThisPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "{{ManaCost}}: This creature gains {{Hasable}} until end of turn. Activate only as a sorcery": "ActivatedWithModifiers(PayMana({{ManaCost[0]}}), ActionList([CreatePermanentLayerEffectUntil(ThisPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]), ActivateOnlyAsASorcery)",
    "{{ManaCost}}: This creature gets {{PTMod}} until end of turn": "Activated(PayMana({{ManaCost[0]}}), ActionList([CreatePermanentLayerEffectUntil(ThisPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)]))",
    "{{ManaCost}}: Turn this creature face up": "Activated(PayMana({{ManaCost[0]}}), ActionList([TurnPermanentFaceUp(ThisPermanent)]))",
    "{{ManaCost}}: Turn this creature face up. If you can't, exile it, then you may cast the exiled card without paying its mana cost": "Activated(PayMana({{ManaCost[0]}}), ActionList([MustCost(TurnPermanentFaceUp(ThisPermanent)), If(CostWasntPaid, [ExilePermanent(ThisPermanent), MayAction(CastExiledCardWithoutPaying(TheCardExiledThisWay))])]))",
    "{{ManaCost}}: Untap this creature": "Activated(PayMana({{ManaCost[0]}}), ActionList([UntapPermanent(ThisPermanent)]))",
    "{{ManaCost}}: Untap this creature. Activate only once": "ActivatedWithModifiers(PayMana({{ManaCost[0]}}), ActionList([UntapPermanent(ThisPermanent)]), ActivateOnlyOnce)",
    "{{TapSelfCost}}, Sacrifice this creature: Add {{Number}} mana of any one color": "Activated(And([{{TapSelfCost[0]}}, SacrificePermanent(ThisPermanent)]), ActionList([AddManaRepeated(AnyManaColor, {{Number[0]}})]))",
    "{{TapSelfCost}}: Add one mana of any of this creature's colors": "Activated({{TapSelfCost[0]}}, ActionList([AddMana(AnyManaColorOfPermanent(ThisPermanent))]))",
    "{{TapSelfCost}}: Add one mana of any of this creature's colors. Spend this mana only to activate an ability of a creature. Activate only if this creature has another activated ability": "ActivatedWithModifiers({{TapSelfCost[0]}}, ActionList([AddManaWithModifiers(AnyManaColorOfPermanent(ThisPermanent), CanOnlySpendToActivateAbilitiesOfPermanents(IsCardtype(Creature)))]), ActivateOnlyIf(PermanentPassesFilter(ThisPermanent, HasAnActivatedAbilityOtherThanThisActivatedAbility)))",
    "{{TapSelfCost}}: Another target {{Creature}} gets {{PTMod}} until end of turn. Put {{a}} {{CounterType}} counter on this creature": "Activated({{TapSelfCost[0]}}, Targeted([TargetPermanent(And([Other(ThisPermanent), {{Creature[0]}}]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), PutACounterOfTypeOnPermanent({{CounterType[0]}}, ThisPermanent)])))",
    "{{TapSelfCost}}: Create X {{PT}} {{CreatureTokens}} with {{Hasable}}, where X is this creature's power. Exile them at the beginning of the next end step": "Activated({{TapSelfCost[0]}}, ActionList([CreateTokens([NumberTokens(PowerOfPermanent(ThisPermanent), TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}]))]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([ExileEachPermanent(TheCreatedTokens)]))]))",
    "{{TapSelfCost}}: Create a token that's a copy of this creature, except it has {{Hasable}}. Exile that token at the beginning of the next end step": "Activated({{TapSelfCost[0]}}, ActionList([CreateTokens([TokenCopyOfPermanent(ThisPermanent, TokenCopyEffects([AddAbility([{{Hasable[0]}}])]))]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([ExilePermanent(TheCreatedToken)]))]))",
    "{{TapSelfCost}}: Destroy target creature with power less than this creature's power": "Activated({{TapSelfCost[0]}}, Targeted([TargetPermanent(And([IsCardtype(Creature), PowerIs(LessThan(PowerOfPermanent(ThisPermanent)))]))], ActionList([DestroyPermanent(Ref_TargetPermanent)])))",
    "{{TapSelfCost}}: Target player mills X cards, where X is this creature's toughness": "Activated({{TapSelfCost[0]}}, Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, MillNumberCards(ToughnessOfPermanent(ThisPermanent)))])))",
    "{{TapSelfCost}}: This creature deals damage equal to its power to any target": "Activated({{TapSelfCost[0]}}, Targeted([AnyTarget], ActionList([PermanentDealsDamage(ThisPermanent, PowerOfPermanent(ThisPermanent), Ref_AnyTarget)])))",
    "{{TapSelfCost}}: This creature deals damage equal to its power to target creature. That creature deals damage equal to its power to this creature": "Activated({{TapSelfCost[0]}}, Targeted([TargetPermanent(IsCardtype(Creature))], ActionList([PermanentDealsDamage(ThisPermanent, PowerOfPermanent(ThisPermanent), Permanent(Ref_TargetPermanent)), PermanentDealsDamage(Ref_TargetPermanent, PowerOfPermanent(Ref_TargetPermanent), Permanent(ThisPermanent))])))",
    "{{TapSelfCost}}: This creature deals damage equal to its power to target {{Creature}}": "Activated({{TapSelfCost[0]}}, Targeted([TargetPermanent({{Creature[0]}})], ActionList([PermanentDealsDamage(ThisPermanent, PowerOfPermanent(ThisPermanent), Permanent(Ref_TargetPermanent))])))",
    "{{TapSelfCost}}: This creature deals {{Digits}} damage to any target": "Activated({{TapSelfCost[0]}}, Targeted([AnyTarget], ActionList([PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, Ref_AnyTarget)])))",
    "{{TapSelfCost}}: This creature deals {{Digits}} damage to any target and {{Digits}} damage to itself": "Activated({{TapSelfCost[0]}}, Targeted([AnyTarget], ActionList([PermanentDealsMultipleDamage(ThisPermanent, [DamageToRecipients({{Digits[0]}}, Ref_AnyTarget), DamageToRecipients({{Digits[1]}}, Permanent(ThisPermanent))])])))",
    "{{TapSelfCost}}: This creature deals {{Digits}} damage to each opponent": "Activated({{TapSelfCost[0]}}, ActionList([PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, EachPlayer(Opponent))]))",
    "{{TapSelfCost}}: This creature deals {{Digits}} damage to target {{Creature}}": "Activated({{TapSelfCost[0]}}, Targeted([TargetPermanent({{Creature[0]}})], ActionList([PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, Permanent(Ref_TargetPermanent))])))",
    "{{TapSelfCost}}: This creature deals {{Digits}} damage to target {{PlayerOrPlaneswalker}}": "Activated({{TapSelfCost[0]}}, Targeted([TargetPlayerOrPermanent({{PlayerOrPlaneswalker[0]}})], ActionList([PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, Ref_TargetPlayerOrPermanent)])))",
    "{{TapSelfCost}}: This creature deals {{Digits}} damage to target {{PlayerOrPlaneswalker}}. If this creature is {{a}} {{Zombie}}, it deals {{Digits}} damage instead": "Activated({{TapSelfCost[0]}}, ActionList([IfElse(PermanentPassesFilter(ThisPermanent, IsCreatureType({{Zombie[0]}})), [PermanentDealsDamage(ThisPermanent, {{Digits[1]}}, Ref_TargetPlayerOrPermanent)], [PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, Ref_TargetPlayerOrPermanent)])]))",
    "{{TapSelfCost}}: This creature deals {{Digits}} damage to target {{PlayerOrPlaneswalker}}. You draw a card": "Activated({{TapSelfCost[0]}}, Targeted([TargetPlayerOrPermanent({{PlayerOrPlaneswalker[0]}})], ActionList([PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, Ref_TargetPlayerOrPermanent), DrawACard])))",
    "{{TapSelfCost}}: This creature fights another target {{Creature}}": "Activated({{TapSelfCost[0]}}, Targeted([TargetPermanent({{Creature[0]}})], ActionList([HaveCreaturesFight(ThisPermanent, Ref_TargetPermanent)])))"
  },
  "{{QuotedAbility}}": {
    "At the beginning of combat on your turn, create a token that's a copy of this creature, except it has {{Hasable}} and loses {{CheckHasable}}. Exile it at end of combat": "TriggerA(AtTheBeginningOfCombatDuringAPlayersTurn(SinglePlayer(You)), ActionList([CreateTokens([TokenCopyOfPermanent(ThisPermanent, TokenCopyEffects([AddAbility([{{Hasable[0]}}]), LosesAbility({{CheckHasable[0]}})]))]), CreateFutureTrigger(AtTheNextEndOfCombat, ActionList([ExilePermanent(TheCreatedToken)]))]))",
    "At the beginning of combat on your turn, {{TriggerActions}}": "TriggerA(AtTheBeginningOfCombatDuringAPlayersTurn(SinglePlayer(You)), {{TriggerActions[0]}})",
    "At the beginning of each end step, if {{Condition}} and this permanent is a creature, put {{a}} {{CounterType}} counter on this permanent and draw a card": "TriggerI(AtTheBeginningOfAPlayersEndStep(AnyPlayer), And([{{Condition[0]}}, PermanentPassesFilter(ThisPermanent, IsCardtype(Creature))]), ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, ThisPermanent), DrawACard]))",
    "At the beginning of each upkeep, {{TriggerActions}}": "TriggerA(AtTheBeginningOfAPlayersUpkeep(AnyPlayer), {{TriggerActions[0]}})",
    "At the beginning of the end step, sacrifice this creature": "TriggerA(AtTheBeginningOfAPlayersEndStep(AnyPlayer), ActionList([SacrificePermanent(ThisPermanent)]))",
    "At the beginning of the end step, sacrifice this permanent": "TriggerA(AtTheBeginningOfAPlayersEndStep(AnyPlayer), ActionList([SacrificePermanent(ThisPermanent)]))",
    "At the beginning of the end step, sacrifice this token": "TriggerA(AtTheBeginningOfAPlayersEndStep(AnyPlayer), ActionList([SacrificePermanent(ThisPermanent)]))",
    "At the beginning of your end step, if {{Condition}}, {{TriggerActions}}": "TriggerI(AtTheBeginningOfAPlayersEndStep(SinglePlayer(You)), {{Condition[0]}}, {{TriggerActions[0]}})",
    "At the beginning of your end step, sacrifice this permanent": "TriggerA(AtTheBeginningOfAPlayersEndStep(SinglePlayer(You)), ActionList([SacrificePermanent(ThisPermanent)]))",
    "At the beginning of your end step, {{TriggerActions}}": "TriggerA(AtTheBeginningOfAPlayersEndStep(SinglePlayer(You)), {{TriggerActions[0]}})",
    "At the beginning of your upkeep, sacrifice this artifact unless you pay its mana cost": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), ActionList([MayCost(PayManaCostOfPermanent(HostPermanent)), Unless(CostWasPaid, [SacrificePermanent(ThisPermanent)])]))",
    "At the beginning of your upkeep, sacrifice this artifact unless you pay {{ManaCost}}": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), ActionList([MayCost(PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [SacrificePermanent(ThisPermanent)])]))",
    "At the beginning of your upkeep, sacrifice this enchantment unless you pay {{ManaCost}}": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), ActionList([MayCost(PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [SacrificePermanent(ThisPermanent)])]))",
    "At the beginning of your upkeep, sacrifice this permanent unless you pay its mana cost": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), ActionList([MayCost(PayManaCostOfPermanent(HostPermanent)), Unless(CostWasPaid, [SacrificePermanent(ThisPermanent)])]))",
    "At the beginning of your upkeep, this land deals {{Digits}} damage to you": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), ActionList([PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, Player(You))]))",
    "At the beginning of your upkeep, this permanent deals {{Digits}} damage to you": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), ActionList([PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, Player(You))]))",
    "At the beginning of your upkeep, this permanent deals {{Digits}} damage to you unless you sacrifice it": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), ActionList([MayCost(SacrificePermanent(ThisPermanent)), Unless(CostWasPaid, [PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, Player(You))])]))",
    "At the beginning of your upkeep, you may exile this enchantment. If you do, return it to the battlefield under its owner's control": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), ActionList([MayCost(ExilePermanent(ThisPermanent)), If(CostWasPaid, [PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersUnderOwnersControl])])]))",
    "At the beginning of your upkeep, {{TriggerActions}}": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), {{TriggerActions[0]}})",
    "Cumulative upkeep {{ManaCost}}": "CumulativeUpkeep(PayMana({{ManaCost[0]}}))",
    "Cumulative upkeep-{{LifeCost}}": "CumulativeUpkeep({{LifeCost[0]}})",
    "Damage isn't removed from {{Creatures}} during cleanup steps": "DamageIsntRemovedFromCreaturesDuringCleanup({{Creatures[0]}})",
    "Enchanted creature loses {{CheckHasable}}": "PermanentLayerEffect(HostPermanent, [LosesAbility({{CheckHasable[0]}})])",
    "Equipped creature gets {{PTMod}} and has {{Hasable}}": "PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])])",
    "Equipped creature has {{Hasable}}": "PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[0]}}])])",
    "Exhaust - {{ManaCost}}: {{ActivatedActions}}": "ActivatedWithModifiers(PayMana({{ManaCost[0]}}), {{ActivatedActions[0]}}, Exhaust)",
    "Exile this permanent: {{ActivatedActions}}": "Activated(ExilePermanent(ThisPermanent), {{ActivatedActions[0]}})",
    "If a creature dying causes a triggered ability of this creature or an emblem you own to trigger, that ability triggers an additional time": "APermanentDyingCausesAbilitiesToTriggerAnAdditionalTime(IsCardtype(Creature), Or([AbilityOfPermanent(ThisPermanent), AbilityOfAnEmblem(OwnedByAPlayer(SinglePlayer(You)))]))",
    "If this land would leave the battlefield, exile it instead of putting it anywhere else": "ReplaceWouldLeaveTheBattlefield(PermanentWouldLeaveTheBattlefield(ThisPermanent), [ExileItInstead])",
    "If this permanent would be put into a graveyard, you may put it on top of its owner's library instead": "ReplaceWouldPutIntoGraveyard(APermanentWouldBePutIntoAGraveyard(SinglePermanent(ThisPermanent)), [MayAction(PutItOnTopOfOwnersLibraryInstead)])",
    "If this permanent would leave the battlefield, exile it instead of putting it anywhere else": "ReplaceWouldLeaveTheBattlefield(PermanentWouldLeaveTheBattlefield(ThisPermanent), [ExileItInstead])",
    "Other commanders you control get {{PTMod}} and have {{Hasable}}": "EachPermanentLayerEffect(And([Other(ThisPermanent), IsACommander, ControlledByAPlayer(SinglePlayer(You))]), [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])])",
    "Prevent all damage that would be dealt to this creature": "PreventDamage(DamageWouldBeDealtToRecipient(Permanent(ThisPermanent)), [PreventThatDamage])",
    "Room abilities of dungeons you own trigger an additional time": "AbilitiesTriggerAnAdditionalTime(RoomAbilityOfDungeon(OwnedByAPlayer(SinglePlayer(You))))",
    "Sacrifice this land: {{ActivatedActions}}": "Activated(SacrificePermanent(ThisPermanent), {{ActivatedActions[0]}})",
    "Sacrifice this permanent: {{ActivatedActions}}": "Activated(SacrificePermanent(ThisPermanent), {{ActivatedActions[0]}})",
    "Spells your opponents cast that target this permanent cost {{ManaCost}} more to cast": "EachPlayerEffect(Opponent, [IncreaseSpellCost(TargetsPermanent(ThisPermanent), PayMana({{ManaCost[0]}}))])",
    "The first time you would draw a card each turn, instead look at the top two cards of your library. Put one of them into your graveyard and the other back on top of your library. Then draw a card": "ReplaceWouldDraw(PlayerWouldDrawACardForTheFirstTimeEachPlayersTurn(You, AnyPlayer), [LookAtTheTopNumberCardsOfLibrary(Integer(2), [PutAGenericCardIntoGraveyard, PutTheRemainingCardsOnTopOfLibraryInAnyOrder]), DrawACard])",
    "The {{Nth}} {{PotentialSpell}} you cast each turn costs {{CostReduce}} less to cast": "PlayerEffect(You, [DecreaseSpellCost(TheNthSpellCastByPlayerThisTurn({{Nth[0]}}, {{PotentialSpell[0]}}, You), {{CostReduce[0]}})])",
    "This permanent costs {{CostReduce}} less to turn face up": "EachPlayerEffect(AnyPlayer, [DecreaseCostToTurnPermanentsFaceUp(SinglePermanent(ThisPermanent), {{CostReduce[0]}})])",
    "This permanent has protection from {{Protectable}} as long as {{Condition}}": "If({{Condition[0]}}, [PermanentLayerEffect(ThisPermanent, [AddAbility([Protection({{Protectable[0]}})])])])",
    "This token can't be sacrificed": "PermanentRuleEffect(ThisPermanent, [CantBeSacrificed])",
    "Untap this land during each other player's untap step": "PermanentRuleEffect(ThisPermanent, [UntapsDuringOtherPlayersUntapSteps(Other(You))])",
    "Ward-{{LifeCost}}": "Ward({{LifeCost[0]}})",
    "Ward-{{SacrificeAPermanentCost}}": "Ward({{SacrificeAPermanentCost[0]}})",
    "When this Equipment enters, attach it to target creature you control": "TriggerA(WhenAPermanentEntersTheBattlefield(SinglePermanent(ThisPermanent)), Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))], ActionList([AttachPermanentToPermanent(Trigger_ThatPermanent, Ref_TargetPermanent)])))",
    "When this creature dies, return it to the battlefield tapped under its owner's control. It deals {{Digits}} damage to each opponent": "TriggerA(WhenACreatureOrPlaneswalkerDies(SinglePermanent(ThisPermanent)), ActionList([PutGraveyardCardOntoBattlefield(Trigger_ThatGraveyardCard, [EntersTapped, EntersUnderOwnersControl]), PermanentDealsDamage(ThePermanentPutOnTheBattlefieldThisWay, {{Digits[0]}}, EachPlayer(Opponent))]))",
    "When this permanent dies, {{TriggerActions}}": "TriggerA(WhenACreatureOrPlaneswalkerDies(SinglePermanent(ThisPermanent)), {{TriggerActions[0]}})",
    "When this permanent enters, {{TriggerActions(ThatPermanent)}}": "TriggerA(WhenAPermanentEntersTheBattlefield(SinglePermanent(ThisPermanent)), {{TriggerActions(ThatPermanent=Trigger_ThatPermanent)[0]}})",
    "When this permanent enters, {{TriggerActions}}": "TriggerA(WhenAPermanentEntersTheBattlefield(SinglePermanent(ThisPermanent)), {{TriggerActions[0]}})",
    "When this permanent is put into a graveyard from the battlefield, {{TriggerActions[WhenAPermanentIsPutIntoAGraveyard]}}": "TriggerA(WhenAPermanentIsPutIntoAPlayersGraveyard(SinglePermanent(ThisPermanent), AnyPlayer), {{TriggerActions[WhenAPermanentIsPutIntoAGraveyard][0]}})",
    "When this permanent is turned face up, if it's a creature, put {{a}} {{CounterType}} counter on it": "TriggerI(WhenAPermanentIsTurnedFaceUp(SinglePermanent(ThisPermanent)), PermanentPassesFilter(Trigger_ThatPermanent, IsCardtype(Creature)), ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Trigger_ThatPermanent)]))",
    "When this permanent leaves the battlefield, it deals damage equal to its mana value to each {{Creature}}": "TriggerA(WhenAPermanentLeavesTheBattlefield(SinglePermanent(ThisPermanent)), ActionList([PermanentDealsDamage(Trigger_ThatPermanent, ManaValueOfPermanent(Trigger_ThatPermanent), EachPermanent({{Creature[0]}}))]))",
    "When this permanent leaves the battlefield, {{TriggerActions}}": "TriggerA(WhenAPermanentLeavesTheBattlefield(SinglePermanent(ThisPermanent)), {{TriggerActions[0]}})",
    "Whenever an opponent casts a spell, {{TriggerActions}}": "TriggerA(WhenAPlayerCastsASpell(Opponent, AnySpell), {{TriggerActions[0]}})",
    "Whenever an opponent sacrifices a nontoken permanent, put that card onto the battlefield under your control unless that player pays {{Digits}} life": "TriggerA(WhenAPlayerSacrificesAPermanent(Opponent, IsNonToken), ActionList([PlayerMayCost(Trigger_ThatPlayer, PayLife({{Digits[0]}})), Unless(CostWasPaid, [PutGraveyardCardOntoBattlefield(Trigger_ThatGraveyardCard, [EntersUnderPlayersControl(You)])])]))",
    "Whenever one or more {{Creatures}} deal combat damage to a player, {{TriggerActions(ThatPlayer)}}": "TriggerA(WhenAnyNumberOfCreaturesDealCombatDamageToAPlayer({{Creatures[0]}}, AnyPlayer), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "Whenever one or more {{Creatures}} deal combat damage to a player, {{TriggerActions}}": "TriggerA(WhenAnyNumberOfCreaturesDealCombatDamageToAPlayer({{Creatures[0]}}, AnyPlayer), {{TriggerActions[0]}})",
    "Whenever this Vehicle deals damage, roll a six-sided die. If the result is equal to this Vehicle's mana value, sacrifice this Vehicle, then it deals that much damage to any target": "TriggerA(WhenAPermanentDealsDamage(SinglePermanent(ThisPermanent)), Targeted([AnyTarget], ActionList([RollAD6, If(DiceResultIs(EqualTo(ManaValueOfPermanent(ThisPermanent))), [SacrificePermanent(ThisPermanent), PermanentDealsDamage(ThisPermanent, TheDiceResult, Ref_AnyTarget)])])))",
    "Whenever this creature becomes tapped for the first time during each of your turns, put {{a}} {{CounterType}} counter on it": "TriggerA(If(IsPlayersTurn(You), WhenAPermanentBecomesTappedForTheFirstTimeEachTurn(SinglePermanent(ThisPermanent))), ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, ThisPermanent)]))",
    "Whenever this creature becomes the target of a spell or ability, {{TriggerActions}}. This ability triggers only twice each turn": "TriggerTwiceEachTurn(WhenAPermanentBecomesTheTargetOfASpellOrAbility(SinglePermanent(ThisPermanent), AnySpellOrAbility), {{TriggerActions[0]}})",
    "Whenever this permanent becomes the target of a spell an opponent controls, you may draw a card": "TriggerA(WhenAPermanentBecomesTheTargetOfASpell(SinglePermanent(ThisPermanent), ControlledByAPlayer(Opponent)), ActionList([MayAction(DrawACard)]))",
    "Whenever this permanent dies, {{TriggerActions}}": "TriggerA(WhenACreatureOrPlaneswalkerDies(SinglePermanent(ThisPermanent)), {{TriggerActions[0]}})",
    "Whenever this permanent leaves the battlefield, {{TriggerActions}}": "TriggerA(WhenAPermanentLeavesTheBattlefield(SinglePermanent(ThisPermanent)), {{TriggerActions[0]}})",
    "Whenever you cast a spell that targets this permanent, put {{Number}} {{CounterType}} counters on it": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), TargetsPermanent(ThisPermanent)), ActionList([PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[0]}}, ThisPermanent)]))",
    "Whenever you cast or copy {{a}} {{Spell}}, {{TriggerActions}}": "TriggerA(Or([WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), WhenAPlayerCopiesASpell(SinglePlayer(You), {{Spell[0]}})]), {{TriggerActions[0]}})",
    "Whenever {{EquippedCreature}} deals combat damage to a player, {{TriggerActions(ThatPlayer)}}": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(HostPermanent), AnyPlayer), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "Whenever {{a}} {{Creature}} dies, {{TriggerActions}}": "TriggerA(WhenACreatureOrPlaneswalkerDies({{Creature[0]}}), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Permanent}} enters under your control, put {{a}} {{CounterType}} counter on this permanent": "TriggerA(WhenAPermanentEntersTheBattlefieldUnderAPlayersControl({{Permanent[0]}}, SinglePlayer(You)), ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, ThisPermanent)]))",
    "Whenever {{a}} {{Permanent}} enters under your control, this permanent becomes {{a}} {{PT}} {{Zombie}} creature in addition to its other types until end of turn": "TriggerA(WhenAPermanentEntersTheBattlefieldUnderAPlayersControl({{Permanent[0]}}, SinglePlayer(You)), ActionList([CreatePermanentLayerEffectUntil(ThisPermanent, [SetPT({{PT[0]}}), AddCreatureType({{Zombie[0]}}), AddCardtype(Creature)], UntilEndOfTurn)]))",
    "Whenever {{a}} {{Permanent}} enters under your control, this permanent deals {{Digits}} damage to target player": "TriggerA(WhenAPermanentEntersTheBattlefieldUnderAPlayersControl({{Permanent[0]}}, SinglePlayer(You)), Targeted([TargetPlayer(AnyPlayer)], ActionList([PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, Player(Ref_TargetPlayer))])))",
    "Whenever {{a}} {{Permanent}} enters under your control, {{TriggerActions}}": "TriggerA(WhenAPermanentEntersTheBattlefieldUnderAPlayersControl({{Permanent[0]}}, SinglePlayer(You)), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Permanent}} is put into a graveyard from the battlefield, {{TriggerActions}}": "TriggerA(WhenAPermanentIsPutIntoAPlayersGraveyard({{Permanent[0]}}, AnyPlayer), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Permanent}} is put into your graveyard from the battlefield, {{TriggerActions[WhenAPermanentIsPutIntoAGraveyard]}}": "TriggerA(WhenAPermanentIsPutIntoAPlayersGraveyard({{Permanent[0]}}, SinglePlayer(You)), {{TriggerActions[WhenAPermanentIsPutIntoAGraveyard][0]}})",
    "You can't lose the game and your opponents can't win the game": "PlayerEffect(You, [CantLoseTheGame]), EachPlayerEffect(Opponent, [CantWinTheGame])",
    "You have no maximum hand size": "PlayerEffect(You, [HasNoMaximumHandSize])",
    "You may cast this card from your graveyard by paying {{Digits}} life in addition to paying its other costs": "FromGraveyard(PlayerEffect(You, [MayCastCardFromGraveyardByPayingAddedCost(ThisGraveyardCard, PayLife({{Digits[0]}}))]))",
    "You may look at the top card of your library any time": "PlayerEffect(You, [MayLookAtTopCardOfLibraryAnyTime])",
    "bands with other legendary creatures": "BandsWithOthers(And([IsSupertype(Legendary), IsCardtype(Creature)]))",
    "{{Creatures}} get {{PTMod}}": "EachPermanentLayerEffect({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})])",
    "{{DiscardCardsCost}}: Untap this permanent": "Activated({{DiscardCardsCost[0]}}, ActionList([UntapPermanent(ThisPermanent)]))",
    "{{EnchantedLand}} has '{{TapSelfCost}}: {{ActivatedActions}}'": "PermanentLayerEffect(HostPermanent, [AddAbility([Activated({{TapSelfCost[0]}}, {{ActivatedActions[0]}})])])",
    "{{EnchantedLand}} has '{{TapSelfCost}}: {{ActivatedActions}}' and '{{ManaCost}}, {{TapSelfCost}}, Sacrifice this land: {{ActivatedActions}}'": "PermanentLayerEffect(HostPermanent, [AddAbility([Activated({{TapSelfCost[0]}}, {{ActivatedActions[0]}})]), AddAbility([Activated(And([PayMana({{ManaCost[0]}}), {{TapSelfCost[1]}}, SacrificePermanent(ThisPermanent)]), {{ActivatedActions[0]}})])])",
    "{{EquippedCreature}} gets {{PTMod}}": "PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}})])",
    "{{LifeCost}}: Return this permanent to its owner's hand": "Activated({{LifeCost[0]}}, ActionList([PutPermanentIntoItsOwnersHand(ThisPermanent)]))",
    "{{LoyaltyCost}}: {{ActivatedActions}}": "Activated({{LoyaltyCost[0]}}, {{ActivatedActions[0]}})",
    "{{ManaCost}}, Sacrifice this artifact: {{ActivatedActions(ThatPermanent)}}": "Activated(And([PayMana({{ManaCost[0]}}), SacrificePermanent(ThisPermanent)]), {{ActivatedActions(ThatPermanent=ThisPermanent)[0]}})",
    "{{ManaCost}}, Sacrifice this artifact: {{ActivatedActions}}": "Activated(And([PayMana({{ManaCost[0]}}), SacrificePermanent(ThisPermanent)]), {{ActivatedActions[0]}})",
    "{{ManaCost}}, Sacrifice this permanent: Prevent the next {{Digits}} damage that would be dealt to target player, planeswalker, or {{Zombie}} creature this turn": "Activated(And([PayMana({{ManaCost[0]}}), SacrificePermanent(ThisPermanent)]), Targeted([TargetPlayerOrPermanent(AnyPlayer, Or([IsCardtype(Planeswalker), And([IsCreatureType({{Zombie[0]}}), IsCardtype(Creature)])]))], ActionList([CreateFuturePreventDamage(NextAmountOfDamageThatWouldBeDealtThisTurnToRecipient({{Digits[0]}}, Ref_TargetPlayerOrPermanent), [PreventThatDamage])])))",
    "{{ManaCost}}, Sacrifice this permanent: Target player discards a card at random. Activate only as a sorcery": "ActivatedWithModifiers(And([PayMana({{ManaCost[0]}}), SacrificePermanent(ThisPermanent)]), Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, DiscardACardAtRandom)])), ActivateOnlyAsASorcery)",
    "{{ManaCost}}, Sacrifice this permanent: This permanent deals {{Digits}} damage to any target": "Activated(And([PayMana({{ManaCost[0]}}), SacrificePermanent(ThisPermanent)]), Targeted([AnyTarget], ActionList([PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, Ref_AnyTarget)])))",
    "{{ManaCost}}, Sacrifice this permanent: {{ActivatedActions}}": "Activated(And([PayMana({{ManaCost[0]}}), SacrificePermanent(ThisPermanent)]), {{ActivatedActions[0]}})",
    "{{ManaCost}}, {{TapSelfCost}}, Sacrifice this artifact: {{ActivatedActions}}": "Activated(And([PayMana({{ManaCost[0]}}), {{TapSelfCost[0]}}, SacrificePermanent(ThisPermanent)]), {{ActivatedActions[0]}})",
    "{{ManaCost}}, {{TapSelfCost}}, Sacrifice this permanent: {{ActivatedActions}}": "Activated(And([PayMana({{ManaCost[0]}}), {{TapSelfCost[0]}}, SacrificePermanent(ThisPermanent)]), {{ActivatedActions[0]}})",
    "{{ManaCost}}, {{TapSelfCost}}, Sacrifice this token: {{ActivatedActions}}": "Activated(And([PayMana({{ManaCost[0]}}), {{TapSelfCost[0]}}, SacrificePermanent(ThisPermanent)]), {{ActivatedActions[0]}})",
    "{{ManaCost}}, {{TapSelfCost}}, {{DiscardACardCost}}: {{ActivatedActions}}": "Activated(And([PayMana({{ManaCost[0]}}), {{TapSelfCost[0]}}, {{DiscardACardCost[0]}}]), {{ActivatedActions[0]}})",
    "{{ManaCost}}, {{TapSelfCost}}: This permanent deals {{Digits}} damage to any target": "Activated(And([PayMana({{ManaCost[0]}}), {{TapSelfCost[0]}}]), Targeted([AnyTarget], ActionList([PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, Ref_AnyTarget)])))",
    "{{ManaCost}}, {{TapSelfCost}}: {{ActivatedActions}}": "Activated(And([PayMana({{ManaCost[0]}}), {{TapSelfCost[0]}}]), {{ActivatedActions[0]}})",
    "{{ManaCost}}, {{TapSelfCost}}: {{ActivatedActions}}. {{ActivateModifiers}}": "ActivatedWithModifiers(And([PayMana({{ManaCost[0]}}), {{TapSelfCost[0]}}]), {{ActivatedActions[0]}}, {{ActivateModifiers[0]}})",
    "{{ManaCost}}: If this permanent is on the battlefield, flip a coin. If you win the flip, exile this permanent and return it to the battlefield under its owner's control at the beginning of the next end step. If you lose the flip, sacrifice it": "Activated(PayMana({{ManaCost[0]}}), ActionList([If(PermanentPassesFilter(ThisPermanent, OnTheBattlefield), [FlipACoin_OnWinAndLose([ExilePermanent(ThisPermanent), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersUnderOwnersControl])]))], [SacrificePermanent(ThisPermanent)])])]))",
    "{{ManaCost}}: Regenerate this permanent": "Activated(PayMana({{ManaCost[0]}}), ActionList([RegeneratePermanent(ThisPermanent)]))",
    "{{ManaCost}}: This permanent becomes the creature type of your choice in addition to its other types until end of turn": "Activated(PayMana({{ManaCost[0]}}), ActionList([ChooseACreatureType, CreatePermanentLayerEffectUntil(ThisPermanent, [AddCreatureTypeVariable(TheChosenCreatureType)], UntilEndOfTurn)]))",
    "{{ManaCost}}: {{ActivatedActions[EnchantedPermanent]}}": "Activated(PayMana({{ManaCost[0]}}), {{ActivatedActions[EnchantedPermanent][0]}})",
    "{{ManaCost}}: {{ActivatedActions}}": "Activated(PayMana({{ManaCost[0]}}), {{ActivatedActions[0]}})",
    "{{QuotedAbility[ThisCreature]}}": "{{QuotedAbility[ThisCreature][0]}}",
    "{{TapSelfCost}}, Sacrifice a creature: You gain life equal to the sacrificed creature's toughness": "Activated(And([{{TapSelfCost[0]}}, SacrificeAPermanent(IsCardtype(Creature))]), ActionList([GainLife(ToughnessOfTheSacrificedCreature)]))",
    "{{TapSelfCost}}, Sacrifice this artifact: Flip a coin. If you win the flip, this artifact deals {{Digits}} damage to any target": "Activated(And([{{TapSelfCost[0]}}, SacrificePermanent(ThisPermanent)]), Targeted([AnyTarget], ActionList([FlipACoin_OnWin([SacrificedPermanentDealsDamage({{Digits[0]}}, Ref_AnyTarget)])])))",
    "{{TapSelfCost}}, Sacrifice this artifact: {{ActivatedActions}}": "Activated(And([{{TapSelfCost[0]}}, SacrificePermanent(ThisPermanent)]), {{ActivatedActions[0]}})",
    "{{TapSelfCost}}, {{DiscardACardCost}}: {{ActivatedActions}}": "Activated(And([{{TapSelfCost[0]}}, {{DiscardACardCost[0]}}]), {{ActivatedActions[0]}})",
    "{{TapSelfCost}}, {{LifeCost}}: {{ActivatedActions}}": "Activated(And([{{TapSelfCost[0]}}, {{LifeCost[0]}}]), {{ActivatedActions[0]}})",
    "{{TapSelfCost}}: Choose a card name. Target opponent reveals a card at random from their hand. If that card has the chosen name, that player discards it. Activate only during your turn": "ActivatedWithModifiers({{TapSelfCost[0]}}, Targeted([TargetPlayer(Opponent)], ActionList([ChooseACardName(AnyOracleCard), PlayerAction(Ref_TargetPlayer, RevealACardFromHandAtRandomAndDiscardIfItIsACardOfType(IsNamed(TheChosenName)))])), ActivateOnlyIf(IsPlayersTurn(You)))",
    "{{TapSelfCost}}: Counter target spell if it would destroy a land you control": "Activated({{TapSelfCost[0]}}, Targeted([TargetSpell(AnySpell)], ActionList([If(SpellPassesFilter(Ref_TargetSpell, WouldDestroyAPermanent(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You))]))), [CounterSpell(Ref_TargetSpell)])])))",
    "{{TapSelfCost}}: This artifact deals {{Digits}} damage to any target": "Activated({{TapSelfCost[0]}}, Targeted([AnyTarget], ActionList([PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, Ref_AnyTarget)])))",
    "{{TapSelfCost}}: This land deals {{Digits}} damage to any target": "Activated({{TapSelfCost[0]}}, Targeted([AnyTarget], ActionList([PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, Ref_AnyTarget)])))",
    "{{TapSelfCost}}: This land deals {{Digits}} damage to each {{Creature}} and each player": "Activated({{TapSelfCost[0]}}, ActionList([PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, MultipleRecipients([EachPermanent({{Creature[0]}}), EachPlayer(AnyPlayer)]))]))",
    "{{TapSelfCost}}: This permanent deals {{Digits}} damage to any target": "Activated({{TapSelfCost[0]}}, Targeted([AnyTarget], ActionList([PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, Ref_AnyTarget)])))",
    "{{TapSelfCost}}: This permanent deals {{Digits}} damage to target {{Creature}}": "Activated({{TapSelfCost[0]}}, Targeted([TargetPermanent({{Creature[0]}})], ActionList([PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, Permanent(Ref_TargetPermanent))])))",
    "{{TapSelfCost}}: {{ActivatedActions(ThatPermanent)}}": "Activated({{TapSelfCost[0]}}, {{ActivatedActions(ThatPermanent=ThisPermanent)[0]}})",
    "{{TapSelfCost}}: {{ActivatedActions}}": "Activated({{TapSelfCost[0]}}, {{ActivatedActions[0]}})",
    "{{TapSelfCost}}: {{ActivatedActions}}. {{ActivateModifiers}}": "ActivatedWithModifiers({{TapSelfCost[0]}}, {{ActivatedActions[0]}}, {{ActivateModifiers[0]}})",
    "{{ThisPermanent}} attacks each combat if able": "PermanentRuleEffect(ThisPermanent, [MustAttack])",
    "{{ThisPermanent}} can't block {{Zombies}} or {{Zombies}}": "PermanentRuleEffect(ThisPermanent, [CantBlockAttackers(Or([IsCreatureType({{Zombies[0]}}), IsCreatureType({{Zombies[1]}})]))])"
  },
