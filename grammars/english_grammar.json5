    "This creature has {{Hasable}} as long as {{Condition(ThatPermanent)}}": "If({{Condition(ThatPermanent=ThisPermanent)[0]}}, [PermanentLayerEffect(ThisPermanent, [AddAbility([{{Hasable[0]}}])])])",
    "This creature must be blocked if able": "PermanentRuleEffect(ThisPermanent, [MustBeBlocked])",
