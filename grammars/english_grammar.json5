    "tap target {{Creature}} and that creature deals damage equal to {{GameNumber(ThatCreature)}} to its controller": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), PermanentDealsDamage(Ref_TargetPermanent, {{GameNumber(ThatCreature=Ref_TargetPermanent)[0]}}, Player(ControllerOfPermanent(Ref_TargetPermanent)))]))",
    "tap target {{Creature}}. Goad it": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), GoadCreature(Ref_TargetPermanent)]))",
