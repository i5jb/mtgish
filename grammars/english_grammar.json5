    "Untap {{Number}} target {{Creatures}}. Each of them gets {{PTMod}} until end of turn": "Targeted([NumberTargetPermanents({{Number[0]}}, {{Creatures[0]}})], ActionList([UntapEachPermanent(Ref_TargetPermanents), CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)]))",
    "Until end of turn, all {{Creatures}} become {{Black}} and all {{Lands}} become {{Swamps}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [SetColor(SimpleColorList([{{Black[0]}}]))], UntilEndOfTurn), CreateEachPermanentLayerEffectUntil({{Lands[0]}}, [SetLandType({{Swamps[0]}})], UntilEndOfTurn)])",
    "Until end of turn, all {{Permanents}} gain \"{{QuotedAbility}}\"": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{QuotedAbility[0]}}])], UntilEndOfTurn)])",
    "Until end of turn, any number of target {{Lands}} become {{PT}} {{Zombie}} creatures with {{Hasable}}, {{Hasable}}, and {{Hasable}}. They're still lands": "Targeted([AnyNumberOfTargetPermanents({{Lands[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [SetPT({{PT[0]}}), SetCreatureType({{Zombie[0]}}), AddCardtype(Creature), AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}]), AddAbility([{{Hasable[2]}}])], UntilEndOfTurn)]))",
    "Until end of turn, any number of target {{Permanents}} each gain \"{{QuotedAbility}}\"": "Targeted([AnyNumberOfTargetPermanents({{Permanents[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AddAbility([{{QuotedAbility[0]}}])], UntilEndOfTurn)]))",
