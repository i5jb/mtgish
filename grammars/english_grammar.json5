  },
  "{{SpellActions(ThatPlayer)}}": {
    "Tap target {{Creature}} that player controls. That creature deals damage equal to its power to the player. Prevent all combat damage that would be dealt to and dealt by the creature this turn": "Targeted([TargetPermanent(And([{{Creature[0]}}, ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))], ActionList([TapPermanent(Ref_TargetPermanent), PermanentDealsDamage(Ref_TargetPermanent, PowerOfPermanent(Ref_TargetPermanent), Player({{ThatPlayer}})), CreatePreventDamageUntil(Or([CombatDamageWouldBeDealtToRecipient(Permanent(Ref_TargetPermanent)), CombatDamageWouldBeDealtByCreature(Ref_TargetPermanent)]), [PreventThatDamage], UntilEndOfTurn)]))",
    "You destroy up to {{Number}} target {{Permanents}} that player controls. They can't be regenerated. That player draws up to {{Number}} cards": "Targeted([UptoNumberTargetPermanents({{Number[0]}}, And([{{Permanents[0]}}, ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))], ActionList([DestroyEachPermanentNoRegen(Ref_TargetPermanents), PlayerAction({{ThatPlayer}}, DrawUptoNumberCards({{Number[1]}}))]))"
  },
  "{{SpellActions(X)}}": {
    "All {{Creatures}} get {{PTModX}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPTX({{PTModX[0]}}, {{X}})], UntilEndOfTurn)])",
