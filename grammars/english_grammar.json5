    "{{ThisPermanent}} loses {{CheckHasable}} and gains {{Hasable}} until end of turn": "ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [LosesAbility({{CheckHasable[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "{{ThisPermanent}} loses {{CheckHasable}} until end of turn": "ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [LosesAbility({{CheckHasable[0]}})], UntilEndOfTurn)])",
    "{{ThisPermanent}} perpetually gains {{PerpetualHasable}}": "ActionList([CreatePerpetualPermanentEffect({{~Permanent}}, [AddAbility([{{PerpetualHasable[0]}}])])])",
    "{{ThisPermanent}} perpetually gets {{PTMod}}": "ActionList([CreatePerpetualPermanentEffect({{~Permanent}}, [AdjustPT({{PTMod[0]}})])])",
    "{{ThisPermanent}} phases out": "ActionList([PhaseOutPermanent({{~Permanent}})])",
    "{{ThisPermanent}} phases out unless you pay {{ManaCost}}": "ActionList([MayCost(PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [PhaseOutPermanent({{~Permanent}})])])",
    "{{ThisPermanent}}'s owner shuffles it into their library": "ActionList([ShufflePermanentIntoLibrary({{~Permanent}})])",
    "{{Zombies}} you control other than {{ThisPermanent}} get {{PTMod}} and gain {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil(And([IsCreatureType({{Zombies[0]}}), ControlledByAPlayer(SinglePlayer(You)), Other(ThisPermanent)]), [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "{{~Permanent}} and the top creature card in your library without {{CheckHasable}} perpetually gain {{PerpetualHasable}}": "ActionList([CreatePerpetualPermanentEffect({{~Permanent}}, [AddAbility([{{PerpetualHasable[0]}}])]), CreatePerpetualCardInLibraryEffect(TheTopCardOfTypeInPlayersLibrary(And([IsCardtype(Creature), DoesntHaveAbility({{CheckHasable[0]}})]), You), [AddAbility([{{PerpetualHasable[0]}}])])])",
    "{{~Permanent}} and up to one other target {{Permanent}} can't be blocked this turn": "Targeted([UptoOneTargetPermanent(And([Other({{~Permanent}}), {{Permanent[0]}}]))], ActionList([CreateEachPermanentRuleEffectUntil(Or([SinglePermanent({{~Permanent}}), SinglePermanent(Ref_TargetPermanent)]), [CantBeBlocked], UntilEndOfTurn)]))",
    "{{~Permanent}} and {{Creatures}} each get {{PTModX}} until end of turn, where X is {{GameNumber}}": "ActionList([CreateEachPermanentLayerEffectUntil(Or([SinglePermanent({{~Permanent}}), {{Creatures[0]}}]), [AdjustPTX({{PTModX[0]}}, {{GameNumber[0]}})], UntilEndOfTurn)])",
    "{{~Permanent}} becomes a copy of up to one other target creature you control, except her name is {{NamedCard}} and she has this ability. Then put {{a}} {{CounterType}} counter on her": "Targeted([UptoOneTargetPermanent(And([Other(ThisPermanent), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))], ActionList([CreatePermanentLayerEffect(ThisPermanent, [IsACopyOfPermanent(Ref_TargetPermanent, CopyEffects([SetName({{NamedCard[0]}}), AddAbilityVariable(ThisAbility)]))]), PutACounterOfTypeOnPermanent({{CounterType[0]}}, ThisPermanent)]))",
    "{{~Permanent}} becomes a copy of up to one target {{Permanent}} until end of turn, except he has {{Hasable}}": "Targeted([UptoOneTargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [IsACopyOfPermanent(Ref_TargetPermanent, CopyEffects([AddAbility([{{Hasable[0]}}])]))], UntilEndOfTurn)]))",
    "{{~Permanent}} becomes a copy of up to one target {{Permanent}} until end of turn, except it has {{Hasable}}": "Targeted([UptoOneTargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [IsACopyOfPermanent(Ref_TargetPermanent, CopyEffects([AddAbility([{{Hasable[0]}}])]))], UntilEndOfTurn)]))",
    "{{~Permanent}} becomes an artifact creature until end of turn": "ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [AddCardtype(Artifact), AddCardtype(Creature)], UntilEndOfTurn)])",
    "{{~Permanent}} becomes prepared": "ActionList([PreparePermanent(ThisPermanent)])",
    "{{~Permanent}} connives": "ActionList([CreatureConnives({{~Permanent}})])",
    "{{~Permanent}} deals X damage to any target and you scry X, where X is {{GameNumber}}": "Targeted([AnyTarget], ActionList([CreateValueX({{GameNumber[0]}}), PermanentDealsDamage({{~Permanent}}, ValueX, Ref_AnyTarget), Scry(ValueX)]))",
    "{{~Permanent}} deals X damage to each opponent, where X is {{GameNumber}}": "ActionList([PermanentDealsDamage({{~Permanent}}, {{GameNumber[0]}}, EachPlayer(Opponent))])",
    "{{~Permanent}} deals damage equal to his power to any target": "Targeted([AnyTarget], ActionList([PermanentDealsDamage({{~Permanent}}, PowerOfPermanent(ThisPermanent), Ref_AnyTarget)]))",
    "{{~Permanent}} deals damage equal to its power to each opponent": "ActionList([PermanentDealsDamage({{~Permanent}}, PowerOfPermanent(ThisPermanent), EachPlayer(Opponent))])",
    "{{~Permanent}} deals damage equal to {{GameNumber(ThatCreature)}} to up to one target {{Creature}}": "Targeted([UptoOneTargetPermanent({{Creature[0]}})], ActionList([PermanentDealsDamage({{~Permanent}}, {{GameNumber(ThatCreature=^~Permanent)[0]}}, EachPlayer(AnyPlayer))]))",
    "{{~Permanent}} deals damage equal to {{GameNumber}} to target player": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PermanentDealsDamage({{~Permanent}}, {{GameNumber[0]}}, Player(Ref_TargetPlayer))]))",
    "{{~Permanent}} deals damage to any target equal to {{GameNumber}}": "Targeted([AnyTarget], ActionList([PermanentDealsDamage({{~Permanent}}, {{GameNumber[0]}}, Ref_AnyTarget)]))",
    "{{~Permanent}} deals {{Digits}} damage to any target": "Targeted([AnyTarget], ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Ref_AnyTarget)]))",
    "{{~Permanent}} deals {{Digits}} damage to any target. Then amass Orcs {{Digits}}": "Targeted([AnyTarget], ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Ref_AnyTarget), Amass({{Digits[1]}}, Orc)]))",
    "{{~Permanent}} deals {{Digits}} damage to each of your opponents and you gain {{Digits}} life": "ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, EachPlayer(Opponent)), GainLife({{Digits[1]}})])",
    "{{~Permanent}} deals {{Digits}} damage to each opponent": "ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, EachPlayer(Opponent))])",
    "{{~Permanent}} deals {{Digits}} damage to each opponent and you gain {{Digits}} life": "ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, EachPlayer(Opponent)), GainLife({{Digits[1]}})])",
    "{{~Permanent}} deals {{Digits}} damage to each opponent. If this is the second time this ability has resolved this turn, draw a card": "ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, EachPlayer(Opponent)), If(TimesThisAbilityHasResolvedThisTurnIs(EqualTo(Integer(2))), [DrawACard])])",
    "{{~Permanent}} deals {{Digits}} damage to each opponent. If {{Condition}}, it deals {{Digits}} damage to each opponent instead": "ActionList([IfElse({{Condition[0]}}, [PermanentDealsDamage(ThisPermanent, {{Digits[1]}}, EachPlayer(Opponent))], [PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, EachPlayer(Opponent))])])",
    "{{~Permanent}} deals {{Digits}} damage to each player": "ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, EachPlayer(AnyPlayer))])",
    "{{~Permanent}} deals {{Digits}} damage to each {{Creature}}": "ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, EachPermanent({{Creature[0]}}))])",
    "{{~Permanent}} deals {{Digits}} damage to each {{Creature}} and each {{Planeswalker}}": "ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, EachPermanent(Or([{{Creature[0]}}, {{Planeswalker[0]}}])))])",
    "{{~Permanent}} deals {{Digits}} damage to target opponent": "Targeted([TargetPlayer(Opponent)], ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Player(Ref_TargetPlayer))]))",
    "{{~Permanent}} deals {{Digits}} damage to target opponent. Add {{ManaProduceSymbol}}": "Targeted([TargetPlayer(Opponent)], ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Player(Ref_TargetPlayer)), AddMana({{ManaProduceSymbol[0]}})]))",
    "{{~Permanent}} deals {{Digits}} damage to target {{PlayerOrPermanent}}": "Targeted([TargetPlayerOrPermanent({{PlayerOrPermanent[0]}})], ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Ref_TargetPlayerOrPermanent)]))",
    "{{~Permanent}} deals {{Digits}} damage to up to one target {{CreatureOrPlaneswalker}}": "Targeted([UptoOneTargetPermanent({{CreatureOrPlaneswalker[0]}})], ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent))]))",
    "{{~Permanent}} endures {{Digits}}": "Targeted([AnyTarget], ActionList([EndureWithPermanent({{Digits[0]}}, {{~Permanent}})]))",
    "{{~Permanent}} explores": "ActionList([ExploreWithPermanent({{~Permanent}})])",
    "{{~Permanent}} explores. Then destroy all other creatures if its power is exactly {{Digits}}": "ActionList([ExploreWithPermanent({{~Permanent}}), If(PermanentPassesFilter({{~Permanent}}, PowerIs(EqualTo({{Digits[0]}}))), [DestroyEachPermanent(And([Other({{~Permanent}}), IsCardtype(Creature)]))])])",
    "{{~Permanent}} fights up to one target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([Fight({{~Permanent}}, Ref_TargetPermanent)]))",
    "{{~Permanent}} gains your choice of {{Hasable}}, {{Hasable}}, or {{Hasable}} until end of turn": "ActionList([ChooseAnAbility([{{Hasable[0]}}, {{Hasable[1]}}, {{Hasable[2]}}]), CreatePermanentLayerEffectUntil({{~Permanent}}, [AddAbilityVariable(TheChosenAbility)], UntilEndOfTurn)])",
    "{{~Permanent}} gains \"{{QuotedAbility(~Permanent)}}\" until end of turn": "ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [AddAbility([{{QuotedAbility(~Permanent=^~Permanent)[0]}}])], UntilEndOfTurn)])",
    "{{~Permanent}} gains {{Hasable}} until end of turn": "ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "{{~Permanent}} gains {{Hasable}} until end of turn if a creature you control or a card in your hand has {{CheckHasable}}. The same is true for {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, and {{CheckHasable}}": "ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [AddAbilityFromEachPermanentHasable(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]), [{{CheckHasable[0]}}, {{CheckHasable[1]}}, {{CheckHasable[2]}}, {{CheckHasable[3]}}, {{CheckHasable[4]}}, {{CheckHasable[5]}}, {{CheckHasable[6]}}, {{CheckHasable[7]}}, {{CheckHasable[8]}}, {{CheckHasable[9]}}, {{CheckHasable[10]}}, {{CheckHasable[11]}}]), AddAbilityFromCardsInHandHasable(AnyCard, [{{CheckHasable[0]}}, {{CheckHasable[1]}}, {{CheckHasable[2]}}, {{CheckHasable[3]}}, {{CheckHasable[4]}}, {{CheckHasable[5]}}, {{CheckHasable[6]}}, {{CheckHasable[7]}}, {{CheckHasable[8]}}, {{CheckHasable[9]}}, {{CheckHasable[10]}}, {{CheckHasable[11]}}])], UntilEndOfTurn)])",
    "{{~Permanent}} gains {{Hasable}}, {{Hasable}}, and {{Hasable}} until end of turn": "ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}]), AddAbility([{{Hasable[2]}}])], UntilEndOfTurn)])",
    "{{~Permanent}} gets {{PTMod}} and gains {{Hasable}} until end of turn": "ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "{{~Permanent}} gets {{PTMod}} until end of turn": "ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])",
    "{{~Permanent}} gets {{PTMod}} until end of turn for each {{Eachable(ThatPermanent)}}": "ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [AdjustPTForEach({{PTMod[0]}}, {{Eachable(ThatPermanent=^~Permanent)[0]}})], UntilEndOfTurn)])",
    "{{~Permanent}} perpetually gains \"{{PerpetualQuotedAbility}}\"": "ActionList([CreatePerpetualPermanentEffect({{~Permanent}}, [AddAbility([{{PerpetualQuotedAbility[0]}}])])])",
    "{{~Permanent}} perpetually gets {{PTMod}}": "ActionList([CreatePerpetualPermanentEffect({{~Permanent}}, [AdjustPT({{PTMod[0]}})])])"
  },
  "{{TriggerActions(~Permanent,DefendingPlayer)}}": {
    "defending player chooses an untapped creature they control. That creature blocks this creature this turn if able": "ActionList([PlayerAction({{DefendingPlayer}}, ChooseAPermanent(And([IsUntapped, IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(ActionPlayer))]))), CreatePermanentRuleEffectUntil(TheChosenPermanent, [MustBlockAttacker({{~Permanent}})], UntilEndOfTurn)])",
    "defending player chooses {{a}} {{SpecificCard}} in your graveyard. Return that card to your hand. This creature gets {{PTModX}} until end of turn, where X is the mana value of that card": "ActionList([PlayerAction({{DefendingPlayer}}, ChooseACardInPlayersGraveyard({{SpecificCard[0]}}, You)), ReturnGraveyardCardToHand(TheChosenGraveyardCard), CreatePermanentLayerEffectUntil({{~Permanent}}, [AdjustPTX({{PTModX[0]}}, ManaValueOfGraveyardCard(TheChosenGraveyardCard))], UntilEndOfTurn)])",
    "defending player may have you draw a card. If they do, untap this creature and remove it from combat": "ActionList([PlayerMayCost({{DefendingPlayer}}, HavePlayerTakeAction(You, DrawACard)), If(CostWasPaid, [UntapPermanent({{~Permanent}}), RemoveCreatureFromCombat({{~Permanent}})])])",
    "defending player may pay {{ManaCost}}. If that player does, prevent all combat damage that would be dealt by this creature this turn": "ActionList([PlayerMayCost({{DefendingPlayer}}, PayMana({{ManaCost[0]}})), If(CostWasPaid, [CreatePreventDamageUntil(CombatDamageWouldBeDealtByCreature({{~Permanent}}), [PreventThatDamage], UntilEndOfTurn)])])",
    "defending player may pay {{ManaCost}}. If that player doesn't, this creature can't be blocked this turn": "ActionList([PlayerMayCost({{DefendingPlayer}}, PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [CreatePermanentRuleEffectUntil({{~Permanent}}, [CantBeBlocked], UntilEndOfTurn)])])",
    "destroy target creature defending player controls, then put {{a}} {{CounterType}} counter on {{~Permanent}}": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByPlayer({{DefendingPlayer}})]))], ActionList([DestroyPermanent(Ref_TargetPermanent), PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{~Permanent}})]))",
    "exile up to one card of each card type from defending player's graveyard. Put {{a}} {{CounterType}} counter on this creature for each card exiled this way": "ActionList([ExileUptoOneCardOfEachCardTypeFromPlayersGraveyard({{DefendingPlayer}}), PutNumberCountersOfTypeOnPermanent(NumGraveyardCardsExiledThisWay, {{CounterType[0]}}, {{~Permanent}})])",
    "it deals {{Digits}} damage to target creature defending player controls. If that creature is {{a}} {{Zombie}}, this creature deals {{Digits}} damage to it instead": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByPlayer({{DefendingPlayer}})]))], ActionList([IfElse(PermanentPassesFilter(Ref_TargetPermanent, IsCreatureType({{Zombie[0]}})), [PermanentDealsDamage({{~Permanent}}, {{Digits[1]}}, Permanent(Ref_TargetPermanent))], [PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent))])]))",
    "reveal the top card of your library. If it's a creature card, put it onto the battlefield tapped and attacking defending player or a planeswalker they control. Otherwise, put that card into your hand. When you put a creature card onto the battlefield this way, it fights {{~Permanent}}": "ActionList([RevealTopCardOfLibrary, MustCost(PutTopCardOfLibraryOfTypeOnBattlefield(IsCardtype(Creature), [EntersTapped, EntersAttackingPlayerOrPlaneswalkerControlledBy({{DefendingPlayer}})])), IfElse(CostWasPaid, [ReflexiveTrigger(ActionList([HaveCreaturesFight(ThePermanentPutOnTheBattlefieldThisWay, {{~Permanent}})]))], [PutTopOfLibraryInHand])])",
    "roll a d20 for each player being attacked and ignore all but the highest roll.\n{{RawDigits}}-{{RawDigits}} | This creature deals damage equal to {{GameNumber(ThatCreature)}} to you.\n{{RawDigits}}-{{RawDigits}} | This creature deals damage equal to {{GameNumber(ThatCreature)}} to defending player.\n{{RawDigits}} | This creature deals damage equal to {{GameNumber(ThatCreature)}} to each opponent": "ActionList([RollNumberD20AndIgnoreAllButHighest(NumPlayers(IsAttacked)), ValueActions(TheDiceResult, [ValueAction(BetweenValues({{RawDigits[0]}}, {{RawDigits[1]}}), [PermanentDealsDamage({{~Permanent}}, {{GameNumber(ThatCreature=^~Permanent)[0]}}, Player(You))]), ValueAction(BetweenValues({{RawDigits[2]}}, {{RawDigits[3]}}), [PermanentDealsDamage({{~Permanent}}, {{GameNumber(ThatCreature=^~Permanent)[0]}}, Player({{DefendingPlayer}}))]), ValueAction(ExactValue({{RawDigits[4]}}), [PermanentDealsDamage({{~Permanent}}, {{GameNumber(ThatCreature=^~Permanent)[0]}}, EachPlayer(Opponent))])])])",
    "tap target creature defending player controls and put {{a}} {{CounterType}} counter on it. Then {{~Permanent}} deals damage to each opponent equal to the number of tapped creatures that opponent controls": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer({{DefendingPlayer}}))]))], ActionList([TapPermanent(Ref_TargetPermanent), PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent), PermanentDealsDamage({{~Permanent}}, TheNumberOfPermanentsOnTheBattlefield(And([IsTapped, IsCardtype(Creature), ControlledByAPlayer(SinglePlayer({{DefendingPlayer}}))])), EachPlayer(Opponent))]))",
    "target creature defending player controls with power less than or equal to {{~Permanent}}'s power can't block this turn": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByPlayer({{DefendingPlayer}}), PowerIs(LessThanOrEqualTo(PowerOfPermanent({{~Permanent}})))]))], ActionList([CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [CantBlock], UntilEndOfTurn)]))",
    "target creature defending player controls with power less than this creature's power can't block this turn": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByPlayer({{DefendingPlayer}}), PowerIs(LessThan(PowerOfPermanent({{~Permanent}})))]))], ActionList([CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [CantBlock], UntilEndOfTurn)]))",
    "this Equipment deals {{Digits}} damage to target creature defending player controls": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByPlayer({{DefendingPlayer}})]))], ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent))]))",
    "this creature deals {{Digits}} damage to each creature defending player controls": "ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, EachPermanent(And([IsCardtype(Creature), ControlledByPlayer({{DefendingPlayer}})])))])",
    "you and defending player each discard a card or sacrifice a permanent. You draw a card for each land card put into a graveyard this way": "ActionList([EachPlayerChoosesAnAction(Or([SinglePlayer(You), SinglePlayer({{DefendingPlayer}})]), [DiscardACard, SacrificeAPermanent(IsPermanent)]), DrawNumberCards(TheNumberOfCardsPutIntoAGraveyardThisWay(IsCardtype(Land)))])",
    "you and defending player each draw a card, then discard a card. Put {{Number}} {{CounterType}} counters on {{~Permanent}} if you discarded the card with the greatest mana value among those cards or tied for greatest": "ActionList([EachPlayerAction(Or([SinglePlayer(You), SinglePlayer({{DefendingPlayer}})]), DrawACard), EachPlayerAction(Or([SinglePlayer(You), SinglePlayer({{DefendingPlayer}})]), DiscardACard), If(PlayerPassesFilter(You, DiscardedACardWithTheHighestManaValueAmongCardsDiscardedThisWay), [PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[0]}}, {{~Permanent}})])])",
    "you may destroy target artifact defending player controls. If you do, this creature assigns no combat damage this turn": "Targeted([TargetPermanent(And([IsCardtype(Artifact), ControlledByAPlayer(SinglePlayer(DefendingPlayer))]))], ActionList([MayCost(DestroyPermanent(Ref_TargetPermanent)), If(CostWasPaid, [CreatePermanentRuleEffectUntil({{~Permanent}}, [AssignsNoCombatDamage], UntilEndOfTurn)])]))",
    "you may exile target creature defending player controls until this creature leaves the battlefield": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByPlayer({{DefendingPlayer}})]))], ActionList([MayAction(ExilePermanentUntil(Ref_TargetPermanent, UntilPermanentLeavesBattlefield({{~Permanent}})))]))",
    "you may exile up to {{Number}} target {{SpecificCards}} from defending player's graveyard. If you do, you gain {{Digits}} life for each card exiled this way and this creature assigns no combat damage this turn": "Targeted([UptoNumberTargetGraveyardCards({{Number[0]}}, And([{{SpecificCards[0]}}, InAPlayersGraveyard(SinglePlayer({{DefendingPlayer}}))]))], ActionList([MayCost(ExileEachGraveyardCard(Ref_TargetGraveyardCards)), If(CostWasPaid, [GainLifeForEach({{Digits[0]}}, NumGraveyardCardsExiledThisWay), CreatePermanentRuleEffectUntil({{~Permanent}}, [AssignsNoCombatDamage], UntilEndOfTurn)])]))",
    "you may gain control of target artifact defending player controls. If you do, this creature assigns no combat damage this turn": "Targeted([TargetPermanent(And([IsCardtype(Artifact), ControlledByAPlayer(SinglePlayer(DefendingPlayer))]))], ActionList([MayCost(GainControlOfPermanent(Ref_TargetPermanent)), If(CostWasPaid, [CreatePermanentRuleEffectUntil({{~Permanent}}, [AssignsNoCombatDamage], UntilEndOfTurn)])]))",
    "you may gain control of target land defending player controls for as long as you control this creature. If you do, this creature assigns no combat damage this turn": "Targeted([TargetPermanent(And([IsCardtype(Land), ControlledByPlayer({{DefendingPlayer}})]))], ActionList([MayCost(GainControlOfPermanentUntil(Ref_TargetPermanent, UntilPermanentChangesControl(You, {{~Permanent}}))), If(CostWasPaid, [CreatePermanentRuleEffectUntil({{~Permanent}}, [AssignsNoCombatDamage], UntilEndOfTurn)])]))",
    "you may have defending player activate a mana ability of each land they control and lose all unspent mana. If you do, this creature assigns no combat damage this turn and at the beginning of your next main phase this turn, you add an amount of {{ManaProduceSymbol}} equal to the amount of mana that player lost this way": "ActionList([MayCost(HavePlayerTakeAction({{DefendingPlayer}}, ActivateAManaAbilityOfEachPermanentAndLoseUnspentMana(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(ActionPlayer))])))), If(CostWasPaid, [CreatePermanentRuleEffectUntil({{~Permanent}}, [AssignsNoCombatDamage], UntilEndOfTurn), CreateFutureTrigger(AtTheBeginningOfTheNextMainPhaseThisTurn, ActionList([AddManaRepeated({{ManaProduceSymbol[0]}}, TheAmountOfManaLostThisWay)]))])])",
    "you may have defending player play with their hand revealed for as long as this creature remains on the battlefield. If you do, this creature assigns no combat damage this turn": "ActionList([MayCost(CreatePlayerEffectUntil({{DefendingPlayer}}, [PlaysWithHandRevealed], UntilPermanentLeavesBattlefield({{~Permanent}}))), If(CostWasPaid, [CreatePermanentRuleEffectUntil({{~Permanent}}, [AssignsNoCombatDamage], UntilEndOfTurn)])])",
    "you may pay {{ManaCost}}. If you do, destroy target artifact defending player controls and this creature assigns no combat damage this turn": "Targeted([TargetPermanent(And([IsCardtype(Artifact), ControlledByAPlayer(SinglePlayer(DefendingPlayer))]))], ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [DestroyPermanent(Ref_TargetPermanent), CreatePermanentRuleEffectUntil({{~Permanent}}, [AssignsNoCombatDamage], UntilEndOfTurn)])]))",
    "you may put the top {{SpecificCard}} of defending player's graveyard onto the battlefield under your control. If you do, this creature assigns no combat damage this turn": "ActionList([MayCost(PutGraveyardCardOntoBattlefield(TopCardOfTypeOfPlayersGraveyard({{SpecificCard[0]}}, {{DefendingPlayer}}), [EntersUnderPlayersControl(You)])), If(CostWasPaid, [CreatePermanentRuleEffectUntil({{~Permanent}}, [AssignsNoCombatDamage], UntilEndOfTurn)])])",
    "you may sacrifice {{a}} {{Permanent}}. When you do, put {{a}} {{CounterType}} counter on {{~Permanent}}, then it fights up to one target creature defending player controls": "ActionList([MayCost(SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByPlayer({{DefendingPlayer}})]))], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{~Permanent}}), HaveCreaturesFight({{~Permanent}}, Ref_TargetPermanent)])))])])"
  },
  "{{TriggerActions(~Permanent,ThatActivatedAbility)}}": {
    "you may pay {{ManaCost}}. If you do, counter that ability. If you don't, destroy this Aura": "ActionList([MayCost(PayMana({{ManaCost[0]}})), IfElse(CostWasPaid, [CounterAbility(Trigger_ThatActivatedAbility)], [DestroyPermanent({{~Permanent}})])])"
  },
  "{{TriggerActions(~Permanent,ThatArtifact)}}": {
    "choose one -\n* {{TriggerActions_Modal(ThatArtifact)}}.\n* {{TriggerActions_Modal(~Permanent)}}": "Modal_ChooseOne([{{TriggerActions_Modal(ThatArtifact=^ThatArtifact)[0]}}, {{TriggerActions_Modal(~Permanent=^~Permanent)[0]}}])",
    "this Aura deals {{Digits}} damage to that artifact's controller": "ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Player(ControllerOfPermanent({{ThatArtifact}})))])",
    "this enchantment deals {{Digits}} damage to that artifact's controller": "ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Player(ControllerOfPermanent({{ThatArtifact}})))])"
  },
  "{{TriggerActions(~Permanent,ThatAura)}}": {
    "you may search your library for an Aura card with mana value less than or equal to that Aura and with a different name than each Aura you control, put that card onto the battlefield attached to {{~Permanent}}, then shuffle": "ActionList([MayAction(SearchLibrary([FindACardOfType(And([IsEnchantmentType(Aura), ManaValueIs(LessThanOrEqualTo(ManaValueOfPermanent({{ThatAura}}))), DoesntShareANameWithAPermanent(And([IsEnchantmentType(Aura), ControlledByAPlayer(SinglePlayer(You))]))])), PutFoundCardsOntoBattlefield([EntersAttachedToPermanent({{~Permanent}})]), Shuffle]))])"
  },
