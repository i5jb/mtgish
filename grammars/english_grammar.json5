    "Target {{Permanent}} gains {{Hasable}} until end of turn. Sacrifice it at the beginning of the next end step": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([SacrificePermanent(Ref_TargetPermanent)]))]))",
    "Target {{Permanent}} gains {{Hasable}} until end of turn. Tap it": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), TapPermanent(Ref_TargetPermanent)]))",
