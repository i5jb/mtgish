  },
  "{{Spell(~Permanent)}}": {
    "Aura spell that targets this creature": "And([IsEnchantmentType(Aura), TargetsPermanent({{~Permanent}})])",
    "creature spell with mana value equal to {{~Permanent}}'s power": "And([IsCardtype(Creature), ManaValueIs(EqualTo(PowerOfPermanent(ThisPermanent)))])",
