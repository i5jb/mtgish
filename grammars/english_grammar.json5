    "Exile target {{SpecificCard}} from a graveyard. Create a token that's a copy of it, except it's {{a}} {{PT}} {{Black}} {{Zombie}}": "Targeted([TargetGraveyardCard({{SpecificCard[0]}})], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard), CreateTokens([TokenCopyOfExiledCard(TheCardExiledThisWay, TokenCopyEffects([SetPT({{PT[0]}}), SetColor(SimpleColorList([{{Black[0]}}])), SetCreatureTypes([{{Zombie[0]}}])]))])]))",
    "Exile target {{SpecificCard}} from a graveyard. Create {{a}} {{PT}} {{CreatureToken}}": "Targeted([TargetGraveyardCard({{SpecificCard[0]}})], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])]))",
    "Exile target {{SpecificCard}} from a graveyard. Each opponent loses {{Digits}} life": "Targeted([TargetGraveyardCard({{SpecificCard[0]}})], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard), EachPlayerAction(Opponent, LoseLife({{Digits[0]}}))]))",
    "Exile target {{SpecificCard}} from a graveyard. Its owner creates {{a}} {{PT}} {{CreatureToken}} with {{Hasable}}": "Targeted([TargetGraveyardCard({{SpecificCard[0]}})], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard), PlayerAction(OwnerOfGraveyrdCard(Ref_TargetGraveyardCard), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])]))]))",
    "Exile target {{SpecificCard}} from a graveyard. When you do, put X {{CounterType}} counters on target {{Permanent}}, where X is the exiled card's toughness": "Targeted([TargetGraveyardCard({{SpecificCard[0]}})], ActionList([MustCost(ExileGraveyardCard(Ref_TargetGraveyardCard)), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutNumberCountersOfTypeOnPermanent(ToughnessOfExiledCard(TheCardExiledThisWay), {{CounterType[0]}}, Ref_TargetPermanent)])))])]))",
    "Exile target {{SpecificCard}} from a graveyard. You gain {{Digits}} life": "Targeted([TargetGraveyardCard({{SpecificCard[0]}})], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard), GainLife({{Digits[0]}})]))",
    "Exile target {{SpecificCard}} from an opponent's graveyard. You may cast it this turn, and mana of any type can be spent to cast that spell. If that spell would be put into a graveyard, exile it instead": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(Opponent)]))], ActionList([Exile([GraveyardCard(Ref_TargetGraveyardCard)]), CreatePlayerEffectUntil(You, [MayCastExiledCardAndMaySpendManaAsThoughAnyTypeToCastIntoExile(TheCardExiledThisWay)], UntilEndOfTurn)]))",
    "Exile target {{SpecificCard}} from your graveyard": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard)]))",
