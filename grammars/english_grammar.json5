    "Whenever this creature deals damage, {{TriggerActions(ThatMuch)}}": "TriggerA(WhenAPermanentDealsDamage(SinglePermanent(ThisPermanent)), {{TriggerActions(ThatMuch=Trigger_ThatMuch)[0]}})",
