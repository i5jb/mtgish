    "Search target player's library for up to {{Number}} cards and exile them. Then that player shuffles": "Targeted([TargetPlayer(AnyPlayer)], ActionList([SearchPlayersLibrary(Ref_TargetPlayer, [FindUptoNumberGenericCards({{Number[0]}}), ExileFoundCards, Shuffle])]))",
    "Search target player's library for up to {{Number}} {{SpecificCards}} and put them into that player's graveyard. Then the player shuffles": "Targeted([TargetPlayer(AnyPlayer)], ActionList([SearchPlayersLibrary(Ref_TargetPlayer, [FindNumberCardsOfType({{Number[0]}}, {{SpecificCards[0]}}), PutFoundCardsIntoGraveyard, Shuffle])]))",
    "Search the top third of your library, rounded up, for a card. Put that card into your hand, then shuffle": "ActionList([SearchTheTopNumberCardsOfLibrary(ThirdRoundedUp(NumCardsInPlayersLibrary(You)), [FindAGenericCard, PutFoundCardsIntoHand, Shuffle])])",
    "Search your library and graveyard for {{Number}} cards and exile the rest. Put the chosen cards on top of your library in any order. You lose half your life, rounded up": "ActionList([SearchLibraryAndGraveyard([FindNumberGenericCards({{Number[0]}}), SetAsideFoundCards, ExileLibraryAndGraveyard, DontShuffle, PutSetAsideCardsOnTopOfLibrary]), LoseLife(HalfRoundedUp(LifeTotalOfPlayer(ActionPlayer)))])",
    "Search your library and graveyard for {{a}} {{SpecificCard}} and {{a}} {{SpecificCard}}, reveal them, put them into your hand, then shuffle": "ActionList([SearchLibraryAndGraveyard([FindCardsOfType([{{SpecificCard[0]}}, {{SpecificCard[1]}}]), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])",
    "Search your library and graveyard for {{a}} {{SpecificCard}}, {{a}} {{SpecificCard}}, and {{a}} {{SpecificCard}}. Reveal those cards, put them into your hand, then shuffle": "ActionList([SearchLibraryAndGraveyard([FindCardsOfType([{{SpecificCard[0]}}, {{SpecificCard[1]}}, {{SpecificCard[2]}}]), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])",
    "Search your library and/or graveyard for {{a}} {{SpecificCard}}, reveal it, and put it into your hand. If you search your library this way, shuffle": "ActionList([SearchLibraryAndOrGraveyard([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsIntoHand, ShuffleLibraryIfSearched])])",
    "Search your library and/or outside the game for exactly {{Number}} legendary creature cards you own with different names, then reveal those cards. An opponent chooses {{Number}} of them. Put the chosen cards into your hand and shuffle the rest into your library": "ActionList([SearchLibraryAndOrOutsideTheGame([FindExactlyNumberGroupCards({{Number[0]}}, And([IsSupertype(Legendary), IsCardtype(Creature)]), DifferentNames), RevealFoundCards, APlayerChoosesNumberFoundCards(Opponent, {{Number[1]}}), PutChosenFoundCardIntoHand, Shuffle])])",
    "Search your library for a card with the same name as target {{Permanent}}, put that card onto the battlefield, then shuffle": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([SearchLibrary([FindACardOfType(SharesANameWithPermanent(Ref_TargetPermanent)), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle])]))",
    "Search your library for a card, exile it, then shuffle. Any opponent may have you put that card into your hand. If no player does, you draw {{Number}} cards": "ActionList([SearchLibrary([FindAGenericCard, ExileFoundCards, Shuffle]), AnyPlayerMayCost(Opponent, HavePlayerTakeAction(You, PutExiledCardIntoOwnersHand(TheCardExiledThisWay))), Unless(CostWasPaid, [DrawNumberCards({{Number[0]}})])])",
