    "If you would lose the game, instead exile this creature and your life total becomes equal to your starting life total": "ReplaceWouldLoseTheGame(PlayerWouldLoseTheGame(You), [ExilePermanent(ThisPermanent), SetLifeTotal(StartingLifeTotalOfPlayer(You))])",
    "If you would lose the game, instead exile {{~Permanent}} and your life total becomes {{Digits}}": "ReplaceWouldLoseTheGame(PlayerWouldLoseTheGame(You), [ExilePermanent(ThisPermanent), SetLifeTotal({{Digits[0]}})])",
    "If you would lose the game, instead shuffle your hand, your graveyard, and all permanents you own into your library, then draw seven cards and your life total becomes {{Digits}}": "ReplaceWouldLoseTheGame(PlayerWouldLoseTheGame(You), [ShuffleHandGraveyardAndPermanentsIntoLibrary, DrawNumberCards(Integer(7)), SetLifeTotal({{Digits[0]}})])",
    "If you would lose unspent mana, that mana becomes colorless instead": "PlayerEffect(You, [UnspentManaBecomesColorless])",
    "If you would lose unspent mana, that mana becomes {{Black}} instead": "PlayerEffect(You, [UnspentManaBecomesColor({{Black[0]}})])",
    "If you would pay life while your library has at least that many cards in it, exile that many cards from the top of your library instead": "ReplaceWouldPayLife(APlayerWouldPayAnAmountOfLife(SinglePlayer(You), GreaterThanOrEqualTo(NumCardsInPlayersLibrary(You))), [ExileTheTopNumberCardsOfLibrary(WouldPayLife_ThatMuch)])",
    "If you would planeswalk, instead look at the top two cards of your planar deck, put one on the bottom of your planar deck and the other on top, then planeswalk": "ReplaceWouldPlaneswalk(APlayerWouldPlaneswalk(SinglePlayer(You)), [LookAtTheTopNumberCardsOfPlanarDeck(Integer(2), [PutACardOnBottom, PutTheRemainingCardOnTopInAnyOrder]), Planeswalk])",
    "If you would proliferate, proliferate twice instead": "ReplaceWouldProliferate(APlayerWouldProliferate(SinglePlayer(You)), [ProliferateNumberTimes(Integer(2))])",
    "If you would put one or more counters on a creature or planeswalker you control or on yourself, put that many plus one of each of those kinds of counters on that permanent or player instead": "ReplaceWouldPutCounters(APlayerWouldPutCountersOnAPermanentOrAPlayer(SinglePlayer(You), And([Or([IsCardtype(Creature), IsCardtype(Planeswalker)]), ControlledByAPlayer(SinglePlayer(You))]), AnyPlayer), [PutNewAmount(Plus(WouldPutCounters_NumberOfCounters, Integer(1)))])",
    "If you would put one or more counters on a permanent you control, put that many plus one of each of those kinds of counters on that permanent instead":
      "ReplaceWouldPutCounters(APlayerWouldPutCountersOnAPermanent(SinglePlayer(You), And([IsPermanent, ControlledByAPlayer(SinglePlayer(You))])), [PutNewAmount(Plus(WouldPutCounters_NumberOfCounters, Integer(1)))])",
    "If you would put one or more counters on a permanent or player, put twice that many of each of those kinds of counters on that permanent or player instead": "ReplaceWouldPutCounters(APlayerWouldPutCountersOnAPermanentOrAPlayer(SinglePlayer(You), AnyPermanent, AnyPlayer), [PutNewAmount(Twice(WouldPutCounters_NumberOfCounters))])",
    "If you would roll one or more dice, instead roll that many dice plus one and ignore the lowest roll": "ReplaceWouldRollDice(APlayerWouldRollANumberOfDice(SinglePlayer(You)), [RollThatManyPlusOneAndIgnoreLowestInstead])",
    "If you would scry a number of cards, draw that many cards instead": "ReplaceWouldScry(PlayerWouldScry(You), [DrawNumberCards(WouldScry_ThatMuch)])",
    "If you would scry a number of cards, scry that many cards plus one instead": "ReplaceWouldScry(PlayerWouldScry(You), [Scry(Plus(WouldScry_ThatMuch, Integer(1)))])",
    "If {{Condition}}, damage that would reduce your life total to less than {{Digits}} reduces it to {{Digits}} instead": "If({{Condition[0]}}, [PlayerEffect(You, [DamageThatWouldReduceLifeTotalToLessThanNumberReducesItToThatNumberInstead({{Digits[0]}})])])",
    "If {{Condition}}, you can't attack with creatures": "If({{Condition[0]}}, [PlayerEffect(You, [CantAttackWithCreatures(AnyPermanent)])])",
    "If {{Condition}}, you can't cast {{PotentialSpells}}": "If({{Condition[0]}}, [PlayerEffect(You, [CantCastSpells({{PotentialSpells[0]}})])])",
    "If {{Condition}}, you can't lose the game and your opponents can't win the game": "If({{Condition[0]}}, [PlayerEffect(You, [CantLoseTheGame]), EachPlayerEffect(Opponent, [CantWinTheGame])])",
    "If {{a}} {{Black}} or {{Black}} permanent, spell, or card not on the battlefield would be put into a graveyard, exile it instead": "ReplaceWouldPutIntoGraveyard(WouldPutAPermanentASpellOrACardIntoAPlayersGraveyard(Or([IsColor({{Black[0]}}), IsColor({{Black[1]}})]), Or([IsColor({{Black[0]}}), IsColor({{Black[1]}})]), Or([IsColor({{Black[0]}}), IsColor({{Black[1]}})]), AnyPlayer), [ExileItInstead])",
    "If {{a}} {{Creature}} an opponent controls attacks, all {{Creatures}} that opponent controls attack if able": "EachPermanentRuleEffect(And([{{Creature[0]}}, ControlledByAPlayer(Opponent)]), [AttackingCausesOthersToAttack({{Creatures[0]}})])",
    "If {{a}} {{Creature}} attacks, all {{Creatures}} attack if able": "EachPermanentRuleEffect({{Creature[0]}}, [AttackingCausesOthersToAttack({{Creatures[0]}})])",
    "If {{a}} {{Creature}} would die, exile it instead": "ReplaceWouldPutIntoGraveyard(APermanentWouldDie({{Creature[0]}}), [ExileItInstead])",
    "If {{a}} {{Creature}} would die, exile it instead. When you do, create {{a}} {{PT}} {{CreatureToken}}": "ReplaceWouldPutIntoGraveyard(APermanentWouldDie({{Creature[0]}}), [MustCost(ExileItInstead), If(CostWasPaid, [ReflexiveTrigger(ActionList([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])]))])])",
    "If {{a}} {{Creature}} would die, exile that card with {{a}} {{CounterType}} counter on it instead": "ReplaceWouldPutIntoGraveyard(APermanentWouldDie({{Creature[0]}}), [ExileItWithACounterInstead({{CounterType[0]}})])",
    "If {{a}} {{Creature}} would die, instead exile it and put {{a}} {{CounterType}} counter on it": "ReplaceWouldPutIntoGraveyard(APermanentWouldDie({{Creature[0]}}), [ExileItInstead, PutACounterOnExiledCard({{CounterType[0]}}, TheCardExiledThisWay)])",
    "If {{a}} {{Creature}} would die, return it to its owner's hand instead": "ReplaceWouldPutIntoGraveyard(APermanentWouldDie({{Creature[0]}}), [PutItInOwnersHandInstead])",
    "If {{a}} {{Permanent}} dealing combat damage to a player causes a triggered ability of {{a}} {{Permanent}} to trigger, that ability triggers an additional time": "APermanentDealingCombatDamageToAPlayerCausesAbilitiesToTriggerAnAdditionalTime({{Permanent[0]}}, AnyPlayer, AbilityOfAPermanent({{Permanent[1]}}))",
    "If {{a}} {{Permanent}} would explore, instead it explores, then it explores again": "ReplaceWouldExplore(APermanentWouldExplore({{Permanent[0]}}), [ItExplores, ItExplores])",
    "If {{a}} {{Permanent}} would explore, instead you scry {{Digits}}, then that creature explores": "ReplaceWouldExplore(APermanentWouldExplore({{Permanent[0]}}), [Scry({{Digits[0]}}), ItExplores])",
    "If {{a}} {{SpecificCard}} would be put into your graveyard from anywhere and it wasn't cycled, exile it instead": "ReplaceWouldPutIntoGraveyard(WouldPutACardInPlayersGraveyardFromAnywhereNotCycled({{SpecificCard[0]}}, You), [ExileItInstead])",
    "If {{a}} {{Zombie}} you control entering causes a triggered ability of a permanent you control to trigger, that ability triggers an additional time": "APermanentEnteringTheBattlefieldCausesAbilitiesToTriggerAnAdditionalTime(And([IsCreatureType({{Zombie[0]}}), ControlledByAPlayer(SinglePlayer(You))]), AbilityOfAPermanent(ControlledByAPlayer(SinglePlayer(You))))",
    "If {{a}} {{Zombie}} {{Zombie}} would be put into your graveyard from the battlefield, exile it instead": "ReplaceWouldPutIntoGraveyard(WouldPutAPermanentIntoPlayersGraveyard(And([IsCreatureType({{Zombie[0]}}), IsCreatureType({{Zombie[1]}})]), You), [ExileItInstead])",
    "Instant and sorcery spells you cast with mana value {{Digits}} or greater cost {{CostReduce}} less to cast": "PlayerEffect(You, [DecreaseSpellCost(And([Or([IsCardtype(Instant), IsCardtype(Sorcery)]), ManaValueIs(GreaterThanOrEqualTo({{Digits[0]}}))]), {{CostReduce[0]}})])",
    "It can't become night": "ItCantBecomeNight",
    "Lands can't enter the battlefield": "CardsCantEnterTheBattlefield(IsCardtype(Land))",
    "Lands you control and land cards in your library are basic": "EachPermanentLayerEffect(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You))]), [AddSupertype(Basic)]), EachCardInPlayersLibraryEffect(IsCardtype(Land), You, [AddSupertype(Basic)])",
    "Lands you control and land cards you own that aren't on the battlefield are {{Swamps}} in addition to their other types": "EachPermanentLayerEffect(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You))]), [AddLandType({{Swamps[0]}})]), CardEffect(And([IsCardtype(Land), OwnedByAPlayer(SinglePlayer(You))]), [AddLandType({{Swamps[0]}})])",
    "Lethal damage dealt to {{Creatures}} is determined by their power rather than their toughness": "EachPermanentRuleEffect({{Creatures[0]}}, [DetermineLethalDamageUsingPowerRatherThanToughness])",
    "Loyalty abilities of {{Planeswalkers}} cost {{ManaCost}} more to activate": "EachPlayerEffect(AnyPlayer, [IncreaseAbilityCost(And([LoyaltyAbility, AbilityOfAPermanent({{Planeswalkers[0]}})]), PayMana({{ManaCost[0]}}))])",
    "Max speed - If you would draw a card, draw {{Number}} cards instead": "MaxSpeed(ReplaceWouldDraw(APlayerWouldDrawACard(SinglePlayer(You)), [DrawNumberCards({{Number[0]}})]))",
    "Max speed - Spells you cast cost {{CostReduce}} less to cast": "MaxSpeed(PlayerEffect(You, [DecreaseSpellCost(AnySpell, {{CostReduce[0]}})]))",
    "Max speed - You may pay {{ManaCost}} rather than pay the unearth cost of the first unearth ability you activate each turn": "PlayerEffect(You, [MayPayAlternateCostForFirstUnearthCostEachTurn({{ManaCost[0]}})])",
    "Ninjutsu abilities you activate cost {{CostReduce}} less to activate": "PlayerEffect(You, [DecreaseNinjutsuAbilityCost({{CostReduce[0]}})])",
    "No more than one creature can attack each combat": "NoMoreThanNumberCreaturesCanAttack(Integer(1))",
    "No more than one creature can attack you each combat": "NoMoreThanNumberCreaturesCanAttackPlayer(Integer(1), You)",
    "No more than one creature can block each combat": "NoMoreThanNumberCreaturesCanBlock(Integer(1))",
    "No more than two creatures can attack each combat": "NoMoreThanNumberCreaturesCanAttack(Integer(2))",
    "No more than two creatures can attack you each combat": "NoMoreThanNumberCreaturesCanAttackPlayer(Integer(2), You)",
    "No more than two creatures can block each combat": "NoMoreThanNumberCreaturesCanBlock(Integer(2))",
    "Noncreature spells you cast from exile have convoke": "PlayerEffect(You, [SpellsCastHaveAbility(And([IsNonCardtype(Creature), WasCastFromExile]), [Convoke])])",
    "Noncreature spells your opponents cast with mana value {{Digits}} or greater cost {{ManaCost}} more to cast": "EachPlayerEffect(Opponent, [IncreaseSpellCost(And([IsNonCardtype(Creature), ManaValueIs(GreaterThanOrEqualTo({{Digits[0]}}))]), PayMana({{ManaCost[0]}}))])",
    "Nonland permanents you control and permanent spells you control are enchantments in addition to their other types": "EachPermanentLayerEffect(And([IsNonCardtype(Land), IsPermanent, ControlledByAPlayer(SinglePlayer(You))]), [AddCardtype(Enchantment)]), StackSpellsEffect(And([IsPermanent, ControlledByAPlayer(SinglePlayer(You))]), [AddCardtype(Enchantment)])",
    "Note the mana value of each card as it's put into exile": "PlayerEffect(You, [NoteManaValueOfExiledCard])",
    "Once during each of your turns, you may cast a noncreature, non-Aura permanent spell from your graveyard. If you do, it perpetually becomes {{a}} {{PT}} {{Zombie}} creature in addition to its other types": "If(IsPlayersTurn(You), [PlayerEffect(You, [MayCastASpellFromTheirGraveyardOnceEachTurnWithEffect(And([IsNonCardtype(Creature), IsNonEnchantmentType(Aura), IsPermanent]), [CastWithPerpetualEffect([SetPT({{PT[0]}}), AddCreatureType({{Zombie[0]}}), AddCardtype(Creature)])])])])",
    "Once during each of your turns, you may cast a spell from your hand by paying life equal to its mana value rather than paying its mana cost": "PlayerEffect(You, [OnceEachTurnMayAction(CastASpellFromHandForAlternateCost(AnySpell, PayLifeEqualToItsManaValue))])",
    "Once during each of your turns, you may cast an artifact spell from your graveyard. If you cast a spell this way, that artifact enters tapped": "If(IsPlayersTurn(You), [PlayerEffect(You, [MayCastASpellFromTheirGraveyardOnceEachTurnWithEffect(IsCardtype(Artifact), [EntersTapped])])])",
    "Once during each of your turns, you may cast {{a}} {{Spell}} by paying life equal to its mana value rather than paying its mana cost": "PlayerEffect(You, [MayCastASpellForAlternateCostOnceDuringEachPlayersTurn({{Spell[0]}}, PayLife(ManaValueOfSpell(ThatSpell)), SinglePlayer(You))])",
    "Once during each of your turns, you may cast {{a}} {{Spell}} from among cards in your graveyard that were milled this turn": "If(IsPlayersTurn(You), [PlayerEffect(You, [MayCastASpellFromAmongCardsInPlayersGraveyardOnceEachTurn({{Spell[0]}}, WasMilledIntoGraveyardThisTurn, You)])])",
    "Once during each of your turns, you may cast {{a}} {{Spell}} from among cards in your graveyard that were put there from anywhere other than the battlefield this turn": "If(IsPlayersTurn(You), [PlayerEffect(You, [MayCastASpellFromAmongCardsInPlayersGraveyardOnceEachTurn({{Spell[0]}}, WasPutIntoGraveyardFromAnywhereOtherThanTheBattlefieldThisTurn, You)])])",
    "Once during each of your turns, you may cast {{a}} {{Spell}} from your graveyard": "PlayerEffect(You, [MayCastASpellFromGraveyardOnceEachPlayersTurn({{Spell[0]}}, You)])",
    "Once during each of your turns, you may cast {{a}} {{Spell}} from your graveyard by exiling {{Number}} other cards from your graveyard in addition to paying its other costs": "PlayerEffect(You, [MayCastASpellFromGraveyardWithAdditionalCostOnceEachPlayersTurn({{Spell[0]}}, ExileNumberGraveyardCards({{Number[0]}}, InAPlayersGraveyard(SinglePlayer(You))), You)])",
    "Once during each of your turns, you may cast {{a}} {{Spell}} from your graveyard by sacrificing {{a}} {{Permanent}} in addition to paying its other costs": "PlayerEffect(You, [MayCastASpellFromGraveyardWithAdditionalCostOnceEachPlayersTurn({{Spell[0]}}, SacrificeAPermanent({{Permanent[0]}}), You)])",
    "Once during each of your turns, you may cast {{a}} {{Spell}} from your graveyard by sacrificing {{a}} {{Permanent}} in addition to paying its other costs. If a spell cast this way would be put into your graveyard, exile it instead": "PlayerEffect(You, [MayCastASpellFromGraveyardIntoExileWithAdditionalCostOnceEachPlayersTurn({{Spell[0]}}, [SacrificeAPermanent({{Permanent[0]}})], You)])",
    "Once during each of your turns, you may cast {{a}} {{Spell}} from your graveyard. If a spell cast this way would be put into your graveyard, exile it instead": "PlayerEffect(You, [OnceDuringEachPlayersTurnMayAction(You, MayCastASpellFromGraveyardIntoExile({{Spell[0]}}, You))])",
    "Once during each of your turns, you may cast {{a}} {{Spell}} from your hand or the top of your library without paying its mana cost": "PlayerEffect(You, [MayCastASpellFromHandOrTopOfLibraryWithoutPayingOnceEachPlayersTurn({{Spell[0]}})])",
    "Once during each of your turns, you may cast {{a}} {{Spell}} from your hand without paying its mana cost": "PlayerEffect(You, [MayCastASpellFromHandWithoutPayingOnceEachPlayersTurn({{Spell[0]}})])",
    "Once during each of your turns, you may play a historic land or cast a historic permanent spell from your graveyard. If you do, it gains \"{{QuotedAbility}}\"": "PlayerEffect(You, [MayPlayALandOrCastASpellFromTheirGraveyardOnceEachPlayersTurnWithEffect(And([IsHistoric, IsCardtype(Land)]), And([IsHistoric, IsPermanent]), You, [AddAbility([{{QuotedAbility[0]}}])])])",
    "Once during each of your turns, you may play a land from your graveyard or cast a permanent spell with mana value {{Digits}} or less from your graveyard. If you do, it gains \"{{QuotedAbility}}\"": "PlayerEffect(You, [MayPlayALandOrCastASpellFromTheirGraveyardOnceEachPlayersTurnWithEffect(IsCardtype(Land), And([IsPermanent, ManaValueIs(LessThanOrEqualTo({{Digits[0]}}))]), You, [AddAbility([{{QuotedAbility[0]}}])])])",
    "Once during each of your turns, you may play a land or cast a permanent spell from among cards in your graveyard that were put there from your library this turn": "PlayerEffect(You, [MayPlayALandOrCastASpellFromAmongCardsInTheirGraveyardThatWerePutThereFromTheirLibraryOnceEachPlayers(IsCardtype(Land), IsPermanent, AnyCard, You)])",
    "Once during each of your turns, you may play a land or cast a spell from among the cards exiled with this permanent without paying its mana cost": "PlayerEffect(You, [OnceDuringEachPlayersTurnMayAction(You, PlayALandOrCastASpellFromAmongExiledCardsWithoutPaying(IsCardtype(Land), AnySpell, WasExiledWithPermanent(ThisPermanent)))])",
    "Once each turn, you may cast a spell with mana value less than or equal to {{GameNumber}} from among cards exiled with {{~Permanent}} this turn without paying its mana cost": "PlayerEffect(You, [MayCastASpellFromAmongExileWithoutPayingOnceEachTurn(ManaValueIs(LessThanOrEqualTo({{GameNumber[0]}})), And([TheExiledCards, WasExiledThisTurn]))])",
    "Once each turn, you may cast {{a}} {{PotentialSpell}} from the top of your library": "PlayerEffect(You, [MayCastASpellFromTopOfLibraryOnceEachTurn({{PotentialSpell[0]}})])",
    "Once each turn, you may pay {{ManaCost}} rather than pay the mana cost for a spell you cast that you don't own with mana value {{Digits}} or less": "PlayerEffect(You, [MayPayAlternateCostForASpellOnceEachTurn({{ManaCost[0]}}, And([OwnedByAPlayer(Other(You)), ManaValueIs(LessThanOrEqualTo({{Digits[0]}}))]))])",
    "Once each turn, you may pay {{ManaCost}} rather than pay the mana cost for {{a}} {{PotentialSpell}} you cast from exile": "PlayerEffect(You, [MayPayAlternateCostForASpellOnceEachTurn({{ManaCost[0]}}, And([{{PotentialSpell[0]}}, WasCastFromExile]))])",
    "Once each turn, you may pay {{ManaCost}} rather than pay the mana cost for {{a}} {{PotentialSpell}} you cast from your hand": "PlayerEffect(You, [MayPayAlternateCostForASpellOnceEachTurn({{ManaCost[0]}}, And([{{PotentialSpell[0]}}, WasCastFromPlayersHand(You)]))])",
    "Once each turn, you may pay {{ManaCost}} to reroll one or more dice you rolled": "PlayerEffect(You, [OnceEachTurnMayPayToRerollAnyNumberOfDiceRolled(PayMana({{ManaCost[0]}}))])",
    "Once each turn, you may play a card from exile with {{a}} {{CounterType}} counter on it if it was exiled by an ability you controlled, and you may spend mana as though it were mana of any color to cast it": "PlayerEffect(You, [OnceEachTurnMayAction(PlayAnExiledCardAndMaySpendManaAsThoughAnyColorToCast(And([HasACounterOfType({{CounterType[0]}}), WasExiledWithAnAbility(ControlledByAPlayer(SinglePlayer(You)))])))])",
    "Once each turn, you may play a historic land or cast a historic spell from the top of your library. When you do, create a Food token": "PlayerEffect(You, [OnceEachTurnMayAction(PlayALandFromTopOfLibraryOrCastASpellFromTopOfLibraryWithTrigger(IsHistoric, IsHistoric, ActionList([CreateTokens([FoodToken])])))])",
    "Other creatures you control are {{Zombies}} in addition to their other types. The same is true for creature spells you control and creature cards you own that aren't on the battlefield": "EachPermanentLayerEffect(And([Other(ThisPermanent), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]), [AddCreatureType({{Zombies[0]}})]), StackSpellsEffect(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]), [AddCreatureType({{Zombies[0]}})]), CardEffect(And([IsCardtype(Creature), OwnedByAPlayer(SinglePlayer(You))]), [AddCreatureType({{Zombies[0]}})])",
    "Other {{Creatures}} get {{PTMod}}": "EachPermanentLayerEffect(And([Other(ThisPermanent), {{Creatures[0]}}]), [AdjustPT({{PTMod[0]}})])",
    "Other {{Permanents}} are Food artifacts in addition to their other types and have \"{{QuotedAbility}}\"": "EachPermanentLayerEffect(And([Other(ThisPermanent), {{Permanents[0]}}]), [AddArtifactType(Food), AddCardtype(Artifact), AddAbility([{{QuotedAbility[0]}}])])",
    "Other {{Permanents}} enter with an additional {{CounterType}} counter on them for each {{Eachable[ThatEnteringPermanent]}}": "ReplaceWouldEnter(APermanentWouldEnterTheBattlefield(And([Other(ThisPermanent), {{Permanents[0]}}])), [EntersWithNumberCounters({{Eachable[ThatEnteringPermanent][0]}}, {{CounterType[0]}})])",
    "Other {{Permanents}} enter with an additional {{CounterType}} counter on them for each {{Eachable}}": "ReplaceWouldEnter(APermanentWouldEnterTheBattlefield(And([Other(ThisPermanent), {{Permanents[0]}}])), [EntersWithNumberCounters({{Eachable[0]}}, {{CounterType[0]}})])",
    "Other {{Permanents}} have {{Hasable}}": "EachPermanentLayerEffect(And([Other(ThisPermanent), {{Permanents[0]}}]), [AddAbility([{{Hasable[0]}}])])",
    "Permanent spells you cast that have an Adventure cost {{CostReduce}} less to cast": "PlayerEffect(You, [DecreaseSpellCost(And([IsPermanent, HasAnAdventure]), {{CostReduce[0]}})])",
    "Permanents can't phase in": "PermanentsCantPhaseIn(AnyPermanent)",
    "Permanents entering don't cause abilities of permanents your opponents control to trigger": "PermanentsEnteringTheBattlefieldDontCauseAbilitiesToTrigger(And([IsPermanent, ControlledByAPlayer(Opponent)]))",
    "Planeswalkers' loyalty abilities you activate cost an additional {{LoyaltyCostAdjust}} to activate": "PlayerEffect(You, [IncreaseAbilityCost(And([LoyaltyAbility, AbilityOfAPermanent(IsCardtype(Planeswalker))]), {{LoyaltyCostAdjust[0]}})])",
    "Play with the top card of your library revealed": "PlayerEffect(You, [PlaysWithTopOfLibraryRevealed])",
    "Play with your hand revealed": "PlayerEffect(You, [PlaysWithHandRevealed])",
    "Players can cast spells and activate abilities only during their own turns": "EachPlayerEffect(AnyPlayer, [CanCastSpellsOnlyDuringTheirTurn, CanActivateAbilitiesOnlyDuringTheirTurn])",
    "Players can cast spells only during their own turns": "EachPlayerEffect(AnyPlayer, [CanCastSpellsOnlyDuringTheirTurn])",
    "Players can't activate planeswalkers' loyalty abilities": "EachPlayerEffect(AnyPlayer, [CantActivateAbilities(And([AbilityOfAPermanent(IsCardtype(Planeswalker)), LoyaltyAbility]))])",
    "Players can't cast spells during combat": "If(IsDuringCombat, [EachPlayerEffect(AnyPlayer, [CantCastSpells(AnySpell)])])",
    "Players can't cast spells from graveyards or activate abilities of cards in graveyards": "EachPlayerEffect(AnyPlayer, [CantCastSpellsFromGraveyards(AnySpell), CantActivateAbilitiesOfCardsInGraveyards])",
    "Players can't cast spells or play lands with a name originally printed in the Arabian Nights expansion": "EachPlayerEffect(AnyPlayer, [CantCastSpells(SharesANameOriginallyPrintedInArabianNights), CantPlayLandsOfType(SharesANameOriginallyPrintedInArabianNights)])",
    "Players can't cast {{PotentialSpells}}": "EachPlayerEffect(AnyPlayer, [CantCastSpells({{PotentialSpells[0]}})])",
    "Players can't cast {{PotentialSpells}} from graveyards": "EachPlayerEffect(AnyPlayer, [CantCastSpellsFromGraveyards({{PotentialSpells[0]}})])",
    "Players can't cast {{PotentialSpells}} from graveyards or exile": "EachPlayerEffect(AnyPlayer, [CantCastSpellsFromGraveyards({{PotentialSpells[0]}}), CantCastSpellsFromExile({{PotentialSpells[0]}})])",
    "Players can't cast {{PotentialSpells}} from graveyards or libraries": "EachPlayerEffect(AnyPlayer, [CantCastSpellsFromGraveyards({{PotentialSpells[0]}}), CantCastSpellsFromLibraries({{PotentialSpells[0]}})])",
    "Players can't cycle cards": "EachPlayerEffect(AnyPlayer, [CantCycleCards])",
    "Players can't draw cards": "EachPlayerEffect(AnyPlayer, [CantDrawCards])",
    "Players can't draw cards or gain life": "EachPlayerEffect(AnyPlayer, [CantDrawCards, CantGainLife])",
    "Players can't gain life": "EachPlayerEffect(AnyPlayer, [CantGainLife])",
    "Players can't get counters": "EachPlayerEffect(AnyPlayer, [CantGetAnyCounters])",
    "Players can't pay life or sacrifice {{Permanents}} to cast spells or activate abilities": "EachPlayerEffect(AnyPlayer, [CantPayLifeToCastSpells(AnySpell), CantPayLifeToActivateAbilities(AnyAbility), CantSacrificePermanentsToCastSpells({{Permanents[0]}}, AnySpell), CantSacrificePermanentsToActivateAbilities({{Permanents[0]}}, AnyAbility)])",
    "Players can't pay life to cast spells or to activate abilities that aren't mana abilities": "EachPlayerEffect(AnyPlayer, [CantPayLifeToCastSpells(AnySpell), CantPayLifeToActivateAbilities(NonManaAbility)])",
    "Players can't play lands": "EachPlayerEffect(AnyPlayer, [CantPlayLands])",
    "Players can't play lands as long as {{Condition}}": "If({{Condition[0]}}, [EachPlayerEffect(AnyPlayer, [CantPlayLands])])",
    "Players can't play nonbasic lands with the same name as a nontoken permanent": "EachPlayerEffect(AnyPlayer, [CantPlayLandsOfType(And([IsNonSupertype(Basic), IsCardtype(Land), SharesANameWithAPermanent(IsNonToken)]))])",
    "Players can't search libraries": "EachPlayerEffect(AnyPlayer, [CantSearchLibraries])",
    "Players can't search libraries. Any player may pay {{ManaCost}} for that player to ignore this effect until end of turn": "PlayerEffect_PlayerMayPayToIgnoreEffectUntil(AnyPlayer, [CantSearchLibraries], PayMana({{ManaCost[0]}}), UntilEndOfTurn)",
    "Players can't untap more than one artifact during their untap steps": "EachPlayerEffect(AnyPlayer, [CantUntapMoreThanNumberPermanentsDuringTheirUntapStep(Integer(1), IsCardtype(Artifact))])",
    "Players can't untap more than one creature during their untap steps": "EachPlayerEffect(AnyPlayer, [CantUntapMoreThanNumberPermanentsDuringTheirUntapStep(Integer(1), IsCardtype(Creature))])",
    "Players can't untap more than one nonbasic land during their untap steps": "EachPlayerEffect(AnyPlayer, [CantUntapMoreThanNumberPermanentsDuringTheirUntapStep(Integer(1), And([IsNonSupertype(Basic), IsCardtype(Land)]))])",
    "Players don't lose unspent mana as steps and phases end": "EachPlayerEffect(AnyPlayer, [DoesntLoseManaAsStepsAndPhasesEnd])",
    "Players have no maximum hand size": "EachPlayerEffect(AnyPlayer, [HasNoMaximumHandSize])",
    "Players may cast {{PotentialSpells}} as though they had flash": "EachPlayerEffect(AnyPlayer, [MayCastSpellsAsThoughTheyHadFlash({{PotentialSpells[0]}})])",
    "Players may spend mana as though it were mana of any color": "EachPlayerEffect(AnyPlayer, [MaySpendManaAsThoughItWasAnyColor])",
    "Players play with the top card of their libraries revealed": "EachPlayerEffect(AnyPlayer, [PlaysWithTopOfLibraryRevealed])",
    "Players play with their hands revealed": "EachPlayerEffect(AnyPlayer, [PlaysWithHandRevealed])",
    "Players reveal each card they draw": "EachPlayerEffect(AnyPlayer, [RevealsEachCardDrawn])",
    "Players skip their untap steps": "EachPlayerEffect(AnyPlayer, [SkipsUntapStep])",
    "Players skip their upkeep steps": "EachPlayerEffect(AnyPlayer, [SkipsUpkeepStep])",
    "Plotting cards from your hand costs {{CostReduce}} less": "PlayerEffect(You, [DecreasePlotFromHandCost({{CostReduce[0]}})])",
    "Prevent all combat damage that would be dealt by {{Creatures}}": "PreventDamage(CombatDamageWouldBeDealtByACreature({{Creatures[0]}}), [PreventThatDamage])",
    "Prevent all combat damage that would be dealt to and dealt by {{Creatures}}": "PreventDamage(Or([CombatDamageWouldBeDealtByACreature({{Creatures[0]}}), CombatDamageWouldBeDealtToARecipient(APermanent({{Creatures[0]}}))]), [PreventThatDamage])",
    "Prevent all combat damage that would be dealt to {{Creatures}}": "PreventDamage(CombatDamageWouldBeDealtToARecipient(APermanent({{Creatures[0]}})), [PreventThatDamage])",
    "Prevent all damage that would be dealt by {{StackSpells}}": "PreventDamage(DamageWouldBeDealtByASpell({{StackSpells[0]}}), [PreventThatDamage])",
    "Prevent all damage that would be dealt to you": "PreventDamage(DamageWouldBeDealtToRecipient(Player(You)), [PreventThatDamage])",
    "Prevent all damage that would be dealt to you by {{DamageSources}}": "PreventDamage(DamageWouldBeDealtByASourceToRecipient({{DamageSources[0]}}, Player(You)), [PreventThatDamage])",
    "Prevent all damage that would be dealt to {{CreaturesOrPlaneswalkers}}": "PreventDamage(DamageWouldBeDealtToARecipient(APermanent({{CreaturesOrPlaneswalkers[0]}})), [PreventThatDamage])",
    "Prevent all damage that would be dealt to {{Creatures}}": "PreventDamage(DamageWouldBeDealtToARecipient(APermanent({{Creatures[0]}})), [PreventThatDamage])",
    "Prevent all damage that would be dealt to {{Creatures}} by {{DamageSources}}": "PreventDamage(DamageWouldBeDealtByASourceToARecipient({{DamageSources[0]}}, APermanent({{Creatures[0]}})), [PreventThatDamage])",
    "Prevent all damage that would be dealt to {{a}} {{Creature}} by another {{Creature}} if they share a color": "PreventDamage(DamageWouldBeDealtByAPermanentToARecipient({{Creature[1]}}, APermanent(And([Other(WouldDealDamage_ThatPermanent), {{Creature[0]}}, SharesAColorWithPermanent(WouldDealDamage_ThatPermanent)]))), [PreventThatDamage])",
    "Prevent all noncombat damage that would be dealt to other {{Creatures}}": "PreventDamage(NoncombatDamageWouldBeDealtToARecipient(APermanent(And([Other(ThisPermanent), {{Creatures[0]}}]))), [PreventThatDamage])",
    "Prevent all noncombat damage that would be dealt to you and creatures you control": "PreventDamage(NoncombatDamageWouldBeDealtToARecipient(APlayerOrAPermanent(SinglePlayer(You), And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))), [PreventThatDamage])",
    "Prevent all noncombat damage that would be dealt to you and other {{Permanents}}": "PreventDamage(NoncombatDamageWouldBeDealtToARecipient(APlayerOrAPermanent(SinglePlayer(You), And([Other(ThisPermanent), {{Permanents[0]}}]))), [PreventThatDamage])",
    "Prevent all noncombat damage that would be dealt to {{Creatures}}": "PreventDamage(NoncombatDamageWouldBeDealtToARecipient(APermanent({{Creatures[0]}})), [PreventThatDamage])",
    "Rather than pay the mana cost for a spell, its controller may discard a card that shares a color with that spell": "EachPlayerEffect(AnyPlayer, [MayPayAlternateCostForSpells(DiscardACardOfType(SharesAColorWithIt), AnySpell)])",
    "Rather than the attacking player, you assign the combat damage of each creature attacking you. You can divide that creature's combat damage as you choose among any of the creatures blocking it": "PlayerEffect(You, [AssignsCombatDamageOfAttackingCreatures(And([IsCardtype(Creature), IsAttackingPlayer(You)]))])",
    "Reveal the first card you draw each turn. Whenever you reveal {{a}} {{SpecificCard}} this way, {{TriggerActions}}": "PlayerEffect(You, [RevealFirstCardDrawnDuringEachPlayersTurn(AnyPlayer)]), TriggerA(WhenAPlayerRevealsFirstCardDrawn(SinglePlayer(You), {{SpecificCard[0]}}), {{TriggerActions[0]}})",
    "Room abilities of dungeons you own trigger an additional time": "AbilitiesTriggerAnAdditionalTime(RoomAbilityOfDungeon(OwnedByAPlayer(SinglePlayer(You))))",
    "Skip your draw step": "PlayerEffect(You, [SkipsDrawStep])",
    "Skip your upkeep step if {{Condition}}": "If({{Condition[0]}}, [PlayerEffect(You, [SkipsUpkeepStep])])",
    "Spells and abilities can't be countered": "StackEffect(AnySpellOrAbility, [CantBeCountered])",
    "Spells and abilities your opponents control can't cause their controller to search their library": "EachPlayerEffect(Opponent, [SpellsAndAbilitiesTheyCantCantCauseThemToSearchTheirLibrary])",
    "Spells and abilities your opponents control can't cause you to discard cards or sacrifice permanents": "PlayerEffect(You, [CantBeCausedToDiscardCardsBySpellAndAbilities(ControlledByAPlayer(Opponent)), CantBeCausedToSacrificePermanentsBySpellAndAbilities(AnyPermanent, ControlledByAPlayer(Opponent))])",
    "Spells and abilities your opponents control can't cause you to sacrifice permanents": "PlayerEffect(You, [CantBeCausedToSacrificePermanentsBySpellAndAbilities(AnyPermanent, ControlledByAPlayer(Opponent))])",
    "Spells cast from among cards you drew this turn cost {{CostReduce}} less to cast": "StackSpellsEffect(AmongCardsDrawByPlayerThisTurn(You), [DecreaseManaCost({{CostReduce[0]}})])",
    "Spells cast from among cards your opponents drew this turn cost {{ManaCost}} more to cast": "StackSpellsEffect(AmongCardsDrawByAPlayerThisTurn(Opponent), [IncreaseManaCost({{ManaCost[0]}})])",
    "Spells cost an additional \"{{SacrificeAPermanentCost}}\" to cast for each {{Black}} mana symbol in their mana costs": "StackSpellsEffect(AnySpell, [AdditionalCostForEachColorManaSymbolInCosts({{SacrificeAPermanentCost[0]}}, {{Black[0]}})])",
    "Spells you cast cost {{CostReduce}} less to cast for each card with the same name as that spell in your graveyard": "PlayerEffect(You, [DecreaseSpellCostForEach(AnySpell, {{CostReduce[0]}}, TheNumberOfGraveyardCards(And([SharesANameWithSpell(DecreaseSpellCost_ThatSpell), InAPlayersGraveyard(SinglePlayer(You))])))])",
    "Spells you cast cost {{CostReduce}} less to cast for each target": "PlayerEffect(You, [DecreaseSpellCostForEachTarget(AnySpell, {{CostReduce[0]}})])",
    "Spells you cast from anywhere other than your hand cost {{CostReduce}} less to cast": "PlayerEffect(You, [DecreaseSpellCost(WasntCastFromTheirHand, {{CostReduce[0]}})])",
    "Spells you cast from exile have convoke": "PlayerEffect(You, [SpellsCastHaveAbility(WasCastFromExile, [Convoke])])",
    "Spells you cast from your graveyard cost {{CostReduce}} less to cast": "PlayerEffect(You, [DecreaseSpellCost(WasCastFromAPlayersGraveyard(SinglePlayer(You)), {{CostReduce[0]}})])",
    "Spells you cast from your graveyard or from exile cost {{CostReduce}} less to cast": "PlayerEffect(You, [DecreaseSpellCost(Or([WasCastFromAPlayersGraveyard(SinglePlayer(You)), WasCastFromExile]), {{CostReduce[0]}})])",
    "Spells you cast have affinity for {{Zombies}}": "PlayerEffect(You, [SpellsCastHaveAbility(AnySpell, [Affinity(IsCreatureType({{Zombies[0]}}))])])",
    "Spells you cast have delve": "PlayerEffect(You, [SpellsCastHaveAbility(AnySpell, [Delve])])",
    "Spells you cast have ripple {{Digits}}": "PlayerEffect(You, [SpellsCastHaveAbility(AnySpell, [Ripple({{Digits[0]}})])])",
    "Spells you cast that target {{a}} {{Permanent}} cost {{CostReduce}} less to cast": "PlayerEffect(You, [DecreaseSpellCost(TargetsAPermanent({{Permanent[0]}}), {{CostReduce[0]}})])",
    "Spells you cast with mana value {{Digits}} or greater cost {{CostReduce}} less to cast and can't be countered": "PlayerEffect(You, [DecreaseSpellCost(ManaValueIs(LessThanOrEqualTo({{Digits[0]}})), {{CostReduce[0]}}), SpellsCastHaveAbility(ManaValueIs(LessThanOrEqualTo({{Digits[0]}})), [CantBeCountered])])",
    "Spells you cast with mana value {{Digits}} or greater have cascade": "PlayerEffect(You, [SpellsCastHaveAbility(ManaValueIs(GreaterThanOrEqualTo({{Digits[0]}})), [Cascade])])",
    "Spells your opponents cast cost {{ManaCost}} more to cast for each target": "EachPlayerEffect(Opponent, [IncreaseSpellCostForEachTarget(AnySpell, PayMana({{ManaCost[0]}}))])",
    "Spells your opponents cast from graveyards or from exile cost {{ManaCost}} more to cast": "EachPlayerEffect(Opponent, [IncreaseSpellCost(Or([WasCastFromAPlayersGraveyard(AnyPlayer), WasCastFromExile]), PayMana({{ManaCost[0]}}))])",
    "Spells your opponents cast that target a creature or planeswalker you control cost {{ManaCost}} more to cast": "EachPlayerEffect(Opponent, [IncreaseSpellCost(TargetsAPermanent(And([Or([IsCardtype(Creature), IsCardtype(Planeswalker)]), ControlledByAPlayer(SinglePlayer(You))])), PayMana({{ManaCost[0]}}))])",
    "Spells your opponents cast that target one or more commanders you control cost {{ManaCost}} more to cast": "EachPlayerEffect(Opponent, [IncreaseSpellCost(TargetsAPermanent(And([IsACommander, ControlledByAPlayer(SinglePlayer(You))])), PayMana({{ManaCost[0]}}))])",
    "Spells your opponents cast that target you or a permanent you control cost {{ManaCost}} more to cast": "EachPlayerEffect(Opponent, [IncreaseSpellCost(Or([TargetsPlayer(You), TargetsAPermanent(ControlledByAPlayer(SinglePlayer(You)))]), PayMana({{ManaCost[0]}}))])",
    "Spells your opponents cast that target {{a}} {{Zombie}} you control cost {{ManaCost}} more to cast": "EachPlayerEffect(Opponent, [IncreaseSpellCost(TargetsAPermanent(And([IsCreatureType({{Zombie[0]}}), ControlledByAPlayer(SinglePlayer(You))])), PayMana({{ManaCost[0]}}))])",
    "Stun counters can't be removed from {{Permanents}}": "CountersOfTypeCantBeRemovedFromPermanents(StunCounter, {{Permanents[0]}})",
    "The \"legend rule\" doesn't apply": "TheLegendsRuleDoesntApply",
    "The \"legend rule\" doesn't apply to {{Permanents}}": "TheLegendsRuleDoesntApplyToPermanents({{Permanents[0]}})",
    "The attacking player chooses how each creature blocks each combat": "PlayerEffect(TheAttackingPlayer, [ChoosesHowCreaturesBlock(IsCardtype(Creature))])",
    "The first activated ability of {{a}} {{Permanent}} you activate each turn costs {{CostReduce}} less to activate": "PlayerEffect(You, [ReduceActivatedCost(FirstAbilityActivatedByPlayerThisTurn(AbilityOfAPermanent({{Permanent[0]}}), You), {{CostReduce[0]}})])",
    "The first activated ability you activate during your turn that targets {{a}} {{Permanent}} costs {{CostReduce}} less to activate": "If(IsPlayersTurn(You), [PlayerEffect(You, [ReduceActivatedCost(FirstAbilityActivatedByPlayerThisTurn(TargetsAPermanent({{Permanent[0]}}), You), {{CostReduce[0]}})])])",
    "The first card you foretell each turn costs {{ManaCost}} to foretell": "PlayerEffect(You, [ReplaceForetellCostOfFirstCardForetoldEachTurn({{ManaCost[0]}})])",
    "The first spell each player casts during each of their turns may be cast without paying its mana cost": "EachPlayerEffect(And([SinglePlayer(TheActivePlayer), HasntCastASpellThisTurn(AnySpell)]), [MayCastSpellsWithoutPaying(AnySpell)])",
    "The first time you flip one or more coins each turn, those coins come up heads and you win those flips": "PlayerEffect(You, [FirstTwoCoinFlipsEachTurnAreHeadsAndYouWin])",
    "The top card of your library has plot. The plot cost is equal to its mana cost": "TopCardOfPlayersLibraryEffect(AnyCard, You, [AddAbility([Plot(ItsManaCost)])])",
    "The {{Nth}} spell you cast during each of your turns with mana value {{Digits}} or greater has cascade": "If(IsPlayersTurn(You), [PlayerEffect(You, [TheNthSpellCastEachTurnHasAbility({{Nth[0]}}, ManaValueIs(GreaterThanOrEqualTo({{Digits[0]}})), [Cascade])])])",
    "The {{Nth}} spell you cast each turn that mana from a Treasure was spent to cast has cascade": "StackSpellsEffect(TheNthSpellCastByPlayerThisTurn({{Nth[0]}}, ManaFromTeasureWasSpentToCast, You), [Cascade])",
    "The {{Nth}} {{PotentialSpell}} each opponent casts each turn costs {{ManaCost}} more to cast": "EachPlayerEffect(Opponent, [IncreaseSpellCost(TheNthSpellCastByPlayerThisTurn({{Nth[0]}}, {{PotentialSpell[0]}}, EachablePlayer), PayMana({{ManaCost[0]}}))])",
    "The {{Nth}} {{PotentialSpell}} you cast during each of your turns costs {{CostReduce}} less to cast": "If(IsPlayersTurn(You), [PlayerEffect(You, [DecreaseSpellCost(TheNthSpellCastByPlayerThisTurn({{Nth[0]}}, {{PotentialSpell[0]}}, You), {{CostReduce[0]}})])])",
    "The {{Nth}} {{PotentialSpell}} you cast each turn costs {{CostReduceSymbol}} (or {{CostReduceSymbolGeneric}}) less to cast for each {{Eachable}}": "PlayerEffect(You, [DecreaseSpellCostForEach(TheNthSpellCastByPlayerThisTurn({{Nth[0]}}, {{PotentialSpell[0]}}, You), [{{CostReduceSymbol[0]}}], {{Eachable[0]}})])",
    "The {{Nth}} {{PotentialSpell}} you cast each turn costs {{CostReduce}} less to cast": "PlayerEffect(You, [DecreaseSpellCost(TheNthSpellCastByPlayerThisTurn({{Nth[0]}}, {{PotentialSpell[0]}}, You), {{CostReduce[0]}})])",
    "The {{Nth}} spell you cast during each of your turns that targets a creature costs {{CostReduce}} less to cast. This effect reduces only the amount of colored mana you pay":
      "PlayerEffect(You, [DecreaseSpellCostOnlyColored(TheNthSpellCastByPlayerThisTurn({{Nth[0]}}, TargetsAPermanent(IsCardtype(Creature)), You), {{CostReduce[0]}})])",
    "The {{Nth}} {{Spell}} you cast each turn has cascade": "StackSpellsEffect(TheNthSpellCastByPlayerThisTurn({{Nth[0]}}, {{Spell[0]}}, You), [Cascade])",
    "The {{Nth}} {{Spell}} you cast each turn has casualty {{Digits}}": "PlayerEffect(You, [TheNthSpellCastEachTurnHasAbility({{Nth[0]}}, {{Spell[0]}}, [Casualty({{Digits[0]}})])])",
    "The {{Nth}} {{Spell}} you cast each turn has convoke": "StackSpellsEffect(TheNthSpellCastByPlayerThisTurn({{Nth[0]}}, {{Spell[0]}}, You), [Convoke])",
    "The {{Nth}} {{Spell}} you cast each turn has improvise": "StackSpellsEffect(TheNthSpellCastByPlayerThisTurn({{Nth[0]}}, {{Spell[0]}}, You), [Improvise])",
    "The {{Nth}} {{Spell}} you cast from anywhere other than your hand each turn has demonstrate": "StackSpellsEffect(TheNthSpellCastByPlayerThisTurn({{Nth[0]}}, And([{{Spell[0]}}, WasntCastFromTheirHand]), You), [Demonstrate])",
    "The {{Nth}} {{Spell}} you cast from exile each turn has cascade": "PlayerEffect(You, [TheNthSpellCastEachTurnHasAbility({{Nth[0]}}, And([{{Spell[0]}}, WasCastFromExile]), [Cascade])])",
    "Triggered abilities you control can't cause you to sacrifice or exile creature tokens you control": "PlayerEffect(You, [CantBeCausedToSacrificePermanentsByAbilities(And([IsCardtype(Creature), IsToken, ControlledByAPlayer(SinglePlayer(You))]), And([TriggeredAbility, ControlledByAPlayer(SinglePlayer(You))])), CantBeCausedToExilePermanentsByAbilities(And([IsCardtype(Creature), IsToken, ControlledByAPlayer(SinglePlayer(You))]), And([TriggeredAbility, ControlledByAPlayer(SinglePlayer(You))]))])",
    "Unlock costs you pay cost {{CostReduce}} less": "PlayerEffect(You, [DecreaseUnlockCost({{CostReduce[0]}})])",
    "Untap all {{Permanents}} during each opponent's untap step": "EachPermanentRuleEffect({{Permanents[0]}}, [UntapsDuringOtherPlayersUntapSteps(Opponent)])",
    "Untap all {{Permanents}} during each other player's untap step": "EachPermanentRuleEffect({{Permanents[0]}}, [UntapsDuringOtherPlayersUntapSteps(Other(You))])",
    "Untap each {{Permanent}} during each other player's untap step": "EachPermanentRuleEffect({{Permanent[0]}}, [UntapsDuringOtherPlayersUntapSteps(Other(You))])",
    "While an opponent is choosing targets as part of casting a spell they control or activating an ability they control, that player must choose at least one {{Zombie}} on the battlefield if able": "EachPlayerEffect(Opponent, [WhileChoosingTargetsMustChooseAtLeastOnePermanentIfAble(IsCreatureType({{Zombie[0]}}))])",
    "While an opponent is searching their library, they exile each card they find. You may play those cards for as long as they remain exiled, and you may spend mana as though it were mana of any color to cast them": "WhilePlayersAreSearchingTheirLibraryTheyExileEachCardTheyFindAndPlayerMayPlayThoseCardsWhileTheyRemainExiledAndMaySpendManaAsThoughItWereAnyColor(Opponent, You)",
    "While voting, you get an additional vote": "PlayerEffect(You, [GetsAnAdditionalVote])",
    "While voting, you may vote an additional time": "PlayerEffect(You, [GetsAnOptionalAdditionalVote])",
    "You and {{Permanents}} have hexproof": "PlayerEffect(You, [Hexproof]), EachPermanentLayerEffect({{Permanents[0]}}, [AddAbility([Hexproof])])",
    "You and {{Permanents}} have protection from {{Zombies}}": "PlayerEffect(You, [Protection(FromTypes(IsCreatureType({{Zombies[0]}})))]), EachPermanentLayerEffect({{Permanents[0]}}, [AddAbility([Protection(FromTypes(IsCreatureType({{Zombies[0]}})))])])",
    "You can cast spells only during your turn and you can cast no more than two spells each turn": "PlayerEffect(You, [CanCastSpellsOnlyDuringTheirTurn, CantCastMoreThanNumberSpellsEachTurn(Integer(2), AnySpell)])",
    "You can spend mana of any type to cast {{PotentialSpells}}": "PlayerEffect(You, [MaySpendManaAsThoughItWasAnyColorToCastSpells({{PotentialSpells[0]}})])",
    "You can't cast more than one {{PotentialSpell}} each turn": "PlayerEffect(You, [CantCastMoreThanNumberSpellsEachTurn(Integer(1), {{PotentialSpell[0]}})])",
    "You can't cast {{PotentialSpells}}": "PlayerEffect(You, [CantCastSpells({{PotentialSpells[0]}})])",
    "You can't draw cards": "PlayerEffect(You, [CantDrawCards])",
    "You can't get poison counters": "PlayerEffect(You, [CantGetPoisonCounters])",
    "You can't lose the game": "PlayerEffect(You, [CantLoseTheGame])",
    "You can't lose the game and your opponents can't win the game": "PlayerEffect(You, [CantLoseTheGame]), EachPlayerEffect(Opponent, [CantWinTheGame])",
    "You can't play lands": "PlayerEffect(You, [CantPlayLands])",
    "You can't play lands or cast spells from your hand": "PlayerEffect(You, [CantPlayLandsFromTheirHand, CantCastSpellsFromTheirHand(AnySpell)])",
    "You can't untap more than one land during your untap step": "PlayerEffect(You, [CantUntapMoreThanNumberPermanentsDuringTheirUntapStep(Integer(1), IsCardtype(Land))])",
    "You can't win the game and your opponents can't lose the game": "PlayerEffect(You, [CantWinTheGame]), EachPlayerEffect(Opponent, [CantLoseTheGame])",
    "You control your opponents while they're searching their libraries": "PlayerEffect(You, [ControlsPlayersWhileTheyAreSearchingLibraries(Opponent)])",
    "You don't lose the game for having 0 or less life": "PlayerEffect(You, [DoesntLoseTheGameForHaving0OrLessLife])",
    "You don't lose unspent green mana as steps and phases end": "PlayerEffect(You, [DoesntLoseColoredManaAsStepsAndPhasesEnd(UnspentGreenMana)])",
    "You don't lose unspent red mana as steps and phases end": "PlayerEffect(You, [DoesntLoseColoredManaAsStepsAndPhasesEnd(UnspentRedMana)])",
    "You draw cards from the bottom of your library rather than the top": "PlayerEffect(You, [DrawsCardsFromBottomOfTheirLibrary])",
    "You gain life rather than lose life from radiation": "PlayerEffect(You, [GainsLifeRatherThanLoseLifeFromRadiation])",
    "You have hexproof": "PlayerEffect(You, [Hexproof])",
    "You have no maximum hand size": "PlayerEffect(You, [HasNoMaximumHandSize])",
    "You have no maximum hand size and don't lose the game for having 0 or less life": "PlayerEffect(You, [HasNoMaximumHandSize, DoesntLoseTheGameForHaving0OrLessLife])",
    "You have protection from each of your opponents": "PlayerEffect(You, [Protection(FromPlayers(Opponent))])",
    "You have shroud": "PlayerEffect(You, [Shroud])",
    "You may activate abilities of creatures you control as though those creatures had haste": "PlayerEffect(You, [MayActivateAbilitiesOfCreaturesAsThoughTheyHadHaste(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))])",
    "You may activate abilities of other {{Creatures}} as though those creatures had haste": "PlayerEffect(You, [MayActivateAbilitiesOfCreaturesAsThoughTheyHadHaste(And([Other(ThisPermanent), {{Creatures[0]}}]))])",
    "You may activate equip abilities any time you could cast an instant": "PlayerEffect(You, [MayActivateEquipAbilitiesAnyTimeTheyCouldCastAnInstant])",
    "You may activate the loyalty abilities of {{Planeswalkers}} twice each turn rather than only once": "PlayerEffect(You, [MayActivateLoyaltyAbilitiesTwiceEachTurn({{Planeswalkers[0]}})])",
    "You may cast Aura and Equipment spells from the top of your library. When you cast an Equipment spell this way, it gains \"{{QuotedAbility}}\"": "PlayerEffect(You, [MayCastSpellsFromTopOfLibrary_SpellsWithTrigger(And([IsEnchantmentType(Aura), IsArtifactType(Equipment)]), IsArtifactType(Equipment), ActionList([CreateSpellEffect(Trigger_ThatSpell, [AddAbility([{{QuotedAbility[0]}}])])]))])",
    "You may cast creature spells from your graveyard using their sneak abilities": "PlayerEffect(You, [MayCastSpellsFromGraveyardUsingTheirSneakAbility(IsCardtype(Creature), InAPlayersGraveyard(SinglePlayer(You)))])",
    "You may cast creature spells with power {{Digits}} or greater from the top of your library. If you cast a creature spell this way, it gains {{Hasable}} until end of turn": "PlayerEffect(You, [MayCastSpellsFromTopOfLibraryWithEffect(IsNonCardtype(Creature), [AddAbilityUntil({{Hasable[0]}}, UntilEndOfTurn)])])",
    "You may cast noncreature spells from the top of your library. If you cast a spell this way, you may cast it as though it had flash": "PlayerEffect(You, [MayCastSpellsFromTopOfLibraryAsThoughTheyHadFlash(IsNonCardtype(Creature))])",
    "You may cast spells from among cards in exile your opponents own with {{CounterType}} counters on them, and you may spend mana from snow sources as though it were mana of any color to cast those spells": "PlayerEffect(You, [MayCastSpellsFromAmongExiledAndMaySpendManaFromSnowSourcesAsThoughItWereAnyColorToCast(And([OwnedByAPlayer(Opponent), HasACounterOfType({{CounterType[0]}})]))])",
    "You may cast spells from the top of your library by removing a counter from {{a}} {{Permanent}} in addition to paying their other costs": "PlayerEffect(You, [MayCastSpellsFromTopOfLibraryWithAdditionalCost(AnySpell, RemoveACounterFromAPermanent({{Permanent[0]}}))])",
    "You may cast spells from the top of your library by sacrificing {{a}} {{Permanent}} in addition to paying their other costs": "PlayerEffect(You, [MayCastSpellsFromTopOfLibraryWithAdditionalCost(AnySpell, SacrificeAPermanent({{Permanent[0]}}))])",
    "You may cast spells from your hand without paying their mana costs": "PlayerEffect(You, [MayCastSpellsFromHandWithoutPaying])",
    "You may cast the first creature spell you cast each turn as though it had flash": "PlayerEffect(You, [MayCastSpellsAsThoughTheyHadFlash(TheNthSpellCastByPlayerThisTurn(Integer(1), IsCardtype(Creature), You))])",
    "You may cast {{PotentialSpells}} and {{PotentialSpells}} as though they had flash": "PlayerEffect(You, [MayCastSpellsAsThoughTheyHadFlash(Or([{{PotentialSpells[0]}}, {{PotentialSpells[1]}}]))])",
    "You may cast {{PotentialSpells}} and {{PotentialSpells}} from the top of your library": "PlayerEffect(You, [MayCastSpellsFromTopOfLibrary(Or([{{PotentialSpells[0]}}, {{PotentialSpells[1]}}]))])",
    "You may cast {{PotentialSpells}} as though they had flash": "PlayerEffect(You, [MayCastSpellsAsThoughTheyHadFlash({{PotentialSpells[0]}})])",
    "You may cast {{PotentialSpells}} by paying {{Energy}} rather than paying their mana costs. If you cast a spell this way, you may cast it as though it had flash": "PlayerEffect(You, [MayCastSpellsForAlternateCostAsThoughTheyHadFlash({{PotentialSpells[0]}}, PayEnergy(Integer({{Energy[0]}})))])",
    "You may cast {{PotentialSpells}} from the top of your library": "PlayerEffect(You, [MayCastSpellsFromTopOfLibrary({{PotentialSpells[0]}})])",
    "You may cast {{PotentialSpells}} from your graveyard": "PlayerEffect(You, [MayCastSpellsFromGraveyard({{PotentialSpells[0]}})])",
    "You may cast {{PotentialSpells}} from your graveyard by paying {{Digits}} life in addition to paying their other costs. If you cast a spell this way, that artifact enters with {{a}} {{CounterType}} counter on it": "PlayerEffect(You, [MayCastSpellsFromGraveyardForAdditionalCostWithEffect({{PotentialSpells[0]}}, You, PayLife({{Digits[0]}}), [EntersWithACounter({{CounterType[0]}})])])",
    "You may cast {{PotentialSpells}} without paying their mana costs": "PlayerEffect(You, [MayCastSpellsWithoutPaying({{PotentialSpells[0]}})])",
    "You may collect evidence {{Digits}} rather than pay the mana cost for {{PotentialSpells}} you cast": "PlayerEffect(You, [MayPayAlternateCostForSpells(CollectEvidence({{Digits[0]}}), {{PotentialSpells[0]}})])",
    "You may look at an additional {{Number}} cards each time you surveil": "PlayerEffect(You, [MayLookAtAnAdditionalNumberCardsAsTheySurveil({{Number[0]}})])",
    "You may look at face-down creatures you don't control any time": "PlayerEffect(You, [MayLookAtFaceDownPermanents(And([IsCardtype(Creature), ControlledByAPlayer(Other(You))]))])",
    "You may look at face-down creatures your opponents control any time": "PlayerEffect(You, [MayLookAtFaceDownPermanents(And([IsCardtype(Creature), ControlledByAPlayer(Opponent)]))])",
    "You may look at the top card of your library and at face-down {{Permanents}} any time": "PlayerEffect(You, [MayLookAtTopCardOfLibraryAnyTime, MayLookAtFaceDownPermanents({{Permanents[0]}})])",
    "You may look at the top card of your library any time": "PlayerEffect(You, [MayLookAtTopCardOfLibraryAnyTime])",
