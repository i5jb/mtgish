    "This creature deals X damage to any target, where X is the number of times this creature has mutated": "Targeted([AnyTarget], ActionList([PermanentDealsDamage(ThisPermanent, NumTimesCreatureHasMutated(ThisPermanent), Ref_AnyTarget)]))",
    "This turn, each {{Permanent}} enters with an additional {{CounterType}} counter on it": "ActionList([CreateReplaceWouldEnterUntil(APermanentWouldEnterTheBattlefield({{Permanent[0]}}), [EntersWithACounter({{CounterType[0]}})], UntilEndOfTurn)])",
    "This turn, when target {{Creature}} attacks and isn't blocked, you may gain life equal to {{GameNumber(ThatCreature)}}. If you do, it assigns no combat damage this turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreateTriggerUntil(WhenACreatureAttacksAndIsntBlocked(SinglePermanent(Ref_TargetPermanent)), ActionList([MayCost(GainLife({{GameNumber(ThatCreature=Trigger_ThatCreature)[0]}})), Unless(CostWasPaid, [CreatePermanentRuleEffectUntil(Trigger_ThatCreature, [AssignsNoCombatDamage], UntilEndOfTurn)])]), UntilEndOfTurn)]))",
    "This turn, you may play basic lands from outside the game": "ActionList([CreatePlayerEffectUntil(You, [MayPlayLandsFromOutsideTheGame(And([IsSupertype(Basic), IsCardtype(Land)]))], UntilEndOfTurn)])",
    "Time travel": "ActionList([TimeTravel])",
    "Time travel {{Number}} times": "ActionList([TimeTravelNumberTimes({{Number[0]}})])",
    "Transform target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TransformPermanent(Ref_TargetPermanent)]))",
    "Transform target {{Permanent}}. Double the number of {{CounterType}} counters on it": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TransformPermanent(Ref_TargetPermanent), DoubleCountersOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent)]))",
    "Turn target {{Permanent}} face up": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TurnPermanentFaceUp(Ref_TargetPermanent)]))",
    "Turn target {{Permanent}} face up. At the beginning of the next end step, sacrifice it": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TurnPermanentFaceUp(Ref_TargetPermanent), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([SacrificePermanent(Ref_TargetPermanent)]))]))",
    "Two target players exchange life totals": "Targeted([NumberTargetPlayers(Integer(2), AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayers_0, ExchangeLifeTotalWithPlayer(Ref_TargetPlayers_1))]))",
    "Untap all {{Creatures}} of the creature type of your choice": "ActionList([ChooseACreatureType, UntapEachPermanent(And([{{Creatures[0]}}, IsCreatureTypeVariable(TheChosenCreatureType)]))])",
    "Untap all {{Creatures}}. Those creatures get {{PTMod}} until end of turn": "ActionList([UntapEachPermanent({{Creatures[0]}}), CreateEachPermanentLayerEffectUntil(WasUntappedThisWay, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])",
    "Untap all {{Permanents}}": "ActionList([UntapEachPermanent({{Permanents[0]}})])",
    "Untap all {{Permanents}} and all {{Permanents}}": "ActionList([UntapEachPermanent(Or([{{Permanents[0]}}, {{Permanents[1]}}]))])",
    "Untap all {{Permanents}}. After this main phase, there is an additional combat phase followed by an additional main phase": "ActionList([UntapEachPermanent({{Permanents[0]}}), ThereIsAnAdditionalCombatPhaseAndAnAdditionalMainPhase])",
    "Untap all {{Permanents}}. They gain {{Hasable}}, {{Hasable}}, and {{Hasable}} until end of turn. After this phase, there is an additional combat phase": "ActionList([UntapEachPermanent({{Permanents[0]}}), CreateEachPermanentLayerEffectUntil(WasUntappedThisWay, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}]), AddAbility([{{Hasable[2]}}])], UntilEndOfTurn), ThereIsAnAdditionalCombatPhase])",
    "Untap each {{Permanent}}": "ActionList([UntapEachPermanent({{Permanent[0]}})])",
    "Untap target {{Artifact}} and gain control of it until end of turn. It gains {{Hasable}} until end of turn. When you lose control of the artifact, tap it": "Targeted([TargetPermanent({{Artifact[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent), GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), CreateFutureTrigger(WhenPlayerLosesControlOfPermanent(You, Ref_TargetPermanent), ActionList([TapPermanent(Trigger_ThatPermanent)]))]))",
    "Untap target {{Creature}} and gain control of it until end of turn. That creature gains {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent), GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Untap target {{Creature}}. Prevent all combat damage that would be dealt to and dealt by it this turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent), CreatePreventDamageUntil(Or([CombatDamageWouldBeDealtToRecipient(Permanent(Ref_TargetPermanent)), CombatDamageWouldBeDealtByCreature(Ref_TargetPermanent)]), [PreventThatDamage], UntilEndOfTurn)]))",
    "Untap target {{Creature}}. Prevent all combat damage that would be dealt to and dealt by that creature this turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent), CreatePreventDamageUntil(Or([CombatDamageWouldBeDealtToRecipient(Permanent(Ref_TargetPermanent)), CombatDamageWouldBeDealtByCreature(Ref_TargetPermanent)]), [PreventThatDamage], UntilEndOfTurn)]))",
    "Untap target {{Land}}. It becomes {{a}} {{PT}} {{Black}} {{Zombie}} creature until end of turn. It's still a land": "Targeted([TargetPermanent({{Land[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [SetPT({{PT[0]}}), SetColor(SimpleColorList([{{Black[0]}}])), SetCreatureType({{Zombie[0]}}), AddCardtype(Creature)], UntilPlayersNextTurn(You))]))",
    "Untap target {{Land}}. It becomes {{a}} {{PT}} {{Zombie}} creature with {{Hasable}} and {{Hasable}} until end of turn. It's still a land": "Targeted([TargetPermanent({{Land[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffect(Ref_TargetPermanent, [SetPT({{PT[0]}}), AddCreatureType({{Zombie[0]}}), AddCardtype(Creature), AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])])]))",
    "Untap target {{Land}}. It becomes {{a}} {{PT}} {{Zombie}} creature with {{Hasable}}. It's still a land": "Targeted([TargetPermanent({{Land[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffect(Ref_TargetPermanent, [SetPT({{PT[0]}}), SetCreatureType({{Zombie[0]}}), AddCardtype(Creature), AddAbility([{{Hasable[0]}}])])]))",
    "Untap target {{Land}}. Until your next turn, it becomes {{a}} {{PT}} {{Zombie}} creature with {{Hasable}}. It's still a land": "Targeted([TargetPermanent({{Land[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [SetPT({{PT[0]}}), SetCreatureType({{Zombie[0]}}), AddCardtype(Creature), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Untap target {{Land}}. You may have it become {{a}} {{PT}} {{Zombie}} creature with {{Hasable}} and {{Hasable}} until end of turn. It's still a land": "Targeted([TargetPermanent({{Land[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent), MayAction(CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [SetPT({{PT[0]}}), AddCreatureType({{Zombie[0]}}), AddCardtype(Creature), AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn))]))",
    "Untap target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent)]))",
    "Untap target {{Permanent}} and remove it from combat": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent), RemoveCreatureFromCombat(Ref_TargetPermanent)]))",
    "Untap target {{Permanent}}. If it's a creature, it gets {{PTMod}} until end of turn": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent), If(PermanentPassesFilter(Ref_TargetPermanent, IsCardtype(Creature)), [CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])]))",
    "Untap target {{Permanent}}. If {{Condition(ThatPermanent)}}, put {{a}} {{CounterType}} counter on it": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent), If({{Condition(ThatPermanent=Ref_TargetPermanent)[0]}}, [PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent)])]))",
    "Untap target {{Permanent}}. Prevent all damage that would be dealt to and dealt by that permanent until your next turn": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent), CreatePreventDamageUntil(Or([DamageWouldBeDealtToRecipient(Permanent(Ref_TargetPermanent)), DamageWouldBeDealtByPermanent(Ref_TargetPermanent)]), [PreventThatDamage], UntilPlayersNextTurn(You))]))",
    "Untap up to one target {{Creature}}. That {{Creature}} and a random {{SpecificCard}} in your hand perpetually get {{PTMod}}": "Targeted([UptoOneTargetPermanent({{Creature[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent), CreatePerpetualPermanentEffect(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})]), ChooseACardInHandAtRandom({{SpecificCard[0]}}), CreatePerpetualCardInHandEffect(TheChosenCardInHand, [AdjustPT({{PTMod[0]}})])]))",
    "Untap up to one target {{Permanent}}": "Targeted([UptoOneTargetPermanent({{Permanent[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent)]))",
    "Untap up to one target {{Permanent}} and up to one target {{Permanent}}": "Targeted([UptoOneTargetPermanent({{Permanent[0]}}), UptoOneTargetPermanent({{Permanent[0]}})], ActionList([UntapEachPermanent(Or([SinglePermanent(Ref_TargetPermanent1), SinglePermanent(Ref_TargetPermanent2)]))]))",
    "Untap up to {{Number}} target {{Lands}}. They become {{PT}} {{Zombie}} creatures with {{Hasable}} and {{Hasable}} until end of turn. They're still lands": "Targeted([UptoNumberTargetPermanents({{Number[0]}}, {{Lands[0]}})], ActionList([UntapEachPermanent(Ref_TargetPermanents), CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [SetPT({{PT[0]}}), AddCreatureType({{Zombie[0]}}), AddCardtype(Creature), AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)]))",
    "Untap up to {{Number}} target {{Lands}}. They become {{PT}} {{Zombie}} creatures. They're still lands": "Targeted([UptoNumberTargetPermanents({{Number[0]}}, {{Lands[0]}})], ActionList([CreateEachPermanentLayerEffect(Ref_TargetPermanents, [SetPT({{PT[0]}}), SetCreatureType({{Zombie[0]}}), AddCardtype(Creature)])]))",
    "Untap up to {{Number}} target {{Permanents}}": "Targeted([UptoNumberTargetPermanents({{Number[0]}}, {{Permanents[0]}})], ActionList([UntapEachPermanent(Ref_TargetPermanents)]))",
    "Untap up to {{Number}} target {{Permanents}} and up to {{Number}} target {{Permanents}}": "Targeted([UptoNumberTargetPermanents({{Number[0]}}, {{Permanents[0]}}), UptoNumberTargetPermanents({{Number[1]}}, {{Permanents[1]}})], ActionList([UntapEachPermanent(Or([Ref_TargetPermanents1, Ref_TargetPermanents2]))]))",
    "Untap {{Number}} target {{Permanents}}": "Targeted([NumberTargetPermanents({{Number[0]}}, {{Permanents[0]}})], ActionList([UntapEachPermanent(Ref_TargetPermanents)]))",
    "Until end of turn, each {{Creature}} has base power and toughness {{PT}} and becomes {{a}} {{Zombie}} in addition to its other creature types": "ActionList([CreateEachPermanentLayerEffectUntil({{Creature[0]}}, [SetPT({{PT[0]}}), AddCreatureType({{Zombie[0]}})], UntilEndOfTurn)])",
    "Until end of turn, each {{Creature}} has base power and toughness {{PT}} and gains {{Hasable}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Creature[0]}}, [SetPT({{PT[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "Until end of turn, each {{Permanent}} gains \"{{QuotedAbility}}\"": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanent[0]}}, [AddAbility([{{QuotedAbility[0]}}])], UntilEndOfTurn)])",
    "Until end of turn, each {{Planeswalker}} becomes {{a}} {{PT}} {{Black}} {{Zombie}} creature and gains {{Hasable}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Planeswalker[0]}}, [SetPT({{PT[0]}}), SetColor(SimpleColorList([{{Black[0]}}])), SetCreatureType({{Zombie[0]}}), SetCardtype(Creature), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "Until end of turn, each {{SpecificCard}} in your graveyard gains \"{{GraveyardQuotedAbility}}\"": "ActionList([CreateEachCardInPlayersGraveyardEffectUntil({{SpecificCard[0]}}, You, [AddAbility([{{GraveyardQuotedAbility[0]}}])], UntilEndOfTurn)])",
    "Until end of turn, if one or more tokens would be created under your control, twice that many of those tokens are created instead": "ActionList([CreateReplaceAnyNumberOfTokensWouldBeCreatedUntil(AnyNumberOfTokensWouldBeCreatedUnderAPlayersControl(AnyPermanent, SinglePlayer(You)), [CreateTokensInstead([ThoseTokens, ThoseTokens])], UntilEndOfTurn)])",
    "Until end of turn, if you tap a land for mana, it produces one mana of a color of your choice instead of any other type and amount": "ActionList([CreateReplaceWouldProduceManaUntil(PlayerTappingAPermanentWouldProduceMana(You, IsCardtype(Land)), [WouldProduceMana_AddMana(AnyManaColor)], UntilEndOfTurn)])",
    "Until end of turn, if you tap {{a}} {{Permanent}} for mana, it produces {{ManaProduceSymbol}} instead of any other type": "ActionList([CreateReplaceWouldProduceManaUntil(PlayerTappingAPermanentWouldProduceMana(You, {{Permanent[0]}}), [WouldProduceMana_ReplaceType({{ManaProduceSymbol[0]}})], UntilEndOfTurn)])",
    "Until end of turn, if you would put one or more {{CounterType}} counters on {{a}} {{Permanent}}, put that many plus one {{CounterType}} counters on it instead": "ActionList([CreateReplaceWouldPutCountersUntil(APlayerWouldPutAnyNumberOfCountersOfTypeOnAPermanent(SinglePlayer(You), {{CounterType[0]}}, {{Permanent[0]}}), [PutNewAmount(Plus(WouldPutCounters_NumberOfCounters, Integer(1)))], UntilEndOfTurn)])",
    "Until end of turn, if {{a}} {{Permanent}} would enter and it wasn't cast, exile it instead": "ActionList([CreateReplaceWouldEnterUntil(APermanentWouldEnterTheBattlefieldAndWasntCast({{Permanent[0]}}), [ExileItInstead], UntilEndOfTurn)])",
    "Until end of turn, target {{Artifact}} becomes an artifact creature and gains {{Hasable}}. If it's not a Vehicle, it has base power and toughness {{PT}} until end of turn": "Targeted([TargetPermanent({{Artifact[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [SetCardtypes([Artifact, Creature]), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), If(PermanentPassesFilter(Ref_TargetPermanent, IsArtifactType(Vehicle)), [CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [SetPT({{PT[0]}})], UntilEndOfTurn)])]))",
    "Until end of turn, target {{Artifact}} becomes {{a}} {{PT}} artifact creature": "Targeted([TargetPermanent({{Artifact[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [SetPT({{PT[0]}}), AddCardtype(Artifact), AddCardtype(Creature)], UntilEndOfTurn)]))",
    "Until end of turn, target {{Creature}} assigns combat damage equal to its toughness rather than its power": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [AssignsToughnessCombatDamage], UntilEndOfTurn)]))",
    "Until end of turn, target {{Creature}} becomes {{a}} {{Black}} artifact in addition to its other colors and types": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddColor(SimpleColorList([{{Black[0]}}])), AddCardtype(Artifact)], UntilEndOfTurn)]))",
    "Until end of turn, target {{Creature}} gains {{Hasable}} and gets {{PTModX}}, where X is {{GameNumber}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}]), AdjustPTX({{PTModX[0]}}, {{GameNumber[0]}})], UntilEndOfTurn)]))",
    "Until end of turn, target {{Creature}} gains {{Hasable}} and has base toughness {{Digits}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}]), SetToughness({{Digits[0]}})], UntilEndOfTurn)]))",
    "Until end of turn, target {{Creature}} gains {{Hasable}}, can attack as though it didn't have defender, and assigns combat damage equal to its toughness rather than its power": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [CanAttackAsThoughItDidntHaveDefender, AssignsToughnessCombatDamage], UntilEndOfTurn)]))",
    "Until end of turn, target {{Creature}} gets {{PTMod}} and becomes an artifact in addition to its other types": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}}), AddCardtype(Artifact)], UntilEndOfTurn)]))",
    "Until end of turn, target {{Creature}} gets {{PTMod}} and becomes {{a}} {{Zombie}} in addition to its other types": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}}), AddCreatureType({{Zombie[0]}})], UntilEndOfTurn)]))",
    "Until end of turn, target {{Creature}} gets {{PTMod}} and gains \"{{QuotedAbility}}\"": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{QuotedAbility[0]}}])], UntilEndOfTurn)]))",
    "Until end of turn, target {{Creature}} gets {{PTMod}}, gains \"{{QuotedAbility}}\", and can attack as though it didn't have defender": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{QuotedAbility[0]}}])], UntilEndOfTurn), CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [CanAttackAsThoughItDidntHaveDefender], UntilEndOfTurn)]))",
    "Until end of turn, target {{Creature}} has base power and toughness {{PT}} and gains {{Hasable}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [SetPT({{PT[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Until end of turn, target {{Creature}} has base power {{Digits}} or base toughness {{Digits}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [SetPower({{Digits[0]}}), SetToughness({{Digits[1]}})], UntilEndOfTurn)]))",
    "Until end of turn, target {{Land}} becomes an X/X {{Zombie}} creature in addition to its other types, where X is {{GameNumber}}": "Targeted([TargetPermanent({{Land[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [SetPowerAndToughnessBoth({{GameNumber[0]}}), AddCreatureType({{Zombie[0]}}), AddCardtype(Creature)], UntilEndOfTurn)]))",
    "Until end of turn, target {{Land}} becomes the basic land type of your choice in addition to its other types": "Targeted([TargetPermanent({{Land[0]}})], ActionList([ChooseABasicLandType, CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddLandTypeVariable(TheChosenLandType)], UntilEndOfTurn)]))",
    "Until end of turn, target {{Land}} becomes {{a}} {{PTX}} {{Zombie}} creature with {{Hasable}} in addition to its other types, where X is twice {{GameNumber}}": "Targeted([TargetPermanent({{Land[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [SetPT(PTX({{PTX[0]}}, {{GameNumber[0]}})), AddCreatureType({{Zombie[0]}}), AddCardtype(Creature), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Until end of turn, target {{Land}} becomes {{a}} {{PT}} creature that's still a land": "Targeted([TargetPermanent({{Land[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [SetPT({{PT[0]}}), AddCardtype(Creature)], UntilEndOfTurn)]))",
    "Until end of turn, target {{Land}} becomes {{a}} {{PT}} {{Zombie}} creature with {{Hasable}}, {{Hasable}}, and {{Hasable}}. It's still a land": "Targeted([TargetPermanent({{Land[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [SetPT({{PT[0]}}), SetCreatureType({{Zombie[0]}}), AddCardtype(Creature), AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}]), AddAbility([{{Hasable[2]}}])], UntilEndOfTurn)]))",
    "Until end of turn, target {{Permanent}} becomes {{Black}} and isn't an artifact": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddColor(SimpleColorList([{{Black[0]}}])), RemoveCardtype(Artifact)], UntilEndOfTurn)]))",
    "Until end of turn, target {{Permanent}} becomes {{a}} {{Black}} {{Zombie}} creature with base power and toughness {{PT}} in addition to its other colors and types": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddColor(SimpleColorList([{{Black[0]}}])), AddCreatureType({{Zombie[0]}}), AddCardtype(Creature), SetPT({{PT[0]}})], UntilEndOfTurn)]))",
    "Until end of turn, target {{Permanent}} becomes {{a}} {{PT}} {{Zombie}} artifact creature with {{Hasable}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffect(Ref_TargetPermanent, [SetPT({{PT[0]}}), SetCreatureType({{Zombie[0]}}), SetCardtypes([Artifact, Creature]), AddAbility([{{Hasable[0]}}])])]))",
    "Until end of turn, target {{Permanent}} gains \"{{QuotedAbility}}\"": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{QuotedAbility[0]}}])], UntilEndOfTurn)]))",
    "Until end of turn, target {{Permanent}} gains \"{{QuotedAbility}}\" and it can't be blocked this turn": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{QuotedAbility[0]}}])], UntilEndOfTurn), CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [CantBeBlocked], UntilEndOfTurn)]))",
    "Until end of turn, target {{Permanent}} gains \"{{QuotedAbility}}\". That creature's controller may have {{ThisPermanent}} deal {{Digits}} damage to it": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{QuotedAbility[0]}}])], UntilEndOfTurn), PlayerMayAction(ControllerOfPermanent(Ref_TargetPermanent), HavePermanentDealDamage(ThisPermanent, {{Digits[0]}}, Permanent(Ref_TargetPermanent)))]))",
    "Until end of turn, target {{Permanent}} gains protection from a color chosen at random from colors it doesn't have protection from": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([ChooseRandomColorPermanentDoesntHaveProtectionFrom(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([Protection(FromColor(TheChosenColor))])], UntilEndOfTurn)]))",
    "Until end of turn, target {{Permanent}} gains {{Hasable}} and \"{{QuotedAbility}}\"": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}]), AddAbility([{{QuotedAbility[0]}}])], UntilEndOfTurn)]))",
    "Until end of turn, up to one target {{Creature}} gets {{PTMod}} and gains {{Hasable}} and {{Hasable}}": "Targeted([UptoOneTargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)]))",
    "Until end of turn, up to one target {{Creature}} gets {{PTMod}} and gains {{Hasable}}, {{Hasable}}, and {{Hasable}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}]), AddAbility([{{Hasable[2]}}])], UntilEndOfTurn)]))",
    "Until end of turn, whenever one or more {{Creatures}} deal combat damage to a player, that player loses half their life, rounded up": "ActionList([CreateTriggerUntil(WhenAnyNumberOfCreaturesDealCombatDamageToAPlayer({{Creatures[0]}}, AnyPlayer), ActionList([PlayerAction(Trigger_ThatPlayer, LoseLife(HalfRoundedUp(LifeTotalOfPlayer(Trigger_ThatPlayer))))]), UntilEndOfTurn)])",
    "Until end of turn, whenever target {{Creature}} deals combat damage to {{a}} {{Creature}}, destroy the damaged creature": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreateTriggerUntil(WhenACreatureDealsCombatDamageToAPermanent(SinglePermanent(Ref_TargetPermanent), {{Creature[1]}}), ActionList([DestroyPermanent(Trigger_ThatPermanent)]), UntilEndOfTurn)]))",
    "Until end of turn, whenever you cast {{a}} {{Spell}}, copy it. You may choose new targets for the copy": "ActionList([CreateTriggerUntil(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), ActionList([CopySpellAndMayChooseNewTargets(Trigger_ThatSpell)]), UntilEndOfTurn)])",
    "Until end of turn, whenever {{a}} {{Creature}} deals combat damage to a player, draw a card": "ActionList([CreateTriggerUntil(WhenACreatureDealsCombatDamageToAPlayer({{Creature[0]}}, AnyPlayer), ActionList([DrawACard]), UntilEndOfTurn)])",
    "Until end of turn, whenever {{a}} {{Creature}} deals combat damage to you, destroy that creature": "ActionList([CreateTriggerUntil(WhenACreatureDealsCombatDamageToAPlayer({{Creature[0]}}, SinglePlayer(You)), ActionList([DestroyPermanent(Trigger_ThatCreature)]), UntilEndOfTurn)])",
    "Until end of turn, you may cast creature spells from your graveyard by foraging in addition to paying their other costs. If you cast a spell this way, that creature enters with {{a}} {{CounterType}} counter on it": "ActionList([CreatePlayerEffectUntil(You, [MayCastSpellsFromGraveyardForAdditionalCostWithEffect(IsCardtype(Creature), You, Forage, [EntersWithACounter({{CounterType[0]}})])], UntilEndOfTurn)])",
