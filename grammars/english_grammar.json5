    "until end of turn, target {{Creature}} gets {{PTModX}} and target {{Creature}} gets {{PTModX}}, where X is {{GameNumber}}": "Targeted([TargetPermanent({{Creature[0]}}), TargetPermanent({{Creature[1]}})], ActionList([CreateValueX({{GameNumber[0]}}), CreatePermanentLayerEffectUntil(Ref_TargetPermanent1, [AdjustPTX({{PTModX[0]}}, ValueX)], UntilEndOfTurn), CreatePermanentLayerEffectUntil(Ref_TargetPermanent2, [AdjustPTX({{PTModX[1]}}, ValueX)], UntilEndOfTurn)]))",
    "until end of turn, target {{Creature}} gets {{PTMod}} for each {{Eachable(ThatPermanent)}} and gains {{Hasable}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTForEach({{PTMod[0]}}, {{Eachable(ThatPermanent=Ref_TargetPermanent)[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "until end of turn, whenever you tap a land for mana, add one mana of any type that land produced": "ActionList([CreateTriggerUntil(WhenAPlayerTapsAPermanentForMana(SinglePlayer(You), IsCardtype(Land)), ActionList([AddMana(Trigger_AnyManaTypeProduced)]), UntilEndOfTurn)])",
    "until end of turn, whenever {{a}} {{Creature}} deals combat damage to a player, investigate": "ActionList([CreateTriggerUntil(WhenACreatureDealsCombatDamageToAPlayer({{Creature[0]}}, AnyPlayer), ActionList([Investigate]), UntilEndOfTurn)])",
    "until end of turn, whenever {{a}} {{Creature}} dies, create a number of {{PT}} {{CreatureTokens}} equal to that creature's power": "ActionList([CreateTriggerUntil(WhenACreatureOrPlaneswalkerDies({{Creature[0]}}), ActionList([CreateTokens([NumberTokens(PowerOfPermanent(Trigger_ThatPermanent), TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])]), UntilEndOfTurn)])",
    "until end of turn, whenever {{a}} {{Creature}} is dealt damage, destroy it": "ActionList([CreateTriggerUntil(WhenAPermanentIsDealtDamage({{Creature[0]}}), ActionList([DestroyPermanent(Trigger_ThatCreatureOrPlaneswalker)]), UntilEndOfTurn)])",
    "until end of turn, you may look at the top card of your library any time and you may play cards from the top of your library. If you cast a spell this way, pay life equal to its mana value rather than pay its mana cost": "ActionList([CreatePlayerEffectUntil(You, [MayLookAtTopCardOfLibraryAnyTime, MayPlayTopCardOfLibraryForAlternateCost(PayLifeEqualToItsManaValue)], UntilEndOfTurn)])",
    "until end of turn, {{Artifacts}} become {{PT}} Vehicles in addition to their other types and gain {{Hasable}}, {{Hasable}}, and {{Hasable}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Artifacts[0]}}, [SetPT({{PT[0]}}), AddArtifactType(Vehicle), AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}]), AddAbility([{{Hasable[2]}}])], UntilEndOfTurn)])",
    "until end of turn, {{Creatures}} gain \"{{QuotedAbility[ThisCreature]}}\"": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AddAbility([{{QuotedAbility[ThisCreature][0]}}])], UntilEndOfTurn)])",
    "until your next turn, if a player would planeswalk as a result of rolling the planar die, chaos ensues instead": "ActionList([CreateReplaceWouldPlaneswalkUntil(APlayerWouldPlaneswalkAsAResultOfRollingThePlanarDie(AnyPlayer), [ChaosEnsues], UntilPlayersNextTurn(You))])",
    "until your next turn, if a source would deal damage, it deals double that damage instead": "ActionList([CreateReplaceWouldDealDamageUntil(DamageWouldBeDealtByASource(AnyDamageSource), [DealDamageInstead(Twice(WouldDealDamage_ThatMuchDamage))], UntilPlayersNextTurn(You))])",
    "until your next turn, target {{Creature}} gets {{PTMod}}, up to one other target {{Creature}} gets {{PTMod}}, and up to one other target {{Creature}} gets {{PTMod}}": "Targeted([TargetPermanent({{Creature[0]}}), UptoOneTargetPermanent(And([Other(Ref_TargetPermanent1), {{Creature[0]}}])), UptoOneTargetPermanent(And([Other(Ref_TargetPermanent1), Other(Ref_TargetPermanent2), {{Creature[1]}}]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent1, [AdjustPT({{PTMod[0]}})], UntilPlayersNextTurn(You)), CreatePermanentLayerEffectUntil(Ref_TargetPermanent2, [AdjustPT({{PTMod[0]}})], UntilPlayersNextTurn(You)), CreatePermanentLayerEffectUntil(Ref_TargetPermanent3, [AdjustPT({{PTMod[0]}})], UntilPlayersNextTurn(You))]))",
    "until your next turn, up to one target opponent can't attack with creatures, up to one target opponent can't cast {{PotentialSpells}}, and up to one target opponent can't cast {{PotentialSpells}}. You can't choose any player as a target more than once": "Targeted_DifferentTargets([UptoOneTargetPlayer(Opponent), UptoOneTargetPlayer(Opponent), UptoOneTargetPlayer(Opponent)], ActionList([CreatePlayerEffectUntil(Ref_TargetPlayer1, [CantAttackWithCreatures(AnyPermanent)], UntilEndOfTurn), CreatePlayerEffectUntil(Ref_TargetPlayer2, [CantCastSpells({{PotentialSpells[0]}})], UntilEndOfTurn), CreatePlayerEffectUntil(Ref_TargetPlayer3, [CantCastSpells({{PotentialSpells[1]}})], UntilEndOfTurn)]))",
    "until your next turn, whenever a player taps a land for mana, that player adds one mana of any type that land produced": "ActionList([CreateTriggerUntil(WhenAPlayerTapsAPermanentForMana(AnyPlayer, IsCardtype(Land)), ActionList([PlayerAction(Trigger_ThatPlayer, AddMana(Trigger_AnyManaTypeProduced))]), UntilPlayersNextTurn(You))])",
    "until your next turn, {{Creatures}} attack each combat if able and attack a player other than you if able": "ActionList([CreateEachPermanentRuleEffectUntil({{Creatures[0]}}, [MustAttackAPlayer(Other(You))], UntilEndOfTurn)])",
    "until your next turn, {{Creatures}} can't attack you or planeswalkers you control unless their controller pays {{ManaCost}} for each of those creatures": "ActionList([CreateEachPermanentRuleEffectUntil({{Creatures[0]}}, [CantAttackPlayerOrPlaneswalkerControlledByUnlessCost(You, PayMana({{ManaCost[0]}}))], UntilPlayersNextTurn(You))])",
    "until your next turn, {{Permanents}} gain \"{{QuotedAbility}}\"": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{QuotedAbility[0]}}])], UntilPlayersNextTurn(You))])",
    "up to X target {{Permanents}} each gain {{Hasable}} and {{Hasable}} until end of turn, where X is {{GameNumber}}": "Targeted([UptoNumberTargetPermanents({{GameNumber[0]}}, {{Permanents[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)]))",
    "up to X target {{Permanents}} get {{PTModX}} until end of turn, where X is {{GameNumber}}": "Targeted([UptoNumberTargetPermanents({{GameNumber[0]}}, {{Permanents[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AdjustPTX({{PTModX[0]}}, {{GameNumber[0]}})], UntilEndOfTurn)]))",
    "up to one target creature you control fights target creature you don't control. If the creature you don't control would die this turn, exile it instead": "Targeted([UptoOneTargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))])), TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(Other(You))]))], ActionList([HaveCreaturesFight(Ref_TargetPermanent1, Ref_TargetPermanent2), CreateReplaceWouldPutIntoGraveyardUntil(APermanentWouldDie(SinglePermanent(Ref_TargetPermanent2)), [ExileItInstead], UntilEndOfTurn)]))",
    "up to one target player puts all the cards from their graveyard on the bottom of their library in a random order": "Targeted([UptoOneTargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, PutEachCardInGraveyardOntoBottomOfLibraryInRandomOrder(AnyCard))]))",
    "up to one target player's life total becomes half their starting life total, rounded down": "Targeted([UptoOneTargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, SetLifeTotal(HalfRoundedDown(StartingLifeTotalOfPlayer(PlayerAction_ThatPlayer))))]))",
    "up to one target {{Artifact}} becomes {{a}} {{PT}} {{Black}} {{Zombie}} creature with {{Hasable}} and {{Hasable}} in addition to its other types": "Targeted([UptoOneTargetPermanent({{Artifact[0]}})], ActionList([CreatePermanentLayerEffect(Ref_TargetPermanent, [SetPT({{PT[0]}}), SetColor(SimpleColorList([{{Black[0]}}])), AddCreatureType({{Zombie[0]}}), AddCardtype(Creature), AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])])]))",
    "up to one target {{Creature}} attacks or blocks this combat if able and up to one target {{Creature}} can't attack or block this combat": "Targeted([TargetPermanent({{Creature[0]}}), TargetPermanent({{Creature[1]}})], ActionList([CreatePermanentRuleEffectUntil(Ref_TargetPermanent1, [MustAttack, MustBlock], UntilEndOfCombat), CreatePermanentRuleEffectUntil(Ref_TargetPermanent2, [CantAttack, CantBlock], UntilEndOfCombat)]))",
