  },
  "{{TriggerActions(~Permanent,X)}}": {
    "create {{a}} {{PT}} {{CreatureToken}}. Put X {{CounterType}} counters on it and attach this Equipment to it": "ActionList([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])]), PutNumberCountersOfTypeOnPermanent(ValueX, {{CounterType[0]}}, TheCreatedToken), AttachPermanentToPermanent({{~Permanent}}, TheCreatedToken)])",
    "distribute X {{CounterType}} counters among any number of other target {{Permanents}}": "TargetedDistributed([UptoNumberTargetPermanents({{X}}, And([Other({{~Permanent}}), {{Permanents[0]}}]))], DistributeNumberAmongTargets({{X}}), ActionList([PutDistributedCounters({{CounterType[0]}})]))",
    "gain control of target {{Artifact}} with mana value X or less. If that artifact is an Equipment, attach it to this creature": "Targeted([TargetPermanent(And([{{Artifact[0]}}, ManaValueIs(LessThanOrEqualTo({{X}}))]))], ActionList([GainControlOfPermanent(Ref_TargetPermanent), If(PermanentPassesFilter(Ref_TargetPermanent, IsArtifactType(Equipment)), [AttachPermanentToPermanent(Ref_TargetPermanent, {{~Permanent}})])]))",
    "roll X six-sided dice. For each odd result, create {{a}} {{PT}} {{CreatureToken}}. For each even result, put {{a}} {{CounterType}} counter on this Vehicle": "ActionList([RollNumberD6({{X}}), CreateTokens([NumberTokens(TheNumberOfDiceResults(Odd), TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, []))]), PutNumberCountersOfTypeOnPermanent(TheNumberOfDiceResults(Even), {{CounterType[0]}}, {{~Permanent}})])"
  },
  "{{TriggerActions(~Plane)}}": {
    "create X {{PT}} {{CreatureTokens}} with {{Hasable}}, where X is {{Number}} plus the number of cards exiled with {{~Plane}}": "ActionList([CreateTokens([NumberTokens(Plus({{Number[0]}}, NumCardsInExile(WasExiledWithPlane({{~Plane}}))), TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}]))])])",
    "for each opponent, choose up to one target {{Permanent}} that opponent controls. Untap those permanents. They phase out. They can't phase in for as long as {{~Plane}} remains face up. When a player planeswalks, those permanents phase in": "Targeted([TargetPermanentEachPlayerControls({{Permanent[0]}}, Opponent)], ActionList([UntapEachPermanent(Ref_TargetPermanents), PhaseOutEachPermanent(Ref_TargetPermanents), CreateGameEffect(AsLongAsPlaneIsFaceUp({{~Plane}}), PermanentsCantPhaseIn(ThePermanentsPhasedOutThisWay)), CreateFutureTrigger(WhenAPlayerPlaneswalks(AnyPlayer), ActionList([PhaseInEachPermanent(ThePermanentsPhasedOutThisWay)]))]))",
    "put {{a}} {{CounterType}} counter on {{~Plane}}": "ActionList([PutACounterOnPlane({{CounterType[0]}}, {{~Plane}})])",
    "put {{a}} {{CounterType}} counter on {{~Plane}}, then add {{ManaProduceSymbol}} for each {{Eachable(ThatPlane)}}": "ActionList([PutACounterOnPlane({{CounterType[0]}}, {{~Plane}}), AddManaRepeated({{ManaProduceSymbol[0]}}, {{Eachable(ThatPlane=^~Plane)[0]}})])",
    "put {{a}} {{CounterType}} counter on {{~Plane}}, then draw cards equal to {{GameNumber(ThatPlane)}}": "ActionList([PutACounterOnPlane({{CounterType[0]}}, {{~Plane}}), DrawNumberCards({{GameNumber(ThatPlane=^~Plane)[0]}})])",
    "put {{a}} {{CounterType}} counter on {{~Plane}}, then you gain life equal to {{GameNumber(ThatPlane)}}": "ActionList([PutACounterOnPlane({{CounterType[0]}}, {{~Plane}}), GainLife({{GameNumber(ThatPlane=^~Plane)[0]}})])",
    "put {{a}} {{CounterType}} counter on {{~Plane}}, then {{~Plane}} deals damage to you equal to {{GameNumber(ThatPlane)}}": "ActionList([PutACounterOnPlane({{CounterType[0]}}, {{~Plane}}), PlaneDealsDamage({{~Plane}}, {{GameNumber(ThatPlane=^~Plane)[0]}}, Player(You))])",
    "put {{a}} {{CounterType}} counter on {{~Plane}}. Then you lose life equal to {{GameNumber(ThatPlane)}}": "ActionList([PutACounterOnPlane({{CounterType[0]}}, {{~Plane}}), LoseLife({{GameNumber(ThatPlane=^~Plane)[0]}})])",
    "scry {{Digits}}. Then put {{a}} {{CounterType}} counter on {{~Plane}}": "ActionList([Scry({{Digits[0]}}), PutACounterOnPlane({{CounterType[0]}}, {{~Plane}})])",
    "you may pay {{ManaCostX}}. If you do, {{~Plane}} deals X damage to any target": "Targeted([AnyTarget], ActionList([MayCost(PayManaAnyX({{ManaCostX[0]}})), If(CostWasPaid, [PlaneDealsDamage({{~Plane}}, ValueX, Ref_AnyTarget)])]))",
    "you may sacrifice any number of {{Permanents}}. If you do, {{~Plane}} deals that much damage to target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([MayCost(SacrificeAnyNumberOfPermanents({{Permanents[0]}})), If(CostWasPaid, [PlaneDealsDamage({{~Plane}}, TheNumberOfPermanentsSacrificedThisWay, Permanent(Ref_TargetPermanent))])]))",
    "{{~Plane}} deals damage to each {{Creature}} and each player equal to the number of {{CounterType}} counters on {{~Plane}}. Each player sacrifices {{a}} {{Permanent}} of their choice. Then planeswalk": "ActionList([PlaneDealsDamage({{~Plane}}, NumberOfCountersOfTypeOnPlane({{CounterType[0]}}, {{~Plane}}), MultipleRecipients([EachPermanent({{Creature[0]}}), EachPlayer(AnyPlayer)])), EachPlayerAction(AnyPlayer, SacrificeAPermanent({{Permanent[0]}})), Planeswalk])",
    "{{~Plane}} deals {{Digits}} damage to any target": "Targeted([AnyTarget], ActionList([PlaneDealsDamage({{~Plane}}, {{Digits[0]}}, Ref_AnyTarget)]))",
    "{{~Plane}} deals {{Digits}} damage to each {{Creature}}": "ActionList([PlaneDealsDamage({{~Plane}}, {{Digits[0]}}, EachPermanent({{Creature[0]}}))])",
    "{{~Plane}} deals {{Digits}} damage to target {{Creature}}. If a creature dealt damage this way would die this turn, exile it instead": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([PlaneDealsDamage({{~Plane}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent)), CreateReplaceWouldPutIntoGraveyardUntil(APermanentWouldDie(And([IsCardtype(Creature), WasDealtDamageThisWay])), [ExileItInstead], UntilEndOfTurn)]))",
    "{{~Plane}} deals {{Digits}} damage to target {{PlayerOrPlaneswalker}}": "Targeted([TargetPlayerOrPermanent({{PlayerOrPlaneswalker[0]}})], ActionList([PlaneDealsDamage({{~Plane}}, {{Digits[0]}}, Ref_TargetPlayerOrPermanent)]))"
  },
  "{{TriggerActions(~Plane,ThatPlayer)}}": {
    "{{~Plane}} deals {{Digits}} damage to that player": "ActionList([PlaneDealsDamage({{~Plane}}, {{Digits[0]}}, Player({{ThatPlayer}}))])"
  },
  "{{TriggerActions(~Spell)}}": {
    "any player may discard {{Number}} cards. If a player does, counter {{~Spell}}": "ActionList([AnyPlayerMayCost(AnyPlayer, DiscardNumberCards({{Number[0]}})), If(CostWasPaid, [CounterSpell({{~Spell}})])])",
    "any player may pay half their life, rounded up. If a player does, counter {{~Spell}}": "ActionList([AnyPlayerMayCost(AnyPlayer, PayLife(HalfRoundedUp(LifeTotalOfPlayer(ActionPlayer)))), If(CostWasPaid, [CounterSpell({{~Spell}})])])",
    "any player may pay {{Digits}} life. If a player does, counter {{~Spell}}": "ActionList([AnyPlayerMayCost(AnyPlayer, PayLife({{Digits[0]}})), If(CostWasPaid, [CounterSpell({{~Spell}})])])",
    "any player may sacrifice {{a}} {{Permanent}} of their choice. If a player does, counter {{~Spell}}": "ActionList([AnyPlayerMayCost(AnyPlayer, SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [CounterSpell({{~Spell}})])])",
    "exile up to one target {{Permanent}}. If you do, {{~Spell}} gains \"{{QuotedAbility}}\"": "Targeted([UptoOneTargetPermanent({{Permanent[0]}})], ActionList([MustCost(ExilePermanent(Ref_TargetPermanent)), If(CostWasPaid, [CreateSpellEffect({{~Spell}}, [AddAbility([{{QuotedAbility[0]}}])])])]))",
    "you may copy {{~Spell}} and may choose a new target for the copy": "ActionList([MayAction(CopySpellAndMayChooseNewTargets({{~Spell}}))])"
  },
  "{{TriggerActions(~Vanguard)}}": {
    "look at the top X cards of your library, where X is {{GameNumber(~Vanguard)}}. Put one of them into your hand, then shuffle": "ActionList([LookAtTheTopNumberCardsOfLibrary({{GameNumber(~Vanguard=^~Vanguard)[0]}}, [PutAGenericCardIntoHand, PutTheRemainingCardsBackIntoLibraryAndShuffle])])",
    "put {{a}} {{CounterType}} counter on {{~Vanguard}}. You draw X cards and you lose X life, where X is {{GameNumber(~Vanguard)}}": "ActionList([PutACounterOnVanguard({{CounterType[0]}}, {{~Vanguard}}), DrawNumberCards({{GameNumber(~Vanguard=^~Vanguard)[0]}}), LoseLife({{GameNumber(~Vanguard=^~Vanguard)[0]}})])",
    "{{~Vanguard}} deals {{Digits}} damage to each opponent": "ActionList([VanguardDealsDamage({{~Vanguard}}, {{Digits[0]}}, EachPlayer(Opponent))])"
  },
  "{{TriggerActions[AddEnchantCreature](~Permanent,ThatPermanent)}}": {
    "it becomes an Aura with enchant creature. Manifest the top card of your library and attach this enchantment to it": "ActionList([CreatePermanentLayerEffect({{~Permanent}}, [AddEnchantmentType(Aura), AddAbility([EnchantPermanent(IsCardtype(Creature))])]), ManifestTheTopCardOfPlayersLibrary(You), AttachPermanentToPermanent({{~Permanent}}, ThePermanentPutOnTheBattlefieldThisWay)])",
    "you may put a name sticker on it, then it becomes an Aura with enchant creature. Return a creature card from your graveyard to the battlefield and attach this Aura to it": "ActionList([PutANameStickerOnPermanent({{~Permanent}}), CreatePermanentLayerEffect({{~Permanent}}, [AddEnchantmentType(Aura), AddAbility([EnchantPermanent(IsCardtype(Creature))])]), PutACardFromPlayersGraveyardOnBattlefield(IsCardtype(Creature), You, [EntersNormally]), AttachPermanentToPermanent({{~Permanent}}, ThePermanentPutOnTheBattlefieldThisWay)])"
  },
  "{{TriggerActions[AtEndOfCombat]}}": {
    "for each creature you controlled at the time it dealt combat damage to a player this turn, copy a random card with the same mana cost as that creature. You may pay {{ManaCost}}. If you do, choose one of those copies. If a copy of a permanent card is chosen, you may create a token that's a copy of that card. If a copy of an instant or sorcery card is chosen, you may cast the copy without paying its mana cost": "ActionList([CreateCopiesOfRandomCardsWithManaCosts(ManaCostsOfCombatCreatures(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), DealtCombatDamageToAPlayerThisTurn(AnyPlayer)]))), MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [ChooseCopyFromCopies, IfElse(CopiedCardPassesFilter(IsPermanent), [MayAction(CreateTokens([TokenFromCopy]))], [MayAction(CastCopiedCardWithoutPaying)])])])",
    "you may exchange control of target creature you control that dealt combat damage to a player this combat and target creature that player controls": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), DealtCombatDamageToAPlayerThisCombat(AnyPlayer)])), TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(WasDealtDamageByPermanentThisCombat(Ref_TargetPermanent1))]))], ActionList([MayAction(ExchangeControl(Ref_TargetPermanent1, Ref_TargetPermanent2))]))"
  },
  "{{TriggerActions[ChooseACreatureType]}}": {
    "choose a creature type": "ActionList([ChooseACreatureType])"
  },
  "{{TriggerActions[ChooseANumber]}}": {
    "you may choose a number between {{RawDigits}} and {{RawDigits}}": "ActionList([MayAction(ChooseANumberBetween({{RawDigits[0]}}, {{RawDigits[1]}}))])"
  },
  "{{TriggerActions[ChooseAPlayer]}}": {
    "choose an opponent": "ActionList([ChooseAPlayer(Opponent)])",
    "secretly choose an opponent": "ActionList([SecretlyChooseAPlayer(Opponent)])"
  },
  "{{TriggerActions[Clash]}}": {
    "tap target {{Creature}}. If you won, that creature doesn't untap during its controller's next untap step": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), If(Trigger_WonTheClash, [PermanentDoesntUntapDuringControllersNextUntap(Ref_TargetPermanent)])]))",
    "you may pay {{ManaCost}}. If you do, create {{a}} {{PT}} {{CreatureToken}}. If you won, that token gains {{Hasable}} until end of turn": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])]), If(Trigger_WonTheClash, [CreatePermanentLayerEffectUntil(TheCreatedToken, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])])])"
  },
  "{{TriggerActions[Crewed](~Permanent)}}": {
    "until end of turn, this Vehicle becomes a copy of target {{Creature}} that crewed it this turn, except it's {{PT}}, it's a Vehicle artifact in addition to its other types, and it has {{Hasable}}": "Targeted([TargetPermanent(And([{{Creature[0]}}, CrewedVehicleThisTurn({{~Permanent}})]))], ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [IsACopyOfPermanent(Ref_TargetPermanent, CopyEffects([SetPT({{PT[0]}}), AddArtifactTypes([Vehicle]), AddCardtypes([Artifact]), AddAbility([{{Hasable[0]}}])]))], UntilEndOfTurn)]))"
  },
  "{{TriggerActions[Devour]}}": {
    "draw a card for each {{Eachable[Devour]}}": "ActionList([DrawNumberCards({{Eachable[Devour][0]}})])",
    "it deals damage to any target equal to twice the number of {{Zombies}} it devoured": "Targeted([AnyTarget], ActionList([PermanentDealsDamage(ThatEnteringPermanent, Twice(NumPermanentsDevouredByEnteringPermanent(IsCreatureType({{Zombies[0]}}))), Ref_AnyTarget)]))",
    "target player discards a card for each {{Eachable[Devour]}}": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, DiscardNumberCards({{Eachable[Devour][0]}}))]))",
    "you gain {{Digits}} life for each {{Eachable[Devour]}}": "ActionList([GainLifeForEach({{Digits[0]}}, {{Eachable[Devour][0]}})])"
  },
  "{{TriggerActions[DoubleKicker]}}": {
    "you gain {{Digits}} life for each time it was kicked": "ActionList([GainLifeForEach({{Digits[0]}}, NumTimesSpellWasKicked(ThatEnteringPermanent))])"
  },
  "{{TriggerActions[EachDefendingPlayer]}}": {
    "each defending player divides all {{Creatures}} they control into a \"left\" pile and a \"right\" pile. Then, for each {{Creature}}, choose \"left\" or \"right\". That creature can't be blocked this combat except by {{Creatures}} and {{Creatures}} in a pile with the chosen label": "ActionList([EachPlayerAction(DefendingPlayerThisCombat, SeparatePermanentsIntoNamedPiles(And([{{Creatures[0]}}, ControlledByAPlayer(SinglePlayer(EachablePlayer))]), [\"Left\", \"Right\"])), ActionForEachPermanent({{Creature[0]}}, [ChooseNamedPileForPermanent([\"Left\", \"Right\"], EachablePermanent), CreatePermanentRuleEffectUntil(EachablePermanent, [CantBeBlockedExceptByDefenders(Or([{{Creatures[1]}}, And([{{Creatures[2]}}, InThePileChosenForPermanent(EachablePermanent)])]))], UntilEndOfCombat)])])"
  },
  "{{TriggerActions[EachPossibleDefendingPlayer]}}": {
    "for each defending player, separate all {{Creatures}} that player controls into two piles and that player chooses one. Only creatures in the chosen piles can block this turn": "ActionList([ActionForEachPlayer(PossibleDefendingPlayerThisCombat, [SeparatePermanentsIntoNumberPiles(And([{{Creatures[0]}}, ControlledByAPlayer(SinglePlayer(EachablePlayer))]), Integer(2)), PlayerAction(EachablePlayer, ChooseAPermanentPile)]), OnlyAllowedBlockersUntilEndOfTurn(InThePermanentPileChosenThisWay)])"
  },
  "{{TriggerActions[EnchantGraveyardCard](~Permanent,ThatPermanent)}}": {
    "it becomes an Aura with \"enchant creature put onto the battlefield with {{~Permanent}}\". Put target {{SpecificCard}} from a graveyard onto the battlefield under your control and attach this enchantment to it. When this enchantment leaves the battlefield, that creature's controller sacrifices it": "Targeted([TargetGraveyardCard({{SpecificCard[0]}})], ActionList([CreatePermanentLayerEffect({{~Permanent}}, [AddEnchantmentType(Aura), AddAbility([EnchantPermanent(And([IsCardtype(Creature), PutOntoBattlefieldByPermanent({{~Permanent}})]))])]), PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersUnderPlayersControl(You)]), AttachPermanentToPermanent({{~Permanent}}, ThePermanentPutOnTheBattlefieldThisWay), CreateFutureTrigger(WhenPermanentLeavesTheBattlefield({{~Permanent}}), ActionList([PlayerAction(ControllerOfPermanent(ThePermanentPutOnTheBattlefieldThisWay), SacrificePermanent(ThePermanentPutOnTheBattlefieldThisWay))]))]))",
    "it loses \"enchant creature card in a graveyard\" and gains \"enchant creature put onto the battlefield with this Aura\". Put enchanted creature card onto the battlefield tapped under your control and attach this Aura to it. When this Aura leaves the battlefield, that creature's controller sacrifices it": "ActionList([CreatePermanentLayerEffect({{~Permanent}}, [LosesAbility(Enchant(IsCardtype(Creature))), AddAbility([EnchantPermanent(And([IsCardtype(Creature), PutOntoBattlefieldByPermanent({{~Permanent}})]))])]), PutGraveyardCardOntoBattlefield(EnchantedGraveyardCard, [EntersTapped, EntersUnderPlayersControl(You)]), AttachPermanentToPermanent({{~Permanent}}, ThePermanentPutOnTheBattlefieldThisWay), CreateFutureTrigger(WhenPermanentLeavesTheBattlefield({{~Permanent}}), ActionList([PlayerAction(ControllerOfLeavingPermanent, SacrificePermanent(ThePermanentPutOnTheBattlefieldThisWay))]))])",
    "it loses \"enchant creature card in a graveyard\" and gains \"enchant creature put onto the battlefield with this Aura\". Return enchanted creature card to the battlefield under your control and attach this Aura to it. When this Aura leaves the battlefield, that creature's controller sacrifices it": "ActionList([CreatePermanentLayerEffect({{~Permanent}}, [LosesAbility(Enchant(IsCardtype(Creature))), AddAbility([EnchantPermanent(And([IsCardtype(Creature), PutOntoBattlefieldByPermanent({{~Permanent}})]))])]), PutGraveyardCardOntoBattlefield(EnchantedGraveyardCard, [EntersUnderPlayersControl(You)]), AttachPermanentToPermanent({{~Permanent}}, ThePermanentPutOnTheBattlefieldThisWay), CreateFutureTrigger(WhenPermanentLeavesTheBattlefield({{~Permanent}}), ActionList([PlayerAction(ControllerOfLeavingPermanent, SacrificePermanent(ThePermanentPutOnTheBattlefieldThisWay))]))])"
  },
  "{{TriggerActions[EnchantedPermanent](ThatPermanent)}}": {
    "it deals {{Digits}} damage to {{EnchantedCreature}}": "ActionList([PermanentDealsDamage({{ThatPermanent}}, {{Digits[0]}}, Permanent(HostPermanent))])",
    "you may put a name sticker on it. When you do, {{EnchantedCreature}} fights up to one target {{Creature}}": "ActionList([MayCost(PutANameStickerOnPermanent({{ThatPermanent}})), If(CostWasPaid, [ReflexiveTrigger(Targeted([UptoOneTargetPermanent({{Creature[0]}})], ActionList([HaveCreaturesFight(HostPermanent, Ref_TargetPermanent)])))])])"
  },
  "{{TriggerActions[EnchantedPermanent](X)}}": {
    "put X {{CounterType}} counters on {{EnchantedPermanent}}": "ActionList([PutNumberCountersOfTypeOnPermanent({{X}}, {{CounterType[0]}}, HostPermanent)])",
    "tap {{EnchantedPermanent}} and put X {{CounterType}} counters on it": "ActionList([TapPermanent(HostPermanent), PutNumberCountersOfTypeOnPermanent({{X}}, {{CounterType[0]}}, HostPermanent)])"
  },
  "{{TriggerActions[EnchantedPermanent](~Permanent)}}": {
    "exile up to one target creature other than enchanted creature until {{ThisPermanent}} leaves the battlefield. Enchanted creature becomes a copy of that creature until {{ThisPermanent}} leaves the battlefield":
      "Targeted([UptoOneTargetPermanent(And([IsCardtype(Creature), Other(HostPermanent)]))], ActionList([ExilePermanentUntil(Ref_TargetPermanent, UntilPermanentLeavesBattlefield(ThisPermanent)), CreatePermanentLayerEffectUntil(HostPermanent, [IsACopyOfPermanent(Ref_TargetPermanent, NoCopyEffects)], UntilPermanentLeavesBattlefield(ThisPermanent))]))",
    "destroy {{EnchantedLand}} and this Aura deals {{Digits}} damage to that land's controller": "ActionList([DestroyPermanent(HostPermanent), PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Player(ControllerOfDestroyedPermanent))])"
  },
  "{{TriggerActions[EnchantedPermanent]}}": {
    "add mana equal to {{EnchantedPermanent}}'s mana cost": "ActionList([AddMana(ManaCostOfPermanent(HostPermanent))])",
    "all damage that would be dealt this turn to you and {{Permanents}} is dealt to {{EnchantedPermanent}} instead": "ActionList([CreateReplaceWouldDealDamageUntil(DamageWouldBeDealtToARecipient(APlayerOrAPermanent(SinglePlayer(You), {{Permanents[0]}})), [DealToCreatureOrPlaneswalkerInstead(HostPermanent)], UntilEndOfTurn)])",
    "choose one -\n* {{TriggerActions_Modal[EnchantedPermanent]}}.\n* {{TriggerActions_Modal}}": "Modal_ChooseOne([{{TriggerActions_Modal[EnchantedPermanent][0]}}, {{TriggerActions_Modal[0]}}])",
    "clash with an opponent. If you win, gain control of {{EnchantedPermanent}}. Otherwise, that player gains control of {{EnchantedPermanent}}": "ActionList([Clash(Opponent, [GainControlOfPermanent(HostPermanent)], [PlayerAction(ClashOpponent, GainControlOfPermanent(HostPermanent))])])",
    "create a token that's a copy of {{EnchantedCreature}}, except it's {{a}} {{Zombie}} in addition to its other types": "ActionList([CreateTokens([TokenCopyOfPermanent(HostPermanent, TokenCopyEffects([AddCreatureTypes([{{Zombie[0]}}])]))])])",
    "create a token that's a copy of {{EnchantedCreature}}, except the token is {{PT}}": "ActionList([CreateTokens([TokenCopyOfPermanent(HostPermanent, TokenCopyEffects([SetPT({{PT[0]}})]))])])",
    "create a token that's a copy of {{EnchantedPermanent}}": "ActionList([CreateTokens([TokenCopyOfPermanent(HostPermanent, NoTokenCopyEffects)])])",
    "create a token that's a copy of {{EnchantedPermanent}}. Then if {{Condition}}, you win the game": "ActionList([CreateTokens([TokenCopyOfPermanent(HostPermanent, NoTokenCopyEffects)]), If({{Condition[0]}}, [WinTheGame])])",
    "destroy {{EnchantedPermanent}}": "ActionList([DestroyPermanent(HostPermanent)])",
    "double the number of {{CounterType}} counters on {{EnchantedPermanent}}": "ActionList([DoubleCountersOfTypeOnPermanent({{CounterType[0]}}, HostPermanent)])",
    "enchanted creature deals damage equal to its power to any other target": "Targeted([AnyTargetExceptPermanent(HostPermanent)], ActionList([PermanentDealsDamage(HostPermanent, PowerOfPermanent(HostPermanent), Ref_AnyTarget)]))",
    "exile {{EnchantedPermanent}}": "ActionList([ExilePermanent(HostPermanent)])",
    "gain control of {{EnchantedPermanent}} until end of turn": "ActionList([GainControlOfPermanentUntil(HostPermanent, UntilEndOfTurn)])",
    "gain control of {{EnchantedPermanent}} until end of turn. Untap that permanent. It gains {{Hasable}} until end of turn": "ActionList([GainControlOfPermanentUntil(HostPermanent, UntilEndOfTurn), UntapPermanent(HostPermanent), CreatePermanentLayerEffectUntil(HostPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "put {{Number}} {{CounterType}} counters on {{EnchantedPermanent}}": "ActionList([PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[0]}}, HostPermanent)])",
    "put {{a}} {{CounterType}} counter on {{EnchantedCreature}}. If {{Condition(ThatPermanent)}}, it deals damage equal to {{GameNumber(ThatCreature)}} to its controller, then destroy that creature and it can't be regenerated": "ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, HostPermanent), If({{Condition(ThatPermanent=HostPermanent)[0]}}, [PermanentDealsDamage(HostPermanent, {{GameNumber(ThatCreature=HostPermanent)[0]}}, Player(ControllerOfPermanent(HostPermanent))), DestroyPermanentNoRegen(HostPermanent)])])",
    "put {{a}} {{CounterType}} counter on {{EnchantedPermanent}}": "ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, HostPermanent)])",
    "put {{a}} {{CounterType}} counter on {{EnchantedPermanent}} if {{Condition(ThatPermanent)}}. Otherwise, remove {{a}} {{CounterType}} counter from it": "ActionList([IfElse({{Condition(ThatPermanent=HostPermanent)[0]}}, [PutACounterOfTypeOnPermanent({{CounterType[0]}}, HostPermanent)], [RemoveACounterOfTypeFromPermanent({{CounterType[0]}}, HostPermanent)])])",
    "remove enchanted creature from combat. Then draw a card for each tapped creature its controller controls": "ActionList([RemoveCreatureFromCombat(HostPermanent), DrawNumberCards(TheNumberOfPermanentsOnTheBattlefield(And([IsTapped, IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(ControllerOfPermanent(HostPermanent)))])))])",
    "return any number of target {{SpecificCards}} from your graveyard to the battlefield attached to {{EnchantedPermanent}}": "Targeted([AnyNumberOfTargetGraveyardCards(And([{{SpecificCards[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([ReturnEachGraveyardCardToBattlefield(Ref_TargetGraveyardCards, [EntersAttachedToPermanent(HostPermanent)])]))",
    "return {{EnchantedCreature}} and all Auras attached to that creature to their owners' hands": "ActionList([PutEachPermanentIntoItsOwnersHand(Or([SinglePermanent(HostPermanent), And([IsEnchantmentType(Aura), AttachedToPermanent(HostPermanent)])]))])",
    "sacrifice {{EnchantedPermanent}}": "ActionList([SacrificePermanent(HostPermanent)])",
    "suspect {{EnchantedPermanent}}": "ActionList([SuspectEachPermanent(SinglePermanent(HostPermanent))])",
    "tap {{EnchantedCreature}} and remove all counters from it": "ActionList([TapPermanent(HostPermanent), RemoveAllCountersFromPermanent(HostPermanent)])",
    "tap {{EnchantedCreature}} and remove it from combat": "ActionList([TapPermanent(HostPermanent), RemoveCreatureFromCombat(HostPermanent)])",
    "tap {{EnchantedCreature}}. It deals damage to you equal to {{GameNumber(ThatCreature)}}": "ActionList([TapPermanent(HostPermanent), PermanentDealsDamage(HostPermanent, {{GameNumber(ThatCreature=HostPermanent)[0]}}, Player(You))])",
    "tap {{EnchantedPermanent}}": "ActionList([TapPermanent(HostPermanent)])",
    "tap {{EnchantedPermanent}} and investigate": "ActionList([TapPermanent(HostPermanent), Investigate])",
    "tap {{EnchantedPermanent}} and you become the monarch": "ActionList([TapPermanent(HostPermanent), BecomeTheMonarch])",
    "tap {{EnchantedPermanent}} and you create {{a}} {{PT}} {{CreatureToken}} with \"{{TokenQuotedAbility}}\"": "ActionList([TapPermanent(HostPermanent), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{TokenQuotedAbility[0]}}])])])",
    "tap {{EnchantedPermanent}}, then proliferate": "ActionList([TapPermanent(HostPermanent), Proliferate])",
    "tap {{EnchantedPermanent}}, then scry {{Digits}}": "ActionList([TapPermanent(HostPermanent), Scry({{Digits[0]}})])",
    "tap {{EnchantedPermanent}}. If {{Condition(ThatPermanent)}}, unattach it": "ActionList([TapPermanent(HostPermanent), If({{Condition(ThatPermanent=HostPermanent)[0]}}, [UnattachPermanent(HostPermanent)])])",
    "target creature you control other than {{EnchantedPermanent}} gets {{PTMod}} and gains {{Hasable}} until end of turn": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), Other(HostPermanent)]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "target player sacrifices a creature of their choice other than enchanted creature": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, SacrificeAPermanent(And([IsCardtype(Creature), Other(HostPermanent)])))]))",
    "unattach {{EnchantedPermanent}}": "ActionList([UnattachPermanent(HostPermanent)])",
    "untap {{EnchantedPermanent}}": "ActionList([UntapPermanent(HostPermanent)])",
    "untap {{EnchantedPermanent}}. It gains {{Hasable}} until end of turn. If it's suspected, it's no longer suspected": "ActionList([UntapPermanent(HostPermanent), CreatePermanentLayerEffectUntil(HostPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), UnsuspectPermanent(Ref_TargetPermanent)])",
    "you may look at the top {{Number}} cards of your library. If you do, you may put a creature card that shares a creature type with {{EnchantedPermanent}} from among them onto the battlefield, then you put the rest of those cards on the bottom of your library in any order": "ActionList([MayAction(LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [MayPutACardOfTypeOntoTheBattlefield(And([IsCardtype(Creature), SharesACreatureTypeWithPermanent(HostPermanent)]), [EntersNormally]), PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder]))])",
    "you may pay {{ManaCost}}. If you do, tap {{EnchantedPermanent}}": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [TapPermanent(HostPermanent)])])",
    "{{EnchantedPermanent}} deals {{Digits}} damage to its owner": "ActionList([PermanentDealsDamage(HostPermanent, {{Digits[0]}}, Player(ControllerOfPermanent(HostPermanent)))])",
    "{{EnchantedPermanent}} gains {{Hasable}} and {{Hasable}} until end of turn": "ActionList([CreatePermanentLayerEffectUntil(HostPermanent, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfCombat)])",
    "{{EnchantedPermanent}} gains {{Hasable}} until end of turn": "ActionList([CreatePermanentLayerEffectUntil(HostPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfCombat)])",
    "{{EnchantedPermanent}} gets {{PTModX}} until end of turn, where X is {{GameNumber}}": "ActionList([CreatePermanentLayerEffectUntil(HostPermanent, [AdjustPTX({{PTModX[0]}}, {{GameNumber[0]}})], UntilEndOfTurn)])",
    "{{EnchantedPermanent}} gets {{PTMod}} until end of turn": "ActionList([CreatePermanentLayerEffectUntil(HostPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfCombat)])",
    "{{EnchantedPermanent}}'s controller sacrifices it and you create {{a}} {{PT}} {{CreatureToken}}": "ActionList([PlayerAction(ControllerOfPermanent(HostPermanent), SacrificePermanent(HostPermanent)), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])])",
    "{{EnchantedPermanent}}'s controller sacrifices {{a}} {{Permanent}} of their choice, then that player loses {{Digits}} life": "ActionList([PlayerAction(ControllerOfPermanent(HostPermanent), SacrificeAPermanent({{Permanent[0]}})), PlayerAction(ControllerOfPermanent(HostPermanent), LoseLife({{Digits[0]}}))])"
  },
  "{{TriggerActions[EnchantedPlayer](~Permanent)}}": {
    "put {{a}} {{CounterType}} counter on this Aura. Then if {{Condition(ThatPermanent)}}, {{EnchantedPlayer}} loses the game": "ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{~Permanent}}), If({{Condition(ThatPermanent=^~Permanent)[0]}}, [PlayerAction(HostPlayer, WinTheGame)])])"
  },
  "{{TriggerActions[EnchantedPlayer]}}": {
    "you may search your library for a Curse card that doesn't have the same name as a Curse attached to {{EnchantedPlayer}}, put it onto the battlefield attached to that player, then shuffle": "ActionList([MayAction(SearchLibrary([FindACardOfType(And([IsEnchantmentType(Curse), DoesntShareANameWithAPermanent(And([IsEnchantmentType(Curse), AttachedToPlayer(HostPlayer)]))])), PutFoundCardsOntoBattlefield([EntersAttachedToPlayer(HostPlayer)]), Shuffle]))])",
    "{{EnchantedPlayer}} creates a Clue token, a Food token, and a Junk token": "ActionList([PlayerAction(HostPlayer, CreateTokens([ClueToken, FoodToken, JunkToken]))])",
    "{{EnchantedPlayer}} mills X cards, where X is {{GameNumber(ThatPlayer)}}": "ActionList([PlayerAction(HostPlayer, MillNumberCards({{GameNumber(ThatPlayer=HostPlayer)[0]}}))])"
  },
  "{{TriggerActions[EquippedCreature](ThatPlayer)}}": {
    "you may have that player gain control of {{EquippedCreature}} until end of turn. If you do, untap it": "ActionList([MayCost(HavePlayerTakeAction({{ThatPlayer}}, GainControlOfPermanentUntil(HostPermanent, UntilEndOfTurn))), If(CostWasPaid, [UntapPermanent(HostPermanent)])])"
  },
  "{{TriggerActions[EquippedCreature]}}": {
    "create a token that's a copy of {{EquippedCreature}}, except the token isn't legendary. That token gains {{Hasable}}": "ActionList([CreateTokens([TokenCopyOfPermanent(HostPermanent, TokenCopyEffects([RemoveSupertypes([Legendary])]))]), CreatePermanentLayerEffect(TheCreatedToken, [AddAbility([{{Hasable[0]}}])])])",
    "exile {{EquippedCreature}}": "ActionList([ExilePermanent(HostPermanent)])",
    "put {{a}} {{CounterType}} counter on {{EquippedCreature}}": "ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, HostPermanent)])",
    "put {{a}} {{CounterType}} counter on {{EquippedCreature}} if {{Condition(ThatPermanent)}}": "ActionList([If({{Condition(ThatPermanent=HostPermanent)[0]}}, [PutACounterOfTypeOnPermanent({{CounterType[0]}}, HostPermanent)])])",
    "put {{a}} {{CounterType}} counter on {{EquippedCreature}}. If {{Condition[EquippedCreature]}}, put {{Number}} {{CounterType}} counters on it instead": "ActionList([IfElse({{Condition[EquippedCreature][0]}}, [PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[1]}}, HostPermanent)], [PutACounterOfTypeOnPermanent({{CounterType[0]}}, HostPermanent)])])",
    "untap {{EquippedCreature}}": "ActionList([UntapPermanent(HostPermanent)])",
    "you may pay {{Energy}}. If you do, untap {{EquippedCreature}}, then put your choice of {{a}} {{CounterType}}, {{CounterType}}, or {{CounterType}} counter on it": "ActionList([MayCost(PayEnergy(Integer({{Energy[0]}}))), If(CostWasPaid, [UntapPermanent(HostPermanent), PutACounterOfChoiceOnPermanent([{{CounterType[0]}}, {{CounterType[1]}}, {{CounterType[2]}}], HostPermanent)])])",
    "{{EquippedCreature}} gets {{PTMod}} until end of turn": "ActionList([CreatePermanentLayerEffectUntil(HostPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])",
    "{{EquippedCreature}} or {{a}} {{Creature}} gets {{PTModX}} until end of turn, where X is {{GameNumber}}": "ActionList([ChooseAPermanent(Or([SinglePermanent(HostPermanent), {{Creature[0]}}])), CreatePermanentLayerEffectUntil(TheChosenPermanent, [AdjustPTX({{PTModX[0]}}, {{GameNumber[0]}})], UntilEndOfTurn)])"
  },
  "{{TriggerActions[ExileACard](ThatPermanent)}}": {
    "exile up to one other target creature from the battlefield or creature card from a graveyard": "Targeted_Modal([Targeted([UptoOneTargetPermanent(And([Other({{ThatPermanent}}), IsCardtype(Creature)]))], ActionList([ExilePermanent(Ref_TargetPermanent)])), Targeted([UptoOneTargetGraveyardCard(IsCardtype(Creature))], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard)]))])"
  },
  "{{TriggerActions[ExileACard](~Permanent)}}": {
    "exile another target {{Permanent}} until this creature leaves the battlefield": "Targeted([TargetPermanent(And([Other({{~Permanent}}), {{Permanent[0]}}]))], ActionList([ExilePermanentUntil(Ref_TargetPermanent, UntilPermanentLeavesBattlefield({{~Permanent}}))]))",
    "exile another {{Permanent}} until {{~Permanent}} leaves the battlefield": "ActionList([ExileAPermanentUntil(And([Other({{~Permanent}}), {{Permanent[0]}}]), UntilPermanentLeavesBattlefield({{~Permanent}}))])",
    "exile target {{Permanent}} until this enchantment leaves the battlefield": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([ExilePermanentUntil(Ref_TargetPermanent, UntilPermanentLeavesBattlefield({{~Permanent}}))]))"
  },
  "{{TriggerActions[ExileACard]}}": {
    "draw a card, then draft a card from {{Spellbook}} and exile it": "ActionList([DrawACard, DraftACardFromSpellBook({{Spellbook[0]}}), ExileCardFromHand(TheCardDraftedThisWay)])",
    "exile a card from a graveyard": "ActionList([Exile([AGraveyardCard(AnyCardInAnyGraveyard)])])",
    "exile target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([ExilePermanent(Ref_TargetPermanent)]))",
    "exile target {{Spell}}": "Targeted([TargetSpell({{Spell[0]}})], ActionList([ExileSpell(Ref_TargetSpell)]))",
    "exile up to one target {{Permanent}}": "Targeted([UptoOneTargetPermanent({{Permanent[0]}})], ActionList([ExilePermanent(Ref_TargetPermanent)]))",
    "look at the top card of each opponent's library and exile those cards face down": "ActionList([LookAtTheTopCardOfEachPlayersLibrary(Opponent), ExileTopCardOfEachPlayersLibrariesFaceDown(Opponent)])",
    "search your library for {{a}} {{SpecificCard}}, exile it, then shuffle": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), ExileFoundCards, Shuffle])])",
    "you may exile target card from a graveyard": "Targeted([TargetGraveyardCard(AnyCardInAnyGraveyard)], ActionList([MayAction(ExileGraveyardCard(Ref_TargetGraveyardCard))]))",
    "you may exile target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([MayAction(ExilePermanent(Ref_TargetPermanent))]))",
    "you may exile {{a}} {{SpecificCard}} from your hand": "ActionList([MayAction(ExileACardOfTypeFromHand({{SpecificCard[0]}}))])"
  },
  "{{TriggerActions[FinishVoting]}}": {
    "each opponent who voted for a choice you didn't vote for loses {{Digits}} life": "ActionList([EachPlayerAction(And([Opponent, VotedForADifferentChoiceThanPlayer(You)]), LoseLife({{Digits[0]}}))])",
    "each opponent who voted for a choice you voted for creates a Treasure token. You scry X, where X is the number of opponents who voted for a choice you didn't vote for. Draw a card": "ActionList([EachPlayerAction(And([Opponent, VotedForTheSameChoiceAsPlayer(You)]), CreateTokens([TreasureToken])), Scry(NumPlayers(And([Opponent, VotedForADifferentChoiceThanPlayer(You)]))), DrawACard])",
    "you and each opponent who voted for a choice you voted for may scry {{Digits}}": "ActionList([EachPlayerMayAction(Or([SinglePlayer(You), And([Opponent, VotedForTheSameChoiceAsPlayer(You)])]), Scry({{Digits[0]}}))])"
  },
  "{{TriggerActions[InCombat]}}": {
    "create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}} named {{NamedCard}} that's tapped and attacking. Sacrifice that token at end of combat": "ActionList([CreateTokensWithFlags([NamedTokenWithPT({{NamedCard[0]}}, {{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])], [EntersTapped, EntersAttacking]), CreateFutureTrigger(AtTheEndOfThisCombat, ActionList([SacrificeEachPermanent(TheTokensCreatedThisWay)]))])"
  },
  "{{TriggerActions[Kicker](~Permanent)}}": {
    "copy the next {{Spell}} you cast this turn when you cast it. If this creature was kicked, copy that spell twice instead. You may choose new targets for the copies": "ActionList([CreateFutureTrigger(WhenPlayerCastsTheirNextSpellThisTurn(You, {{Spell[0]}}), ActionList([IfElse(EnteringPermanentPassesFilter(WasKicked), [CopySpellAndMayChooseNewTargets(Trigger_ThatSpell), CopySpellAndMayChooseNewTargets(Trigger_ThatSpell)], [CopySpellAndMayChooseNewTargets(Trigger_ThatSpell)])]))])"
  },
  "{{TriggerActions[Kicker]}}": {
    "destroy all other {{Permanents}}. If it was kicked, destroy all other {{Permanents}} instead": "ActionList([IfElse(EnteringPermanentPassesFilter(WasKicked), [DestroyEachPermanent(And([Other(ThatEnteringPermanent), {{Permanents[1]}}]))], [DestroyEachPermanent(And([Other(ThatEnteringPermanent), {{Permanents[0]}}]))])])",
    "destroy all {{Permanents}}. If it was kicked, destroy all {{Permanents}} instead": "ActionList([IfElse(EnteringPermanentPassesFilter(WasKicked), [DestroyEachPermanent({{Permanents[1]}})], [DestroyEachPermanent({{Permanents[0]}})])])",
    "draw {{Number}} cards. Then if it wasn't kicked, discard {{Number}} cards": "ActionList([DrawNumberCards({{Number[0]}}), If(EnteringPermanentPassesFilter(WasntKicked), [DiscardNumberCards({{Number[1]}})])])",
    "return target card from your graveyard to your hand. If this spell was kicked, conjure a duplicate of target card in an opponent's graveyard into your hand. It perpetually gains \"{{PerpetualQuotedAbility}}\"": "Targeted([TargetGraveyardCard(InAPlayersGraveyard(SinglePlayer(You))), TargetGraveyardCard(InAPlayersGraveyard(Opponent))], ActionList([ReturnGraveyardCardToHand(Ref_TargetGraveyardCard1), If(EnteringPermanentPassesFilter(WasKicked), [ConjureDuplicateOfGraveyardCardIntoHand(Ref_TargetGraveyardCard2), CreatePerpetualCardInHandEffect(TheCardConjuredIntoHandThisWay, [AddAbility([{{PerpetualQuotedAbility[0]}}])])])]))"
  },
  "{{TriggerActions[LeavesTheBattlefield](ThatPermanent)}}": {
    "create a number of {{PT}} {{CreatureTokens}} equal to its power": "ActionList([CreateTokens([NumberTokens(PowerOfPermanent({{ThatPermanent}}), TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])])",
    "draw a card for each {{CounterType}} counter on it": "ActionList([DrawNumberCards(NumCountersOfTypeOnPermanent({{CounterType[0]}}, {{ThatPermanent}}))])",
    "draw a card if it was attacking. Otherwise, each opponent loses {{Digits}} life": "ActionList([IfElse(PermanentPassesFilter({{ThatPermanent}}, IsAttacking), [DrawACard], [EachPlayerAction(Opponent, LoseLife({{Digits[0]}}))])])",
    "exile all tokens created with it at the beginning of the next end step": "ActionList([CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([ExileEachPermanent(And([IsToken, CreatedByPermanent({{ThatPermanent}})]))]))])",
    "it deals X damage to target player and you gain X life, where X is its power": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PermanentDealsDamage({{ThatPermanent}}, PowerOfPermanent({{ThatPermanent}}), Player(Ref_TargetPlayer)), GainLife(PowerOfPermanent({{ThatPermanent}}))]))",
    "it deals damage to each {{Creature}} equal to half {{GameNumber}}, rounded down": "ActionList([PermanentDealsDamage({{ThatPermanent}}, HalfRoundedDown({{GameNumber[0]}}), EachPermanent({{Creature[0]}}))])",
    "it deals {{Digits}} damage to each {{Creature}}": "ActionList([PermanentDealsDamage({{ThatPermanent}}, {{Digits[0]}}, EachPermanent({{Creature[0]}}))])",
    "it deals {{Digits}} damage to target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([PermanentDealsDamage({{ThatPermanent}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent))]))",
    "its controller draws a card": "ActionList([PlayerAction(ControllerOfLeavingPermanent, DrawACard)])",
    "its controller sacrifices {{a}} {{Permanent}} of their choice": "ActionList([PlayerAction(ControllerOfPermanent({{ThatPermanent}}), SacrificeAPermanent({{Permanent[0]}}))])",
    "its owner creates a tapped {{PT}} {{CreatureToken}} for each {{CounterType}} counter on it": "ActionList([PlayerAction(OwnerOfPermanent({{ThatPermanent}}), CreateTokensWithFlags([NumberTokens(NumCountersOfTypeOnPermanent({{CounterType[0]}}, {{ThatPermanent}}), TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, []))], [EntersTapped]))])",
    "put all cards exiled with it into their owner's graveyard": "ActionList([PutExiledCardsIntoOwnersGraveyards(WasExiledWithPermanent(Trigger_ThatPermanent))])",
    "return all cards exiled with it to the battlefield under their owners' control": "ActionList([PutEachExiledCardOntoTheBattlefield(WasExiledWithPermanent({{ThatPermanent}}), [EntersUnderOwnersControl])])",
    "return each card exiled with it to the battlefield under your control": "ActionList([PutEachExiledCardOntoTheBattlefield(WasExiledWithPermanent({{ThatPermanent}}), [EntersUnderPlayersControl(You)])])",
    "target opponent loses life equal to its power": "Targeted([TargetPlayer(Opponent)], ActionList([PlayerAction(Ref_TargetPlayer, LoseLife(PowerOfPermanent({{ThatPermanent}})))]))",
    "you gain life equal to the number of {{CounterType}} counters on it": "ActionList([GainLife(NumCountersOfTypeOnPermanent({{CounterType[0]}}, {{ThatPermanent}}))])"
  },
  "{{TriggerActions[MilledThisWay]}}": {
    "put {{a}} {{CounterType}} counter on each of up to X target {{Permanents}}, where X is the number of {{SpecificCards}} milled this way": "Targeted([UptoNumberTargetPermanents(Trigger_TheNumberOfCardsOfTypeMilledThisWay({{SpecificCards[0]}}), {{Permanents[0]}})], ActionList([PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, Ref_TargetPermanents)]))"
  },
  "{{TriggerActions[Multikicker](~Permanent)}}": {
    "exile up to X target {{SpecificCards}} from your graveyard, where X is the number of times {{~Permanent}} was kicked. Put {{a}} {{CounterType}} counter on each of them": "Targeted([UptoNumberTargetGraveyardCards(NumTimesSpellWasKicked(ThatEnteringPermanent), And([{{SpecificCards[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([ExileEachGraveyardCard(Ref_TargetGraveyardCards), PutACounterOnEachExiledCard({{CounterType[0]}}, TheCardsExiledThisWay)]))",
    "return up to X target {{SpecificCards}} from your graveyard to the battlefield, where X is the number of times this enchantment was kicked": "Targeted([UptoNumberTargetGraveyardCards(NumTimesSpellWasKicked(ThatEnteringPermanent), And([{{SpecificCards[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([ReturnEachGraveyardCardToBattlefield(Ref_TargetGraveyardCards, [EntersNormally])]))",
    "up to X target {{Permanents}} gain {{Hasable}} until end of turn, where X is the number of times this creature was kicked": "Targeted([UptoNumberTargetPermanents(NumTimesSpellWasKicked(ThatEnteringPermanent), {{Permanents[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))"
  },
  "{{TriggerActions[Multikicker]}}": {
    "create {{a}} {{PT}} {{CreatureToken}} for each time it was kicked": "ActionList([CreateTokens([NumberTokens(NumTimesSpellWasKicked(ThatEnteringPermanent), TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, []))])])",
    "it deals damage to target {{PlayerOrPlaneswalker}} equal to twice the number of times it was kicked": "Targeted([TargetPlayerOrPermanent({{PlayerOrPlaneswalker[0]}})], ActionList([PermanentDealsDamage(ThatEnteringPermanent, Twice(NumTimesSpellWasKicked(ThatEnteringPermanent)), Ref_TargetPlayerOrPermanent)]))",
    "target opponent discards a card for each time it was kicked": "Targeted([TargetPlayer(Opponent)], ActionList([PlayerAction(Ref_TargetPlayer, DiscardNumberCards(NumTimesSpellWasKicked(ThatEnteringPermanent)))]))",
    "you gain {{Digits}} life for each time it was kicked": "ActionList([GainLifeForEach({{Digits[0]}}, NumTimesSpellWasKicked(ThatEnteringPermanent))])"
  },
  "{{TriggerActions[TheChosenColor](ThatPermanent)}}": {
    "its controller adds an additional one mana of the chosen color": "ActionList([PlayerAction(ControllerOfPermanent({{ThatPermanent}}), AddMana(ManaOfTheChosenColor))])"
  },
  "{{TriggerActions[TheChosenColor](~Permanent,ThatPlayer)}}": {
    "this enchantment deals X damage to that player, where X is {{GameNumber[TheChosenColor](ThatPlayer)}}": "ActionList([PermanentDealsDamage({{~Permanent}}, {{GameNumber[TheChosenColor](ThatPlayer=^ThatPlayer)[0]}}, Player({{ThatPlayer}}))])"
  },
  "{{TriggerActions[TheChosenColors](ThatSpell)}}": {
    "you gain {{Digits}} life for each of the chosen colors it is": "ActionList([GainLifeForEach({{Digits[0]}}, TheNumberOfChosenColorsSpellIs({{ThatSpell}}))])"
  },
  "{{TriggerActions[TheChosenCreatureType](ThatPermanent)}}": {
    "other {{Creatures}} of the chosen type and {{CreatureCards}} of that type in your hand perpetually get {{PTMod}}": "ActionList([CreatePerpetualEachPermanentEffect(And([{{Creatures[0]}}, IsCreatureTypeVariable(TheChosenCreatureType)]), [AdjustPT({{PTMod[0]}})]), CreatePerpetualCardsInPlayersHandEffect(And([{{CreatureCards[0]}}, IsCreatureTypeVariable(TheChosenCreatureType)]), You, [AdjustPT({{PTMod[0]}})])])"
  },
  "{{TriggerActions[TheChosenCreatureType]}}": {
    "for each token you control of the chosen type that entered this turn, create a token that's a copy of it": "ActionList([CreateTokens([TokenCopyOfEachPermanent(And([IsToken, ControlledByAPlayer(SinglePlayer(You)), IsCreatureTypeVariable(TheChosenCreatureType), EnteredTheBattlefieldThisTurn]), NoTokenCopyEffects)])])",
    "look at the top card of your library. If it's a creature card of the chosen type, you may reveal it and put it into your hand": "ActionList([LookAtTopOfLibrary, MayAction(RevealTopCardOfLibraryAndPutIntoHand(And([IsCardtype(Creature), IsCreatureTypeVariable(TheChosenCreatureType)])))])",
    "return target creature card of the chosen type from your graveyard to the battlefield with {{a}} {{CounterType}} counter on it": "Targeted([TargetGraveyardCard(And([IsCardtype(Creature), IsCreatureTypeVariable(TheChosenCreatureType), InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersWithACounter({{CounterType[0]}})])]))",
    "reveal the top {{Number}} cards of your library. Put all creature cards of the chosen type revealed this way into your hand and the rest on the bottom of your library in any order": "ActionList([RevealTheTopNumberCardsOfLibrary({{Number[0]}}, [PutEachCardOfTypeIntoHand(And([IsCardtype(Creature), IsCreatureTypeVariable(TheChosenCreatureType)])), PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder])])"
  },
  "{{TriggerActions[TheChosenName]}}": {
    "you may search your library for any number of cards with that name, reveal them, put them into your hand, then shuffle": "ActionList([MayAction(SearchLibrary([FindAnyNumberOfCardsOfType(IsNamed(TheChosenName)), RevealFoundCards, PutFoundCardsIntoHand, Shuffle]))])"
  },
  "{{TriggerActions[TheChosenPlayer](ThatPermanent,ThatMuch)}}": {
    "it deals that much damage to the chosen player": "ActionList([PermanentDealsDamage({{ThatPermanent}}, {{ThatMuch}}, Player(TheChosenPlayer))])"
  },
  "{{TriggerActions[TheExiledCard](ThatMuch)}}": {
    "create that many {{PT}} {{CreatureTokens}}. Then if {{Condition}}, you may play the exiled card without paying its mana cost": "ActionList([CreateTokens([NumberTokens({{ThatMuch}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))]), If({{Condition[0]}}, [MayAction(PlayExiledCardWithoutPaying(TheExiledCard))])])"
  },
  "{{TriggerActions[TheExiledCard](ThatPermanent)}}": {
    "until end of turn, it becomes a copy of the exiled card, except it's a Vehicle artifact in addition to its other types": "ActionList([CreatePermanentLayerEffectUntil(Trigger_ThatPermanent, [IsACopyOfExiledCard(TheExiledCard, CopyEffects([AddArtifactTypes([Vehicle]), AddCardtypes([Artifact])]))], UntilEndOfTurn)])",
    "you may sacrifice it. If you do, you may cast the exiled card without paying its mana cost": "ActionList([MayCost(SacrificePermanent({{ThatPermanent}})), If(CostWasPaid, [MayAction(CastSpellFromExileWithoutPaying(AnySpell, TheExiledCard))])])"
  },
  "{{TriggerActions[TheExiledCard](~Permanent)}}": {
    "you may cast the exiled card without paying its mana cost. If you do, return this Vehicle to its owner's hand": "ActionList([MayCost(CastSpellFromExileWithoutPaying(AnySpell, TheExiledCard)), If(CostWasPaid, [PutPermanentIntoItsOwnersHand({{~Permanent}})])])"
  },
  "{{TriggerActions[TheExiledCard]}}": {
    "create a Treasure token. Then you may pay {{ManaCost}}. If you do, you may play the exiled card without paying its mana cost": "ActionList([CreateTokens([TreasureToken]), MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [MayAction(PlayExiledCardWithoutPaying(TheExiledCard))])])",
    "draw a card. Then if {{Condition}}, you may play the exiled card without paying its mana cost": "ActionList([DrawACard, If({{Condition[0]}}, [MayAction(PlayExiledCardWithoutPaying(TheExiledCard))])])",
    "put the exiled card into its owner's hand": "ActionList([PutExiledCardIntoOwnersHand(TheExiledCard)])",
    "put the exiled cards onto the battlefield under their owners' control": "ActionList([PutEachExiledCardOntoTheBattlefield(TheExiledCards, [EntersUnderOwnersControl])])",
    "put {{a}} {{CounterType}} counter on target {{Permanent}}. Then if {{Condition}}, you may play the exiled card without paying its mana cost": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent), If({{Condition[0]}}, [MayAction(PlayExiledCardWithoutPaying(TheExiledCard))])]))",
    "return the exiled card to its owner's hand": "ActionList([PutExiledCardIntoOwnersHand(TheExiledCard)])",
    "you may copy the exiled card. If you do, you may cast the copy without paying its mana cost": "ActionList([MayCost(CopyExiledCard(TheExiledCard)), If(CostWasPaid, [MayAction(CastCopiedCardWithoutPaying)])])",
    "you may mill {{Number}} cards. Then if {{Condition}}, you may play the exiled card without paying its mana cost": "ActionList([MayAction(MillNumberCards({{Number[0]}})), If({{Condition[0]}}, [MayAction(PlayExiledCardWithoutPaying(TheExiledCard))])])"
  },
  "{{TriggerActions[ThisScheme](ThatPlayer)}}": {
    "they may sacrifice {{Number}} {{Permanents}} of their choice. If they do, abandon this scheme": "ActionList([PlayerMayCost({{ThatPlayer}}, SacrificeNumberPermanents({{Number[0]}}, {{Permanents[0]}})), If(CostWasPaid, [AbandonScheme(ThisScheme)])])",
    "they may tap any number of untapped creatures they control with total power {{Digits}} or greater. If they do, abandon this scheme": "ActionList([PlayerMayCost({{ThatPlayer}}, TapAnyNumberOfGroupPermanents(And([IsUntapped, IsCardtype(Creature), ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]), TotalPowerIs(GreaterThanOrEqualTo({{Digits[0]}})))), If(CostWasPaid, [AbandonScheme(ThisScheme)])])"
  },
  "{{TriggerActions[ThisScheme]}}": {
    "abandon this scheme": "ActionList([AbandonScheme(ThisScheme)])",
    "abandon this scheme at end of combat": "ActionList([CreateFutureTrigger(AtTheNextEndOfCombat, ActionList([AbandonScheme(ThisScheme)]))])",
    "abandon this scheme unless you discard a card or pay {{Digits}} life": "ActionList([MayCost(Or([DiscardACard, PayLife({{Digits[0]}})])), Unless(CostWasPaid, [AbandonScheme(ThisScheme)])])",
    "create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}}, then abandon this scheme": "ActionList([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])]), AbandonScheme(ThisScheme)])",
    "draw {{Number}} cards, then abandon this scheme": "ActionList([DrawNumberCards({{Number[0]}}), AbandonScheme(ThisScheme)])",
    "put {{a}} {{CounterType}} counter on this scheme, then this scheme deals damage equal to {{GameNumber(ThatScheme)}} to the opponent with the highest life total among your opponents. If two or more players are tied for highest life total, you choose one": "ActionList([PutACounterOnScheme({{CounterType[0]}}, ThisScheme), ChooseAPlayer(And([Opponent, LifeTotalIs(EqualTo(HighestLifeTotalAmongPlayers(Opponent)))])), SchemeDealsDamage(ThisScheme, {{GameNumber(ThatScheme=ThisScheme)[0]}}, Player(TheChosenPlayer))])",
    "reveal the top {{Number}} cards of your library and put them into your hand. When you reveal one or more nonland cards this way, this scheme deals damage equal to their total mana value to any target": "ActionList([RevealTheTopNumberCardsOfLibrary({{Number[0]}}, [PutTheRemainingCardsIntoHand]), If(ACardWasRevealedThisWay(IsNonCardtype(Land)), [ReflexiveTrigger(Targeted([AnyTarget], ActionList([SchemeDealsDamage(ThisScheme, TotalManaValueOfTheCardsRevealedThisWay, Ref_AnyTarget)])))])])",
    "target opponent chooses self or others. If that player chooses self, this scheme deals {{Digits}} damage to that player. If the player chooses others, this scheme deals {{Digits}} damage to each of your other opponents": "Targeted([TargetPlayer(Opponent)], ActionList([PlayerAction(Ref_TargetPlayer, ChooseANamedAction([NamedAction(\"Self\", [SchemeDealsDamage(ThisScheme, {{Digits[0]}}, Player(PlayerAction_ThatPlayer))]), NamedAction(\"Others\", [SchemeDealsDamage(ThisScheme, {{Digits[1]}}, EachPlayer(And([Opponent, Other(PlayerAction_ThatPlayer)])))])]))]))",
    "you may cast {{a}} {{Spell}} from your hand without paying its mana cost. If you do, abandon this scheme": "ActionList([MayCost(CastASpellFromHandWithoutPaying({{Spell[0]}})), If(CostWasPaid, [AbandonScheme(ThisScheme)])])",
    "you may pay {{ManaCostX}}. If you do, this scheme deals X damage to target {{PlayerOrPlaneswalker}} and each creature that player or that planeswalker's controller controls": "Targeted([TargetPlayerOrPermanent({{PlayerOrPlaneswalker[0]}})], ActionList([MayCost(PayManaAnyX({{ManaCostX[0]}})), If(CostWasPaid, [SchemeDealsDamage(ThisScheme, ValueX, MultipleRecipients([Ref_TargetPlayerOrPermanent, EachPermanent(And([IsCardtype(Creature), ControlledByPlayer(PlayerOrControllerOfPermanent(Ref_TargetPlayerOrPermanent))]))]))])]))"
  },
  "{{TriggerActions[WhenACardIsPutIntoAGraveyardFromAnywhere]}}": {
    "you may pay life equal to its mana value. If you do, put it onto the battlefield under your control. It's {{a}} {{Zombie}} in addition to its other types": "ActionList([MayCost(PayLife(ManaValueOfCardPutInGraveyard)), If(CostWasPaid, [ReturnNewGraveyardCardToBattlefield([EntersUnderPlayersControl(You)]), CreatePermanentLayerEffect(ThePermanentPutOnTheBattlefieldThisWay, [AddCreatureType({{Zombie[0]}})])])])"
  },
  "{{TriggerActions[WhenACardIsPutIntoAGraveyardFromTheirLibrary]}}": {
    "exile that card and create {{a}} {{PT}} {{CreatureToken}}": "ActionList([ExileGraveyardCard(Trigger_ThatGraveyardCard), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])])"
  },
  "{{TriggerActions[WhenACardIsPutIntoAGraveyard]}}": {
    "exile it with {{a}} {{CounterType}} counter on it": "ActionList([ExileGraveyardCardWithACounterOfType(TheCardDiscardedThisWay, {{CounterType[0]}})])",
    "it perpetually gains \"{{PerpetualQuotedAbility}}\"": "ActionList([CreatePerpetualGraveyardCardEffect(TheCardDiscardedThisWay, [AddAbility([{{PerpetualQuotedAbility[0]}}])])])"
  },
  "{{TriggerActions[WhenACreatureBlocksAnotherCreature]}}": {
    "destroy the attacking creature": "ActionList([DestroyPermanent(Trigger_TheAttackingCreature)])",
    "the blocking creature gets {{PTMod}} until end of turn": "ActionList([CreatePermanentLayerEffectUntil(Trigger_TheBlockingCreature, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])"
  },
  "{{TriggerActions[WhenACreatureIsDevoured]}}": {
    "create {{a}} {{PTX}} {{CreatureToken}}, where X is the devoured creature's power": "ActionList([CreateTokens([TokenWithPT(PTX({{PTX[0]}}, PowerOfTheDevouredCreature), {{CreatureToken[0]}}, [])])])"
  },
  "{{TriggerActions[WhenACreatureOrPlaneswalkerDies,TheCreatureOrPlaneswalker=~](~Permanent)}}": {
    "clash with an opponent. If you win, return this card to its owner's hand": "ActionList([Clash(Opponent, [ReturnDeadGraveyardCardToHand], [DoNothing])])",
    "conjure a card named {{NamedCard}} into your graveyard. Perpetually double the power and toughness of {{~Dead}} and that card, then shuffle them into their owner's library": "ActionList([ConjureACardIntoGraveyard({{NamedCard[0]}}), CreatePerpetualEachGraveyardCardEffect(Or([SingleGraveyardCard(Trigger_ThatGraveyardCard), SingleGraveyardCard(TheCardConjuredIntoGraveyardThisWay)]), [DoubleCreaturesPowerAndToughness])])",
    "create X tapped {{PT}} {{CreatureTokens}}, where X is this creature's power": "ActionList([CreateTokensWithFlags([NumberTokens(PowerOfDeadPermanent, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))], [EntersTapped])])",
    "create X {{PT}} {{CreatureTokens}} with {{Hasable}}, where X is {{GameNumber(~Permanent)}}": "ActionList([CreateTokens([NumberTokens({{GameNumber(~Permanent=^~Permanent)[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}]))])])",
    "create a number of {{PT}} {{CreatureTokens}} equal to this creature's power": "ActionList([CreateTokens([NumberTokens(PowerOfDeadPermanent, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])])",
    "create {{a}} {{PTX}} {{CreatureToken}}, where X is the number of {{CounterType}} counters on {{~Dead}}": "ActionList([CreateTokens([TokenWithPT(PTX({{PTX[0]}}, NumCountersOfTypeOnDeadPermanent({{CounterType[0]}})), {{CreatureToken[0]}}, [])])])",
    "create {{a}} {{PTX}} {{CreatureToken}}, where X is this creature's power": "ActionList([CreateTokens([TokenWithPT(PTX({{PTX[0]}}, PowerOfDeadPermanent), {{CreatureToken[0]}}, [])])])",
    "create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}} for each {{CounterType}} counter on this creature": "ActionList([CreateTokens([NumberTokens(NumCountersOfTypeOnDeadPermanent({{CounterType[0]}}), TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}]))])])",
    "distribute X {{CounterType}} counters among any number of target {{Permanents}}, where X is the number of {{CounterType}} counters on this creature": "TargetedDistributed([UptoNumberTargetPermanents(NumCountersOfTypeOnDeadPermanent({{CounterType[1]}}), {{Permanents[0]}})], DistributeNumberAmongTargets(NumCountersOfTypeOnDeadPermanent({{CounterType[1]}})), ActionList([PutDistributedCounters({{CounterType[0]}})]))",
    "each player mills {{Number}} cards. Then you may exile this card. When you do, put target {{SpecificCard}} from your graveyard on top of your library": "ActionList([EachPlayerAction(AnyPlayer, MillNumberCards({{Number[0]}})), MayCost(ExileGraveyardCard(Trigger_ThatGraveyardCard)), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardOnTopOfLibrary(Ref_TargetGraveyardCard)])))])])",
    "exile it and choose target {{Creature}}. When that creature leaves the battlefield, return this card from exile to the battlefield under its owner's control": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([ExileGraveyardCard(Trigger_ThatGraveyardCard), CreateFutureTrigger(WhenPermanentLeavesTheBattlefield(Ref_TargetPermanent), ActionList([PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersUnderOwnersControl])]))]))",
    "exile it and create {{Number}} tapped Treasure tokens": "ActionList([ExileGraveyardCard(Trigger_ThatGraveyardCard), CreateTokensWithFlags([NumberTokens({{Number[0]}}, TreasureToken)], [EntersTapped])])",
    "exile it and each other player creates {{a}} {{PT}} {{CreatureToken}} with {{Hasable}}": "ActionList([ExileGraveyardCard(Trigger_ThatGraveyardCard), EachPlayerAction(Other(You), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])]))])",
    "exile it, then return another target {{SpecificCard}} from your graveyard to your hand": "Targeted([TargetGraveyardCard(And([Other(Trigger_ThatGraveyardCard), {{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([ExileGraveyardCard(Trigger_ThatGraveyardCard), PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersNormally])]))",
    "exile it, then return the top creature card of your graveyard to the battlefield": "ActionList([ExileGraveyardCard(Trigger_ThatGraveyardCard), PutGraveyardCardOntoBattlefield(TopCardOfTypeOfPlayersGraveyard(IsCardtype(Creature), You), [EntersNormally])])",
    "exile it, then shuffle all {{SpecificCards}} from your graveyard into your library": "ActionList([ExileGraveyardCard(Trigger_ThatGraveyardCard), ShuffleEachCardInGraveyardIntoLibrary({{SpecificCards[0]}})])",
    "it deals X damage to any target, where X is {{GameNumber}}": "Targeted([AnyTarget], ActionList([DeadPermanentDealsDamage({{GameNumber[0]}}, Ref_AnyTarget)]))",
    "it deals X damage to target {{Creature}}, where X is {{Digits}} plus the amount of damage dealt to this creature this turn by other sources named {{NamedCard}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([DeadPermanentDealsDamage(Plus({{Digits[0]}}, TheAmountOfDamageDealtToPermanentThisTurnBySources(Trigger_ThatPermanent, And([Other(Trigger_ThatPermanent), IsNamed(NamedCard({{NamedCard[0]}}))]))), Permanent(Ref_TargetPermanent))]))",
    "put X {{CounterType}} counters on each {{Permanent}}, where X is the number of {{CounterType}} counters on {{~Permanent}}": "ActionList([PutNumberCountersOfTypeOnEachPermanent(NumCountersOfTypeOnDeadPermanent({{CounterType[1]}}), {{CounterType[0]}}, {{Permanent[0]}})])",
    "put X {{CounterType}} counters on target {{Permanent}}, where X is the number of {{CounterType}} counters on this creature": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutNumberCountersOfTypeOnPermanent(NumCountersOfTypeOnDeadPermanent({{CounterType[1]}}), {{CounterType[0]}}, Ref_TargetPermanent)]))",
    "put {{a}} {{CounterType}} counter on target {{Permanent}} for each {{CounterType}} counter on this creature": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutNumberCountersOfTypeOnPermanent(NumCountersOfTypeOnDeadPermanent({{CounterType[1]}}), {{CounterType[0]}}, Ref_TargetPermanent)]))",
    "return another target {{SpecificCard}} with mana value less than or equal to this creature's power from your graveyard to the battlefield": "Targeted([TargetGraveyardCard(And([Other(Trigger_ThatGraveyardCard), {{SpecificCard[0]}}, ManaValueIs(LessThanOrEqualTo(PowerOfDeadPermanent)), InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersNormally])]))",
    "return any number of other creature cards with total power X or less from your graveyard to the battlefield, where X is this creature's power. Exile this card": "ActionList([ReturnAnyNumberOfGroupCardsFromPlayersGraveyardToBattlefield(And([Other(Trigger_ThatGraveyardCard), IsCardtype(Creature)]), TotalPowerIs(LessThanOrEqualTo(PowerOfDeadPermanent)), You, [EntersNormally]), ExileGraveyardCard(Trigger_ThatGraveyardCard)])",
    "return it to the battlefield tapped": "ActionList([PutGraveyardCardOntoBattlefield(Trigger_ThatGraveyardCard, [EntersTapped])])",
    "return it to the battlefield. It's an Aura enchantment with enchant {{Land}} and \"{{QuotedAbility}}\". {{~Permanent}} loses all other abilities": "ActionList([ReturnDeadGraveyardCardToBattlefield([EntersNormally]), CreatePermanentLayerEffect(ThePermanentPutOnTheBattlefieldThisWay, [AddAbilityAndLoseAllOtherAbilities([EnchantPermanent({{Land[0]}})]), AddAbility([{{QuotedAbility[0]}}])])])",
    "return this card to the battlefield under your control. He's {{a}} {{Zombie}} in addition to his other types": "ActionList([ReturnDeadGraveyardCardToBattlefield([EntersUnderPlayersControl(You), EntersWithLayerEffect([AddCreatureType({{Zombie[0]}})])])])",
    "roll a six-sided die. If the result is {{Digits}} or less, this creature deals that much damage to you": "ActionList([RollAD6, If(DiceResultIs(LessThanOrEqualTo({{Digits[0]}})), [DeadPermanentDealsDamage(TheDiceResult, Player(You))])])",
    "search your library for up to X {{SpecificCards}}, where X is this creature's power, put them onto the battlefield, then shuffle": "ActionList([SearchLibrary([FindNumberCardsOfType(PowerOfDeadPermanent, {{SpecificCards[0]}}), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle])])",
    "target {{Creature}} gets {{PTModX}} until end of turn, where X is this creature's power": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreateValueX(PowerOfDeadPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTX({{PTModX[0]}}, ValueX)], UntilEndOfTurn)]))",
    "target {{Land}} becomes {{a}} {{Swamp}}. Exile this card": "Targeted([TargetPermanent({{Land[0]}})], ActionList([CreatePermanentLayerEffect(Ref_TargetPermanent, [AddLandType({{Swamp[0]}})]), ExileGraveyardCard(Trigger_ThatGraveyardCard)]))",
    "this creature deals {{Digits}} damage to any target": "Targeted([AnyTarget], ActionList([DeadPermanentDealsDamage({{Digits[0]}}, Ref_AnyTarget)]))",
    "you gain life equal to this creature's power": "ActionList([GainLife(PowerOfDeadPermanent)])",
    "you may distribute a number of {{CounterType}} counters equal to the number of {{CounterType}} counters on this creature among any number of {{Permanents}}": "ActionList([MayAction(DistributeNumberCountersOfTypeAmongAnyNumberOfPermanents(NumCountersOfTypeOnDeadPermanent({{CounterType[1]}}), {{CounterType[0]}}, {{Permanents[0]}}))])",
    "you may exile it and collect evidence {{Digits}}. If you do, return this card to the battlefield tapped": "ActionList([MayCost(And([ExileGraveyardCard(Trigger_ThatGraveyardCard), CollectEvidence({{Digits[0]}})])), If(CostWasPaid, [PutExiledCardOntoBattlefield(ThisExiledCard, [EntersTapped])])])",
    "you may gain {{Digits}} life for each {{Eachable}}. If you do, exile this card from your graveyard": "ActionList([MayCost(GainLifeForEach({{Digits[0]}}, {{Eachable[0]}})), If(CostWasPaid, [ExileGraveyardCard(Trigger_ThatGraveyardCard)])])",
    "you may pay {{Energy}}. When you do, this creature deals damage equal to its power to any target": "ActionList([MayCost(PayEnergy(Integer({{Energy[0]}}))), If(CostWasPaid, [ReflexiveTrigger(Targeted([AnyTarget], ActionList([PermanentDealsDamage(Trigger_ThatPermanent, PowerOfPermanent(Trigger_ThatPermanent), Ref_AnyTarget)])))])])",
    "you may pay {{ManaCost}}. If you do, for each creature that dealt damage to this creature this turn, destroy that creature unless its controller pays {{Digits}} life. A creature destroyed this way can't be regenerated": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [ActionForEachPermanent(And([IsCardtype(Creature), DealtDamageToPermanentThisTurn(Trigger_ThatPermanent)]), [PlayerMayCost(ControllerOfPermanent(EachablePermanent), PayLife({{Digits[0]}})), Unless(CostWasPaid, [DestroyPermanentNoRegen(EachablePermanent)])])])])",
    "you may pay {{ManaCost}}. When you do, {{~Permanent}} deals damage equal to its power to each opponent": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [ReflexiveTrigger(ActionList([PermanentDealsDamage({{~Permanent}}, PowerOfPermanent({{~Permanent}}), EachPlayer(Opponent))]))])])",
    "you may put {{a}} {{CounterType}} counter on target {{Permanent}} for each {{CounterType}} counter on this creature": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([MayAction(PutNumberCountersOfTypeOnPermanent(NumCountersOfTypeOnDeadPermanent({{CounterType[1]}}), {{CounterType[0]}}, Ref_TargetPermanent))]))"
  },
  "{{TriggerActions[WhenACreatureOrPlaneswalkerDies,TheDeadCreatureOrPlaneswalker=EnchantedCreature]}}": {
    "choose a creature at random this card can enchant. Return this card to the battlefield attached to that creature": "ActionList([ChooseAPermanentAtRandom(And([IsCardtype(Creature), CanBeEnchantedByDeadGuest])), ReturnDeadGuestGraveyardCardToBattlefield([EntersAttachedToPermanent(TheChosenPermanent)])])",
    "draw a card for each {{CounterType}} counter on this Aura": "ActionList([DrawNumberCards(NumCountersOfTypeOnDeadGuestPermanent({{CounterType[0]}}))])",
    "its controller chooses target creature one of their opponents controls. Return this card from its owner's graveyard to the battlefield attached to that creature": "Targeted([TargetPermanentOfPlayersChoice(And([IsCardtype(Creature), ControlledByAPlayer(OpponentOf(ControllerOfDeadPermanent))]), ControllerOfDeadPermanent)], ActionList([ReturnDeadGuestGraveyardCardToBattlefield([EntersAttachedToPermanent(Ref_TargetPermanent)])]))",
    "return it to the battlefield under your control, then return this card to the battlefield transformed under your control": "ActionList([ReturnDeadGraveyardCardToBattlefield([EntersUnderPlayersControl(You)]), ReturnDeadGuestGraveyardCardToBattlefield([EntersTransformed, EntersUnderPlayersControl(You)])])",
    "return that card to its owner's hand. If that card is returned to its owner's hand this way, you may pay {{ManaCost}}. If you do, return this card to its owner's hand": "ActionList([MustCost(PutGraveyardCardIntoHand(Trigger_ThatGraveyardCard)), If(CostWasPaid, [MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [ReturnDeadGuestGraveyardCardToHand])])])",
    "return that card to the battlefield under its owner's control. Return this card to the battlefield attached to that creature at the beginning of the next end step": "ActionList([ReturnDeadGraveyardCardToBattlefield([EntersUnderOwnersControl]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([ReturnDeadGuestGraveyardCardToBattlefield([EntersAttachedToPermanent(ThePermanentPutOnTheBattlefieldThisWay)])]))])",
    "return this card to its owner's hand and you create {{a}} {{PT}} {{CreatureToken}} named {{NamedCard}}": "ActionList([ReturnDeadGuestGraveyardCardToHand, CreateTokens([NamedTokenWithPT({{NamedCard[0]}}, {{PT[0]}}, {{CreatureToken[0]}}, [])])])",
    "that creature's controller chooses a creature that this card could enchant. If the player does, return this card to the battlefield under your control attached to that creature. If they don't, return this card to the battlefield under your control as a non-Aura enchantment. It loses \"enchant creature\" and gains \"At the beginning of that player's upkeep, this enchantment deals {{Digits}} damage to that player\"": "ActionList([PlayerMustCost(ControllerOfDeadPermanent, ChooseAPermanent(And([IsCardtype(Creature), CanBeEnchantedByDeadGuest]))), IfElse(CostWasPaid, [ReturnDeadGuestGraveyardCardToBattlefield([EntersUnderPlayersControl(You), EntersAttachedToPermanent(TheChosenPermanent)])], [ReturnDeadGuestGraveyardCardToBattlefield([EntersUnderPlayersControl(You), EntersAsNonAuraEnchantment]), CreatePermanentLayerEffect(ThePermanentPutOnTheBattlefieldThisWay, [LosesAbility(Enchant(IsCardtype(Creature))), AddAbility([TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(ControllerOfDeadPermanent)), ActionList([PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, Player(Trigger_ThatPlayer))]))])])])])",
    "this Aura deals X damage to any target, where X is the number of {{CounterType}} counters on this Aura": "Targeted([AnyTarget], ActionList([DeadGuestPermanentDealsDamage(NumCountersOfTypeOnDeadGuestPermanent({{CounterType[0]}}), Ref_AnyTarget)]))",
    "this Aura deals damage equal to that creature's toughness to the creature's controller": "ActionList([DeadGuestPermanentDealsDamage(ToughnessOfDeadPermanent, Player(ControllerOfDeadPermanent))])",
    "this Aura deals {{Digits}} damage to that creature's controller": "ActionList([DeadGuestPermanentDealsDamage({{Digits[0]}}, Player(ControllerOfDeadPermanent))])",
    "you may put a creature card you own with lesser mana value from your hand or from the command zone onto the battlefield. If you do, return this card to the battlefield attached to that creature at the beginning of the next end step": "ActionList([ChooseAnAction([[PutACardFromHandOnBattlefield(And([IsCardtype(Creature), ManaValueIs(LessThan(ManaValueOfDeadPermanent))]), [EntersNormally]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([ReturnDeadGuestGraveyardCardToBattlefield([EntersAttachedToPermanent(ThePermanentPutOnTheBattlefieldThisWay)])]))], [PutACommanderFromCommandZoneOntoBattlefield(And([IsCardtype(Creature), ManaValueIs(LessThan(ManaValueOfDeadPermanent))]), [EntersNormally]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([ReturnDeadGuestGraveyardCardToBattlefield([EntersAttachedToPermanent(ThePermanentPutOnTheBattlefieldThisWay)])]))], [DoNothing]])])"
  },
  "{{TriggerActions[WhenACreatureOrPlaneswalkerDiesDuringCombat]}}": {
    "it deals {{Digits}} damage to each creature it blocked this combat": "ActionList([PermanentDealsDamage(Trigger_ThatPermanent, {{Digits[0]}}, EachPermanent(And([IsCardtype(Creature), WasBlockedByDefenderThisCombat(Trigger_ThatPermanent)])))])"
  },
  "{{TriggerActions[WhenACreatureOrPlaneswalkerDies](~Permanent)}}": {
    "draw a card if {{Condition[WhenACreatureOrPlaneswalkerDies]}}. Otherwise, {{~Permanent}} deals {{Digits}} damage to each opponent": "ActionList([IfElse({{Condition[WhenACreatureOrPlaneswalkerDies][0]}}, [DrawACard], [PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, EachPlayer(Opponent))])])",
    "exile it and return this enchantment to its owner's hand": "ActionList([ExileGraveyardCard(Trigger_ThatGraveyardCard), PutPermanentIntoItsOwnersHand({{~Permanent}})])",
    "put its counters on {{ThisPermanent}}": "ActionList([PutCountersOfDeadPermanentOnPermanent(ThisPermanent)])",
    "put that card onto the battlefield under your control at the beginning of the next end step. Sacrifice the creature when you lose control of this creature": "ActionList([CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([ReturnDeadGraveyardCardToBattlefield([EntersUnderPlayersControl(You)]), CreateFutureTrigger(WhenPlayerLosesControlOfPermanent(You, {{~Permanent}}), ActionList([SacrificePermanent(ThePermanentPutOnTheBattlefieldThisWay)]))]))])",
    "put {{a}} {{CounterType}} counter on this creature. It gains {{Hasable}} until end of turn if it exploited that creature": "ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{~Permanent}}), If(PermanentPassesFilter({{~Permanent}}, ExploitedCreature(Trigger_ThatDeadPermanent)), [CreatePermanentLayerEffectUntil({{~Permanent}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])])",
    "put {{a}} {{CounterType}} counter on {{~Permanent}}. If that creature was {{a}} {{Zombie}} or {{Zombie}}, put {{Number}} {{CounterType}} counters on {{~Permanent}} instead": "ActionList([IfElse(DeadPermanentPassesFilter(Or([IsCreatureType({{Zombie[0]}}), IsCreatureType({{Zombie[1]}})])), [PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[0]}}, {{~Permanent}})], [PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{~Permanent}})])])",
    "put {{a}} {{CounterType}} counter on {{~Permanent}}. If that creature was {{a}} {{Zombie}}, you may draw a card. If you do, you lose {{Digits}} life": "ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{~Permanent}}), If(DeadPermanentPassesFilter(IsCreatureType({{Zombie[0]}})), [MayCost(DrawACard), If(CostWasPaid, [LoseLife({{Digits[0]}})])])])",
    "return that card to the battlefield under your control. Attach this Equipment to that creature": "ActionList([ReturnDeadGraveyardCardToBattlefield([EntersUnderPlayersControl(You)]), AttachPermanentToPermanent({{~Permanent}}, ThePermanentPutOnTheBattlefieldThisWay)])",
    "this artifact deals {{Digits}} damage to that creature's controller": "ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Player(ControllerOfDeadPermanent))])",
    "you gain {{Digits}} life. If that creature was {{a}} {{Zombie}}, put {{a}} {{CounterType}} counter on this creature": "ActionList([GainLife({{Digits[0]}}), If(DeadPermanentPassesFilter(IsCreatureType({{Zombie[0]}})), [PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{~Permanent}})])])",
    "you may exile that card. If you do, return each other card exiled with this artifact to its owner's graveyard": "ActionList([MayCost(ExileGraveyardCard(Trigger_ThatGraveyardCard)), If(CostWasPaid, [ReturnEachExiledCardToGraveyard(And([Other(TheCardExiledThisWay), WasExiledWithPermanent({{~Permanent}})]))])])",
    "you may pay {{ManaCost}}. If you do, this creature becomes a copy of that creature, except it has this ability": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [CreatePermanentLayerEffect({{~Permanent}}, [IsACopyOfPermanent(Trigger_ThatDeadPermanent, CopyEffects([AddAbilityVariable(ThisAbility)]))])])])",
    "you may put X {{CounterType}} counters on {{~Permanent}}, where X is {{GameNumber[WhenACreatureOrPlaneswalkerDies]}}": "ActionList([MayAction(PutNumberCountersOfTypeOnPermanent({{GameNumber[WhenACreatureOrPlaneswalkerDies][0]}}, {{CounterType[0]}}, {{~Permanent}}))])",
    "{{~Permanent}} deals damage equal to that creature's power to target opponent": "Targeted([TargetPlayer(Opponent)], ActionList([PermanentDealsDamage({{~Permanent}}, PowerOfPermanent(Trigger_ThatPermanent), Player(Ref_TargetPlayer))]))",
    "{{~Permanent}} deals {{Digits}} damage to that creature's controller": "ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Player(ControllerOfDeadPermanent))])"
  },
  "{{TriggerActions[WhenACreatureOrPlaneswalkerDies]}}": {
    "change the base power and toughness of all creatures that dealt damage to it this turn to {{PT}}": "ActionList([CreateEachPermanentLayerEffect(And([IsCardtype(Creature), DealtDamageToPermanentThisTurn(Trigger_ThatPermanent)]), [SetPT({{PT[0]}})])])",
    "choose target opponent. That player puts this card from its owner's graveyard onto the battlefield under their control at the beginning of the next end step": "Targeted([TargetPlayer(Opponent)], ActionList([CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PlayerAction(Ref_TargetPlayer, ReturnDeadGraveyardCardToBattlefield([EntersUnderPlayersControl(Ref_TargetPlayer)]))]))]))",
    "conjure X duplicates of it into exile, where X is the number of {{CounterType}} counters on it. Those duplicates perpetually get {{PTModX}}. Then shuffle those duplicates into your library": "ActionList([ConjureNumberDuplicatesOfGraveyardCardIntoExile(NumCountersOfTypeOnDeadPermanent({{CounterType[0]}}), Trigger_ThatGraveyardCard), CreatePerpetualEachExiledCardEffect(TheCardsConjuredThisWay, [AdjustPTX({{PTModX[0]}}, NumCountersOfTypeOnDeadPermanent({{CounterType[0]}}))]), ShuffleEachExiledCardIntoLibrary(TheCardsConjuredThisWay)])",
    "create X Junk tokens, where X is the number of {{CounterType}} counters on it": "ActionList([CreateTokens([NumberTokens(NumCountersOfTypeOnDeadPermanent({{CounterType[0]}}), JunkToken)])])",
    "create X tapped {{PT}} {{CreatureTokens}} with {{Hasable}}, where X is {{GameNumber[WhenACreatureOrPlaneswalkerDies]}}": "ActionList([CreateTokensWithFlags([NumberTokens({{GameNumber[WhenACreatureOrPlaneswalkerDies][0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}]))], [EntersTapped])])",
    "create X {{PT}} {{CreatureTokens}} with \"{{TokenQuotedAbility}}\", where X is {{GameNumber[WhenACreatureOrPlaneswalkerDies]}}": "ActionList([CreateTokens([NumberTokens({{GameNumber[WhenACreatureOrPlaneswalkerDies][0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{TokenQuotedAbility[0]}}]))])])",
    "create X {{PT}} {{CreatureTokens}} with {{Hasable}}, where X is {{GameNumber[WhenACreatureOrPlaneswalkerDies]}}": "ActionList([CreateTokens([NumberTokens({{GameNumber[WhenACreatureOrPlaneswalkerDies][0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}]))])])",
    "create X {{PT}} {{CreatureTokens}}, where X is {{GameNumber[WhenACreatureOrPlaneswalkerDies]}}": "ActionList([CreateTokens([NumberTokens({{GameNumber[WhenACreatureOrPlaneswalkerDies][0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])])",
    "create a number of tapped Treasure tokens equal to its power": "ActionList([CreateTokensWithFlags([NumberTokens(PowerOfPermanent(Trigger_ThatPermanent), TreasureToken)], [EntersTapped])])",
    "create a number of {{PT}} {{CreatureTokens}} equal to the number of {{CounterType}} counters on {{ThisPermanent}}": "ActionList([CreateTokens([NumberTokens(NumCountersOfTypeOnDeadPermanent({{CounterType[0]}}), TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])])",
    "create a tapped {{PT}} {{CreatureToken}} and exile that card": "ActionList([CreateTokensWithFlags([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])], [EntersTapped]), ExileGraveyardCard(Trigger_ThatGraveyardCard)])",
    "create a token that's a copy of it, except it's an artifact in addition to its other types": "ActionList([CreateTokens([TokenCopyOfPermanent(Trigger_ThatPermanent, TokenCopyEffects([AddCardtypes([Artifact])]))])])",
    "create a token that's a copy of that creature, except it's a Food artifact with \"{{TokenQuotedAbility}}\", and it loses all other card types": "ActionList([CreateTokens([TokenCopyOfPermanent(Trigger_ThatPermanent, TokenCopyEffects([SetArtifactTypes([Food]), SetCardtypes([Artifact]), AddAbility([{{TokenQuotedAbility[0]}}])]))])])",
    "create a token that's a copy of that creature, except it's not legendary and it's {{a}} {{PT}} {{Black}} {{Zombie}} in addition to its other colors and types": "ActionList([CreateTokens([TokenCopyOfPermanent(Trigger_ThatPermanent, TokenCopyEffects([RemoveSupertypes([Legendary]), SetPT({{PT[0]}}), AddColor(SimpleColorList([{{Black[0]}}])), AddCreatureTypes([{{Zombie[0]}}])]))])])",
    "create {{Number}} tokens that are copies of it": "ActionList([CreateTokens([NumberTokens({{Number[0]}}, TokenCopyOfPermanent(Trigger_ThatPermanent, NoTokenCopyEffects))])])",
    "create {{a}} {{PTX}} {{CreatureToken}} with {{Hasable}}, where X is the number of counters on this creature": "ActionList([CreateTokens([TokenWithPT(PTX({{PTX[0]}}, NumCountersOnDeadPermanent), {{CreatureToken[0]}}, [{{Hasable[0]}}])])])",
    "create {{a}} {{PT}} {{CreatureToken}} for each {{Eachable[WhenACreatureOrPlaneswalkerDies]}}": "ActionList([CreateTokens([NumberTokens({{Eachable[WhenACreatureOrPlaneswalkerDies][0]}}, TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, []))])])",
    "create {{a}} {{PT}} {{CreatureToken}} with \"{{TokenQuotedAbility}}\". If the creature had power {{Digits}} or greater, create {{Number}} of those tokens instead": "ActionList([IfElse(PermanentPassesFilter(Trigger_ThatPermanent, PowerIs(GreaterThanOrEqualTo({{Digits[0]}}))), [CreateTokens([NumberTokens({{Number[0]}}, TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{TokenQuotedAbility[0]}}]))])], [CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{TokenQuotedAbility[0]}}])])])])",
