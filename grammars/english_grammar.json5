    "each player creates {{a}} {{PT}} {{CreatureToken}} with {{Hasable}} named {{NamedCard}} for each {{Eachable(ThatPlayer)}}": "ActionList([EachPlayerAction(AnyPlayer, CreateTokens([NumberTokens({{Eachable(ThatPlayer=EachPlayerAction_ThatPlayer)[0]}}, NamedTokenWithPT({{NamedCard[0]}}, {{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}]))]))])",
    "each player discards a card": "ActionList([EachPlayerAction(AnyPlayer, DiscardACard)])",
    "each player discards a card. Each opponent who discarded a card that shares a card type with the card you discarded loses {{Digits}} life": "ActionList([EachPlayerAction(AnyPlayer, DiscardACard), EachPlayerAction(And([Opponent, DiscardedACardOfTypeThisWay(SharesACardtypeWithCardDiscardedByPlayerThisWay(You))]), LoseLife({{Digits[0]}}))])",
    "each player discards a card. If you discarded a card this way, draw a card": "ActionList([EachPlayerAction(AnyPlayer, DiscardACard), If(PlayerPassesFilter(You, DiscardedACardThisWay), [DrawACard])])",
    "each player discards a card. Then you draw a card for each card type among cards discarded this way": "ActionList([EachPlayerAction(AnyPlayer, DiscardACard), DrawNumberCards(TheNumberOfCardtypesAmongCardsDiscardedThisWay)])",
    "each player discards their hand": "ActionList([EachPlayerAction(AnyPlayer, DiscardHand)])",
    "each player discards their hand, then draws {{Number}} cards": "ActionList([EachPlayerAction(AnyPlayer, DiscardHand), EachPlayerAction(AnyPlayer, DrawNumberCards({{Number[0]}}))])",
    "each player discards {{a}} {{SpecificCard}}": "ActionList([EachPlayerAction(AnyPlayer, DiscardACardOfType({{SpecificCard[0]}}))])",
    "each player draws a card": "ActionList([EachPlayerAction(AnyPlayer, DrawACard)])",
    "each player draws a card and loses {{Digits}} life": "ActionList([EachPlayerAction(AnyPlayer, DrawACard), EachPlayerAction(AnyPlayer, LoseLife({{Digits[0]}}))])",
    "each player draws a card. If {{Condition}}, instead only you draw a card": "ActionList([IfElse({{Condition[0]}}, [DrawACard], [EachPlayerAction(AnyPlayer, DrawACard)])])",
    "each player draws {{Number}} cards": "ActionList([EachPlayerAction(AnyPlayer, DrawNumberCards({{Number[0]}}))])",
    "each player draws {{Number}} cards, then discards a card at random": "ActionList([EachPlayerAction(AnyPlayer, DrawNumberCards({{Number[0]}})), EachPlayerAction(AnyPlayer, DiscardACardAtRandom)])",
    "each player exiles a card from their graveyard. When one or more nonland cards are exiled this way, put that many {{CounterType}} counters on target {{Permanent}}": "ActionList([EachPlayerAction(AnyPlayer, Exile([AGraveyardCard(InAPlayersGraveyard(SinglePlayer(EachablePlayer)))])), If(ACardWasExiledThisWay(IsNonCardtype(Land)), [ReflexiveTrigger(Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutNumberCountersOfTypeOnPermanent(NumberOfCardsOfTypeExiledThisWay(IsNonCardtype(Land)), {{CounterType[0]}}, Ref_TargetPermanent)])))])])",
    "each player exiles all but the bottom {{Number}} cards of their library face down": "ActionList([EachPlayerAction(AnyPlayer, ExileTheTopNumberCardsOfLibraryFaceDown(Minus(NumCardsInPlayersLibrary(ActionPlayer), {{Number[0]}})))])",
    "each player exiles all {{Permanents}} they control and creates X {{PT}} {{CreatureTokens}}, where X is the total power of the creatures they exiled this way. Then planeswalk": "ActionList([EachPlayerActions(AnyPlayer, [ExileEachPermanent(And([{{Permanents[0]}}, ControlledByAPlayer(SinglePlayer(EachablePlayer))])), CreateTokens([NumberTokens(NumPermanentsExiledThisWay, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])]), Planeswalk])",
    "each player exiles cards from the top of their library until they exile a nonland card. An opponent chooses a nonland card exiled this way. You may cast up to two spells from among the other cards exiled this way without paying their mana costs": "ActionList([EachPlayerAction(AnyPlayer, ExileCardsFromTheTopOfLibraryUntilACardOfTypeIsExiled(IsNonCardtype(Land))), APlayerAction(Opponent, ChooseAnExiledCard(And([IsNonCardtype(Land), WasExiledThisWay]))), MayAction(CastUptoNumberSpellsFromExileWithoutPaying(Integer(2), AnySpell, And([Other(TheChosenExiledCard), WasExiledThisWay])))])",
    "each player exiles cards from the top of their library until they exile a nonland card. You may cast any number of spells from among the nonland cards exiled this way without paying their mana costs": "ActionList([EachPlayerAction(AnyPlayer, ExileCardsFromTheTopOfLibraryUntilACardOfTypeIsExiled(IsNonCardtype(Land))), MayAction(CastAnyNumberOfExiledCardsWithoutPaying(TheSpecificCardsExiledThisWay))])",
    "each player exiles the top card of their library": "ActionList([EachPlayerAction(AnyPlayer, ExileTopCardOfLibrary)])",
    "each player exiles the top card of their library. The player who exiled the card with the greatest mana value takes an extra turn after this one. If two or more players' cards are tied for greatest, the tied players repeat this process until the tie is broken": "ActionList([PlayersExileTopCardOfLibraryAndFindHighestManaValueUntilSingleWinner(AnyPlayer), PlayerAction(ThePlayerWhoExiledTheCardWithTheHighestManaValue, TakeAnExtraTurn)])",
    "each player exiles the top card of their library. Until end of turn, you may play the card you own exiled this way and each other card exiled this way with lesser mana value than it without paying their mana costs": "ActionList([EachPlayerAction(AnyPlayer, ExileTopCardOfLibrary), CreatePlayerEffectUntil(You, [MayPlayExiledCardsWithoutPaying(TheCardsExiledByPlayerThisWay(You)), MayPlayExiledCardsWithoutPaying(And([TheCardsExiledThisWay, ManaValueIs(LessThanOrEqualTo(TotalManaValueOfExiledCards(TheCardsExiledByPlayerThisWay(You))))]))], UntilEndOfTurn)])",
    "each player exiles the top card of their library. Until your next end step, each player may play the card they exiled this way": "ActionList([EachPlayerAction(AnyPlayer, ExileTopCardOfLibrary), CreateEachPlayerEffectUntil(AnyPlayer, [MayPlayExiledCards(WasExiledByPlayerThisWay(EachablePlayer))], UntilPlayersNextEndStep(You))])",
    "each player exiles the top {{Number}} cards of their library": "ActionList([EachPlayerAction(AnyPlayer, ExileTheTopNumberCardsOfLibrary({{Number[0]}}))])",
    "each player flips a coin. Each player whose coin comes up tails sacrifices {{a}} {{Permanent}} of their choice": "ActionList([EachPlayerAction(AnyPlayer, FlipACoin), EachPlayerAction(CoinCameUpTails, SacrificeAPermanent({{Permanent[0]}}))])",
    "each player gains control of all {{Permanents}} they own": "ActionList([EachPlayerAction(AnyPlayer, GainControlOfEachPermanent(And([{{Permanents[0]}}, OwnedByAPlayer(SinglePlayer(EachPlayerAction_ThatPlayer))])))])",
    "each player gains control of each {{Permanent}} they own that you control": "ActionList([EachPlayerAction(AnyPlayer, GainControlOfEachPermanent(And([{{Permanent[0]}}, OwnedByAPlayer(SinglePlayer(EachPlayerAction_ThatPlayer)), ControlledByAPlayer(SinglePlayer(You))])))])",
    "each player gains control of {{a}} {{Permanent}} of your choice controlled by the player to their right": "ActionList([ActionForEachPlayer(AnyPlayer, [ChooseAPermanent(And([{{Permanent[0]}}, ControlledByPlayer(PlayerToTheRightOf(EachablePlayer))])), PlayerAction(EachablePlayer, GainControlOfPermanent(TheChosenPermanent))])])",
    "each player gains {{Digits}} life": "ActionList([EachPlayerAction(AnyPlayer, GainLife({{Digits[0]}}))])",
    "each player gains {{Digits}} life and draws a card": "ActionList([EachPlayerAction(AnyPlayer, GainLife({{Digits[0]}})), EachPlayerAction(AnyPlayer, DrawACard)])",
    "each player gets a poison counter": "ActionList([EachPlayerAction(AnyPlayer, GetAPoisonCounter)])",
    "each player gets a rad counter": "ActionList([EachPlayerAction(AnyPlayer, GetARadCounter)])",
    "each player gets {{Number}} rad counters": "ActionList([EachPlayerAction(AnyPlayer, GetNumberRadCounters({{Number[0]}}))])",
    "each player loses a third of their life, rounded up": "ActionList([EachPlayerAction(AnyPlayer, LoseLife(ThirdRoundedUp(LifeTotalOfPlayer(LoseLife_ThatPlayer))))])",
    "each player loses half their life, rounded up": "ActionList([EachPlayerAction(AnyPlayer, LoseLife(HalfRoundedUp(LifeTotalOfPlayer(LoseLife_ThatPlayer))))])",
    "each player loses {{Digits}} life": "ActionList([EachPlayerAction(AnyPlayer, LoseLife({{Digits[0]}}))])",
    "each player loses {{Digits}} life unless they sacrifice {{a}} {{Permanent}} of their choice": "ActionList([EachPlayerMayCost(AnyPlayer, SacrificeAPermanent({{Permanent[0]}})), EachPlayerAction(DidntPayCost, LoseLife({{Digits[0]}}))])",
    "each player may discard a card. Each player who discarded a card this way draws a card. If a creature card was discarded this way, you create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}}. Then if a noncreature card was discarded this way, put {{a}} {{CounterType}} counter on each {{Permanent}}": "ActionList([EachPlayerMayCost(AnyPlayer, DiscardACard), EachPlayerAction(PaidCost, DrawACard), If(ACardWasDiscardedThisWay(IsCardtype(Creature)), [CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])])]), If(ACardWasDiscardedThisWay(IsNonCardtype(Creature)), [PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, {{Permanent[0]}})])])",
    "each player may discard a card. Each player who discarded a card this way may search their library for {{a}} {{SpecificCard}}, reveal it, put it into their hand, then shuffle": "ActionList([EachPlayerMayCost(AnyPlayer, DiscardACard), EachPlayerAction(PaidCost, SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle]))])",
    "each player may discard their hand and draw {{Number}} cards": "ActionList([EachPlayerMayActions(AnyPlayer, [DiscardHand, DrawNumberCards({{Number[0]}})])])",
    "each player may draw a card. Each opponent who does can't attack you or permanents you control during their next turn": "ActionList([EachPlayerMayCost(AnyPlayer, DrawACard), CreateEachPlayerEffectUntil(And([Opponent, DidntPayCost]), [CantAttackPlayer(You), CantAttackAPermanent(ControlledByAPlayer(SinglePlayer(You)))], DuringPlayersNextTurn(EachablePlayer))])",
    "each player may pay any amount of mana. Then each player creates a number of {{PT}} {{CreatureTokens}} equal to the amount of mana they paid this way": "ActionList([EachPlayerAction(AnyPlayer, PayAnyAmountOfMana), EachPlayerAction(AnyPlayer, CreateTokens([NumberTokens(AmountOfManaPaidThisWay, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))]))])",
    "each player may put {{Number}} {{CounterType}} counters on {{a}} {{Creature}} they control. Goad each creature that had counters put on it this way": "ActionList([EachPlayerAction(AnyPlayer, PutNumberCountersOfTypeOnAPermanent({{Number[0]}}, {{CounterType[0]}}, And([{{Creature[0]}}, ControlledByPlayer(EachPlayerAction_ThatPlayer)]))), GoadEachCreature(And([IsCardtype(Creature), HadCountersPutOnItThisWay]))])",
    "each player may put {{Number}} {{CounterType}} counters on {{a}} {{Permanent}} they control. For each opponent who does, you gain protection from that player until your next turn": "ActionList([EachPlayerMayAction(AnyPlayer, PutNumberCountersOfTypeOnAPermanent({{Number[0]}}, {{CounterType[0]}}, And([{{Permanent[0]}}, ControlledByPlayer(EachPlayerAction_ThatPlayer)]))), CreatePlayerEffectUntil(You, [Protection(FromPlayers(And([Opponent, PlayerWhoTookActionThisWay])))], UntilEndOfNextTurn(You))])",
    "each player may put {{Number}} {{CounterType}} counters on {{a}} {{Permanent}} they control. If a player does, creatures that player controls can't attack you or planeswalkers you control until your next turn": "ActionList([EachPlayerMayCost(AnyPlayer, PutNumberCountersOfTypeOnAPermanent({{Number[0]}}, {{CounterType[0]}}, {{Permanent[0]}})), CreateEachPermanentRuleEffectUntil(And([IsCardtype(Creature), ControlledByAPlayer(PaidCost)]), [CantAttackPlayerOrPlaneswalkerControlledBy(You)], UntilPlayersNextTurn(You))])",
    "each player may return {{a}} {{SpecificCard}} from their graveyard to their hand": "ActionList([EachPlayerMayAction(AnyPlayer, ReturnAGraveyardCardToHand({{SpecificCard[0]}}))])",
    "each player may scry {{Digits}}": "ActionList([EachPlayerMayAction(AnyPlayer, Scry({{Digits[0]}}))])",
    "each player may search their library for a card and put that card into their hand. Then each player who searched their library this way shuffles": "ActionList([EachPlayerMayAction(AnyPlayer, SearchLibrary([FindAGenericCard, PutFoundCardsIntoHand, Shuffle]))])",
    "each player may search their library for up to {{Number}} {{SpecificCards}}, put them onto the battlefield, then shuffle": "ActionList([EachPlayerMayAction(AnyPlayer, SearchLibrary([FindNumberCardsOfType({{Number[0]}}, {{SpecificCards[0]}}), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle]))])",
    "each player may search their library for {{a}} {{SpecificCard}}, reveal it, put it into their hand, then shuffle": "ActionList([EachPlayerMayAction(AnyPlayer, SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle]))])",
    "each player mills a card": "ActionList([EachPlayerAction(AnyPlayer, MillACard)])",
    "each player mills a card. If a land card was milled this way, create a Treasure token. Until end of turn, you may cast a spell from among those cards": "ActionList([EachPlayerAction(AnyPlayer, MillACard), If(ACardWasMilledThisWay(IsCardtype(Land)), [CreateTokens([TreasureToken])]), CreatePlayerEffectUntil(You, [MayCastASpellFromAmongCardsMilledThisWay(AnySpell)], UntilEndOfTurn)])",
    "each player mills {{Number}} cards": "ActionList([EachPlayerAction(AnyPlayer, MillNumberCards({{Number[0]}}))])",
    "each player mills {{Number}} cards, then each opponent discards a card and you draw a card": "ActionList([EachPlayerAction(AnyPlayer, MillNumberCards({{Number[0]}})), EachPlayerAction(Opponent, DiscardACard), DrawACard])",
    "each player mills {{Number}} cards. Put {{a}} {{SpecificCard}} from among the milled cards onto the battlefield under your control": "ActionList([EachPlayerAction(AnyPlayer, MillNumberCards({{Number[0]}})), ReturnACardMilledThisWayToBattlefield(AnyCard, [EntersUnderPlayersControl(You)])])",
    "each player mills {{Number}} cards. Then you may put {{a}} {{SpecificCard}} from your graveyard on top of your library": "ActionList([EachPlayerAction(AnyPlayer, MillNumberCards({{Number[0]}})), MayAction(PutACardFromPlayersGraveyardOnTopOfLibrary({{SpecificCard[0]}}, You))])",
    "each player mills {{Number}} cards. Then you put {{a}} {{SpecificCard}} from among the milled cards onto the battlefield under your control": "ActionList([EachPlayerAction(AnyPlayer, MillNumberCards({{Number[0]}})), PutACardOfTypeMilledThisWayOntoTheBattlefield({{SpecificCard[0]}}, [EntersUnderPlayersControl(You)])])",
    "each player on your team may discard a card, then each player who discarded a card this way draws a card": "ActionList([EachPlayerMayAction(YourTeam, DiscardACard), EachPlayerAction(DiscardedACardThisWay, DrawACard)])",
    "each player puts a card from their hand on top of their library": "ActionList([EachPlayerAction(AnyPlayer, PutACardFromHandOnTopOfLibrary)])",
    "each player puts {{a}} {{SpecificCard}} from their graveyard onto the battlefield": "ActionList([EachPlayerAction(AnyPlayer, ReturnACardFromGraveyardToBattlefield({{SpecificCard[0]}}, [EntersNormally]))])",
    "each player returns all {{SpecificCards}} from their graveyard to the battlefield": "ActionList([EachPlayerAction(AnyPlayer, ReturnEachCardFromPlayersGraveyardToBattlefield({{SpecificCards[0]}}, ActionPlayer, [EntersNormally]))])",
    "each player returns all {{SpecificCards}} from their graveyard to the battlefield tapped": "ActionList([EachPlayerAction(AnyPlayer, ReturnEachCardFromPlayersGraveyardToBattlefield({{SpecificCards[0]}}, ActionPlayer, [EntersTapped]))])",
    "each player reveals the top card of their library, loses life equal to that card's mana value, then puts it into their hand": "ActionList([EachPlayerActions(AnyPlayer, [RevealTopCardOfLibrary, LoseLife(ManaValueOfTheCardRevealedThisWay), PutTopOfLibraryInHand])])",
    "each player reveals the top card of their library. For each {{SpecificCard}} revealed this way, you create a Map token. Then each player draws a card": "ActionList([EachPlayerAction(AnyPlayer, RevealTopCardOfLibrary), CreateTokens([NumberTokens(NumLibraryCardsRevealedThisWay({{SpecificCard[0]}}), MapToken)]), EachPlayerAction(AnyPlayer, DrawACard)])",
    "each player reveals the top card of their library. For each {{SpecificCard}} revealed this way, you create a tapped Treasure token. Then each player draws a card": "ActionList([EachPlayerAction(AnyPlayer, RevealTopCardOfLibrary), CreateTokensWithFlags([NumberTokens(NumLibraryCardsRevealedThisWay({{SpecificCard[0]}}), TreasureToken)], [EntersTapped]), EachPlayerAction(AnyPlayer, DrawACard)])",
    "each player reveals the top card of their library. For each {{SpecificCard}} revealed this way, you create {{a}} {{PT}} {{CreatureToken}}. Then {{Creatures}} get {{PTMod}} until end of turn for each {{SpecificCard}} revealed this way. Then each player draws a card": "ActionList([EachPlayerAction(AnyPlayer, RevealTopCardOfLibrary), CreateTokens([NumberTokens(NumLibraryCardsRevealedThisWay({{SpecificCard[0]}}), TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, []))]), CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), EachPlayerAction(AnyPlayer, DrawACard)])",
    "each player reveals the top card of their library. For each {{SpecificCard}} revealed this way, you investigate. Then each player draws a card": "ActionList([EachPlayerAction(AnyPlayer, RevealTopCardOfLibrary), InvestigateTimes(NumLibraryCardsRevealedThisWay({{SpecificCard[0]}})), EachPlayerAction(AnyPlayer, DrawACard)])",
    "each player reveals the top card of their library. For each {{SpecificCard}} revealed this way, {{Permanents}} get {{PTMod}} until end of turn. Then each player draws a card": "ActionList([EachPlayerAction(AnyPlayer, RevealTopCardOfLibrary), CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AdjustPTForEach({{PTMod[0]}}, NumLibraryCardsRevealedThisWay({{SpecificCard[0]}}))], UntilEndOfTurn), EachPlayerAction(AnyPlayer, DrawACard)])",
    "each player reveals the top card of their library. If all cards revealed this way are {{SpecificCards}}, put those cards onto the battlefield under their owners' control": "ActionList([EachPlayerAction(AnyPlayer, RevealTopCardOfLibrary), If(AllCardsRevealedThisWayAreCardsOfType({{SpecificCards[0]}}), [EachPlayerAction(AnyPlayer, PutTopOfLibraryOnBattlefield([EntersUnderOwnersControl]))])])",
    "each player sacrifices all {{Permanents}} they control except for {{Number}}": "ActionList([EachPlayerAction(AnyPlayer, SacrificeAllPermanentsExceptForNum({{Permanents[0]}}, {{Number[0]}}))])",
    "each player sacrifices half the non-{{Zombie}} creatures they control of their choice, rounded down": "ActionList([EachPlayerAction(Opponent, SacrificeNumberPermanents(HalfRoundedDown(TheNumberOfPermanentsOnTheBattlefield(And([IsNonCreatureType({{Zombie[0]}}), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(ActionPlayer))]))), And([IsNonCreatureType({{Zombie[0]}}), IsCardtype(Creature)])))])",
    "each player sacrifices {{Number}} {{Permanents}} of their choice": "ActionList([EachPlayerAction(AnyPlayer, SacrificeNumberPermanents({{Number[0]}}, {{Permanents[0]}}))])",
    "each player sacrifices {{a}} {{Permanent}} of their choice": "ActionList([EachPlayerAction(AnyPlayer, SacrificeAPermanent({{Permanent[0]}}))])",
    "each player sacrifices {{a}} {{Permanent}} of their choice unless they discard a card": "ActionList([EachPlayerMayCost(AnyPlayer, DiscardACard), EachPlayerAction(DidntPayCost, SacrificeAPermanent({{Permanent[0]}}))])",
    "each player sacrifices {{a}} {{Permanent}} of their choice, then you flip a coin. If you lose the flip, repeat this process": "ActionList([RepeatableActions([EachPlayerAction(AnyPlayer, SacrificeAPermanent({{Permanent[0]}})), FlipACoin_OnLose([RepeatThisProcess])])])",
    "each player sacrifices {{a}} {{Permanent}} of their choice. Each player who can't discards a card": "ActionList([EachPlayerMustCost(AnyPlayer, SacrificeAPermanent({{Permanent[0]}})), EachPlayerAction(DidntPayCost, DiscardACard)])",
    "each player searches their library for up to {{Number}} {{SpecificCards}}, puts them onto the battlefield, then shuffles": "ActionList([EachPlayerAction(AnyPlayer, SearchLibrary([FindNumberCardsOfType({{Number[0]}}, {{SpecificCards[0]}}), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle]))])",
    "each player seeks {{a}} {{SpecificCard}}": "ActionList([EachPlayerAction(AnyPlayer, SeekACard({{SpecificCard[0]}}))])",
    "each player shuffles all {{Permanents}} they own into their library, then reveals that many cards from the top of their library. Each player puts all artifact, creature, land, and planeswalker cards revealed this way onto the battlefield, then does the same for enchantment cards, then puts all cards revealed this way that weren't put onto the battlefield on the bottom of their library in any order": "ActionList([EachPlayerActions(AnyPlayer, [ShuffleEachPermanentIntoLibrary({{Permanents[0]}}), RevealTheTopNumberCardsOfLibrary(NumPermanentsShuffledIntoLibraryThisWay, [PutEachCardOfTypeOntoTheBattlefield(Or([IsCardtype(Artifact), IsCardtype(Creature), IsCardtype(Land), IsCardtype(Planeswalker)]), [EntersNormally]), PutEachCardOfTypeOntoTheBattlefield(IsCardtype(Enchantment), [EntersNormally]), PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder])])])",
    "each player shuffles their hand and graveyard into their library. You draw {{Number}} cards, then each other player draws {{Number}} cards": "ActionList([EachPlayerAction(AnyPlayer, ShuffleHandAndGraveyardIntoLibrary), DrawNumberCards({{Number[0]}}), EachPlayerAction(Other(You), DrawNumberCards({{Number[1]}}))])",
    "each player who controls fewer lands than the player who controls the most lands searches their library for a number of {{SpecificCards}} less than or equal to the difference, puts those cards onto the battlefield tapped, then shuffles": "ActionList([CreateValueX(MaxPermanentsControlledByAPlayer(IsCardtype(Land), AnyPlayer)), ActionForEachPlayer(ControlsNum(LessThan(ValueX), IsCardtype(Land)), [PlayerAction(EachablePlayer, SearchLibrary([FindNumberCardsOfType(Minus(TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(EachablePlayer))])), ValueX), {{SpecificCards[0]}}), PutFoundCardsOntoBattlefield([EntersTapped]), Shuffle]))])])",
    "each player who controls fewer lands than the player who controls the most lands searches their library for a number of {{SpecificCards}} less than or equal to the difference, reveals them, puts them into their hand, then shuffles": "ActionList([CreateValueX(MaxPermanentsControlledByAPlayer(IsCardtype(Land), AnyPlayer)), ActionForEachPlayer(ControlsNum(LessThan(ValueX), IsCardtype(Land)), [PlayerAction(EachablePlayer, SearchLibrary([FindNumberCardsOfType(Minus(TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(EachablePlayer))])), ValueX), {{SpecificCards[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle]))])])",
    "each player who controls the fewest creatures creates {{a}} {{PT}} {{CreatureToken}}": "ActionList([EachPlayerAction(AControllerOfTheLeastPermanentsAmongPlayers(AnyPlayer, IsCardtype(Creature)), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])]))])",
    "each player who controls the most lands sacrifices {{Number}} {{Permanents}} of their choice": "ActionList([EachPlayerAction(AControllerOfTheMostPermanentsAmongPlayers(AnyPlayer, IsCardtype(Land)), SacrificeNumberPermanents({{Number[0]}}, {{Permanents[0]}}))])",
    "each player's life total becomes the highest life total among all players": "ActionList([EachPlayerAction(AnyPlayer, SetLifeTotal(HighestLifeTotalAmongPlayers(AnyPlayer)))])",
    "each token that would be created under an opponent's control this turn is created under your control instead": "ActionList([CreateReplaceTokensWouldBeCreatedUnderAPlayersControlUntil(TokensWouldBeCreatedUnderAPlayersControl(Opponent), [CreateTokensUnderPlayersControlInstead([ThoseTokens], You)], UntilEndOfTurn)])",
    "each {{Creature}} explores": "ActionList([ExploreWithEachPermanent({{Creature[0]}})])",
    "each {{Creature}} gains \"{{QuotedAbility[ThisCreature]}}\" until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creature[0]}}, [AddAbility([{{QuotedAbility[ThisCreature][0]}}])], UntilEndOfTurn)])",
    "each {{Creature}} gets {{PTMod}} and gains {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creature[0]}}, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "each {{Creature}} gets {{PTMod}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creature[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])",
    "each {{Creature}} gets {{PTMod}}, gains {{Hasable}}, and becomes {{a}} {{Zombie}} in addition to its other types until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creature[0]}}, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}]), AddCreatureType({{Zombie[0]}})], UntilEndOfTurn)])",
    "each {{Permanent}} becomes {{a}} {{PT}} artifact creature until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanent[0]}}, [SetPT({{PT[0]}}), AddCardtype(Artifact), AddCardtype(Creature)], UntilEndOfTurn)])",
    "each {{Permanent}} gains all activated abilities of target {{Permanent}} until end of turn. You may spend {{Black}} mana as though it were mana of any color to activate those abilities": "Targeted([TargetPermanent({{Permanent[1]}})], ActionList([CreateEachPermanentLayerEffectUntil({{Permanent[0]}}, [AddActivatedAbilitiesAndMaySpendColorManaAsThoughAnyColorToActivate(AbilityOfPermanent(Ref_TargetPermanent), {{Black[0]}})], UntilEndOfTurn)]))",
    "each {{Permanent}} gains {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanent[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "each {{SpecificCard}} in your graveyard gains flashback until end of turn. The flashback cost is equal to its mana cost": "ActionList([CreateEachCardInPlayersGraveyardEffectUntil({{SpecificCard[0]}}, You, [AddAbility([Flashback(ItsManaCost)])], UntilEndOfTurn)])",
    "each {{SpecificCard}} in your graveyard gains unearth {{ManaCost}} until end of turn": "ActionList([CreateEachCardInPlayersGraveyardEffectUntil({{SpecificCard[0]}}, You, [AddAbility([Unearth(PayMana({{ManaCost[0]}}))])], UntilEndOfTurn)])",
    "each {{SpecificCard}} in your hand perpetually gains \"{{PerpetualQuotedAbility}}\"": "ActionList([CreatePerpetualCardsInHandEffect({{SpecificCard[0]}}, [AddAbility([{{PerpetualQuotedAbility[0]}}])])])",
    "earthbend X, where X is {{GameNumber}}": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))], ActionList([Earthbend(Ref_TargetPermanent, {{GameNumber[0]}})]))",
    "earthbend {{Digits}}": "Targeted([TargetPermanent(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You))]))], ActionList([Earthbend(Ref_TargetPermanent, {{Digits[0]}})]))",
