    "Each player shuffles their hand and graveyard into their library. You exile the top {{Number}} cards of your library. Then each player draws up to {{Number}} cards": "ActionList([EachPlayerAction(AnyPlayer, ShuffleHandAndGraveyardIntoLibrary), ExileTheTopNumberCardsOfLibrary({{Number[0]}}), EachPlayerAction(AnyPlayer, DrawNumberCards({{Number[0]}}))])",
    "Each player shuffles their hand, graveyard, and all permanents they own into their library, then draws {{Number}} cards. Each player's life total becomes {{Digits}}": "ActionList([EachPlayerActions(AnyPlayer, [ShuffleHandGraveyardAndPermanentsIntoLibrary, DrawNumberCards({{Number[0]}}), SetLifeTotal({{Digits[0]}})])])",
    "Each player who controls the most creatures investigates. Then destroy all {{Permanents}}": "ActionList([EachPlayerAction(ControlsNum(EqualTo(TheGreatestNumberOfPermanentsControlledAmongPlayers(IsCardtype(Creature), AnyPlayer)), IsCardtype(Creature)), Investigate), DestroyEachPermanent({{Permanents[0]}})])",
    "Each player who controls {{Number}} or more {{Permanents}} chooses {{Number}} {{Permanents}} they control and sacrifices the rest. Each player who controls {{Number}} or fewer {{Permanents}} may search their library for up to X {{SpecificCards}} and put them onto the battlefield, where X is {{Number}} minus {{GameNumber(ThatPlayer)}}. Then each player who searched their library this way shuffles": "ActionList([EachPlayerAction(ControlsNum(GreaterThanOrEqualTo({{Number[0]}}), {{Permanents[0]}}), SacrificeAllPermanentsExceptForNum({{Permanents[1]}}, {{Number[1]}})), EachPlayerMayAction(ControlsNum(LessThanOrEqualTo({{Number[2]}}), {{Permanents[2]}}), SearchLibrary([FindNumberCardsOfType(Minus({{Number[0]}}, {{GameNumber(ThatPlayer=ActionPlayer)[0]}}), {{SpecificCards[0]}}), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle]))])",
    "Each player who controls {{a}} {{Permanent}} creates {{a}} {{PT}} {{CreatureToken}}. Then destroy all {{Permanents}}": "ActionList([EachPlayerAction(ControlsA({{Permanent[0]}}), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])), DestroyEachPermanent({{Permanents[0]}})])",
    "Each player who controls {{a}} {{Permanent}} draws a card. Then destroy all {{Permanents}}": "ActionList([EachPlayerAction(ControlsA({{Permanent[0]}}), DrawACard), DestroyEachPermanent({{Permanents[0]}})])",
    "Each player with fewer cards in hand than the player with the most cards in hand draws cards equal to the difference": "ActionList([CreateValueX(TheHighestNumberOfCardsInHandAmongPlayers(AnyPlayer)), EachPlayerAction(NumCardsInHandIs(LessThan(ValueX)), DrawNumberCards(Minus(ValueX, TheNumberOfCardsInPlayersHand(ActionPlayer))))])",
    "Each player's life total becomes {{GameNumber(ThatPlayer)}}": "ActionList([EachPlayerAction(AnyPlayer, SetLifeTotal({{GameNumber(ThatPlayer=EachablePlayer)[0]}}))])",
    "Each player's life total becomes {{GameNumber}}": "ActionList([EachPlayerAction(AnyPlayer, SetLifeTotal({{GameNumber[0]}}))])",
    "Each time target {{Permanent}} would deal damage to a permanent or player this turn, it deals double that damage to that permanent or player instead": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreateReplaceWouldDealDamageUntil(DamageWouldBeDealtByPermanentToARecipient(Ref_TargetPermanent, APlayerOrAPermanent(AnyPlayer, AnyPermanent)), [DealDamageInstead(Twice(WouldDealDamage_ThatMuchDamage))], UntilEndOfTurn)]))",
    "Each {{Creature}} blocks this turn if able": "ActionList([CreateEachPermanentRuleEffectUntil({{Creature[0]}}, [MustBlock], UntilEndOfTurn)])",
    "Each {{Creature}} deals damage to itself equal to its power": "ActionList([EachPermanentDealsDamage({{Creature[0]}}, PowerOfPermanent(EachablePermanent), Permanent(EachablePermanent))])",
    "Each {{Creature}} gets {{PTModX}} until end of turn, where X is {{Digits}} plus {{GameNumber}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Creature[0]}}, [AdjustPTX({{PTModX[0]}}, Plus({{Digits[0]}}, {{GameNumber[0]}}))], UntilEndOfTurn)])",
    "Each {{Creature}} gets {{PTModX}} until end of turn, where X is {{GameNumber}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Creature[0]}}, [AdjustPTX({{PTModX[0]}}, {{GameNumber[0]}})], UntilEndOfTurn)])",
    "Each {{Creature}} gets {{PTMod}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creature[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])",
    "Each {{Creature}} gets {{PTMod}} until end of turn and must be blocked this turn if able": "ActionList([CreateEachPermanentLayerEffectUntil({{Creature[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), CreateEachPermanentRuleEffectUntil({{Creature[0]}}, [MustBeBlocked], UntilEndOfTurn)])",
    "Each {{Permanent}} becomes a copy of target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[1]}})], ActionList([CreateEachPermanentLayerEffect({{Permanent[0]}}, [IsACopyOfPermanent(Ref_TargetPermanent, NoCopyEffects)])]))",
    "Each {{Permanent}} deals {{Digits}} damage to its controller": "ActionList([EachPermanentDealsDamage({{Permanent[0]}}, {{Digits[0]}}, Player(ControllerOfPermanent(EachablePermanent)))])",
    "Each {{Permanent}} gains {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanent[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "Each {{Permanent}} gains {{Hasable}}, {{Hasable}}, and {{Hasable}} until end of turn. {{Reminder}}\nAt the beginning of the next main phase this turn, draw a card for each {{Eachable}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanent[0]}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}]), AddAbility([{{Hasable[2]}}])], UntilEndOfTurn), CreateFutureTrigger(AtTheBeginningOfTheNextMainPhaseThisTurn, ActionList([DrawNumberCards({{Eachable[0]}})]))])",
    "Each {{SpecificCard}} in your graveyard gains flashback until end of turn. The flashback cost is equal to its mana cost": "ActionList([CreateEachCardInPlayersGraveyardEffectUntil({{SpecificCard[0]}}, You, [AddAbility([Flashback(ItsManaCost)])], UntilEndOfTurn)])",
    "Earthbend X, where X is {{GameNumber}}": "Targeted([TargetPermanent(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You))]))], ActionList([Earthbend(Ref_TargetPermanent, {{GameNumber[0]}})]))",
    "Earthbend {{Digits}}": "Targeted([TargetPermanent(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You))]))], ActionList([Earthbend(Ref_TargetPermanent, {{Digits[0]}})]))",
    "Earthbend {{Digits}}, then earthbend {{Digits}}. You gain {{Digits}} life": "Targeted([TargetPermanent(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You))])), TargetPermanent(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You))]))], ActionList([Earthbend(Ref_TargetPermanent1, {{Digits[0]}}), Earthbend(Ref_TargetPermanent1, {{Digits[1]}}), GainLife({{Digits[2]}})]))",
    "Earthbend {{Digits}}. Then each creature you control with power less than or equal to that land's power gains {{Hasable}} and {{Hasable}} until end of turn. You gain hexproof until end of turn": "Targeted([TargetPermanent(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You))]))], ActionList([Earthbend(Ref_TargetPermanent, {{Digits[0]}}), CreateEachPermanentLayerEffectUntil(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), PowerIs(LessThanOrEqualTo(PowerOfPermanent(Ref_TargetPermanent)))]), [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn), CreatePlayerEffectUntil(You, [Hexproof], UntilEndOfTurn)]))",
    "Earthbend {{Digits}}. When you do, up to one target {{Permanent}} fights target {{Permanent}}": "Targeted([TargetPermanent(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You))]))], ActionList([ReflexiveAction(Earthbend(Ref_TargetPermanent, {{Digits[0]}})), ReflexiveTrigger(Targeted([TargetPermanent({{Permanent[0]}}), TargetPermanent({{Permanent[0]}})], ActionList([HaveCreaturesFight(Ref_TargetPermanent1, Ref_TargetPermanent2)])))]))",
    "End the turn": "ActionList([EndTheTurn])",
    "End the turn. {{Reminder}}\nAt the beginning of your next end step, you lose the game": "ActionList([EndTheTurn, CreateFutureTrigger(AtTheBeginningOfPlayersNextEndStep(You), ActionList([LoseTheGame]))])",
    "Exchange control of target artifact or creature and another target permanent that shares one of those types with it": "Targeted([TargetPermanent(Or([IsCardtype(Artifact), IsCardtype(Creature)])), TargetPermanent(And([Other(Ref_TargetPermanent1), Or([SharesCardtypeWithPermanent(Artifact, Ref_TargetPermanent1), SharesCardtypeWithPermanent(Creature, Ref_TargetPermanent1)])]))], ActionList([ExchangeControl(Ref_TargetPermanent1, Ref_TargetPermanent2)]))",
    "Exchange control of target {{Permanent}} and target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}}), TargetPermanent({{Permanent[1]}})], ActionList([ExchangeControl(Ref_TargetPermanent1, Ref_TargetPermanent2)]))",
    "Exchange control of target {{Spell}} and target {{Permanent}}. Then the spell's controller may choose new targets for it": "Targeted([TargetSpell({{Spell[0]}}), TargetPermanent({{Permanent[0]}})], ActionList([ExchangeControlOfSpellAndPermanent(Ref_TargetSpell, Ref_TargetPermanent), PlayerMayAction(ControllerOfSpell(Ref_TargetSpell), ChooseNewTargetsForSpell(Ref_TargetSpell))]))",
    "Exchange control of two target {{Creatures}} controlled by different players. If you control neither creature, draw {{Number}} cards": "Targeted([NumberTargetGroupPermanents(Integer(2), IsCardtype(Creature), ControlledByDifferentPlayers)], ActionList([ExchangeControl(Ref_TargetPermanents_0, Ref_TargetPermanents_1), If(PlayerPassesFilter(You, And([DoesntControlPermanent(Ref_TargetPermanents_0), DoesntControlPermanent(Ref_TargetPermanents_1)])), [DrawNumberCards({{Number[0]}})])]))",
    "Exchange control of two target {{Permanents}}": "Targeted([TargetPermanent({{Permanents[0]}}), TargetPermanent(And([Other(Ref_TargetPermanent1), {{Permanents[0]}}]))], ActionList([ExchangeControl(Ref_TargetPermanent1, Ref_TargetPermanent2)]))",
    "Exchange control of two target {{Permanents}} that share a card type": "Targeted([TargetPermanent({{Permanents[0]}}), TargetPermanent(And([Other(Ref_TargetPermanent1), SharesACardtypeWithPermanent(Ref_TargetPermanent1)]))], ActionList([ExchangeControl(Ref_TargetPermanent1, Ref_TargetPermanent2)]))",
    "Exchange control of two target {{Permanents}} that share a permanent type": "Targeted([TargetPermanent({{Permanents[0]}}), TargetPermanent(And([Other(Ref_TargetPermanent1), SharesAPermanentCardtypeWithPermanent(Ref_TargetPermanent1)]))], ActionList([ExchangeControl(Ref_TargetPermanent1, Ref_TargetPermanent2)]))",
    "Exchange your graveyard and library. Then shuffle your library": "ActionList([ExchangeGraveyardAndLibrary])",
    "Exile all attacking creatures target player controls. That player may search their library for that many {{SpecificCards}}, put those cards onto the battlefield tapped, then shuffle": "Targeted([TargetPlayer(AnyPlayer)], ActionList([ExileEachPermanent(And([IsAttacking, IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))])), PlayerMayAction(Ref_TargetPlayer, SearchLibrary([FindNumberCardsOfType(NumPermanentsExiledThisWay, {{SpecificCards[0]}}), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle]))]))",
    "Exile all cards from target player's graveyard other than {{SpecificCards}}. For each card exiled this way, search that player's library for all cards with the same name as that card and exile them. Then that player shuffles": "Targeted([TargetPlayer(AnyPlayer)], ActionList([ExileEachCardFromPlayersGraveyard(Not({{SpecificCards[0]}}), Ref_TargetPlayer), SearchPlayersLibrary(Ref_TargetPlayer, [FindAnyNumberOfCardsOfType(SharesANameWithAnExiled(TheCardsExiledThisWay)), ExileFoundCards, Shuffle])]))",
    "Exile all cards from target player's hand and graveyard": "Targeted([TargetPlayer(AnyPlayer)], ActionList([ExilePlayersHand(Ref_TargetPlayer), ExilePlayersGraveyard(Ref_TargetPlayer)]))",
    "Exile all cards from your hand face down. At the beginning of the next end step, return those cards to your hand, then draw a card": "ActionList([ExileHandFaceDown, CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([ReturnEachExiledCardToOwnersHand(TheCardsExiledThisWay), DrawACard]))])",
    "Exile all cards from your library. Then shuffle your graveyard into your library": "ActionList([ExileAllLibraryCards, ShuffleGraveyardIntoLibrary])",
    "Exile all creatures except those that share a creature type with a creature that convoked this spell, all artifacts, and all enchantments": "ActionList([ExileEachPermanent(Or([And([IsCardtype(Creature), ExceptFor(SharesACreatureTypeWithPermanents(ConvokedSpell(ThisSpell)))]), IsCardtype(Artifact), IsCardtype(Enchantment)]))])",
    "Exile all creatures. Incubate X, where X is the number of creatures exiled this way": "ActionList([ExileEachPermanent(IsCardtype(Creature)), Incubate(NumPermanentsExiledThisWay)])",
    "Exile all graveyards": "ActionList([ExileEachPlayersGraveyard(AnyPlayer)])",
    "Exile all nonland permanents target player controls. Return the exiled cards to the battlefield under their owner's control at the beginning of the next end step": "Targeted([TargetPlayer(AnyPlayer)], ActionList([ExileEachPermanent(And([IsNonCardtype(Land), IsPermanent, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))])), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutEachExiledCardOntoTheBattlefield(TheCardsExiledThisWay, [EntersUnderOwnersControl])]))]))",
    "Exile all opponents' graveyards": "ActionList([ExileEachPlayersGraveyard(Opponent)])",
    "Exile all opponents' graveyards, then create X {{PT}} {{CreatureTokens}}, where X is the greatest power among creature cards exiled this way": "ActionList([ExileEachPlayersGraveyard(Opponent), CreateTokens([NumberTokens(TheGreatestPowerAmongPermanents(ThePermanentsExiledThisWay), TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])])",
    "Exile all other spells and counter all abilities": "ActionList([ExileEachSpell(Other(ThisSpell)), CounterEachAbility(AnyAbility)])",
    "Exile all permanents. Exile all cards from all hands and graveyards. Each player's life total becomes {{Digits}}": "ActionList([ExileEachPermanent(AnyPermanent), ExileEachPlayersHand(AnyPlayer), ExileEachPlayersGraveyard(AnyPlayer), EachPlayerAction(AnyPlayer, SetLifeTotal({{Digits[0]}}))])",
    "Exile all {{Permanents}}": "ActionList([ExileEachPermanent({{Permanents[0]}})])",
    "Exile all {{Permanents}} from the battlefield and all {{SpecificCards}} from all graveyards": "ActionList([ExileEachPermanent({{Permanents[0]}}), ExileEachCardFromEachPlayersGraveyard({{SpecificCards[0]}}, AnyPlayer)])",
    "Exile all {{Permanents}} from the battlefield, all cards from all graveyards, and all cards from all hands": "ActionList([ExileEachPermanent({{Permanents[0]}}), ExileEachPlayersGraveyard(AnyPlayer), ExileEachPlayersHand(AnyPlayer)])",
    "Exile all {{Permanents}}, then reveal cards from the top of your library until you reveal that many creature cards. Put all creature cards revealed this way onto the battlefield, then shuffle the rest of the revealed cards into your library": "ActionList([ExileEachPermanent({{Permanents[0]}}), RevealCardsFromTheTopOfLibraryUntilANumberOfCardsOfTypeAreRevealed(NumPermanentsExiledThisWay, IsCardtype(Creature), [PutTheCardsFoundThisWayOntoTheBattlefield([EntersNormally]), PutTheRemainingCardsBackIntoLibraryAndShuffle])])",
    "Exile all {{Permanents}}, then roll a d20.\n{{RawDigits}}-{{RawDigits}} | Return those cards to the battlefield under their owner's control at the beginning of the next end step.\n{{RawDigits}}-{{RawDigits}} | Return those cards to the battlefield under their owner's control, then exile them again. Return those cards to the battlefield under their owner's control at the beginning of the next end step": "ActionList([ExileEachPermanent({{Permanents[0]}}), RollAD20, ValueActions(TheDiceResult, [ValueAction(BetweenValues({{RawDigits[0]}}, {{RawDigits[1]}}), [CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutEachExiledCardOntoTheBattlefield(TheCardsExiledThisWay, [EntersUnderOwnersControl])]))]), ValueAction(BetweenValues({{RawDigits[2]}}, {{RawDigits[3]}}), [PutEachExiledCardOntoTheBattlefield(TheCardsExiledThisWay, [EntersUnderOwnersControl]), ExileEachPermanent(ThePermanentsPutOnTheBattlefieldThisWay), CreateFutureTrigger(AtTheBeginningOfPlayersNextEndStep(You), ActionList([PutEachExiledCardOntoTheBattlefield(TheCardsExiledThisWay, [EntersUnderOwnersControl])]))])])])",
    "Exile all {{Permanents}}.\n{{AbilityWord}} - Create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}} if {{Condition}}": "ActionList([ExileEachPermanent({{Permanents[0]}}), If({{Condition[0]}}, [CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])])])])",
    "Exile all {{Permanents}}. At the beginning of the next end step, reveal cards from the top of your library until you reveal that many {{SpecificCards}}, put all {{SpecificCards}} revealed this way onto the battlefield, then shuffle the rest of the revealed cards into your library": "ActionList([ExileEachPermanent({{Permanents[0]}}), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([RevealCardsFromTheTopOfLibraryUntilANumberOfCardsOfTypeAreRevealed(NumPermanentsExiledThisWay, {{SpecificCards[0]}}, [PutTheCardsFoundThisWayOntoTheBattlefield([EntersNormally]), PutTheRemainingCardsBackIntoLibraryAndShuffle])]))])",
    "Exile all {{Permanents}}. Each player creates {{a}} {{PT}} {{CreatureToken}} and puts a number of {{CounterType}} counters on it equal to the total power of creatures they controlled that were exiled this way": "ActionList([ExileEachPermanent({{Permanents[0]}}), EachPlayerActions(AnyPlayer, [CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])]), PutNumberCountersOfTypeOnPermanent(TotalPowerOfPermanentsExiledThisWay(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(ActionPlayer))])), {{CounterType[0]}}, TheTokenCreatedByPlayerThisWay(ActionPlayer))])])",
    "Exile all {{Permanents}}. For as long as any of those cards remain exiled, at the beginning of each player's upkeep, that player returns one of the exiled cards they own to the battlefield": "ActionList([ExileEachPermanent({{Permanents[0]}}), CreateTriggerUntil(AtTheBeginningOfAPlayersUpkeep(AnyPlayer), ActionList([PlayerMayAction(Trigger_ThatPlayer, ReturnAnExiledCardToBattlefield(And([TheCardsExiledThisWay, OwnedByAPlayer(SinglePlayer(ActionPlayer))]), [EntersNormally]))]), UntilCardsAreNoLongerExiled(TheCardsExiledThisWay))])",
    "Exile all {{Permanents}}. For each creature exiled this way, its controller draws a card": "ActionList([ExileEachPermanent({{Permanents[0]}}), EachPlayerAction(AnyPlayer, DrawNumberCards(NumPermanentsOfTypeExiledThisWay(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(ActionPlayer))]))))])",
    "Exile all {{Permanents}}. Starting with you, each player chooses one of the exiled cards and puts it onto the battlefield tapped under their control. Repeat this process until all cards exiled this way have been chosen": "ActionList([ExileEachPermanent({{Permanents[0]}}), RepeatableActions([EachPlayerStartingWithAction(AnyPlayer, You, [ReturnAnExiledCardToBattlefield(WasExiledThisWay, [EntersUnderPlayersControl(ActionPlayer)])]), If(NumCardsInExileIs(GreaterThan(Integer(0)), WasExiledThisWay), [RepeatThisProcess])])])",
    "Exile all {{Permanents}}. They perpetually gain \"{{PerpetualQuotedAbility}}\" and \"{{PerpetualQuotedAbility}}\". For as long as each of them remain exiled, its owner may play it": "ActionList([ExileEachPermanent({{Permanents[0]}}), CreatePerpetualEachExiledCardEffect(TheCardsExiledThisWay, [AddAbility([{{PerpetualQuotedAbility[0]}}]), AddAbility([{{PerpetualQuotedAbility[1]}}])]), ActionForEachExiledCard(TheCardsExiledThisWay, [CreatePlayerEffectUntil(OwnerOfExiledCard(EachableExiled), [MayPlayExiledCard(EachableExiled)], UntilCardIsNoLongerExiled(EachableExiled))])])",
    "Exile all {{Permanents}}. You discard your hand": "ActionList([ExileEachPermanent({{Permanents[0]}}), DiscardHand])",
    "Exile all {{SpecificCards}} from all graveyards. You gain {{Digits}} life for each card exiled this way": "ActionList([ExileEachCardFromEachPlayersGraveyard({{SpecificCards[0]}}, AnyPlayer), GainLifeForEach({{Digits[0]}}, NumGraveyardCardsExiledThisWay)])",
    "Exile all {{SpecificCards}} from target player's graveyard in a face-down pile, shuffle that pile, then manifest those cards": "Targeted([TargetPlayer(AnyPlayer)], ActionList([ExileEachCardFromPlayersGraveyardInShuffledFaceDownPile({{SpecificCards[0]}}, Ref_TargetPlayer), ManifestEachExiledCard(TheCardsExiledThisWay)]))",
    "Exile all {{SpecificCards}} from target player's graveyard. You gain {{Digits}} life for each card exiled this way": "Targeted([TargetPlayer(AnyPlayer)], ActionList([ExileEachCardFromPlayersGraveyard({{SpecificCards[0]}}, Ref_TargetPlayer), GainLifeForEach({{Digits[0]}}, NumGraveyardCardsExiledThisWay)]))",
    "Exile all {{SpecificCards}} from target player's graveyard. You may cast spells from among those cards for as long as they remain exiled, and mana of any type can be spent to cast them": "Targeted([TargetPlayer(AnyPlayer)], ActionList([ExileEachCardFromPlayersGraveyard({{SpecificCards[0]}}, Ref_TargetPlayer), CreatePlayerEffectUntil(You, [MayCastSpellsFromAmongExiledAndMaySpendManaAsThoughAnyTypeToCast(AnySpell, TheCardsExiledThisWay)], UntilCardsAreNoLongerExiled(TheCardsExiledThisWay))]))",
    "Exile any number of target creatures. For each creature exiled this way, its controller creates {{a}} {{PT}} {{CreatureToken}} with {{Hasable}}": "Targeted([AnyNumberOfTargetPermanents(IsCardtype(Creature))], ActionList([ExileEachPermanent(Ref_TargetPermanents), EachPlayerAction(ControlledAPermanentExiledThisWay, CreateTokens([NumberTokens(NumPermanentsOfTypeExiledThisWay(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(ActionPlayer))])), TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}]))]))]))",
    "Exile any number of target players' graveyards": "Targeted([AnyNumberOfTargetPlayers(AnyPlayer)], ActionList([ExileEachPlayersGraveyard(Ref_TargetPlayers)]))",
    "Exile any number of target {{Creatures}} controlled by different players. For each creature exiled this way, its controller reveals cards from the top of their library until they reveal {{a}} {{SpecificCard}}, puts that card onto the battlefield, then puts the rest on the bottom of their library in a random order": "Targeted([AnyNumberOfTargetGroupPermanents({{Creatures[0]}}, ControlledByDifferentPlayers)], ActionList([ExileEachPermanent(Ref_TargetPermanents), ActionForEachPermanentExiledThisWayByController([PlayerAction(ControllerOfEachableExiledPermanent, RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed({{SpecificCard[0]}}, [PutTheCardFoundThisWayOntoTheBattlefield([EntersNormally]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder]))])]))",
    "Exile any number of target {{Permanents}}": "Targeted([AnyNumberOfTargetPermanents({{Permanents[0]}})], ActionList([ExileEachPermanent(Ref_TargetPermanents)]))",
    "Exile any number of target {{Permanents}} and all {{Permanents}} attached to them": "Targeted([AnyNumberOfTargetPermanents({{Permanents[0]}})], ActionList([ExileEachPermanent(Or([Ref_TargetPermanents, AttachedToAPermanent(Ref_TargetPermanents)]))]))",
    "Exile any number of target {{Permanents}}. At the beginning of the next end step, return each of them to the battlefield under its owner's control. Each of them enters with an additional {{CounterType}} counter on it if it's a creature and an additional {{CounterType}} counter on it if it's a planeswalker": "Targeted([AnyNumberOfTargetPermanents({{Permanents[0]}})], ActionList([ExileEachPermanent(Ref_TargetPermanents), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutEachExiledCardOntoTheBattlefield(TheCardsExiledThisWay, [EntersUnderPlayersControl(You), IfPassesFilter(IsCardtype(Creature), [EntersWithACounter({{CounterType[0]}})]), IfPassesFilter(IsCardtype(Planeswalker), [EntersWithACounter({{CounterType[1]}})])])]))]))",
    "Exile any number of target {{Permanents}}. Return those cards to the battlefield under their owner's control at the beginning of the next end step": "Targeted([AnyNumberOfTargetPermanents({{Permanents[0]}})], ActionList([ExileEachPermanent(Ref_TargetPermanents), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutEachExiledCardOntoTheBattlefield(TheCardsExiledThisWay, [EntersUnderOwnersControl])]))]))",
    "Exile any number of target {{StackSpells}}": "Targeted([AnyNumberOfTargetSpells({{StackSpells[0]}})], ActionList([ExileEachSpell(Ref_TargetSpells)]))",
    "Exile any number of {{Permanents}} in a face-down pile, shuffle that pile, then cloak them": "ActionList([ExileEachPermanentInAShuffledFaceDownPile({{Permanents[0]}}), CloakEachExiledCard(TheCardsExiledThisWay, [EntersNormally])])",
    "Exile cards from the top of your library until you exile {{a}} {{SpecificCard}}. You may cast that card without paying its mana cost if the spell's mana value is less than {{GameNumber}}. If you don't cast that card this way, put it into your hand": "ActionList([ExileTopCardsOfLibraryUntilASingleCardOfTypeIsExiled({{SpecificCard[0]}}), MayAction(CastSpellFromExileWithoutPaying(ManaValueIs(LessThan({{GameNumber[0]}})), TheSpecificCardExiledThisWay)), PutExiledCardIntoOwnersHand(TheSpecificCardExiledThisWay)])",
    "Exile each opponent's graveyard. When you do, choose up to one target creature card exiled this way. Create a token that's a copy of that card, except it's an artifact and it loses all other card types": "ActionList([MustCost(Exile([GraveyardCards(InAPlayersGraveyard(Opponent))])), If(CostWasPaid, [ReflexiveTrigger(Targeted([UptoOneTargetExiledCard(And([IsCardtype(Creature), TheCardsExiledThisWay]))], ActionList([CreateTokens([TokenCopyOfExiledCard(Ref_TargetExiledCard, TokenCopyEffects([SetCardtypes([Artifact])]))])])))])])",
    "Exile each {{Permanent}}": "ActionList([ExileEachPermanent({{Permanent[0]}})])",
    "Exile each {{Permanent}}. Return those cards to the battlefield under their owner's control at the beginning of the next end step": "ActionList([ExileEachPermanent({{Permanent[0]}}), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutEachExiledCardOntoTheBattlefield(TheCardsExiledThisWay, [EntersUnderOwnersControl])]))])",
    "Exile target card from a graveyard": "Targeted([TargetGraveyardCard(AnyCardInAnyGraveyard)], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard)]))",
    "Exile target card from a graveyard.\nDraw a card": "Targeted([TargetGraveyardCard(AnyCardInAnyGraveyard)], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard), DrawACard]))",
    "Exile target card from a graveyard.\nDraw a card at the beginning of the next turn's upkeep": "Targeted([TargetGraveyardCard(AnyCardInAnyGraveyard)], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard), CreateFutureTrigger(AtTheBeginningOfTheNextTurnsUpkeep, ActionList([DrawACard]))]))",
    "Exile target card from a graveyard. Create {{a}} {{PT}} {{CreatureToken}}": "Targeted([TargetGraveyardCard(AnyCardInAnyGraveyard)], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])]))",
    "Exile target card from a graveyard. Create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}}": "Targeted([TargetGraveyardCard(AnyCardInAnyGraveyard)], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])])]))",
    "Exile target card from a graveyard. Draw a card": "Targeted([TargetGraveyardCard(AnyCardInAnyGraveyard)], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard), DrawACard]))",
    "Exile target card from a graveyard. If it was {{a}} {{SpecificCard}}, you gain {{Digits}} life. Otherwise, you draw a card": "Targeted([TargetGraveyardCard(AnyCardInAnyGraveyard)], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard), IfElse(GraveyardCardPassesFilter(Ref_TargetGraveyardCard, {{SpecificCard[0]}}), [GainLife({{Digits[0]}})], [DrawACard])]))",
    "Exile target card from a graveyard. Its owner creates a {{PT}} {{CreatureToken}} with {{Hasable}}": "Targeted([TargetGraveyardCard(AnyCardInAnyGraveyard)], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard), PlayerAction(OwnerOfGraveyrdCard(Ref_TargetGraveyardCard), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])]))]))",
    "Exile target card from a graveyard. You gain {{Digits}} life": "Targeted([TargetGraveyardCard(AnyCardInAnyGraveyard)], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard), GainLife({{Digits[0]}})]))",
    "Exile target creature an opponent controls with mana value {{Digits}} or less and all other creatures that player controls with the same name as that creature. Then that player reveals their hand and exiles all cards with that name from their hand and graveyard": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(Opponent), ManaValueIs(LessThanOrEqualTo({{Digits[0]}}))]))], ActionList([ExileEachPermanent(Or([SinglePermanent(Ref_TargetPermanent), And([Other(Ref_TargetPermanent), IsCardtype(Creature), ControlledByPlayer(ControllerOfPermanent(Ref_TargetPermanent))])])), PlayerActions(ControllerOfPermanent(Ref_TargetPermanent), [RevealHand, ExileEachCardFromHandAndGraveyard(SharesANameWithPermanent(Ref_TargetPermanent))])]))",
