    "Search your library for {{a}} {{SpecificCard}}, put that card onto the battlefield tapped, then shuffle": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersTapped]), Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}}, put that card onto the battlefield tapped, then shuffle.\nLearn": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersTapped]), Shuffle]), Learn])",
    "Search your library for {{a}} {{SpecificCard}}, put that card onto the battlefield tapped, then shuffle.\n{{AbilityWord}} - If {{Condition}}, instead search your library for up to {{Number}} {{SpecificCards}}, put them onto the battlefield tapped, then shuffle": "ActionList([IfElse({{Condition[0]}}, [SearchLibrary([FindNumberCardsOfType({{Number[0]}}, {{SpecificCards[0]}}), PutFoundCardsOntoBattlefield([EntersTapped]), Shuffle])], [SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersTapped]), Shuffle])])])",
    "Search your library for {{a}} {{SpecificCard}}, put that card onto the battlefield tapped, then shuffle. Then if {{Condition}}, scry {{Digits}}": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersTapped]), Shuffle]), If({{Condition[0]}}, [Scry({{Digits[0]}})])])",
    "Search your library for {{a}} {{SpecificCard}}, put that card onto the battlefield, then shuffle": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}}, put that card onto the battlefield, then shuffle.\nDraw a card at the beginning of the next turn's upkeep": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle]), CreateFutureTrigger(AtTheBeginningOfTheNextTurnsUpkeep, ActionList([DrawACard]))])",
    "Search your library for {{a}} {{SpecificCard}}, reveal it, and put it into your hand. If this spell was cast from a graveyard, put that card onto the battlefield instead. Then shuffle": "ActionList([IfElse(SpellPassesFilter(ThisSpell, WasCastFromAPlayersGraveyard(AnyPlayer)), [SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle])], [SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])])",
    "Search your library for {{a}} {{SpecificCard}}, reveal it, put it into your hand or graveyard, then shuffle": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, ChooseAnAction([PutFoundCardsIntoHand, PutFoundCardsIntoGraveyard]), Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}}, reveal it, put it into your hand, then shuffle": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}}, reveal it, put it into your hand, then shuffle.\nAt the beginning of your next upkeep, pay {{ManaCost}}. If you don't, you lose the game": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle]), CreateFutureTrigger(AtTheBeginningOfPlayersNextUpkeep(You), ActionList([MustCost(PayMana({{ManaCost[0]}})), If(CostWasntPaid, [LoseTheGame])]))])",
    "Search your library for {{a}} {{SpecificCard}}, reveal it, put it into your hand, then shuffle.\n{{AbilityWord}} - If {{Condition}}, instead search your library for any card, put it into your hand, then shuffle": "ActionList([IfElse({{Condition[0]}}, [SearchLibrary([FindAGenericCard, PutFoundCardsIntoHand, Shuffle])], [SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])])",
    "Search your library for {{a}} {{SpecificCard}}, reveal it, put it into your hand, then shuffle.\n{{AbilityWord}} - If {{Condition}}, instead search your library for {{a}} {{SpecificCard}}, reveal it, put it into your hand, then shuffle": "ActionList([IfElse({{Condition[0]}}, [SearchLibrary([FindACardOfType({{SpecificCard[1]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])], [SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])])",
    "Search your library for {{a}} {{SpecificCard}}, reveal it, put it into your hand, then shuffle.\n{{AbilityWord}} - You may put that card onto the battlefield instead of putting it into your hand if {{Condition}}":
      "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, If({{Condition[0]}}, [MayPutFoundCardsOntoBattlefield([EntersNormally])]), PutFoundCardsIntoHand, Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}}, reveal it, put it into your hand, then shuffle. Create a Food token": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle]), CreateTokens([FoodToken])])",
    "Search your library for {{a}} {{SpecificCard}}, reveal it, put it into your hand, then shuffle. Create {{a}} {{PT}} {{CreatureToken}} with \"{{TokenQuotedAbility}}\"": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle]), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{TokenQuotedAbility[0]}}])])])",
    "Search your library for {{a}} {{SpecificCard}}, reveal it, put it into your hand, then shuffle. It perpetually becomes a Clue artifact in addition to its other types and gains \"{{PerpetualQuotedAbility}}\"": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle]), CreatePerpetualCardInHandEffect(TheCardPutInHandThisWay, [AddArtifactType(Clue), AddAbility([{{PerpetualQuotedAbility[0]}}])])])",
    "Search your library for {{a}} {{SpecificCard}}, reveal it, put it into your hand, then shuffle. You gain {{Digits}} life": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle]), GainLife({{Digits[0]}})])",
    "Search your library for {{a}} {{SpecificCard}}, reveal it, put it into your hand, then shuffle. You get {{Energy}}": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle]), GetEnergy(Integer({{Energy[0]}}))])",
    "Search your library for {{a}} {{SpecificCard}}, reveal it, then shuffle and put that card on top": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, SetAsideFoundCards, Shuffle, PutSetAsideCardsOnTopOfLibrary])])",
    "Search your library for {{a}} {{SpecificCard}}, reveal it, then shuffle and put the card on top": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, SetAsideFoundCards, Shuffle, PutSetAsideCardsOnTopOfLibrary])])",
    "Search your library for {{a}} {{SpecificCard}}, reveal that card, put it into your hand, then shuffle": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}}, {{a}} {{SpecificCard}}, or {{a}} {{SpecificCard}}, reveal it, put it into your hand, then shuffle. You gain {{Digits}} life for each {{Eachable[ThisSpell]}}": "ActionList([SearchLibrary([FindACardOfType(Or([{{SpecificCard[0]}}, {{SpecificCard[1]}}, {{SpecificCard[2]}}])), RevealFoundCards, PutFoundCardsIntoHand, Shuffle]), GainLifeForEach({{Digits[0]}}, {{Eachable[ThisSpell][0]}})])",
    "Search your library for {{a}} {{SpecificCard}}, {{a}} {{SpecificCard}}, {{a}} {{SpecificCard}}, and {{a}} {{SpecificCard}}. Reveal those cards, put them into your hand, then shuffle": "ActionList([SearchLibrary([FindCardsOfType([{{SpecificCard[0]}}, {{SpecificCard[1]}}, {{SpecificCard[2]}}, {{SpecificCard[3]}}]), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}}, {{a}} {{SpecificCard}}, {{a}} {{SpecificCard}}, {{a}} {{SpecificCard}}, and {{a}} {{SpecificCard}}. Reveal those cards, put them into your hand, then shuffle": "ActionList([SearchLibrary([FindCardsOfType([{{SpecificCard[0]}}, {{SpecificCard[1]}}, {{SpecificCard[2]}}, {{SpecificCard[3]}}, {{SpecificCard[4]}}]), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}}. If target opponent controls more lands than you, you may search your library for an additional {{SpecificCard}}. Reveal those cards, put them into your hand, then shuffle": "Targeted([TargetPlayer(Opponent)], ActionList([IfElse(PlayerPassesFilter(Ref_TargetPlayer, ControlsMorePermanentThanPlayer(You, IsCardtype(Land))), [SearchLibrary([FindCardsOfType([{{SpecificCard[0]}}, {{SpecificCard[1]}}]), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])], [SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])]))",
    "Secretly choose land or nonland. Seek a card of the chosen kind": "ActionList([SecretlyChooseLibraryFilter([IsCardtype(Land), IsNonCardtype(Land)]), SeekACard(TheChosenLibraryFilter)])",
    "Seek X cards that each share a color with one or more permanents you control, where X is {{GameNumber}}. For each color among permanents you control, those cards perpetually gain \"{{PerpetualQuotedAbility}}\"": "ActionList([SeekNumberCards({{GameNumber[0]}}, SharesAColorWithAPermanent(And([IsPermanent, ControlledByAPlayer(SinglePlayer(You))]))), ActionNumberTimes(NumColorsAmongPermanents(And([IsPermanent, ControlledByAPlayer(SinglePlayer(You))])), [CreatePerpetualCardsInHandEffect(TheCardsSeekedThisWay, [AddAbility([{{PerpetualQuotedAbility[0]}}])])])])",
    "Seek X {{PermanentCards}}, where X is {{GameNumber}}. Put those cards onto the battlefield": "ActionList([SeekNumberCards({{GameNumber[0]}}, {{PermanentCards[0]}}), PutCardsFromHandOnBattlefield(TheCardsSeekedThisWay, [EntersNormally])])",
    "Seek {{Number}} cards. You may shuffle them into your library. If you do, seek {{Number}} cards.\nYou have no maximum hand size for the rest of the game": "ActionList([SeekNumberCards({{Number[0]}}, AnyCard), MayCost(ShuffleCardsFromHandIntoLibrary(TheCardsSeekedThisWay)), If(CostWasPaid, [SeekNumberCards({{Number[1]}}, AnyCard)]), CreatePlayerEffectUntil(You, [HasNoMaximumHandSize], UntilEndOfTurn)])",
    "Seek {{Number}} {{SpecificCards}} from among the top {{Number}} cards of your library, then shuffle. {{CreatureCards}} in your hand perpetually get {{PTMod}}": "ActionList([SeekNumberCardsFromTheTopNumberCardsOfLibrary({{Number[0]}}, {{SpecificCards[0]}}, {{Number[1]}}), CreatePerpetualCardsInHandEffect({{CreatureCards[0]}}, [AdjustPT({{PTMod[0]}})])])",
    "Seek {{Number}} {{SpecificCards}}, then put a card from your hand on the bottom of your library": "ActionList([SeekNumberCards({{Number[0]}}, {{SpecificCards[0]}}), PutACardFromHandOnBottomOfLibrary])",
    "Seek {{Number}} {{SpecificCards}}, then {{SpecificCards}} in your hand perpetually gain \"{{PerpetualQuotedAbility}}\"": "ActionList([SeekNumberCards({{Number[0]}}, {{SpecificCards[0]}}), CreatePerpetualCardsInHandEffect(TheCardsSeekedThisWay, [AddAbility([{{PerpetualQuotedAbility[0]}}])])])",
    "Seek {{a}} {{SpecificCard}}": "ActionList([SeekACard({{SpecificCard[0]}})])",
    "Seek {{a}} {{SpecificCard}}.\nLearn": "ActionList([SeekACard({{SpecificCard[0]}}), Learn])",
    "Seek {{a}} {{SpecificCard}} and put it onto the battlefield": "ActionList([SeekACard({{SpecificCard[0]}}), PutCardFromHandOnBattlefield(TheCardSeekedThisWay, [EntersNormally])])",
    "Seek {{a}} {{SpecificCard}} and put it onto the battlefield tapped. Then seek {{a}} {{SpecificCard}}": "ActionList([SeekACard({{SpecificCard[0]}}), PutCardFromHandOnBattlefield(TheCardPutInHandThisWay, [EntersTapped]), SeekACard({{SpecificCard[1]}})])",
    "Seek {{a}} {{SpecificCard}} and {{a}} {{SpecificCard}}. Discard those cards at the beginning of your next turn's end step": "ActionList([SeekACard({{SpecificCard[0]}}), SeekACard({{SpecificCard[1]}}), CreateFutureTrigger(AtTheBeginningOfPlayersEndStepNextTurn(You), ActionList([DiscardEachCard(TheCardsSeekedThisWay)]))])",
    "Seek {{a}} {{SpecificCard}}, {{a}} {{SpecificCard}}, and {{a}} {{SpecificCard}}. Put one of them onto the battlefield and put one of them into your graveyard": "ActionList([SeekCards([{{SpecificCard[0]}}, {{SpecificCard[1]}}, {{SpecificCard[2]}}]), PutACardFromHandOnBattlefield(TheCardsSeekedThisWay, [EntersNormally]), PutACardFromHandIntoGraveyard(TheCardsSeekedThisWay)])",
    "Seek {{a}} {{SpecificCard}}. At the beginning of the next end step, if that card is in your hand, exile it": "ActionList([SeekACard({{SpecificCard[0]}}), CreateFutureTriggerI(AtTheBeginningOfTheNextEndStep, PlayerPassesFilter(You, HasACardInHand(SingleCardInHand(TheCardSeekedThisWay))), ActionList([Exile([CardInHand(TheCardSeekedThisWay)])]))])",
    "Separate all {{Creatures}} target player controls into two piles. Destroy all creatures in the pile of that player's choice. They can't be regenerated": "Targeted([TargetPlayer(AnyPlayer)], ActionList([SeparatePermanentsIntoNumberPiles(And([{{Creatures[0]}}, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]), Integer(2)), PlayerAction(Ref_TargetPlayer, ChooseAPermanentPile), DestroyEachPermanentNoRegen(InThePermanentPileChosenThisWay)]))",
    "Separate all {{SpecificCards}} in your graveyard into two piles. Exile the pile of an opponent's choice and return the other to the battlefield": "ActionList([SeparateCardsInPlayersGraveyardIntoTwoPiles({{SpecificCards[0]}}, You), APlayerAction(Opponent, ChooseAGraveyardPile), ExileEachGraveyardCard(InTheGraveyardPileChosenThisWay), ReturnEachGraveyardCardToBattlefield(InTheGraveyardPileNotChosenThisWay, [EntersNormally])])",
    "Shuffle a card from your hand into your library. If you do, draw {{Number}} cards at the beginning of the next turn's upkeep": "ActionList([MustCost(ShuffleACardFromHandIntoLibrary), If(CostWasPaid, [CreateFutureTrigger(AtTheBeginningOfTheNextTurnsUpkeep, ActionList([DrawNumberCards({{Number[0]}})]))])])",
    "Shuffle all cards from your graveyard into your library. Target player mills that many cards": "Targeted([TargetPlayer(AnyPlayer)], ActionList([ShuffleGraveyardIntoLibrary, PlayerAction(Ref_TargetPlayer, MillNumberCards(NumCardsShuffledIntoLibraryThisWay))]))",
    "Shuffle all permanents you own into your library, then reveal that many cards from the top of your library. Put all non-Aura permanent cards revealed this way onto the battlefield, then do the same for Aura cards, then put the rest on the bottom of your library in a random order": "ActionList([ShuffleEachPermanentIntoLibrary(OwnedByAPlayer(SinglePlayer(You))), RevealTheTopNumberCardsOfLibrary(NumCardsShuffledIntoLibraryThisWay, [PutEachCardOfTypeOntoTheBattlefield(And([IsNonEnchantmentType(Aura), IsPermanent]), [EntersNormally]), PutEachCardOfTypeOntoTheBattlefield(IsEnchantmentType(Aura), [EntersNormally]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "Shuffle all {{SpecificCards}} from target player's graveyard into that player's library": "Targeted([TargetPlayer(AnyPlayer)], ActionList([ShuffleEachCardInPlayersGraveyardIntoLibrary({{SpecificCards[0]}}, Ref_TargetPlayer)]))",
    "Shuffle any number of target {{SpecificCards}} from your graveyard into your library": "Targeted([AnyNumberOfTargetGraveyardCards(And([{{SpecificCards[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([ShuffleEachGraveyardCardIntoLibrary(Ref_TargetGraveyardCards)]))",
    "Shuffle up to {{Number}} cards you own from outside the game into your library": "ActionList([ShuffleUptoNumberCardsFromOutsideTheGameIntoLibrary({{Number[0]}})])",
    "Shuffle your library, then exile the top {{Number}} cards. You may cast any number of {{PotentialSpells}} from among them without paying their mana costs. {{Permanents}} don't untap during your next untap step": "ActionList([Shuffle, ExileTheTopNumberCardsOfLibrary({{Number[0]}}), CastAnyNumberOfSpellsFromExileWithoutPaying({{PotentialSpells[0]}}, TheCardsExiledThisWay), CreateEachPermanentRuleEffectUntil({{Permanents[0]}}, [DoesntUntapDuringControllersUntap], DuringPlayersNextUntapStep(You))])",
    "Shuffle your library, then mill {{Number}} cards. Put each creature card milled this way onto the battlefield. They gain {{Hasable}}. At the beginning of the next end step, return those creatures to their owner's hand": "ActionList([Shuffle, MillNumberCards({{Number[0]}}), PutEachCardOfTypeMilledThisWayOntoTheBattlefield(IsCardtype(Creature), [EntersNormally]), CreateEachPermanentLayerEffect(ThePermanentsPutOnTheBattlefieldThisWay, [AddAbility([{{Hasable[0]}}])]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutEachPermanentIntoItsOwnersHand(ThePermanentsPutOnTheBattlefieldThisWay)]))])",
    "Shuffle your library, then reveal cards from the top of it until you reveal {{a}} {{SpecificCard}}. Exile that card and put the rest on the bottom of your library in a random order. You may cast the exiled card without paying its mana cost": "ActionList([Shuffle, RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed({{SpecificCard[0]}}, [ExileTheCardFoundThisWay, PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder]), MayAction(CastExiledCardWithoutPaying(TheCardExiledThisWay))])",
    "Shuffle your library. As many times as you choose, you may exile the top card of your library. If the total mana value of the cards exiled this way is {{Digits}} or less, you may cast any number of spells from among those cards without paying their mana costs": "ActionList([Shuffle, RepeatableActions([MayCost(ExileTopCardOfLibrary), If(CostWasPaid, [RepeatThisProcess])]), If(TheTotalManaValueOfExiledCardsIs(WasExiledThisWay, LessThanOrEqualTo({{Digits[0]}})), [CastAnyNumberOfExiledCardsWithoutPaying(WasExiledThisWay)])])",
    "Shuffle your library. Then exile the top card of your library. Until end of turn, you may play that card without paying its mana cost": "ActionList([Shuffle, ExileTopCardOfLibrary, CreatePlayerEffectUntil(You, [MayPlayExiledCardWithoutPaying(TheCardExiledThisWay)], UntilEndOfTurn)])",
    "Simultaneously untap all tapped {{Permanents}} and tap all untapped {{Permanents}}": "ActionList([SimultaneouslyTapEachPermanentAndUntapEachPermanent(And([IsUntapped, {{Permanents[1]}}]), And([IsTapped, {{Permanents[0]}}]))])",
    "Simultaneously, all phased-out {{Permanents}} phase in and all {{Permanents}} with phasing phase out": "ActionList([PhaseInEachPermanentAndPhaseOutEachPermanent({{Permanents[0]}}, And([{{Permanents[1]}}, HasAbility(Phasing)]))])",
    "Spells you control can't be countered by {{StackSpells}} this turn, and {{Permanents}} can't be the targets of {{StackSpells}} this turn": "ActionList([CreatePlayerEffectUntil(You, [SpellsControlledHaveAbility(AnySpell, [CantBeCounteredBySpells({{StackSpells[0]}})])], UntilEndOfTurn), CreateEachPermanentRuleEffectUntil({{Permanents[0]}}, [CantBeTheTargetOfSpells({{StackSpells[1]}})], UntilEndOfTurn)])",
    "Starting with the next opponent in turn order, each player chooses a creature you don't control. Destroy the chosen creatures": "ActionList([EachPlayerStartingWithAction(AnyPlayer, NextOpponentInTurnOrder, [ChooseAPermanent(And([IsCardtype(Creature), ControlledByAPlayer(Other(You))]))]), DestroyEachPermanent(ThePermanentsChosenThisWay)])",
    "Starting with you, each player may pay any amount of life. Repeat this process until no one pays life. Each player creates {{a}} {{PT}} {{CreatureToken}} for each 1 life they paid this way": "ActionList([RepeatableActions([EachPlayerStartingWithAction(AnyPlayer, You, [PayAnyAmountOfLife]), Unless(NoLifeWasPaidThisWay, [RepeatThisProcess])]), EachPlayerAction(AnyPlayer, CreateTokens([NumberTokens(AmountOfLifePaidThisWay, TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, []))]))])",
    "Starting with you, each player may pay any amount of mana. Each player creates X {{PT}} {{CreatureTokens}}, where X is the total amount of mana paid this way": "ActionList([EachPlayerStartingWithAction(AnyPlayer, You, [PayAnyAmountOfMana]), EachPlayerAction(AnyPlayer, CreateTokens([NumberTokens(TheTotalAmountOfManaPaidThisWay, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))]))])",
    "Starting with you, each player may pay any amount of mana. Each player draws X cards, where X is the total amount of mana paid this way": "ActionList([EachPlayerStartingWithAction(AnyPlayer, You, [PayAnyAmountOfMana]), EachPlayerAction(AnyPlayer, DrawNumberCards(AmountOfManaPaidThisWay))])",
    "Starting with you, each player may pay any amount of mana. Each player mills X cards, where X is the total amount of mana paid this way": "ActionList([EachPlayerStartingWithAction(AnyPlayer, You, [PayAnyAmountOfMana]), EachPlayerAction(AnyPlayer, MillNumberCards(AmountOfManaPaidThisWay))])",
    "Starting with you, each player may pay any amount of mana. Each player searches their library for up to X {{SpecificCards}}, where X is the total amount of mana paid this way, puts them onto the battlefield tapped, then shuffles": "ActionList([EachPlayerStartingWithMayAction(AnyPlayer, You, PayAnyAmountOfMana), EachPlayerAction(AnyPlayer, SearchLibrary([FindNumberCardsOfType(AmountOfManaPaidThisWay, {{SpecificCards[0]}}), PutFoundCardsOntoBattlefield([EntersTapped]), Shuffle]))])",
    "Starting with you, each player may put {{a}} {{SpecificCard}} from their hand onto the battlefield. Repeat this process until no one puts a card onto the battlefield": "ActionList([RepeatableActions([EachPlayerStartingWithMayAction(AnyPlayer, You, PutACardFromHandOnBattlefield({{SpecificCard[0]}}, [EntersNormally])), Unless(NoOneTookAnActionThisWay, [RepeatThisProcess])])])",
    "Starting with you, each player separates all permanents they control into {{Number}} piles. Then each player chooses one of their piles at random and sacrifices those permanents": "ActionList([EachPlayerStartingWithAction(AnyPlayer, You, [SeparatePermanentsIntoNumberPiles(ControlledByAPlayer(SinglePlayer(ActionPlayer)), {{Number[0]}})]), ChooseAPileCreatedByEachPlayerAtRandom(AnyPlayer), EachPlayerAction(AnyPlayer, SacrificeEachPermanent(InTheChosenPiles))])",
    "Starting with you, each player votes for death or taxes. Each opponent sacrifices {{a}} {{Permanent}} of their choice for each death vote and discards a card for each taxes vote": "ActionList([EachPlayerStartingWithAction(AnyPlayer, You, [VoteForAWord([\"Death\", \"Taxes\"])]), EachPlayerActions(Opponent, [SacrificeNumberPermanents(TheNumberOfVotesForWord(\"Death\"), {{Permanent[0]}}), DiscardNumberCards(TheNumberOfVotesForWord(\"Taxes\"))])])",
    "Starting with you, each player votes for death or torture. If death gets more votes, each opponent sacrifices {{a}} {{Permanent}} of their choice. If torture gets more votes or the vote is tied, each opponent loses {{Digits}} life": "ActionList([EachPlayerStartingWithAction(AnyPlayer, You, [VoteForAWord([\"Death\", \"Torture\"])]), If(MostVotesForWordIs(\"Death\"), [EachPlayerAction(Opponent, SacrificeAPermanent({{Permanent[0]}}))]), If(MostVotesOrTiedForMostVotesForWordIs(\"Torture\"), [EachPlayerAction(Opponent, LoseLife({{Digits[0]}}))])])",
    "Starting with you, each player votes for sickness or psychosis. If sickness gets more votes, {{Creatures}} get {{PTMod}} until end of turn. If psychosis gets more votes or the vote is tied, each opponent discards {{Number}} cards": "ActionList([EachPlayerStartingWithAction(AnyPlayer, You, [VoteForAWord([\"Sickness\", \"Psychosis\"])]), If(MostVotesForWordIs(\"Sickness\"), [CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)]), If(MostVotesOrTiedForMostVotesForWordIs(\"Psychosis\"), [EachPlayerAction(Opponent, DiscardNumberCards({{Number[0]}}))])])",
    "Starting with you, each player votes for time or knowledge. If time gets more votes, take an extra turn after this one. If knowledge gets more votes or the vote is tied, draw {{Number}} cards": "ActionList([EachPlayerStartingWithAction(AnyPlayer, You, [VoteForAWord([\"Time\", \"Knowledge\"])]), If(MostVotesForWordIs(\"Time\"), [TakeAnExtraTurn]), If(MostVotesOrTiedForMostVotesForWordIs(\"Knowledge\"), [DrawNumberCards({{Number[0]}})])])",
    "Starting with you, each player votes for wild or free. Reveal cards from the top of your library until you reveal a creature card for each wild vote. Put those creature cards onto the battlefield, then shuffle the rest into your library. You may put a permanent card from your hand onto the battlefield for each free vote": "ActionList([EachPlayerStartingWithAction(AnyPlayer, You, [VoteForAWord([\"Wild\", \"Free\"])]), RevealCardsFromTheTopOfLibraryUntilANumberOfCardsOfTypeAreRevealed(TheNumberOfVotesForWord(\"Wild\"), IsCardtype(Creature), [PutTheCardsFoundThisWayOntoTheBattlefield([EntersNormally]), PutTheRemainingCardsBackIntoLibraryAndShuffle]), PutUptoNumberCardsFromHandOntoBattlefield(TheNumberOfVotesForWord(\"Free\"), IsPermanent, [EntersNormally])])",
    "Starting with you, each player votes for {{a}} {{Permanent}} you don't control. Exile each permanent with the most votes or tied for most votes": "ActionList([EachPlayerStartingWithAction(AnyPlayer, You, [VoteForAPermanent(And([{{Permanent[0]}}, ControlledByAPlayer(Other(You))]))]), ExileEachPermanent(HasTheMostVotesOrTiedForTheMostVotes)])",
    "Support {{Digits}}": "Targeted([UptoNumberTargetPermanents({{Digits[0]}}, IsCardtype(Creature))], ActionList([Support(Ref_TargetPermanents)]))",
    "Support {{Digits}}. {{Reminder}}\nChoose up to one target creature an opponent controls. Each creature you control with {{a}} {{CounterType}} counter on it deals damage equal to its power to that creature": "Targeted([UptoNumberTargetPermanents({{Digits[0]}}, IsCardtype(Creature)), TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(Opponent)]))], ActionList([Support(Ref_TargetPermanents), EachPermanentDealsDamage(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), HasACounterOfType({{CounterType[0]}})]), PowerOfPermanent(EachablePermanent), Permanent(Ref_TargetPermanent))]))",
    "Support {{Digits}}. {{Reminder}}\nDraw a card": "Targeted([UptoNumberTargetPermanents({{Digits[0]}}, IsCardtype(Creature))], ActionList([Support(Ref_TargetPermanents), DrawACard]))",
    "Support {{Digits}}. {{Reminder}}\nGain control of target {{Creature}} until end of turn. Untap that creature. It gains {{Hasable}} until end of turn": "Targeted([UptoNumberTargetPermanents({{Digits[0]}}, IsCardtype(Creature)), TargetPermanent({{Creature[0]}})], ActionList([Support(Ref_TargetPermanents), GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), UntapPermanent(Ref_TargetPermanent)]))",
    "Support {{Digits}}. {{Reminder}}\nUntap each {{Permanent}}": "Targeted([UptoNumberTargetPermanents({{Digits[0]}}, IsCardtype(Creature))], ActionList([Support(Ref_TargetPermanents), UntapEachPermanent({{Permanent[0]}})]))",
    "Surveil X, where X is {{GameNumber}}. Then draw {{Number}} cards": "ActionList([Surveil({{GameNumber[0]}}), DrawNumberCards({{Number[0]}})])",
    "Surveil {{Digits}}": "ActionList([Surveil({{Digits[0]}})])",
    "Surveil {{Digits}} if {{Condition}}. Then draw {{Number}} cards": "ActionList([If({{Condition[0]}}, [Surveil({{Digits[0]}})]), DrawNumberCards({{Number[0]}})])",
    "Surveil {{Digits}}, then choose {{a}} {{SpecificCard}} in your graveyard. You may cast it this turn. If that spell would be put into your graveyard, exile it instead": "ActionList([Surveil({{Digits[0]}}), ChooseACardInPlayersGraveyard({{SpecificCard[0]}}, You), CreatePlayerEffectUntil(You, [MayCastGraveyardCardIntoExile(TheChosenGraveyardCard)], UntilEndOfTurn)])",
    "Surveil {{Digits}}, then draw a card": "ActionList([Surveil({{Digits[0]}}), DrawACard])",
    "Surveil {{Digits}}, then draw a card. You may planeswalk": "ActionList([Surveil({{Digits[0]}}), DrawACard, MayAction(Planeswalk)])",
    "Surveil {{Digits}}, then draw {{Number}} cards": "ActionList([Surveil({{Digits[0]}}), DrawNumberCards({{Number[0]}})])",
    "Surveil {{Digits}}, then draw {{Number}} cards. You lose {{Digits}} life": "ActionList([Surveil({{Digits[0]}}), DrawNumberCards({{Number[0]}}), LoseLife({{Digits[0]}})])",
    "Surveil {{Digits}}, then return {{a}} {{SpecificCard}} from your graveyard to the battlefield": "ActionList([Surveil({{Digits[0]}}), ReturnACardFromGraveyardToBattlefield({{SpecificCard[0]}}, [EntersNormally])])",
    "Surveil {{Digits}}, then you draw a card and lose {{Digits}} life. {{Reminder}}\n{{AbilityWord}} - If {{Condition}}, draw another card": "ActionList([Surveil({{Digits[0]}}), DrawACard, LoseLife({{Digits[0]}}), If({{Condition[0]}}, [DrawACard])])",
    "Surveil {{Digits}}. You gain {{Digits}} life. If this spell was cast from a graveyard, exile it, then put it onto the battlefield transformed under its owner's control with {{a}} {{CounterType}} counter on it": "ActionList([Surveil({{Digits[0]}}), GainLife({{Digits[1]}}), If(SpellPassesFilter(ThisSpell, WasCastFromAPlayersGraveyard(AnyPlayer)), [ExileSpell(ThisSpell), PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersTransformed, EntersUnderOwnersControl, EntersWithACounter({{CounterType[0]}})])])])",
    "Surveil {{Digits}}. {{Reminder}}\nDraw a card": "ActionList([Surveil({{Digits[0]}}), DrawACard])",
    "Switch each creature's power and toughness until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil(IsCardtype(Creature), [SwitchPT], UntilEndOfTurn)])",
    "Switch target {{Creature}}'s power and toughness until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [SwitchPT], UntilEndOfTurn)]))",
    "Switch target {{Creature}}'s power and toughness until end of turn.\nDraw a card": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [SwitchPT], UntilEndOfTurn), DrawACard]))",
    "Switch the power and toughness of each of up to {{Number}} target {{Creatures}} until end of turn": "Targeted([UptoNumberTargetPermanents({{Number[0]}}, {{Creatures[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [SwitchPT], UntilEndOfTurn)]))",
    "Take an extra turn after this one": "ActionList([TakeAnExtraTurn])",
    "Take an extra turn after this one if {{Condition}}": "ActionList([If({{Condition[0]}}, [TakeAnExtraTurn])])",
    "Take an extra turn after this one. At the beginning of that turn's end step, you lose the game": "ActionList([TakeAnExtraTurn, CreateFutureTrigger(AtTheBeginningOfTheEndStepOfTheExtraTurnCreatedThisWay, ActionList([LoseTheGame]))])",
    "Take an extra turn after this one. Skip the untap step of that turn": "ActionList([TakeAnExtraTurnAndSkipUntapStepOfThatTurn])",
    "Tap all creatures blocking target attacking creature. Prevent all combat damage that would be dealt this turn by that creature and each creature blocking it": "Targeted([TargetPermanent(And([IsAttacking, IsCardtype(Creature)]))], ActionList([TapEachPermanent(And([IsCardtype(Creature), IsBlockingAttacker(Ref_TargetPermanent)])), CreatePreventDamageUntil(CombatDamageWouldBeDealtByACreature(Or([SinglePermanent(Ref_TargetPermanent), And([IsCardtype(Creature), IsBlockingAttacker(Ref_TargetPermanent)])])), [PreventThatDamage], UntilEndOfTurn)]))",
    "Tap all creatures target player controls. You may pay any amount of {{EnergyCounters}}. If you do, choose up to that many creatures tapped this way. Put {{a}} {{CounterType}} counter on each of them": "Targeted([TargetPlayer(AnyPlayer)], ActionList([TapEachPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))])), PayAnyAmountOfEnergy, ChooseUptoNumberPermanents(TheAmountOfEnergyPaidThisWay, ThePermanentsTappedThisWay), PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, ThePermanentsChosenThisWay)]))",
    "Tap all {{Creatures}} target player controls. Those creatures don't untap during that player's next untap step": "Targeted([TargetPlayer(AnyPlayer)], ActionList([TapEachPermanent(And([{{Creatures[0]}}, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))])), EachPermanentDoesntUntapDuringControllersNextUntap(ThePermanentsTappedThisWay)]))",
    "Tap all {{Creatures}}. Prevent all combat damage that would be dealt this turn. Each {{Creature}} and each {{Creature}} doesn't untap during its controller's next untap step": "ActionList([TapEachPermanent({{Creatures[0]}}), CreatePreventDamageUntil(CombatDamageWouldBeDealt, [PreventThatDamage], UntilEndOfTurn), EachPermanentDoesntUntapDuringControllersNextUntap(Or([{{Creature[0]}}, {{Creature[1]}}]))])",
    "Tap all {{Permanents}}": "ActionList([TapEachPermanent({{Permanents[0]}})])",
    "Tap all {{Permanents}} and untap all {{Permanents}}": "ActionList([TapEachPermanent({{Permanents[0]}}), UntapEachPermanent({{Permanents[0]}})])",
    "Tap all {{Permanents}} target player controls": "Targeted([TargetPlayer(AnyPlayer)], ActionList([TapEachPermanent(And([{{Permanents[0]}}, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]))]))",
    "Tap all {{Permanents}} target player controls and that player loses all unspent mana": "Targeted([TargetPlayer(AnyPlayer)], ActionList([TapEachPermanent(And([{{Permanents[0]}}, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))])), PlayerAction(Ref_TargetPlayer, LoseUnspentMana)]))",
    "Tap all {{Permanents}}. {{Permanents}} gain {{Hasable}} until end of turn": "ActionList([TapEachPermanent({{Permanents[0]}}), CreateEachPermanentLayerEffectUntil({{Permanents[1]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "Tap any number of untapped creatures you control. Create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}} for each creature tapped this way": "ActionList([TapAnyNumberOfPermanents(And([IsUntapped, IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))])), CreateTokens([NumberTokens(TheNumberOfPermanentsTappedThisWay, TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}]))])])",
    "Tap any number of untapped creatures you control. You gain {{Digits}} life for each creature tapped this way": "ActionList([TapAnyNumberOfPermanents(And([IsUntapped, IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))])), GainLifeForEach({{Digits[0]}}, TheNumberOfPermanentsTappedThisWay)])",
    "Tap one or two target {{Creatures}}. They each deal damage equal to their power to target {{Creature}}": "Targeted([OneOrTwoTargetPermanents({{Creatures[0]}}), TargetPermanent({{Creature[0]}})], ActionList([TapEachPermanent(Ref_TargetPermanents), EachPermanentDealsDamage(Ref_TargetPermanents, PowerOfPermanent(EachablePermanent), Permanent(Ref_TargetPermanent))]))",
    "Tap one or two target {{Permanents}}": "Targeted([OneOrTwoTargetPermanents({{Permanents[0]}})], ActionList([TapEachPermanent(Ref_TargetPermanents)]))",
    "Tap one or two target {{Permanents}}. Put {{a}} {{CounterType}} counter on each of them": "Targeted([OneOrTwoTargetPermanents({{Permanents[0]}})], ActionList([TapEachPermanent(Ref_TargetPermanents), PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, ThePermanentsTappedThisWay)]))",
    "Tap target {{Creature}}.\n{{AbilityWord}} - If {{Condition}}, exile that creature": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([IfElse({{Condition[0]}}, [ExilePermanent(Ref_TargetPermanent)], [TapPermanent(Ref_TargetPermanent)])]))",
    "Tap target {{Creature}}. If you do, add an amount of {{ManaProduceSymbol}} equal to {{GameNumber(ThatCreature)}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([MustCost(TapPermanent(Ref_TargetPermanent)), If(CostWasPaid, [AddManaRepeated({{ManaProduceSymbol[0]}}, {{GameNumber(ThatCreature=Ref_TargetPermanent)[0]}})])]))",
    "Tap target {{Creature}}. If you do, it deals damage equal to {{GameNumber(ThatCreature)}} to target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}}), TargetPermanent(And([Other(Ref_TargetPermanent1), {{Creature[1]}}]))], ActionList([MustCost(TapPermanent(Ref_TargetPermanent1)), If(CostWasPaid, [PermanentDealsDamage(Ref_TargetPermanent1, {{GameNumber(ThatCreature=Ref_TargetPermanent1)[0]}}, Permanent(Ref_TargetPermanent2))])]))",
    "Tap target {{Creature}}. It deals damage equal to {{GameNumber(ThatCreature)}} to another target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}}), TargetPermanent({{Creature[1]}})], ActionList([TapPermanent(Ref_TargetPermanent1), PermanentDealsDamage(Ref_TargetPermanent1, {{GameNumber(ThatCreature=Ref_TargetPermanent1)[0]}}, Permanent(Ref_TargetPermanent2))]))",
    "Tap target {{Creature}}. It deals damage equal to {{GameNumber(ThatCreature)}} to its controller": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), PermanentDealsDamage(Ref_TargetPermanent, {{GameNumber(ThatCreature=Ref_TargetPermanent)[0]}}, Player(ControllerOfPermanent(Ref_TargetPermanent)))]))",
    "Tap target {{Creature}}. Its controller mills {{Number}} cards. That creature doesn't untap during its controller's next untap step. {{Reminder}}\nDraw a card": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), PlayerAction(ControllerOfPermanent(Ref_TargetPermanent), MillNumberCards({{Number[0]}})), PermanentDoesntUntapDuringControllersNextUntap(Ref_TargetPermanent), DrawACard]))",
    "Tap target {{Creature}}. Prevent all combat damage that would be dealt by that creature this turn. It doesn't untap during its controller's next {{Number}} untap steps": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), CreatePreventDamageUntil(CombatDamageWouldBeDealtByCreature(Ref_TargetPermanent), [PreventThatDamage], UntilEndOfTurn), PermanentDoesntUntapDuringControllersNextNumberUntaps(Ref_TargetPermanent, {{Number[0]}})]))",
    "Tap target {{Creature}}. That creature deals damage equal to {{GameNumber(ThatCreature)}} to its controller": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), PermanentDealsDamage(Ref_TargetPermanent, {{GameNumber(ThatCreature=Ref_TargetPermanent)[0]}}, Player(ControllerOfPermanent(Ref_TargetPermanent)))]))",
    "Tap target {{Creature}}. That creature perpetually gains \"{{PerpetualQuotedAbility}}\" and \"{{PerpetualQuotedAbility}}\"": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), CreatePerpetualPermanentEffect(Ref_TargetPermanent, [AddAbility([{{PerpetualQuotedAbility[0]}}]), AddAbility([{{PerpetualQuotedAbility[1]}}])])]))",
    "Tap target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent)]))",
    "Tap target {{Permanent}} and put {{Number}} {{CounterType}} counters on it": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[0]}}, ThePermanentTappedThisWay)]))",
    "Tap target {{Permanent}} and put {{Number}} {{CounterType}} counters on it. Scry {{Digits}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[0]}}, ThePermanentTappedThisWay), Scry({{Digits[0]}})]))",
    "Tap target {{Permanent}} and put {{Number}} {{CounterType}} counters on it. {{Reminder}}\nScry {{Digits}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[0]}}, ThePermanentTappedThisWay), Scry({{Digits[0]}})]))",
    "Tap target {{Permanent}}, then put {{Number}} {{CounterType}} counters on it": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[0]}}, Ref_TargetPermanent)]))",
    "Tap target {{Permanent}}.\nDraw a card": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), DrawACard]))",
    "Tap target {{Permanent}}.\nDraw a card at the beginning of the next turn's upkeep": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), CreateFutureTrigger(AtTheBeginningOfTheNextTurnsUpkeep, ActionList([DrawACard]))]))",
    "Tap target {{Permanent}}. Create a Cursed Role token attached to it": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreateTokensWithFlags([CursedRoleToken], [EntersAttachedToPermanent(Ref_TargetPermanent)])]))",
    "Tap target {{Permanent}}. If {{Condition(ThatPermanent)}}, destroy it.\nDraw a card": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), If({{Condition(ThatPermanent=Ref_TargetPermanent)[0]}}, [DestroyPermanent(Ref_TargetPermanent)]), DrawACard]))",
    "Tap target {{Permanent}}. If {{Condition}}, put {{a}} {{CounterType}} counter on it. {{Reminder}}\nDraw a card": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), If({{Condition[0]}}, [PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent)]), DrawACard]))",
    "Tap target {{Permanent}}. It doesn't untap during its controller's next untap step": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), PermanentDoesntUntapDuringControllersNextUntap(Ref_TargetPermanent)]))",
    "Tap target {{Permanent}}. It doesn't untap during its controller's next untap step.\nDraw a card": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), PermanentDoesntUntapDuringControllersNextUntap(Ref_TargetPermanent), DrawACard]))",
