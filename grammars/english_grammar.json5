  "{{Line[ToSolve]}}": {
    "Creatures you control have total power {{Digits}} or greater": "TotalPowerOfPermanentsIs(GreaterThanOrEqualTo({{Digits[0]}}), And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))",
    "There are {{Number}} colors among permanents you control": "PlayerPassesFilter(You, ControlsNumColorsOfPermanents(EqualTo({{Number[0]}})))",
    "There are {{Number}} or more cards in your graveyard": "PlayerPassesFilter(You, NumCardsInGraveyardIs(GreaterThanOrEqualTo({{Number[0]}}), AnyCard))",
    "You control a legendary {{Zombie}}": "PlayerPassesFilter(You, ControlsA(And([IsSupertype(Legendary), IsCreatureType({{Zombie[0]}})])))",
    "You control no suspected {{Zombies}}": "PlayerPassesFilter(You, ControlsNo(And([IsSuspected, IsCreatureType({{Zombies[0]}})])))",
    "You control {{Number}} or more artifacts": "PlayerPassesFilter(You, ControlsNum(GreaterThanOrEqualTo({{Number[0]}}), IsCardtype(Artifact)))",
    "You control {{Number}} or more lands": "PlayerPassesFilter(You, ControlsNum(GreaterThanOrEqualTo({{Number[0]}}), IsCardtype(Land)))",
    "You control {{Number}} or more {{Zombies}}": "PlayerPassesFilter(You, ControlsNum(GreaterThanOrEqualTo({{Number[0]}}), IsCreatureType({{Zombies[0]}})))",
    "You have no cards in hand": "PlayerPassesFilter(You, NumCardsInHandIs(EqualTo(Integer(0))))",
    "You've cast {{Number}} or more instant and sorcery spells this turn": "PlayerPassesFilter(You, CastNumSpellsThisTurn(GreaterThanOrEqualTo({{Number[0]}}), Or([IsCardtype(Instant), IsCardtype(Sorcery)])))",
    "You've gained {{Digits}} or more life this turn": "PlayerPassesFilter(You, GainedLifeAmountThisTurn(GreaterThanOrEqualTo({{Digits[0]}})))",
    "{{Number}} or more creature cards were put into graveyards from anywhere this turn": "ANumberOfCardsWerePutIntoPlayersGraveyardFromAnywhereThisTurn(GreaterThanOrEqualTo({{Number[0]}}), IsCardtype(Creature), AnyPlayer)",
    "{{Number}} or more creatures are damaged": "NumPermanentsPassFilter(GreaterThanOrEqualTo({{Number[0]}}), IsCardtype(Creature), IsDamaged)",
    "{{Number}} or more creatures attacked this turn": "ANumberOfCreaturesAttackedThisTurn(GreaterThanOrEqualTo({{Number[0]}}), IsCardtype(Creature))",
    "{{Number}} or more sources you controlled dealt damage this turn": "ANumberOfSourcesDealtDamageThisTurn(GreaterThanOrEqualTo({{Number[0]}}), ControlledByAPlayer(SinglePlayer(You)))"
  },
