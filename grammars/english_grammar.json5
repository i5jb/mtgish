    "Search your library for up to {{Number}} {{SpecificCards}}, reveal them, then shuffle and put those cards on top in any order": "ActionList([SearchLibrary([FindNumberCardsOfType({{Number[0]}}, {{SpecificCards[0]}}), RevealFoundCards, SetAsideFoundCards, Shuffle, PutSetAsideCardsOnTopOfLibrary])])",
    "Search your library for up to {{Number}} {{SpecificCards}}, reveal those cards, and put one onto the battlefield tapped and the rest into your hand. Then shuffle.\n{{AbilityWord}} - If {{Condition}}, search your library for up to {{Number}} {{SpecificCards}} instead of {{Number}}": "ActionList([IfElse({{Condition[0]}}, [SearchLibrary([FindNumberCardsOfType({{Number[1]}}, {{SpecificCards[1]}}), RevealFoundCards, PutAFoundCardOntoBattlefield([EntersNormally]), PutFoundCardsIntoHand, Shuffle])], [SearchLibrary([FindNumberCardsOfType({{Number[0]}}, {{SpecificCards[0]}}), RevealFoundCards, PutAFoundCardOntoBattlefield([EntersNormally]), PutFoundCardsIntoHand, Shuffle])])])",
    "Search your library for up to {{Number}} {{SpecificCards}}, reveal those cards, put them into your hand, then shuffle": "ActionList([SearchLibrary([FindNumberCardsOfType({{Number[0]}}, {{SpecificCards[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])",
    "Search your library for up to {{Number}} {{SpecificCards}}. If {{Condition}}, instead search your library for up to {{Number}} {{SpecificCards}}. Reveal those cards, put them into your hand, then shuffle": "ActionList([IfElse({{Condition[0]}}, [SearchLibrary([FindNumberCardsOfType({{Number[1]}}, {{SpecificCards[1]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])], [SearchLibrary([FindNumberCardsOfType({{Number[0]}}, {{SpecificCards[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])])",
    "Search your library for {{Number}} cards and reveal them. Target opponent chooses one. Put that card into your hand and the rest into your graveyard. Then shuffle":
      "Targeted([TargetPlayer(Opponent)], ActionList([SearchLibrary([FindNumberGenericCards({{Number[0]}}), RevealFoundCards, APlayerChoosesAFoundCard(SinglePlayer(Ref_TargetPlayer)), PutChosenFoundCardsIntoHand, PutFoundCardsIntoGraveyard, Shuffle])]))",
    "Search your library for {{Number}} cards, exile them, then shuffle.\nDraw a card": "ActionList([SearchLibrary([FindNumberGenericCards({{Number[0]}}), ExileFoundCards, Shuffle]), DrawACard])",
    "Search your library for {{Number}} cards, exile them, then shuffle.\nDraw a card at the beginning of the next turn's upkeep": "ActionList([SearchLibrary([FindNumberGenericCards({{Number[0]}}), ExileFoundCards, Shuffle]), CreateFutureTrigger(AtTheBeginningOfTheNextTurnsUpkeep, ActionList([DrawACard]))])",
    "Search your library for {{Number}} {{SpecificCards}} and reveal them. If you reveal {{Number}} cards with different names, choose one of them at random and put that card into your hand. Shuffle the rest into your library":
      "ActionList([SearchLibrary([FindNumberGroupCards({{Number[0]}}, {{SpecificCards[0]}}, DifferentNames), RevealFoundCards, ChooseAFoundCardAtRandom, PutChosenFoundCardIntoHand, Shuffle])])",
    "Search your library for {{a}} {{LandCard}}, put it onto the battlefield tapped, then shuffle. That land becomes {{a}} {{PT}} {{Black}} and {{Black}} {{Zombie}} creature that's still a land. Put {{a}} {{CounterType}} counter on it for each {{Eachable}}": "ActionList([SearchLibrary([FindACardOfType({{LandCard[0]}}), PutFoundCardsOntoBattlefield([EntersTapped, EntersWithLayerEffect([SetPT({{PT[0]}}), SetColor(SimpleColorList([{{Black[0]}}, {{Black[1]}}])), AddCreatureType({{Zombie[0]}}), AddCardtype(Creature)])]), Shuffle]), PutNumberCountersOfTypeOnPermanent({{Eachable[0]}}, {{CounterType[0]}}, ThePermanentPutOnTheBattlefieldThisWay)])",
    "Search your library for {{a}} {{LandCard}}, put it onto the battlefield, then shuffle. Until end of turn, that land becomes {{a}} {{PT}} {{Zombie}} creature with {{Hasable}} and {{Hasable}}. It's still a land": "ActionList([SearchLibrary([FindACardOfType({{LandCard[0]}}), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle]), CreatePermanentLayerEffectUntil(ThePermanentPutOnTheBattlefieldThisWay, [SetPT({{PT[0]}}), AddCreatureType({{Zombie[0]}}), AddCardtype(Creature), AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)])",
    "Search your library for {{a}} {{SpecificCard}} and put it onto the battlefield tapped. Search your library and graveyard for {{a}} {{SpecificCard}}, reveal it, put it into your hand, then shuffle": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersTapped]), DontShuffle]), SearchLibraryAndGraveyard([FindACardOfType({{SpecificCard[1]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}} and put it onto the battlefield. Each opponent may search their library for {{a}} {{SpecificCard}} and put it onto the battlefield. For each opponent who searches a library this way, search your library for {{a}} {{SpecificCard}} and put it onto the battlefield. Then each player who searched a library this way shuffles": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersNormally]), DontShuffle]), EachPlayerMayCost(Opponent, SearchLibrary([FindACardOfType({{SpecificCard[1]}}), PutFoundCardsOntoBattlefield([EntersNormally]), DontShuffle])), SearchLibrary([FindNumberCardsOfType(TheNumberOfPlayersThatPaidCost, {{SpecificCard[2]}}), PutFoundCardsOntoBattlefield([EntersNormally]), DontShuffle]), EachPlayerAction(Or([SinglePlayer(You), PaidCost]), Shuffle)])",
    "Search your library for {{a}} {{SpecificCard}} and put that card onto the battlefield. Then shuffle": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}} and reveal it. Each opponent who cast a spell this turn with the same name as that card loses {{Digits}} life. Then shuffle":
      "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, EachPlayerLosesLife(And([Opponent, CastASpellThisTurn(SharesANameWithTheCardRevealedThisWay)]), {{Digits[0]}}), Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}} and reveal it. You may put that card onto the battlefield tapped if {{Condition}}. Otherwise, put that card into your hand. Then shuffle":
      "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, If({{Condition[0]}}, [MayPutFoundCardsOntoBattlefield([EntersTapped])]), PutFoundCardsIntoHand, Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}} and/or {{a}} {{SpecificCard}}, reveal them, put them into your hand, then shuffle": "ActionList([SearchLibrary([FindCardsOfType([{{SpecificCard[0]}}, {{SpecificCard[1]}}]), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}} or {{SpecificCard}}, put it onto the battlefield tapped, then shuffle. When you search your library this way, put {{a}} {{CounterType}} counter on target {{Permanent}}": "ActionList([MayCost(SearchLibrary([FindACardOfType(Or([{{SpecificCard[0]}}, {{SpecificCard[1]}}])), PutFoundCardsOntoBattlefield([EntersTapped]), Shuffle])), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent)])))])])",
    "Search your library for {{a}} {{SpecificCard}} or {{SpecificCard}}, reveal it, put it into your hand, then shuffle": "ActionList([SearchLibrary([FindACardOfType(Or([{{SpecificCard[0]}}, {{SpecificCard[1]}}])), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}} or {{a}} {{SpecificCard}}, put it onto the battlefield, then shuffle": "ActionList([SearchLibrary([FindACardOfType(Or([{{SpecificCard[0]}}, {{SpecificCard[1]}}])), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}} or {{a}} {{SpecificCard}}, reveal it, put it into your hand, then shuffle": "ActionList([SearchLibrary([FindACardOfType(Or([{{SpecificCard[0]}}, {{SpecificCard[1]}}])), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])",
