    "Whenever equipped creature blocks or becomes blocked by one or more {{Creatures}}, {{TriggerActions(ThosePermanents)}}": "TriggerA(Or([WhenACreatureBlocksAnyNumberOfCreatures(SinglePermanent(HostPermanent), {{Creatures[0]}}), WhenACreatureBecomesBlockedByAnyNumberOfCreatures(SinglePermanent(HostPermanent), {{Creatures[0]}})]), {{TriggerActions(ThosePermanents=Trigger_ThoseCreatures)[0]}})",
    "Whenever equipped creature blocks or becomes blocked by {{a}} {{Creature}}, destroy both creatures": "TriggerA(WhenACreatureBlocksACreature(SinglePermanent(HostPermanent), {{Creature[0]}}), ActionList([DestroyEachPermanent(Or([SinglePermanent(Trigger_TheAttackingCreature), SinglePermanent(Trigger_TheBlockingCreature)]))])), TriggerA(WhenACreatureBecomesBlockedByACreature(SinglePermanent(HostPermanent), {{Creature[0]}}), ActionList([DestroyEachPermanent(Or([SinglePermanent(Trigger_TheAttackingCreature), SinglePermanent(Trigger_TheBlockingCreature)]))]))",
    "Whenever equipped creature blocks or becomes blocked by {{a}} {{Creature}}, {{TriggerActions(ThatCreature)}}": "TriggerA(WhenACreatureBlocksACreature(SinglePermanent(HostPermanent), {{Creature[0]}}), {{TriggerActions(ThatCreature=Trigger_ThatCreature)[0]}}), TriggerA(WhenACreatureBecomesBlockedByACreature(SinglePermanent(HostPermanent), {{Creature[0]}}), {{TriggerActions(ThatCreature=Trigger_TheAttackingCreature)[0]}})",
    "Whenever equipped creature blocks {{a}} {{Creature}}, {{TriggerActions(ThatCreature)}}": "TriggerA(WhenACreatureBlocksACreature(SinglePermanent(HostPermanent), {{Creature[0]}}), {{TriggerActions(ThatCreature=Trigger_ThatOtherCreature)[0]}})",
    "Whenever equipped creature deals combat damage to a player or battle, {{TriggerActions}}": "TriggerA(Or([WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(HostPermanent), AnyPlayer), WhenACreatureDealsCombatDamageToAPermanent(SinglePermanent(HostPermanent), IsCardtype(Battle))]), {{TriggerActions[0]}})",
