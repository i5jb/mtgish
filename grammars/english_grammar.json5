    "Look at target opponent's hand and choose X cards from it. That player discards those cards": "Targeted([TargetPlayer(Opponent)], ActionList([LookAtPlayersHandAndChooseNumCardsToDiscard(Ref_TargetPlayer, {{X}}, AnyCard)]))",
    "Look at target player's hand and choose X cards from it. That player discards those cards": "Targeted([TargetPlayer(AnyPlayer)], ActionList([LookAtPlayersHandAndChooseNumCardsToDiscard(Ref_TargetPlayer, {{X}}, AnyCard)]))",
    "Look at the top X cards of target opponent's library. Exile one of those cards and put the rest back on top of that player's library in any order": "Targeted([TargetPlayer(Opponent)], ActionList([LookAtTheTopNumberCardsOfPlayersLibrary(Ref_TargetPlayer, {{X}}, [ExileAGenericCard, PutTheRemainingCardsOnTopOfLibraryInAnyOrder])]))",
    "Look at the top X cards of your library. Put one of them into your hand and the rest on the bottom of your library in any order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{X}}, [PutAGenericCardIntoHand, PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder])])",
    "Look at the top X cards of your library. Put up to {{Number}} of them into your hand and the rest on the bottom of your library in a random order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{X}}, [PutNumberGenericCardsIntoHand({{Number[0]}}), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "Look at the top X cards of your library. You may put any number of land and/or legendary permanent cards with mana value X or less from among them onto the battlefield. Put the rest into your graveyard": "ActionList([LookAtTheTopNumberCardsOfLibrary({{X}}, [MayPutAnyNumberOfCardsOntoTheBattlefield(Or([IsCardtype(Land), And([IsSupertype(Legendary), IsPermanent, ManaValueIs(LessThanOrEqualTo({{X}}))])]), [EntersNormally]), PutTheRemainingCardsIntoGraveyard])])",
    "Look at the top {{Number}} cards of your library. Put up to X {{PermanentCards}} from among them onto the battlefield. Put the rest on the bottom of your library in a random order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [MayPutUptoNumberCardsOntoTheBattlefield({{X}}, {{PermanentCards[0]}}, [EntersNormally]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "Look at twice X cards from the top of your library. Put X cards from among them into your hand and the rest into your graveyard. You lose X life": "ActionList([LookAtTheTopNumberCardsOfLibrary(Twice({{X}}), [PutNumberGenericCardsIntoHand({{X}}), PutTheRemainingCardsIntoGraveyard]), LoseLife({{X}})])",
    "Manifest dread X times, then put X {{CounterType}} counters on each of those creatures": "ActionList([ManifestDreadNumberTimes({{X}}), PutNumberCountersOfTypeOnEachPermanent({{X}}, {{CounterType[0]}}, ThePermanentsPutOnTheBattlefieldThisWay)])",
    "Manifest the top card of your library, then put X {{CounterType}} counters on it": "ActionList([ManifestTheTopCardOfPlayersLibrary(You), PutNumberCountersOfTypeOnPermanent({{X}}, {{CounterType[0]}}, ThePermanentPutOnTheBattlefieldThisWay)])",
    "Mill X cards. Target player loses {{Digits}} life for each {{SpecificCard}} put into your graveyard this way": "Targeted([TargetPlayer(AnyPlayer)], ActionList([MillNumberCards({{X}}), PlayerAction(Ref_TargetPlayer, LoseLifeForEach({{Digits[0]}}, NumCardsMilledThisWay({{SpecificCard[0]}})))]))",
    "Populate X times": "ActionList([PopulateNumberTimes({{X}})])",
    "Prevent all combat damage X target {{Creatures}} would deal this turn": "Targeted([NumberTargetPermanents({{X}}, {{Creatures[0]}})], ActionList([CreatePreventDamageUntil(CombatDamageWouldBeDealtByACreature(Ref_TargetPermanents), [PreventThatDamage], UntilEndOfTurn)]))",
    "Prevent the next X damage that would be dealt to any target this turn": "Targeted([AnyTarget], ActionList([CreateFuturePreventDamage(NextAmountOfDamageThatWouldBeDealtThisTurnToRecipient({{X}}, Ref_AnyTarget), [PreventThatDamage])]))",
    "Prevent the next X damage that would be dealt to any target this turn. Until end of turn, you may pay {{ManaCost}} any time you could cast an instant. If you do, prevent the next {{Digits}} damage that would be dealt to that permanent or player this turn": "Targeted([AnyTarget], ActionList([CreateFuturePreventDamage(NextAmountOfDamageThatWouldBeDealtThisTurnToRecipient({{X}}, Ref_AnyTarget), [PreventThatDamage]), CreatePlayerEffectUntil(You, [MayPayManaAnyTimeTheyCouldCastAnInstant({{ManaCost[0]}}, [CreateFuturePreventDamage(NextAmountOfDamageThatWouldBeDealtThisTurnToRecipient({{Digits[0]}}, Ref_AnyTarget), [PreventThatDamage])])], UntilEndOfTurn)]))",
    "Prevent the next X damage that would be dealt to target {{Creature}} this turn. For each 1 damage prevented this way, put {{a}} {{CounterType}} counter on that creature": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreateFuturePreventDamage(NextAmountOfDamageThatWouldBeDealtThisTurnToRecipient({{X}}, Permanent(Ref_TargetPermanent)), [PreventThatDamage, PutNumberCountersOfTypeOnPermanent(TheAmountOfDamagePreventedThisWay, {{CounterType[0]}}, Ref_TargetPermanent)])]))",
    "Prevent the next X damage that would be dealt to you this turn.\nDraw a card": "ActionList([CreateFuturePreventDamage(NextAmountOfDamageThatWouldBeDealtThisTurnToRecipient({{X}}, Player(You)), [PreventThatDamage]), DrawACard])",
    "Proliferate X times": "ActionList([ProliferateNumberTimes({{X}})])",
    "Put X {{CounterType}} counters on target {{Permanent}} or suspended card": "Targeted_Modal([Targeted([TargetPermanent(AnyPermanent)], ActionList([PutNumberCountersOfTypeOnPermanent(ValueX, TimeCounter, Ref_TargetPermanent)])), Targeted([TargetExiledCard(IsSuspended)], ActionList([PutNumberCountersOfTypeOnExiledCard(ValueX, TimeCounter, Ref_TargetExiledCard)]))])",
    "Put X {{CounterType}} counters on target {{Permanent}}. If {{Condition(ThatPermanent)}}, it becomes {{a}} {{PT}} {{Zombie}} artifact creature": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutNumberCountersOfTypeOnPermanent({{X}}, {{CounterType[0]}}, Ref_TargetPermanent), If({{Condition(ThatPermanent=Ref_TargetPermanent)[0]}}, [CreatePermanentLayerEffect(Ref_TargetPermanent, [SetPT({{PT[0]}}), AddCreatureType({{Zombie[0]}}), AddCardtype(Artifact), AddCardtype(Creature)])])]))",
    "Put X {{CounterType}} counters on target {{Permanent}}. Then counter up to one target {{Spell}} unless its controller pays mana equal to {{GameNumber}}": "Targeted([TargetPermanent({{Permanent[0]}}), UptoOneTargetSpell({{Spell[0]}})], ActionList([PutNumberCountersOfTypeOnPermanent({{X}}, {{CounterType[0]}}, Ref_TargetPermanent), PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), PayManaForEach([ManaCostGeneric(1)], {{GameNumber[0]}})), Unless(CostWasPaid, [CounterSpell(Ref_TargetSpell)])]))",
    "Put a random creature card with mana value X or less from target opponent's library onto the battlefield under your control. It perpetually has base power and toughness {{PTX}} and perpetually gains ward {{ManaCost}}": "Targeted([TargetPlayer(Opponent)], ActionList([PutARandomCardFromPlayersLibraryOntoBattlefield(And([IsCardtype(Creature), ManaValueIs(LessThanOrEqualTo({{X}}))]), Ref_TargetPlayer, [EntersUnderPlayersControl(You), EntersWithPerpetualEffect([SetPT(PTX({{PTX[0]}}, {{X}})), AddAbility([Ward(PayMana({{ManaCost[0]}}))])])])]))",
    "Put target {{Permanent}} into its owner's library just beneath the top X cards of that library": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutPermanentInOwnersLibraryBeneathNumberCards(Ref_TargetPermanent, {{X}})]))",
    "Put {{Number}} {{CounterType}} counters on each of X target {{Lands}}. They each become {{PT}} {{Zombie}} creatures with {{Hasable}}, {{Hasable}}, and \"{{QuotedAbility}}\". They're still lands": "Targeted([NumberTargetPermanents({{X}}, {{Lands[0]}})], ActionList([PutNumberCountersOfTypeOnEachPermanent({{Number[0]}}, {{CounterType[0]}}, Ref_TargetPermanents), CreateEachPermanentLayerEffect(Ref_TargetPermanents, [SetPT({{PT[0]}}), AddCreatureType({{Zombie[0]}}), AddCardtype(Creature), AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}]), AddAbility([{{QuotedAbility[0]}}])])]))",
    "Put {{a}} {{CounterType}} counter on each of X target {{Permanents}}": "Targeted([NumberTargetPermanents({{X}}, {{Permanents[0]}})], ActionList([PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, Ref_TargetPermanents)]))",
    "Put {{a}} {{CounterType}} counter on each of up to X target creatures. Those creatures gain {{Hasable}} until end of turn. Draw a card": "Targeted([UptoNumberTargetPermanents({{X}}, IsCardtype(Creature))], ActionList([PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, Ref_TargetPermanents), CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), DrawACard]))",
    "Put {{a}} {{CounterType}} counter on each of up to X target {{Permanents}}.\n{{Permanents}} gain {{Hasable}} until end of turn": "Targeted([UptoNumberTargetPermanents({{X}}, {{Permanents[0]}})], ActionList([PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, Ref_TargetPermanents), CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Remove X {{CounterType}} counters from target {{Permanent}} or suspended card": "Targeted_Modal([Targeted([TargetPermanent({{Permanent[0]}})], ActionList([RemoveNumberCountersOfTypeFromPermanent({{X}}, {{CounterType[0]}}, Ref_TargetPermanent)])), Targeted([TargetExiledCard(IsSuspended)], ActionList([RemoveNumberCountersOfTypeOnExiledCard({{X}}, {{CounterType[0]}}, Ref_TargetExiledCard)]))])",
    "Remove twice X {{CounterType}} counters from target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([RemoveNumberCountersOfTypeFromPermanent(Twice({{X}}), {{CounterType[0]}}, Ref_TargetPermanent)]))",
    "Repeat the following process X times. Each opponent loses {{Digits}} life unless that player sacrifices {{a}} {{Permanent}} of their choice or discards a card": "ActionList([RepeatableActionsNumTimes({{X}}, [EachPlayerMayCost(Opponent, Or([SacrificeAPermanent({{Permanent[0]}}), DiscardACard])), EachPlayerAction(DidntPayCost, LoseLife({{Digits[0]}})), RepeatThisProcess])])",
    "Return X target creatures of the creature type of your choice to their owner's hand": "Targeted([NumberTargetGroupPermanents({{X}}, IsCardtype(Creature), ShareACreatureTypeOfChoice)], ActionList([PutEachPermanentIntoItsOwnersHand(Ref_TargetPermanents)]))",
    "Return X target {{CreatureCards}} from your graveyard to the battlefield. Sacrifice those creatures at the beginning of the next end step": "Targeted([NumberTargetGraveyardCards({{X}}, And([{{CreatureCards[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([ReturnEachGraveyardCardToBattlefield(Ref_TargetGraveyardCards, [EntersNormally]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([SacrificeEachPermanent(ThePermanentsPutOnTheBattlefieldThisWay)]))]))",
    "Return X target {{Permanents}} to their owners' hands": "Targeted([NumberTargetPermanents({{X}}, {{Permanents[0]}})], ActionList([PutEachPermanentIntoItsOwnersHand(Ref_TargetPermanents)]))",
    "Return X target {{SpecificCards}} from your graveyard to the battlefield": "Targeted([NumberTargetGraveyardCards({{X}}, And([{{SpecificCards[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([ReturnEachGraveyardCardToBattlefield(Ref_TargetGraveyardCards, [EntersNormally])]))",
    "Return X target {{SpecificCards}} from your graveyard to your hand": "Targeted([NumberTargetGraveyardCards({{X}}, And([{{SpecificCards[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutEachGraveyardCardIntoHand(Ref_TargetGraveyardCards)]))",
    "Return X target {{SpecificCards}} from your graveyard to your hand. You lose X life": "Targeted([NumberTargetGraveyardCards({{X}}, And([{{SpecificCards[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutEachGraveyardCardIntoHand(Ref_TargetGraveyardCards), LoseLife({{X}})]))",
    "Return all nonland permanents with mana value X or less to their owners' hands": "ActionList([PutEachPermanentIntoItsOwnersHand(And([IsNonCardtype(Land), ManaValueIs(LessThanOrEqualTo({{X}}))]))])",
    "Return each creature card with mana value X from your graveyard to the battlefield": "ActionList([ReturnEachCardFromPlayersGraveyardToBattlefield(And([IsCardtype(Creature), ManaValueIs(EqualTo({{X}}))]), You, [EntersNormally])])",
    "Return from your graveyard to the battlefield any number of target creature cards that each have a different mana value X or less": "Targeted([AnyNumberOfTargetGroupGraveyardCards(And([IsCardtype(Creature), ManaValueIs(LessThanOrEqualTo({{X}})), InAPlayersGraveyard(SinglePlayer(You))]), DifferentManaValues)], ActionList([ReturnEachGraveyardCardToBattlefield(Ref_TargetGraveyardCards, [EntersNormally])]))",
    "Return target creature card with mana value X from your graveyard to the battlefield. It gains {{Hasable}}. Exile it at the beginning of the next end step": "Targeted([TargetGraveyardCard(And([IsCardtype(Creature), ManaValueIs(EqualTo({{X}})), InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersNormally]), CreatePermanentLayerEffect(ThePermanentPutOnTheBattlefieldThisWay, [AddAbility([{{Hasable[0]}}])]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([ExilePermanent(ThePermanentPutOnTheBattlefieldThisWay)]))]))",
    "Return target creature card with mana value X or less from your graveyard to the battlefield": "Targeted([TargetGraveyardCard(And([IsCardtype(Creature), ManaValueIs(LessThanOrEqualTo({{X}})), InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersNormally])]))",
    "Return target creature with mana value X to its owner's hand. You create X {{PT}} {{CreatureTokens}} with {{Hasable}}": "Targeted([TargetPermanent(And([IsCardtype(Creature), ManaValueIs(EqualTo({{X}}))]))], ActionList([PutPermanentIntoItsOwnersHand(Ref_TargetPermanent), CreateTokens([NumberTokens({{X}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}]))])]))",
    "Return target planeswalker card with mana value X or less from your graveyard to the battlefield": "Targeted([TargetGraveyardCard(And([IsCardtype(Planeswalker), ManaValueIs(LessThanOrEqualTo({{X}})), InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersNormally])]))",
    "Return target {{Permanent}} with mana value X to its owner's hand.\nDraw a card": "Targeted([TargetPermanent(And([{{Permanent[0]}}, ManaValueIs(EqualTo({{X}}))]))], ActionList([PutPermanentIntoItsOwnersHand(Ref_TargetPermanent), DrawACard]))",
    "Return target {{SpecificCard}} from your graveyard to the battlefield with X additional {{CounterType}} counters on it. It's {{a}} {{PT}} {{Zombie}} creature with {{Hasable}} in addition to its other types": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersWithNumberCounters({{X}}, {{CounterType[0]}}), EntersWithLayerEffect([SetPT({{PT[0]}}), AddCreatureType({{Zombie[0]}}), AddCardtype(Creature), AddAbility([{{Hasable[0]}}])])])]))",
    "Return up to X target artifact and/or non-Aura enchantment cards each with mana value X or less from your graveyard to the battlefield. If X is {{Digits}} or more, those permanents are {{PT}} creatures in addition to their other types": "Targeted([UptoNumberTargetGraveyardCards({{X}}, And([Or([IsCardtype(Artifact), And([IsNonEnchantmentType(Aura), IsCardtype(Enchantment)])]), ManaValueIs(LessThanOrEqualTo({{X}})), InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([IfElse(SpellXIs(GreaterThanOrEqualTo({{Digits[0]}})), [ReturnEachGraveyardCardToBattlefield(Ref_TargetGraveyardCards, [EntersWithLayerEffect([SetPT({{PT[0]}}), AddCardtype(Creature)])])], [ReturnEachGraveyardCardToBattlefield(Ref_TargetGraveyardCards, [EntersNormally])])]))",
    "Return {{Number}} target {{SpecificCards}} from your graveyard to your hand unless any player pays {{ManaCostX}}": "Targeted([NumberTargetGraveyardCards({{Number[0]}}, And([{{SpecificCards[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([AnyPlayerMayCost(AnyPlayer, PayManaX({{ManaCostX[0]}}, {{X}})), Unless(CostWasPaid, [PutEachGraveyardCardIntoHand(Ref_TargetGraveyardCards)])]))",
    "Reveal cards from the top of your library until you reveal X land cards. Put those land cards onto the battlefield tapped and the rest on the bottom of your library in a random order": "ActionList([RevealCardsFromTheTopOfLibraryUntilANumberOfCardsOfTypeAreRevealed({{X}}, IsCardtype(Land), [PutTheCardsFoundThisWayOntoTheBattlefield([EntersTapped]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "Reveal the top X cards of your library. For each card type, you may exile a card of that type from among them. Put the rest into your graveyard. You may cast a spell from among the exiled cards without paying its mana cost if you exiled {{Number}} or more cards this way. Then put the rest of the exiled cards into your hand": "ActionList([RevealTheTopNumberCardsOfLibrary({{X}}, [MayExileACardOfEachCardType, PutTheRemainingCardsIntoGraveyard]), If(ANumberOfCardsWereExildThisWay(GreaterThanOrEqualTo({{Number[0]}}), AnyCard), [MayAction(CastASpellFromExileWithoutPaying(AnySpell, TheCardsExiledThisWay))]), PutExiledCardsIntoOwnersHand(TheCardsExiledThisWay)])",
    "Reveal the top X cards of your library. Put all {{SpecificCards}} from among them onto the battlefield tapped and the rest on the bottom of your library in a random order.\n{{AbilityWord}} - If {{Condition}}, untap those {{Permanents}}": "ActionList([RevealTheTopNumberCardsOfLibrary({{X}}, [PutEachCardOfTypeOntoTheBattlefield({{SpecificCards[0]}}, [EntersTapped]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder]), If({{Condition[0]}}, [UntapEachPermanent(ThePermanentsPutOnTheBattlefieldThisWay)])])",
    "Reveal the top X cards of your library. Put all {{SpecificCards}} revealed this way into your hand and the rest on the bottom of your library in any order": "ActionList([RevealTheTopNumberCardsOfLibrary({{X}}, [PutEachCardOfTypeIntoHand({{SpecificCards[0]}}), PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder])])",
    "Reveal the top X cards of your library. You may put any number of artifact cards with mana value X or less from among them onto the battlefield. Then put all cards revealed this way that weren't put onto the battlefield into your graveyard": "ActionList([RevealTheTopNumberCardsOfLibrary({{X}}, [MayPutAnyNumberOfCardsOfTypeOntoTheBattlefield(And([IsCardtype(Artifact), ManaValueIs(LessThanOrEqualTo({{X}}))]), [EntersNormally]), PutTheRemainingCardsIntoGraveyard])])",
    "Reveal the top X cards of your library. You may put any number of permanent cards with mana value X or less from among them onto the battlefield. Then put all cards revealed this way that weren't put onto the battlefield into your graveyard": "ActionList([RevealTheTopNumberCardsOfLibrary({{X}}, [MayPutAnyNumberOfCardsOfTypeOntoTheBattlefield(And([IsPermanent, ManaValueIs(LessThanOrEqualTo({{X}}))]), [EntersNormally]), PutTheRemainingCardsIntoGraveyard])])",
    "Reveal the top X plus {{Number}} cards of your library and separate them into two piles. An opponent chooses one of those piles. Put that pile into your hand and the other into your graveyard": "ActionList([RevealTheTopNumberCardsOfLibrary(Plus({{X}}, {{Number[0]}}), [SeperateThoseCardsIntoTwoPiles, APlayerChoosesAPile(Opponent), PutTheChosenPileIntoHand, PutTheRemainingCardsIntoGraveyard])])",
    "Reveal the top X plus {{Number}} cards of your library. Choose {{a}} {{SpecificCard}} and/or {{a}} {{SpecificCard}} from among them. Put those cards into your hand and the rest on the bottom of your library in a random order. If X is {{Digits}} or more, instead put the chosen cards onto the battlefield or into your hand and the rest on the bottom of your library in a random order": "ActionList([IfElse(SpellXIs(GreaterThanOrEqualTo({{Digits[0]}})), [RevealTheTopNumberCardsOfLibrary(Plus({{X}}, {{Number[0]}}), [MayPutMultipleCardsOfTypeIntoHandOrOntoTheBattlefield([{{SpecificCard[0]}}, {{SpecificCard[1]}}], [EntersNormally]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])], [RevealTheTopNumberCardsOfLibrary(Plus({{X}}, {{Number[0]}}), [MayPutMultipleCardsOfTypeIntoHand([{{SpecificCard[0]}}, {{SpecificCard[1]}}]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])])",
    "Roll a d20 and add {{GameNumber}}.\n{{RawDigits}}-{{RawDigits}} | Draw X cards.\n{{RawDigits}}+ | Scry X, then draw X cards": "ActionList([RollAD20, ValueActions(Plus(TheDiceResult, {{GameNumber[0]}}), [ValueAction(BetweenValues({{RawDigits[0]}}, {{RawDigits[1]}}), [DrawNumberCards({{X}})]), ValueAction(ValueOrBigger({{RawDigits[2]}}), [Scry({{X}}), DrawNumberCards({{X}})])])])",
    "Sacrifice X lands. For each land sacrificed this way, draw a card. You may play X additional lands this turn. {{Permanents}} enter tapped this turn": "ActionList([SacrificeNumberPermanents({{X}}, IsCardtype(Land)), DrawNumberCards(TheNumberOfPermanentsSacrificedThisWay), CreatePlayerEffectUntil(You, [MayPlayAdditionalLands({{X}})], UntilEndOfTurn), CreateReplaceWouldEnterUntil(APermanentWouldEnterTheBattlefield({{Permanents[0]}}), [EntersTapped], UntilEndOfTurn)])",
    "Sacrifice X {{Zombies}}, then reveal cards from the top of your library until you reveal a number of {{Zombie}} creature cards equal to the number of {{Zombies}} sacrificed this way. Put those cards onto the battlefield and the rest on the bottom of your library in a random order": "ActionList([SacrificeNumberPermanents({{X}}, IsCreatureType({{Zombies[0]}})), RevealCardsFromTheTopOfLibraryUntilANumberOfCardsOfTypeAreRevealed(TheNumberOfPermanentsSacrificedThisWay, And([IsCreatureType({{Zombie[0]}}), IsCardtype(Creature)]), [PutTheCardsFoundThisWayOntoTheBattlefield([EntersNormally]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "Search your library and/or graveyard for a creature card with mana value X or less and put it onto the battlefield. If you search your library this way, shuffle. If X is {{Digits}} or more, {{Creatures}} get {{PTModX}} and gain {{Hasable}} until end of turn": "ActionList([SearchLibraryAndOrGraveyard([FindACardOfType(And([IsCardtype(Creature), ManaValueIs(LessThanOrEqualTo({{X}}))])), PutFoundCardsOntoBattlefield([EntersNormally]), ShuffleLibraryIfSearched]), If(SpellXIs(GreaterThanOrEqualTo({{Digits[0]}})), [CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPTX({{PTModX[0]}}, {{X}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])])",
    "Search your library for X cards, then shuffle and put those cards on top in any order":
      "ActionList([SearchLibrary([FindNumberGenericCards({{X}}), SetAsideFoundCards, Shuffle, PutSetAsideCardsOnTopOfLibrary])])",
    "Search your library for a creature card with mana value X or less, put it onto the battlefield, then shuffle": "ActionList([SearchLibrary([FindACardOfType(And([IsCardtype(Creature), ManaValueIs(LessThanOrEqualTo({{X}}))])), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle])])",
    "Search your library for a permanent card with mana value X or less, put it onto the battlefield, then shuffle": "ActionList([SearchLibrary([FindACardOfType(And([IsPermanent, ManaValueIs(LessThanOrEqualTo({{X}}))])), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle])])",
    "Search your library for an artifact card with mana value X or less, put it onto the battlefield, then shuffle": "ActionList([SearchLibrary([FindACardOfType(And([IsCardtype(Artifact), ManaValueIs(LessThanOrEqualTo({{X}}))])), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle])])",
    "Search your library for up to X cards, put those cards into your hand, then shuffle": "ActionList([SearchLibrary([FindUptoNumberGenericCards({{X}}), PutFoundCardsIntoHand, Shuffle])])",
    "Search your library for up to X creature cards with different names that each have mana value X, reveal them, put them into your hand, then shuffle": "ActionList([SearchLibrary([FindNumberGroupCards({{X}}, And([IsCardtype(Creature), ManaValueIs(EqualTo({{X}}))]), DifferentNames), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])",
    "Search your library for up to X {{SpecificCards}} with different names, put them onto the battlefield, then shuffle": "ActionList([SearchLibrary([FindNumberGroupCards({{X}}, {{SpecificCards[0]}}, DifferentNames), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle])])",
    "Search your library for up to X {{SpecificCards}}, reveal them, put them into your hand, then shuffle": "ActionList([SearchLibrary([FindNumberCardsOfType({{X}}, {{SpecificCards[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])",
    "Seek {{a}} {{SpecificCard}} with mana value X or less and put it onto the battlefield. If a card with mana value less than X is put onto the battlefield this way, this spell perpetually gains \"{{PerpetualQuotedAbility}}\", then return this spell to its owner's hand": "ActionList([SeekACard(And([{{SpecificCard[0]}}, ManaValueIs(LessThanOrEqualTo({{X}}))])), PutCardFromHandOnBattlefield(TheCardSeekedThisWay, [EntersNormally]), If(APermanentWasPutOntoTheBattlefieldThisWay(ManaValueIs(LessThan({{X}}))), [CreatePerpetualSpellEffect(ThisSpell, [AddAbility([{{PerpetualQuotedAbility[0]}}])]), ReturnSpellToOwnersHand(ThisSpell)])])",
    "Support X. {{Reminder}}\nEach {{Permanent}} gains {{Hasable}} until end of turn": "Targeted([UptoNumberTargetPermanents({{X}}, IsCardtype(Creature))], ActionList([Support(Ref_TargetPermanents), CreateEachPermanentLayerEffectUntil({{Permanent[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Tap X target {{Creatures}}.\n{{AbilityWord}} - If {{Condition}}, those creatures don't untap during their controllers' next untap steps": "Targeted([NumberTargetPermanents({{X}}, {{Creatures[0]}})], ActionList([TapEachPermanent(Ref_TargetPermanents), If({{Condition[0]}}, [EachPermanentDoesntUntapDuringControllersNextUntap(Ref_TargetPermanents)])]))",
    "Tap X target {{Permanents}}": "Targeted([NumberTargetPermanents({{X}}, {{Permanents[0]}})], ActionList([TapEachPermanent(Ref_TargetPermanents)]))",
    "Tap X target {{Permanents}}. Scry {{Digits}}": "Targeted([NumberTargetPermanents({{X}}, {{Permanents[0]}})], ActionList([TapEachPermanent(Ref_TargetPermanents), Scry({{Digits[0]}})]))",
    "Tap X target {{Permanents}}. They don't untap during their controllers' next untap steps": "Targeted([NumberTargetPermanents({{X}}, {{Permanents[0]}})], ActionList([TapEachPermanent(Ref_TargetPermanents), EachPermanentDoesntUntapDuringControllersNextUntap(Ref_TargetPermanents)]))",
    "Tap X target {{Permanents}}. You lose X life": "Targeted([NumberTargetPermanents({{X}}, {{Permanents[0]}})], ActionList([TapEachPermanent(Ref_TargetPermanents), LoseLife({{X}})]))",
    "Tap target {{Permanent}}. Put twice X {{CounterType}} counters on it": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), PutNumberCountersOfTypeOnPermanent(Twice({{X}}), {{CounterType[0]}}, Ref_TargetPermanent)]))",
    "Target opponent chooses X cards from their hand. Look at those cards. You may cast a spell from among them without paying its mana cost": "Targeted([TargetPlayer(Opponent)], ActionList([PlayerAction(Ref_TargetPlayer, RevealANumberOfCardsFromHandAndPlayerMayCastASpellFromAmongThemWithoutPaying({{X}}, You, AnySpell))]))",
    "Target opponent exiles the top X cards of their library face down. You may look at and play those cards for as long as they remain exiled. If you cast a spell this way, you may spend mana as though it were mana of any type to cast it": "Targeted([TargetPlayer(Opponent)], ActionList([PlayerAction(Ref_TargetPlayer, ExileTheTopNumberCardsOfLibraryFaceDown({{X}})), CreatePlayerEffectUntil(You, [MayLookAtFaceDownExiledCards(TheCardsExiledThisWay), MayPlayExiledCardsAndMaySpendManaAsThoughAnyTypeToCast(TheCardsExiledThisWay)], UntilCardsAreNoLongerExiled(TheCardsExiledThisWay))]))",
    "Target opponent exiles the top X cards of their library. You may cast any number of spells with mana value X or less from among them without paying their mana costs": "Targeted([TargetPlayer(Opponent)], ActionList([PlayerAction(Ref_TargetPlayer, ExileTheTopNumberCardsOfLibrary({{X}})), CastAnyNumberOfSpellsFromExileWithoutPaying(ManaValueIs(LessThanOrEqualTo({{X}})), TheCardsExiledThisWay)]))",
    "Target opponent reveals their hand. You choose up to X {{SpecificCards}} from it and exile them. For each card exiled this way, search that player's graveyard, hand, and library for any number of cards with the same name as that card and exile them. Then that player shuffles": "Targeted([TargetPlayer(Opponent)], ActionList([PlayerAction(Ref_TargetPlayer, RevealHandAndPlayerChoosesNumberCardsToExile(You, {{X}}, {{SpecificCards[0]}})), SearchPlayersLibraryAndGraveyardAndHand(Ref_TargetPlayer, [FindAnyNumberOfCardsOfType(SharesANameWithAnExiled(TheCardsExiledThisWay)), ExileFoundCards, Shuffle])]))",
    "Target player creates X {{PT}} {{CreatureTokens}} with \"{{TokenQuotedAbility}}\"": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, CreateTokens([NumberTokens({{X}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{TokenQuotedAbility[0]}}]))]))]))",
    "Target player creates X {{PT}} {{CreatureTokens}}, then up to one target {{Creature}} gets {{PTMod}} until end of turn for each {{Eachable(ThatPlayer)}}": "Targeted([TargetPlayer(AnyPlayer), UptoOneTargetPermanent({{Creature[0]}})], ActionList([PlayerAction(Ref_TargetPlayer, CreateTokens([NumberTokens({{X}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTForEach({{PTMod[0]}}, {{Eachable(ThatPlayer=Ref_TargetPlayer)[0]}})], UntilEndOfTurn)]))",
    "Target player discards X cards at random": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, DiscardNumberCardsAtRandom({{X}}))]))",
    "Target player draws 2ˣ cards": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, DrawNumberCards(Power(Integer(2), ValueX)))]))",
    "Target player draws X cards": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, DrawNumberCards({{X}}))]))",
    "Target player draws X cards and loses X life": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerActions(Ref_TargetPlayer, [DrawNumberCards({{X}}), LoseLife({{X}})])]))",
    "Target player draws X cards plus an additional card for each {{Eachable(ThatPlayer)}}": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, DrawNumberCards(Plus({{X}}, {{Eachable(ThatPlayer=ActionPlayer)[0]}})))]))",
    "Target player draws X cards. Create a token that's a copy of up to one target creature with mana value X or less": "Targeted([TargetPlayer(AnyPlayer), UptoOneTargetPermanent(And([IsCardtype(Creature), ManaValueIs(LessThanOrEqualTo({{X}}))]))], ActionList([PlayerAction(Ref_TargetPlayer, DrawNumberCards({{X}})), CreateTokens([TokenCopyOfPermanent(Ref_TargetPermanent, NoTokenCopyEffects)])]))",
    "Target player gains X life": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, GainLife({{X}}))]))",
    "Target player gains twice X life": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, GainLife(Twice({{X}})))]))",
    "Target player loses X life": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, LoseLife({{X}}))]))",
    "Target player mills X cards and you gain X life": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, MillNumberCards({{X}})), GainLife({{X}})]))",
    "Target player mills twice X cards": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, MillNumberCards(Twice({{X}})))]))",
    "Target player reveals their hand. You choose a nonland card with mana value X or less from it. That player discards that card": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, RevealHandAndPlayerChoosesACardToDiscard(You, And([IsNonCardtype(Land), ManaValueIs(LessThanOrEqualTo({{X}}))])))]))",
    "Target player scries X, then draws a card": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, Scry({{X}})), PlayerAction(Ref_TargetPlayer, DrawACard)]))",
    "Target {{Creature}} deals damage equal to {{GameNumber(ThatCreature)}} to each of X target {{CreaturesOrPlaneswalkers}}": "Targeted([TargetPermanent({{Creature[0]}}), NumberTargetPermanents({{X}}, {{CreaturesOrPlaneswalkers[0]}})], ActionList([PermanentDealsDamage(Ref_TargetPermanent, {{GameNumber(ThatCreature=Ref_TargetPermanent)[0]}}, EachPermanent(Ref_TargetPermanents))]))",
    "Target {{Creature}} gets {{PTModX}} and gains {{Hasable}} and {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTX({{PTModX[0]}}, {{X}}), AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)]))",
    "Target {{Creature}} gets {{PTModX}} and gains {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTX({{PTModX[0]}}, {{X}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Target {{Creature}} gets {{PTModX}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTX({{PTModX[0]}}, {{X}})], UntilEndOfTurn)]))",
    "Target {{Creature}} gets {{PTModX}} until end of turn.\nDraw a card at the beginning of the next turn's upkeep": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTX({{PTModX[0]}}, {{X}})], UntilEndOfTurn), CreateFutureTrigger(AtTheBeginningOfTheNextTurnsUpkeep, ActionList([DrawACard]))]))",
    "Target {{Creature}} gets {{PTModX}} until end of turn. Create {{a}} {{PT}} {{CreatureToken}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTX({{PTModX[0]}}, {{X}})], UntilEndOfTurn), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])]))",
    "Target {{Creature}} gets {{PTModX}} until end of turn. That creature gets an additional {{PTMod}} until end of turn if you controlled {{a}} {{Permanent}} as you cast this spell": "Modal_IfElse(PlayerPassesFilter(You, ControlsA({{Permanent[0]}})), Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTX({{PTModX[0]}}, {{X}}), AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])), Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTX({{PTModX[0]}}, {{X}})], UntilEndOfTurn)])))",
    "Target {{Creature}} gets {{PTModX}} until end of turn. Then it fights up to one target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}}), TargetPermanent({{Creature[1]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent1, [AdjustPTX({{PTModX[0]}}, {{X}})], UntilEndOfTurn), HaveCreaturesFight(Ref_TargetPermanent1, Ref_TargetPermanent2)]))",
    "Target {{Creature}} gets {{PTModX}} until end of turn. You gain X life": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTX({{PTModX[0]}}, {{X}})], UntilEndOfTurn), GainLife({{X}})]))",
    "Target {{Spell}}'s controller exiles it with X {{CounterType}} counters on it.\nAt the beginning of each of that player's upkeeps, if that card is exiled, remove {{a}} {{CounterType}} counter from it. If the card has no {{CounterType}} counters on it, the player puts it onto the stack as a copy of the original spell": "Targeted([TargetSpell({{Spell[0]}})], ActionList([PlayerAction(ControllerOfSpell(Ref_TargetSpell), ExileSpellWithANumberOfCountersOnIt(Ref_TargetSpell, {{X}}, {{CounterType[0]}})), CreateTriggerUntilI(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(ControllerOfSpell(Ref_TargetSpell))), CardIsExiled(TheCardExiledThisWay), ActionList([RemoveACounterOfTypeFromExiledCard({{CounterType[1]}}, TheCardExiledThisWay), If(ExiledCardPassesFilter(TheCardExiledThisWay, HasNoCountersOfType({{CounterType[2]}})), [PutExiledCardOnStackAsCopyOfSpell(TheCardExiledThisWay, Ref_TargetSpell, NoSpellCopyEffects)])]), UntilCardIsNoLongerExiled(TheCardExiledThisWay))]))",
    "The next X damage that would be dealt to target creature, planeswalker, or player this turn is dealt to another target creature, planeswalker, or player instead": "Targeted([NumberAnyTargets(Integer(2))], ActionList([CreateFutureReplaceWouldDealDamage(NextAmountOfDamageThatWouldBeDealtThisTurnToRecipient({{X}}, Ref_AnyTargets_1), [DealToAnyTargetInstead(Ref_AnyTargets_2)])]))",
    "The next X damage that {{a}} {{DamageSource}} of your choice would deal to you and/or {{Creatures}} this turn is dealt to any target instead": "Targeted([AnyTarget], ActionList([ChooseADamageSource({{DamageSource[0]}}), CreateFutureReplaceWouldDealDamage(NextAmountOfDamageThatWouldBeDealtThisTurnBySourceToARecipient({{X}}, TheChosenDamageSource, APlayerOrAPermanent(SinglePlayer(You), {{Creatures[0]}})), [DealToAnyTargetInstead(Ref_AnyTarget)])]))",
    "This spell deals X damage to target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([SpellDealsDamage(ThisSpell, {{X}}, Permanent(Ref_TargetPermanent))]))",
    "This spell deals X damage to target {{Planeswalker}}": "Targeted([TargetPermanent({{Planeswalker[0]}})], ActionList([SpellDealsDamage(ThisSpell, {{X}}, Permanent(Ref_TargetPermanent))]))",
    "Untap X target {{Permanents}}": "Targeted([NumberTargetPermanents({{X}}, {{Permanents[0]}})], ActionList([UntapEachPermanent(Ref_TargetPermanents)]))",
    "Until end of turn, double target {{Creature}}'s power X times": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([DoubleCreaturesPowerNumberTimesUntilEndOfTurn(Ref_TargetPermanent, {{X}})]))",
    "Until end of turn, target {{Permanent}} becomes {{a}} {{Black}} and {{Black}} {{Zombie}} with base power and toughness each equal to X plus {{Digits}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [SetColor(SimpleColorList([{{Black[0]}}, {{Black[0]}}])), SetCreatureType({{Zombie[0]}}), SetPowerAndToughnessBoth(Plus({{X}}, {{Digits[0]}}))], UntilEndOfTurn)]))",
    "Until end of turn, target {{Permanent}} gets {{PTModX}} and gains {{Hasable}} and \"{{QuotedAbility}}\"": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTX({{PTModX[0]}}, {{X}}), AddAbility([{{Hasable[0]}}]), AddAbility([{{QuotedAbility[0]}}])], UntilEndOfTurn)]))",
    "Up to X target {{Permanents}} gain {{Hasable}} until end of turn": "Targeted([UptoNumberTargetPermanents({{X}}, {{Permanents[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Up to X target {{Permanents}} phase out": "Targeted([UptoNumberTargetPermanents({{X}}, {{Permanents[0]}})], ActionList([PhaseOutEachPermanent(Ref_TargetPermanents)]))",
    "Up to one target {{Creature}} gets {{PTModX}} until end of turn. If X is {{Digits}} or more, return a creature card with mana value X or less from your graveyard to the battlefield tapped": "Targeted([UptoOneTargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTX({{PTModX[0]}}, {{X}})], UntilEndOfTurn), If(SpellXIs(GreaterThanOrEqualTo({{Digits[0]}})), [PutACardFromPlayersGraveyardOnBattlefield(And([IsCardtype(Creature), ManaValueIs(LessThanOrEqualTo({{X}}))]), You, [EntersTapped])])]))",
    "When you next cast {{a}} {{Spell}} this turn, copy that spell X times. You may choose new targets for the copies": "ActionList([CreateFutureTrigger(WhenPlayerCastsTheirNextSpellThisTurn(You, {{Spell[0]}}), ActionList([CopySpellNumberTimesAndMayChooseNewTargets(Trigger_ThatSpell, {{X}})]))])",
    "X target blocked creatures assign their combat damage this turn as though they weren't blocked": "Targeted([NumberTargetPermanents({{X}}, And([IsBlocked, IsCardtype(Creature)]))], ActionList([CreateEachPermanentRuleEffectUntil(Ref_TargetPermanents, [AssignsCombatDamageAsThoughNotBlocked], UntilEndOfTurn)]))",
    "X target {{Creatures}} can't be blocked this turn. Until end of turn, those creatures gain \"{{QuotedAbility}}\"": "Targeted([NumberTargetPermanents({{X}}, {{Creatures[0]}})], ActionList([CreateEachPermanentRuleEffectUntil(Ref_TargetPermanents, [CantBeBlocked], UntilEndOfTurn), CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AddAbility([{{QuotedAbility[0]}}])], UntilEndOfTurn)]))",
    "X target {{Creatures}} can't block this turn": "Targeted([NumberTargetPermanents({{X}}, {{Creatures[0]}})], ActionList([CreateEachPermanentRuleEffectUntil(Ref_TargetPermanents, [CantBlock], UntilEndOfTurn)]))",
    "X target {{Permanents}} gain {{Hasable}} until end of turn": "Targeted([NumberTargetPermanents({{X}}, {{Permanents[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "You draw X cards and you lose X life": "ActionList([DrawNumberCards({{X}}), LoseLife({{X}})])",
    "You gain X life": "ActionList([GainLife({{X}})])",
    "You gain X life and draw X cards": "ActionList([GainLife({{X}}), DrawNumberCards({{X}})])",
    "You gain X life. Create X {{PT}} {{CreatureTokens}} with {{Hasable}} and \"{{TokenQuotedAbility}}\". If X is {{Digits}} or more, destroy all other creatures": "ActionList([GainLife({{X}}), CreateTokens([NumberTokens({{X}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}, {{TokenQuotedAbility[0]}}]))]), If(SpellXIs(GreaterThanOrEqualTo({{Digits[0]}})), [DestroyEachPermanent(And([Not(TheCreatedTokens), Not(IsCardtype(Creature))]))])])",
    "You gain X plus {{Digits}} life": "ActionList([GainLife(Plus({{X}}, {{Digits[0]}}))])",
    "You get X {{EnergyCounters}}, then you may pay any amount of {{EnergyCounters}}. Destroy each artifact, creature, and enchantment with mana value less than or equal to the amount of {E} paid this way": "ActionList([GetEnergy({{X}}), PayAnyAmountOfEnergy, DestroyEachPermanent(And([Or([IsCardtype(Artifact), IsCardtype(Creature), IsCardtype(Enchantment)]), ManaValueIs(LessThanOrEqualTo(TheAmountOfEnergyPaidThisWay))]))])",
    "You lose X life and create X tapped Powerstone tokens. Then all {{Creatures}} get {{PTMod}} until end of turn for each {{Eachable}}": "ActionList([LoseLife({{X}}), CreateTokensWithFlags([NumberTokens({{X}}, PowerstoneToken)], [EntersTapped]), CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPTForEach({{PTMod[0]}}, {{Eachable[0]}})], UntilEndOfTurn)])",
    "You may cast up to one target instant card and/or up to one target sorcery card from your graveyard each with mana value X or less without paying their mana costs. If a spell cast this way would be put into your graveyard, exile it instead. If X is {{Digits}} or more, copy each of those spells twice. You may choose new targets for the copies": "Targeted([UptoOneTargetGraveyardCard(And([IsCardtype(Instant), ManaValueIs(LessThanOrEqualTo({{X}})), InAPlayersGraveyard(SinglePlayer(You))])), UptoOneTargetGraveyardCard(And([IsCardtype(Sorcery), ManaValueIs(LessThanOrEqualTo({{X}})), InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([CastAnyNumberOfGraveyardCardsWithoutPayingIntoExile(Or([SingleGraveyardCard(Ref_TargetGraveyardCard1), SingleGraveyardCard(Ref_TargetGraveyardCard2)])), If(SpellXIs(GreaterThanOrEqualTo({{Digits[0]}})), [CopyEachSpellAndMayChooseNewTargets(TheSpellsCastThisWay)])]))",
    "{{Creatures}} have base power and toughness {{PTX}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [SetPT(PTX({{PTX[0]}}, {{X}}))], UntilEndOfTurn)])"
  },
  "{{SpellActions(~Spell)}}": {
    "Exile all creatures. Each player may put any number of creature cards from their hand onto the battlefield. Then put all cards exiled this way into their owners' hands. Exile {{~Spell}}": "ActionList([Exile([Permanents(IsCardtype(Creature))]), EachPlayerMayAction(AnyPlayer, PutAnyNumberOfCardsFromHandOntoBattlefield(IsCardtype(Creature), [EntersNormally])), ReturnEachExiledCardToOwnersHand(TheCardsExiledThisWay), Exile([Spell(ThisSpell)])])",
    "Add {{ManaProduceSymbol}} for each card in target opponent's hand. Until end of turn, you don't lose this mana as steps and phases end. Exile {{~Spell}} with {{Number}} {{CounterType}} counters on it": "Targeted([TargetPlayer(Opponent)], ActionList([AddManaRepeatedWithModifiers({{ManaProduceSymbol[0]}}, TheNumberOfCardsInPlayersHand(Ref_TargetPlayer), DontLoseAsStepsAndPhasesEnd(UntilEndOfTurn)), ExileSpellWithANumberOfCountersOnIt({{~Spell}}, {{Number[0]}}, {{CounterType[0]}})]))",
    "Add X {{ManaProduceSymbol}} and X {{ManaProduceSymbol}}, where X is this spell's intensity.\nDraw a card": "ActionList([AddManaRepeated(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}]), IntensityOfSpell(ThisSpell)), DrawACard])",
    "All {{Permanents}} lose {{CheckHasable}} until end of turn. {{~Spell}} deals {{Digits}} damage to each {{Creature}} and each {{Planeswalker}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [LosesAbility({{CheckHasable[0]}})], UntilEndOfTurn), SpellDealsDamage({{~Spell}}, {{Digits[0]}}, MultipleRecipients([EachPermanent({{Creature[0]}}), EachPermanent({{Planeswalker[0]}})]))])",
    "Amass Orcs {{Digits}}. When you do, {{~Spell}} deals X damage to target {{Creature}}, where X is the amassed Army's power": "ActionList([MustCost(Amass({{Digits[0]}}, Orc)), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPermanent({{Creature[0]}})], ActionList([SpellDealsDamage({{~Spell}}, PowerOfPermanent(TheArmyAmassedThisWay), Permanent(Ref_TargetPermanent))])))])])",
    "Any player may have {{~Spell}} deal {{Digits}} damage to them. If no one does, destroy all creatures. Creatures destroyed this way can't be regenerated": "ActionList([AnyPlayerMayCost(AnyPlayer, HaveSpellDealDamage({{~Spell}}, {{Digits[0]}}, Player(ActionPlayer))), Unless(CostWasPaid, [DestroyEachPermanentNoRegen(IsCardtype(Creature))])])",
    "Any player may have {{~Spell}} deal {{Digits}} damage to them. If no one does, target player draws {{Number}} cards": "Targeted([TargetPlayer(AnyPlayer)], ActionList([AnyPlayerMayCost(AnyPlayer, HaveSpellDealDamage({{~Spell}}, {{Digits[0]}}, Player(ActionPlayer))), Unless(CostWasPaid, [PlayerAction(Ref_TargetPlayer, DrawNumberCards({{Number[0]}}))])]))",
    "Any player may have {{~Spell}} deal {{Digits}} damage to them. If no one does, target player mills {{Number}} cards": "Targeted([TargetPlayer(AnyPlayer)], ActionList([AnyPlayerMayCost(AnyPlayer, HaveSpellDealDamage({{~Spell}}, {{Digits[0]}}, Player(ActionPlayer))), Unless(CostWasPaid, [PlayerAction(Ref_TargetPlayer, MillNumberCards({{Number[0]}}))])]))",
    "Change the text of target permanent by replacing all instances of one color word with another or one basic land type with another until end of turn.\nCipher": "Targeted([TargetPermanent(AnyPermanent)], ActionList([ChooseAnAction([[ChooseTwoColorWords, CreatePermanentLayerEffect(Ref_TargetPermanent, [ReplaceColorWordVariableWithNewColorWordVariable(TheFirstChosenColorWord, TheSecondChosenColorWord)])], [ChooseTwoBasicLandTypes, CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [ReplaceLandTypeVariableWithNewLandTypeVariable(TheFirstChosenLandType, TheSecondChosenLandType)], UntilEndOfTurn)]]), Cipher(ThisSpell)]))",
    "Choose a card type. Target opponent reveals their hand. {{~Spell}} deals {{Digits}} damage to that player for each card of the chosen type revealed this way": "Targeted([TargetPlayer(Opponent)], ActionList([ChooseACardtype, PlayerAction(Ref_TargetPlayer, RevealHand), SpellDealsDamageForEach({{~Spell}}, {{Digits[0]}}, Player(Ref_TargetPlayer), TheNumberOfCardsOfTypeRevealedFromHandThisWay(IsCardtypeVariable(TheChosenCardtype)))]))",
    "Choose a color. {{~Spell}} deals damage to each player equal to the number of creatures of that color that player controls": "ActionList([ChooseAColor(AnyColor), SpellDealsDamage({{~Spell}}, TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), IsColor(TheChosenColor), ControlledByPlayer(DealsDamage_ThatPlayer)])), EachPlayer(AnyPlayer))])",
    "Choose a creature type. {{~Spell}} deals damage to any target equal to the number of permanents you control of the chosen type": "Targeted([AnyTarget], ActionList([ChooseACreatureType, SpellDealsDamage({{~Spell}}, TheNumberOfPermanentsOnTheBattlefield(And([ControlledByAPlayer(SinglePlayer(You)), IsCreatureTypeVariable(TheChosenCreatureType)])), Ref_AnyTarget)]))",
    "Choose a creature type. {{~Spell}} deals damage to target {{Creature}} equal to the number of permanents you control of the chosen type": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([ChooseACreatureType, SpellDealsDamage({{~Spell}}, TheNumberOfPermanentsOnTheBattlefield(And([ControlledByAPlayer(SinglePlayer(You)), IsCreatureTypeVariable(TheChosenCreatureType)])), Permanent(Ref_TargetPermanent))]))",
    "Choose a nonland card name and a number greater than 0. Target player reveals their library. If that library contains exactly the chosen number of cards with the chosen name, {{~Spell}} deals {{Digits}} damage to that player. Then that player shuffles": "Targeted([TargetPlayer(AnyPlayer)], ActionList([ChooseACardName(IsNonCardtype(Land)), ChooseANumberGreaterThanNumber(0), PlayerAction(Ref_TargetPlayer, RevealLibrary([If(TheNumberOfCardsOfTypeInPlayersLibraryIs(IsNamed(TheChosenName), Ref_TargetPlayer, EqualTo(TheChosenNumber)), [SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Player(Ref_TargetPlayer))]), PutTheRemainingCardsBackIntoLibraryAndShuffle]))]))",
    "Choose a nonland card name. Target player reveals their hand. {{~Spell}} deals {{Digits}} damage to that player for each card with the chosen name revealed this way. Search that player's graveyard, hand, and library for all cards with that name and exile them. Then that player shuffles": "Targeted([TargetPlayer(AnyPlayer)], ActionList([ChooseACardName(IsNonCardtype(Land)), PlayerAction(Ref_TargetPlayer, RevealHand), SpellDealsDamage({{~Spell}}, TheNumberOfCardsOfTypeRevealedFromHandThisWay(IsNamed(TheChosenName)), Player(Ref_TargetPlayer)), SearchPlayersLibraryAndGraveyardAndHand(Ref_TargetPlayer, [FindAllCardsOfType(IsNamed(TheChosenName)), ExileFoundCards, Shuffle])]))",
    "Choose a player who cast one or more sorcery spells this turn. {{~Spell}} deals damage to that player equal to half the damage dealt by one of those sorcery spells this turn, rounded down": "ActionList([ChooseAPlayer(CastASpellThisTurn(IsCardtype(Sorcery))), ChooseASpellThatResolvedThisTurn(And([IsCardtype(Sorcery), CastByPlayer(TheChosenPlayer)])), SpellDealsDamage({{~Spell}}, HalfRoundedDown(DamageDealtByResolvedSpell(TheResolvedSpellChosenThisWay)), Player(TheChosenPlayer))])",
    "Choose any number of target creatures, planeswalkers, and/or players. For each of them, exile the top card of your library, then {{~Spell}} deals damage equal to that card's mana value to that permanent or player. You may play the exiled cards until the end of your next turn": "Targeted([AnyNumberOfAnyTargets], ActionList([ExileTopOfLibraryForEachPlayerOrPermanentWithAction(Ref_AnyTargets, SpellDealsDamage({{~Spell}}, ManaValueOfTheCardExiledThisWay, EachableTarget)), CreatePlayerEffectUntil(You, [MayPlayExiledCards(TheCardsExiledThisWay)], UntilPlayersNextTurn(You))]))",
    "Choose any number of target players or planeswalkers. For each of them, reveal cards from the top of your library until you reveal {{a}} {{SpecificCard}}, {{~Spell}} deals damage equal to that card's mana value to that player or planeswalker, then you put the revealed cards on the bottom of your library in any order": "Targeted([AnyNumberOfTargetPlayersOrPermanents(AnyPlayer, IsCardtype(Planeswalker))], ActionList([ActionForEachTarget(Ref_TargetPlayersAndPermanents, [RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed({{SpecificCard[0]}}, [SpellDealsDamage({{~Spell}}, ManaValueOfTheCardFoundThisWay, EachableTarget), PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder])])]))",
