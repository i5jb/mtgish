    "Equipped creature has {{Hasable}} and gets {{PTModX}}, where X is {{GameNumber}}": "PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[0]}}]), AdjustPTX({{PTModX[0]}}, {{GameNumber[0]}})])",
    "Equipped creature has {{Hasable}} and gets {{PTMod}} for each {{Eachable}}": "PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[0]}}]), AdjustPTForEach({{PTMod[0]}}, {{Eachable[0]}})])",
    "Equipped creature has {{Hasable}} and mobilize X, where X is its power": "PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[0]}}]), AddAbility([Mobilize(PowerOfPermanent(HostPermanent))])])",
    "Equipped creature has {{Hasable}} and {{Hasable}}": "PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])])",
    "Equipped creature has {{Hasable}} as long as {{Condition(ThatPermanent)}}": "If({{Condition(ThatPermanent=HostPermanent)[0]}}, [PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[0]}}])])])",
    "Equipped creature has {{Hasable}} during your turn. Otherwise, it has {{Hasable}}": "IfElse(IsPlayersTurn(You), [PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[0]}}])])], [PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[1]}}])])])",
    "Equipped creature has {{Hasable}} if {{Condition}}, {{Hasable}} if {{Condition}}, {{Hasable}} if {{Condition}}, and {{Hasable}} if {{Condition}}": "If({{Condition[0]}}, [PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[0]}}])])]), If({{Condition[1]}}, [PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[1]}}])])]), If({{Condition[2]}}, [PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[2]}}])])]), If({{Condition[3]}}, [PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[3]}}])])])",
