    "Enchanted creature's controller may have it assign its combat damage as though it weren't blocked": "PermanentRuleEffect(HostPermanent, [MayAssignCombatDamageAsThoughNotBlocked])",
    "Enchanted {{Zombie}} can attack as though it didn't have defender": "PermanentRuleEffect(HostPermanent, [CanAttackAsThoughItDidntHaveDefender])",
    "Equip abilities you activate that target {{EnchantedPermanent}} cost {{CostReduce}} less to activate": "PlayerEffect(You, [DecreaseEquipAbilityCostWhenTargetingPermanent({{CostReduce[0]}}, HostPermanent)])",
    "If a creature dealt damage by {{EnchantedPermanent}} this turn would die, exile it instead": "ReplaceWouldPutIntoGraveyard(APermanentWouldDie(And([IsCardtype(Creature), WasDealtDamageByPermanentThisTurn(HostPermanent)])), [ExileItInstead])",
    "If {{EnchantedCreature}} would deal combat damage to a permanent or player, it deals double that damage instead": "ReplaceWouldDealDamage(CombatDamageWouldBeDealtByCreatureToARecipient(HostPermanent, APlayerOrAPermanent(AnyPlayer, AnyPermanent)), [DealDamageInstead(Twice(WouldDealDamage_ThatMuchDamage))])",
    "Prevent all combat damage that would be dealt by {{EnchantedCreature}}": "PreventDamage(CombatDamageWouldBeDealtByCreature(HostPermanent), [PreventThatDamage])",
    "Prevent all combat damage that would be dealt to and dealt by {{EnchantedPermanent}}": "PreventDamage(Or([CombatDamageWouldBeDealtToRecipient(Permanent(HostPermanent)), CombatDamageWouldBeDealtByCreature(HostPermanent)]), [PreventThatDamage])",
    "Prevent all damage that would be dealt by {{EnchantedCreature}}": "PreventDamage(DamageWouldBeDealtByPermanent(HostPermanent), [PreventThatDamage])",
    "Prevent all damage that would be dealt to and dealt by {{EnchantedCreature}}": "PreventDamage(Or([DamageWouldBeDealtToRecipient(Permanent(HostPermanent)), DamageWouldBeDealtByPermanent(HostPermanent)]), [PreventThatDamage])",
    "Prevent all damage that would be dealt to {{EnchantedCreature}}": "PreventDamage(DamageWouldBeDealtToRecipient(Permanent(HostPermanent)), [PreventThatDamage])",
    "Prevent all damage that would be dealt to {{EnchantedPermanent}} by {{DamageSources}}": "PreventDamage(DamageWouldBeDealtByASourceToRecipient({{DamageSources[0]}}, Permanent(HostPermanent)), [PreventThatDamage])",
    "The monarch controls {{EnchantedPermanent}}": "PermanentLayerEffect(HostPermanent, [SetController(TheMonarch)])",
    "You control {{EnchantedPermanent}}": "PermanentLayerEffect(HostPermanent, [SetController(You)])",
    "{{EnchantedArtifact}} is a creature with base power and toughness {{PT}} in addition to its other types": "PermanentLayerEffect(HostPermanent, [AddCardtype(Creature), SetPT({{PT[0]}})])",
    "{{EnchantedLand}} is a {{PT}} {{Black}} {{Zombie}} creature that's still a land": "PermanentLayerEffect(HostPermanent, [SetPT({{PT[0]}}), SetColor(SimpleColorList([{{Black[0]}}])), SetCreatureType({{Zombie[0]}}), AddCardtype(Creature)])",
    "{{EnchantedLand}} is a {{PT}} {{Black}} {{Zombie}} creature with {{Hasable}}. It's still a land": "PermanentLayerEffect(HostPermanent, [SetPT({{PT[0]}}), SetColor(SimpleColorList([{{Black[0]}}])), SetCreatureType({{Zombie[0]}}), AddCardtype(Creature), AddAbility([{{Hasable[0]}}])])",
    "{{EnchantedLand}} is a {{PT}} {{Black}} {{Zombie}} creature. It's still a land": "PermanentLayerEffect(HostPermanent, [SetPT({{PT[0]}}), SetColor(SimpleColorList([{{Black[0]}}])), SetCreatureType({{Zombie[0]}}), AddCardtype(Creature)])",
    "{{EnchantedLand}} is a {{PT}} {{Zombie}} creature with {{Hasable}} and {{Hasable}}. It's still a land": "PermanentLayerEffect(HostPermanent, [SetPT({{PT[0]}}), SetCreatureType({{Zombie[0]}}), AddCardtype(Creature), AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])])",
    "{{EnchantedLand}} is every basic land type in addition to its other types": "PermanentLayerEffect(HostPermanent, [AddLandTypeVariable(EachBasicLandType)])",
    "{{EnchantedLand}} is {{a}} {{PT}} {{Black}} {{Zombie}} creature with {{Hasable}} and {{Hasable}}. It's still a land": "PermanentLayerEffect(HostPermanent, [SetPT({{PT[0]}}), SetColor(SimpleColorList([{{Black[0]}}])), SetCreatureType({{Zombie[0]}}), AddCardtype(Creature), AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[0]}}])])",
    "{{EnchantedLand}} is {{a}} {{Swamp}}, {{Swamp}}, and {{Swamp}}": "PermanentLayerEffect(HostPermanent, [SetLandTypes([{{Swamp[0]}}, {{Swamp[1]}}, {{Swamp[2]}}])])",
    "{{EnchantedPermanent}} can't attack or block, and its activated abilities can't be activated": "PermanentRuleEffect(HostPermanent, [CantAttack, CantBlock, AbilitiesCantBeActivated])",
    "{{EnchantedPermanent}} can't attack or block, and its activated abilities can't be activated unless they're mana abilities": "PermanentRuleEffect(HostPermanent, [CantAttack, CantBlock, AbilitiesOfTypeCantBeActivated(NonManaAbility)])",
    "{{EnchantedPermanent}} can't attack or block, and its activated abilities can't be activated. Its controller may exile {{Number}} cards from their graveyard for that player to ignore this effect until end of turn": "PermanentRuleEffect_PlayerMayPayToIgnoreEffectUntil(HostPermanent, [CantAttack, CantBlock, AbilitiesCantBeActivated], ControllerOfPermanent(HostPermanent), ExileNumberGraveyardCards({{Number[0]}}, InAPlayersGraveyard(SinglePlayer(ControllerOfPermanent(HostPermanent)))), UntilEndOfTurn)",
    "{{EnchantedPermanent}} can't attack or block, and its activated abilities can't be activated. That creature's controller may sacrifice {{a}} {{Permanent}} of their choice for that player to ignore this effect until end of turn": "PermanentRuleEffect_PlayerMayPayToIgnoreEffectUntil(HostPermanent, [CantAttack, CantBlock, AbilitiesCantBeActivated], ControllerOfPermanent(HostPermanent), SacrificeAPermanent({{Permanent[0]}}), UntilEndOfTurn)",
    "{{EnchantedPermanent}} can't attack or block, and its activated abilities with {T} in their costs can't be activated": "PermanentRuleEffect(HostPermanent, [CantAttack, CantBlock, AbilitiesOfTypeCantBeActivated(HasTapSelfInCost)])",
    "{{EnchantedPermanent}} can't attack, block, or crew Vehicles, and its activated abilities can't be activated unless they're mana abilities": "PermanentRuleEffect(HostPermanent, [CantAttack, CantBlock, CantCrew, AbilitiesOfTypeCantBeActivated(NonManaAbility)])",
    "{{EnchantedPermanent}} can't attack, block, or crew Vehicles. Its activated abilities can't be activated unless they're mana abilities": "PermanentRuleEffect(HostPermanent, [CantAttack, CantBlock, CantCrew, AbilitiesOfTypeCantBeActivated(NonManaAbility)])",
    "{{EnchantedPermanent}} can't be the target of abilities from {{AbilitySources}}": "PermanentRuleEffect(HostPermanent, [CantBeTheTargetOfAbilities(AbilityOfASource({{AbilitySources[0]}}))])",
    "{{EnchantedPermanent}} can't be the target of spells and can't be enchanted by other Auras": "PermanentRuleEffect(HostPermanent, [CantBeTheTargetOfSpells(AnySpell), CantBeEnchantedByAnEnchantment(And([Other(ThisPermanent), IsEnchantmentType(Aura)]))])",
    "{{EnchantedPermanent}} can't be the target of {{PotentialSpellsOrAbilities}}": "PermanentRuleEffect(HostPermanent, [CantBeTheTargetOfSpellsOrAbilities({{PotentialSpellsOrAbilities[0]}})])",
    "{{EnchantedPermanent}} can't become untapped and can't have counters put on it": "PermanentRuleEffect(HostPermanent, [CantBecomeUntapped, CantHaveAnyCountersPutOnIt])",
    "{{EnchantedPermanent}} can't block as long as {{Condition}}": "If({{Condition[0]}}, [PermanentRuleEffect(HostPermanent, [CantBlock])])",
    "{{EnchantedPermanent}} can't block if {{Condition(ThatPermanent)}}": "If({{Condition(ThatPermanent=HostPermanent)[0]}}, [PermanentRuleEffect(HostPermanent, [CantBlock])])",
    "{{EnchantedPermanent}} doesn't untap during its controller's untap step": "PermanentRuleEffect(HostPermanent, [DoesntUntapDuringControllersUntap])",
    "{{EnchantedPermanent}} doesn't untap during its controller's untap step and its activated abilities can't be activated": "PermanentRuleEffect(HostPermanent, [DoesntUntapDuringControllersUntap, AbilitiesCantBeActivated])",
    "{{EnchantedPermanent}} doesn't untap during its controller's untap step if {{Condition(ThatPermanent)}}": "If({{Condition(ThatPermanent=HostPermanent)[0]}}, [PermanentRuleEffect(HostPermanent, [DoesntUntapDuringControllersUntap])])",
    "{{EnchantedPermanent}} doesn't untap during its controller's untap step unless that player is the monarch": "Unless(PlayerPassesFilter(ControllerOfPermanent(HostPermanent), IsTheMonarch), [PermanentRuleEffect(HostPermanent, [DoesntUntapDuringControllersUntap])])",
    "{{EnchantedPermanent}} gets {{PTModX}}, where X is {{GameNumber}}": "PermanentLayerEffect(HostPermanent, [AdjustPTX({{PTModX[0]}}, {{GameNumber[0]}})])",
    "{{EnchantedPermanent}} gets {{PTMod}} and has {{Hasable}}": "PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])])",
    "{{EnchantedPermanent}} has \"{{QuotedAbility(~Guest)}}\"": "PermanentLayerEffect(HostPermanent, [AddAbility([{{QuotedAbility(~Guest=ThisGuest)[0]}}])])",
    "{{EnchantedPermanent}} has \"{{QuotedAbility}}\"": "PermanentLayerEffect(HostPermanent, [AddAbility([{{QuotedAbility[0]}}])])",
    "{{EnchantedPermanent}} has \"{{QuotedAbility}}\" and \"{{QuotedAbility}}\"": "PermanentLayerEffect(HostPermanent, [AddAbility([{{QuotedAbility[0]}}]), AddAbility([{{QuotedAbility[1]}}])])",
    "{{EnchantedPermanent}} has base power and toughness {{PT}} and has \"{{QuotedAbility}}\"": "PermanentLayerEffect(HostPermanent, [SetPT({{PT[0]}}), AddAbility([{{QuotedAbility[0]}}])])",
    "{{EnchantedPermanent}} has base power {{Digits}} and has \"{{QuotedAbility}}\"": "PermanentLayerEffect(HostPermanent, [SetPower({{Digits[0]}}), AddAbility([{{QuotedAbility[0]}}])])",
    "{{EnchantedPermanent}} has {{Hasable}}": "PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[0]}}])])",
    "{{EnchantedPermanent}} has {{Hasable}} and \"{{QuotedAbility}}\"": "PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[0]}}]), AddAbility([{{QuotedAbility[0]}}])])",
    "{{EnchantedPermanent}} has {{Hasable}} and can't be blocked by more than one creature": "PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[0]}}])]), PermanentRuleEffect(HostPermanent, [CantBeBlockedByMoreThanOne])",
    "{{EnchantedPermanent}} has {{Hasable}} and can't be blocked except by {{Creatures}}": "PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[0]}}])]), PermanentRuleEffect(HostPermanent, [CantBeBlockedExceptByDefenders({{Creatures[0]}})])",
    "{{EnchantedPermanent}} has {{Hasable}} and can't be enchanted by other {{Enchantments}}": "PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[0]}}])]), PermanentRuleEffect(HostPermanent, [CantBeEnchantedByAnEnchantment(And([Other(ThisPermanent), {{Enchantments[0]}}]))])",
    "{{EnchantedPermanent}} has {{Hasable}} and loses {{CheckHasable}}": "PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[0]}}]), LosesAbility({{CheckHasable[0]}})])",
    "{{EnchantedPermanent}} has {{Hasable}} and {{Hasable}}": "PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])])",
    "{{EnchantedPermanent}} has {{Hasable}} as long as {{Condition(ThatPermanent)}}": "If({{Condition(ThatPermanent=HostPermanent)[0]}}, [PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[0]}}])])])",
    "{{EnchantedPermanent}} has {{Hasable}} as long as {{Condition(ThatPermanent)}}. Otherwise, prevent all damage that would be dealt by {{EnchantedPermanent}}": "IfElse({{Condition(ThatPermanent=HostPermanent)[0]}}, [PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[0]}}])])], [PreventDamage(DamageWouldBeDealtByPermanent(HostPermanent), [PreventThatDamage])])",
    "{{EnchantedPermanent}} has {{Hasable}} as long as {{Condition}}": "If({{Condition[0]}}, [PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[0]}}])])])",
    "{{EnchantedPermanent}} has {{Hasable}}, {{Hasable}}, and {{Hasable}}": "PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}]), AddAbility([{{Hasable[2]}}])])",
    "{{EnchantedPermanent}} is a Treasure artifact with \"{{QuotedAbility}}\", and it loses all other abilities": "PermanentLayerEffect(HostPermanent, [SetArtifactType(Treasure), SetCardtype(Artifact), LosesAllAbilities, AddAbility([{{QuotedAbility[0]}}])])",
    "{{EnchantedPermanent}} is a Vehicle artifact with {{Hasable}} and it loses all other card types": "PermanentLayerEffect(HostPermanent, [SetArtifactType(Vehicle), SetCardtype(Artifact), AddAbility([{{Hasable[0]}}])])",
    "{{EnchantedPermanent}} is a colorless Clue artifact with \"{{QuotedAbility}}\" and loses all other abilities": "PermanentLayerEffect(HostPermanent, [SetColor(Colorless), SetArtifactType(Clue), SetCardtype(Artifact), LosesAllAbilities, AddAbility([{{QuotedAbility[0]}}])])",
    "{{EnchantedPermanent}} is a colorless Food artifact with \"{{QuotedAbility}}\" and loses all other card types and abilities": "PermanentLayerEffect(HostPermanent, [SetColor(Colorless), SetArtifactType(Clue), SetCardtype(Artifact), LosesAllAbilities, AddAbility([{{QuotedAbility[0]}}])])",
    "{{EnchantedPermanent}} is a colorless land with \"{{QuotedAbility}}\" and loses all other card types and abilities": "PermanentLayerEffect(HostPermanent, [SetColor(Colorless), SetCardtype(Land), LosesAllAbilities, AddAbility([{{QuotedAbility[0]}}])])",
    "{{EnchantedPermanent}} is a colorless {{Swamp}} land": "PermanentLayerEffect(HostPermanent, [SetColor(Colorless), SetLandType({{Swamp[0]}}), SetCardtype(Land)])",
    "{{EnchantedPermanent}} is an enchantment and loses all other card types": "PermanentLayerEffect(HostPermanent, [SetCardtype(Enchantment)])",
    "{{EnchantedPermanent}} is legendary": "PermanentLayerEffect(HostPermanent, [AddSupertype(Legendary)])",
    "{{EnchantedPermanent}} is snow": "PermanentLayerEffect(HostPermanent, [AddSupertype(Snow)])",
    "{{EnchantedPermanent}} is {{a}} {{Swamp}}": "PermanentLayerEffect(HostPermanent, [SetLandType({{Swamp[0]}})])",
    "{{EnchantedPermanent}} is {{a}} {{Zombie}}": "PermanentLayerEffect(HostPermanent, [SetCreatureType({{Zombie[0]}})])",
    "{{EnchantedPermanent}} is {{a}} {{Zombie}} creature with base power and toughness {{PT}} in addition to its other types": "PermanentLayerEffect(HostPermanent, [AddCreatureType({{Zombie[0]}}), AddCardtype(Creature), SetPT({{PT[0]}})])",
    "{{EnchantedPermanent}} loses all abilities and doesn't untap during its controller's untap step": "PermanentLayerEffect(HostPermanent, [LosesAllAbilities]), PermanentRuleEffect(HostPermanent, [DoesntUntapDuringControllersUntap])",
    "{{EnchantedPermanent}} loses all land types and abilities and has \"{{QuotedAbility}}\" and \"{{QuotedAbility}}\"": "PermanentLayerEffect(HostPermanent, [RemoveAllLandTypes, LosesAllAbilities, AddAbility([{{QuotedAbility[0]}}]), AddAbility([{{QuotedAbility[1]}}])])",
    "{{EnchantedPermanent}} loses {{CheckHasable}}": "PermanentLayerEffect(HostPermanent, [LosesAbility({{CheckHasable[0]}})])",
    "{{EnchantedPermanent}}'s activated abilities can't be activated": "PermanentRuleEffect(HostPermanent, [AbilitiesCantBeActivated])",
    "{{EnchantedPermanent}}'s activated abilities cost {{CostReduce}} less to activate. This effect can't reduce the mana in that cost to less than one mana": "ActivatedAbilityEffect(AbilityOfPermanent(HostPermanent), ReduceManaCostNotLessThanOne({{CostReduce[0]}}))",
    "{{EnchantedPermanent}}'s controller can't cast {{PotentialSpells}}": "PlayerEffect(ControllerOfPermanent(HostPermanent), [CantCastSpells({{PotentialSpells[0]}})])",
    "{{Permanents}} enter as a copy of {{EnchantedPermanent}}": "ReplaceWouldEnter(APermanentWouldEnterTheBattlefield({{Permanents[0]}}), [EnterAsACopyOfPermanent(HostPermanent, NoCopyEffects)])"
  },
  "{{StaticEffect[EnchantedPlayer,TheChosenName]}}": {
    "Spells with the chosen name {{EnchantedPlayer}} casts cost {{ManaCost}} more to cast": "StackSpellsEffect(And([IsNamed(TheChosenName), CastByPlayer(HostPlayer)]), [IncreaseManaCost({{ManaCost[0]}})])"
  },
  "{{StaticEffect[EnchantedPlayer]}}": {
    "If a card would be put into {{EnchantedPlayer}}'s graveyard from anywhere, instead that card is revealed and put on the bottom of that player's library": "ReplaceWouldPutIntoGraveyard(WouldPutACardInPlayersGraveyardFromAnywhere(AnyCard, HostPlayer), [RevealItAndPutItOnBottomOfOwnersLibraryInstead])",
    "If {{a}} {{DamageSource}} would deal damage to {{EnchantedPlayer}}, it deals double that damage to that player instead": "ReplaceWouldDealDamage(DamageWouldBeDealtByASourceToRecipient({{DamageSource[0]}}, Player(HostPlayer)), [DealDamageInstead(Twice(WouldDealDamage_ThatMuchDamage))])",
    "Spells you cast that target {{EnchantedPlayer}} cost {{CostReduce}} less to cast": "PlayerEffect(You, [DecreaseSpellCost(TargetsPlayer(HostPlayer), {{CostReduce[0]}})])",
    "{{Creatures}} attacking {{EnchantedPlayer}} have {{Hasable}}": "EachPermanentLayerEffect(And([{{Creatures[0]}}, IsAttackingPlayer(HostPlayer)]), [AddAbility([{{Hasable[0]}}])])",
    "{{Creatures}} {{EnchantedPlayer}} controls attack each combat if able": "EachPermanentRuleEffect(And([{{Creatures[0]}}, ControlledByPlayer(HostPlayer)]), [MustAttack])",
    "{{Creatures}} {{EnchantedPlayer}} controls get {{PTMod}}": "EachPermanentLayerEffect(And([{{Creatures[0]}}, ControlledByPlayer(HostPlayer)]), [AdjustPT({{PTMod[0]}})])",
    "{{Creatures}} {{EnchantedPlayer}} controls have base power and toughness {{PT}} and lose all creature types": "EachPermanentLayerEffect(And([{{Creatures[0]}}, ControlledByPlayer(HostPlayer)]), [SetPT({{PT[0]}}), RemoveAllCreatureTypes])",
    "{{Creatures}} {{EnchantedPlayer}} controls lose all abilities and have base power and toughness {{PT}}": "EachPermanentLayerEffect(And([{{Creatures[0]}}, ControlledByPlayer(HostPlayer)]), [LosesAllAbilities, SetPT({{PT[0]}})])",
    "{{EnchantedPlayer}} can't activate abilities that aren't mana abilities or loyalty abilities": "PlayerEffect(HostPlayer, [CantActivateAbilities(And([NonManaAbility, NonLoyaltyAbility]))])",
    "{{EnchantedPlayer}} can't cast more than one {{PotentialSpell}} each turn": "PlayerEffect(HostPlayer, [CantCastMoreThanNumberSpellsEachTurn(Integer(1), {{PotentialSpell[0]}})])",
    "{{EnchantedPlayer}} can't gain life": "PlayerEffect(HostPlayer, [CantGainLife])",
    "{{Permanents}} {{EnchantedPlayer}} controls enter tapped": "ReplaceWouldEnter(APermanentWouldEnterTheBattlefield(And([{{Permanents[0]}}, ControlledByPlayer(HostPlayer)])), [EntersTapped])"
  },
  "{{StaticEffect[EquippedCreature,TheChosenColor]}}": {
    "{{EquippedCreature}} gets {{PTMod}} and has {{Hasable[TheChosenColor]}}": "PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[TheChosenColor][0]}}])])"
  },
  "{{StaticEffect[EquippedCreature,TheExiledCard]}}": {
    "{{EquippedCreature}} gets {{PTMod}} for each {{Eachable[TheExiledCard]}}": "PermanentLayerEffect(HostPermanent, [AdjustPTForEach({{PTMod[0]}}, {{Eachable[TheExiledCard][0]}})])",
    "{{EquippedCreature}} has {{Hasable}} and gets {{PTModX}}, where X is the exiled card's power": "PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[0]}}]), AdjustPTX({{PTModX[0]}}, PowerOfTheExiledCreature)])"
  },
  "{{StaticEffect[EquippedCreature](~Permanent)}}": {
    "As long as a card exiled with {{~Permanent}} has {{CheckHasable}}, {{EquippedCreature}} has {{Hasable}}. The same is true for {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, and {{CheckHasable}}": "PermanentLayerEffect(HostPermanent, [AddAbilityFromAnExiledHasable(WasExiledWithPermanent({{~Permanent}}), [{{CheckHasable[0]}}, {{CheckHasable[1]}}, {{CheckHasable[2]}}, {{CheckHasable[3]}}, {{CheckHasable[4]}}, {{CheckHasable[5]}}, {{CheckHasable[6]}}, {{CheckHasable[7]}}, {{CheckHasable[8]}}, {{CheckHasable[9]}}, {{CheckHasable[10]}}, {{CheckHasable[11]}}, {{CheckHasable[12]}}])])",
    "As long as {{Condition(~Permanent)}}, {{EquippedCreature}} has {{Hasable}}": "If({{Condition(~Permanent=^~Permanent)[0]}}, [PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[0]}}])])])",
    "Equipped creature gets {{PTModX}}, where X is {{GameNumber(~Permanent)}}": "PermanentLayerEffect(HostPermanent, [AdjustPTX({{PTModX[0]}}, {{GameNumber(~Permanent=^~Permanent)[0]}})])",
    "Equipped creature gets {{PTMod}} and has \"{{QuotedAbility(~Guest)}}\"": "PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{QuotedAbility(~Guest=ThisGuest)[0]}}])])",
    "Equipped creature gets {{PTMod}} and has all abilities of ability stickers on this Equipment": "PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}}), AddAbilityFromPermanentHasable({{~Permanent}}, [AbilityStickerAbility])])",
    "Equipped creature gets {{PTMod}} for each {{Eachable(~Permanent)}}": "PermanentLayerEffect(HostPermanent, [AdjustPTForEach({{PTMod[0]}}, {{Eachable(~Permanent=^~Permanent)[0]}})])",
    "Equipped creature gets {{PTMod}} for each {{Eachable(~Permanent)}} and has \"{{QuotedAbility(~Guest)}}\"": "PermanentLayerEffect(HostPermanent, [AdjustPTForEach({{PTMod[0]}}, {{Eachable(~Permanent=^~Permanent)[0]}}), AddAbility([{{QuotedAbility(~Guest=ThisGuest)[0]}}])])",
    "Equipped creature gets {{PTMod}} for each {{Eachable(~Permanent)}} and has {{Hasable}}": "PermanentLayerEffect(HostPermanent, [AdjustPTForEach({{PTMod[0]}}, {{Eachable(~Permanent=^~Permanent)[0]}}), AddAbility([{{Hasable[0]}}])])",
    "Equipped creature gets {{PTMod}} for each {{Eachable(~Permanent)}} and is {{a}} {{Zombie}} in addition to its other types": "PermanentLayerEffect(HostPermanent, [AdjustPTForEach({{PTMod[0]}}, {{Eachable(~Permanent=^~Permanent)[0]}}), AddCreatureType({{Zombie[0]}})])",
    "Equipped creature has \"{{QuotedAbility(~Guest)}}\"": "PermanentLayerEffect(HostPermanent, [AddAbility([{{QuotedAbility(~Guest=ThisGuest)[0]}}])])",
    "Equipped creature has \"{{QuotedAbility(~Guest)}}\" and \"{{QuotedAbility(~Guest)}}\"": "PermanentLayerEffect(HostPermanent, [AddAbility([{{QuotedAbility(~Guest=ThisGuest)[0]}}]), AddAbility([{{QuotedAbility(~Guest=ThisGuest)[1]}}])])",
    "Equipped creature has {{Hasable}} and \"{{QuotedAbility(~Guest)}}\"": "PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[0]}}]), AddAbility([{{QuotedAbility(~Guest=ThisGuest)[0]}}])])"
  },
  "{{StaticEffect[EquippedCreature]}}": {
    "Double all damage {{EquippedCreature}} would deal": "ReplaceWouldDealDamage(DamageWouldBeDealtByPermanent(HostPermanent), [DealDamageInstead(Twice(WouldDealDamage_ThatMuchDamage))])",
    "All damage that would be dealt to you is dealt to {{EquippedCreature}} instead": "ReplaceWouldDealDamage(DamageWouldBeDealtToRecipient(Player(You)), [DealToCreatureOrPlaneswalkerInstead(HostPermanent)])",
    "All {{Creatures}} able to block {{EquippedCreature}} do so": "EachPermanentRuleEffect({{Creatures[0]}}, [MustBlockAttacker(HostPermanent)])",
    "As long as {{Condition[EquippedCreature]}}, it assigns combat damage equal to its toughness rather than its power": "If({{Condition[EquippedCreature][0]}}, [PermanentRuleEffect(HostPermanent, [AssignsToughnessCombatDamage])])",
    "As long as {{Condition[EquippedCreature]}}, it can attack as though it didn't have defender": "If({{Condition[EquippedCreature][0]}}, [PermanentRuleEffect(HostPermanent, [CanAttackAsThoughItDidntHaveDefender])])",
    "As long as {{Condition[EquippedCreature]}}, it gets an additional {{PTMod}}": "If({{Condition[EquippedCreature][0]}}, [PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}})])])",
    "As long as {{Condition[EquippedCreature]}}, it gets {{PTMod}}": "If({{Condition[EquippedCreature][0]}}, [PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}})])])",
    "As long as {{Condition[EquippedCreature]}}, it has {{Hasable}}": "If({{Condition[EquippedCreature][0]}}, [PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[0]}}])])])",
    "As long as {{Condition[EquippedCreature]}}, it has {{Hasable}} and must be blocked by {{a}} {{Creature}} if able": "If({{Condition[EquippedCreature][0]}}, [PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[0]}}])]), PermanentRuleEffect(HostPermanent, [MustBeBlockedByADefender({{Creature[0]}})])])",
    "As long as {{Condition[EquippedCreature]}}, it has {{Hasable}} and must be blocked if able": "If({{Condition[EquippedCreature][0]}}, [PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[0]}}])]), PermanentRuleEffect(HostPermanent, [MustBeBlocked])])",
    "As long as {{Condition[EquippedCreature]}}, it has {{Hasable}} and {{Hasable}}": "If({{Condition[EquippedCreature][0]}}, [PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])])])",
    "As long as {{Condition[EquippedCreature]}}, {{Creatures}} get {{PTMod}}": "If({{Condition[EquippedCreature][0]}}, [EachPermanentLayerEffect({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})])])",
