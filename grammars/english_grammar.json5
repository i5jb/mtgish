    "Exile this creature. Return it to the battlefield under its owner's control at the beginning of the next end step": "ActionList([ExilePermanent({{~Permanent}}), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersUnderOwnersControl])]))])",
    "Exile {{~Permanent}}, then return it to the battlefield under an opponent's control": "ActionList([ExilePermanent({{~Permanent}}), PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersUnderAPlayersControl(Opponent)])])",
    "Put {{Number}} {{CounterType}} counters on this creature": "ActionList([PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[0]}}, {{~Permanent}})])",
    "Put {{Number}} {{CounterType}} counters on {{~Permanent}}": "ActionList([PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[0]}}, {{~Permanent}})])",
    "Put {{a}} {{CounterType}} counter on this creature": "ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{~Permanent}})])",
    "Put {{a}} {{CounterType}} counter on this creature for each {{Eachable}}": "ActionList([PutNumberCountersOfTypeOnPermanent({{Eachable[0]}}, {{CounterType[0]}}, {{~Permanent}})])",
    "Put {{a}} {{CounterType}} counter on {{~Permanent}}": "ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{~Permanent}})])",
    "Put {{a}} {{CounterType}} counter on {{~Permanent}}. It gains {{Hasable}} until end of turn": "ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{~Permanent}}), CreatePermanentLayerEffectUntil({{~Permanent}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "Put {{~Permanent}} on top of its owner's library": "ActionList([PutPermanentOnTopOfOwnersLibrary({{~Permanent}})])",
    "Remove all counters from target {{Permanent}}. It can't have counters put on it for as long as {{ThisPermanent}} remains on the battlefield": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([RemoveAllCountersFromPermanent(Ref_TargetPermanent), CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [CantHaveAnyCountersPutOnIt], UntilPermanentLeavesBattlefield({{~Permanent}}))]))",
    "Sacrifice {{a}} {{Permanent}}. If you do, put {{Number}} {{CounterType}} counters on this creature": "ActionList([MustCost(SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[0]}}, {{~Permanent}})])])",
    "Target opponent gains control of target {{Permanent}}. If they do, remove {{~Permanent}} from combat and create {{Number}} Treasure tokens": "Targeted([TargetPlayer(Opponent), TargetPermanent({{Permanent[0]}})], ActionList([PlayerMustCost(Ref_TargetPlayer, GainControlOfPermanent(Ref_TargetPermanent)), If(CostWasPaid, [RemoveCreatureFromCombat({{~Permanent}}), CreateTokens([NumberTokens({{Number[0]}}, TreasureToken)])])]))",
    "Target opponent loses all counters. That player can't get counters for as long as this creature remains on the battlefield": "Targeted([TargetPlayer(Opponent)], ActionList([RemoveAllCountersFromPlayer(Ref_TargetPlayer), CreatePlayerEffectUntil(Ref_TargetPlayer, [CantGetAnyCounters], UntilPermanentLeavesBattlefield({{~Permanent}}))]))",
    "Transform {{~Permanent}}": "ActionList([TransformPermanent({{~Permanent}})])",
    "Untap {{ThisPermanent}}": "ActionList([UntapPermanent({{~Permanent}})])",
    "You may cast {{a}} {{PotentialSpell}} from your hand with mana value less than or equal to {{GameNumber(~Permanent)}} without paying its mana cost": "ActionList([MayAction(CastASpellFromHandWithoutPaying(And([{{PotentialSpell[0]}}, ManaValueIs(LessThanOrEqualTo({{GameNumber(~Permanent=^~Permanent)[0]}}))])))])",
    "{{ThisPermanent}} becomes a copy of another target {{Permanent}}": "Targeted([TargetPermanent(And([Other({{~Permanent}}), {{Permanent[0]}}]))], ActionList([CreatePermanentLayerEffect({{~Permanent}}, [IsACopyOfPermanent(Ref_TargetPermanent, NoCopyEffects)])]))",
    "{{ThisPermanent}} deals {{Digits}} damage to any target": "Targeted([AnyTarget], ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Ref_AnyTarget)]))",
    "{{ThisPermanent}} deals {{Digits}} damage to any target and you gain {{Digits}} life": "Targeted([AnyTarget], ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Ref_AnyTarget), GainLife({{Digits[1]}})]))",
    "{{ThisPermanent}} deals {{Digits}} damage to each opponent": "ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, EachPlayer(Opponent))])",
    "{{ThisPermanent}} deals {{Digits}} damage to target {{PlayerOrPlaneswalker}}": "Targeted([TargetPlayerOrPermanent({{PlayerOrPlaneswalker[0]}})], ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Ref_TargetPlayerOrPermanent)]))",
    "{{ThisPermanent}} fights target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([Fight({{~Permanent}}, Ref_TargetPermanent)]))",
    "{{ThisPermanent}} gains {{Hasable}} and {{Hasable}} until end of turn": "ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)])",
    "{{ThisPermanent}} gains {{Hasable}} until end of turn": "ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
