    "{{Creatures}} get {{PTMod}} and gain {{Hasable}} and {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTMod}} and gain {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTMod}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTMod}} until end of turn for each {{Eachable}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPTForEach({{PTMod[0]}}, {{Eachable[0]}})], UntilEndOfTurn)])",
    "{{Creatures}} target player controls get {{PTMod}} until end of turn": "Targeted([TargetPlayer(AnyPlayer)], ActionList([CreateEachPermanentLayerEffectUntil(And([{{Creatures[0]}}, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]), [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)]))",
    "{{Permanents}} gain {{Hasable}} and {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)])",
    "{{Permanents}} gain {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])"
  },
  "{{TriggerActions}}": {
    "draw a card if {{Condition}}. Then if {{Condition}}, {{Permanents}} get {{PTMod}} until end of turn": "ActionList([If({{Condition[0]}}, [DrawACard]), If({{Condition[1]}}, [CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])])",
    "put {{a}} {{CounterType}} counter on target creature. Whenever that creature attacks the monarch this turn, it gains {{Hasable}} and {{Hasable}} until end of turn":
      "Targeted([TargetPermanent(IsCardtype(Creature))], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent), CreateTriggerUntil(WhenACreatureAttacksAPlayer(SinglePermanent(Ref_TargetPermanent), SinglePlayer(TheMonarch)), ActionList([CreatePermanentLayerEffectUntil(RefOuter_TargetPermanent, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)]), UntilEndOfTurn)]))",
    "all cards you own named {{NamedCard}} perpetually get {{PTMod}}": "ActionList([CreatePerpetualAllCardsEffect(And([OwnedByAPlayer(SinglePlayer(You)), IsNamed(NamedCard({{NamedCard[0]}}))]), [AdjustPT({{PTMod[0]}})])])",
    "a random creature card with the greatest mana value among creature cards in your hand perpetually gains \"{{PerpetualQuotedAbility}}\"": "ActionList([ChooseACardInHandAtRandom(And([IsCardtype(Creature), ManaValueIs(EqualTo(TheHighestManaValueAmongCardsInPlayersHand(IsCardtype(Creature), You)))])), CreatePerpetualCardInHandEffect(TheChosenCardInHand, [AddAbility([{{PerpetualQuotedAbility[0]}}])])])",
    "a random {{SpecificCard}} in your graveyard perpetually becomes a Food artifact in addition to its other types and gains \"{{PerpetualQuotedAbility}}\". You may play that card for as long as it's in your graveyard": "ActionList([ChooseACardInPlayersGraveyardAtRandom({{SpecificCard[0]}}, You), CreatePerpetualGraveyardCardEffect(TheGraveyardCardChosenThisWay, [AddArtifactType(Food), AddCardtype(Artifact), AddAbility([{{PerpetualQuotedAbility[0]}}])]), CreatePlayerEffectUntil(You, [MayPlayGraveyardCard(TheGraveyardCardChosenThisWay)], UntilCardIsNoLongerInGraveyard(TheGraveyardCardChosenThisWay))])",
    "a random {{SpecificCard}} in your hand perpetually gains \"{{PerpetualQuotedAbility}}\"": "ActionList([ChooseACardInHandAtRandom({{SpecificCard[0]}}), CreatePerpetualCardInHandEffect(TheChosenCardInHand, [AddAbility([{{PerpetualQuotedAbility[0]}}])])])",
    "a random {{SpecificCard}} in your library perpetually becomes a basic {{Swamp}} in addition to its other types and gains \"{{PerpetualQuotedAbility}}\"": "ActionList([CreatePerpetualCardInLibraryEffect(ARandomCardOfTypeFromPlayersLibrary({{SpecificCard[0]}}, You), [AddSupertype(Basic), AddLandType({{Swamp[0]}}), AddAbility([{{PerpetualQuotedAbility[0]}}])])])",
    "a random {{SpecificCard}} in your library perpetually gains \"{{PerpetualQuotedAbility}}\"": "ActionList([CreatePerpetualCardInLibraryEffect(ARandomCardOfTypeFromPlayersLibrary({{SpecificCard[0]}}, You), [AddAbility([{{PerpetualQuotedAbility[0]}}])])])",
    "activated abilities of {{Permanents}} cost {{CostReduce}} less to activate this turn": "ActionList([CreateEachPlayerEffectUntil(AnyPlayer, [ReduceActivatedCost(AbilityOfAPermanent({{Permanents[0]}}), {{CostReduce[0]}})], UntilEndOfTurn)])",
    "add X mana in any combination of colors, where X is {{GameNumber}}. Spend this mana only to cast spells. Until end of turn, you don't lose this mana as steps and phases end": "ActionList([AddCombinationManaWithModifers(AnyManaColor, {{GameNumber[0]}}, And([CanOnlySpendOnSpells(AnySpell), DontLoseAsStepsAndPhasesEnd(UntilEndOfTurn)]))])",
    "add X mana of any one color, where X is {{GameNumber}}": "ActionList([AddManaRepeated(AnyManaColor, {{GameNumber[0]}})])",
    "add an additional one mana of any color": "ActionList([AddMana(AnyManaColor)])",
    "add an additional {{ManaProduceSymbol}}": "ActionList([AddMana({{ManaProduceSymbol[0]}})])",
    "add one mana of any color": "ActionList([AddMana(AnyManaColor)])",
    "add one mana of any color. Then if this is the second time this ability has resolved this turn, reveal cards from the top of your library until you reveal {{a}} {{SpecificCard}}. Put that card into your hand and the rest on the bottom of your library in a random order": "ActionList([AddMana(AnyManaColor), If(TimesThisAbilityHasResolvedThisTurnIs(EqualTo(Integer(2))), [RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed({{SpecificCard[0]}}, [PutTheCardFoundThisWayIntoHand, PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])])",
    "add {{ManaProduceSymbol}}": "ActionList([AddMana({{ManaProduceSymbol[0]}})])",
    "add {{ManaProduceSymbol}} at the beginning of your next main phase this turn": "ActionList([CreateFutureTrigger(AtTheBeginningOfTheNextMainPhaseThisTurn, ActionList([AddMana({{ManaProduceSymbol[0]}})]))])",
    "add {{ManaProduceSymbol}} for each land target opponent controls": "Targeted([TargetPlayer(Opponent)], ActionList([AddManaRepeated({{ManaProduceSymbol[0]}}, TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))])))]))",
    "add {{ManaProduceSymbol}} for each {{Eachable}}": "ActionList([AddManaRepeated({{ManaProduceSymbol[0]}}, {{Eachable[0]}})])",
    "add {{ManaProduceSymbol}} for each {{Eachable}}. This mana can't be spent to cast nonartifact spells. Until end of turn, you don't lose this mana as steps and phases end": "ActionList([AddManaRepeatedWithModifiers({{ManaProduceSymbol[0]}}, {{Eachable[0]}}, And([CantSpendOnSpells(IsNonCardtype(Artifact)), DontLoseAsStepsAndPhasesEnd(UntilEndOfTurn)]))])",
    "add {{ManaProduceSymbol}} or {{ManaProduceSymbol}} for each {{Eachable}}": "ActionList([AddCombinationMana(Or([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}]), {{Eachable[0]}})])",
    "add {{ManaProduceSymbol}} or {{ManaProduceSymbol}}. Until end of turn, you don't lose this mana as steps and phases end": "ActionList([AddManaWithModifiers(Or([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}]), DontLoseAsStepsAndPhasesEnd(UntilEndOfTurn))])",
    "add {{ManaProduceSymbol}}. Until end of turn, you don't lose this mana as steps and phases end": "ActionList([AddManaWithModifiers({{ManaProduceSymbol[0]}}, DontLoseAsStepsAndPhasesEnd(UntilEndOfTurn))])",
    "add {{ManaProduceSymbol}}{{ManaProduceSymbol}}": "ActionList([AddMana(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}]))])",
    "add {{ManaProduceSymbol}}{{ManaProduceSymbol}} at the beginning of your next main phase this turn": "ActionList([CreateFutureTrigger(AtTheBeginningOfTheNextMainPhaseThisTurn, ActionList([AddMana(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}]))]))])",
    "add {{ManaProduceSymbol}}{{ManaProduceSymbol}}. Spend this mana only to cast Room spells and unlock doors": "ActionList([AddManaWithModifiers(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}]), Or([CanOnlySpendOnSpells(IsEnchantmentType(Room)), CanOnlySpendToUnlockDoors]))])",
    "add {{ManaProduceSymbol}}{{ManaProduceSymbol}}. Spend this mana only to cast {{PotentialSpells}}": "ActionList([AddManaWithModifiers(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}]), CanOnlySpendOnSpells({{PotentialSpells[0]}}))])",
    "add {{ManaProduceSymbol}}{{ManaProduceSymbol}}. Until end of turn, you don't lose this mana as steps and phases end": "ActionList([AddManaWithModifiers(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}]), DontLoseAsStepsAndPhasesEnd(UntilEndOfTurn))])",
    "add {{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}": "ActionList([AddMana(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}, {{ManaProduceSymbol[2]}}]))])",
    "add {{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}} and you gain {{Digits}} life. Until end of turn, you don't lose this mana as steps and phases end": "ActionList([AddManaWithModifiers(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}, {{ManaProduceSymbol[2]}}]), DontLoseAsStepsAndPhasesEnd(UntilEndOfTurn)), GainLife({{Digits[0]}})])",
    "add {{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}. Spend this mana only to cast {{PotentialSpells}}": "ActionList([AddManaWithModifiers(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}, {{ManaProduceSymbol[2]}}]), CanOnlySpendOnSpells({{PotentialSpells[0]}}))])",
    "add {{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}": "ActionList([AddMana(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}, {{ManaProduceSymbol[2]}}, {{ManaProduceSymbol[3]}}]))])",
    "add {{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}": "ActionList([AddMana(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}, {{ManaProduceSymbol[2]}}, {{ManaProduceSymbol[3]}}, {{ManaProduceSymbol[4]}}]))])",
    "add {{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}. Until end of turn, you don't lose this mana as steps and phases end": "ActionList([AddManaWithModifiers(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}, {{ManaProduceSymbol[2]}}, {{ManaProduceSymbol[3]}}, {{ManaProduceSymbol[4]}}, {{ManaProduceSymbol[5]}}]), DontLoseAsStepsAndPhasesEnd(UntilEndOfTurn))])",
    "add {{Number}} mana in any combination of colors": "ActionList([AddCombinationMana(AnyManaColor, {{Number[0]}})])",
    "add {{Number}} mana of any one color. Spend this mana only to activate abilities": "ActionList([AddManaRepeatedWithModifiers(AnyManaColor, {{Number[0]}}, CanOnlySpendToActivateAbilities)])",
    "add {{Number}} mana of any one color. Spend this mana only to cast {{PotentialSpells}}": "ActionList([AddManaRepeatedWithModifiers(AnyManaColor, {{Number[0]}}, CanOnlySpendOnSpells({{PotentialSpells[0]}}))])",
    "add {{Number}} mana of any one color. Until end of turn, you don't lose this mana as steps and phases end": "ActionList([AddManaRepeatedWithModifiers(AnyManaColor, {{Number[0]}}, DontLoseAsStepsAndPhasesEnd(UntilEndOfTurn))])",
    "add {{Number}} {{ManaProduceSymbol}}. Until end of combat, you don't lose this mana as steps end": "ActionList([AddManaRepeatedWithModifiers({{ManaProduceSymbol[0]}}, {{Number[0]}}, DontLoseAsStepsAndPhasesEnd(UntilEndOfCombat))])",
    "add {{Number}} {{ManaProduceSymbol}}. Until end of turn, you don't lose this mana as steps and phases end": "ActionList([AddManaRepeatedWithModifiers({{ManaProduceSymbol[0]}}, {{Number[0]}}, DontLoseAsStepsAndPhasesEnd(UntilEndOfTurn))])",
    "after this main phase, there is an additional combat phase followed by an additional main phase. {{Permanents}} gain {{Hasable}} until end of turn": "ActionList([ThereIsAnAdditionalCombatPhaseAndAnAdditionalMainPhase, CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfCombat)])",
    "airbend up to one target {{Permanent}}": "Targeted([UptoOneTargetPermanent({{Permanent[0]}})], ActionList([AirbendPermanent(Ref_TargetPermanent)]))",
    "all suspected creatures are no longer suspected": "ActionList([UnsuspectEachPermanent(IsCardtype(Creature))])",
    "all {{Creatures}} able to block target {{Creature}} this turn do so": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [AllCreaturesMustBlockIt({{Creatures[0]}})], UntilEndOfTurn)]))",
    "all {{Creatures}} get {{PTMod}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])",
    "all {{Permanents}} gain {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "all {{Permanents}} phase out": "ActionList([PhaseOutEachPermanent({{Permanents[0]}})])",
    "each card you own with {X} in its mana cost perpetually gains \"{{PerpetualQuotedAbility}}\"": "ActionList([CreatePerpetualAllCardsEffect(And([OwnedByAPlayer(SinglePlayer(You)), HasXInManaCost]), [AddAbility([{{PerpetualQuotedAbility[0]}}])])])",
    "all {{SpecificCards}} and {{SpecificCards}} you own perpetually get {{PTMod}}": "ActionList([CreatePerpetualAllCardsEffect(And([Or([{{SpecificCards[0]}}, {{SpecificCards[1]}}]), OwnedByAPlayer(SinglePlayer(You))]), [AdjustPT({{PTMod[0]}})])])",
    "all {{SpecificCards}} you own perpetually become {{Zombie}} kindreds in addition to their other types": "ActionList([CreatePerpetualAllCardsEffect(And([{{SpecificCards[0]}}, OwnedByAPlayer(SinglePlayer(You))]), [AddCreatureType({{Zombie[0]}}), AddCardtype(Kindred)])])",
    "amass Orcs {{Digits}}": "ActionList([Amass({{Digits[0]}}, Orc)])",
    "amass Orcs {{Digits}}, mill {{Number}} cards, then return {{a}} {{SpecificCard}} from your graveyard to the battlefield": "ActionList([Amass({{Digits[0]}}, Orc), MillNumberCards({{Number[0]}}), PutACardFromPlayersGraveyardOnBattlefield({{SpecificCard[0]}}, You, [EntersNormally])])",
    "amass Orcs {{Digits}}. When you do, until end of turn, gain control of target {{Creature}} with power less than or equal to the amassed Army's power. Untap that creature. It gains {{Hasable}} until end of turn": "ActionList([MustCost(Amass({{Digits[0]}}, Orc)), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPermanent(And([{{Creature[0]}}, PowerIs(LessThanOrEqualTo(PowerOfPermanent(TheArmyAmassedThisWay)))]))], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])))])])",
    "amass Slivers {{Digits}}": "ActionList([Amass({{Digits[0]}}, Sliver)])",
    "amass Zombies {{Digits}}": "ActionList([Amass({{Digits[0]}}, Zombie)])",
    "any number of target noncreature artifacts you control become {{PT}} artifact creatures. Sacrifice them at the beginning of the next end step": "Targeted([AnyNumberOfTargetPermanents(And([IsNonCardtype(Creature), IsCardtype(Artifact), ControlledByAPlayer(SinglePlayer(You))]))], ActionList([CreateEachPermanentLayerEffect(Ref_TargetPermanents, [SetPT({{PT[0]}}), AddCardtype(Artifact), AddCardtype(Creature)]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([SacrificeEachPermanent(ThePermanentsAffectedThisWay)]))]))",
    "any number of target opponents each discard a card. For each of those opponents who didn't discard {{a}} {{SpecificCard}}, draw a card": "Targeted([AnyNumberOfTargetPlayers(Opponent)], ActionList([EachPlayerAction(Ref_TargetPlayers, DiscardACard), DrawNumberCards(NumPlayers(DidntDiscardedACardOfTypeThisWay({{SpecificCard[0]}})))]))",
    "any number of target players each create {{a}} {{PT}} {{CreatureToken}}": "Targeted([AnyNumberOfTargetPlayers(AnyPlayer)], ActionList([EachPlayerAction(Ref_TargetPlayers, CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])]))]))",
    "any number of target players each discard a card": "Targeted([AnyNumberOfTargetPlayers(AnyPlayer)], ActionList([EachPlayerAction(Ref_TargetPlayers, DiscardACard)]))",
    "any number of target players each discard their hands. Each opponent draws cards equal to the number of cards that player discarded minus one. Then if you discarded a card this way, draw {{Number}} cards": "Targeted([AnyNumberOfTargetPlayers(AnyPlayer)], ActionList([EachPlayerAction(Ref_TargetPlayers, DiscardHand), EachPlayerAction(Opponent, DrawNumberCards(Minus(TheNumberOfCardsPlayerDiscardedThisWay(EachablePlayer), Integer(1)))), If(PlayerPassesFilter(You, DiscardedACardThisWay), [DrawNumberCards({{Number[0]}})])]))",
    "any number of target players each mill a card and lose {{Digits}} life": "Targeted([AnyNumberOfTargetPlayers(AnyPlayer)], ActionList([EachPlayerActions(Ref_TargetPlayers, [MillACard, LoseLife({{Digits[0]}})])]))",
    "any number of target players each mill {{Number}} cards. If {{Condition}}, each of those players mills {{Number}} cards instead": "Targeted([AnyNumberOfTargetPlayers(AnyPlayer)], ActionList([IfElse({{Condition[0]}}, [EachPlayerAction(Ref_TargetPlayers, MillNumberCards({{Number[1]}}))], [EachPlayerAction(Ref_TargetPlayers, MillNumberCards({{Number[0]}}))])]))",
    "as you cast spells from your hand this turn, they gain cascade": "ActionList([CreateEachSpellEffect(CastByPlayerFromHand(You, You), [Cascade], UntilEndOfTurn)])",
    "attach all Auras enchanting target permanent to another permanent with the same controller": "Targeted([TargetPermanent(AnyPermanent)], ActionList([AttachEachPermanentToAPermanent(And([IsEnchantmentType(Aura), IsEnchantingPermanent(Ref_TargetPermanent)]), And([Other(Ref_TargetPermanent), ControlledByPlayer(ControllerOfPermanent(Ref_TargetPermanent))]))]))",
    "attach any number of target Equipment you control to target creature you control. When one or more Equipment become attached to that creature this way, that creature deals damage equal to its power to up to one target creature": "Targeted([AnyNumberOfTargetPermanents(And([IsArtifactType(Equipment), ControlledByAPlayer(SinglePlayer(You))])), TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))], ActionList([ReflexiveActionTrigger(AttachEachPermanentToPermanent(Ref_TargetPermanents, Ref_TargetPermanent), Targeted([UptoOneTargetPermanent(IsCardtype(Creature))], ActionList([PermanentDealsDamage(RefOuter_TargetPermanent, PowerOfPermanent(RefOuter_TargetPermanent), Permanent(Ref_TargetPermanent))])))]))",
    "attach target {{Permanent}} to up to one target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}}), UptoOneTargetPermanent({{Permanent[1]}})], ActionList([AttachPermanentToPermanent(Ref_TargetPermanent1, Ref_TargetPermanent2)]))",
    "attach up to one target {{Artifact}} to target {{Permanent}}": "Targeted([UptoOneTargetPermanent({{Artifact[0]}}), TargetPermanent({{Permanent[0]}})], ActionList([AttachPermanentToPermanent(Ref_TargetPermanent1, Ref_TargetPermanent2)]))",
    "blight {{Digits}}": "ActionList([Blight({{Digits[0]}})])",
    "bolster X, where X is {{GameNumber}}": "ActionList([Bolster({{GameNumber[0]}})])",
    "bolster {{Digits}}": "ActionList([Bolster({{Digits[0]}})])",
    "cards can't enter from exile this turn. Then planeswalk": "ActionList([CreateGameEffect(UntilEndOfTurn, CardsCantEnterTheBattlefieldFromExile(AnyCard)), Planeswalk])",
    "cards you own named {{NamedCard}} intensify by {{Digits}}": "ActionList([PerpetuallyIncreaseIntensityOfCardsOwnedByPlayer(IsNamed(NamedCard({{NamedCard[0]}})), You, {{Digits[0]}})])",
    "change the target of target {{StackSpellOrAbility}}": "Targeted([TargetSpellOrAbility({{StackSpellOrAbility[0]}})], ActionList([ChangeTheTargetOfSpellOrAbility(Ref_TargetSpellOrAbility)]))",
    "chaos ensues": "ActionList([ChaosEnsues])",
    "choose a card at random in your graveyard. If it's {{a}} {{SpecificCard}}, put it onto the battlefield. Otherwise, put it into your hand": "ActionList([ChooseACardInPlayersGraveyardAtRandom(AnyCard, You), IfElse(TheChosenGraveyardCardPassesFilter({{SpecificCard[0]}}), [PutGraveyardCardOntoBattlefield(TheChosenGraveyardCard, [EntersNormally])], [ReturnGraveyardCardToHand(TheChosenGraveyardCard)])])",
    "choose a card in your hand. It perpetually gains {{PerpetualHasable}}": "ActionList([ChooseACardInHand(AnyCard), CreatePerpetualCardInHandEffect(TheChosenCardInHand, [AddAbility([{{PerpetualHasable[0]}}])])])",
    "choose a card name. {{PotentialSpells[TheChosenName]}} cost {{CostReduce}} less to cast this turn": "ActionList([ChooseACardName(AnyOracleCard), CreateEachPlayerEffectUntil(AnyPlayer, [DecreaseSpellCost({{PotentialSpells[TheChosenName][0]}}, {{CostReduce[0]}})], UntilEndOfTurn)])",
    "choose a card type, then reveal the top {{Number}} cards of your library. Put all cards of the chosen type revealed this way into your hand and the rest on the bottom of your library in any order": "ActionList([ChooseACardtype, RevealTheTopNumberCardsOfLibrary({{Number[0]}}, [PutEachCardOfTypeIntoHand(IsCardtypeVariable(TheChosenCardtype)), PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder])])",
    "choose a color. Add an amount of mana of that color equal to your devotion to that color": "ActionList([ChooseAColor(AnyColor), AddManaRepeated(ManaOfTheChosenColor, PlayerDevotionTo(You, TheChosenColor))])",
    "choose a color. Put X {{CounterType}} counters on target {{Creature}}, where X is your devotion to that color. Then sacrifice another creature": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([ChooseAColor(AnyColor), PutNumberCountersOfTypeOnPermanent(PlayerDevotionTo(You, TheChosenColor), {{CounterType[0]}}, Ref_TargetPermanent), SacrificeAPermanent(And([Other(Ref_TargetPermanent), IsCardtype(Creature)]))]))",
    "choose a counter on target permanent. Put an additional counter of that kind on that permanent": "Targeted([TargetPermanent(AnyPermanent)], ActionList([PutADuplicateCounterOnPermanent(Ref_TargetPermanent)]))",
    "choose a counter on {{a}} {{Permanent}}. Put a counter of that kind on target {{Permanent}} if it doesn't have a counter of that kind on it": "Targeted([TargetPermanent({{Permanent[1]}})], ActionList([ChooseACounterTypeOnAPermanent({{Permanent[0]}}), If(PermanentPassesFilter(Ref_TargetPermanent, HasNoCountersOfType(TheChosenCounterType)), [PutACounterOfTypeOnPermanent(TheChosenCounterType, Ref_TargetPermanent)])]))",
    "choose a creature card in your hand without blitz. It perpetually gains blitz. The blitz cost is equal to its mana cost": "ActionList([ChooseACardInHand(And([IsCardtype(Creature), DoesntHaveAbility(AnyBlitz)])), CreatePerpetualCardInHandEffect(TheChosenCardInHand, [AddAbility([Blitz(ItsManaCost)])])])",
    "choose a creature type. Draw a card for each creature you control of that type": "ActionList([ChooseACreatureType, DrawNumberCards(TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), IsCreatureTypeVariable(TheChosenCreatureType)])))])",
    "choose a creature type. Put {{a}} {{CounterType}} counter on each creature you control of that type": "ActionList([ChooseACreatureType, PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), IsCreatureTypeVariable(TheChosenCreatureType)]))])",
    "choose a creature type. Shuffle all creature cards of that type from your graveyard into your library": "ActionList([ChooseACreatureType, ShuffleEachCardInGraveyardIntoLibrary(And([IsCardtype(Creature), IsCreatureTypeVariable(TheChosenCreatureType)]))])",
    "choose a creature with the least toughness among creatures your opponents control. It perpetually gets {{PTMod}}": "ActionList([ChooseAPermanent(ToughnessIs(EqualTo(TheLeastToughnessAmongPermanents(And([IsCardtype(Creature), ControlledByAPlayer(Opponent)]))))), CreatePermanentLayerEffect(ThePermanentChosenThisWay, [AdjustPT({{PTMod[0]}})])])",
    "choose a land of each basic land type, then destroy those lands": "ActionList([ChooseAPermanentOfEachBasicLandTypeAvailable(IsCardtype(Land)), DestroyEachPermanent(TheChosenPermanents)])",
    "choose a planeswalker type. Until end of turn, whenever you activate an ability of a planeswalker of that type, copy that ability. You may choose new targets for the copies": "ActionList([ChooseAPlaneswalkerType, CreateTriggerUntil(WhenAPlayerActivatesAnAbility(SinglePlayer(You), AbilityOfAPermanent(And([IsCardtype(Planeswalker), IsPlaneswalkerTypeVariable(TheChosenPlaneswalkerType)]))), ActionList([CopyAbilityAndMayChooseNewTargets(Trigger_ThatAbility)]), UntilEndOfTurn)])",
    "choose a player at random. That player exiles {{a}} {{SpecificCard}} from their graveyard. Copy that card. You may cast the copy without paying its mana cost": "ActionList([ChooseAPlayerAtRandom(AnyPlayer), PlayerAction(TheChosenPlayer, Exile([AGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(ActionPlayer))]))])), CopyExiledCard(TheCardExiledThisWay), MayAction(CastCopiedCardWithoutPaying)])",
    "choose a player. That player adds {{Number}} mana of any one color they choose": "ActionList([ChooseAPlayer(AnyPlayer), PlayerAction(TheChosenPlayer, AddManaRepeated(AnyManaColor, {{Number[0]}}))])",
    "choose a player. They put {{Number}} {{CounterType}} counters on {{a}} {{Permanent}} they control. Choose a second player to draw a card. Then choose a third player to create {{Number}} Treasure tokens": "ActionList([ChooseAPlayer(AnyPlayer), PlayerAction(TheFirstPlayerChosenThisWay, PutNumberCountersOfTypeOnAPermanent({{Number[0]}}, {{CounterType[0]}}, And([{{Permanent[0]}}, ControlledByPlayer(PlayerAction_ThatPlayer)]))), ChooseAPlayer(Other(TheFirstPlayerChosenThisWay)), PlayerAction(TheSecondPlayerChosenThisWay, DrawACard), ChooseAPlayer(And([Other(TheFirstPlayerChosenThisWay), Other(TheSecondPlayerChosenThisWay)])), PlayerAction(TheThirdPlayerChosenThisWay, CreateTokens([NumberTokens({{Number[1]}}, TreasureToken)]))])",
    "choose an opponent at random. Exile the top card of that player's library. Until end of turn, you may play that card and you may spend mana as though it were mana of any color to cast it. When you cast a spell this way, its owner loses life equal to its mana value": "ActionList([ChooseAPlayerAtRandom(Opponent), ExileTheTopCardOfPlayersLibrary(TheChosenPlayer), CreatePlayerEffectUntil(You, [MayPlayExiledCardAndMaySpendManaAsThoughAnyColorToCastWithTrigger(TheCardExiledThisWay, ActionList([PlayerAction(OwnerOfExiledCard(TheCardExiledThisWay), LoseLife(ManaValueOfExiled(TheCardExiledThisWay)))]))], UntilEndOfTurn)])",
    "choose an opponent who controls more lands than you. Search your library for a number of {{SpecificCards}} equal to the difference, reveal those cards, put one of them onto the battlefield tapped and the rest into your hand, then shuffle": "ActionList([ChooseAPlayer(And([Opponent, ControlsMorePermanentThanPlayer(You, IsCardtype(Land))])), SearchLibrary([FindNumberCardsOfType(Minus(TheNumberOfCardsInPlayersHand(TheChosenPlayer), TheNumberOfCardsInPlayersHand(You)), {{SpecificCards[0]}}), RevealFoundCards, PutAFoundCardOntoBattlefield([EntersTapped]), PutFoundCardsIntoHand, Shuffle])])",
    "choose an opponent with the highest life total among your opponents. That player loses {{Digits}} life": "ActionList([APlayerAction(And([Opponent, LifeTotalIs(EqualTo(HighestLifeTotalAmongPlayers(Opponent)))]), LoseLife({{Digits[0]}}))])",
    "choose an opponent. At the beginning of that player's next end step, you draw a card if they didn't attack you that turn. Otherwise, create {{Number}} {{PT}} {{CreatureTokens}}": "ActionList([ChooseAPlayer(Opponent), CreateFutureTrigger(AtTheBeginningOfPlayersNextEndStep(TheChosenPlayer), ActionList([IfElse(PlayerPassesFilter(TheChosenPlayer, DidntAttackPlayerThisTurn(You)), [DrawACard], [CreateTokens([NumberTokens({{Number[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])])]))])",
    "choose an opponent. If that player has more cards in hand than you, draw cards equal to the difference": "ActionList([ChooseAPlayer(Opponent), If(PlayerPassesFilter(TheChosenPlayer, NumCardsInHandIs(GreaterThan(TheNumberOfCardsInPlayersHand(You)))), [DrawNumberCards(Minus(TheNumberOfCardsInPlayersHand(TheChosenPlayer), TheNumberOfCardsInPlayersHand(You)))])])",
    "choose any number -\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}": "Modal_ChooseAnyNumber([{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal[1]}}, {{TriggerActions_Modal[2]}}])",
    "choose any number of creatures with different mana values. Destroy those creatures": "ActionList([ChooseAnyNumberOfGroupPermanents(IsCardtype(Creature), DifferentManaValues), DestroyEachPermanent(ThePermanentsChosenThisWay)])",
    "choose any number of target {{Planeswalkers}}. Until end of turn, they become {{PT}} {{Black}} {{Zombie}} creatures with {{Hasable}}, {{Hasable}}, and \"{{QuotedAbility}}\"": "Targeted([AnyNumberOfTargetPermanents({{Planeswalkers[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [SetPT({{PT[0]}}), SetColor(SimpleColorList([{{Black[0]}}])), SetCreatureType({{Zombie[0]}}), SetCardtype(Creature), AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)]))",
    "choose any number of {{Creatures}} with different powers. Those creatures gain {{Hasable}} until end of turn": "ActionList([ChooseAnyNumberOfGroupPermanents({{Creatures[0]}}, DifferentPowers), CreateEachPermanentLayerEffectUntil(TheChosenPermanents, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "choose creatures you control one at a time until each creature you control has been chosen. Each of those creatures gets {{PTMod}} until end of turn for each creature chosen before it": "ActionList([NumberEachPermanentStartingFromZero(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))])), CreateEachPermanentLayerEffectUntil(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]), [AdjustPTForEach({{PTMod[0]}}, TheNumberChosenForPermanent(ActionPermanent))], UntilEndOfTurn)])",
    "choose land or nonland. Seek a permanent card of the chosen kind": "ActionList([ChooseLibraryFilter([IsCardtype(Land), IsNonCardtype(Land)]), SeekACard(And([IsPermanent, TheChosenLibraryFilter]))])",
    "choose left or right": "ActionList([ChooseLeftOrRight])",
    "choose odd or even. Creatures with mana value of that quality can't block this turn": "ActionList([ChooseEvenOrOdd, CreateEachPermanentRuleEffectUntil(And([IsCardtype(Creature), ManaValueIs(TheChosenQuality)]), [CantBlock], UntilEndOfTurn)])",
    "choose one -\n* {{FlavorWord}} - {{TriggerActions_Modal}}.\n* {{FlavorWord}} - {{TriggerActions_Modal}}": "Modal_ChooseOne([{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal[1]}}])",
    "choose one -\n* {{FlavorWord}} - {{TriggerActions_Modal}}.\n* {{FlavorWord}} - {{TriggerActions_Modal}}.\n* {{FlavorWord}} - {{TriggerActions_Modal}}": "Modal_ChooseOne([{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal[1]}}, {{TriggerActions_Modal[2]}}])",
    "choose one -\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}": "Modal_ChooseOne([{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal[1]}}])",
    "choose one -\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}": "Modal_ChooseOne([{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal[1]}}, {{TriggerActions_Modal[2]}}])",
    "choose one -\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}": "Modal_ChooseOne([{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal[1]}}, {{TriggerActions_Modal[2]}}, {{TriggerActions_Modal[3]}}])",
    "choose one -\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}. {{Reminder}}\n* {{TriggerActions_Modal}}": "Modal_ChooseOne([{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal[1]}}, {{TriggerActions_Modal[2]}}])",
    "choose one -\n* {{TriggerActions_Modal}}. {{Reminder}}\n* {{TriggerActions_Modal}}": "Modal_ChooseOne([{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal[1]}}])",
    "choose one -\n* {{TriggerActions_Modal}}. {{Reminder}}\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}": "Modal_ChooseOne([{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal[1]}}, {{TriggerActions_Modal[2]}}])",
    "choose one at random -\n* {{FlavorWord}} - {{TriggerActions_Modal}}.\n* {{FlavorWord}} - {{TriggerActions_Modal}}.\n* {{FlavorWord}} - {{TriggerActions_Modal}}.\n* {{FlavorWord}} - {{TriggerActions_Modal}}": "Modal_ChooseOneAtRandom([{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal[1]}}, {{TriggerActions_Modal[2]}}, {{TriggerActions_Modal[3]}}])",
    "choose one at random. Create {{a}} {{Black}} and {{Black}} creature token with those characteristics.\n* {{PT}} {{Zombie}} {{Zombie}} with {{Hasable}} and {{Hasable}}.\n* {{PT}} {{Zombie}} {{Zombie}} with {{Hasable}} and {{Hasable}}.\n* {{PT}} {{Zombie}} {{Zombie}} with {{Hasable}} and \"{{TokenQuotedAbility}}\"": "Modal_ChooseOneAtRandom([ActionList([CreateTokens([TokenWithPT({{PT[0]}}, Colors([{{Black[0]}}, {{Black[1]}}]), [], [Creature], SubtypesList([{{Zombie[0]}}, {{Zombie[1]}}]), [{{Hasable[0]}}, {{Hasable[1]}}])])]), ActionList([CreateTokens([TokenWithPT({{PT[1]}}, Colors([{{Black[0]}}, {{Black[1]}}]), [], [Creature], SubtypesList([{{Zombie[2]}}, {{Zombie[3]}}]), [{{Hasable[2]}}, {{Hasable[3]}}])])]), ActionList([CreateTokens([TokenWithPT({{PT[2]}}, Colors([{{Black[0]}}, {{Black[1]}}]), [], [Creature], SubtypesList([{{Zombie[4]}}, {{Zombie[5]}}]), [{{Hasable[4]}}, {{TokenQuotedAbility[0]}}])])])])",
    "choose one or both -\n* {{FlavorWord}} - {{TriggerActions_Modal}}.\n* {{FlavorWord}} - {{TriggerActions_Modal}}": "Modal_ChooseOneOrBoth([{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal[1]}}])",
    "choose one or both -\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}": "Modal_ChooseOneOrBoth([{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal[1]}}])",
    "choose one or both. Each mode must target a different player.\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}": "Modal_ChooseOneOrMore_DifferentTargets([{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal[1]}}])",
    "choose one or more -\n* {{FlavorWord}} - {{TriggerActions_Modal}}.\n* {{FlavorWord}} - {{TriggerActions_Modal}}.\n* {{FlavorWord}} - {{TriggerActions_Modal}}": "Modal_ChooseOneOrMore([{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal[1]}}, {{TriggerActions_Modal[2]}}])",
    "choose one or more -\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}": "Modal_ChooseOneOrMore([{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal[1]}}, {{TriggerActions_Modal[2]}}])",
    "choose one or more. Each mode must target a different player.\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}": "Modal_ChooseOneOrMore_DifferentTargets([{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal[1]}}, {{TriggerActions_Modal[2]}}])",
    "choose one that hasn't been chosen -\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}": "Modal_ChooseOneThatHasntBeenChosen([{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal[1]}}, {{TriggerActions_Modal[2]}}])",
    "choose one that hasn't been chosen this turn -\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}": "Modal_ChooseOneThatHasntBeenChosenThisTurn([{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal[1]}}, {{TriggerActions_Modal[2]}}])",
    "choose one that hasn't been chosen this turn. Create a creature token with those characteristics.\n* {{PT}} {{Black}} {{Zombie}} with {{Hasable}}.\n* {{PT}} {{Black}} {{Zombie}} with {{Hasable}}.\n* {{PT}} {{Black}} {{Zombie}} with {{Hasable}}":
      "Modal_ChooseOneThatHasntBeenChosenThisTurn([ActionList([CreateTokens([TokenWithPT({{PT[0]}}, Colors([{{Black[0]}}]), [], [Creature], SubtypesList([{{Zombie[0]}}]), [{{Hasable[0]}}])])]), ActionList([CreateTokens([TokenWithPT({{PT[1]}}, Colors([{{Black[1]}}]), [], [Creature], SubtypesList([{{Zombie[1]}}]), [{{Hasable[1]}}])])]), ActionList([CreateTokens([TokenWithPT({{PT[2]}}, Colors([{{Black[2]}}]), [], [Creature], SubtypesList([{{Zombie[2]}}]), [{{Hasable[2]}}])])])])",
    "choose one that wasn't chosen during your last combat -\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}": "Modal_ChooseOneThatWasntChosenDuringPlayersLastCombat(You, [{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal[1]}}])",
    "choose one that wasn't chosen during your last combat -\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}": "Modal_ChooseOneThatWasntChosenDuringPlayersLastCombat(You, [{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal[1]}}, {{TriggerActions_Modal[2]}}])",
    "choose one. If {{Condition}}, choose both instead.\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}": "Modal_ChooseOneOrBothIf({{Condition[0]}}, [{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal[1]}}])",
    "choose one. If {{Condition}}, you may choose both instead.\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}": "Modal_ChooseOneOrBothIf({{Condition[0]}}, [{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal[1]}}])",
    "choose target creature an opponent controls. Tap it, then you may sacrifice {{a}} {{Permanent}}. If you do, put {{a}} {{CounterType}} counter on the chosen creature": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(Opponent)]))], ActionList([TapPermanent(Ref_TargetPermanent), MayCost(SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent)])]))",
    "choose target creature attacking you. Put {{a}} {{CounterType}} counter on that creature": "Targeted([TargetPermanent(And([IsCardtype(Creature), IsAttackingPlayer(You)]))], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent)]))",
    "choose target creature you control. If damage would be dealt to that creature this turn, prevent that damage and put that many {{CounterType}} counters on it": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))], ActionList([CreatePreventDamageUntil(DamageWouldBeDealtToRecipient(Permanent(Ref_TargetPermanent)), [PreventThatDamage, PutNumberCountersOfTypeOnPermanent(TheAmountOfDamagePreventedThisWay, {{CounterType[0]}}, Ref_TargetPermanent)], UntilEndOfTurn)]))",
    "choose target face-up exiled card. Its owner shuffles it into their library": "Targeted([TargetExiledCard(IsFaceUp)], ActionList([ShuffleExiledCardIntoLibrary(Ref_TargetExiledCard)]))",
    "choose target opponent. If they lost life this turn, they reveal their hand, you choose {{a}} {{SpecificCard}} from it, and they discard that card. Otherwise, they discard a card": "Targeted([TargetPlayer(Opponent)], ActionList([IfElse(PlayerPassesFilter(Ref_TargetPlayer, LostLifeThisTurn), [PlayerAction(Ref_TargetPlayer, RevealHandAndPlayerChoosesACardToDiscard(You, {{SpecificCard[0]}}))], [PlayerAction(Ref_TargetPlayer, DiscardACard)])]))",
    "choose target opponent. Secretly choose {{a}} {{Permanent}} that player controls. That player sacrifices {{a}} {{Permanent}} of their choice, then sacrifices the chosen permanent": "Targeted([TargetPlayer(Opponent)], ActionList([ChooseAPermanent(And([{{Permanent[0]}}, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))])), PlayerActions(Ref_TargetPlayer, [SacrificeAPermanent({{Permanent[0]}}), SacrificePermanent(ThePermanentChosenThisWay)])]))",
    "choose target opponent. This turn, that player can't cast spells or activate abilities and plays with their hand revealed. You may play lands and cast spells from that player's hand this turn": "Targeted([TargetPlayer(Opponent)], ActionList([CreatePlayerEffectUntil(Ref_TargetPlayer, [CantCastSpells(AnySpell), CantActivateAbilities(AnyAbility), PlaysWithHandRevealed], UntilEndOfTurn), CreatePlayerEffectUntil(You, [CanPlayLandsFromRevealedHandOfPlayer(Ref_TargetPlayer), CanCastSpellsFromRevealedHandOfPlayer(Ref_TargetPlayer)], UntilEndOfTurn)]))",
    "choose target opponent. Until end of turn, that player can't cast spells, you may look at the top card of their library any time, you may play the top card of their library, and you may spend mana as though it were mana of any color to cast spells this way": "Targeted([TargetPlayer(Opponent)], ActionList([CreatePlayerEffectUntil(Ref_TargetPlayer, [CantCastSpells(AnySpell)], UntilEndOfTurn), CreatePlayerEffectUntil(You, [MayLookAtAndPlayCardsFromTheTopOfOtherPlayersLibraryAndMaySpendManaAsThoughAnyColorToCast(Ref_TargetPlayer)], UntilEndOfTurn)]))",
    "choose target opponent. You get an amount of {E} (energy counters) equal to {{GameNumber(ThatPlayer)}}": "Targeted([TargetPlayer(Opponent)], ActionList([GetEnergy({{GameNumber(ThatPlayer=Ref_TargetPlayer)[0]}})]))",
    "choose target player and any number of target attacking creatures their opponents control. Those creatures are now attacking that player": "Targeted([TargetPlayer(AnyPlayer), AnyNumberOfTargetPermanents(And([IsAttacking, IsCardtype(Creature), ControlledByAPlayer(OpponentOf(Ref_TargetPlayer))]))], ActionList([SetAttackAssignmentOfCreatures(Ref_TargetPermanents, Player(Ref_TargetPlayer))]))",
    "choose target player. You create a tapped Powerstone token for each {{Eachable(ThatPlayer)}}": "Targeted([TargetPlayer(AnyPlayer)], ActionList([CreateTokensWithFlags([NumberTokens({{Eachable(ThatPlayer=Ref_TargetPlayer)[0]}}, PowerstoneToken)], [EntersTapped])]))",
    "choose target spell or ability that targets only a single permanent or player. Copy that spell or ability for each other permanent or player the spell or ability could target. Each copy targets a different one of those permanents and players": "Targeted([TargetSpellOrAbility(TargetsOnlyASinglePermanentOrPlayer)], ActionList([CopySpellOrAbilityForEachPermanentOrPlayerItCouldTarget(Ref_TargetSpellOrAbility)]))",
    "choose target {{Creature}} and tap it. If {{Condition}}, the chosen creature doesn't untap during its controller's next untap step": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), If({{Condition[0]}}, [PermanentDoesntUntapDuringControllersNextUntap(Ref_TargetPermanent)])]))",
    "choose target {{Creature}}, then roll a d20.\n{{RawDigits}}-{{RawDigits}} | Create a tapped and attacking token that's a copy of that creature, except it's not legendary and it has \"{{TokenQuotedAbility}}\".\n{{RawDigits}}-{{RawDigits}} | Create one of those tokens. You may roll again": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([RepeatableActions([RollAD20, ValueActions(TheDiceResult, [ValueAction(BetweenValues({{RawDigits[0]}}, {{RawDigits[1]}}), [CreateTokensWithFlags([TokenCopyOfPermanent(Ref_TargetPermanent, TokenCopyEffects([RemoveSupertypes([Legendary]), AddAbility([{{TokenQuotedAbility[0]}}])]))], [EntersTapped, EntersAttacking])]), ValueAction(BetweenValues({{RawDigits[2]}}, {{RawDigits[3]}}), [CreateTokensWithFlags([TokenCopyOfPermanent(Ref_TargetPermanent, TokenCopyEffects([RemoveSupertypes([Legendary]), AddAbility([{{TokenQuotedAbility[0]}}])]))], [EntersTapped, EntersAttacking]), MayAction(RepeatThisProcess)])])])]))",
    "choose target {{Creature}}, then roll a d20.\n{{RawDigits}}-{{RawDigits}} | Tap that creature.\n{{RawDigits}}-{{RawDigits}} | Tap that creature. It doesn't untap during its controller's next untap step": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([RollAD20, ValueActions(TheDiceResult, [ValueAction(BetweenValues({{RawDigits[0]}}, {{RawDigits[1]}}), [TapPermanent(Ref_TargetPermanent)]), ValueAction(BetweenValues({{RawDigits[2]}}, {{RawDigits[3]}}), [TapPermanent(Ref_TargetPermanent), PermanentDoesntUntapDuringControllersNextUntap(Ref_TargetPermanent)])])]))",
    "choose target {{Creature}}. Each player except that creature's controller creates a token that's a copy of that creature": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([EachPlayerAction(Other(ControllerOfPermanent(Ref_TargetPermanent)), CreateTokens([TokenCopyOfPermanent(Ref_TargetPermanent, NoTokenCopyEffects)]))]))",
    "choose target {{Creature}}. Each {{Creature}} deals {{Digits}} damage to that creature": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([EachPermanentDealsDamage({{Creature[1]}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent))]))",
    "choose target {{Creature}}. Until end of turn, it gains \"{{QuotedAbility[ThisCreature]}}\" and \"{{QuotedAbility[ThisCreature]}}\"": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{QuotedAbility[ThisCreature][0]}}]), AddAbility([{{QuotedAbility[ThisCreature][1]}}])], UntilEndOfTurn)]))",
    "choose target {{Creature}}. Until end of turn, that creature has base power and toughness {{PT}} and gains {{Hasable}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [SetPT({{PT[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "choose target {{PermanentCard}} in your graveyard. Return that card to the battlefield if its mana value is less than or equal to {{GameNumber}}. Otherwise, put it into your hand": "Targeted([TargetGraveyardCard(And([{{PermanentCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([IfElse(GraveyardCardPassesFilter(Ref_TargetGraveyardCard, ManaValueIs(LessThanOrEqualTo({{GameNumber[0]}}))), [PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersNormally])], [PutGraveyardCardIntoHand(Ref_TargetGraveyardCard)])]))",
    "choose target {{Permanent}} and up to {{Number}} target {{Permanents}}. Destroy one of them at random": "Targeted([TargetPermanent({{Permanent[0]}}), UptoNumberTargetPermanents({{Number[0]}}, {{Permanents[0]}})], ActionList([DestroyAPermanentAtRandom(Or([SinglePermanent(Ref_TargetPermanent), Ref_TargetPermanents]))]))",
    "choose target {{Permanent}}. If {{Condition(ThatPermanent)}}, put {{a}} {{CounterType}} counter on it. Otherwise, tap it": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([IfElse({{Condition(ThatPermanent=Ref_TargetPermanent)[0]}}, [PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent)], [TapPermanent(Ref_TargetPermanent)])]))",
    "choose target {{Permanent}}. Until end of turn, it becomes a Vehicle artifact with base power and toughness each equal to its mana value, and it gains crew {{RawDigits}} and \"{{FlavorWord}} - {{QuotedAbility}}\"": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [SetArtifactType(Vehicle), SetCardtype(Artifact), SetPowerAndToughnessBoth(ManaValueOfPermanent(ThisPermanent)), AddAbility([Crew({{RawDigits[0]}})]), AddAbility([{{QuotedAbility[0]}}])], UntilEndOfTurn)]))",
    "choose target {{Permanent}}. Until your next turn, it can't attack or block, and its activated abilities can't be activated": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [CantAttack, CantBlock, AbilitiesCantBeActivated], UntilEndOfTurn)]))",
    "choose target permanent card in your graveyard that was put there from anywhere this turn. Return it to your hand":
      "Targeted([TargetGraveyardCard(And([IsPermanent, InAPlayersGraveyard(SinglePlayer(You)), WasPutIntoGraveyardFromAnywhereThisTurn]))], ActionList([PutGraveyardCardIntoHand(Ref_TargetGraveyardCard)]))",
    "choose target {{SpecificCard}} in an opponent's graveyard that was put there from their library this turn. Put it onto the battlefield under your control": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(Opponent), WasPutIntoGraveyardFromLibraryThisTurn]))], ActionList([PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersUnderPlayersControl(You)])]))",
    "choose target {{SpecificCard}} in your graveyard that was put there from the battlefield this turn. Return it to the battlefield. It perpetually gains \"{{PerpetualQuotedAbility}}\"": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You)), WasPutIntoGraveyardFromTheBattlefieldThisTurn]))], ActionList([PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersNormally]), CreatePerpetualPermanentEffect(ThePermanentPutOnTheBattlefieldThisWay, [AddAbility([{{PerpetualQuotedAbility[0]}}])])]))",
    "choose target {{SpecificCard}} in your graveyard, then roll a d20.\n{{RawDigits}}-{{RawDigits}} | You may put that card on top of your library.\n{{RawDigits}}-{{RawDigits}} | Return that card to your hand": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([RollAD20, ValueActions(TheDiceResult, [ValueAction(BetweenValues({{RawDigits[0]}}, {{RawDigits[1]}}), [PutGraveyardCardOnTopOfLibrary(Ref_TargetGraveyardCard)]), ValueAction(BetweenValues({{RawDigits[2]}}, {{RawDigits[3]}}), [PutGraveyardCardIntoHand(Ref_TargetGraveyardCard)])])]))",
    "choose target {{SpecificCard}} in your graveyard. Conjure a duplicate of it into your graveyard": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([ConjureDuplicateOfGraveyardCardIntoPlayersGraveyard(Ref_TargetGraveyardCard, You)]))",
    "choose target {{SpecificCard}} in your graveyard. If that card's mana value is less than or equal to {{GameNumber}}, return it to the battlefield. Otherwise, put it into your hand": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([IfElse(GraveyardCardPassesFilter(Ref_TargetGraveyardCard, ManaValueIs(LessThanOrEqualTo({{GameNumber[0]}}))), [PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersNormally])], [PutGraveyardCardIntoHand(Ref_TargetGraveyardCard)])]))",
    "choose target {{SpecificCard}} in your graveyard. You may cast that card this turn": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([CreatePlayerEffectUntil(You, [MayCastGraveyardCard(Ref_TargetGraveyardCard)], UntilEndOfTurn)]))",
    "choose target {{SpecificCard}} in your graveyard. You may sacrifice a permanent that shares a card type with the chosen card. If you do, return the chosen card from your graveyard to the battlefield and it gains \"{{QuotedAbility}}\"": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([MayCost(SacrificeAPermanent(SharesACardtypeWithGraveyardCard(Ref_TargetGraveyardCard))), If(CostWasPaid, [PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersNormally]), CreatePermanentLayerEffect(ThePermanentPutOnTheBattlefieldThisWay, [AddAbility([{{QuotedAbility[0]}}])])])]))",
    "choose target {{SpecificCard}} in your graveyard. You may sacrifice {{a}} {{Permanent}}. If you do, return the chosen card to the battlefield": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([MayCost(SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersNormally])])]))",
    "choose three. You may choose the same mode more than once.\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}": "Modal_ChooseNumberMayChooseSameModeMoreThanOnce(Integer(3), [{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal[1]}}, {{TriggerActions_Modal[2]}}])",
    "choose two -\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}": "Modal_ChooseTwo([{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal[1]}}, {{TriggerActions_Modal[2]}}, {{TriggerActions_Modal[3]}}])",
    "choose up to one -\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}": "Modal_ChooseOne([{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal[1]}}])",
    "choose up to one -\n* {{TriggerActions_Modal}}. {{Reminder}}\n* {{TriggerActions_Modal}}": "Modal_ChooseOne([{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal[1]}}])",
    "choose up to one target Mount or Vehicle you control. Until end of turn, that permanent becomes saddled if it's a Mount and becomes an artifact creature if it's a Vehicle": "Targeted([UptoOneTargetPermanent(Or([IsCreatureType(Mount), IsArtifactType(Vehicle)]))], ActionList([If(PermanentPassesFilter(Ref_TargetPermanent, IsCreatureType(Mount)), [SaddlePermanent(Ref_TargetPermanent)]), If(PermanentPassesFilter(Ref_TargetPermanent, IsArtifactType(Vehicle)), [CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddCardtype(Artifact), AddCardtype(Creature)], UntilEndOfTurn)])]))",
    "choose up to one target Vehicle you control. Until end of turn, it becomes an artifact creature and gains {{Hasable}}": "Targeted([UptoOneTargetPermanent(And([IsArtifactType(Vehicle), ControlledByAPlayer(SinglePlayer(You))]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddCardtype(Artifact), AddCardtype(Creature), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "choose up to one target card in a graveyard that was discarded or put there from a library this turn. Put that card into its owner's hand": "Targeted([TargetGraveyardCard(Or([WasDiscardedIntoGraveyardThisTurn, WasPutIntoGraveyardFromLibraryThisTurn]))], ActionList([PutGraveyardCardIntoHand(Ref_TargetGraveyardCard)]))",
    "choose up to one target {{Creature}} and up to one target {{Creature}}. Each of those creatures deals damage equal to its toughness to the other": "Targeted([UptoOneTargetPermanent({{Creature[0]}}), UptoOneTargetPermanent({{Creature[0]}})], ActionList([PermanentDealsDamageAndPermanentDealsDamage(Ref_TargetPermanent1, ToughnessOfPermanent(Ref_TargetPermanent1), Permanent(Ref_TargetPermanent2), Ref_TargetPermanent2, ToughnessOfPermanent(Ref_TargetPermanent2), Permanent(Ref_TargetPermanent1))]))",
    "choose up to one target {{Creature}}. That creature can't be blocked this turn and has base power and toughness {{PT}} until end of turn": "Targeted([UptoOneTargetPermanent({{Creature[0]}})], ActionList([CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [CantBeBlocked], UntilEndOfTurn), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [SetPT({{PT[0]}})], UntilEndOfTurn)]))",
    "choose up to one target {{Creature}}. Until end of turn, that creature gets {{PTMod}}, gains {{Hasable}} if {{Condition(ThatPermanent)}}, and gains {{Hasable}} if {{Condition(ThatPermanent)}}": "Targeted([UptoOneTargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), If({{Condition(ThatPermanent=Ref_TargetPermanent)[0]}}, [CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]), If({{Condition(ThatPermanent=Ref_TargetPermanent)[1]}}, [CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)])]))",
    "choose up to one target {{Permanent}}. If {{Condition(ThatPermanent)}}, exile it. Otherwise, suspect it": "Targeted([UptoOneTargetPermanent({{Permanent[0]}})], ActionList([IfElse({{Condition(ThatPermanent=Ref_TargetPermanent)[0]}}, [ExilePermanent(Ref_TargetPermanent)], [SuspectPermanent(Ref_TargetPermanent)])]))",
    "choose up to one target {{Permanent}}. Until end of turn, it becomes {{a}} {{PT}} {{Zombie}} creature with {{Hasable}} and {{Hasable}} in addition to its other types": "Targeted([UptoOneTargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [SetPT({{PT[0]}}), AddCreatureType({{Zombie[0]}}), AddCardtype(Creature), AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)]))",
    "choose up to one target {{SpecificCard}} in your graveyard that was put there from the battlefield this turn. Return it to your hand. Then the Ring tempts you": "Targeted([UptoOneTargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You)), WasPutIntoGraveyardFromTheBattlefieldThisTurn]))], ActionList([PutGraveyardCardIntoHand(Ref_TargetGraveyardCard), TemptWithRing]))",
    "choose up to one target {{Spell}} or {{Spell}}. Its owner puts it on their choice of the top or bottom of their library": "Targeted([TargetSpell(Or([{{Spell[0]}}, {{Spell[1]}}]))], ActionList([ReturnSpellToTopOrBottomOfLibrary(Ref_TargetSpell)]))",
    "choose up to two target {{Permanents}}. For each one, create a token that's a copy of it. If you created fewer than two tokens this way, create a number of {{PT}} {{CreatureTokens}} with {{Hasable}} equal to the difference": "Targeted([UptoNumberTargetPermanents(Integer(2), {{Permanents[0]}})], ActionList([CreateTokens([TokenCopyOfEachPermanent(Ref_TargetPermanents, NoTokenCopyEffects)]), If(ANumberOfTokensWereCreatedThisWay(LessThan(Integer(2))), [CreateTokens([NumberTokens(Minus(Integer(2), TheNumberOfTokensCreatedThisWay), TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}]))])])]))",
    "choose up to {{Number}} {{Permanents}}. Target opponent chooses one of those permanents. You gain control of the rest": "Targeted([TargetPlayer(Opponent)], ActionList([ChooseUptoNumberPermanents({{Number[0]}}, {{Permanents[0]}}), PlayerAction(Ref_TargetPlayer, ChooseAPermanent(ThePermanentsChosenThisWay)), GainControlOfEachPermanent(ThePermanentsNotChosenThisWay)]))",
    "choose up to {{Number}} {{SpecificCards}} in your hand. They perpetually gain \"{{PerpetualQuotedAbility}}\"": "ActionList([ChooseUptoNumberCardsInHand({{Number[0]}}, {{SpecificCards[0]}}), CreatePerpetualCardsInHandEffect(TheChosenCardsInHand, [AddAbility([{{PerpetualQuotedAbility[0]}}])])])",
    "choose {{Hasable}}, {{Hasable}}, or {{Hasable}}. {{Permanents}} gain that ability until end of turn": "ActionList([ChooseAnAbility([{{Hasable[0]}}, {{Hasable[1]}}, {{Hasable[2]}}]), CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbilityVariable(TheChosenAbility)], UntilEndOfTurn)])",
    "choose {{Number}} {{Permanents}} and put {{a}} {{CounterType}} counter on each of them": "ActionList([ChooseNumberPermanents({{Number[0]}}, {{Permanents[0]}}), PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, TheChosenPermanents)])",
    "choose {{a}} {{Permanent}} and an opponent. Flip a coin. If you lose the flip, that opponent gains control of that creature": "ActionList([ChooseAPermanent({{Permanent[0]}}), ChooseAPlayer(Opponent), FlipACoin_OnLose([PlayerAction(TheChosenPlayer, GainControlOfPermanent(TheChosenPermanent))])])",
    "choose {{a}} {{Permanent}}, then draw cards equal to its total toxic value": "ActionList([ChooseAPermanent({{Permanent[0]}}), DrawNumberCards(ToxicValueOfPermanent(ThePermanentChosenThisWay))])",
    "choose {{a}} {{SpecificCard}} at random from your library, reveal that card, put it into your hand, then shuffle": "ActionList([DigitallySearchLibrary([FindACardOfTypeAtRandom({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])",
    "choose {{a}} {{SpecificCard}} in an opponent's graveyard, then that player chooses {{a}} {{SpecificCard}} in your graveyard. You may return those cards to the battlefield under their owners' control": "ActionList([ChooseAPlayer(Opponent), ChooseACardInPlayersGraveyard({{SpecificCard[0]}}, TheChosenPlayer), PlayerAction(TheChosenPlayer, ChooseACardInPlayersGraveyard({{SpecificCard[1]}}, You)), MayAction(ReturnEachGraveyardCardToBattlefield(TheChosenGraveyardCards, [EntersUnderOwnersControl]))])",
    "choose {{a}} {{SpecificCard}} in your hand or {{a}} {{Permanent}}. It perpetually gets {{PTMod}}": "ActionList([ChooseACardInHandOrAPermanent({{SpecificCard[0]}}, {{Permanent[0]}}), If(ACardWasChosenThisWay, [CreatePerpetualCardInHandEffect(TheChosenCardInHand, [AdjustPT({{PTMod[0]}})])]), If(APermanentWasChosenThisWay, [CreatePerpetualPermanentEffect(TheChosenPermanent, [AdjustPT({{PTMod[0]}})])])])",
    "choose {{a}} {{SpecificCard}} in your hand with mana value {{Digits}} or greater. It perpetually gains \"{{PerpetualQuotedAbility}}\"": "ActionList([ChooseACardInHand(And([{{SpecificCard[0]}}, ManaValueIs(GreaterThanOrEqualTo({{Digits[0]}}))])), CreatePerpetualCardInHandEffect(TheChosenCardInHand, [AddAbility([{{PerpetualQuotedAbility[0]}}])])])",
    "choose {{a}} {{SpecificCard}} in your hand. It perpetually gains \"{{PerpetualQuotedAbility}}\"": "ActionList([ChooseACardInHand({{SpecificCard[0]}}), CreatePerpetualCardInHandEffect(TheChosenCardInHand, [AddAbility([{{PerpetualQuotedAbility[0]}}])])])",
    "choose {{a}} {{SpecificCard}} in your hand. It perpetually gains {{PerpetualHasable}}": "ActionList([ChooseACardInHand({{SpecificCard[0]}}), CreatePerpetualCardInHandEffect(TheChosenCardInHand, [AddAbility([{{PerpetualHasable[0]}}])])])",
    "choose {{a}} {{SpecificCard}} in your hand. It perpetually gets {{PTMod}}": "ActionList([ChooseACardInHand({{SpecificCard[0]}}), CreatePerpetualCardInHandEffect(TheChosenCardInHand, [AdjustPT({{PTMod[0]}})])])",
    "choose {{a}} {{SpecificCard}} in your hand. It perpetually gets {{PTMod}} and gains {{PerpetualHasable}}": "ActionList([ChooseACardInHand({{SpecificCard[0]}}), CreatePerpetualCardInHandEffect(TheChosenCardInHand, [AdjustPT({{PTMod[0]}}), AddAbility([{{PerpetualHasable[0]}}])])])",
    "choose {{a}} {{SpecificCard}} in your hand. That card perpetually gains {{PerpetualHasable}}": "ActionList([ChooseACardInHand({{SpecificCard[0]}}), CreatePerpetualCardInHandEffect(TheChosenCardInHand, [AddAbility([{{PerpetualHasable[0]}}])])])",
    "clash with an opponent. If you win, target {{Permanent}} gains {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([Clash(Opponent, [CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)], [DoNothing])]))",
    "conjure a card named {{NamedCard}} and a card named {{NamedCard}} into your hand": "ActionList([ConjureCardIntoHand({{NamedCard[0]}}), ConjureCardIntoHand({{NamedCard[1]}})])",
    "conjure a card named {{NamedCard}} into the top {{Number}} cards of your library at random. It perpetually gains \"{{PerpetualQuotedAbility}}\"": "ActionList([ConjureCardIntoTheTopNumberCardsOfLibraryAtRandom({{NamedCard[0]}}, {{Number[0]}}), CreatePerpetualCardInLibraryEffect(TheCardConjureIntoLibraryThisWay, [AddAbility([{{PerpetualQuotedAbility[0]}}])])])",
    "conjure a card named {{NamedCard}} into the top {{Number}} cards of your library at random. It perpetually gains \"{{PerpetualQuotedAbility}}\" and \"{{PerpetualQuotedAbility}}\"": "ActionList([ConjureCardIntoTheTopNumberCardsOfLibraryAtRandom({{NamedCard[0]}}, {{Number[0]}}), CreatePerpetualCardInLibraryEffect(TheCardConjureIntoLibraryThisWay, [AddAbility([{{PerpetualQuotedAbility[0]}}]), AddAbility([{{PerpetualQuotedAbility[1]}}])])])",
    "conjure a card named {{NamedCard}} into your graveyard": "ActionList([ConjureACardIntoGraveyard({{NamedCard[0]}})])",
    "conjure a card named {{NamedCard}} into your hand": "ActionList([ConjureCardIntoHand({{NamedCard[0]}})])",
    "conjure a card named {{NamedCard}} into your hand, then create {{a}} {{PT}} {{CreatureToken}}": "ActionList([ConjureCardIntoHand({{NamedCard[0]}}), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])])",
    "conjure a card named {{NamedCard}} into your hand, then discard a card": "ActionList([ConjureCardIntoHand({{NamedCard[0]}}), DiscardACard])",
    "conjure a card named {{NamedCard}} into your hand. Discard that card at the beginning of the next end step": "ActionList([ConjureCardIntoHand({{NamedCard[0]}}), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([DiscardCard(TheCardConjuredIntoHandThisWay)]))])",
    "conjure a card named {{NamedCard}} into your hand. If {{Condition}}, you may seek {{a}} {{SpecificCard}} instead": "ActionList([IfElse({{Condition[0]}}, [MayCost(SeekACard({{SpecificCard[0]}})), Unless(CostWasPaid, [ConjureCardIntoHand({{NamedCard[0]}})])], [ConjureCardIntoHand({{NamedCard[0]}})])])",
    "conjure a card named {{NamedCard}} into your library {{Nth}} from the top": "ActionList([ConjureCardIntoLibraryNthFromTop({{NamedCard[0]}}, {{Nth[0]}})])",
    "conjure a card named {{NamedCard}} onto the battlefield": "ActionList([ConjureCardOntoBattlefield({{NamedCard[0]}}, [EntersNormally])])",
    "conjure a card named {{NamedCard}} onto the battlefield and you may transform it. If {{Condition}}, instead create {{Number}} {{PT}} {{CreatureTokens}} with {{Hasable}}": "ActionList([IfElse({{Condition[0]}}, [CreateTokens([NumberTokens({{Number[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}]))])], [ConjureCardOntoBattlefield({{NamedCard[0]}}, [EntersNormally]), MayAction(TransformPermanent(ThePermanentPutOnTheBattlefieldThisWay))])])",
    "conjure a card named {{NamedCard}} onto the battlefield if {{Condition}}. Otherwise, put {{a}} {{CounterType}} counter on each {{Permanent}}": "ActionList([IfElse({{Condition[0]}}, [ConjureCardOntoBattlefield({{NamedCard[0]}}, [EntersNormally])], [PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, {{Permanent[0]}})])])",
    "conjure a card named {{NamedCard}} onto the battlefield tapped": "ActionList([ConjureCardOntoBattlefield({{NamedCard[0]}}, [EntersTapped])])",
    "conjure a card named {{NamedCard}} onto the battlefield tapped and attacking": "ActionList([ConjureCardOntoBattlefield({{NamedCard[0]}}, [EntersTapped, EntersAttacking])])",
    "conjure a card named {{NamedCard}} onto the battlefield tapped and attacking. At the beginning of the next end step, if that card is on the battlefield, return it to its owner's hand": "ActionList([ConjureCardOntoBattlefield({{NamedCard[0]}}, [EntersTapped, EntersAttacking]), CreateFutureTriggerI(AtTheBeginningOfTheNextEndStep, PermanentPassesFilter(TheCardConjuredOntoTheBattlefieldThisWay, OnTheBattlefield), ActionList([PutPermanentIntoItsOwnersHand(TheCardConjuredOntoTheBattlefieldThisWay)]))])",
    "conjure a card named {{NamedCard}} onto the battlefield, then put {{a}} {{CounterType}} counter on it": "ActionList([ConjureCardOntoBattlefield({{NamedCard[0]}}, [EntersNormally]), PutACounterOfTypeOnPermanent({{CounterType[0]}}, TheCardConjuredOntoTheBattlefieldThisWay)])",
    "conjure a card named {{NamedCard}} onto the battlefield. Then put {{a}} {{CounterType}} counter on each {{Permanent}}": "ActionList([ConjureCardOntoBattlefield({{NamedCard[0]}}, [EntersNormally]), PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, {{Permanent[0]}})])",
    "conjure a card named {{NamedCard}} or a card named {{NamedCard}} into your hand": "ActionList([ConjureCardOrCardIntoHand({{NamedCard[0]}}, {{NamedCard[1]}})])",
    "conjure a card of your choice from {{Spellbook}} into your hand. You may cast that card this turn without paying its mana cost": "ActionList([ConjureACardOfChoiceFromSpellBookIntoHand({{Spellbook[0]}}), CreatePlayerEffectUntil(You, [MayCastCardInHandWithoutPaying(TheCardConjuredIntoHandThisWay)], UntilEndOfTurn)])",
    "conjure a card of your choice from {{Spellbook}} into your hand": "ActionList([ConjureACardOfChoiceFromSpellBookIntoHand({{Spellbook[0]}})])",
    "conjure a card of your choice from {{Spellbook}} onto the battlefield": "ActionList([ConjureACardOfChoiceFromSpellBookOntoBattlefield({{Spellbook[0]}}, [EntersNormally])])",
    "conjure a duplicate of a random {{SpecificCard}} from an opponent's library into your hand. It perpetually gains \"{{PerpetualQuotedAbility}}\"": "ActionList([ConjureDuplicateOfARandomCardOfTypeFromAPlayersLibraryIntoHand({{SpecificCard[0]}}, Opponent), CreatePerpetualCardInHandEffect(TheCardConjuredIntoHandThisWay, [AddAbility([{{PerpetualQuotedAbility[0]}}])])])",
    "conjure a duplicate of a random {{SpecificCard}} from your opponent's library into your hand. It perpetually gains \"{{PerpetualQuotedAbility}}\"": "ActionList([ConjureDuplicateOfARandomCardOfTypeFromAPlayersLibraryIntoHand({{SpecificCard[0]}}, Opponent), CreatePerpetualCardInHandEffect(TheCardPutInHandThisWay, [AddAbility([{{PerpetualQuotedAbility[0]}}])])])",
    "conjure a duplicate of target {{Permanent}} into exile": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([ConjureDuplicateOfPermanentIntoExile(Ref_TargetPermanent)]))",
    "conjure a duplicate of target {{Spell}} into your hand. That card perpetually gains \"{{PerpetualQuotedAbility}}\"": "Targeted([TargetSpell({{Spell[0]}})], ActionList([ConjureDuplicateOfSpellIntoHand(Ref_TargetSpell), CreatePerpetualCardInHandEffect(TheCardConjuredIntoHandThisWay, [AddAbility([{{PerpetualQuotedAbility[0]}}])])]))",
    "conjure a random card from {{Spellbook}} into exile face down with {{Number}} {{CounterType}} counters on it. It gains \"{{ExiledQuotedAbility}}\"": "ActionList([ConjureARandomCardFromSpellBookIntoExileFaceDown({{Spellbook[0]}}), CreateExiledCardEffect(TheCardConjuredIntoExileThisWay, [AddAbility([{{ExiledQuotedAbility[0]}}])])])",
    "conjure a random card from {{Spellbook}} into exile. You may play that card until the end of your next turn": "ActionList([ConjureARandomCardFromSpellBookIntoExile({{Spellbook[0]}}), CreatePlayerEffectUntil(You, [MayPlayExiledCard(TheCardConjuredIntoExileThisWay)], UntilTheEndOfPlayersNextTurn(You))])",
    "conjure a random card from {{Spellbook}} into the top {{Number}} cards of your library at random, then draw a card": "ActionList([ConjureARandomCardFromSpellbookIntoTheTopNumberCardsOfLibrary({{Spellbook[0]}}, {{Number[0]}}), DrawACard])",
    "conjure a random card from {{Spellbook}} into your hand": "ActionList([ConjureARandomCardFromSpellBookIntoHand({{Spellbook[0]}})])",
    "conjure a random card from {{Spellbook}} into your hand. Then if {{Condition}}, repeat this process": "ActionList([RepeatableActions([ConjureARandomCardFromSpellBookIntoHand({{Spellbook[0]}}), If({{Condition[0]}}, [RepeatThisProcess])])])",
    "conjure a random card from {{Spellbook}} onto the battlefield. Its base power and toughness perpetually become {{PT}}":
      "ActionList([ConjureARandomCardFromSpellBookOntoBattlefield({{Spellbook[0]}}, [EntersNormally]), CreatePerpetualPermanentEffect(TheCardConjuredOntoTheBattlefieldThisWay, [SetPT({{PT[0]}})])])",
    "conjure cards named {{NamedCard}}, {{NamedCard}}, and {{NamedCard}} into your library, then shuffle": "ActionList([ConjureMultipleCardsIntoLibraryAndShuffle({{NamedCard[0]}}, {{NamedCard[1]}}, {{NamedCard[2]}})])",
    "conjure the Power Nine into your library, then shuffle": "ActionList([ConjureThePowerNineIntoLibraryAndShuffle])",
    "conjure {{Number}} cards named {{NamedCard}} into the top {{Number}} cards of each player's library at random": "ActionList([ConjureNumberCardsIntoTheTopNumberCardsOfEachPlayersLibraryAtRandom({{Number[0]}}, {{NamedCard[0]}}, {{Number[1]}}, AnyPlayer)])",
    "conjure {{Number}} cards named {{NamedCard}} into your graveyard": "ActionList([ConjureNumberCardsIntoPlayersGraveyard({{Number[0]}}, {{NamedCard[0]}}, You)])",
    "conjure {{Number}} cards named {{NamedCard}} into your library, then shuffle": "ActionList([ConjureNumberCardsIntoLibraryAndShuffle({{Number[0]}}, {{NamedCard[0]}})])",
    "conjure {{Number}} cards named {{NamedCard}} into your library, then shuffle. Draw a card": "ActionList([ConjureNumberCardsIntoLibraryAndShuffle({{Number[0]}}, {{NamedCard[0]}}), DrawACard])",
    "conjure {{Number}} cards named {{NamedCard}} into your library. They perpetually gain {{PerpetualHasable}}. Then shuffle": "ActionList([ConjureNumberCardsIntoLibrary({{Number[0]}}, {{NamedCard[0]}}), CreatePerpetualCardsInPlayersLibraryEffect(TheCardsConjuredInLibraryThisWay, You, [AddAbility([{{PerpetualHasable[0]}}])]), Shuffle])",
    "conjure {{Number}} cards named {{NamedCard}} on top of your library. They perpetually gain \"{{PerpetualQuotedAbility}}\". Then shuffle": "ActionList([ConjureNumberCardsOnTopOfLibrary({{Number[0]}}, {{NamedCard[0]}}), CreatePerpetualCardsInPlayersLibraryEffect(TheCardsConjuredInLibraryThisWay, You, [AddAbility([{{PerpetualQuotedAbility[0]}}])]), Shuffle])",
    "conjure {{Number}} cards named {{NamedCard}} onto the battlefield": "ActionList([ConjureNumberCardsOntoBattlefield({{Number[0]}}, {{NamedCard[0]}}, [EntersNormally])])",
    "conjure {{Spellbook}} into your library twice, then shuffle": "ActionList([ConjureEachCardFromSpellBookIntoLibrary({{Spellbook[0]}}), ConjureEachCardFromSpellBookIntoLibrary({{Spellbook[0]}}), Shuffle])",
    "copy a card you exiled with cards named {{NamedCard}}. You may cast the copy without paying its mana cost": "ActionList([CopyAnExiledCard(WasExiledByPlayerForDraftCard(You, {{NamedCard[0]}})), MayAction(CastCopiedCardWithoutPaying)])",
    "copy each exiled card you own with {{a}} {{CounterType}} counter on it. You may cast the copies": "ActionList([CopyExiledCards(And([OwnedByAPlayer(SinglePlayer(You)), HasACounterOfType({{CounterType[0]}})])), MayAction(CastAnyNumberOfCopiedCards)])",
    "copy target {{Spell}}. You may choose new targets for that copy": "Targeted([TargetSpell({{Spell[0]}})], ActionList([CopySpellAndMayChooseNewTargets(Ref_TargetSpell)]))",
    "copy target {{Spell}}. You may choose new targets for the copy": "Targeted([TargetSpell({{Spell[0]}})], ActionList([CopySpellAndMayChooseNewTargets(Ref_TargetSpell)]))",
    "copy the next loyalty ability you activate this turn when you activate it. You may choose new targets for the copy": "ActionList([CreateFutureTrigger(WhenAPlayerNextActivatesAnAbilityThisTurn(SinglePlayer(You), LoyaltyAbility), ActionList([CopyAbilityAndMayChooseNewTargets(Trigger_ThatAbility)]))])",
    "copy the next {{Spell}} you cast this turn when you cast it. You may choose new targets for the copy": "ActionList([CreateFutureTrigger(WhenPlayerCastsTheirNextSpellThisTurn(You, {{Spell[0]}}), ActionList([CopySpellAndMayChooseNewTargets(Trigger_ThatSpell)]))])",
    "count the number of {{CounterType}} counters on {{Permanents}}. {{Creatures}} with power less than or equal to that number can't block this turn": "ActionList([CreateValueX(NumCountersOfTypeOnPermanents({{CounterType[0]}}, {{Permanents[0]}})), CreateEachPermanentRuleEffectUntil(And([{{Creatures[0]}}, PowerIs(LessThanOrEqualTo(ValueX))]), [CantBlock], UntilEndOfTurn)])",
    "count the number of {{Permanents}}. If the number is odd, until end of turn, {{Creatures}} get {{PTMod}} and whenever a player taps {{a}} {{Permanent}} for mana, that player adds an additional {{ManaProduceSymbol}}. If the number is even, until end of turn, {{Creatures}} get {{PTMod}} and if a player taps {{a}} {{Permanent}} for mana, that {{Permanent}} produces colorless mana instead of any other type": "ActionList([If(NumPermanentsIs(Odd, {{Permanents[0]}}), [CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), CreateTriggerUntil(WhenAPlayerTapsAPermanentForMana(AnyPlayer, {{Permanent[0]}}), ActionList([PlayerAction(Trigger_ThatPlayer, AddMana({{ManaProduceSymbol[0]}}))]), UntilEndOfTurn)]), If(NumPermanentsIs(Even, {{Permanents[0]}}), [CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), CreateGameEffect(UntilEndOfTurn, PermanentsTappedByPlayerForManaProduceColorlessInstead({{Permanent[1]}}, AnyPlayer))])])",
    "count the number of {{Permanents}}. Your life total becomes that number": "ActionList([SetLifeTotal(TheNumberOfPermanentsOnTheBattlefield({{Permanents[0]}}))])",
    "counter all abilities your opponents control": "ActionList([CounterEachAbility(ControlledByAPlayer(Opponent))])",
    "counter target spell an opponent controls unless they pay {{ManaCost}}": "Targeted([TargetSpell(ControlledByAPlayer(Opponent))], ActionList([PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), PayMana({{ManaCost[0]}})), CounterSpell(Ref_TargetSpell)]))",
    "counter target spell with mana value X or less, where X is {{GameNumber}}": "Targeted([TargetSpell(ManaValueIs(LessThanOrEqualTo({{GameNumber[0]}})))], ActionList([CounterSpell(Ref_TargetSpell)]))",
    "counter target {{Ability}}": "Targeted([TargetAbility({{Ability[0]}})], ActionList([CounterAbility(Ref_TargetAbility)]))",
    "counter target {{Ability}} from {{an}} {{AbilitySource}}. If a permanent's ability is countered this way, destroy that permanent": "Targeted([TargetAbility(And([{{Ability[0]}}, AbilityOfASource({{AbilitySource[0]}})]))], ActionList([CounterAbility(Ref_TargetAbility), If(APermanentsAbilityIsCounteredThisWay(AnyPermanent), [DestroyPermanent(PermanentSourceOfAbilityCounteredThisWay)])]))",
    "counter target {{Spell}}": "Targeted([TargetSpell({{Spell[0]}})], ActionList([CounterSpell(Ref_TargetSpell)]))",
    "counter target {{Spell}} unless its controller pays {{ManaCost}}": "Targeted([TargetSpell({{Spell[0]}})], ActionList([PlayerMayCost(ControllerOfTargetSpell, PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [CounterSpell(Ref_TargetSpell)])]))",
    "counter target {{Spell}}. If that spell is countered this way, exile it instead of putting it into its owner's graveyard, then you may cast it without paying its mana cost": "Targeted([TargetSpell({{Spell[0]}})], ActionList([CounterSpellIntoExile(Ref_TargetSpell), MayAction(CastExiledCardWithoutPaying(TheCardExiledThisWay))]))",
    "counter target {{Spell}}. If that spell is countered this way, exile it instead of putting it into its owner's graveyard. You may cast that card without paying its mana cost for as long as it remains exiled": "Targeted([TargetSpell({{Spell[0]}})], ActionList([CounterSpellIntoExile(Ref_TargetSpell), CreatePlayerEffectUntil(You, [MayCastExiledCardWithoutPaying(TheCardExiledThisWay)], UntilCardIsCastFromExile(TheCardExiledThisWay))]))",
    "counter target {{Spell}}. Its controller manifests dread": "Targeted([TargetSpell({{Spell[0]}})], ActionList([CounterSpell(Ref_TargetSpell), PlayerAction(ControllerOfSpell(Ref_TargetSpell), ManifestDread)]))",
    "counter target {{StackSpellOrAbility}}": "Targeted([TargetSpellOrAbility({{StackSpellOrAbility[0]}})], ActionList([CounterSpellOrAbility(Ref_TargetSpellOrAbility)]))",
    "create X Blood tokens, where X is {{GameNumber}}": "ActionList([CreateValueX({{GameNumber[0]}}), CreateTokens([NumberTokens(ValueX, BloodToken)])])",
    "create X Treasure tokens, where X is {{GameNumber}}": "ActionList([CreateTokens([NumberTokens({{GameNumber[0]}}, TreasureToken)])])",
    "create X tokens that are copies of another target {{Permanent}}, where X is {{Number}} plus {{GameNumber}}. They gain {{Hasable}}. Exile them at the beginning of the next end step": "Targeted([TargetPermanent(And([Other(ThisPermanent), {{Permanent[0]}}]))], ActionList([CreateTokens([NumberTokens(Plus({{Number[0]}}, {{GameNumber[0]}}), TokenCopyOfPermanent(Ref_TargetPermanent, NoTokenCopyEffects))]), CreateEachPermanentLayerEffect(TheCreatedTokens, [AddAbility([{{Hasable[0]}}])]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([ExileEachPermanent(TheTokensCreatedThisWay)]))]))",
    "create X {{PT}} {{CreatureTokens}} at the beginning of your next upkeep, where X is {{GameNumber}} at that time": "ActionList([CreateFutureTrigger(AtTheBeginningOfPlayersNextUpkeep(You), ActionList([CreateTokens([NumberTokens({{GameNumber[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])]))])",
    "create X {{PT}} {{CreatureTokens}} with \"{{TokenQuotedAbility}}\", where X is {{GameNumber}}": "ActionList([CreateTokens([NumberTokens({{GameNumber[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{TokenQuotedAbility[0]}}]))])])",
    "create X {{PT}} {{CreatureTokens}} with {{Hasable}}, where X is {{GameNumber}}": "ActionList([CreateTokens([NumberTokens({{GameNumber[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}]))])])",
    "create X {{PT}} {{CreatureTokens}}, where X is half {{GameNumber}}, rounded down": "ActionList([CreateTokens([NumberTokens(HalfRoundedDown({{GameNumber[0]}}), TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])])",
    "create X {{PT}} {{CreatureTokens}}, where X is {{GameNumber}}": "ActionList([CreateTokens([NumberTokens({{GameNumber[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])])",
    "create X {{PT}} {{CreatureTokens}}, where X is {{Number}} plus {{GameNumber}}": "ActionList([CreateTokens([NumberTokens(Plus({{Number[0]}}, {{GameNumber[0]}}), TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])])",
    "create a Blood token": "ActionList([CreateTokens([BloodToken])])",
    "create a Blood token and conjure a card named {{NamedCard}} onto the battlefield": "ActionList([CreateTokens([BloodToken]), ConjureCardOntoBattlefield({{NamedCard[0]}}, [EntersNormally])])",
