    "You draw a card and target opponent gains {{Digits}} life": "Targeted([TargetPlayer(Opponent)], ActionList([DrawACard, PlayerAction(Ref_TargetPlayer, GainLife({{Digits[0]}}))]))",
    "You draw a card and you lose {{Digits}} life": "ActionList([DrawACard, LoseLife({{Digits[0]}})])",
    "You draw a card. Each opponent exiles a card from their hand or {{a}} {{Permanent}} they control": "ActionList([DrawACard, EachPlayerChoosesAnAction(Opponent, [ExileACardFromHand, ExileAPermanent(And([{{Permanent[0]}}, ControlledByAPlayer(SinglePlayer(EachablePlayer))]))])])",
    "You draw {{Number}} cards and you lose {{Digits}} life": "ActionList([DrawNumberCards({{Number[0]}}), LoseLife({{Digits[0]}})])",
    "You draw {{Number}} cards. Then each opponent may scry {{Digits}}": "ActionList([DrawNumberCards({{Number[0]}}), EachPlayerMayAction(Opponent, Scry({{Digits[0]}}))])",
    "You gain X life and draw X cards, where X is {{GameNumber}}": "ActionList([CreateValueX({{GameNumber[0]}}), GainLife(ValueX), DrawNumberCards(ValueX)])",
    "You gain life equal to {{GameNumber}}": "ActionList([GainLife({{GameNumber[0]}})])",
    "You gain life equal to {{GameNumber}} plus {{GameNumber}}": "ActionList([GainLife(Plus({{GameNumber[0]}}, {{GameNumber[1]}}))])",
    "You gain protection from everything until your next turn": "ActionList([CreatePlayerEffectUntil(You, [Protection(FromEverything)], UntilPlayersNextTurn(You))])",
    "You gain {{Digits}} life": "ActionList([GainLife({{Digits[0]}})])",
    "You gain {{Digits}} life and draw a card": "ActionList([GainLife({{Digits[0]}}), DrawACard])",
    "You gain {{Digits}} life and draw {{Number}} cards": "ActionList([GainLife({{Digits[0]}}), DrawNumberCards({{Number[0]}})])",
    "You gain {{Digits}} life and each opponent loses {{Digits}} life": "ActionList([GainLife({{Digits[0]}}), EachPlayerAction(Opponent, LoseLife({{Digits[1]}}))])",
    "You gain {{Digits}} life and get {{Energy}}": "ActionList([GainLife({{Digits[0]}}), GetEnergy(Integer({{Energy[0]}}))])",
    "You gain {{Digits}} life and scry {{Digits}}": "ActionList([GainLife({{Digits[0]}}), Scry({{Digits[1]}})])",
    "You gain {{Digits}} life for each {{Eachable}}": "ActionList([GainLifeForEach({{Digits[0]}}, {{Eachable[0]}})])",
    "You gain {{Digits}} life, draw {{Number}} cards, then put up to {{Number}} {{SpecificCards}} from your hand onto the battlefield": "ActionList([GainLife({{Digits[0]}}), DrawNumberCards({{Number[0]}}), PutUptoNumberCardsFromHandOntoBattlefield({{Number[1]}}, {{SpecificCards[0]}}, [EntersNormally])])",
    "You gain {{Digits}} life. Add {{ManaProduceSymbol}}, {{ManaProduceSymbol}}, or {{ManaProduceSymbol}}. Spend this mana only to cast {{a}} {{PotentialSpell}}": "ActionList([GainLife({{Digits[0]}}), AddManaWithModifiers(Or([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}, {{ManaProduceSymbol[2]}}]), CanOnlySpendOnSpells({{PotentialSpell[0]}}))])",
    "You gain {{Digits}} life. If {{Condition}}, you gain {{Digits}} life instead": "ActionList([IfElse({{Condition[0]}}, [GainLife({{Digits[1]}})], [GainLife({{Digits[0]}})])])",
    "You gain {{Digits}} life. Put {{Number}} {{CounterType}} counters on up to one target {{Permanent}}": "Targeted([UptoOneTargetPermanent({{Permanent[0]}})], ActionList([GainLife({{Digits[0]}}), PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[0]}}, Ref_TargetPermanent)]))",
    "You gain {{Digits}} life. Surveil {{Digits}}": "ActionList([GainLife({{Digits[0]}}), Surveil({{Digits[1]}})])",
    "You get an emblem with \"{{EmblemQuotedAbility}}\"": "ActionList([GetAnEmblem([{{EmblemQuotedAbility[0]}}])])",
    "You get an emblem with \"{{EmblemQuotedAbility}}\" and \"{{EmblemQuotedAbility}}\"": "ActionList([GetAnEmblem([{{EmblemQuotedAbility[0]}}, {{EmblemQuotedAbility[1]}}])])",
    "You get an emblem with \"{{EmblemQuotedAbility}}\". Search your library for any number of {{SpecificCards}}, put them onto the battlefield tapped, then shuffle": "ActionList([GetAnEmblem([{{EmblemQuotedAbility[0]}}]), SearchLibrary([FindAnyNumberOfCardsOfType({{SpecificCards[0]}}), PutFoundCardsOntoBattlefield([EntersTapped]), Shuffle])])",
    "You get an emblem with \"{{EmblemQuotedAbility}}\". Then create {{Number}} {{PT}} {{CreatureTokens}}": "ActionList([GetAnEmblem([{{EmblemQuotedAbility[0]}}]), CreateTokens([NumberTokens({{Number[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])])",
    "You get an emblem with '{{EmblemQuotedAbility}}'": "ActionList([GetAnEmblem([{{EmblemQuotedAbility[0]}}])])",
    "You get {{Energy}}": "ActionList([GetEnergy(Integer({{Energy[0]}}))])",
    "You get {{Energy}} and draw a card": "ActionList([GetEnergy(Integer({{Energy[0]}})), DrawACard])",
    "You get {{Energy}}, then you may pay one or more {{EnergyCounters}}. If you do, create an {{PTX}} {{CreatureToken}}, where X is the amount of {{EnergyCounters}} paid this way": "ActionList([GetEnergy(Integer({{Energy[0]}})), MayCost(PayAnyAmountOfEnergy), If(CostWasPaid, [CreateTokens([TokenWithPT(PTX({{PTX[0]}}, TheAmountOfEnergyPaidThisWay), {{CreatureToken[0]}}, [])])])])",
    "You get {{Tickets}}": "ActionList([GetNumberTickets({{Tickets[0]}})])",
    "You get {{Tickets}}. You may put a sticker on {{a}} {{Permanent}}": "ActionList([GetNumberTickets({{Tickets[0]}}), MayAction(PutAStickerOnAPermanent({{Permanent[0]}}))])",
    "You lose {{Digits}} life. Look at the top {{Number}} cards of your library. Put one of them into your hand and the rest into your graveyard": "ActionList([LoseLife({{Digits[0]}}), LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [PutAGenericCardIntoHand, PutTheRemainingCardsIntoGraveyard])])",
    "You may cast a spell from among cards in exile with {{CounterType}} counters on them without paying its mana cost": "ActionList([MayAction(CastASpellFromExileWithoutPaying(AnySpell, HasACounterOfType({{CounterType[0]}})))])",
    "You may cast a spell with suspend from your hand. If you do, pay its suspend cost rather than its mana cost": "ActionList([MayAction(CastASpellFromHandForAlternateCost(HasAbility(AnySuspend), PayItsSuspendCost))])",
    "You may cast target {{SpecificCard}} from your graveyard this turn": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([CreatePlayerEffectUntil(You, [MayCastGraveyardCard(Ref_TargetGraveyardCard)], UntilEndOfTurn)]))",
    "You may cast target {{SpecificCard}} from your graveyard this turn. If that spell doesn't target {{a}} {{Permanent}}, it costs {{ManaCost}} more to cast this way. If that spell would be put into your graveyard, exile it instead": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([CreatePlayerEffectUntil(You, [MayCastGraveyardCardIntoExileIfSpell(Ref_TargetGraveyardCard, TargetsAPermanent({{Permanent[0]}})), MayCastGraveyardCardIntoExileIfSpellForIncreasedCost(Ref_TargetGraveyardCard, DoesntTargetAPermanent({{Permanent[0]}}), {{ManaCost[0]}})], UntilEndOfTurn)]))",
    "You may cast target {{SpecificCard}} from your graveyard this turn. If that spell would be put into your graveyard, exile it instead": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([CreatePlayerEffectUntil(You, [MayCastGraveyardCardIntoExile(Ref_TargetGraveyardCard)], UntilEndOfTurn)]))",
    "You may cast target {{SpecificCard}} from your graveyard. If that spell would be put into your graveyard, exile it instead": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([MayAction(CastGraveyardCardIntoExile(Ref_TargetGraveyardCard))]))",
    "You may cast target {{SpecificCard}} in your graveyard this turn": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([CreatePlayerEffectUntil(You, [MayCastGraveyardCard(Ref_TargetGraveyardCard)], UntilEndOfTurn)]))",
    "You may cast up to {{Number}} spells from among face-up cards your opponents own from exile without paying their mana costs": "ActionList([CastUptoNumberSpellsFromExileWithoutPaying({{Number[0]}}, AnySpell, And([IsFaceUp, OwnedByAPlayer(Opponent)]))])",
    "You may cast {{PotentialSpells}} from your graveyard this turn": "ActionList([CreatePlayerEffectUntil(You, [MayCastSpellsFromGraveyard({{PotentialSpells[0]}})], UntilEndOfTurn)])",
    "You may cast {{PotentialSpells}} this turn as though they had flash": "ActionList([CreatePlayerEffectUntil(You, [MayCastSpellsAsThoughTheyHadFlash({{PotentialSpells[0]}})], UntilEndOfTurn)])",
    "You may cast {{a}} {{PotentialSpell}} from your graveyard this turn": "ActionList([CreatePlayerEffectUntil(You, [MayCastASpellFromGraveyard({{PotentialSpell[0]}}, You)], UntilEndOfTurn)])",
    "You may cast {{a}} {{PotentialSpell}} from your graveyard this turn. If you do, it enters with {{a}} {{CounterType}} counter on it and is {{a}} {{Zombie}} in addition to its other types": "ActionList([CreatePlayerEffectUntil(You, [MayCastASpellFromGraveyardWithEffect({{PotentialSpell[0]}}, You, [EntersWithACounter({{CounterType[0]}}), EntersWithLayerEffect([AddCreatureType({{Zombie[0]}})])])], UntilEndOfTurn)])",
    "You may cast {{a}} {{PotentialSpell}} from your hand without paying its mana cost": "ActionList([MayAction(CastASpellFromHandWithoutPaying({{PotentialSpell[0]}}))])",
    "You may cast {{a}} {{PotentialSpell}} from your hand without paying its mana cost if it has the same name as a spell that was cast this turn": "ActionList([MayAction(CastASpellFromHandWithoutPaying(And([{{PotentialSpell[0]}}, SharesANameWithASpellCastThisTurn])))])",
    "You may change the targets of target {{Spell}}": "Targeted([TargetSpell({{Spell[0]}})], ActionList([MayAction(ChangeTargetsOfSpell(Ref_TargetSpell))]))",
    "You may discard a card. If you do, draw a card": "ActionList([MayCost(DiscardACard), If(CostWasPaid, [DrawACard])])",
    "You may discard a card. If you do, draw a card. If {{a}} {{SpecificCard}} was discarded this way, draw {{Number}} cards instead": "ActionList([MayCost(DiscardACard), If(CostWasPaid, [IfElse(ACardWasDiscardedThisWay({{SpecificCard[0]}}), [DrawNumberCards({{Number[0]}})], [DrawACard])])])",
    "You may discard a card. If you do, draw {{Number}} cards, then mill a card": "ActionList([MayCost(DiscardACard), If(CostWasPaid, [DrawNumberCards({{Number[0]}}), MillACard])])",
    "You may exile {{a}} {{SpecificCard}} from your hand and put {{Number}} {{CounterType}} counters on it. It gains \"{{ExiledQuotedAbility}}\" and \"{{ExiledQuotedAbility}}\"": "ActionList([MayCost(ExileACardOfTypeFromHand({{SpecificCard[0]}})), If(CostWasPaid, [PutNumberCountersOnExiledCard({{Number[0]}}, {{CounterType[0]}}, TheCardExiledThisWay), CreateExiledCardEffect(TheCardExiledThisWay, [AddAbility([{{ExiledQuotedAbility[0]}}]), AddAbility([{{ExiledQuotedAbility[1]}}])])])])",
    "You may exile {{a}} {{SpecificCard}} from your hand. If you do, it becomes plotted": "ActionList([MayCost(ExileACardOfTypeFromHand({{SpecificCard[0]}})), If(CostWasPaid, [CreateExiledCardEffect(TheCardExiledThisWay, [IsPlotted])])])",
    "You may play target {{PermanentCard}} from your graveyard this turn. If you do, it enters tapped": "Targeted([TargetGraveyardCard(And([{{PermanentCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([CreatePlayerEffectUntil(You, [MayPlayGraveyardCardWithEffect(Ref_TargetGraveyardCard, [EntersTapped])], UntilEndOfTurn)]))",
    "You may play target {{SpecificCard}} from your graveyard without paying its mana cost": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([MayAction(PlayGraveyardCardWithoutPaying(Ref_TargetGraveyardCard))]))",
    "You may put a sticker on {{a}} {{Permanent}}": "ActionList([MayAction(PutAStickerOnAPermanent({{Permanent[0]}}))])",
    "You may put {{a}} {{CreatureCard}} from your hand onto the battlefield. That creature gains {{Hasable}}. At the beginning of the next end step, sacrifice that creature": "ActionList([MayActions([PutACardFromHandOnBattlefield({{CreatureCard[0]}}, [EntersNormally]), CreatePermanentLayerEffect(ThePermanentPutOnTheBattlefieldThisWay, [AddAbility([{{Hasable[0]}}])]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([SacrificePermanent(ThePermanentPutOnTheBattlefieldThisWay)]))])])",
    "You may put {{a}} {{SpecificCard}} from your hand onto the battlefield": "ActionList([MayAction(PutACardFromHandOnBattlefield({{SpecificCard[0]}}, [EntersNormally]))])",
    "You may put {{a}} {{SpecificCard}} from your hand onto the battlefield tapped": "ActionList([MayAction(PutACardFromHandOnBattlefield({{SpecificCard[0]}}, [EntersTapped]))])",
    "You may put {{a}} {{SpecificCard}} from your hand onto the battlefield. If you put an artifact onto the battlefield this way, put {{Number}} {{CounterType}} counters on it": "ActionList([MayActions([PutACardFromHandOnBattlefield({{SpecificCard[0]}}, [EntersNormally]), If(APermanentOfTypeWasPutOntoTheBattlefieldThisWay(IsCardtype(Artifact)), [PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[0]}}, ThePermanentPutOnTheBattlefieldThisWay)])])])",
    "You may put {{a}} {{SpecificCard}} from your hand onto the battlefield. Sacrifice it at the beginning of the next end step": "ActionList([MayActions([PutACardFromHandOnBattlefield({{SpecificCard[0]}}, [EntersNormally]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([SacrificePermanent(ThePermanentPutOnTheBattlefieldThisWay)]))])])",
    "You may put {{a}} {{SpecificCard}} from your hand onto the battlefield. That artifact gains {{Hasable}}. Sacrifice it at the beginning of the next end step": "ActionList([MayActions([PutACardFromHandOnBattlefield({{SpecificCard[0]}}, [EntersNormally]), CreatePermanentLayerEffect(ThePermanentPutOnTheBattlefieldThisWay, [AddAbility([{{Hasable[0]}}])]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([SacrificePermanent(ThePermanentPutOnTheBattlefieldThisWay)]))])])",
    "You may put {{a}} {{SpecificCard}} from your hand onto the battlefield. That creature gains {{Hasable}} until end of turn. Sacrifice it at the beginning of the next end step": "ActionList([MayActions([PutACardFromHandOnBattlefield({{SpecificCard[0]}}, [EntersNormally]), CreatePermanentLayerEffectUntil(ThePermanentPutOnTheBattlefieldThisWay, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([SacrificePermanent(ThePermanentPutOnTheBattlefieldThisWay)]))])])",
    "You may put {{a}} {{SpecificCard}} from your hand onto the battlefield. That creature gains {{Hasable}}. Sacrifice the creature at the beginning of the next end step": "ActionList([MayActions([PutACardFromHandOnBattlefield({{SpecificCard[0]}}, [EntersNormally]), CreatePermanentLayerEffect(ThePermanentPutOnTheBattlefieldThisWay, [AddAbility([{{Hasable[0]}}])]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([SacrificePermanent(ThePermanentPutOnTheBattlefieldThisWay)]))])])",
    "You may put {{a}} {{SpecificCard}} from your hand or graveyard onto the battlefield": "ActionList([MayAction(PutACardFromHandOrGraveyardOnBattlefield({{SpecificCard[0]}}, You, [EntersNormally]))])",
    "You may put {{a}} {{SpecificCard}} onto the battlefield from your hand or graveyard with {{Number}} {{CounterType}} counters on it": "ActionList([MayAction(PutACardFromHandOrGraveyardOnBattlefield({{SpecificCard[0]}}, You, [EntersWithNumberCounters({{Number[0]}}, {{CounterType[0]}})]))])",
    "You may put {{a}} {{SpecificCard}} or {{a}} {{SpecificCard}} from your hand onto the battlefield. Sacrifice it at the beginning of the next end step": "ActionList([MayCost(PutACardFromHandOrGraveyardOnBattlefield(Or([{{SpecificCard[0]}}, {{SpecificCard[1]}}]), You, [EntersNormally])), If(CostWasPaid, [CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([SacrificePermanent(ThePermanentPutOnTheBattlefieldThisWay)]))])])",
    "You may reveal {{a}} {{SpecificCard}} you own from outside the game and put it into your hand": "ActionList([MayAction(RevealCardFromOutsideGameAndPutInHand({{SpecificCard[0]}}))])",
    "You may reveal {{a}} {{SpecificCard}} you own from outside the game or choose a face-up {{SpecificCard}} you own in exile. Put that card into your hand": "ActionList([MayAction(RevealCardFromOutsideGameAndPutInHandOrPutAnExiledCardInOwnersHand({{SpecificCard[0]}}, And([IsFaceUp, {{SpecificCard[1]}}, OwnedByAPlayer(SinglePlayer(You))])))])",
    "You may sacrifice {{a}} {{Creature}}. If you do, search your library for a creature card with mana value equal to {{Digits}} plus {{GameNumber[ThatSacrificedPermanent]}}, put it onto the battlefield, then shuffle": "ActionList([MayCost(SacrificeAPermanent({{Creature[0]}})), If(CostWasPaid, [SearchLibrary([FindACardOfType(And([IsCardtype(Creature), ManaValueIs(EqualTo(Plus({{Digits[0]}}, {{GameNumber[ThatSacrificedPermanent][0]}})))])), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle])])])",
    "You may sacrifice {{a}} {{Permanent}} or discard a card. If you do, draw a card": "ActionList([MayCost(Or([SacrificeAPermanent({{Permanent[0]}}), DiscardACard])), If(CostWasPaid, [DrawACard])])",
    "You may sacrifice {{a}} {{Permanent}}. If you do, create {{a}} {{PT}} {{CreatureToken}}": "ActionList([MayCost(SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])])])",
    "You may sacrifice {{a}} {{Permanent}}. If you do, destroy target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[1]}})], ActionList([MayCost(SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [DestroyPermanent(Ref_TargetPermanent)])]))",
    "You may sacrifice {{a}} {{Permanent}}. If you do, return that card to the battlefield under its owner's control with {{Number}} {{CounterType}} counters on it and you become the monarch":
      "ActionList([MayCost(SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [PutEachGraveyardCardOntoBattlefield(WasPutIntoGraveyardThisWay, [EntersUnderOwnersControl, EntersWithNumberCounters({{Number[0]}}, {{CounterType[0]}})]), BecomeTheMonarch])])",
    "You may sacrifice {{a}} {{Permanent}}. When you do, destroy target {{Permanent}}": "ActionList([MayCost(SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPermanent({{Permanent[0]}})], ActionList([DestroyPermanent(Ref_TargetPermanent)])))])])",
    "You may tap or untap another target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([MayAction(TapOrUntapPermanent(Ref_TargetPermanent))]))",
    "You may tap or untap target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([MayAction(TapOrUntapPermanent(Ref_TargetPermanent))]))",
    "You may unattach an Equipment from {{a}} {{Creature}}. If you do, tap that creature and it gains {{Hasable}} until end of turn": "ActionList([MayCost(UnattachAPermanentFromAPermanent(IsArtifactType(Equipment), {{Creature[0]}})), If(CostWasPaid, [TapPermanent(TheCreatureUnequippedThisWay), CreatePermanentLayerEffectUntil(TheCreatureUnequippedThisWay, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])])",
    "You take the initiative, gain {{Digits}} life, draw a card, and create a Treasure token": "ActionList([TakeTheInitiative, GainLife({{Digits[0]}}), DrawACard, CreateTokens([TreasureToken])])",
    "You win the game": "ActionList([WinTheGame])",
    "Your life total becomes {{Digits}}": "ActionList([SetLifeTotal({{Digits[0]}})])",
    "Your opponents can't cast {{PotentialSpells}} this turn": "ActionList([CreateEachPlayerEffectUntil(Opponent, [CantCastSpells({{PotentialSpells[0]}})], UntilEndOfTurn)])",
    "Your opponents can't gain life this turn": "ActionList([CreateEachPlayerEffectUntil(Opponent, [CantGainLife], UntilEndOfTurn)])",
    "{{Artifacts}} become artifact creatures with base power and toughness {{PT}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Artifacts[0]}}, [SetCardtypes([Artifact, Creature]), SetPT({{PT[0]}})], UntilEndOfTurn)])",
    "{{Creatures}} attack this turn if able": "ActionList([CreateEachPermanentRuleEffectUntil({{Creatures[0]}}, [MustAttack], UntilEndOfTurn)])",
    "{{Creatures}} attack this turn if able. At the beginning of the next end step, destroy each of those creatures that didn't attack this turn": "ActionList([CreateEachPermanentRuleEffectUntil({{Creatures[0]}}, [MustAttack], UntilEndOfTurn), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([DestroyEachPermanent(And([ControlledSinceBeforeCombatThisTurn, {{Creatures[0]}}, DidntAttackThisTurn]))]))])",
    "{{Creatures}} block this turn if able, and you choose how those creatures block": "ActionList([CreateEachPermanentRuleEffectUntil({{Creatures[0]}}, [MustBlock], UntilEndOfTurn), CreatePlayerEffectUntil(You, [ChoosesHowCreaturesBlock({{Creatures[0]}})], UntilEndOfTurn)])",
    "{{Creatures}} can attack this turn as though they didn't have defender": "ActionList([CreateEachPermanentRuleEffectUntil({{Creatures[0]}}, [CanAttackAsThoughItDidntHaveDefender], UntilEndOfTurn)])",
    "{{Creatures}} can't be blocked this turn": "ActionList([CreateEachPermanentRuleEffectUntil({{Creatures[0]}}, [CantBeBlocked], UntilEndOfTurn)])",
    "{{Creatures}} gain {{Hasable}} and get {{PTModX}} until end of turn, where X is {{GameNumber}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AddAbility([{{Hasable[0]}}]), AdjustPTX({{PTModX[0]}}, {{GameNumber[0]}})], UntilEndOfTurn)])",
    "{{Creatures}} gain {{Hasable}} until end of turn and can't be blocked this turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), CreateEachPermanentRuleEffectUntil({{Creatures[0]}}, [CantBeBlocked], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTModX}} until end of turn, where X is the number of colors among those creatures": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPTX({{PTModX[0]}}, NumColorsAmongPermanents({{Creatures[0]}}))], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTModX}} until end of turn, where X is {{GameNumber}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPTX({{PTModX[0]}}, {{GameNumber[0]}})], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTModX}} until end of turn, where X is {{GameNumber}}. {{Permanents}} gain {{Hasable}} and {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPTX({{PTModX[0]}}, {{GameNumber[0]}})], UntilEndOfTurn), CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTMod}} and gain {{Hasable}} and {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTMod}} and gain {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTMod}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTMod}} until end of turn and {{Creatures}} get {{PTMod}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), CreateEachPermanentLayerEffectUntil({{Creatures[1]}}, [AdjustPT({{PTMod[1]}})], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTMod}} until end of turn. Each opponent loses {{Digits}} life": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), EachPlayerAction(Opponent, LoseLife({{Digits[0]}}))])",
    "{{Creatures}} get {{PTMod}} until end of turn. If this is the third time this ability has resolved this turn, {{Creatures}} gain {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), If(TimesThisAbilityHasResolvedThisTurnIs(EqualTo(Integer(3))), [CreateEachPermanentLayerEffectUntil({{Creatures[1]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])])",
    "{{Creatures}} get {{PTMod}} until end of turn. Tap all {{Permanents}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), TapEachPermanent({{Permanents[0]}})])",
    "{{Creatures}} get {{PTMod}} until end of turn. Those creatures attack this turn if able": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), CreateEachPermanentRuleEffectUntil(ThePermanentsAffectedThisWay, [MustAttack], UntilEndOfTurn)])",
    "{{Creatures}} of the creature type of your choice attack this turn if able": "ActionList([ChooseACreatureType, CreateEachPermanentRuleEffectUntil(And([{{Creatures[0]}}, IsCreatureTypeVariable(TheChosenCreatureType)]), [MustAttack], UntilEndOfTurn)])",
    "{{Creatures}} target player controls attack this turn if able": "Targeted([TargetPlayer(AnyPlayer)], ActionList([CreateEachPermanentRuleEffectUntil(And([{{Creatures[0]}}, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]), [MustAttack], UntilEndOfTurn)]))",
    "{{Lands}} become {{PT}} creatures until end of turn. They're still lands": "ActionList([CreateEachPermanentLayerEffectUntil({{Lands[0]}}, [SetPT({{PT[0]}}), AddCardtype(Creature)], UntilEndOfTurn)])",
