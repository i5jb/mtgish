    "Enchanted creature can't be blocked": "PermanentRuleEffect(HostPermanent, [CantBeBlocked])",
    "Enchanted creature can't be blocked and has {{Hasable}}": "PermanentRuleEffect(HostPermanent, [CantBeBlocked]), PermanentLayerEffect(HostPermanent, [AddAbility([{{Hasable[0]}}])])",
    "Enchanted creature can't be blocked as long as {{Condition(ThatPermanent)}}": "If({{Condition(ThatPermanent=HostPermanent)[0]}}, [PermanentRuleEffect(HostPermanent, [CantBeBlocked])])",
