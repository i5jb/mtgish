  "{{TriggerEffect[EnchantedPlayer,TheChosenName](~Permanent)}}": {
    "Whenever {{EnchantedPlayer}} casts a spell with the chosen name, {{TriggerActions(~Permanent)}}": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(HostPlayer), IsNamed(TheChosenName)), {{TriggerActions(~Permanent=^~Permanent)[0]}})"
  },
  "{{TriggerEffect[EnchantedPlayer](~Permanent)}}": {
    "At the beginning of your upkeep, {{TriggerActions[EnchantedPlayer](~Permanent)}}": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), {{TriggerActions[EnchantedPlayer](~Permanent=^~Permanent)[0]}})",
    "At the beginning of {{EnchantedPlayer}}'s upkeep, {{TriggerActions(~Permanent,ThatPlayer)}}": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(HostPlayer)), {{TriggerActions(~Permanent=^~Permanent,ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "When this Aura enters, {{TriggerActions[EnchantedPlayer]}}": "TriggerA(WhenAPermanentEntersTheBattlefield(SinglePermanent({{~Permanent}})), {{TriggerActions[EnchantedPlayer][0]}})",
    "When you attack {{EnchantedPlayer}} or a planeswalker they control or when they attack you or a planeswalker you control, {{TriggerActions(~Permanent)}}": "TriggerA(Or([WhenAPlayerAttacksAPlayerAndOrPlaneswalkerTheyControl(SinglePlayer(You), SinglePlayer(HostPlayer)), WhenAPlayerAttacksAPlayerAndOrPlaneswalkerTheyControl(SinglePlayer(HostPlayer), SinglePlayer(You))]), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "When {{EnchantedPlayer}} loses the game, {{TriggerActions(~Permanent)}}": "TriggerA(WhenAPlayerLosesTheGame(SinglePlayer(HostPlayer)), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "Whenever {{EnchantedPlayer}} casts {{a}} {{Spell}} other than the {{Nth}} {{Spell}} they cast each turn or copies {{a}} {{Spell}}, {{TriggerActions(~Permanent,ThatPlayer)}}": "TriggerA(Or([WhenAPlayerCastsTheirNthSpellInATurn(SinglePlayer(HostPlayer), NotEqualTo({{Nth[0]}}), {{Spell[0]}}), WhenAPlayerCopiesASpell(SinglePlayer(HostPlayer), {{Spell[1]}})]), {{TriggerActions(~Permanent=^~Permanent,ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "Whenever {{EnchantedPlayer}} casts {{a}} {{Spell}}, {{TriggerActions(~Permanent)}}": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(HostPlayer), {{Spell[0]}}), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "Whenever {{EnchantedPlayer}} casts {{a}} {{Spell}}, {{TriggerActions(~Permanent,ThatPlayer)}}": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(HostPlayer), {{Spell[0]}}), {{TriggerActions(~Permanent=^~Permanent,ThatPlayer=Trigger_ThatPlayer)[0]}})"
  },
  "{{TriggerEffect[EnchantedPlayer]}}": {
    "At the beginning of combat on {{EnchantedPlayer}}'s turn, {{TriggerActions(ThatPlayer)}}": "TriggerA(AtTheBeginningOfCombatDuringAPlayersTurn(SinglePlayer(HostPlayer)), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "At the beginning of each end step, {{TriggerActions[EnchantedPlayer]}}": "TriggerA(AtTheBeginningOfAPlayersEndStep(AnyPlayer), {{TriggerActions[EnchantedPlayer][0]}})",
    "At the beginning of each of {{EnchantedPlayer}}'s postcombat main phases, {{TriggerActions}}": "TriggerA(AtTheBeginningOfAPlayersPostcombatMainPhase(SinglePlayer(You)), {{TriggerActions[0]}})",
    "At the beginning of your upkeep, {{TriggerActions[EnchantedPlayer]}}": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), {{TriggerActions[EnchantedPlayer][0]}})",
    "At the beginning of {{EnchantedPlayer}}'s draw step, {{TriggerActions(ThatPlayer)}}": "TriggerA(AtTheBeginningOfAPlayersDrawStep(SinglePlayer(HostPlayer)), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "At the beginning of {{EnchantedPlayer}}'s end step, {{TriggerActions(ThatPlayer)}}": "TriggerA(AtTheBeginningOfAPlayersEndStep(SinglePlayer(HostPlayer)), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "At the beginning of {{EnchantedPlayer}}'s first upkeep each turn, that player gets an additional upkeep step after this step": "TriggerA(AtTheBeginningOfAPlayersFirstUpkeepEachTurn(SinglePlayer(HostPlayer)), ActionList([ThereIsAnAdditionalUpkeepStep]))",
    "At the beginning of {{EnchantedPlayer}}'s upkeep, {{TriggerActions(ThatPlayer)}}": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(HostPlayer)), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "Whenever a creature {{EnchantedPlayer}} controls enters, {{TriggerActions(ThatPlayer)}}": "TriggerA(WhenAPermanentEntersTheBattlefield(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(HostPlayer))])), {{TriggerActions(ThatPlayer=HostPlayer)[0]}})",
    "Whenever a land {{EnchantedPlayer}} controls enters, {{TriggerActions}}": "TriggerA(WhenAPermanentEntersTheBattlefield(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(HostPlayer))])), {{TriggerActions[0]}})",
    "Whenever a player attacks {{EnchantedPlayer}} with one or more {{Creatures}}, that attacking player may tap or untap target {{Permanent}} of their choice": "TriggerA(WhenAPlayerAttacksAPlayerWithAnyNumberOfCreatures(AnyPlayer, SinglePlayer(HostPlayer), {{Creatures[0]}}), Targeted([TargetPermanentOfPlayersChoice({{Permanent[0]}}, Trigger_ThatPlayer)], ActionList([PlayerMayAction(Trigger_ThatPlayer, TapOrUntapPermanent(Ref_TargetPermanentOfPlayersChoice))])))",
    "Whenever a player attacks {{EnchantedPlayer}} with one or more {{Creatures}}, {{TriggerActions(TheAttackingPlayer)}}": "TriggerA(WhenAPlayerAttacksAPlayerWithAnyNumberOfCreatures(AnyPlayer, SinglePlayer(HostPlayer), {{Creatures[0]}}), {{TriggerActions(TheAttackingPlayer=Trigger_ThatPlayer)[0]}})",
    "Whenever {{EnchantedPlayer}} casts {{a}} {{Spell}}, {{TriggerActions(ThatSpell,ThatPlayer)}}": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(HostPlayer), {{Spell[0]}}), {{TriggerActions(ThatSpell=Trigger_ThatSpell,ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "Whenever {{EnchantedPlayer}} draws a card, {{TriggerActions(ThatPlayer)}}": "TriggerA(WhenAPlayerDrawsACard(SinglePlayer(HostPlayer)), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "Whenever {{EnchantedPlayer}} draws a card, {{TriggerActions}}": "TriggerA(WhenAPlayerDrawsACard(SinglePlayer(HostPlayer)), {{TriggerActions[0]}})",
    "Whenever {{EnchantedPlayer}} is attacked, {{TriggerActions(ThatPlayer)}}": "TriggerA(WhenAPlayerIsAttacked(SinglePlayer(HostPlayer)), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "Whenever {{EnchantedPlayer}} is dealt damage, {{TriggerActions(ThatPlayer)}}": "TriggerA(WhenAPlayerIsDealtDamage(SinglePlayer(HostPlayer)), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "Whenever {{a}} {{Creature}} attacks {{EnchantedPlayer}}, {{TriggerActions(ThatPermanent)}}": "TriggerA(WhenACreatureAttacksAPlayer({{Creature[0]}}, SinglePlayer(HostPlayer)), {{TriggerActions(ThatPermanent=Trigger_ThatCreature)[0]}})",
    "Whenever {{a}} {{Creature}} deals combat damage to {{EnchantedPlayer}}, {{TriggerActions(ThatCreature)}}": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer({{Creature[0]}}, SinglePlayer(HostPlayer)), {{TriggerActions(ThatCreature=Trigger_ThatCreature)[0]}})",
    "Whenever {{a}} {{Creature}} deals combat damage to {{EnchantedPlayer}}, {{TriggerActions(ThatPlayer,ThatCreature)}}": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer({{Creature[0]}}, SinglePlayer(HostPlayer)), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer,ThatCreature=Trigger_ThatCreature)[0]}})",
    "Whenever {{a}} {{Creature}} {{EnchantedPlayer}} controls dies, {{TriggerActions[WhenACreatureOrPlaneswalkerDies]}}": "TriggerA(WhenACreatureOrPlaneswalkerDies(And([{{Creature[0]}}, ControlledByPlayer(HostPlayer)])), {{TriggerActions[WhenACreatureOrPlaneswalkerDies][0]}})"
  },
  "{{TriggerEffect[EquippedCreature,TheExiledCard]}}": {
    "Whenever {{EquippedCreature}} deals combat damage to a player, {{TriggerActions[TheExiledCard]}}": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(HostPermanent), AnyPlayer), {{TriggerActions[TheExiledCard][0]}})"
  },
  "{{TriggerEffect[EquippedCreature](~Permanent)}}": {
    "When {{EquippedCreature}} deals combat damage to a player, {{TriggerActions(~Permanent)}}": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(HostPermanent), AnyPlayer), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "When {{EquippedCreature}} dies, {{TriggerActions(~Permanent)}}": "TriggerA(WhenACreatureOrPlaneswalkerDies(SinglePermanent(HostPermanent)), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "When {{EquippedCreature}} transforms, {{TriggerActions(~Permanent)}}": "TriggerA(WhenAPermanentTransforms(SinglePermanent(HostPermanent)), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "When {{ThisPermanent}} enters, attach it to target creature you control. When you do, equipped creature fights up to one target creature an opponent controls": "TriggerA(WhenAPermanentEntersTheBattlefield(SinglePermanent(ThisPermanent)), Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))], ActionList([ReflexiveActionTrigger(AttachPermanentToPermanent(ThisPermanent, Ref_TargetPermanent), Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(Opponent)]))], ActionList([HaveCreaturesFight(HostPermanent, Ref_TargetPermanent)])))])))",
    "When {{~Permanent}} is put into a graveyard from the battlefield, {{TriggerActions[EquippedCreature]}}": "TriggerA(WhenAPermanentIsPutIntoAPlayersGraveyard(SinglePermanent({{~Permanent}}), AnyPlayer), {{TriggerActions[EquippedCreature][0]}})",
    "Whenever equipped creature attacks, you may sacrifice a permanent other than that creature or this Equipment. If you do, draw a card": "TriggerA(WhenACreatureAttacks(SinglePermanent(HostPermanent)), ActionList([MayCost(SacrificeAPermanent(And([IsPermanent, Other(Trigger_ThatPermanent), Other({{~Permanent}})]))), If(CostWasPaid, [DrawACard])]))",
    "Whenever equipped creature attacks, {{TriggerActions(~Permanent)}}": "TriggerA(WhenACreatureAttacks(SinglePermanent(HostPermanent)), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "Whenever equipped creature attacks, {{TriggerActions(~Permanent,DefendingPlayer)}}": "TriggerA(WhenACreatureAttacks(SinglePermanent(HostPermanent)), {{TriggerActions(~Permanent=^~Permanent,DefendingPlayer=Trigger_DefendingPlayer)[0]}})",
    "Whenever equipped creature becomes untapped, {{TriggerActions(~Permanent)}}": "TriggerA(WhenAPermanentBecomesUntapped(SinglePermanent(HostPermanent)), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "Whenever equipped creature deals combat damage to a player, {{TriggerActions(ThatPermanent)}}": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(HostPermanent), AnyPlayer), {{TriggerActions(ThatPermanent=Trigger_ThatPermanent)[0]}})",
    "Whenever equipped creature deals combat damage to a player, {{TriggerActions(~Permanent)}}": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(HostPermanent), AnyPlayer), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "Whenever equipped creature deals combat damage to a player, {{TriggerActions(~Permanent,ThatPlayer)}}": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(HostPermanent), AnyPlayer), {{TriggerActions(~Permanent=^~Permanent,ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "Whenever equipped creature deals combat damage, {{TriggerActions(~Permanent)}}": "TriggerA(WhenACreatureDealsCombatDamage(SinglePermanent(HostPermanent)), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "Whenever equipped creature deals damage to a blocking creature, this Equipment deals that much damage to each other {{Permanent(DefendingPlayer)}}": "TriggerA(WhenAPermanentDealsDamageToAPermanent(SinglePermanent(HostPermanent), And([IsBlocking, IsCardtype(Creature)])), ActionList([PermanentDealsDamage({{~Permanent}}, Trigger_AmountOfDamageDealt, EachPermanent(And([Other(Trigger_ThatOtherPermanent), {{Permanent(DefendingPlayer=Trigger_DefendingPlayer)[0]}}])))]))",
    "Whenever equipped creature deals damage to {{a}} {{Creature}}, {{TriggerActions(~Permanent,ThatCreature)}}": "TriggerA(WhenAPermanentDealsDamageToAPermanent(SinglePermanent(HostPermanent), {{Creature[0]}}), {{TriggerActions(~Permanent=^~Permanent,ThatCreature=Trigger_ThatOtherPermanent)[0]}})",
    "Whenever equipped creature dies, {{TriggerActions(~Permanent)}}": "TriggerA(WhenACreatureOrPlaneswalkerDies(SinglePermanent(HostPermanent)), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "Whenever equipped creature mentors a creature, put {{a}} {{CounterType}} counter on that creature": "TriggerA(WhenACreatureMentorsACreature(SinglePermanent(HostPermanent), IsCardtype(Creature)), ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Trigger_ThatOtherCreature)]))",
    "Whenever this creature or {{EquippedCreature}} attacks, {{TriggerActions(ThatCreature)}}": "TriggerA(Or([WhenACreatureAttacks(SinglePermanent({{~Permanent}})), WhenACreatureAttacks(SinglePermanent(HostPermanent))]), {{TriggerActions(ThatCreature=Trigger_ThatCreature)[0]}})",
    "Whenever this creature or {{EquippedCreature}} attacks, {{TriggerActions(ThatPermanent)}}": "TriggerA(Or([WhenACreatureAttacks(SinglePermanent({{~Permanent}})), WhenACreatureAttacks(SinglePermanent(HostPermanent))]), {{TriggerActions(ThatPermanent=Trigger_ThatCreature)[0]}})",
    "Whenever this creature or {{EquippedCreature}} becomes blocked, {{TriggerActions(ThatPermanent,DefendingPlayer)}}": "TriggerA(Or([WhenACreatureBecomesBlocked(SinglePermanent({{~Permanent}})), WhenACreatureBecomesBlocked(SinglePermanent(HostPermanent))]), {{TriggerActions(ThatPermanent=Trigger_ThatCreature,DefendingPlayer=Trigger_DefendingPlayer)[0]}})",
    "Whenever this creature or {{EquippedCreature}} deals combat damage to a player, {{TriggerActions(ThatPermanent)}}": "TriggerA(Or([WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent({{~Permanent}}), AnyPlayer), WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(HostPermanent), AnyPlayer)]), {{TriggerActions(ThatPermanent=Trigger_ThatCreature)[0]}})",
    "Whenever this creature or {{EquippedCreature}} deals combat damage to a player, {{TriggerActions(ThatPlayer)}}": "TriggerA(Or([WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent({{~Permanent}}), AnyPlayer), WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(HostPermanent), AnyPlayer)]), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "Whenever this creature or {{EquippedCreature}} deals combat damage to a player, {{TriggerActions}}": "TriggerA(Or([WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent({{~Permanent}}), AnyPlayer), WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(HostPermanent), AnyPlayer)]), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Creature[EquippedCreature]}} dies, {{TriggerActions[WhenACreatureOrPlaneswalkerDies](~Permanent)}}": "TriggerA(WhenACreatureOrPlaneswalkerDies({{Creature[EquippedCreature][0]}}), {{TriggerActions[WhenACreatureOrPlaneswalkerDies](~Permanent=^~Permanent)[0]}})",
    "Whenever {{~Permanent}} or {{EquippedCreature}} deals combat damage to a player, if {{Condition(ThatPermanent)}}, {{TriggerActions(ThatPermanent)}}": "TriggerI(Or([WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent({{~Permanent}}), AnyPlayer), WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(HostPermanent), AnyPlayer)]), {{Condition(ThatPermanent=Trigger_ThatPermanent)[0]}}, {{TriggerActions(ThatPermanent=Trigger_ThatPermanent)[0]}})",
    "Whenever {{~Permanent}} or {{EquippedCreature}} dies, {{TriggerActions[WhenACreatureOrPlaneswalkerDies]}}": "TriggerA(Or([WhenACreatureOrPlaneswalkerDies(SinglePermanent({{~Permanent}})), WhenACreatureOrPlaneswalkerDies(SinglePermanent(HostPermanent))]), {{TriggerActions[WhenACreatureOrPlaneswalkerDies][0]}})"
  },
  "{{TriggerEffect[EquippedCreature]}}": {
    "At the beginning of combat on your turn, {{TriggerActions[EquippedCreature]}}": "TriggerA(AtTheBeginningOfCombatDuringAPlayersTurn(SinglePlayer(You)), {{TriggerActions[EquippedCreature][0]}})",
    "At the beginning of each combat, {{TriggerActions[EquippedCreature]}}": "TriggerA(AtTheBeginningOfCombatDuringAPlayersTurn(AnyPlayer), {{TriggerActions[EquippedCreature][0]}})",
    "At the beginning of each opponent's upkeep, {{TriggerActions[EquippedCreature](ThatPlayer)}}": "TriggerA(AtTheBeginningOfAPlayersUpkeep(Opponent), {{TriggerActions[EquippedCreature](ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "At the beginning of your end step, if {{Condition[EquippedCreature]}}, {{TriggerActions(ThatPermanent)}}": "TriggerI(AtTheBeginningOfAPlayersEndStep(SinglePlayer(You)), {{Condition[EquippedCreature][0]}}, {{TriggerActions(ThatPermanent=HostPermanent)[0]}})",
    "At the beginning of your upkeep, {{TriggerActions[EquippedCreature]}}": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), {{TriggerActions[EquippedCreature][0]}})",
    "Whenever an ability of {{EquippedCreature}} is activated, if {{Condition(ThatActivatedAbility)}}, {{TriggerActions(ThatActivatedAbility)}}": "TriggerI(WhenAnAbilityIsActivated(AbilityOfPermanent(HostPermanent)), {{Condition(ThatActivatedAbility=Trigger_ThatActivatedAbility)[0]}}, {{TriggerActions(ThatActivatedAbility=Trigger_ThatActivatedAbility)[0]}})",
    "Whenever another {{ArtifactOrCreature}} is put into a graveyard from the battlefield, {{TriggerActions[EquippedCreature]}}": "TriggerA(WhenAPermanentIsPutIntoAPlayersGraveyard(And([Other(ThisPermanent), Other(HostPermanent), {{ArtifactOrCreature[0]}}]), AnyPlayer), {{TriggerActions[EquippedCreature][0]}})",
    "Whenever equipped creature and at least one other {{Creature}} attack, {{TriggerActions}}": "TriggerA(WhenASingleCreatureAndANumberOfOtherCreaturesAttack(HostPermanent, GreaterThanOrEqualTo(Integer(1)), {{Creature[0]}}), {{TriggerActions[0]}})",
    "Whenever equipped creature attacks alone, {{TriggerActions(DefendingPlayer)}}": "TriggerA(WhenACreatureAttacksAlone(SinglePermanent(HostPermanent)), {{TriggerActions(DefendingPlayer=Trigger_DefendingPlayer)[0]}})",
    "Whenever equipped creature attacks alone, {{TriggerActions(ThatPermanent)}}": "TriggerA(WhenACreatureAttacksAlone(SinglePermanent(HostPermanent)), {{TriggerActions(ThatPermanent=Trigger_ThatCreature)[0]}})",
    "Whenever equipped creature attacks alone, {{TriggerActions}}": "TriggerA(WhenACreatureAttacksAlone(SinglePermanent(HostPermanent)), {{TriggerActions[0]}})",
    "Whenever equipped creature attacks or blocks, {{TriggerActions(ThatPermanent)}}": "TriggerA(Or([WhenACreatureAttacks(SinglePermanent(HostPermanent)), WhenACreatureBlocks(SinglePermanent(HostPermanent))]), {{TriggerActions(ThatPermanent=Trigger_ThatCreature)[0]}})",
    "Whenever equipped creature attacks the player with the most life or tied for most life, {{TriggerActions(ThatPlayer)}}": "TriggerA(WhenACreatureAttacksAPlayer(SinglePermanent(HostPermanent), LifeTotalIs(EqualTo(HighestLifeTotalAmongPlayers(AnyPlayer)))), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
