  },
  "{{SpellActions[MultiKicker](~Spell,X)}}": {
    "Choose any target, then choose another target for each time this spell was kicked. {{~Spell}} deals X damage to each of them": "Targeted([NumberAnyTargets(Plus(Integer(1), NumTimesSpellWasKicked({{~Spell}})))], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, Ref_AnyTargets)]))"
  },
  "{{SpellActions[Overload](~Spell)}}": {
    "Exile target {{SpecificCard}} from your graveyard. For each card exiled this way, copy it, and you may cast the copy without paying its mana cost. Exile {{~Spell}}": "OverloadPaid(ActionList([ExileEachCardFromPlayersGraveyard({{SpecificCard[0]}}, You), CopyExiledCards(TheCardsExiledThisWay), MayAction(CastAnyNumberOfCopiedCardsWithoutPaying), ExileSpell({{~Spell}})])), OverloadNotPaid(Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard), CopyExiledCard(TheCardExiledThisWay), MayAction(CastCopiedCardWithoutPaying), ExileSpell({{~Spell}})])))",
    "{{~Spell}} deals {{Digits}} damage to target {{Creature}}": "OverloadPaid(ActionList([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, EachPermanent({{Creature[0]}}))])), OverloadNotPaid(Targeted([TargetPermanent({{Creature[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent))])))"
  },
  "{{SpellActions[Overload](~Spell,X)}}": {
    "{{~Spell}} deals X damage to target {{Creature}}": "OverloadPaid(ActionList([SpellDealsDamage({{~Spell}}, {{X}}, EachPermanent({{Creature[0]}}))])), OverloadNotPaid(Targeted([TargetPermanent({{Creature[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, Permanent(Ref_TargetPermanent))])))"
  },
  "{{SpellActions[Overload]}}": {
    "Choose target {{Creature}}. For each creature chosen this way, create a token that's a copy of it": "OverloadPaid(ActionList([CreateTokens([TokenCopyOfEachPermanent({{Creature[0]}}, NoTokenCopyEffects)])])), OverloadNotPaid(Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreateTokens([TokenCopyOfPermanent(Ref_TargetPermanent, NoTokenCopyEffects)])])))",
    "Counter target {{Spell}}": "OverloadPaid(ActionList([CounterEachSpell({{Spell[0]}})])), OverloadNotPaid(Targeted([TargetSpell({{Spell[0]}})], ActionList([CounterSpell(Ref_TargetSpell)])))",
    "Destroy target {{Creature}}. A creature destroyed this way can't be regenerated": "OverloadPaid(ActionList([DestroyEachPermanentNoRegen({{Creature[0]}})])), OverloadNotPaid(Targeted([TargetPermanent({{Creature[0]}})], ActionList([DestroyPermanentNoRegen(Ref_TargetPermanent)])))",
    "Destroy target {{Permanent}}": "OverloadPaid(ActionList([DestroyEachPermanent({{Permanent[0]}})])), OverloadNotPaid(Targeted([TargetPermanent({{Permanent[0]}})], ActionList([DestroyPermanent(Ref_TargetPermanent)])))",
    "Exile target {{Creature}}. For each creature exiled this way, its controller searches their library for {{a}} {{SpecificCard}}. Those players put those cards onto the battlefield tapped, then shuffle": "OverloadPaid(ActionList([ExileEachPermanent({{Creature[0]}}), ActionForEachPermanentExiledThisWayByController([PlayerAction(ControllerOfEachableExiledPermanent, SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersTapped]), Shuffle]))])])), OverloadNotPaid(Targeted([TargetPermanent({{Creature[0]}})], ActionList([ExilePermanent(Ref_TargetPermanent), PlayerAction(ControllerOfPermanent(Ref_TargetPermanent), SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersTapped]), Shuffle]))])))",
    "Put {{a}} {{CounterType}} counter on target {{Creature}}, then double the number of {{CounterType}} counters on each creature that had a {{CounterType}} counter put on it this way": "OverloadPaid(ActionList([PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, {{Creature[0]}}), DoubleCountersOfTypeOnEachPermanent({{CounterType[1]}}, And([IsCardtype(Creature), HadACounterOfTypePutOnItThisWay({{CounterType[2]}})]))])), OverloadNotPaid(Targeted([TargetPermanent({{Creature[0]}})], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent), DoubleCountersOfTypeOnEachPermanent({{CounterType[1]}}, And([IsCardtype(Creature), HadACounterOfTypePutOnItThisWay({{CounterType[2]}})]))])))",
    "Put {{a}} {{CounterType}} counter on target {{Creature}}, then goad each creature that had {{a}} {{CounterType}} counter put on it this way": "OverloadPaid(ActionList([PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, {{Creature[0]}}), GoadEachCreature(And([IsCardtype(Creature), HadACounterOfTypePutOnItThisWay({{CounterType[1]}})]))])), OverloadNotPaid(Targeted([TargetPermanent({{Creature[0]}})], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent), GoadEachCreature(And([IsCardtype(Creature), HadACounterOfTypePutOnItThisWay({{CounterType[1]}})]))])))",
    "Return target {{Permanent}} to its owner's hand": "OverloadPaid(ActionList([PutEachPermanentIntoItsOwnersHand({{Permanent[0]}})])), OverloadNotPaid(Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutPermanentIntoItsOwnersHand(Ref_TargetPermanent)])))",
    "Tap target {{Permanent}}": "OverloadPaid(ActionList([TapEachPermanent({{Permanent[0]}})])), OverloadNotPaid(Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent)])))",
    "Target player discards {{Number}} cards": "OverloadPaid(ActionList([EachPlayerAction(AnyPlayer, DiscardNumberCards({{Number[0]}}))])), OverloadNotPaid(Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, DiscardNumberCards({{Number[0]}}))])))",
    "Target {{Artifact}} becomes {{a}} {{PT}} artifact creature. Put {{Number}} {{CounterType}} counters on each artifact that became a creature this way": "OverloadPaid(ActionList([CreateEachPermanentLayerEffect({{Artifact[0]}}, [SetPT({{PT[0]}}), AddCardtype(Artifact), AddCardtype(Creature)]), PutNumberCountersOfTypeOnEachPermanent({{Number[0]}}, {{CounterType[0]}}, ThePermanentsAffectedThisWay)])), OverloadNotPaid(Targeted([TargetPermanent({{Artifact[0]}})], ActionList([CreatePermanentLayerEffect(Ref_TargetPermanent, [SetPT({{PT[0]}}), AddCardtype(Artifact), AddCardtype(Creature)]), PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[0]}}, Ref_TargetPermanent)])))",
    "Target {{Creature}} gets {{PTMod}} and gains {{Hasable}} until end of turn": "OverloadPaid(ActionList([CreateEachPermanentLayerEffectUntil({{Creature[0]}}, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])), OverloadNotPaid(Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])))",
    "Target {{Creature}} gets {{PTMod}} until end of turn": "OverloadPaid(ActionList([CreateEachPermanentLayerEffectUntil({{Creature[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])), OverloadNotPaid(Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])))",
    "Target {{Creature}} gets {{PTMod}} until end of turn and attacks this turn if able": "OverloadPaid(ActionList([CreateEachPermanentLayerEffectUntil({{Creature[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), CreateEachPermanentRuleEffectUntil({{Creature[0]}}, [MustAttack], UntilEndOfTurn)])), OverloadNotPaid(Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [MustAttack], UntilEndOfTurn)])))",
    "Target {{Creature}} gets {{PTMod}} until end of turn and can't be blocked this turn": "OverloadPaid(ActionList([CreateEachPermanentLayerEffectUntil({{Creature[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), CreateEachPermanentRuleEffectUntil({{Creature[0]}}, [CantBeBlocked], UntilEndOfTurn)])), OverloadNotPaid(Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [CantBeBlocked], UntilEndOfTurn)])))",
    "Target {{Permanent}} gains {{Hasable}} until end of turn": "OverloadPaid(ActionList([CreateEachPermanentLayerEffectUntil({{Permanent[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])), OverloadNotPaid(Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])))",
    "Until end of turn, target {{Creature}} becomes {{a}} {{Black}} and {{Black}} {{Zombie}} with base power and toughness {{PT}}, loses all abilities, and gains {{Hasable}}": "OverloadPaid(ActionList([CreateEachPermanentLayerEffectUntil({{Creature[0]}}, [SetColor(SimpleColorList([{{Black[0]}}, {{Black[1]}}])), SetCreatureType({{Zombie[0]}}), SetPT({{PT[0]}}), AddAbilityAndLoseAllOtherAbilities([{{Hasable[0]}}])], UntilEndOfTurn)])), OverloadNotPaid(Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [SetColor(SimpleColorList([{{Black[0]}}, {{Black[1]}}])), SetCreatureType({{Zombie[0]}}), SetPT({{PT[0]}}), AddAbilityAndLoseAllOtherAbilities([{{Hasable[0]}}])], UntilEndOfTurn)])))",
    "Until end of turn, target {{Creature}} becomes {{a}} {{Black}} {{Zombie}} with base power and toughness {{PT}}": "OverloadPaid(ActionList([CreateEachPermanentLayerEffectUntil({{Creature[0]}}, [SetColor(SimpleColorList([{{Black[0]}}])), SetCreatureType({{Zombie[0]}}), SetPT({{PT[0]}})], UntilEndOfTurn)])), OverloadNotPaid(Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [SetColor(SimpleColorList([{{Black[0]}}])), SetCreatureType({{Zombie[0]}}), SetPT({{PT[0]}})], UntilEndOfTurn)])))",
    "Until end of turn, target {{Permanent}} gains \"{{QuotedAbility}}\"": "OverloadPaid(ActionList([CreateEachPermanentLayerEffectUntil({{Permanent[0]}}, [AddAbility([{{QuotedAbility[0]}}])], UntilEndOfTurn)])), OverloadNotPaid(Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{QuotedAbility[0]}}])], UntilEndOfTurn)])))"
  },
  "{{SpellActions[PaidAdditionalManaCost]}}": {
    "Prevent all combat damage that would be dealt this turn. If this spell's additional cost was paid, this effect doesn't affect combat damage that would be dealt by {{Creatures}}": "ActionList([IfElse(CastSpellPassesFilter(AdditionalCostWasPaid), [CreatePreventDamageUntil(CombatDamageWouldBeDealtByACreature(Not({{Creatures[0]}})), [PreventThatDamage], UntilEndOfTurn)], [CreatePreventDamageUntil(CombatDamageWouldBeDealt, [PreventThatDamage], UntilEndOfTurn)])])",
    "You gain {{Digits}} life plus an additional {{Digits}} life for each additional {{ManaCost}} you paid": "ActionList([GainLifeAndLifeForEach({{Digits[0]}}, {{Digits[1]}}, EachAdditionalManaCostPaid({{ManaCost[0]}}))])"
  },
  "{{SpellActions[Prowl]}}": {
    "Create X {{PT}} {{CreatureTokens}} with {{Hasable}}, where X is {{GameNumber}}. If this spell's prowl cost was paid, take an extra turn after this one": "ActionList([CreateTokens([NumberTokens({{GameNumber[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}]))]), If(CastSpellPassesFilter(ProwlCostWasPaid), [TakeAnExtraTurn])])",
    "Target player loses {{Digits}} life and you gain {{Digits}} life. If this spell's prowl cost was paid, draw a card": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, LoseLife({{Digits[0]}})), GainLife({{Digits[1]}}), If(CastSpellPassesFilter(ProwlCostWasPaid), [DrawACard])]))"
  },
  "{{SpellActions[RevealedACardOrSelectedAPermanent](~Spell)}}": {
    "{{~Spell}} deals {{Digits}} damage to target {{CreatureOrPlaneswalker}}. If you revealed {{a}} {{SpecificCard}} or chose {{a}} {{Permanent}} as you cast this spell, {{~Spell}} deals damage equal to the power of that card or creature instead": "Targeted([TargetPermanent({{CreatureOrPlaneswalker[0]}})], ActionList([IfElse(CastSpellPassesFilter(PlayerRevealedACardAsCast(You, {{SpecificCard[0]}})), [SpellDealsDamage({{~Spell}}, PowerOfTheRevealedCard, Permanent(Ref_TargetPermanent))], [IfElse(CastSpellPassesFilter(PlayerChoseAPermanentAsCast(You, {{Permanent[0]}})), [SpellDealsDamage({{~Spell}}, PowerOfTheSelectedPermanent, Permanent(Ref_TargetPermanent))], [SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent))])])]))"
  },
  "{{SpellActions[RevealedACard](~Spell)}}": {
    "{{~Spell}} deals {{Digits}} damage to target {{Creature}}. If you revealed {{a}} {{SpecificCard}} or controlled {{a}} {{Permanent}} as you cast this spell, {{~Spell}} deals {{Digits}} damage to that creature's controller": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent)), If(CastSpellPassesFilter(Or([PlayerRevealedACardAsCast(You, {{SpecificCard[0]}}), PlayerControlledAPermanentAsCast(You, {{Permanent[0]}})])), [SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Player(ControllerOfPermanent(Ref_TargetPermanent)))])]))"
  },
  "{{SpellActions[RevealedACard]}}": {
    "Counter target {{Spell}} unless its controller pays {{ManaCost}}. If you revealed {{a}} {{SpecificCard}} or controlled {{a}} {{Permanent}} as you cast this spell, counter that spell instead": "Targeted([TargetSpell({{Spell[0]}})], ActionList([IfElse(CastSpellPassesFilter(Or([PlayerRevealedACardAsCast(You, {{SpecificCard[0]}}), PlayerControlledAPermanentAsCast(You, {{Permanent[0]}})])), [CounterSpell(Ref_TargetSpell)], [PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [CounterSpell(Ref_TargetSpell)])])]))",
    "Target player sacrifices {{a}} {{Permanent}} of their choice. If you revealed {{a}} {{SpecificCard}} or controlled {{a}} {{Permanent}} as you cast this spell, you gain {{Digits}} life": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, SacrificeAPermanent({{Permanent[0]}})), If(CastSpellPassesFilter(Or([PlayerRevealedACardAsCast(You, {{SpecificCard[0]}}), PlayerControlledAPermanentAsCast(You, {{Permanent[0]}})])), [GainLife({{Digits[0]}})])]))"
  },
  "{{SpellActions[Surge]}}": {
    "Return all {{Permanents}} to their owners' hands. If this spell's surge cost was paid, create {{a}} {{PT}} {{CreatureToken}}": "ActionList([PutEachPermanentIntoItsOwnersHand({{Permanents[0]}}), If(CastSpellPassesFilter(SurgeCostWasPaid), [CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])])])"
  },
  "{{SpellActions[TheChosenNumber](~Spell)}}": {
    "{{~Spell}} deals X damage to target {{Creature}} and {{Digits}} minus X damage to that creature's controller, where X is the chosen number": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([SpellDealsMultipleDamage({{~Spell}}, [DamageToRecipients(TheChosenNumber, Permanent(Ref_TargetPermanent)), DamageToRecipients(Minus({{Digits[0]}}, TheChosenNumber), Player(ControllerOfPermanent(Ref_TargetPermanent)))])]))"
  },
  "{{SpellActions[TheDiscardedCards](~Spell,X)}}": {
    "{{~Spell}} deals damage equal to the total mana value of the discarded cards to each of up to X target {{CreaturesOrPlaneswalkers}}": "Targeted([UptoNumberTargetPermanents({{X}}, {{CreaturesOrPlaneswalkers[0]}})], ActionList([SpellDealsDamage({{~Spell}}, TotalManaValueOfTheCardsDiscardedThisWay, EachPermanent(Ref_TargetPermanents))]))"
  },
  "{{SpellActions[TheExiledCard](~Spell)}}": {
    "{{~Spell}} deals X damage to each {{Creature}}, where X is the exiled card's mana value. If a creature dealt damage this way would die this turn, exile it instead": "ActionList([SpellDealsDamage({{~Spell}}, ManaValueOfExiled(TheExiledCard), EachPermanent({{Creature[0]}})), CreateReplaceWouldPutIntoGraveyardUntil(APermanentWouldDie(And([IsCardtype(Creature), WasDealtDamageThisWay])), [ExileItInstead], UntilEndOfTurn)])",
    "{{~Spell}} deals damage equal to the exiled card's power to each {{Creature}} and each {{Planeswalker}}": "ActionList([SpellDealsDamage({{~Spell}}, PowerOfExiledCard(TheExiledCard), MultipleRecipients([EachPermanent({{Creature[0]}}), EachPermanent({{Planeswalker[0]}})]))])",
    "{{~Spell}} deals damage equal to the exiled card's power to target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([SpellDealsDamage({{~Spell}}, PowerOfExiledCard(TheExiledCard), Permanent(Ref_TargetPermanent))]))"
  },
  "{{SpellActions[TheExiledPermanent]}}": {
    "Return target {{SpecificCard}} from your graveyard to the battlefield. Put {{a}} {{CounterType}} counter on that creature if the exiled creature was {{a}} {{Zombie}}": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersNormally]), If(APermanentWasExiledThisWay(And([IsCardtype(Creature), IsCreatureType({{Zombie[0]}})])), [PutACounterOfTypeOnPermanent({{CounterType[0]}}, ThePermanentPutOnTheBattlefieldThisWay)])]))"
  },
  "{{SpellActions[TheRevealedCard](~Spell)}}": {
    "{{~Spell}} deals X damage to each {{Creature}}, where X is the revealed card's mana value": "ActionList([SpellDealsDamage({{~Spell}}, ManaValueOfTheCardRevealedThisWay, EachPermanent({{Creature[0]}}))])",
    "{{~Spell}} deals damage to target {{CreatureOrPlaneswalker}} equal to the revealed card's power": "Targeted([TargetPermanent({{CreatureOrPlaneswalker[0]}})], ActionList([SpellDealsDamage({{~Spell}}, PowerOfTheRevealedCard, Permanent(Ref_TargetPermanent))]))"
  },
  "{{SpellActions[TheRevealedCard]}}": {
    "Exile each creature and planeswalker with mana value less than the revealed card's mana value": "ActionList([ExileEachPermanent(And([Or([IsCardtype(Creature), IsCardtype(Planeswalker)]), ManaValueIs(LessThan(ManaValueOfTheCardRevealedThisWay))]))])",
    "Exile target {{Creature}} if its power is less than or equal to the revealed card's power": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([If(PermanentPassesFilter(Ref_TargetPermanent, PowerIs(LessThanOrEqualTo(PowerOfTheRevealedCard))), [ExilePermanent(Ref_TargetPermanent)])]))",
    "Target {{Creature}} gets {{PTModX}} until end of turn, where X is the revealed card's mana value": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTX({{PTModX[0]}}, ManaValueOfTheCardRevealedThisWay)], UntilEndOfTurn)]))",
    "You gain life equal to the revealed card's mana value": "ActionList([GainLife(ManaValueOfTheCardRevealedThisWay)])"
  },
  "{{SpellActions[TheSacrificedCreatures]}}": {
    "Create {{a}} {{PTX}} {{CreatureToken}} with {{Hasable}}, where X is the total power of the sacrificed creatures": "ActionList([CreateTokens([TokenWithPT(PTX({{PTX[0]}}, TotalPowerOfPermanents(TheSacrificedPermanents)), {{CreatureToken[0]}}, [{{Hasable[0]}}])])])",
    "Target {{Creature}} gets {{PTMod}} until end of turn for each creature sacrificed this way": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTForEach({{PTMod[0]}}, TheNumberOfPermanentsSacrificedThisWay)], UntilEndOfTurn)]))"
  },
  "{{SpellActions[TheSacrificedPermanent](~Spell)}}": {
    "Add X mana in any combination of {{ManaProduceSymbol}} and/or {{ManaProduceSymbol}}, where X is {{GameNumber[ThatSacrificedPermanent]}}": "ActionList([AddCombinationMana(Or([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}]), {{GameNumber[ThatSacrificedPermanent][0]}})])",
    "Add X mana of any one color, where X is {{Digits}} plus {{GameNumber[ThatSacrificedPermanent]}}. Spend this mana only to cast {{PotentialSpells}}": "ActionList([AddManaRepeatedWithModifiers(AnyManaColor, Plus({{Digits[0]}}, {{GameNumber[ThatSacrificedPermanent][0]}}), CanOnlySpendOnSpells({{PotentialSpells[0]}}))])",
    "Add an amount of {{ManaProduceSymbol}} equal to {{GameNumber[ThatSacrificedPermanent]}}": "ActionList([AddManaRepeated({{ManaProduceSymbol[0]}}, {{GameNumber[ThatSacrificedPermanent][0]}})])",
    "All {{Creatures}} get {{PTModX}} until end of turn, where X is {{GameNumber[ThatSacrificedPermanent]}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPTX({{PTModX[0]}}, {{GameNumber[ThatSacrificedPermanent][0]}})], UntilEndOfTurn)])",
    "Choose target {{SpecificCard}} in your graveyard. Return that card and the sacrificed card to the battlefield under your control at the beginning of your next upkeep. Exile {{~Spell}}": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([CreateFutureTrigger(AtTheBeginningOfPlayersNextUpkeep(You), ActionList([ReturnEachGraveyardCardToBattlefield(Or([SingleGraveyardCard(Ref_TargetGraveyardCard), SingleGraveyardCard(TheSacrificedPermanent)]), [EntersUnderPlayersControl(You)])])), ExileSpell({{~Spell}})]))",
    "Create X {{PT}} {{CreatureTokens}} with \"{{TokenQuotedAbility}}\", where X is {{GameNumber[ThatSacrificedPermanent]}}": "ActionList([CreateTokens([NumberTokens({{GameNumber[ThatSacrificedPermanent][0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{TokenQuotedAbility[0]}}]))])])",
    "Create X {{PT}} {{CreatureTokens}}, where X is {{GameNumber[ThatSacrificedPermanent]}}": "ActionList([CreateTokens([NumberTokens({{GameNumber[ThatSacrificedPermanent][0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])])",
    "Create {{Number}} tapped Powerstone tokens. If the sacrificed artifact was legendary, draw a card": "ActionList([CreateTokensWithFlags([NumberTokens({{Number[0]}}, PowerstoneToken)], [EntersTapped]), If(APermanentWasSacrificedThisWay(IsSupertype(Legendary)), [DrawACard])])",
    "Destroy all creatures that share a creature type with the sacrificed creature. They can't be regenerated": "ActionList([DestroyEachPermanentNoRegen(And([IsCardtype(Creature), SharesACreatureTypeWithPermanent(TheSacrificedPermanent)]))])",
    "Draw cards equal to {{GameNumber[ThatSacrificedPermanent]}}": "ActionList([DrawNumberCards({{GameNumber[ThatSacrificedPermanent][0]}})])",
    "Draw {{Number}} cards. If the sacrificed creature was legendary, draw {{Number}} cards instead": "ActionList([IfElse(APermanentWasSacrificedThisWay(IsSupertype(Legendary)), [DrawNumberCards({{Number[1]}})], [DrawNumberCards({{Number[0]}})])])",
    "Each opponent chooses a permanent they control that shares a card type with the sacrificed permanent and sacrifices it.\nDraw a card": "ActionList([EachPlayerAction(Opponent, SacrificeAPermanent(SharesACardtypeWithTheSacrificedPermanent)), DrawACard])",
    "Put X {{CounterType}} counters on target {{Creature}}, where X is {{GameNumber[ThatSacrificedPermanent]}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([PutNumberCountersOfTypeOnPermanent({{GameNumber[ThatSacrificedPermanent][0]}}, {{CounterType[0]}}, Ref_TargetPermanent)]))",
    "Search your library for a creature card with mana value X or less, where X is {{Digits}} plus {{GameNumber[ThatSacrificedPermanent]}}. Put that card onto the battlefield, then shuffle. Exile {{~Spell}}": "ActionList([SearchLibrary([FindACardOfType(And([IsCardtype(Creature), ManaValueIs(LessThanOrEqualTo(Plus({{Digits[0]}}, {{GameNumber[ThatSacrificedPermanent][0]}})))])), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle]), ExileSpell({{~Spell}})])",
    "Search your library for a creature card with mana value equal to {{Digits}} plus {{GameNumber[ThatSacrificedPermanent]}}, put that card onto the battlefield with an additional {{CounterType}} counter on it, then shuffle": "ActionList([SearchLibrary([FindACardOfType(And([IsCardtype(Creature), ManaValueIs(EqualTo(Plus({{Digits[0]}}, {{GameNumber[ThatSacrificedPermanent][0]}})))])), PutFoundCardsOntoBattlefield([EntersWithACounter({{CounterType[0]}})]), Shuffle])])",
    "Target player discards a number of cards equal to {{GameNumber[ThatSacrificedPermanent]}}": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, DiscardNumberCards({{GameNumber[ThatSacrificedPermanent][0]}}))]))",
    "Target player reveals their hand and discards all cards of each of the sacrificed creature's colors": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, RevealHandAndDiscardEachCard(SharesAColorWithPermanent(TheSacrificedPermanent)))]))",
    "Target {{Creature}} gets {{PTModX}} until end of turn, where X is {{GameNumber[ThatSacrificedPermanent]}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTX({{PTModX[0]}}, {{GameNumber[ThatSacrificedPermanent][0]}})], UntilEndOfTurn)]))",
    "You draw cards equal to the sacrificed creature's power, then you gain life equal to its toughness": "ActionList([DrawNumberCards(PowerOfTheSacrificedCreature), GainLife(ToughnessOfTheSacrificedCreature)])",
    "You gain life equal to {{GameNumber[ThatSacrificedPermanent]}}": "ActionList([GainLife({{GameNumber[ThatSacrificedPermanent][0]}})])",
    "You gain life equal to {{GameNumber[ThatSacrificedPermanent]}}. Destroy target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([GainLife({{GameNumber[ThatSacrificedPermanent][0]}}), DestroyPermanent(Ref_TargetPermanent)]))",
    "You gain life equal to {{GameNumber[ThatSacrificedPermanent]}}. Draw {{Number}} cards": "ActionList([GainLife({{GameNumber[ThatSacrificedPermanent][0]}}), DrawNumberCards({{Number[0]}})])",
    "{{~Spell}} deals damage equal to {{GameNumber[ThatSacrificedPermanent]}} to any target": "Targeted([AnyTarget], ActionList([SpellDealsDamage({{~Spell}}, {{GameNumber[ThatSacrificedPermanent][0]}}, Ref_AnyTarget)]))",
    "{{~Spell}} deals damage equal to {{GameNumber[ThatSacrificedPermanent]}} to any target. Draw a card": "Targeted([AnyTarget], ActionList([SpellDealsDamage({{~Spell}}, {{GameNumber[ThatSacrificedPermanent][0]}}, Ref_AnyTarget), DrawACard]))",
    "{{~Spell}} deals damage equal to {{GameNumber[ThatSacrificedPermanent]}} to target player or planeswalker. You gain life equal to the damage dealt this way": "Targeted([TargetPlayerOrPermanent(AnyPlayer, IsCardtype(Planeswalker))], ActionList([SpellDealsDamage({{~Spell}}, {{GameNumber[ThatSacrificedPermanent][0]}}, Ref_TargetPlayerOrPermanent), GainLife(TheAmountOfDamageDealtThisWay)]))",
    "{{~Spell}} deals damage to target opponent or planeswalker equal to {{GameNumber[ThatSacrificedPermanent]}}": "Targeted([TargetPlayerOrPermanent(Opponent, IsCardtype(Planeswalker))], ActionList([SpellDealsDamage({{~Spell}}, {{GameNumber[ThatSacrificedPermanent][0]}}, Ref_TargetPlayerOrPermanent)]))",
    "{{~Spell}} deals {{Digits}} damage to any target. If the sacrificed permanent was an artifact, you gain {{Digits}} life": "Targeted([AnyTarget], ActionList([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Ref_AnyTarget), If(APermanentWasSacrificedThisWay(IsCardtype(Artifact)), [GainLife({{Digits[1]}})])]))"
  },
  "{{SpellActions[TheSacrificedPermanents](~Spell)}}": {
    "{{~Spell}} deals damage to any target equal to the total power of the sacrificed creatures": "Targeted([AnyTarget], ActionList([SpellDealsDamage({{~Spell}}, TheTotalPowerOfThePermanentsSacrificedThisWay, Ref_AnyTarget)]))"
  },
  "{{SpellActions[TheSacrificedPermanents]}}": {
    "Target player loses {{Digits}} life plus {{Digits}} life for each {{Zombie}} sacrificed this way. You gain that much life": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, LoseLifeAndLifeForEach({{Digits[0]}}, {{Digits[1]}}, TheNumberOfPermanentsSacrificedThisWay)), GainLife(LifeLostThisWay)]))",
    "Target {{Creature}} gets {{PTMod}} until end of turn. For each {{Zombie}} sacrificed this way, that creature gets an additional {{PTMod}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTForEach({{PTMod[1]}}, TheNumberOfPermanentsSacrificedThisWay)], UntilEndOfTurn)]))"
  },
  "{{SpellActions[TheTappedPermanents](~Spell)}}": {
    "{{~Spell}} deals damage to any target equal to {{Number}} times the number of {{Permanents}} tapped this way": "Targeted([AnyTarget], ActionList([SpellDealsDamage({{~Spell}}, TheNumberOfPermanentsTappedThisWay, Ref_AnyTarget)]))"
  },
  "{{SpellActions[TheTappedPermanents]}}": {
    "Exile target {{Permanent}}. Put {{a}} {{CounterType}} counter on the {{Permanent}} tapped to pay this spell's additional cost": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([ExilePermanent(Ref_TargetPermanent), PutACounterOfTypeOnPermanent({{CounterType[0]}}, ThePermanentTappedThisWay)]))"
  },
  "{{SpellActions}}": {
    "Exile all the cards from your hand, then draw that many cards. Until the end of your next turn, you may play cards exiled this way": "ActionList([ExileHand, DrawNumberCards(TheNumberOfCardsInHandExiledThisWay), CreatePlayerEffectUntil(You, [MayPlayExiledCards(WasExiledThisWay)], UntilPlayersNextTurn(You))])",

    "Add one mana of any color": "ActionList([AddMana(AnyManaColor)])",
    "Add {{ManaProduceSymbol}} for each card in target opponent's hand": "Targeted([TargetPlayer(Opponent)], ActionList([AddManaRepeated({{ManaProduceSymbol[0]}}, TheNumberOfCardsInPlayersHand(Ref_TargetPlayer))]))",
    "Add {{ManaProduceSymbol}} for each {{Eachable}}": "ActionList([AddManaRepeated({{ManaProduceSymbol[0]}}, {{Eachable[0]}})])",
    "Add {{ManaProduceSymbol}} for each {{Eachable}}. Until end of turn, {{Permanents}} gain \"{{QuotedAbility}}\"": "ActionList([AddManaRepeated({{ManaProduceSymbol[0]}}, {{Eachable[0]}}), CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{QuotedAbility[0]}}])], UntilEndOfTurn)])",
    "Add {{ManaProduceSymbol}}{{ManaProduceSymbol}}, then add {{ManaProduceSymbol}} for each {{Eachable}}": "ActionList([AddMana(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}])), AddManaRepeated({{ManaProduceSymbol[2]}}, {{Eachable[0]}})])",
    "Add {{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}": "ActionList([AddMana(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}, {{ManaProduceSymbol[2]}}]))])",
    "Add {{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}.\n{{AbilityWord}} - Add {{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}} instead if {{Condition}}": "ActionList([IfElse({{Condition[0]}}, [AddMana(And([{{ManaProduceSymbol[3]}}, {{ManaProduceSymbol[4]}}, {{ManaProduceSymbol[5]}}, {{ManaProduceSymbol[6]}}, {{ManaProduceSymbol[7]}}]))], [AddMana(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}, {{ManaProduceSymbol[2]}}]))])])",
    "Add {{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}": "ActionList([AddMana(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}, {{ManaProduceSymbol[2]}}, {{ManaProduceSymbol[3]}}]))])",
    "Add {{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}": "ActionList([AddMana(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}, {{ManaProduceSymbol[2]}}, {{ManaProduceSymbol[3]}}, {{ManaProduceSymbol[4]}}]))])",
    "Add {{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}. Spend this mana only to cast {{PotentialSpells}}": "ActionList([AddManaWithModifiers(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}, {{ManaProduceSymbol[2]}}, {{ManaProduceSymbol[3]}}, {{ManaProduceSymbol[4]}}, {{ManaProduceSymbol[5]}}, {{ManaProduceSymbol[6]}}]), CanOnlySpendOnSpells({{PotentialSpells[0]}}))])",
    "Add {{Number}} mana in any combination of colors.\nDraw a card": "ActionList([AddCombinationMana(AnyManaColor, {{Number[0]}}), DrawACard])",
    "Add {{Number}} mana of any one color and {{Number}} mana of any other color. Spend this mana only to cast {{PotentialSpells}}": "ActionList([AddManaRepeatedTwiceWithModifiers(AnyManaColor, {{Number[0]}}, AnyOtherManaColor, {{Number[0]}}, CanOnlySpendOnSpells({{PotentialSpells[0]}}))])",
    "Add {{Number}} {{ManaProduceSymbol}}. You can cast only one more spell this turn": "ActionList([AddManaRepeated({{ManaProduceSymbol[0]}}, {{Number[0]}}), CreateFuturePlayerEffect(You, CanCastOnlyOneMoreSpellThisTurn)])",
    "After the second main phase this turn, there's an additional combat phase followed by an additional main phase. At the beginning of that combat, untap all {{Permanents}}": "ActionList([AfterTheSecondMainPhaseThisTurnThereIsAnAdditionalCombatPhaseAndAnAdditionalMainPhaseWithAtTheBeginningOfCombatTrigger(ActionList([UntapEachPermanent({{Permanents[0]}})]))])",
    "After this main phase, there are two additional combat phases.\nAt the beginning of each combat this turn, untap all {{Permanents}}": "ActionList([AfterThisMainPhaseThereAreAnAdditionalNumberCombatPhases(Integer(2)), CreateTriggerUntil(AtTheBeginningOfCombat, ActionList([UntapEachPermanent({{Permanents[0]}})]), UntilEndOfTurn)])",
    "Airbend target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([AirbendPermanent(Ref_TargetPermanent)]))",
    "Airbend target {{Permanent}}. {{Reminder}}\nDraw a card": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([AirbendPermanent(Ref_TargetPermanent), DrawACard]))",
    "All combat damage that would be dealt to you this turn by target {{Creature}} is dealt to its controller instead": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreateReplaceWouldDealDamageUntil(CombatDamageWouldBeDealtByCreatureToRecipient(Ref_TargetPermanent, Player(You)), [DealToPlayerInstead(WouldDealDamage_ControllerOfDamageSource)], UntilEndOfTurn)]))",
    "All combat damage that would be dealt to you this turn is dealt to target {{Creature}} instead": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreateReplaceWouldDealDamageUntil(CombatDamageWouldBeDealtToRecipient(Player(You)), [DealToCreatureOrPlaneswalkerInstead(Ref_TargetPermanent)], UntilEndOfTurn)]))",
    "All creatures able to block target {{Creature}} this turn do so.\n{{AbilityWord}} - That creature gains {{Hasable}} until end of turn if {{Condition}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreateEachPermanentRuleEffectUntil(IsCardtype(Creature), [MustBlockAttacker(Ref_TargetPermanent)], UntilEndOfTurn), If({{Condition[0]}}, [CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])]))",
    "All damage that would be dealt this turn by target {{Spell}} is dealt to that spell's controller instead": "Targeted([TargetSpell({{Spell[0]}})], ActionList([CreateReplaceWouldDealDamageUntil(DamageWouldBeDealtBySpell(Ref_TargetSpell), [DealToPlayerInstead(WouldDealDamage_ControllerOfDamageSource)], UntilEndOfTurn)]))",
    "All damage that would be dealt this turn to target creature you control by {{a}} {{DamageSource}} of your choice is dealt to another target creature instead": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))])), TargetPermanent(And([Other(Ref_TargetPermanent1), IsCardtype(Creature)]))], ActionList([ChooseADamageSource({{DamageSource[0]}}), CreateReplaceWouldDealDamageUntil(DamageWouldBeDealtBySourceToRecipient(TheChosenDamageSource, Permanent(Ref_TargetPermanent1)), [DealToCreatureOrPlaneswalkerInstead(Ref_TargetPermanent2)], UntilEndOfTurn)]))",
    "All damage that would be dealt to target {{Creature}} this turn is dealt to you instead": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreateReplaceWouldDealDamageUntil(DamageWouldBeDealtToRecipient(Permanent(Ref_TargetPermanent)), [DealToPlayerInstead(You)], UntilEndOfTurn)]))",
    "All {{Creatures}} able to block target {{Creature}} this turn do so": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreateEachPermanentRuleEffectUntil({{Creatures[0]}}, [MustBlockAttacker(Ref_TargetPermanent)], UntilEndOfTurn)]))",
    "All {{Creatures}} get {{PTModX}} until end of turn, where X is {{GameNumber}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPTX({{PTModX[0]}}, {{GameNumber[0]}})], UntilEndOfTurn)])",
    "All {{Creatures}} get {{PTMod}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])",
    "All {{Creatures}} get {{PTMod}} until end of turn for each {{Eachable}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPTForEach({{PTMod[0]}}, {{Eachable[0]}})], UntilEndOfTurn)])",
    "All {{Creatures}} get {{PTMod}} until end of turn.\nSurveil {{Digits}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), Surveil({{Digits[0]}})])",
    "All {{Creatures}} get {{PTMod}} until end of turn.\nYou may cast a spell with mana value {{Digits}} or less from your hand without paying its mana cost": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), CastASpellFromHandWithoutPaying(ManaValueIs(LessThanOrEqualTo({{Digits[0]}})))])",
    "All {{Creatures}} get {{PTMod}} until end of turn. Exile all {{SpecificCards}} in all graveyards that were put there from the battlefield this turn. If a creature would die this turn, exile it instead": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), Exile([GraveyardCards(And([{{SpecificCards[0]}}, WasPutIntoGraveyardFromTheBattlefieldThisTurn]))]), CreateReplaceWouldPutIntoGraveyardUntil(APermanentWouldDie(IsCardtype(Creature)), [ExileItInstead], UntilEndOfTurn)])",
    "All {{Creatures}} get {{PTMod}} until end of turn. If {{a}} {{Creature}} would die this turn, exile it instead": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), CreateReplaceWouldPutIntoGraveyardUntil(APermanentWouldDie({{Creature[0]}}), [ExileItInstead], UntilEndOfTurn)])",
    "All {{Creatures}} get {{PTMod}} until end of turn. Scry {{Digits}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), Scry({{Digits[0]}})])",
    "All {{Creatures}} get {{PTMod}} until end of turn. Whenever a creature dies this turn, you gain {{Digits}} life": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), CreateTriggerUntil(WhenACreatureOrPlaneswalkerDies(IsCardtype(Creature)), ActionList([GainLife({{Digits[0]}})]), UntilEndOfTurn)])",
    "All {{Creatures}} get {{PTMod}} until end of turn. You become the monarch": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), BecomeTheMonarch])",
    "All {{Creatures}} get {{PTMod}} until end of turn. {{Creatures}} get an additional {{PTMod}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), CreateEachPermanentLayerEffectUntil({{Creatures[1]}}, [AdjustPT({{PTMod[1]}})], UntilEndOfTurn)])",
    "All {{Lands}} become {{PT}} creatures until end of turn. They're still lands": "ActionList([CreateEachPermanentLayerEffectUntil({{Lands[0]}}, [SetPT({{PT[0]}}), AddCardtype(Creature)], UntilEndOfTurn)])",
    "All {{Permanents}} gain {{Hasable}} and {{Hasable}} until end of turn. Players gain hexproof until end of turn. Players can't lose life this turn and players can't lose the game or win the game this turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn), CreateEachPlayerEffectUntil(AnyPlayer, [Hexproof], UntilEndOfTurn), CreateEachPlayerEffectUntil(AnyPlayer, [CantLoseLife, CantLoseTheGame, CantWinTheGame], UntilEndOfTurn)])",
    "All {{Permanents}} gain {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "All {{Permanents}} gain {{Hasable}} until end of turn. {{Reminder}}\nDraw a card": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), DrawACard])",
    "All {{Permanents}} gain {{Hasable}} until end of turn. {{Reminder}}\nDraw a card at the beginning of the next turn's upkeep": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), CreateFutureTrigger(AtTheBeginningOfTheNextTurnsUpkeep, ActionList([DrawACard]))])",
    "All {{Permanents}} gain {{Hasable}} until end of turn. {{Reminder}}\n{{AbilityWord}} - If {{Condition}}, {{Creatures}} can't block this turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), If({{Condition[0]}}, [CreateGameEffect(UntilEndOfTurn, CreaturesCantBlock)])])",
    "All {{Permanents}} get {{PTMod}} until end of turn.\n{{AbilityWord}} - If {{Condition}}, destroy all {{Permanents}} instead": "ActionList([IfElse({{Condition[0]}}, [DestroyEachPermanent({{Permanents[1]}})], [CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])])",
    "All {{Permanents}} lose all abilities until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [LosesAllAbilities], UntilEndOfTurn)])",
    "All {{Permanents}} lose {{CheckHasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [LosesAbility({{CheckHasable[0]}})], UntilEndOfTurn)])",
    "All {{Permanents}} lose {{CheckHasable}} until end of turn, then destroy all {{Permanents}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [LosesAbility({{CheckHasable[0]}})], UntilEndOfTurn), DestroyEachPermanent({{Permanents[1]}})])",
    "All {{Permanents}} lose {{CheckHasable}} until end of turn. If a creature would deal combat damage to a creature this turn, it deals double that damage to that creature instead": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [LosesAbility({{CheckHasable[0]}})], UntilEndOfTurn), CreateReplaceWouldDealDamageUntil(CombatDamageWouldBeDealtByACreatureToARecipient(IsCardtype(Creature), APermanent(IsCardtype(Creature))), [DealDamageInstead(Twice(WouldDealDamage_ThatMuchDamage))], UntilEndOfTurn)])",
    "Amass {{Zombies}} X, where X is {{GameNumber}}": "ActionList([Amass({{GameNumber[0]}}, {{Zombies[0]}})])",
    "Amass {{Zombies}} {{Digits}}": "ActionList([Amass({{Digits[0]}}, {{Zombies[0]}})])",
    "Amass {{Zombies}} {{Digits}}, then target player mills X cards, where X is the amassed Army's power": "Targeted([TargetPlayer(AnyPlayer)], ActionList([Amass({{Digits[0]}}, {{Zombies[0]}}), PlayerAction(Ref_TargetPlayer, MillNumberCards(PowerOfPermanent(TheArmyAmassedThisWay)))]))",
    "Amass {{Zombies}} {{Digits}}, then the Army you amassed deals damage equal to {{GameNumber(ThatCreature)}} to each {{Creature}}": "ActionList([Amass({{Digits[0]}}, {{Zombies[0]}}), PermanentDealsDamage(TheArmyAmassedThisWay, {{GameNumber(ThatCreature=TheArmyAmassedThisWay)[0]}}, EachPermanent({{Creature[0]}}))])",
    "Amass {{Zombies}} {{Digits}}. {{Reminder}}\nYou and {{Permanents}} gain hexproof until end of turn": "ActionList([Amass({{Digits[0]}}, {{Zombies[0]}}), CreatePlayerEffectUntil(You, [Hexproof], UntilEndOfTurn), CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([Hexproof])], UntilEndOfTurn)])",
    "Any number of target opponents each discard their hands, then draw {{Number}} cards.\nDraw a card": "Targeted([AnyNumberOfTargetPlayers(Opponent)], ActionList([EachPlayerActions(Ref_TargetPlayers, [DiscardHand, DrawNumberCards({{Number[0]}})]), DrawACard]))",
    "Any number of target opponents each sacrifice a creature with the greatest power among creatures that player controls and lose {{Digits}} life": "Targeted([AnyNumberOfTargetPlayers(Opponent)], ActionList([EachPlayerActions(Ref_TargetPlayers, [SacrificeAPermanent(And([IsCardtype(Creature), PowerIs(EqualTo(TheGreatestPowerAmongPermanents(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(EachablePlayer))]))))])), LoseLife({{Digits[0]}})])]))",
    "Any number of target players each discard a number of cards equal to {{GameNumber}}": "Targeted([AnyNumberOfTargetPlayers(AnyPlayer)], ActionList([EachPlayerAction(Ref_TargetPlayers, DiscardNumberCards({{GameNumber[0]}}))]))",
    "Any number of target players each gain life equal to {{GameNumber}}": "Targeted([AnyNumberOfTargetPlayers(AnyPlayer)], ActionList([EachPlayerAction(Ref_TargetPlayers, GainLife({{GameNumber[0]}}))]))",
    "Any number of target players each gain {{Digits}} life": "Targeted([AnyNumberOfTargetPlayers(AnyPlayer)], ActionList([EachPlayerAction(Ref_TargetPlayers, GainLife({{Digits[0]}}))]))",
    "Any number of target players may each search their library for {{a}} {{SpecificCard}}, put it onto the battlefield under their control, then shuffle": "Targeted([AnyNumberOfTargetPlayers(AnyPlayer)], ActionList([EachPlayerMayAction(Ref_TargetPlayers, SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersUnderPlayersControl(EachablePlayer)]), Shuffle]))]))",
    "Any number of target {{Creatures}} and up to one other target {{Creature}} each deal damage equal to their power to target {{Creature}}": "Targeted([AnyNumberOfTargetPermanents({{Creatures[0]}}), UptoOneTargetPermanent(And([ExceptFor(Ref_TargetPermanents), {{Creature[0]}}])), TargetPermanent({{Creature[1]}})], ActionList([EachPermanentDealsDamage(Or([Ref_TargetPermanents, SinglePermanent(Ref_TargetPermanent1)]), PowerOfPermanent(EachablePermanent), Permanent(Ref_TargetPermanent2))]))",
    "Any number of target {{Creatures}} can't block this turn": "Targeted([AnyNumberOfTargetPermanents({{Creatures[0]}})], ActionList([CreateEachPermanentRuleEffectUntil(Ref_TargetPermanents, [CantBlock], UntilEndOfTurn)]))",
    "Any number of target {{Creatures}} each get {{PTMod}} and gain {{Hasable}} and {{Hasable}} until end of turn": "Targeted([AnyNumberOfTargetPermanents({{Creatures[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)]))",
    "Any number of target {{Creatures}} each get {{PTMod}} and gain {{Hasable}} until end of turn": "Targeted([AnyNumberOfTargetPermanents({{Creatures[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Any number of target {{Creatures}} each get {{PTMod}} until end of turn. Untap those creatures": "Targeted([AnyNumberOfTargetPermanents({{Creatures[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), UntapEachPermanent(Ref_TargetPermanents)]))",
    "Any number of target {{Permanents}} become the color of your choice until end of turn.\nDraw a card": "Targeted([AnyNumberOfTargetPermanents({{Permanents[0]}})], ActionList([ChooseAColor(AnyColor), CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [SetColor(TheChosenColor)], UntilEndOfTurn), DrawACard]))",
    "Any number of target {{Permanents}} each gain {{Hasable}} until end of turn": "Targeted([AnyNumberOfTargetPermanents({{Permanents[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Any number of target {{Permanents}} phase out": "Targeted([AnyNumberOfTargetPermanents({{Permanents[0]}})], ActionList([PhaseOutEachPermanent(Ref_TargetPermanents)]))",
    "Ascend {{Reminder}}\nAll {{Creatures}} get {{PTMod}} until end of turn. If {{Condition}}, instead only {{Creatures}} get {{PTMod}} until end of turn": "ActionList([Ascend, IfElse({{Condition[0]}}, [CreateEachPermanentLayerEffectUntil({{Creatures[1]}}, [AdjustPT({{PTMod[1]}})], UntilEndOfTurn)], [CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])])",
    "Ascend {{Reminder}}\nDraw {{Number}} cards. If {{Condition}}, draw {{Number}} cards instead": "ActionList([Ascend, IfElse({{Condition[0]}}, [DrawNumberCards({{Number[1]}})], [DrawNumberCards({{Number[0]}})])])",
    "Ascend {{Reminder}}\nEach opponent sacrifices {{a}} {{Permanent}} of their choice. If {{Condition}}, instead each opponent sacrifices half the {{Permanents}} they control of their choice, rounded up": "ActionList([Ascend, IfElse({{Condition[0]}}, [EachPlayerAction(Opponent, SacrificeNumberPermanents(HalfRoundedUp(TheNumberOfPermanentsOnTheBattlefield(And([{{Permanents[0]}}, ControlledByAPlayer(SinglePlayer(ActionPlayer))]))), {{Permanents[0]}}))], [EachPlayerAction(Opponent, SacrificeAPermanent({{Permanent[0]}}))])])",
    "Ascend {{Reminder}}\nReturn target {{Permanent}} to its owner's hand. If {{Condition}}, you may put that permanent on top of its owner's library instead": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([Ascend, IfElse({{Condition[0]}}, [MayCost(PutPermanentOnTopOfOwnersLibrary(Ref_TargetPermanent)), Unless(CostWasPaid, [PutPermanentIntoItsOwnersHand(Ref_TargetPermanent)])], [PutPermanentIntoItsOwnersHand(Ref_TargetPermanent)])]))",
    "Ascend {{Reminder}}\n{{Creatures}} get {{PTMod}} until end of turn. If {{Condition}}, those creatures get {{PTMod}} until end of turn instead": "ActionList([Ascend, IfElse({{Condition[0]}}, [CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[1]}})], UntilEndOfTurn)], [CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])])",
    "Attach target {{Permanent}} attached to a creature or land to another permanent of that type": "Targeted([TargetPermanent(And([{{Permanent[0]}}, AttachedToAPermanent(Or([IsCardtype(Creature), IsCardtype(Land)]))]))], ActionList([AttachPermanentToAPermanent(Ref_TargetPermanent, And([Or([IsCardtype(Creature), IsCardtype(Land)]), SharesACardtypeWithPermanent(HostPermanent)]))]))",
    "Attach target {{Permanent}} to target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}}), TargetPermanent({{Permanent[1]}})], ActionList([AttachPermanentToPermanent(Ref_TargetPermanent1, Ref_TargetPermanent2)]))",
    "Attach target {{Permanent}} to target {{Permanent}}.\nDraw a card": "Targeted([TargetPermanent({{Permanent[0]}}), TargetPermanent({{Permanent[1]}})], ActionList([AttachPermanentToPermanent(Ref_TargetPermanent1, Ref_TargetPermanent2), DrawACard]))",
    "Bolster X, where X is {{GameNumber}}. Each {{Permanent}} gains {{Hasable}} until end of turn": "ActionList([Bolster({{GameNumber[0]}}), CreateEachPermanentLayerEffectUntil({{Permanent[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "Bolster {{Digits}}": "ActionList([Bolster({{Digits[0]}})])",
    "Bolster {{Digits}}, then put {{a}} {{CounterType}} counter on each {{Permanent}}": "ActionList([Bolster({{Digits[0]}}), PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, {{Permanent[0]}})])",
    "Change the target of target activated ability with a single target. {{Reminder}}\nDraw a card": "Targeted([TargetAbility(And([ActivatedAbility, HasASingleTarget]))], ActionList([ChangeTargetsOfAbility(Ref_TargetAbility), DrawACard]))",
    "Change the target of target spell or ability with a single target": "Targeted([TargetSpellOrAbility(HasASingleTarget)], ActionList([ChangeTargetsOfSpellOrAbility(Ref_TargetSpellOrAbility)]))",
    "Change the target of target spell that targets only a player. The new target must be a player": "Targeted([TargetSpell(TargetsOnlyASinglePlayer(AnyPlayer))], ActionList([ChangeTheTargetsOfSpellToAPlayer(Ref_TargetSpell, AnyPlayer)]))",
    "Change the target of target spell with a single target": "Targeted([TargetSpell(HasASingleTarget)], ActionList([ChangeTargetsOfSpell(Ref_TargetSpell)]))",
    "Change the target of target spell with a single target unless that spell's controller pays {{ManaCost}}": "Targeted([TargetSpell(TargetsOnlyASingleTarget)], ActionList([PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [ChangeTargetsOfSpell(Ref_TargetSpell)])]))",
    "Change the target of target spell with a single target. You lose life equal to {{GameNumber(ThatSpell)}}": "Targeted([TargetSpell(TargetsOnlyASingleTarget)], ActionList([ChangeTargetsOfSpell(Ref_TargetSpell), LoseLife({{GameNumber(ThatSpell=Ref_TargetSpell)[0]}})]))",
    "Change the text of target permanent by replacing all instances of one color word with another or one basic land type with another": "Targeted([TargetPermanent(AnyPermanent)], ActionList([ChooseAnAction([[ChooseTwoColorWords, CreatePermanentLayerEffect(Ref_TargetPermanent, [ReplaceColorWordVariableWithNewColorWordVariable(TheFirstChosenColorWord, TheSecondChosenColorWord)])], [ChooseTwoBasicLandTypes, CreatePermanentLayerEffect(Ref_TargetPermanent, [ReplaceLandTypeVariableWithNewLandTypeVariable(TheFirstChosenLandType, TheSecondChosenLandType)])]])]))",
    "Change the text of target permanent by replacing all instances of one color word with another or one basic land type with another until end of turn": "Targeted([TargetPermanent(AnyPermanent)], ActionList([ChooseAnAction([[ChooseTwoColorWords, CreatePermanentLayerEffect(Ref_TargetPermanent, [ReplaceColorWordVariableWithNewColorWordVariable(TheFirstChosenColorWord, TheSecondChosenColorWord)])], [ChooseTwoBasicLandTypes, CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [ReplaceLandTypeVariableWithNewLandTypeVariable(TheFirstChosenLandType, TheSecondChosenLandType)], UntilEndOfTurn)]])]))",
    "Change the text of target spell or permanent by replacing all instances of one basic land type with another": "Targeted_Modal([Targeted([TargetSpell(AnySpell)], ActionList([ChooseTwoBasicLandTypes, CreateSpellEffect(Ref_TargetSpell, [ReplaceLandTypeVariableWithNewLandTypeVariable(TheFirstChosenLandType, TheSecondChosenLandType)])])), Targeted([TargetPermanent(AnyPermanent)], ActionList([ChooseTwoBasicLandTypes, CreatePermanentLayerEffect(Ref_TargetPermanent, [ReplaceLandTypeVariableWithNewLandTypeVariable(TheFirstChosenLandType, TheSecondChosenLandType)])]))])",
    "Change the text of target spell or permanent by replacing all instances of one color word with another": "Targeted_Modal([Targeted([TargetSpell(AnySpell)], ActionList([ChooseTwoColorWords, CreateSpellEffect(Ref_TargetSpell, [ReplaceColorWordVariableWithNewColorWordVariable(TheFirstChosenColorWord, TheSecondChosenColorWord)])])), Targeted([TargetPermanent(AnyPermanent)], ActionList([ChooseTwoColorWords, CreatePermanentLayerEffect(Ref_TargetPermanent, [ReplaceColorWordVariableWithNewColorWordVariable(TheFirstChosenColorWord, TheSecondChosenColorWord)])]))])",
    "Change the text of target spell or permanent by replacing all instances of one color word with another or one basic land type with another until end of turn.\nDraw a card": "Targeted_Modal([Targeted([TargetSpell(AnySpell)], ActionList([ChooseAnAction([[ChooseTwoColorWords, CreatePermanentSpellLayerEffect(UntilEndOfTurn, Ref_TargetSpell, [ReplaceColorWordVariableWithNewColorWordVariable(TheFirstChosenColorWord, TheSecondChosenColorWord)]), DrawACard], [ChooseTwoBasicLandTypes, CreateSpellEffect(Ref_TargetSpell, [ReplaceLandTypeVariableWithNewLandTypeVariable(TheFirstChosenLandType, TheSecondChosenLandType)])]])])), Targeted([TargetPermanent(AnyPermanent)], ActionList([ChooseAnAction([[ChooseTwoColorWords, CreatePermanentLayerEffect(Ref_TargetPermanent, [ReplaceColorWordVariableWithNewColorWordVariable(TheFirstChosenColorWord, TheSecondChosenColorWord)])], [ChooseTwoBasicLandTypes, CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [ReplaceLandTypeVariableWithNewLandTypeVariable(TheFirstChosenLandType, TheSecondChosenLandType)], UntilEndOfTurn), DrawACard]])]))])",
    "Change the text of target spell or permanent by replacing all instances of one creature type with another. The new creature type can't be {{Zombie}}": "Targeted_Modal([Targeted([TargetSpell(AnySpell)], ActionList([ChooseACreatureType_And_ChooseACreatureTypeOtherThan({{Zombie[0]}}), CreateSpellEffect(Ref_TargetSpell, [ReplaceColorWordVariableWithNewColorWordVariable(TheFirstChosenColorWord, TheSecondChosenColorWord)])])), Targeted([TargetPermanent(AnyPermanent)], ActionList([ChooseACreatureType_And_ChooseACreatureTypeOtherThan({{Zombie[0]}}), CreatePermanentLayerEffect(Ref_TargetPermanent, [ReplaceColorWordVariableWithNewColorWordVariable(TheFirstChosenColorWord, TheSecondChosenColorWord)])]))])",
    "Choose a card name other than a basic land card name. Reveal the top {{Number}} cards of your library and put all of them with that name into your hand. Exile the rest": "ActionList([ChooseACardName(Not(And([IsSupertype(Basic), IsCardtype(Land)]))), RevealTheTopNumberCardsOfLibrary({{Number[0]}}, [PutEachCardOfTypeIntoHand(IsNamed(TheChosenName)), ExileTheRemainingCards])])",
    "Choose a card name other than a basic land card name. Search target opponent's graveyard, hand, and library for any number of cards with that name and exile them. That player shuffles, then creates {{a}} {{PT}} {{CreatureToken}} for each card exiled from their hand this way": "Targeted([TargetPlayer(Opponent)], ActionList([ChooseACardName(Not(And([IsSupertype(Basic), IsCardtype(Land)]))), SearchPlayersLibraryAndGraveyardAndHand(Ref_TargetPlayer, [FindAnyNumberOfCardsOfType(IsNamed(TheChosenName)), ExileFoundCards, Shuffle]), PlayerAction(Ref_TargetPlayer, CreateTokens([NumberTokens(NumHandCardsExiledThisWay, TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, []))]))]))",
    "Choose a card name, then target opponent mills a card. If a card with the chosen name was milled this way, you draw a card.\nDraw a card at the beginning of the next turn's upkeep": "Targeted([TargetPlayer(Opponent)], ActionList([ChooseACardName(AnyOracleCard), PlayerAction(Ref_TargetPlayer, MillACard), If(ACardWasMilledThisWay(IsNamed(TheChosenName)), [DrawACard]), CreateFutureTrigger(AtTheBeginningOfTheNextTurnsUpkeep, ActionList([DrawACard]))]))",
    "Choose a card name, then target player mills a card. If a card with the chosen name was milled this way, you draw {{Number}} cards. Otherwise, you draw a card": "Targeted([TargetPlayer(AnyPlayer)], ActionList([ChooseACardName(AnyOracleCard), PlayerAction(Ref_TargetPlayer, MillACard), IfElse(ACardWasMilledThisWay(IsNamed(TheChosenName)), [DrawNumberCards({{Number[0]}})], [DrawACard])]))",
    "Choose a card name, then target player mills a card. If a card with the chosen name was milled this way, you gain life equal to its mana value.\nDraw a card": "Targeted([TargetPlayer(AnyPlayer)], ActionList([ChooseACardName(AnyOracleCard), PlayerAction(Ref_TargetPlayer, MillACard), If(ACardWasMilledThisWay(IsNamed(TheChosenName)), [GainLife(ManaValueOfTheCardMilledThisWay)]), DrawACard]))",
    "Choose a card name. Exile the top {{Number}} cards of your library, then reveal cards from the top of your library until you reveal a card with the chosen name. Put that card into your hand and exile all other cards revealed this way": "ActionList([ChooseACardName(AnyOracleCard), ExileTheTopNumberCardsOfLibrary({{Number[0]}}), RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed(IsNamed(TheChosenName), [PutTheCardFoundThisWayIntoHand, ExileTheRemainingCards])])",
    "Choose a card name. Reveal cards from the top of your library until you reveal a card with that name, then put that card into your hand. Exile all other cards revealed this way, and you lose {{Digits}} life for each of the exiled cards": "ActionList([ChooseACardName(AnyOracleCard), RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed(IsNamed(TheChosenName), [PutTheCardFoundThisWayIntoHand, ExileTheRemainingCards]), LoseLifeForEach({{Digits[0]}}, TheNumberOfLibraryCardsExiledThisWay)])",
    "Choose a card name. Search target opponent's graveyard, hand, and library for up to {{Number}} cards with that name and exile them. That player shuffles, then draws a card for each card exiled from their hand this way": "Targeted([TargetPlayer(Opponent)], ActionList([ChooseACardName(AnyOracleCard), SearchPlayersLibraryAndGraveyardAndHand(Ref_TargetPlayer, [FindUptoNumberCardsOfType({{Number[0]}}, IsNamed(TheChosenName)), ExileFoundCards, Shuffle]), PlayerAction(Ref_TargetPlayer, DrawNumberCards(NumHandCardsExiledThisWay))]))",
    "Choose a card name. Search target opponent's graveyard, hand, and library for up to {{Number}} cards with that name and exile them. Then that player shuffles": "Targeted([TargetPlayer(Opponent)], ActionList([ChooseACardName(AnyOracleCard), SearchPlayersLibraryAndGraveyardAndHand(Ref_TargetPlayer, [FindUptoNumberCardsOfType({{Number[0]}}, IsNamed(TheChosenName)), ExileFoundCards, Shuffle])]))",
    "Choose a card name. Target player reveals cards from the top of their library until a card with that name is revealed. If it is, that player puts the rest of the revealed cards into their graveyard and puts the card with the chosen name on top of their library. Otherwise, the player shuffles": "Targeted([TargetPlayer(AnyPlayer)], ActionList([ChooseACardName(AnyOracleCard), RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed(IsNamed(TheChosenName), [IfElse(ACardWasFoundThisWay, [PutTheCardFoundThisWayOnTopOfLibrary, PutTheRemainingCardsIntoGraveyard], [PutTheRemainingCardsBackIntoLibraryAndShuffle])])]))",
    "Choose a card name. Until your next turn, spells with the chosen name can't be cast and lands with the chosen name can't be played.\nDraw a card": "ActionList([ChooseACardName(AnyOracleCard), CreateEachPlayerEffectUntil(AnyPlayer, [CantCastSpells(IsNamed(TheChosenName)), CantPlayLandsOfType(IsNamed(TheChosenName))], UntilPlayersNextTurn(You)), DrawACard])",
    "Choose a card name. Until your next turn, your opponents can't cast spells with the chosen name": "ActionList([ChooseACardName(AnyOracleCard), CreateEachPlayerEffectUntil(Opponent, [CantCastSpells(IsNamed(TheChosenName))], UntilPlayersNextTurn(You))])",
    "Choose a card type, then reveal the top {{Number}} cards of your library. Put all cards of the chosen type revealed this way into your hand and the rest into your graveyard": "ActionList([ChooseACardtype, RevealTheTopNumberCardsOfLibrary({{Number[0]}}, [PutEachCardOfTypeIntoHand(IsCardtypeVariable(TheChosenCardtype)), PutTheRemainingCardsIntoGraveyard])])",
    "Choose a card type. Target opponent reveals their hand. Create {{Number}} {{PT}} {{CreatureTokens}} for each card of the chosen type revealed this way": "Targeted([TargetPlayer(Opponent)], ActionList([ChooseACardtype, PlayerAction(Ref_TargetPlayer, RevealHand), CreateTokens([NumberTokensForEach({{Number[0]}}, TheNumberOfCardsOfTypeRevealedFromHandThisWay(IsCardtypeVariable(TheChosenCardtype)), TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])]))",
    "Choose a color. All {{Permanents}} gain protection from the chosen color until end of turn": "ActionList([ChooseAColor(AnyColor), CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([Protection(FromColor(TheChosenColor))])], UntilEndOfTurn)])",
    "Choose a color. Target player reveals their hand and discards all cards of that color": "Targeted([TargetPlayer(AnyPlayer)], ActionList([ChooseAColor(AnyColor), PlayerActions(Ref_TargetPlayer, [RevealHand, DiscardCards(IsColor(TheChosenColor))])]))",
    "Choose a color. Target player reveals their hand and you choose a card of that color from it. That player discards that card": "Targeted([TargetPlayer(AnyPlayer)], ActionList([ChooseAColor(AnyColor), PlayerAction(Ref_TargetPlayer, RevealHand), ChooseACardFromPlayersRevealedHand(IsColor(TheChosenColor), Ref_TargetPlayer), PlayerAction(Ref_TargetPlayer, DiscardCard(TheCardChosenThisWay))]))",
    "Choose a color. Target {{Permanent}} and each other {{Permanent}} that shares a color with it gain protection from the chosen color until end of turn": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([ChooseAColor(AnyColor), CreateEachPermanentLayerEffectUntil(Or([SinglePermanent(Ref_TargetPermanent), And([Other(Ref_TargetPermanent), SharesAColorWithPermanent(Ref_TargetPermanent)])]), [AddAbility([Protection(FromColor(TheChosenColor))])], UntilEndOfTurn)]))",
    "Choose a color. {{Permanents}} gain protection from the chosen color until end of turn": "ActionList([ChooseAColor(AnyColor), CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([Protection(FromColor(TheChosenColor))])], UntilEndOfTurn)])",
    "Choose a counter on target permanent or suspended card. Remove that counter from that permanent or card or put another of those counters on it": "Targeted_Modal([Targeted([TargetPermanent(AnyPermanent)], ActionList([ChooseAnAction([[RemoveACounterFromPermanent(Ref_TargetPermanent)], [PutAnotherCounterOnPermanent(Ref_TargetPermanent)]])])), Targeted([TargetExiledCard(IsSuspended)], ActionList([ChooseAnAction([[RemoveACounterFromExiledCard(Ref_TargetExiledCard)], [PutAnotherCounterOnExiledCard(Ref_TargetExiledCard)]])]))])",
    "Choose a creature at random, then destroy the rest": "ActionList([ChooseAPermanentAtRandom(IsCardtype(Creature)), DestroyEachPermanent(Other(ThePermanentChosenThisWay))])",
    "Choose a creature at random. You gain control of that creature until end of turn. Untap it. It gains {{Hasable}} until end of turn. Then destroy all other creatures": "ActionList([ChooseAPermanentAtRandom(IsCardtype(Creature)), GainControlOfPermanentUntil(ThePermanentChosenThisWay, UntilEndOfTurn), UntapPermanent(ThePermanentChosenThisWay), CreatePermanentLayerEffectUntil(ThePermanentChosenThisWay, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), DestroyEachPermanent(ThePermanentsNotChosenThisWay)])",
    "Choose a creature card name. Search target opponent's graveyard, hand, and library for any number of cards with that name and exile them. Then that player shuffles": "Targeted([TargetPlayer(Opponent)], ActionList([ChooseACardName(IsCardtype(Creature)), SearchPlayersLibraryAndGraveyardAndHand(Ref_TargetPlayer, [FindAnyNumberOfCardsOfType(IsNamed(TheChosenName)), ExileFoundCards, Shuffle])]))",
    "Choose a creature card with mana value 1 in your graveyard, then do the same for creature cards with mana value 2 and 3. Return those cards to the battlefield": "ActionList([ReturnMultipleCardsFromPlayersGraveyardToBattlefield([And([IsCardtype(Creature), ManaValueIs(EqualTo(Integer(1)))]), And([IsCardtype(Creature), ManaValueIs(EqualTo(Integer(2)))]), And([IsCardtype(Creature), ManaValueIs(EqualTo(Integer(3)))])], You, [EntersNormally])])",
    "Choose a creature type other than {{Zombie}}. Each {{Creature}} becomes that type until end of turn": "ActionList([ChooseACreatureTypeOtherThan({{Zombie[0]}}), CreateEachPermanentLayerEffectUntil({{Creature[0]}}, [SetCreatureTypeVariable(TheChosenCreatureType)], UntilEndOfTurn)])",
    "Choose a creature type. All {{Creatures}} of that type get {{PTMod}} until end of turn": "ActionList([ChooseACreatureType, CreateEachPermanentLayerEffectUntil(And([{{Creatures[0]}}, IsCreatureTypeVariable(TheChosenCreatureType)]), [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])",
    "Choose a creature type. Destroy all {{Creatures}} that aren't of the chosen type": "ActionList([ChooseACreatureType, DestroyEachPermanent(And([{{Creatures[0]}}, IsNonCreatureTypeVariable(TheChosenCreatureType)]))])",
    "Choose a creature type. Draw a card for each permanent you control of that type": "ActionList([ChooseACreatureType, DrawNumberCards(TheNumberOfPermanentsOnTheBattlefield(And([ControlledByAPlayer(SinglePlayer(You)), IsCreatureTypeVariable(TheChosenCreatureType)])))])",
    "Choose a creature type. For each creature you control of the chosen type, create a token that's a copy of that creature. Those tokens gain {{Hasable}}. Exile them at the beginning of the next end step": "ActionList([ChooseACreatureType, CreateTokens([TokenCopyOfEachPermanent(And([IsCardtype(Creature), IsCreatureTypeVariable(TheChosenCreatureType)]), NoTokenCopyEffects)]), CreatePermanentLayerEffect(TheCreatedToken, [AddAbility([{{Hasable[0]}}])]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([ExileEachPermanent(TheCreatedTokens)]))])",
    "Choose a creature type. If you control more creatures of that type than each other player, you gain control of all creatures of that type": "ActionList([ChooseACreatureType, If(PlayerPassesFilter(You, ControlsMorePermanentsThanEachPlayer(Other(You), And([IsCardtype(Creature), IsCreatureTypeVariable(TheChosenCreatureType)]))), [GainControlOfEachPermanent(And([IsCardtype(Creature), IsCreatureTypeVariable(TheChosenCreatureType)]))])])",
    "Choose a creature type. Look at the top {{Number}} cards of your library. You may reveal any number of cards of the chosen type from among them and put the revealed cards into your hand. Put the rest on the bottom of your library in a random order": "ActionList([ChooseACreatureType, LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [MayRevealAnyNumberOfCardsOfTypeAndPutThemIntoHand(IsCreatureTypeVariable(TheChosenCreatureType)), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "Choose a creature type. Return all creature cards of the chosen type from your graveyard to the battlefield": "ActionList([ChooseACreatureType, PutEachGraveyardCardOntoBattlefield(And([IsCardtype(Creature), IsCreatureTypeVariable(TheChosenCreatureType), InAPlayersGraveyard(SinglePlayer(You))]), [EntersNormally])])",
    "Choose a creature type. Return all {{Creatures}} that aren't of the chosen type to their owners' hands": "ActionList([ChooseACreatureType, PutEachPermanentIntoItsOwnersHand(And([{{Creatures[0]}}, IsNonCreatureTypeVariable(TheChosenCreatureType)]))])",
    "Choose a creature type. Reveal cards from the top of your library until you reveal X creature cards of the chosen type, where X is the number of creatures you control of that type. Put those cards onto the battlefield, then shuffle the rest of the revealed cards into your library": "ActionList([ChooseACreatureType, RevealCardsFromTheTopOfLibraryUntilANumberOfCardsOfTypeAreRevealed(TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), IsCreatureTypeVariable(TheChosenCreatureType)])), And([IsCardtype(Creature), IsCreatureTypeVariable(TheChosenCreatureType)]), [PutTheCardsFoundThisWayOntoTheBattlefield([EntersNormally]), PutTheRemainingCardsBackIntoLibraryAndShuffle])])",
    "Choose a creature type. Target player draws X cards and loses X life, where X is the number of creatures they control of the chosen type": "Targeted([TargetPlayer(AnyPlayer)], ActionList([ChooseACreatureType, CreateValueX(TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer)), IsCreatureTypeVariable(TheChosenCreatureType)]))), PlayerActions(Ref_TargetPlayer, [DrawNumberCards(ValueX), LoseLife(ValueX)])]))",
    "Choose a creature type. Target player reveals their hand and discards all creature cards of that type. Then destroy all creatures of that type that player controls. They can't be regenerated": "Targeted([TargetPlayer(AnyPlayer)], ActionList([ChooseACreatureType, PlayerAction(Ref_TargetPlayer, RevealHandAndDiscardEachCard(And([IsCardtype(Creature), IsCreatureTypeVariable(TheChosenCreatureType)]))), DestroyEachPermanentNoRegen(And([IsCardtype(Creature), IsCreatureTypeVariable(TheChosenCreatureType), ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]))]))",
    "Choose a creature type. Target {{Creature}} gets {{PTMod}} until end of turn for each permanent of the chosen type you control": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([ChooseACreatureType, CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTForEach({{PTMod[0]}}, TheNumberOfPermanentsOnTheBattlefield(And([IsCreatureTypeVariable(TheChosenCreatureType), ControlledByAPlayer(SinglePlayer(You))])))], UntilEndOfTurn)]))",
    "Choose a creature type. You gain {{Digits}} life for each {{Permanent}} of that type": "ActionList([ChooseACreatureType, GainLifeForEach({{Digits[0]}}, TheNumberOfPermanentsOnTheBattlefield(And([{{Permanent[0]}}, IsCreatureTypeVariable(TheChosenCreatureType)])))])",
    "Choose a creature type. {{Creatures}} of the chosen type get {{PTMod}} and gain {{Hasable}} until end of turn": "ActionList([ChooseACreatureType, CreateEachPermanentLayerEffectUntil(And([{{Creatures[0]}}, IsCreatureTypeVariable(TheChosenCreatureType)]), [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "Choose a creature type. {{Creatures}} that aren't of the chosen type get {{PTMod}} until end of turn": "ActionList([ChooseACreatureType, CreateEachPermanentLayerEffectUntil(And([{{Creatures[0]}}, IsNonCreatureTypeVariable(TheChosenCreatureType)]), [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])",
    "Choose a land type and a basic land type. Each land of the first chosen type becomes the second chosen type until end of turn": "ActionList([ChooseALandTypeAndABasicLandType, CreateEachPermanentLayerEffectUntil(And([IsCardtype(Land), IsLandTypeVariable(TheFirstChosenLandType)]), [SetLandTypeVariable(TheSecondChosenLandType)], UntilEndOfTurn)])",
    "Choose a nonartifact, nonland card name. Search target player's graveyard, hand, and library for any number of cards with that name and exile them. That player shuffles, then draws a card for each card exiled from their hand this way": "Targeted([TargetPlayer(AnyPlayer)], ActionList([ChooseACardName(And([IsNonCardtype(Artifact), IsNonCardtype(Land)])), SearchPlayersLibraryAndGraveyardAndHand(Ref_TargetPlayer, [FindAnyNumberOfCardsOfType(IsNamed(TheChosenName)), ExileFoundCards, Shuffle]), PlayerAction(Ref_TargetPlayer, DrawNumberCards(NumHandCardsExiledThisWay))]))",
    "Choose a nonbasic land type. Each land you control of that type becomes a copy of target {{Permanent}} until end of turn and gains {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([ChooseANonBasicLandType, CreateEachPermanentLayerEffectUntil(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You)), IsLandTypeVariable(TheChosenLandType)]), [IsACopyOfPermanent(Ref_TargetPermanent, NoCopyEffects)], UntilEndOfTurn), CreateEachPermanentLayerEffectUntil(ThePermanentsAffectedThisWay, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Choose a nonland card name. Opponents can't cast spells with the chosen name until your next turn": "ActionList([ChooseACardName(IsNonCardtype(Land)), CreateEachPlayerEffectUntil(Opponent, [CantCastSpells(IsNamed(TheChosenName))], UntilPlayersNextTurn(You))])",
    "Choose a nonland card name. Search target opponent's graveyard, hand, and library for any number of cards with that name and exile them. Then that player shuffles": "Targeted([TargetPlayer(Opponent)], ActionList([ChooseACardName(IsNonCardtype(Land)), SearchPlayersLibraryAndGraveyardAndHand(Ref_TargetPlayer, [FindAnyNumberOfCardsOfType(IsNamed(TheChosenName)), ExileFoundCards, Shuffle])]))",
    "Choose a nonland card name. Search target player's graveyard, hand, and library for all cards with that name and exile them. Then that player shuffles": "Targeted([TargetPlayer(AnyPlayer)], ActionList([ChooseACardName(IsNonCardtype(Land)), SearchPlayersLibraryAndGraveyardAndHand(Ref_TargetPlayer, [FindAllCardsOfType(IsNamed(TheChosenName)), ExileFoundCards, Shuffle])]))",
    "Choose a nonland card name. Search target player's graveyard, hand, and library for any number of cards with that name and exile them. Then that player shuffles": "Targeted([TargetPlayer(AnyPlayer)], ActionList([ChooseACardName(IsNonCardtype(Land)), SearchPlayersLibraryAndGraveyardAndHand(Ref_TargetPlayer, [FindAnyNumberOfCardsOfType(IsNamed(TheChosenName)), ExileFoundCards, Shuffle])]))",
    "Choose a nonland card name. Target player reveals their hand and discards all cards with that name": "Targeted([TargetPlayer(AnyPlayer)], ActionList([ChooseACardName(IsNonCardtype(Land)), PlayerActions(Ref_TargetPlayer, [RevealHand, DiscardCards(IsNamed(TheChosenName))])]))",
    "Choose a nonland card name. Target player reveals their hand. That player discards a card with that name. If they can't, you draw a card": "Targeted([TargetPlayer(AnyPlayer)], ActionList([ChooseACardName(IsNonCardtype(Land)), PlayerAction(Ref_TargetPlayer, RevealHand), PlayerMustCost(Ref_TargetPlayer, DiscardACardOfType(IsNamed(TheChosenName))), Unless(CostWasPaid, [DrawACard])]))",
    "Choose a nonland permanent you don't control, then each other player chooses a nonland permanent they don't control that hasn't been chosen this way. Destroy all other nonland permanents": "ActionList([EachPlayerStartingWithAction(AnyPlayer, You, [ChooseAPermanentThatHasntBeenChosen(And([IsNonCardtype(Land), IsPermanent, ControlledByAPlayer(Other(ActionPlayer))]))]), DestroyEachPermanent(And([ExceptFor(ThePermanentsChosenThisWay), IsNonCardtype(Land), IsPermanent]))])",
    "Choose a number between {{RawDigits}} and {{RawDigits}}. Destroy all creatures with power greater than or equal to the chosen number": "ActionList([ChooseANumberBetween({{RawDigits[0]}}, {{RawDigits[1]}}), DestroyEachPermanent(And([IsCardtype(Creature), PowerIs(GreaterThanOrEqualTo(TheChosenNumber))]))])",
    "Choose a number between {{RawDigits}} and {{RawDigits}}. Each player sacrifices that many {{Permanents}} of their choice": "ActionList([ChooseANumberBetween({{RawDigits[0]}}, {{RawDigits[1]}}), EachPlayerAction(AnyPlayer, SacrificeNumberPermanents(TheChosenNumber, {{Permanents[0]}}))])",
    "Choose a number. Destroy all artifacts and creatures with mana value equal to that number. Then target player reveals their hand and discards all nonland cards with mana value equal to the number": "Targeted([TargetPlayer(AnyPlayer)], ActionList([ChooseANumber, DestroyEachPermanent(And([Or([IsCardtype(Artifact), IsCardtype(Creature)]), ManaValueIs(EqualTo(TheChosenNumber))])), PlayerAction(Ref_TargetPlayer, RevealHandAndDiscardEachCard(And([IsNonCardtype(Land), ManaValueIs(EqualTo(TheChosenNumber))])))]))",
    "Choose a number. Flip a coin that many times or until you lose a flip, whichever comes first. If you win all the flips, draw {{Number}} cards for each flip": "ActionList([ChooseANumber, FlipACoinNumberTimesOrUntilLose(TheChosenNumber), If(NumCoinFlipsLostIs(EqualTo(Integer(0))), [DrawNumberCardsForEach({{Number[0]}}, NumCoinFlipsWon)])])",
    "Choose a permanent type. Return all cards of the chosen type from your graveyard to your hand": "ActionList([ChooseAPermanentType, ReturnEachCardFromGraveyardToHand(IsCardtypeVariable(TheChosenCardtype))])",
    "Choose an artifact card name. Search target opponent's graveyard, hand, and library for any number of cards with the chosen name and exile them. Then that player shuffles": "Targeted([TargetPlayer(Opponent)], ActionList([ChooseACardName(IsCardtype(Artifact)), SearchPlayersLibraryAndGraveyardAndHand(Ref_TargetPlayer, [FindAnyNumberOfCardsOfType(IsNamed(TheChosenName)), ExileFoundCards, Shuffle])]))",
    "Choose an opponent. They look at the top {{Number}} cards of your library and separate them into a face-down pile and a face-up pile. Put one pile into your hand and the other into your graveyard. The Ring tempts you": "ActionList([APlayerAction(Opponent, LookAtTheTopNumberCardsOfPlayersLibrary(You, {{Number[0]}}, [SeparateIntoFaceUpFileAndFaceDownPile, PlayerChoosesPileTopPutIntoHand(You), PutTheRemainingCardsIntoGraveyard])), TemptWithRing])",
    "Choose an opponent. You and that player each create {{Number}} {{PT}} {{CreatureTokens}} with {{Hasable}}.\nChoose an opponent. You gain {{Digits}} life for each {{Eachable}} and that player gains {{Digits}} life for each {{Eachable(ThatPlayer)}}": "ActionList([ChooseAPlayer(Opponent), EachPlayerAction(Or([SinglePlayer(You), SinglePlayer(TheChosenPlayer)]), CreateTokens([NumberTokens({{Number[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}]))])), ChooseAPlayer(Opponent), GainLifeForEach({{Digits[0]}}, {{Eachable[0]}}), PlayerAction(TheChosenPlayer, GainLifeForEach({{Digits[1]}}, {{Eachable(ThatPlayer=ActionPlayer)[0]}}))])",
    "Choose an opponent. You and that player each draw {{Number}} cards.\nChoose an opponent. Untap all nonland permanents you control and all nonland permanents that player controls": "ActionList([ChooseAPlayer(Opponent), EachPlayerAction(Or([SinglePlayer(You), SinglePlayer(TheChosenPlayer)]), DrawNumberCards({{Number[0]}})), ChooseAPlayer(Opponent), UntapEachPermanent(And([IsNonCardtype(Land), Or([ControlledByAPlayer(SinglePlayer(You)), ControlledByAPlayer(SinglePlayer(TheChosenPlayer))])]))])",
    "Choose an opponent. You and that player each sacrifice {{a}} {{Permanent}}. Each player who sacrificed a creature this way draws {{Number}} cards.\nChoose an opponent. Return {{a}} {{SpecificCard}} from your graveyard to the battlefield, then that player returns {{a}} {{SpecificCard}} from their graveyard to the battlefield": "ActionList([ChooseAPlayer(Opponent), EachPlayerAction(Or([SinglePlayer(You), SinglePlayer(TheChosenPlayer)]), SacrificeAPermanent({{Permanent[0]}})), EachPlayerAction(SacrificedAPermanentThisWay(AnyPermanent), DrawACard), ChooseAPlayer(Opponent), ReturnACardFromGraveyardToBattlefield({{SpecificCard[0]}}, [EntersNormally]), PlayerAction(TheChosenPlayer, ReturnACardFromGraveyardToBattlefield({{SpecificCard[0]}}, [EntersNormally]))])",
    "Choose an order for artifacts, creatures, and lands. Each player sacrifices one permanent of their choice of the first type, sacrifices two of their choice of the second type, then sacrifices three of their choice of the third type": "ActionList([ChooseAnOrderForCardTypes([Artifact, Creature, Land]), EachPlayerActions(AnyPlayer, [SacrificeAPermanent(IsTheFirstChosenPermanentFilter), SacrificeNumberPermanents(Integer(2), IsTheSecondChosenPermanentFilter), SacrificeNumberPermanents(Integer(3), IsTheThirdChosenPermanentFilter)])])",
    "Choose any number of creatures target player controls. Choose the same number of creatures another target player controls. Those players exchange control of those creatures": "Targeted([TargetPlayer(AnyPlayer), TargetPlayer(Other(Ref_TargetPlayer1))], ActionList([ChooseUptoNumberPermanents(MinPermanentsControlledByAPlayer(IsCardtype(Creature), Or([SinglePlayer(Ref_TargetPlayer1), SinglePlayer(Ref_TargetPlayer2)])), And([IsCardtype(Creature), ControlledByPlayer(Ref_TargetPlayer1)])), ChooseNumberPermanents(TheNumberOfPermanentsOnTheBattlefield(ThePermanentsChosenThisWay), And([IsCardtype(Creature), ControlledByPlayer(Ref_TargetPlayer2)])), PlayerAction(Ref_TargetPlayer1, ExchangeControlOfEachPermanentWithPlayer(ThePermanentsChosenThisWay, Ref_TargetPlayer2))]))",
    "Choose any number of target creatures with equal toughness. Destroy the chosen creatures": "Targeted([AnyNumberOfTargetGroupPermanents(IsCardtype(Creature), SameToughness)], ActionList([DestroyEachPermanent(Ref_TargetPermanents)]))",
    "Choose any number of target opponents. Create X {{PT}} {{CreatureTokens}}, where X is the number of creatures those opponents control": "Targeted([AnyNumberOfTargetPlayers(Opponent)], ActionList([CreateTokens([NumberTokens(TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), ControlledByAPlayer(Ref_TargetPlayers)])), TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])]))",
    "Choose any number of target players. Investigate X times, where X is the total number of creatures those players control": "Targeted([AnyNumberOfTargetPlayers(AnyPlayer)], ActionList([InvestigateTimes(TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), ControlledByAPlayer(Ref_TargetPlayers)])))]))",
    "Choose any number of target {{Creatures}}. Each of those creatures gains {{Hasable}} until end of turn": "Targeted([AnyNumberOfTargetPermanents({{Creatures[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Choose any number of target {{Creatures}}. For each of them, create a token that's a copy of that creature, except it has {{Hasable}}. Exile those tokens at the beginning of the next end step": "Targeted([AnyNumberOfTargetPermanents({{Creatures[0]}})], ActionList([CreateTokens([TokenCopyOfEachPermanent(Ref_TargetPermanents, TokenCopyEffects([AddAbility([{{Hasable[0]}}])]))]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([ExileEachPermanent(TheCreatedTokens)]))]))",
    "Choose any number of target {{Permanents}}. Double the number of {{CounterType}} counters on each of them": "Targeted([AnyNumberOfTargetPermanents({{Permanents[0]}})], ActionList([DoubleCountersOfTypeOnEachPermanent({{CounterType[0]}}, Ref_TargetPermanents)]))",
    "Choose any number of target {{Permanents}}. Put {{a}} {{CounterType}} counter on each of them": "Targeted([AnyNumberOfTargetPermanents({{Permanents[0]}})], ActionList([PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, Ref_TargetPermanents)]))",
    "Choose artifact or enchantment. Destroy all permanents of the chosen type": "ActionList([ChooseACardtypeFromList([Artifact, Enchantment]), DestroyEachPermanent(And([IsPermanent, IsTheChosenPermanentFilter]))])",
    "Choose artifact, creature, or land. Tap all untapped permanents of the chosen type target player controls, or untap all tapped permanents of that type that player controls": "Targeted([TargetPlayer(AnyPlayer)], ActionList([ChooseACardtypeFromList([Artifact, Creature, Land]), ChooseAnAction([[TapEachPermanent(And([IsUntapped, IsPermanent, IsCardtypeVariable(TheChosenCardtype), ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]))], [UntapEachPermanent(And([IsTapped, IsPermanent, IsCardtypeVariable(TheChosenCardtype), ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]))]])]))",
    "Choose creature or land. Reveal the top {{Number}} cards of your library. Put all cards of the chosen type revealed this way into your hand and the rest into your graveyard": "ActionList([ChooseACardtypeFromList([Creature, Land]), RevealTheTopNumberCardsOfLibrary({{Number[0]}}, [PutEachCardOfTypeIntoHand(IsCardtypeVariable(TheChosenCardtype)), PutTheRemainingCardsIntoGraveyard])])",
    "Choose exactly two creatures you control. You draw X cards and the chosen creatures get {{PTModX}} and gain {{Hasable}} until end of turn, where X is the difference between the chosen creatures' powers": "Targeted([NumberTargetPermanents(Integer(2), And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))], ActionList([CreateValueX(DifferenceBetween(PowerOfPermanent(Ref_TargetPermanents_0), PowerOfPermanent(Ref_TargetPermanents_1))), DrawNumberCards(ValueX), CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AdjustPTX({{PTModX[0]}}, ValueX), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Choose land or nonland. Reveal cards from the top of your library until you reveal a card of the chosen kind. Put that card into your hand and the rest on the bottom of your library in a random order": "ActionList([ChooseLibraryFilter([IsCardtype(Land), IsNonCardtype(Land)]), RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed(TheChosenLibraryFilter, [PutTheCardFoundThisWayIntoHand, PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder])])",
    "Choose left or right. Starting with you and proceeding in the chosen direction, each player chooses a creature controlled by the next player in that direction. Each player gains control of the creature they chose": "ActionList([ChooseLeftOrRight, EachPlayerStartingWithActionInDirection(AnyPlayer, You, TheChosenDirection, [ChooseAPermanent(And([IsCardtype(Creature), ControlledByPlayer(PlayerInTheChosenDirectionOf(ActionPlayer))])), GainControlOfPermanent(ThePermanentChosenByPlayerThisWay(ActionPlayer))])])",
    "Choose odd or even. Destroy each creature with mana value of the chosen quality. Then gain control of all creatures until end of turn. Untap them. They gain {{Hasable}} until end of turn": "ActionList([ChooseEvenOrOdd, DestroyEachPermanent(And([IsCardtype(Creature), ManaValueIs(TheChosenQuality)])), GainControlOfEachPermanentUntil(IsCardtype(Creature), UntilEndOfTurn), UntapEachPermanent(ThePermanentsGainedControlOfThisWay), CreateEachPermanentLayerEffectUntil(ThePermanentsGainedControlOfThisWay, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "Choose odd or even. Exile each creature with mana value of the chosen quality": "ActionList([ChooseEvenOrOdd, ExileEachPermanent(And([IsCardtype(Creature), ManaValueIs(TheChosenQuality)]))])",
    "Choose one. Until end of turn, target {{Creature}} has that base power and toughness, becomes that creature type, and gains that ability.\n* {{PT}} {{Zombie}} with {{Hasable}}.\n* {{PT}} {{Zombie}} with {{Hasable}}.\n* {{PT}} {{Zombie}} with {{Hasable}}": "Modal_ChooseOne([Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [SetPT({{PT[0]}}), AddCreatureType({{Zombie[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])), Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [SetPT({{PT[1]}}), AddCreatureType({{Zombie[1]}}), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)])), Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [SetPT({{PT[2]}}), AddCreatureType({{Zombie[2]}}), AddAbility([{{Hasable[2]}}])], UntilEndOfTurn)]))])",
