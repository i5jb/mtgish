    "tap up to one target creature. If an opponent controls that creature, put {{a}} {{CounterType}} counter on it": "Targeted([TargetPermanent(IsCardtype(Creature))], ActionList([TapPermanent(Ref_TargetPermanent), If(PermanentPassesFilter(Ref_TargetPermanent, ControlledByAPlayer(Opponent)), [PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent)])]))",
    "tap up to one target {{Creature}} and put {{Number}} {{CounterType}} counters on it. If you control that creature, draw {{Number}} cards": "Targeted([UptoOneTargetPermanent({{Creature[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[0]}}, Ref_TargetPermanent), If(PermanentPassesFilter(Ref_TargetPermanent, ControlledByAPlayer(SinglePlayer(You))), [DrawNumberCards({{Number[0]}})])]))",
