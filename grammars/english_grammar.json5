    "Regenerate this creature. When it regenerates this way, put {{a}} {{CounterType}} counter on it": "ActionList([RegeneratePermanent({{~Permanent}}), If(PermanentRegeneratedThisWay, [ReflexiveTrigger(ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{~Permanent}})]))])])",
    "Regenerate {{~Permanent}}": "ActionList([RegeneratePermanent({{~Permanent}})])",
    "Remove {{a}} {{CounterType}} counter from this Aura": "ActionList([RemoveACounterOfTypeFromPermanent({{CounterType[0]}}, {{~Permanent}})])",
    "Remove {{a}} {{CounterType}} counter from this artifact": "ActionList([RemoveACounterOfTypeFromPermanent({{CounterType[0]}}, {{~Permanent}})])",
    "Remove {{a}} {{CounterType}} counter from {{~Permanent}}": "ActionList([RemoveACounterOfTypeFromPermanent({{CounterType[0]}}, {{~Permanent}})])",
    "Restart the game, leaving in exile all {{SpecificCards}} exiled with {{~Permanent}}. Then put those cards onto the battlefield under your control": "ActionList([RestartTheGameLeavingEachExiledCardInExileThenPutThoseCardsOntoTheBattlefield(And([{{SpecificCards[0]}}, WasExiledWithPermanent({{~Permanent}})]), [EntersUnderPlayersControl(You)])])",
    "Return a card exiled with this creature to its owner's hand": "ActionList([ReturnAnExiledCardToOwnersHand(WasExiledWithPermanent({{~Permanent}}))])",
    "Return a card you own exiled with this artifact to your hand": "ActionList([ReturnAnExiledCardToOwnersHand(And([OwnedByAPlayer(SinglePlayer(You)), WasExiledWithPermanent({{~Permanent}})]))])",
    "Return a creature card exiled with {{ThisPermanent}} to the battlefield under your control. Return each other card exiled with {{ThisPermanent}} to its owner's hand": "ActionList([PutAnExiledCardOntoBattlefield(And([IsCardtype(Creature), TheExiledCards]), [EntersUnderPlayersControl(You)]), ReturnEachExiledCardToOwnersHand(TheExiledCards)])",
    "Return all cards exiled with this artifact to the battlefield under your control": "ActionList([PutEachExiledCardOntoTheBattlefield(WasExiledWithPermanent({{~Permanent}}), [EntersUnderPlayersControl(You)])])",
    "Return all cards exiled with this artifact to their owner's hand": "ActionList([ReturnEachExiledCardToOwnersHand(WasExiledWithPermanent({{~Permanent}}))])",
    "Return all cards exiled with {{~Permanent}} to their owner's hand and you lose that much life": "ActionList([ReturnEachExiledCardToOwnersHand(WasExiledWithPermanent({{~Permanent}})), LoseLife(NumCardsReturnedToHandThisWay)])",
    "Return each {{SpecificCard}} exiled with this artifact to the battlefield under your control": "ActionList([PutEachExiledCardOntoTheBattlefield(And([WasExiledWithPermanent({{~Permanent}}), {{SpecificCard[0]}}]), [EntersUnderPlayersControl(You)])])",
    "Return each {{SpecificCard}} exiled with this land to the battlefield under its owner's control": "ActionList([PutEachExiledCardOntoTheBattlefield(And([WasExiledWithPermanent({{~Permanent}}), {{SpecificCard[0]}}]), [EntersUnderOwnersControl])])",
    "Return target {{Permanent}} to its owner's hand. {{~Permanent}} gains {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutPermanentIntoItsOwnersHand(Ref_TargetPermanent), CreatePermanentLayerEffectUntil({{~Permanent}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Return target {{SpecificCard}} from your graveyard to the battlefield attached to {{~Permanent}}": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersAttachedToPermanent({{~Permanent}})])]))",
    "Return this Aura to its owner's hand": "ActionList([PutPermanentIntoItsOwnersHand({{~Permanent}})])",
    "Return this Equipment to its owner's hand": "ActionList([PutPermanentIntoItsOwnersHand({{~Permanent}})])",
    "Return this creature and another target {{Permanent}} to their owners' hands": "Targeted([TargetPermanent(And([Other({{~Permanent}}), {{Permanent[0]}}]))], ActionList([PutEachPermanentIntoItsOwnersHand(Or([SinglePermanent({{~Permanent}}), SinglePermanent(Ref_TargetPermanent)]))]))",
    "Return this creature and target {{Permanent}} to their owner's hand": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutEachPermanentIntoItsOwnersHand(Or([SinglePermanent({{~Permanent}}), SinglePermanent(Ref_TargetPermanent)]))]))",
    "Return this creature to its owner's hand": "ActionList([PutPermanentIntoItsOwnersHand({{~Permanent}})])",
    "Return this creature to its owner's hand and return target {{SpecificCard}} from your graveyard to your hand": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutPermanentIntoItsOwnersHand({{~Permanent}}), PutGraveyardCardIntoHand(Ref_TargetGraveyardCard)]))",
    "Return this enchantment to its owner's hand": "ActionList([PutPermanentIntoItsOwnersHand({{~Permanent}})])",
    "Return this land to its owner's hand": "ActionList([PutPermanentIntoItsOwnersHand({{~Permanent}})])",
    "Return up to X target {{Permanents}} to their owners' hands, where X is {{GameNumber(~Permanent)}}": "Targeted([UptoNumberTargetPermanents({{GameNumber(~Permanent=^~Permanent)[0]}}, {{Permanents[0]}})], ActionList([PutEachPermanentIntoItsOwnersHand(Ref_TargetPermanents)]))",
    "Return {{~Permanent}} and another target {{Permanent}} to their owners' hands": "Targeted([TargetPermanent(And([Other({{~Permanent}}), {{Permanent[0]}}]))], ActionList([PutEachPermanentIntoItsOwnersHand(Or([SinglePermanent({{~Permanent}}), SinglePermanent(Ref_TargetPermanent)]))]))",
    "Return {{~Permanent}} to its owner's hand": "ActionList([PutPermanentIntoItsOwnersHand({{~Permanent}})])",
    "Return {{~Permanent}} to its owner's hand. Target opponent may draw a card": "Targeted([TargetPlayer(Opponent)], ActionList([PutPermanentIntoItsOwnersHand({{~Permanent}}), PlayerMayAction(Ref_TargetPlayer, DrawACard)]))",
    "Reveal any number of {{SpecificCards}} in your hand. This creature deals X damage to any target, where X is the number of cards revealed this way": "Targeted([AnyTarget], ActionList([RevealAnyNumberOfCardsOfTypeFromHand({{SpecificCards[0]}}), PermanentDealsDamage({{~Permanent}}, TheNumberOfCardsInHandRevealedThisWay, Ref_AnyTarget)]))",
    "Reveal cards from the top of your library until you reveal a land card. This artifact deals damage equal to the number of nonland cards revealed this way to any target. If the revealed land card was {{a}} {{Swamp}}, this artifact deals double that damage instead. Put the revealed cards on the bottom of your library in any order": "Targeted([AnyTarget], ActionList([RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed(IsCardtype(Land), [PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder]), IfElse(ACardWasRevealedThisWay(IsLandType({{Swamp[0]}})), [PermanentDealsDamage({{~Permanent}}, Twice(NumLibraryCardsRevealedThisWay(IsNonCardtype(Land))), Ref_AnyTarget)], [PermanentDealsDamage({{~Permanent}}, NumLibraryCardsRevealedThisWay(IsNonCardtype(Land)), Ref_AnyTarget)])]))",
    "Reveal cards from the top of your library until you reveal {{Number}} land cards. Put those land cards onto the battlefield tapped and the rest on the bottom of your library in a random order. Put {{a}} {{CounterType}} counter on this creature": "ActionList([RevealCardsFromTheTopOfLibraryUntilANumberOfCardsOfTypeAreRevealed({{Number[0]}}, IsCardtype(Land), [PutTheCardsFoundThisWayOntoTheBattlefield([EntersTapped]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder]), PutACounterOfTypeOnPermanent({{CounterType[0]}}, ThisPermanent)])",
    "Reveal cards from the top of your library until you reveal {{a}} {{SpecificCard}}. Put that card onto the battlefield and the rest on the bottom of your library in a random order. This creature deals damage to you equal to the number of cards revealed this way": "ActionList([RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed({{SpecificCard[0]}}, [PutTheCardFoundThisWayOntoTheBattlefield([EntersNormally]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder]), PermanentDealsDamage({{~Permanent}}, TheNumberOfLibraryCardsRevealedThisWay, Player(You))])",
    "Reveal cards from the top of your library until you reveal {{a}} {{SpecificCard}}. This creature gets {{PTModX}} until end of turn, where X is that card's mana value. Put the revealed cards on the bottom of your library in any order": "ActionList([RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed({{SpecificCard[0]}}, [PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder]), CreatePermanentLayerEffectUntil({{~Permanent}}, [AdjustPTX({{PTModX[0]}}, ManaValueOfTheCardRevealedThisWay)], UntilEndOfTurn)])",
    "Reveal the top card of your library and put it into your hand. {{~Permanent}} deals damage to himself equal to that card's mana value": "ActionList([RevealTopCardOfLibrary, PutTopOfLibraryInHand, PermanentDealsDamage({{~Permanent}}, ManaValueOfTheCardRevealedThisWay, Permanent({{~Permanent}}))])",
    "Reveal the top card of your library. If it's {{a}} {{SpecificCard}}, this creature gains \"{{QuotedAbility(~Permanent)}}\" until end of turn": "ActionList([RevealTopCardOfLibrary, If(ACardWasRevealedThisWay({{SpecificCard[0]}}), [CreatePermanentLayerEffectUntil({{~Permanent}}, [AddAbility([{{QuotedAbility(~Permanent=^~Permanent)[0]}}])], UntilEndOfTurn)])])",
    "Reveal the top card of your library. If it's {{a}} {{SpecificCard}}, this creature gets {{PTMod}} and gains {{Hasable}} until end of turn": "ActionList([RevealTopCardOfLibrary, If(ACardWasRevealedThisWay({{SpecificCard[0]}}), [CreatePermanentLayerEffectUntil({{~Permanent}}, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])])",
    "Reveal the top card of your library. If it's {{a}} {{SpecificCard}}, untap this creature and it gets {{PTMod}} until end of turn": "ActionList([RevealTopCardOfLibrary, If(ACardWasRevealedThisWay({{SpecificCard[0]}}), [UntapPermanent({{~Permanent}}), CreatePermanentLayerEffectUntil({{~Permanent}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])])",
    "Roll a d10. Return up to X cards from among cards exiled with this artifact to their owners' hands, where X is the result": "ActionList([RollAD10, ReturnUptoNumberCardsFromExileToOwnersHand(TheDiceResult, WasExiledWithPermanent({{~Permanent}}))])",
    "Roll a d20.\n{{RawDigits}}-{{RawDigits}} | Put {{a}} {{CounterType}} counter on this artifact.\n{{RawDigits}}-{{RawDigits}} | Put {{Number}} {{CounterType}} counters on this artifact": "ActionList([RollAD20, ValueActions(TheDiceResult, [ValueAction(BetweenValues({{RawDigits[0]}}, {{RawDigits[1]}}), [PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{~Permanent}})]), ValueAction(BetweenValues({{RawDigits[2]}}, {{RawDigits[3]}}), [PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[1]}}, {{~Permanent}})])])])",
    "Roll a d4 and create a number of Treasure tokens equal to the result. The player to your right gains control of this artifact": "ActionList([RollAD4, CreateTokens([NumberTokens(TheDiceResult, TreasureToken)]), PlayerAction(PlayerToTheRightOf(You), GainControlOfPermanent({{~Permanent}}))])",
    "Roll a d6. Until end of turn, you may have this artifact become {{a}} {{PTX}} {{Zombie}} artifact creature with {{Hasable}}, where X is the result": "ActionList([RollAD6, MayAction(CreatePermanentLayerEffectUntil({{~Permanent}}, [SetPT(PTX({{PTX[0]}}, TheDiceResult)), SetCreatureType({{Zombie[0]}}), SetCardtypes([Artifact, Creature]), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn))])",
    "Roll a six-sided die.\n1 or 2 - {{LoyaltyCost}}, then create {{Number}} {{PT}} {{CreatureTokens}}. They gain {{Hasable}} until end of turn.\n3 - {{LoyaltyCost}}, then return {{a}} {{SpecificCard}} from your graveyard to your hand.\n4 or 5 - {{~Permanent}} deals damage equal to {{GameNumber(ThatPermanent)}} to a creature or player, then {{LoyaltyCost}}.\n6 - {{LoyaltyCost}}, and you may activate {{~Permanent}}'s loyalty ability two more times this turn": "ActionList([RollAD6, ValueActions(TheDiceResult, [ValueAction(BetweenValues(1, 2), [{{LoyaltyCost[0]}}, CreateTokens([NumberTokens({{Number[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))]), CreateEachPermanentLayerEffectUntil(TheCreatedTokens, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]), ValueAction(ExactValue(3), [{{LoyaltyCost[1]}}, PutACardFromGraveyardIntoHand({{SpecificCard[0]}})]), ValueAction(BetweenValues(4, 5), [ChooseADamageRecipient(APlayerOrAPermanent(AnyPlayer, IsCardtype(Creature))), PermanentDealsDamage({{~Permanent}}, {{GameNumber(ThatPermanent=^~Permanent)[0]}}, TheChosenDamageRecipient), {{LoyaltyCost[2]}}]), ValueAction(ExactValue(6), [{{LoyaltyCost[3]}}, CreatePlayerEffectUntil(You, [MayActivateLoyaltyAbilityOfPlanewalkerAnAdditionalNumberTimes({{~Permanent}}, Integer(2))], UntilEndOfTurn)])])])",
    "Sacrifice this artifact": "ActionList([SacrificePermanent({{~Permanent}})])",
    "Sacrifice this artifact. If you do, discard your hand, then put all cards exiled with this artifact into their owner's hand": "ActionList([MustCost(SacrificePermanent({{~Permanent}})), If(CostWasPaid, [DiscardHand, ReturnEachExiledCardToOwnersHand(WasExiledWithPermanent({{~Permanent}}))])])",
    "Sacrifice this artifact. You gain {{Digits}} life": "ActionList([SacrificePermanent({{~Permanent}}), GainLife({{Digits[0]}})])",
    "Sacrifice this enchantment": "ActionList([SacrificePermanent({{~Permanent}})])",
    "Sacrifice this enchantment. If you do, scry {{Digits}}": "ActionList([MustCost(SacrificePermanent({{~Permanent}})), If(CostWasPaid, [Scry({{Digits[0]}})])])",
    "Sacrifice {{a}} {{Creature}}. When you do, {{~Permanent}} deals X damage to any target, where X is that creature's power. If the sacrificed creature was {{a}} {{Zombie}}, draw X cards": "ActionList([MustCost(SacrificeAPermanent({{Creature[0]}})), If(CostWasPaid, [ReflexiveTrigger(Targeted([AnyTarget], ActionList([PermanentDealsDamage({{~Permanent}}, PowerOfTheSacrificedCreature, Ref_AnyTarget), If(APermanentWasSacrificedThisWay(IsCreatureType({{Zombie[0]}})), [DrawNumberCards(PowerOfTheSacrificedCreature)])])))])])",
    "Scry {{Digits}}, then reveal the top card of your library. This creature gets {{PTModX}} until end of turn, where X is that card's mana value": "ActionList([Scry({{Digits[0]}}), RevealTopCardOfLibrary, CreatePermanentLayerEffectUntil({{~Permanent}}, [AdjustPTX({{PTModX[0]}}, ManaValueOfTheCardRevealedThisWay)], UntilEndOfTurn)])",
    "Scry {{Digits}}. Put {{a}} {{CounterType}} counter on this artifact. Then if there are {{Number}} or more {{CounterType}} counters on it, remove those counters, transform this artifact, and create {{Number}} Treasure tokens": "ActionList([Scry({{Digits[0]}}), PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{~Permanent}}), If(PermanentPassesFilter({{~Permanent}}, HasNumCountersOfType(GreaterThanOrEqualTo({{Number[0]}}), {{CounterType[1]}})), [RemoveAllCountersOfTypeFromPermanent({{CounterType[1]}}, {{~Permanent}}), TransformPermanent({{~Permanent}}), CreateTokens([NumberTokens({{Number[1]}}, TreasureToken)])])])",
    "Scry {{Digits}}. This land deals {{Digits}} damage to each {{Creature}}": "ActionList([Scry({{Digits[0]}}), PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, EachPermanent({{Creature[0]}}))])",
    "Scry {{Digits}}. {{~Permanent}} deals {{Digits}} damage to each opponent": "ActionList([Scry({{Digits[0]}}), PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, EachPlayer(Opponent))])",
    "Search your library for a card, put it into your graveyard, then shuffle. If it's {{a}} {{SpecificCard}}, put {{a}} {{CounterType}} counter on this creature": "ActionList([SearchLibrary([FindAGenericCard, PutFoundCardsIntoGraveyard, Shuffle]), If(ACardWasPutIntoGraveyardThisWay({{SpecificCard[0]}}), [PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{~Permanent}})])])",
    "Search your library for a card, put it into your hand, then shuffle. An opponent gains control of this artifact": "ActionList([SearchLibrary([FindAGenericCard, PutFoundCardsIntoHand, Shuffle]), APlayerGainsControlOfPermanent(Opponent, {{~Permanent}})])",
    "Search your library for a creature card with mana value equal to {{GameNumber(~Permanent)}}, put it onto the battlefield, then shuffle": "ActionList([SearchLibrary([FindACardOfType(And([IsCardtype(Creature), ManaValueIs(EqualTo({{GameNumber(~Permanent=^~Permanent)[0]}}))])), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle])])",
    "Search your library for a creature card with mana value equal to {{GameNumber(~Permanent)}}, reveal it, and put it into your hand. If that card is legendary, create a Treasure token. Then shuffle": "ActionList([SearchLibrary([FindACardOfType(And([IsCardtype(Creature), ManaValueIs(EqualTo({{GameNumber(~Permanent=^~Permanent)[0]}}))])), RevealFoundCards, PutFoundCardsIntoHand, If(ACardOfTypeWasFoundThisWay(IsSupertype(Legendary)), [CreateTokens([TreasureToken])]), Shuffle])])",
    "Search your library for a legendary permanent card with mana value less than {{GameNumber(~Permanent)}}, put that card onto the battlefield, then shuffle": "ActionList([SearchLibrary([FindACardOfType(And([IsSupertype(Legendary), IsPermanent, ManaValueIs(LessThan({{GameNumber(~Permanent=^~Permanent)[0]}}))])), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}} and put it into your graveyard. If you do, {{~Permanent}} becomes a copy of that card until end of turn. Then shuffle":
      "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsIntoGraveyard, If(ACardWasFoundThisWay, [CreatePermanentLayerEffectUntil({{~Permanent}}, [IsACopyOfThatCard(NoCopyEffects)], UntilEndOfTurn)]), Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}}, put it onto the battlefield tapped, then shuffle. The player to your right gains control of this artifact": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersTapped]), Shuffle]), PlayerAction(PlayerToTheRightOf(You), GainControlOfPermanent({{~Permanent}}))])",
    "Search your library for {{a}} {{SpecificCard}}, put that card onto the battlefield tapped, then shuffle. Return this land to its owner's hand at the beginning of the next cleanup step": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersTapped]), Shuffle]), CreateFutureTrigger(AtTheBeginningOfTheNextCleanupStep, ActionList([PutPermanentIntoItsOwnersHand({{~Permanent}})]))])",
    "Seek a card with the highest mana value among cards in your library with mana value X or less, where X is {{GameNumber(~Permanent)}}": "ActionList([SeekACard(ManaValueIs(EqualTo(TheHighestManaValueAmongCardsInPlayersLibrary(ManaValueIs(LessThanOrEqualTo({{GameNumber(~Permanent=^~Permanent)[0]}})), You))))])",
    "Shuffle this creature and target {{Permanent}} into their owners' libraries": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([ShuffleEachPermanentIntoLibrary(Or([SinglePermanent({{~Permanent}}), SinglePermanent(Ref_TargetPermanent)]))]))",
    "Surveil {{Digits}}, then untap this creature": "ActionList([Surveil({{Digits[0]}}), UntapPermanent(ThisPermanent)])",
    "Surveil {{Digits}}. Create a token that's a copy of {{ThisPermanent}}, then sacrifice {{a}} {{Permanent}}": "ActionList([Surveil({{Digits[0]}}), CreateTokens([TokenCopyOfPermanent(ThisPermanent, NoTokenCopyEffects)]), SacrificeAPermanent({{Permanent[0]}})])",
    "Switch this creature's power and toughness until end of turn": "ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [SwitchPT], UntilEndOfTurn)])",
    "Tap all other {{Permanents}}. They don't untap during their controllers' untap steps for as long as this artifact remains tapped": "ActionList([TapEachPermanent(And([Other({{~Permanent}}), {{Permanents[0]}}])), CreateEachPermanentRuleEffectUntil(ThePermanentsTappedThisWay, [DoesntUntapDuringControllersUntap], ForAsLongAsPermanentRemainsTapped({{~Permanent}}))])",
    "Tap all {{Permanents}}. This artifact becomes {{a}} {{PT}} {{Zombie}} artifact creature until end of turn": "ActionList([TapEachPermanent({{Permanents[0]}}), CreatePermanentLayerEffectUntil({{~Permanent}}, [SetPT({{PT[0]}}), SetCreatureType({{Zombie[0]}}), SetCardtypes([Artifact, Creature])], UntilEndOfTurn)])",
    "Tap another target {{Creature}} and put {{a}} {{CounterType}} counter on it. This creature becomes a copy of that creature for as long as that creature remains tapped": "Targeted([TargetPermanent(And([Other({{~Permanent}}), {{Creature[0]}}]))], ActionList([TapPermanent(Ref_TargetPermanent), PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent), CreatePermanentLayerEffectUntil({{~Permanent}}, [IsACopyOfPermanent(Ref_TargetPermanent, NoCopyEffects)], ForAsLongAsPermanentRemainsTapped(Ref_TargetPermanent))]))",
    "Tap target creature. This creature deals damage equal to its power to that creature": "Targeted([TargetPermanent(IsCardtype(Creature))], ActionList([TapPermanent(Ref_TargetPermanent), PermanentDealsDamage(ThisPermanent, PowerOfPermanent(ThisPermanent), Permanent(Ref_TargetPermanent))]))",
    "Tap target {{Creature(~Permanent)}}. That creature doesn't untap during its controller's untap step for as long as this creature remains tapped": "Targeted([TargetPermanent({{Creature(~Permanent=^~Permanent)[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), CreatePermanentRuleEffectUntil(ThePermanentTappedThisWay, [DoesntUntapDuringControllersUntap], ForAsLongAsPermanentRemainsTapped({{~Permanent}}))]))",
    "Tap target {{Creature}}. That creature doesn't untap during its controller's untap step for as long as this creature remains tapped": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), CreatePermanentRuleEffectUntil(ThePermanentTappedThisWay, [DoesntUntapDuringControllersUntap], ForAsLongAsPermanentRemainsTapped({{~Permanent}}))]))",
    "Tap target {{Permanent(~Permanent)}}": "Targeted([TargetPermanent({{Permanent(~Permanent=^~Permanent)[0]}})], ActionList([TapPermanent(Ref_TargetPermanent)]))",
