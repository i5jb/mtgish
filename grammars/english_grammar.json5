    "create a tapped Powerstone token": "ActionList([CreateTokensWithFlags([PowerstoneToken], [EntersTapped])])",
    "create a tapped Treasure token": "ActionList([CreateTokensWithFlags([TreasureToken], [EntersTapped])])",
    "create a tapped Vibranium token": "ActionList([CreateTokensWithFlags([VibraniumToken], [EntersTapped])])",
    "create a tapped and attacking token that's a copy of target {{Permanent}}. Sacrifice the token at the beginning of the next end step": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreateTokens([TokenCopyOfPermanent(Ref_TargetPermanent, NoTokenCopyEffects)]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([SacrificeEachPermanent(TheTokensCreatedThisWay)]))]))",
    "create a tapped and attacking {{PT}} {{CreatureToken}} with \"{{TokenQuotedAbility}}\"": "ActionList([CreateTokensWithFlags([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{TokenQuotedAbility[0]}}])], [EntersTapped, EntersAttacking])])",
    "create a tapped colorless artifact token named {{NamedCard}} with \"{{TokenQuotedAbility}}\" and \"{{TokenQuotedAbility}}\"": "ActionList([CreateTokensWithFlags([NamedToken({{NamedCard[0]}}, Colorless, [], [Artifact], SubtypesList([]), [{{TokenQuotedAbility[0]}}, {{TokenQuotedAbility[1]}}])], [EntersTapped])])",
    "create a tapped colorless land token named {{NamedCard}} that is every basic land type": "ActionList([CreateTokensWithFlags([NamedToken({{NamedCard[0]}}, Colorless, [], [Land], AllBasicLandTypes, [])], [EntersTapped])])",
    "create a tapped {{PT}} {{CreatureToken}}": "ActionList([CreateTokensWithFlags([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])], [EntersTapped])])",
    "create a tapped {{PT}} {{CreatureToken}} for each {{Eachable}}": "ActionList([CreateTokensWithFlags([NumberTokens({{Eachable[0]}}, TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, []))], [EntersTapped])])",
    "create a tapped {{PT}} {{CreatureToken}} with {{Hasable}} if {{Condition}}. Otherwise, mill {{Number}} cards":
      "ActionList([IfElse({{Condition[0]}}, [CreateTokensWithFlags([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])], [EntersTapped])], [MillNumberCards({{Number[0]}})])])",
    "create a tapped {{PT}} {{CreatureToken}} with {{Hasable}}": "ActionList([CreateTokensWithFlags([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])], [EntersTapped])])",
    "create a tapped {{PT}} {{CreatureToken}}. If {{Condition}}, create {{Number}} of those tokens instead": "ActionList([IfElse({{Condition[0]}}, [CreateTokensWithFlags([NumberTokens({{Number[0]}}, TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, []))], [EntersTapped])], [CreateTokensWithFlags([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])], [EntersTapped])])])",
    "create a token that's a copy of target token you control. If that token is {{a}} {{Zombie}}, instead create {{Number}} tokens that are copies of it": "Targeted([TargetPermanent(And([IsToken, ControlledByAPlayer(SinglePlayer(You))]))], ActionList([IfElse(PermanentPassesFilter(Ref_TargetPermanent, IsCreatureType({{Zombie[0]}})), [CreateTokens([NumberTokens({{Number[0]}}, TokenCopyOfPermanent(Ref_TargetPermanent, NoTokenCopyEffects))])], [CreateTokens([TokenCopyOfPermanent(Ref_TargetPermanent, NoTokenCopyEffects)])])]))",
    "create a token that's a copy of target {{Artifact}}, except its name is {{NamedCard}} and it's {{a}} {{PT}} {{Zombie}} artifact creature in addition to its other types. It gains {{Hasable}} until end of turn. Sacrifice it at the beginning of the next end step": "Targeted([TargetPermanent({{Artifact[0]}})], ActionList([CreateTokens([TokenCopyOfPermanent(Ref_TargetPermanent, TokenCopyEffects([SetName({{NamedCard[0]}}), SetPT({{PT[0]}}), AddCreatureTypes([{{Zombie[0]}}]), AddCardtypes([Artifact, Creature])]))]), CreatePermanentLayerEffectUntil(TheCreatedToken, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([SacrificeEachPermanent(TheTokensCreatedThisWay)]))]))",
    "create a token that's a copy of target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreateTokens([TokenCopyOfPermanent(Ref_TargetPermanent, NoTokenCopyEffects)])]))",
    "create a token that's a copy of target {{Permanent}}, except it's {{a}} {{Zombie}} in addition to its other creature types": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreateTokens([TokenCopyOfPermanent(Ref_TargetPermanent, TokenCopyEffects([AddCreatureTypes([{{Zombie[0]}}])]))])]))",
    "create a token that's a copy of your commander, except it's not legendary": "ActionList([CreateTokens([TokenCopyOfCommander(TokenCopyEffects([RemoveSupertypes([Legendary])]))])])",
    "create your choice of a Clue token, a Food token, or a Treasure token": "ActionList([ChooseAnAction([[CreateTokens([ClueToken])], [CreateTokens([FoodToken])], [CreateTokens([TreasureToken])]])])",
    "create {{NamedCard}}, a legendary colorless Book artifact token with {{Hasable}} and \"{{TokenQuotedAbility}}\"": "ActionList([CreateTokens([NamedToken({{NamedCard[0]}}, Colorless, [Legendary], [Artifact], SubtypesList([Book]), [{{Hasable[0]}}, {{TokenQuotedAbility[0]}}])])])",
    "create {{NamedCard}}, a legendary colorless Equipment artifact token with \"{{TokenQuotedAbility}}\" and equip {{ManaCost}}": "ActionList([CreateTokens([NamedToken({{NamedCard[0]}}, Colorless, [Legendary], [Artifact], SubtypesList([Equipment]), [{{TokenQuotedAbility[0]}}, Equip(IsCardtype(Creature), PayMana({{ManaCost[0]}}))])])])",
    "create {{NamedCard}}, a legendary {{Black}} Equipment artifact token with \"{{TokenQuotedAbility}}\", \"{{TokenQuotedAbility}}\", and {{Hasable}}": "ActionList([CreateTokens([NamedToken({{NamedCard[0]}}, Colors([{{Black[0]}}]), [Legendary], [Artifact], SubtypesList([Equipment]), [{{TokenQuotedAbility[0]}}, {{TokenQuotedAbility[1]}}, {{Hasable[0]}}])])])",
    "create {{NamedCard}}, a legendary {{Black}} {{Zombie}} creature token with \"{{TokenQuotedCDA_PT_0_0}}\"": "ActionList([CreateTokens([NamedTokenWithPT({{NamedCard[0]}}, PT(0, 0), Colors([{{Black[0]}}]), [Legendary], [Creature], SubtypesList([{{Zombie[0]}}]), [{{TokenQuotedCDA_PT_0_0[0]}}])])])",
    "create {{NamedCard}}, a legendary {{PT}} colorless Vehicle artifact token with {{Hasable}} and {{Hasable}}": "ActionList([CreateTokens([NamedTokenWithPT({{NamedCard[0]}}, {{PT[0]}}, Colorless, [Legendary], [Artifact], SubtypesList([Vehicle]), [{{Hasable[0]}}, {{Hasable[1]}}])])])",
    "create {{NamedCard}}, a legendary {{PT}} colorless {{Zombie}} {{Zombie}} artifact creature token": "ActionList([CreateTokens([NamedTokenWithPT({{NamedCard[0]}}, {{PT[0]}}, Colorless, [Legendary], [Artifact, Creature], SubtypesList([{{Zombie[0]}}, {{Zombie[1]}}]), [])])])",
    "create {{NamedCard}}, a legendary {{PT}} {{Black}} {{Zombie}} {{Zombie}} creature token with {{Hasable}} and \"{{TokenQuotedAbility}}\"": "ActionList([CreateTokens([NamedTokenWithPT({{NamedCard[0]}}, {{PT[0]}}, Colors([{{Black[0]}}]), [Legendary], [Creature], SubtypesList([{{Zombie[0]}}, {{Zombie[1]}}]), [{{Hasable[0]}}, {{TokenQuotedAbility[0]}}])])])",
