    "target opponent creates {{a}} {{PT}} {{CreatureToken}} and you draw a card": "Targeted([TargetPlayer(Opponent)], ActionList([PlayerAction(Ref_TargetPlayer, CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])), DrawACard]))",
