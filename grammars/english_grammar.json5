    "instant, sorcery, or {{Zombie}} card": "Or([IsCardtype(Instant), IsCardtype(Sorcery), IsCreatureType({{Zombie[0]}})])",
    "land or double-faced card": "Or([IsCardtype(Land), IsDoubleFaced])",
    "land or legendary {{Zombie}} card": "Or([IsCardtype(Land), And([IsSupertype(Legendary), IsCreatureType({{Zombie[0]}})])])",
    "legendary card": "IsSupertype(Legendary)",
