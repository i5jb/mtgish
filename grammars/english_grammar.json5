    "target {{Permanent}} perpetually gets {{PTMod}}. Then choose {{a}} {{SpecificCard}} in your hand. It perpetually gets {{PTMod}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePerpetualPermanentEffect(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})]), ChooseACardInHand({{SpecificCard[0]}}), CreatePerpetualCardInHandEffect(TheCardInHandChosenThisWay, [AdjustPT({{PTMod[0]}})])]))",
    "target {{Permanent}} phases out": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PhaseOutPermanent(Ref_TargetPermanent)]))",
    "target {{Permanent}}'s owner puts it into their library {{Nth}} from the top or on the bottom": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PlayerChooseAnAction(OwnerOfPermanent(Ref_TargetPermanent), [PutPermanentInOwnersLibraryNthFromTheTop(Ref_TargetPermanent, {{Nth[0]}}), PutPermanentOnBottomOfOwnersLibrary(Ref_TargetPermanent)])]))",
    "target {{Permanent}}'s owner puts it on their choice of the top or bottom of their library": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PlayerAction(OwnerOfPermanent(Ref_TargetPermanent), ReturnPermanentToTopOrBottomOfLibrary(Ref_TargetPermanent))]))",
    "target {{SpecificCard}} in your graveyard gains flashback until end of turn. The flashback cost is equal to its mana cost": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([CreateGraveyardCardEffectUntil(Ref_TargetGraveyardCard, [AddAbility([Flashback(ItsManaCost)])], UntilEndOfTurn)]))",
    "target {{SpecificCard}} in your graveyard gains flashback until end of turn. The flashback cost is equal to that card's mana cost": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([CreateGraveyardCardEffectUntil(Ref_TargetGraveyardCard, [AddAbility([Flashback(ItsManaCost)])], UntilEndOfTurn)]))",
    "target {{SpecificCard}} in your graveyard gains harmonize until end of turn. Its harmonize cost is equal to its mana cost": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([CreateGraveyardCardEffectUntil(Ref_TargetGraveyardCard, [AddAbility([Harmonize(ItsManaCost)])], UntilEndOfTurn)]))",
    "the Ring tempts you": "ActionList([TemptWithRing])",
    "the active player adds {{ManaProduceSymbol}}{{ManaProduceSymbol}} for each {{Eachable}}": "ActionList([PlayerAction(TheActivePlayer, AddManaRepeated(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}]), {{Eachable[0]}}))])",
    "the exiled card's owner creates {{a}} {{PTX}} {{CreatureToken}}, where X is the mana value of the exiled card": "ActionList([EachPlayerAction(OwnersOfExiledCards(TheExiledCards), CreateTokens([TokenWithPT(PTX({{PTX[0]}}, TotalManaValueOfExiledCards(TheExiledCards)), {{CreatureToken[0]}}, [])]))])",
    "the exiled card's owner manifests dread": "ActionList([PlayerAction(OwnerOfExiledCard(TheExiledCard), ManifestDread)])",
    "the exiled card's owner may cast that card without paying its mana cost": "ActionList([EachPlayerMayAction(OwnersOfExiledCards(TheExiledCards), CastSpellsFromExileWithoutPaying(AnySpell, And([TheExiledCards, OwnedByAPlayer(SinglePlayer(EachablePlayer))])))])",
    "the exiled card's owner seeks a card that shares a card type with the exiled card": "ActionList([PlayerAction(OwnerOfExiledCard(TheExiledCard), SeekACard(SharesACardtypeWithExiledCard(TheExiledCard)))])",
    "the exiled card's owner seeks {{a}} {{SpecificCard}} with lesser mana value than the exiled card": "ActionList([PlayerAction(OwnerOfExiledCard(TheExiledCard), SeekACard(And([{{SpecificCard[0]}}, ManaValueIs(LessThan(ManaValueOfExiled(TheExiledCard)))])))])",
    "the game is a draw": "ActionList([DrawTheGame])",
    "the next instant spell and the next sorcery spell you cast this turn each have cascade": "ActionList([CreateFutureSpellEffect(TheNextSpellPlayerCastsThisTurn(IsCardtype(Instant), You), [Cascade]), CreateFutureSpellEffect(TheNextSpellPlayerCastsThisTurn(IsCardtype(Sorcery), You), [Cascade])])",
    "the next noncreature spell you cast this turn has affinity for artifacts": "ActionList([CreateFutureSpellEffect(TheNextSpellPlayerCastsThisTurn(IsNonCardtype(Creature), You), [Affinity(IsCardtype(Artifact))])])",
    "the next spell you cast this turn costs {{CostReduce}} less to cast": "ActionList([CreateFutureSpellEffect(TheNextSpellPlayerCastsThisTurn(AnySpell, You), [DecreaseManaCost({{CostReduce[0]}})])])",
    "the next spell you cast this turn has cascade and you may planeswalk": "ActionList([CreateFutureSpellEffect(TheNextSpellPlayerCastsThisTurn(AnySpell, You), [Cascade]), MayAction(Planeswalk)])",
    "the next time target {{Creature}} would deal combat damage to one or more players this combat, prevent that damage. If damage is prevented this way, create that many {{PT}} {{CreatureTokens}} with {{Hasable}} and \"{{TokenQuotedAbility}}\"": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreateFuturePreventDamage(NextTimeCombatDamageWouldBeDealtThisTurnByCreatureToAnyNumberOfRecipients(Ref_TargetPermanent, APlayer(AnyPlayer)), [PreventThatDamage, If(DamageWasPreventedThisWay, [CreateTokens([NumberTokens(TheAmountOfDamagePreventedThisWay, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}, {{TokenQuotedAbility[0]}}]))])])])]))",
    "the next time you would set a scheme in motion, set {{Number}} schemes in motion instead": "ActionList([CreateFutureReplaceWouldSetASchemeInMotion(NextTimePlayerWouldSetASchemeInMotion(You), [WouldSetASchemeInMotion_SetNumberSchemesInMotionInstead({{Number[0]}})])])",
    "the next {{Spell}} you cast costs {{CostReduce}} less to cast": "ActionList([CreateFutureSpellEffect(TheNextSpellPlayerCasts({{Spell[0]}}, You), [DecreaseManaCost({{CostReduce[0]}})])])",
    "the next {{Spell}} you cast this turn has convoke": "ActionList([CreateFutureSpellEffect(TheNextSpellPlayerCastsThisTurn({{Spell[0]}}, You), [Convoke])])",
    "the next {{Spell}} you cast this turn has storm": "ActionList([CreateFutureSpellEffect(TheNextSpellPlayerCastsThisTurn({{Spell[0]}}, You), [Storm])])",
    "the topmost creature card in your library perpetually gets {{PTMod}}": "ActionList([CreatePerpetualCardInLibraryEffect(TheTopCardOfTypeInPlayersLibrary(IsCardtype(Creature), You), [AdjustPT({{PTMod[0]}})])])",
    "the topmost land card in your library perpetually gains \"{{PerpetualQuotedAbility}}\"": "ActionList([CreatePerpetualCardInLibraryEffect(TheTopCardOfTypeInPlayersLibrary(IsCardtype(Land), You), [AddAbility([{{PerpetualQuotedAbility[0]}}])])])",
    "there is an additional beginning phase after this phase": "ActionList([ThereIsAnAdditionalBeginningPhase])",
    "there is an additional combat phase after this phase followed by an additional main phase. When you next attack this turn, untap each {{Permanent}}": "ActionList([ThereIsAnAdditionalCombatPhaseAndAnAdditionalMainPhase, CreateFutureTrigger(WhenAPlayerNextAttacksThisTurn(SinglePlayer(You)), ActionList([UntapEachPermanent({{Permanent[0]}})]))])",
    "there's an additional combat phase after this phase. At the beginning of that combat, untap all {{Permanents}}": "ActionList([ThereIsAnAdditionalCombatPhaseWithTrigger(ActionList([UntapEachPermanent({{Permanents[0]}})]))])",
    "time travel": "ActionList([TimeTravel])",
    "transform up to one target {{Permanent}}": "Targeted([UptoOneTargetPermanent({{Permanent[0]}})], ActionList([TransformPermanent(Ref_TargetPermanent)]))",
    "turn any number of target {{Creatures}} face down. They're {{PT}} {{Zombie}} creatures": "Targeted([AnyNumberOfTargetPermanents({{Creatures[0]}})], ActionList([TurnEachPermanentFaceDownAsCreature(Ref_TargetPermanents, {{PT[0]}}, {{Zombie[0]}})]))",
    "turn target {{Creature}} face down. It becomes {{a}} {{PT}} {{Zombie}} artifact creature": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([TurnPermanentFaceDownAsArtifactCreature(Ref_TargetPermanent, {{PT[0]}}, {{Zombie[0]}})]))",
    "turn the exiled card face up. If it's {{a}} {{SpecificCard}}, put it onto the battlefield under your control": "ActionList([TurnExiledCardFaceUp(TheExiledCard), If(ExiledCardPassesFilter(TheExiledCard, {{SpecificCard[0]}}), [PutExiledCardOntoBattlefield(TheExiledCard, [EntersUnderPlayersControl(You)])])])",
    "two target players each reveal the top card of their library. They each lose life equal to the mana value of the card revealed by the other player. Then they each put the card they revealed into their hand": "Targeted([NumberTargetPlayers(Integer(2), AnyPlayer)], ActionList([EachPlayerAction(Ref_TargetPlayers, RevealTopCardOfLibrary), EachPlayerAction(Ref_TargetPlayers, LoseLife(ManaValueOfTheCardsRevealedByPlayersThisWay(Other(EachablePlayer)))), EachPlayerAction(Ref_TargetPlayers, PutTopOfLibraryInHand)]))",
    "unlock a locked door of up to one target Room you control": "Targeted([TargetPermanent(And([IsEnchantmentType(Room), ControlledByAPlayer(SinglePlayer(You))]))], ActionList([UnlockADoorOfPermanent(Ref_TargetPermanent)]))",
    "untap all {{Permanents}}": "ActionList([UntapEachPermanent({{Permanents[0]}})])",
    "untap all {{Permanents}}. After this combat phase, there is an additional combat phase": "ActionList([UntapEachPermanent({{Permanents[0]}}), ThereIsAnAdditionalCombatPhase])",
    "untap all {{Permanents}}. After this phase, there is an additional combat phase": "ActionList([UntapEachPermanent({{Permanents[0]}}), ThereIsAnAdditionalCombatPhase])",
    "untap all {{Permanents}}. After this phase, there is an additional combat phase. Only {{Permanents}} can attack during that combat phase": "ActionList([UntapEachPermanent({{Permanents[0]}}), ThereIsAnAdditionalCombatPhase, OnlyAllowedAttackersDuringTheAdditionalCombatStepAddedThisWay({{Permanents[1]}})])",
    "untap all {{Permanents}}. If it's a main phase, there is an additional combat phase after this phase, followed by an additional main phase": "ActionList([UntapEachPermanent({{Permanents[0]}}), If(IsDuringAMainPhase, [ThereIsAnAdditionalCombatPhaseAndAnAdditionalMainPhase])])",
    "untap all {{Permanents}}. If it's the first combat phase of your turn, there is an additional combat phase after this phase": "ActionList([UntapEachPermanent({{Permanents[0]}}), If(IsFirstCombatPhaseOfTurn, [ThereIsAnAdditionalCombatPhase])])",
