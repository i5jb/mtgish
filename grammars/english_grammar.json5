    "Whenever {{a}} {{Permanent}} explores {{a}} {{SpecificCard}}, {{TriggerActions(~Permanent)}}": "TriggerA(WhenAPermanentExploresACardOfType({{Permanent[0]}}, {{SpecificCard[0]}}), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
