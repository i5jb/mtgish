    "Discard a card at random. If you do, {{~Spell}} deals damage equal to that card's mana value to each creature. You may repeat this process any number of times": "ActionList([RepeatableActions([MayCost(DiscardACardAtRandom), If(CostWasPaid, [SpellDealsDamage({{~Spell}}, ManaValueOfTheDiscardedCard, EachPermanent(IsCardtype(Creature))), MayAction(RepeatThisProcess)])])])",
    "Discard a card, then draw a card. When you discard {{a}} {{SpecificCard}} this way, {{~Spell}} deals damage equal to that card's mana value to target {{CreatureOrPlaneswalker}}": "ActionList([DiscardACard, DrawACard, If(ACardWasDiscardedThisWay({{SpecificCard[0]}}), [ReflexiveTrigger(Targeted([TargetPermanent({{CreatureOrPlaneswalker[0]}})], ActionList([SpellDealsDamage({{~Spell}}, ManaValueOfTheDiscardedCard, Permanent(Ref_TargetPermanent))])))])])",
    "Discard your hand, then draw {{Number}} cards. {{~Spell}} deals {{Digits}} damage to each opponent. Exile {{~Spell}}": "ActionList([DiscardHand, DrawNumberCards({{Number[0]}}), SpellDealsDamage({{~Spell}}, {{Digits[0]}}, EachPlayer(Opponent)), ExileSpell({{~Spell}})])",
    "Double target player's life total. Shuffle {{~Spell}} into its owner's library": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, SetLifeTotal(Twice(LifeTotalOfPlayer(ActionPlayer)))), ShuffleSpellIntoLibrary({{~Spell}})]))",
    "Draw X cards, where X is the greatest power among creatures you controlled as you cast this spell. If this spell was cast from exile, you gain twice X life": "ActionList([CreateValueX(TheGreatestPowerAmongPermanentsAsSpellWasCast(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))), DrawNumberCards(ValueX), If(SpellPassesFilter(ThisSpell, WasCastFromExile), [GainLife(Twice(ValueX))])])",
    "Draw a card, then each other player may draw a card. Whenever a card is drawn this way, {{~Spell}} deals {{Digits}} damage to target opponent chosen at random from among your opponents": "ActionList([DrawACard, EachPlayerMayAction(Other(You), DrawACard), ReflexiveTriggerNumberTimes(NumberOfCardsDrawnThisWay, Targeted([TargetPlayerAtRandom(Opponent)], ActionList([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Player(Ref_TargetPlayer))])))])",
    "Draw a card, then you may discard a card. When you discard {{a}} {{SpecificCard}} this way, {{~Spell}} deals {{Digits}} damage to target {{Creature}}": "ActionList([DrawACard, MayCost(DiscardACard), If(CostWasPaid, [If(ACardWasDiscardedThisWay({{SpecificCard[0]}}), [ReflexiveTrigger(Targeted([TargetPermanent({{Creature[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent))])))])])])",
    "Draw a card.\nCipher": "ActionList([DrawACard, Cipher(ThisSpell)])",
    "Draw a card. Clash with an opponent. If you win, return {{~Spell}} to its owner's hand": "ActionList([DrawACard, Clash(Opponent, [ReturnSpellToOwnersHand({{~Spell}})], [DoNothing])])",
    "Draw a card. If {{~Spell}}'s intensity is {{Digits}}, instead take an extra turn after this one.\nCards you own named {{NamedCard}} intensify by {{Digits}}": "ActionList([IfElse(SpellPassesFilter({{~Spell}}, IntensityIs(EqualTo({{Digits[0]}}))), [TakeAnExtraTurn], [DrawACard]), PerpetuallyIncreaseIntensityOfCardsOwnedByPlayer(IsNamed(NamedCard({{NamedCard[0]}})), You, {{Digits[1]}})])",
    "Draw a card. {{~Spell}} deals damage to any target equal to {{GameNumber}}": "Targeted([AnyTarget], ActionList([DrawACard, SpellDealsDamage({{~Spell}}, {{GameNumber[0]}}, Ref_AnyTarget)]))",
    "Draw {{Number}} cards, then discard a card. Then if {{Condition}}, return {{~Spell}} to its owner's hand": "ActionList([DrawNumberCards({{Number[0]}}), DiscardACard, If({{Condition[0]}}, [ReturnSpellToOwnersHand({{~Spell}})])])",
    "Draw {{Number}} cards. Exile {{~Spell}} with {{Number}} {{CounterType}} counters on it": "ActionList([DrawNumberCards({{Number[0]}}), ExileSpellWithANumberOfCountersOnIt({{~Spell}}, {{Number[0]}}, {{CounterType[0]}})])",
    "Draw {{Number}} cards. Then you may discard {{Number}} cards. When you do, {{~Spell}} deals X damage to each {{Creature}}, where X is the greatest mana value among cards discarded this way": "ActionList([DrawNumberCards({{Number[0]}}), MayCost(DiscardNumberCards({{Number[1]}})), If(CostWasPaid, [ReflexiveTrigger(ActionList([SpellDealsDamage({{~Spell}}, TheGreatestManaValueAmongTheCardsDiscardedThisWay, EachPermanent({{Creature[0]}}))]))])])",
    "Draw {{Number}} cards. Then you may discard {{a}} {{SpecificCard}}. When you do, {{~Spell}} deals {{Digits}} damage to target {{Creature}}": "ActionList([DrawNumberCards({{Number[0]}}), MayCost(DiscardACardOfType({{SpecificCard[0]}})), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPermanent({{Creature[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent))])))])])",
    "Each opponent exiles a creature with the greatest power among creatures that player controls.\n{{AbilityWord}} - If {{Condition}}, {{~Spell}} deals damage to each opponent equal to the power of the creature they exiled": "ActionList([EachPlayerAction(Opponent, ExileAPermanent(And([IsCardtype(Creature), PowerIs(EqualTo(TheGreatestPowerAmongPermanents(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(ActionPlayer))])))), ControlledByAPlayer(SinglePlayer(ActionPlayer))]))), If({{Condition[0]}}, [SpellDealsDamageEachPlayer(Opponent, {{~Spell}}, PowerOfPermanent(ThePermanentExiledByPlayerThisWay(EachablePlayer)), Player(EachablePlayer))])])",
    "Each opponent faces a villainous choice - They exile cards from the top of their library until they exile a nonland card, then you may cast that card without paying its mana cost, or that player exiles the top {{Number}} cards of their library and {{~Spell}} deals damage equal to the total mana value of those exiled cards to that player": "ActionList([EachPlayerAction(Opponent, FaceAVillianousChoice([[PlayerAction(EachablePlayer, ExileTopCardsOfLibraryUntilASingleCardOfTypeIsExiled(IsNonCardtype(Land))), MayAction(CastExiledCardWithoutPaying(TheSpecificCardExiledThisWay))], [PlayerAction(EachablePlayer, ExileTheTopNumberCardsOfLibrary({{Number[0]}})), SpellDealsDamage({{~Spell}}, TotalManaValueOfExiledCards(WasExiledThisWay), Player(EachablePlayer))]]))])",
    "Each opponent secretly chooses silence or snitch, then the choices are revealed. If each opponent chose silence, {{~Spell}} deals {{Digits}} damage to each of them. If each opponent chose snitch, {{~Spell}} deals {{Digits}} damage to each of them. Otherwise, {{~Spell}} deals {{Digits}} damage to each opponent who chose silence": "ActionList([EachPlayerAction(AnyPlayer, SecretlyVoteForAWord([\"Silence\", \"Snitch\"])), RevealVotesForWord, If(AllVotesWereForWord(\"Silence\"), [SpellDealsDamage({{~Spell}}, {{Digits[0]}}, EachPlayer(VotedForWord(\"Silence\")))]), If(AllVotesWereForWord(\"Snitch\"), [SpellDealsDamage({{~Spell}}, {{Digits[1]}}, EachPlayer(VotedForWord(\"Snitch\")))]), Unless(Or([AllVotesWereForWord(\"Silence\"), AllVotesWereForWord(\"Snitch\")]), [SpellDealsDamage({{~Spell}}, {{Digits[2]}}, EachPlayer(VotedForWord(\"Silence\")))])])",
    "Each player chooses {{Number}} {{Permanents}} they control, then sacrifices the rest. {{~Spell}} deals {{Digits}} damage to each {{Creature}}": "ActionList([EachPlayerActions(AnyPlayer, [ChooseNumberPermanents({{Number[0]}}, And([{{Permanents[0]}}, ControlledByAPlayer(SinglePlayer(ActionPlayer))])), SacrificeEachPermanent(Other(ThePermanentChosenThisWay))]), SpellDealsDamage({{~Spell}}, {{Digits[0]}}, EachPermanent({{Creature[0]}}))])",
    "Each player discards their hand, then draws cards equal to the greatest number of cards a player discarded this way.\nCipher": "ActionList([EachPlayerAction(AnyPlayer, DiscardHand), EachPlayerAction(AnyPlayer, DrawNumberCards(TheGreatestNumberOfCardsDiscardedThisWay)), Cipher(ThisSpell)])",
    "Each player may discard their hand and draw {{Number}} cards. Then {{~Spell}} deals {{Digits}} damage to each opponent who discarded their hand this way": "ActionList([EachPlayerMayActions(AnyPlayer, [DiscardHand, DrawNumberCards({{Number[0]}})]), SpellDealsDamage(ThisSpell, {{Digits[0]}}, EachPlayer(PlayerWhoTookActionThisWay))])",
    "Each player may discard up to {{Number}} cards. {{~Spell}} deals damage to each player equal to {{Digits}} minus the number of cards they discarded this way": "ActionList([EachPlayerAction(AnyPlayer, DiscardUptoNumberCards({{Number[0]}})), SpellDealsDamage({{~Spell}}, Minus({{Digits[0]}}, TheNumberOfCardsDiscardedByPlayerThisWay(DealsDamage_ThatPlayer)), EachPlayer(AnyPlayer))])",
    "Each player may shuffle their hand and graveyard into their library. Each player who does draws {{Number}} cards. Exile {{~Spell}}": "ActionList([EachPlayerMayAction(AnyPlayer, ShuffleHandAndGraveyardIntoLibrary), EachPlayerAction(ShuffledLibraryThisWay, DrawNumberCards({{Number[0]}})), ExileSpell({{~Spell}})])",
    "Each player mills {{Number}} cards. Return up to {{Number}} {{SpecificCards}} from your graveyard to your hand. Exile {{~Spell}}": "ActionList([EachPlayerAction(AnyPlayer, MillNumberCards({{Number[0]}})), PutUptoNumberCardsFromGraveyardToHand({{Number[1]}}, {{SpecificCards[0]}}), ExileSpell({{~Spell}})])",
    "Each player reveals the top card of their library. For each {{SpecificCard}} revealed this way, create a token that's a copy of that card, except it's {{PT}}, it's {{a}} {{Zombie}} in addition to its other types, and it has {{Hasable}}. If no {{SpecificCards}} were revealed this way, return {{~Spell}} to its owner's hand": "ActionList([EachPlayerAction(AnyPlayer, RevealTopCardOfLibrary), CreateTokens([TokenCopyOfEachCardOfTypeRevealedThisWay({{SpecificCard[0]}}, TokenCopyEffects([SetPT({{PT[0]}}), AddCreatureTypes([{{Zombie[0]}}]), AddAbility([{{Hasable[0]}}])]))]), If(NoCardsOfTypeWereRevealedThisWay({{SpecificCards[0]}}), [ReturnSpellToOwnersHand({{~Spell}})])])",
    "Each player sacrifices {{Number}} {{Permanents}} of their choice. {{~Spell}} deals {{Digits}} damage to each {{Creature}}": "ActionList([EachPlayerAction(AnyPlayer, SacrificeNumberPermanents({{Number[0]}}, {{Permanents[0]}})), SpellDealsDamage({{~Spell}}, {{Digits[0]}}, EachPermanent({{Creature[0]}}))])",
    "Each player secretly chooses a number 0 or greater, then all players reveal those numbers simultaneously and determine the highest and lowest numbers revealed this way. {{~Spell}} deals damage equal to the highest number to each player who chose that number. Each player who didn't choose the lowest number discards their hand, then draws {{Number}} cards": "ActionList([EachPlayerAction(AnyPlayer, SecretlyChooseANumber), RevealSecretlyChosenNumbers, SpellDealsDamage({{~Spell}}, TheHighestNumberChosen, EachPlayer(ChoseHighestNumber)), EachPlayerActions(ExceptFor(ChoseLowestNumber), [DiscardHand, DrawNumberCards({{Number[0]}})])])",
    "Each player secretly votes for another player, then those votes are revealed. For each vote an opponent received, {{~Spell}} deals {{Digits}} damage to that player and each creature that player controls. For each vote you received, draw a card": "ActionList([EachPlayerAction(AnyPlayer, SecretlyVoteForAPlayer(Other(EachablePlayer))), RevealVotesForPlayer, SpellDealsDamageEachPlayerForEach(And([Opponent, ReceivedAVote]), {{~Spell}}, {{Digits[0]}}, MultipleRecipients([Player(EachablePlayer), EachPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(EachablePlayer))]))]), TheNumberOfVotesReceivedByPlayer(EachablePlayer)), DrawNumberCards(TheNumberOfVotesReceivedByPlayer(ActionPlayer))])",
    "Each player secretly votes for truth or consequences, then those votes are revealed. You draw cards equal to the number of truth votes. Then choose an opponent at random. {{~Spell}} deals {{Digits}} damage to that player for each consequences vote": "ActionList([EachPlayerAction(AnyPlayer, SecretlyVoteForAWord([\"Truth\", \"Consequences\"])), RevealVotesForWord, DrawNumberCards(TheNumberOfVotesForWord(\"Truth\")), ChooseAPlayerAtRandom(Opponent), SpellDealsDamageForEach({{~Spell}}, {{Digits[0]}}, Player(ThePlayerChosenThisWay), TheNumberOfVotesForWord(\"Consequences\"))])",
    "Each player shuffles all cards from their hand and all permanents they own into their library, then draws that many cards. Each player may put any number of {{SpecificCards}} from their hand onto the battlefield. Exile {{~Spell}}": "ActionList([EachPlayerActions(AnyPlayer, [ShuffleHandAndPermanentsIntoLibrary, DrawNumberCards(TheNumberOfCardsPlayerShuffledIntoLibraryThisWay(ActionPlayer)), PutAnyNumberOfCardsFromHandOntoBattlefield({{SpecificCards[0]}}, [EntersNormally])]), ExileSpell({{~Spell}})])",
    "Each player shuffles the cards from their hand into their library, then draws that many cards.\n{{AbilityWord}} - If {{Condition}}, {{~Spell}} deals damage to each opponent equal to {{GameNumber(ThatPlayer)}}": "ActionList([EachPlayerActions(AnyPlayer, [ShuffleHandIntoLibrary, DrawNumberCards(NumCardsShuffledIntoLibraryThisWay)]), If({{Condition[0]}}, [SpellDealsDamage({{~Spell}}, {{GameNumber(ThatPlayer=DealsDamage_ThatPlayer)[0]}}, EachPlayer(Opponent))])])",
    "Each player shuffles their hand and graveyard into their library, then draws {{Number}} cards. Exile {{~Spell}}": "ActionList([EachPlayerActions(AnyPlayer, [ShuffleHandAndGraveyardIntoLibrary, DrawNumberCards({{Number[0]}})]), ExileSpell({{~Spell}})])",
    "Exchange your hand and graveyard.\nExile {{~Spell}}": "ActionList([ExchangeHandAndGraveyard, ExileSpell(ThisSpell)])",
    "Exile all graveyards. Players can't cast {{PotentialSpells}} this turn. Exile {{~Spell}}": "ActionList([ExileEachPlayersGraveyard(AnyPlayer), CreateEachPlayerEffectUntil(AnyPlayer, [CantCastSpells({{PotentialSpells[0]}})], UntilEndOfTurn), ExileSpell({{~Spell}})])",
    "Exile all opponents' graveyards. You may cast spells from among those cards this turn, and mana of any type can be spent to cast them. At the beginning of the next end step, if any of those cards remain exiled, return them to their owners' graveyards.\nExile {{~Spell}}": "ActionList([ExileEachPlayersGraveyard(Opponent), CreatePlayerEffectUntil(You, [MayCastSpellsFromAmongExiledAndMaySpendManaAsThoughAnyTypeToCast(AnySpell, TheCardsExiledThisWay)], UntilEndOfTurn), CreateFutureTriggerI(AtTheBeginningOfTheNextEndStep, AnExiledCardPassesFilter(AnyExiledCard, TheCardsExiledThisWay), ActionList([ReturnEachExiledCardToGraveyard(TheCardsExiledThisWay)])), ExileSpell(ThisSpell)])",
    "Exile all {{Permanents}}. For each card exiled this way, you may play that card for as long as it remains exiled, and mana of any type can be spent to cast that spell. Exile {{~Spell}}": "ActionList([ExileEachPermanent({{Permanents[0]}}), CreatePlayerEffectUntil(You, [MayPlayExiledCardsAndMaySpendManaAsThoughAnyTypeToCast(TheCardsExiledThisWay)], UntilCardsAreNoLongerExiled(TheCardsExiledThisWay)), ExileSpell({{~Spell}})])",
    "Exile any number of target {{Permanents}}. At the beginning of the next end step, return those cards to the battlefield tapped under their owners' control.\nUntil your next turn, prevent all damage that would be dealt to you.\nExile {{~Spell}}": "Targeted([AnyNumberOfTargetPermanents({{Permanents[0]}})], ActionList([ExileEachPermanent(Ref_TargetPermanents), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutEachExiledCardOntoTheBattlefield(TheCardsExiledThisWay, [EntersTapped, EntersUnderOwnersControl])])), CreatePreventDamageUntil(DamageWouldBeDealtToRecipient(Player(You)), [PreventThatDamage], UntilPlayersNextTurn(You)), ExileSpell(ThisSpell)]))",
    "Exile cards from the top of your library until you exile cards with total mana value {{Digits}} or greater. You may cast any number of spells from among them without paying their mana costs.\nParadigm": "ActionList([ExileTopCardsOfLibraryUntilGroupCardsAreExiled(TotalManaValueIs(GreaterThanOrEqualTo({{Digits[0]}}))), CastAnyNumberOfSpellsFromExileWithoutPaying(AnySpell, TheCardsExiledThisWay), Paradigm(ThisSpell)])",
    "Exile cards from the top of your library until you exile {{a}} {{SpecificCard}}. Put that card onto the battlefield and the rest on the bottom of your library in a random order. Exile {{~Spell}} with {{Number}} {{CounterType}} counters on it": "ActionList([ExileCardsFromTheTopOfLibraryUntilACardOfTypeIsExiled({{SpecificCard[0]}}), PutExiledCardOntoBattlefield(TheExiledCardFoundThisWay, [EntersNormally]), PutEachExiledCardOnTheBottomOfTheirOwnersLibraryInARandomOrder(TheCardsExiledThisWay), ExileSpellWithANumberOfCountersOnIt({{~Spell}}, {{Number[0]}}, {{CounterType[0]}})])",
    "Exile cards from the top of your library until you exile {{a}} {{SpecificCard}}. {{~Spell}} deals damage to any target equal to that card's mana value.\nEpic": "Targeted([AnyTarget], ActionList([ExileTopCardsOfLibraryUntilASingleCardOfTypeIsExiled({{SpecificCard[0]}}), SpellDealsDamage({{~Spell}}, ManaValueOfExiled(TheCardExiledThisWay), Ref_AnyTarget), Epic]))",
    "Exile target {{Permanent}}. Return it to the battlefield under its owner's control at the beginning of the next end step.\nCipher": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([ExilePermanent(Ref_TargetPermanent), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersUnderOwnersControl])])), Cipher(ThisSpell)]))",
    "Exile target {{Permanent}}. {{~Spell}} deals {{Digits}} damage to that permanent's controller": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([ExilePermanent(Ref_TargetPermanent), SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Player(ControllerOfPermanent(Ref_TargetPermanent)))]))",
    "Exile target {{SpecificCard}} from a graveyard and copy it. You may cast the copy without paying its mana cost.\nExile {{~Spell}}": "Targeted([TargetGraveyardCard({{SpecificCard[0]}})], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard), CopyExiledCard(TheCardExiledThisWay), MayAction(CastCopiedCardWithoutPaying), ExileSpell(ThisSpell)]))",
    "Exile target {{SpecificCard}} from a graveyard. Copy that card {{Number}} times. You may cast the copies without paying their mana costs. Exile {{~Spell}}": "Targeted([TargetGraveyardCard({{SpecificCard[0]}})], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard), CopyExiledCardNumberTimes(TheCardExiledThisWay, {{Number[0]}}), CastAnyNumberOfCopiedCardsWithoutPaying, ExileSpell({{~Spell}})]))",
    "Exile target {{SpecificCard}} from your graveyard and target {{SpecificCard}} from an opponent's graveyard. Copy those cards. Cast the copies if able without paying their mana costs. Exile {{~Spell}}": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))])), TargetGraveyardCard(And([{{SpecificCard[1]}}, InAPlayersGraveyard(Opponent)]))], ActionList([ExileEachGraveyardCard(Or([SingleGraveyardCard(Ref_TargetGraveyardCard1), SingleGraveyardCard(Ref_TargetGraveyardCard2)])), CopyExiledCards(TheCardsExiledThisWay), CastEachCopiedCardWithoutPaying, ExileSpell({{~Spell}})]))",
    "Exile up to one target {{Permanent}}. Return it to the battlefield under its owner's control at the beginning of the next end step.\n{{~Spell}} deals {{Digits}} damage to each {{Creature}}": "Targeted([UptoOneTargetPermanent({{Permanent[0]}})], ActionList([ExilePermanent(Ref_TargetPermanent), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersUnderOwnersControl])])), SpellDealsDamage({{~Spell}}, {{Digits[0]}}, EachPermanent({{Creature[0]}}))]))",
    "Exile {{Number}} target {{Permanents}}. {{~Spell}} deals {{Digits}} damage to you": "Targeted([NumberTargetPermanents({{Number[0]}}, {{Permanents[0]}})], ActionList([ExileEachPermanent(Ref_TargetPermanents), SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Player(You))]))",
    "Exile {{~Spell}}": "ActionList([ExileSpell({{~Spell}})])",
    "Exile {{~Spell}} with {{Number}} {{CounterType}} counters on it": "ActionList([ExileSpellWithANumberOfCountersOnIt({{~Spell}}, {{Number[0]}}, {{CounterType[0]}})])",
    "Exile {{~Spell}}. Each player discards their hand, then returns up to {{Number}} cards from their graveyard to their hand": "ActionList([ExileSpell({{~Spell}}), EachPlayerActions(AnyPlayer, [DiscardHand, PutUptoNumberCardsFromGraveyardToHand({{Number[0]}}, AnyCard)])])",
    "Exile {{~Spell}}. Each player shuffles their hand and graveyard into their library, then draws {{Number}} cards. You untap up to {{Number}} {{Permanents}}": "ActionList([ExileSpell({{~Spell}}), EachPlayerActions(AnyPlayer, [ShuffleHandAndGraveyardIntoLibrary, DrawNumberCards({{Number[0]}})]), UntapUptoNumberPermanents({{Number[0]}}, {{Permanents[0]}})])",
    "Flip a coin until you lose a flip or choose to stop flipping. If you lose a flip, {{~Spell}} has no effect. If you win one or more flips, {{~Spell}} deals {{Digits}} damage to target {{Creature}}. If you win two or more flips, {{~Spell}} deals {{Digits}} damage to each opponent. If you win three or more flips, draw {{Number}} cards and untap all {{Permanents}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([FlipACoinUntilLoseOrStop, IfElse(NumCoinFlipsLostIs(GreaterThan(Integer(0))), [DoNothing], [If(NumCoinFlipsWonIs(GreaterThanOrEqualTo(Integer(1))), [SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent))]), If(NumCoinFlipsWonIs(GreaterThanOrEqualTo(Integer(2))), [SpellDealsDamage({{~Spell}}, {{Digits[1]}}, EachPlayer(Opponent))]), If(NumCoinFlipsWonIs(GreaterThanOrEqualTo(Integer(3))), [DrawNumberCards({{Number[0]}}), UntapEachPermanent({{Permanents[0]}})])])]))",
    "Flip a coin. If you win the flip, {{~Spell}} deals {{Digits}} damage to each {{Creature}} and each player. If you lose the flip, each player draws a card": "ActionList([FlipACoin_OnWinAndLose([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, MultipleRecipients([EachPermanent({{Creature[0]}}), EachPlayer(AnyPlayer)]))], [EachPlayerAction(AnyPlayer, DrawACard)])])",
    "For each color, return up to one target card of that color from your graveyard to your hand. Exile {{~Spell}}": "Targeted([UptoOneTargetGraveyardCardOfEachColor(InAPlayersGraveyard(SinglePlayer(You)))], ActionList([PutEachGraveyardCardIntoHand(Ref_TargetGraveyardCards), ExileSpell({{~Spell}})]))",
    "For each permanent type, return up to one card of that type from your graveyard to the battlefield. You lose {{Digits}} life for each card returned this way. Exile {{~Spell}}": "ActionList([ReturnUptoOneCardOfEachPermanentTypeInPlayersGraveyardToBattlefield(You, [EntersNormally]), LoseLife(TheNumberOfCardsReturnedToTheBattlefieldThisWay), ExileSpell({{~Spell}})])",
    "For each player, choose friend or foe. Each friend discards all cards from their hand, then draws that many cards plus one. {{~Spell}} deals damage to each foe equal to the number of cards in their hand": "ActionList([ForEachPlayerChooseAWord(AnyPlayer, [\"Friend\", \"Foe\"]), EachPlayerActions(ChoseWord(\"Friend\"), [DiscardHand, DrawNumberCards(Plus(TheNumberOfCardsPlayerDiscardedThisWay(ActionPlayer), Integer(1)))]), SpellDealsDamage({{~Spell}}, TheNumberOfCardsInPlayersHand(DealsDamage_ThatPlayer), EachPlayer(ChoseWord(\"Foe\")))])",
    "For each player, {{~Spell}} deals damage to that player and each creature that player controls equal to {{GameNumber(ThatPlayer)}}": "ActionList([SpellDealsDamageEachPlayer(AnyPlayer, {{~Spell}}, {{GameNumber(ThatPlayer=EachablePlayer)[0]}}, MultipleRecipients([Player(EachablePlayer), EachPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(EachablePlayer))]))]))])",
    "Gain control of target {{Creature}} until end of turn. Untap that creature. It gains {{Hasable}} until end of turn. {{~Spell}} deals {{Digits}} damage to any other target": "Targeted([TargetPermanent({{Creature[0]}}), AnyTargetExceptPermanent(Ref_TargetPermanent)], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Ref_AnyTarget)]))",
    "If target player has exactly {{Digits}} life, {{~Spell}} deals {{Digits}} damage to that player": "Targeted([TargetPlayer(AnyPlayer)], ActionList([If(PlayerPassesFilter(Ref_TargetPlayer, LifeTotalIs(EqualTo({{Digits[0]}}))), [SpellDealsDamage({{~Spell}}, {{Digits[1]}}, Player(Ref_TargetPlayer))])]))",
    "If {{Condition}}, damage can't be prevented this turn.\n{{~Spell}} deals {{Digits}} damage to any target": "Targeted([AnyTarget], ActionList([If({{Condition[0]}}, [CreateGameEffect(UntilEndOfTurn, DamageCantBePrevented)]), SpellDealsDamage(ThisSpell, {{Digits[0]}}, Ref_AnyTarget)]))",
    "Look at target opponent's hand and choose a card from it. You control that player until {{~Spell}} finishes resolving. The player plays that card if able. While doing so, the player can activate mana abilities only if they're from lands that player controls and only if mana they produce is spent to activate other mana abilities of lands the player controls and/or to play that card. If the chosen card is cast as a spell, you control the player while that spell is resolving": "Targeted([TargetPlayer(Opponent)], ActionList([LookAtPlayersHandAndChooseACardForPlayerToPlayControllingThemToDoSo(Ref_TargetPlayer, AnyCard)]))",
    "Look at the top three cards of your library. You may put those cards on the bottom of your library in any order. If you do, return {{~Spell}} to its owner's hand. Otherwise, draw three cards": "ActionList([LookAtTheTopNumberCardsOfLibrary(Integer(3), [MayCost(PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder), Unless(CostWasPaid, [LeaveRemainingCardsOnTopOfLibraryInSameOrder])]), IfElse(CostWasPaid, [ReturnSpellToOwnersHand({{~Spell}})], [DrawNumberCards(Integer(3))])])",
    "Look at the top {{Number}} cards of your library. Put any number of {{SpecificCards}} from among them onto the battlefield and the rest into your hand. Exile {{~Spell}}": "ActionList([LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [MayPutAnyNumberOfCardsOntoTheBattlefield({{SpecificCards[0]}}, [EntersNormally]), PutTheRemainingCardsIntoHand])])",
    "Look at the top {{Number}} cards of your library. Put {{Number}} of them into your hand and the other into your graveyard. {{~Spell}} deals {{Digits}} damage to you": "ActionList([LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [PutNumberGenericCardsIntoHand({{Number[1]}}), PutTheRemainingCardsIntoGraveyard]), SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Player(You))])",
    "Players can't gain life this turn. Damage can't be prevented this turn. {{~Spell}} deals {{Digits}} damage to any target": "Targeted([AnyTarget], ActionList([CreateEachPlayerEffectUntil(AnyPlayer, [CantGainLife], UntilEndOfTurn), CreateGameEffect(UntilEndOfTurn, DamageCantBePrevented), SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Ref_AnyTarget)]))",
    "Players can't gain life this turn. Damage can't be prevented this turn. {{~Spell}} deals {{Digits}} damage to target player or planeswalker": "Targeted([TargetPlayerOrPermanent(AnyPlayer, IsCardtype(Planeswalker))], ActionList([CreateEachPlayerEffectUntil(AnyPlayer, [CantGainLife], UntilEndOfTurn), CreateGameEffect(UntilEndOfTurn, DamageCantBePrevented), SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Ref_TargetPlayerOrPermanent)]))",
    "Prevent all damage that would be dealt to you and permanents you control this turn by {{DamageSources}}. If damage is prevented this way, you may have {{~Spell}} deal that much damage to target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePreventDamageUntil(DamageWouldBeDealtByASourceToARecipient({{DamageSources[0]}}, APlayerOrAPermanent(SinglePlayer(You), ControlledByAPlayer(SinglePlayer(You)))), [PreventThatDamage, If(DamageWasPreventedThisWay, [MayAction(HaveSpellDealDamage({{~Spell}}, TheAmountOfDamagePreventedThisWay, Permanent(Ref_TargetPermanent)))])], UntilEndOfTurn)]))",
    "Prevent all damage that would be dealt to you and {{Planeswalkers}} this turn by {{DamageSources}}. If damage from a creature source is prevented this way, {{~Spell}} deals that much damage to that creature. If damage from a noncreature source is prevented this way, {{~Spell}} deals that much damage to the source's controller": "ActionList([CreatePreventDamageUntil(DamageWouldBeDealtByASourceToARecipient({{DamageSources[0]}}, APlayerOrAPermanent(SinglePlayer(You), {{Planeswalkers[0]}})), [PreventThatDamage, IfElse(DamageFromAPermanentSourceWasPreventedThisWay(IsCardtype(Creature)), [SpellDealsDamage({{~Spell}}, TheAmountOfDamagePreventedThisWay, Permanent(WouldDealDamage_DamageSourceAsPermanent))], [SpellDealsDamage({{~Spell}}, TheAmountOfDamagePreventedThisWay, Player(WouldDealDamage_ControllerOfDamageSource))])], UntilEndOfTurn)])",
    "Prevent the next X damage that would be dealt to target {{Creature}} this turn, where X is {{GameNumber}}. If damage is prevented this way, {{~Spell}} deals that much damage to any target": "Targeted([TargetPermanent({{Creature[0]}}), AnyTarget], ActionList([CreateFuturePreventDamage(NextAmountOfDamageThatWouldBeDealtThisTurnToRecipient({{GameNumber[0]}}, Permanent(Ref_TargetPermanent)), [PreventThatDamage, If(DamageWasPreventedThisWay, [SpellDealsDamage({{~Spell}}, TheAmountOfDamagePreventedThisWay, Ref_AnyTarget)])])]))",
    "Prevent the next {{Digits}} damage that {{a}} {{DamageSource}} of your choice would deal to you and/or permanents you control this turn. If damage is prevented this way, {{~Spell}} deals that much damage to any target": "Targeted([AnyTarget], ActionList([ChooseADamageSource({{DamageSource[0]}}), CreateFuturePreventDamage(NextAmountOfDamageThatWouldBeDealtThisTurnBySourceToARecipient({{Digits[0]}}, TheChosenDamageSource, APlayerOrAPermanent(SinglePlayer(You), ControlledByAPlayer(SinglePlayer(You)))), [PreventThatDamage, If(DamageWasPreventedThisWay, [SpellDealsDamage({{~Spell}}, TheAmountOfDamagePreventedThisWay, Ref_AnyTarget)])])]))",
    "Put target {{SpecificCard}} from a graveyard onto the battlefield under your control. Shuffle {{~Spell}} into its owner's library": "Targeted([TargetGraveyardCard({{SpecificCard[0]}})], ActionList([PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersUnderPlayersControl(You)]), ShuffleSpellIntoLibrary({{~Spell}})]))",
    "Put up to one target {{SpecificCard}} from a graveyard onto the battlefield under your control. Destroy up to one target {{Permanent}}. Exile {{~Spell}}": "Targeted([UptoOneTargetGraveyardCard({{SpecificCard[0]}}), UptoOneTargetPermanent({{Permanent[0]}})], ActionList([PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersUnderPlayersControl(You)]), DestroyPermanent(Ref_TargetPermanent), ExileSpell({{~Spell}})]))",
    "Put {{Number}} {{CounterType}} counters on each {{Permanent}}.\nParadigm": "ActionList([PutNumberCountersOfTypeOnEachPermanent({{Number[0]}}, {{CounterType[0]}}, {{Permanent[0]}}), Paradigm(ThisSpell)])",
    "Put {{a}} {{CounterType}} counter on target {{Creature}}. {{~Spell}} deals {{Digits}} damage to that creature's controller": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent), SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Player(ControllerOfPermanent(Ref_TargetPermanent)))]))",
    "Return all cards from your graveyard to your hand. Exile {{~Spell}}. You have no maximum hand size for the rest of the game": "ActionList([ReturnEachCardFromGraveyardToHand(AnyCard), ExileSpell({{~Spell}}), CreatePlayerEffect(You, [HasNoMaximumHandSize])])",
    "Return all {{Permanents}} to their owners' hands. Each player may shuffle their hand and graveyard into their library, then each player who does draws {{Number}} cards.\nExile {{~Spell}}": "ActionList([PutEachPermanentIntoItsOwnersHand({{Permanents[0]}}), EachPlayerMayAction(AnyPlayer, ShuffleHandAndGraveyardIntoLibrary), EachPlayerAction(PlayerWhoTookActionThisWay, DrawNumberCards({{Number[0]}})), ExileSpell(ThisSpell)])",
    "Return all {{SpecificCards}} from your graveyard to the battlefield. Each of them is {{a}} {{PT}} {{Zombie}} with {{Hasable}} in addition to its other types. Exile {{~Spell}}": "ActionList([ReturnEachCardFromPlayersGraveyardToBattlefield({{SpecificCards[0]}}, You, [EntersWithLayerEffect([SetPT({{PT[0]}}), AddCreatureType({{Zombie[0]}}), AddAbility([{{Hasable[0]}}])])]), ExileSpell({{~Spell}})])",
    "Return all {{SpecificCards}} from your graveyard to your hand. You have no maximum hand size for the rest of the game.\nExile {{~Spell}}": "ActionList([ReturnEachCardFromGraveyardToHand({{SpecificCards[0]}}), CreatePlayerEffect(You, [HasNoMaximumHandSize]), ExileSpell(ThisSpell)])",
    "Return any number of cards with different mana values from your graveyard to your hand. Put {{~Spell}} on the bottom of its owner's library": "ActionList([ReturnAnyNumberOfGroupCardsFromGraveyardToHand(AnyCard, DifferentManaValues)])",
    "Return any number of target creature cards with total power {{Digits}} or less from your graveyard to the battlefield. Exile {{~Spell}}": "Targeted([AnyNumberOfTargetGroupGraveyardCards(And([IsCardtype(Creature), InAPlayersGraveyard(SinglePlayer(You))]), TotalPowerIs(LessThanOrEqualTo({{Digits[0]}})))], ActionList([ReturnEachGraveyardCardToBattlefield(Ref_TargetGraveyardCards, [EntersNormally]), ExileSpell({{~Spell}})]))",
    "Return any number of {{SpecificCards}} with total mana value X or less from your graveyard to the battlefield, where X is {{~Spell}}'s intensity.\nAll {{SpecificCards}} you own intensify by {{Digits}}": "ActionList([ReturnAnyNumberOfGroupCardsFromPlayersGraveyardToBattlefield({{SpecificCards[0]}}, TotalManaValueIs(LessThanOrEqualTo(IntensityOfSpell({{~Spell}}))), You, [EntersNormally]), PerpetuallyIncreaseIntensityOfCardsOwnedByPlayer({{SpecificCards[0]}}, You, {{Digits[0]}})])",
    "Return any number of {{Swamps}} you control to their owner's hand. {{~Spell}} deals damage to target {{Creature}} equal to twice the number of {{Swamps}} returned this way": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([ReturnAnyNumberOfPermanentsToTheirOwnersHands(And([IsLandType({{Swamps[0]}}), ControlledByAPlayer(SinglePlayer(You))])), SpellDealsDamage({{~Spell}}, Twice(NumCardsReturnedToHandThisWay), Permanent(Ref_TargetPermanent))]))",
    "Return target card from your graveyard to your hand. Clash with an opponent. If you win, untap all {{Permanents}}. {{Reminder}}\nExile {{~Spell}}": "Targeted([TargetGraveyardCard(InAPlayersGraveyard(SinglePlayer(You)))], ActionList([PutGraveyardCardIntoHand(Ref_TargetGraveyardCard), Clash(Opponent, [UntapEachPermanent({{Permanents[0]}})], [DoNothing]), ExileSpell(ThisSpell)]))",
    "Return target card from your graveyard to your hand. Exile {{~Spell}}": "Targeted([TargetGraveyardCard(InAPlayersGraveyard(SinglePlayer(You)))], ActionList([PutGraveyardCardIntoHand(Ref_TargetGraveyardCard), ExileSpell({{~Spell}})]))",
    "Return target card from your graveyard to your hand. If you return {{a}} {{SpecificCard}} to your hand this way, {{~Spell}} deals damage equal to that card's mana value to any target.\nExile {{~Spell}}": "Targeted([TargetGraveyardCard(InAPlayersGraveyard(SinglePlayer(You))), AnyTarget], ActionList([PutGraveyardCardIntoHand(Ref_TargetGraveyardCard), If(ACardWasPutIntoHandThisWay({{SpecificCard[0]}}), [SpellDealsDamage({{~Spell}}, ManaValueOfCardPutInHandThisWay, Ref_AnyTarget)]), ExileSpell(ThisSpell)]))",
    "Return target card from your graveyard to your hand. You gain life equal to that card's mana value. Exile {{~Spell}}": "Targeted([TargetGraveyardCard(InAPlayersGraveyard(SinglePlayer(You)))], ActionList([PutGraveyardCardIntoHand(Ref_TargetGraveyardCard), GainLife(ManaValueOfGraveyardCard(Ref_TargetGraveyardCard)), ExileSpell({{~Spell}})]))",
    "Return target spell or permanent to its owner's hand. {{~Spell}} deals {{Digits}} damage to any target. Create {{Number}} {{PT}} {{CreatureTokens}} with {{Hasable}}. Draw {{Number}} cards. You gain {{Digits}} life": "Targeted_Modal([Targeted([TargetSpell(AnySpell), AnyTarget], ActionList([ReturnSpellToOwnersHand(Ref_TargetSpell), SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Ref_AnyTarget), CreateTokens([NumberTokens({{Number[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}]))]), DrawNumberCards({{Number[1]}}), GainLife({{Digits[1]}})])), Targeted([TargetPermanent(AnyPermanent), AnyTarget], ActionList([PutPermanentIntoItsOwnersHand(Ref_TargetPermanent), SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Ref_AnyTarget), CreateTokens([NumberTokens({{Number[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}]))]), DrawNumberCards({{Number[1]}}), GainLife({{Digits[1]}})]))])",
    "Return target {{Permanent}} to its owner's hand. Exile {{~Spell}} with {{Number}} {{CounterType}} counters on it": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutGraveyardCardIntoHand(Ref_TargetGraveyardCard), ExileSpellWithANumberOfCountersOnIt({{~Spell}}, {{Number[0]}}, {{CounterType[0]}})]))",
    "Return target {{SpecificCard}} from a graveyard to its owner's hand. Clash with an opponent. If you win, return {{~Spell}} to its owner's hand": "Targeted([TargetGraveyardCard({{SpecificCard[0]}})], ActionList([PutGraveyardCardIntoHand(Ref_TargetGraveyardCard), Clash(Opponent, [ReturnSpellToOwnersHand({{~Spell}})], [DoNothing])]))",
    "Return target {{SpecificCard}} from your graveyard to the battlefield tapped.\nCipher": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersTapped]), Cipher(ThisSpell)]))",
    "Return target {{SpecificCard}} from your graveyard to the battlefield.\nParadigm": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersNormally]), Paradigm(ThisSpell)]))",
    "Return target {{SpecificCard}} from your graveyard to your hand.\nCipher": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardIntoHand(Ref_TargetGraveyardCard), Cipher(ThisSpell)]))",
    "Return target {{SpecificCard}} from your graveyard to your hand. Exile {{~Spell}}": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardIntoHand(Ref_TargetGraveyardCard), ExileSpell({{~Spell}})]))",
    "Return target {{SpecificCard}} from your graveyard to your hand. {{~Spell}} deals damage equal to that card's mana value to each {{Creature}}. Exile {{~Spell}}": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardIntoHand(Ref_TargetGraveyardCard), SpellDealsDamage({{~Spell}}, ManaValueOfGraveyardCard(Ref_TargetGraveyardCard), EachPermanent({{Creature[0]}})), ExileSpell({{~Spell}})]))",
    "Return target {{SpecificCard}} from your graveyard to your hand. {{~Spell}} deals damage equal to that card's mana value to up to one target {{CreatureOrPlaneswalker}}": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))])), UptoOneTargetPermanent({{CreatureOrPlaneswalker[0]}})], ActionList([PutGraveyardCardIntoHand(Ref_TargetGraveyardCard), SpellDealsDamage({{~Spell}}, ManaValueOfGraveyardCard(Ref_TargetGraveyardCard), Permanent(Ref_TargetPermanent))]))",
    "Return target {{SpecificCard}} from your graveyard to your hand. {{~Spell}} deals damage equal to that card's power to target {{Creature}}": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))])), TargetPermanent({{Creature[0]}})], ActionList([PutGraveyardCardIntoHand(Ref_TargetGraveyardCard), SpellDealsDamage({{~Spell}}, PowerOfGraveyardCard(Ref_TargetGraveyardCard), Permanent(Ref_TargetPermanent))]))",
    "Return target {{SpecificCard}} from your graveyard to your hand. {{~Spell}} deals damage to any target equal to the power of the card returned this way": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))])), AnyTarget], ActionList([PutGraveyardCardIntoHand(Ref_TargetGraveyardCard), SpellDealsDamage({{~Spell}}, PowerOfGraveyardCard(Ref_TargetGraveyardCard), Ref_AnyTarget)]))",
    "Return up to one target {{SpecificCard}} and up to one target {{SpecificCard}} from your graveyard to your hand, then discard a card. Exile {{~Spell}}": "Targeted([UptoOneTargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))])), UptoOneTargetGraveyardCard(And([{{SpecificCard[1]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutEachGraveyardCardIntoHand(Or([SingleGraveyardCard(Ref_TargetGraveyardCard1), SingleGraveyardCard(Ref_TargetGraveyardCard2)])), DiscardACard, ExileSpell({{~Spell}})]))",
    "Return up to one target {{SpecificCard}} and up to one target {{SpecificCard}} from your graveyard to your hand. Exile {{~Spell}}": "Targeted([UptoOneTargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))])), UptoOneTargetGraveyardCard(And([{{SpecificCard[1]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutEachGraveyardCardIntoHand(Or([SingleGraveyardCard(Ref_TargetGraveyardCard1), SingleGraveyardCard(Ref_TargetGraveyardCard2)])), ExileSpell({{~Spell}})]))",
    "Return up to one target {{SpecificCard}}, up to one target {{SpecificCard}}, up to one target {{SpecificCard}}, up to one target {{SpecificCard}}, and up to one target {{SpecificCard}} from your graveyard to your hand.\nExile {{~Spell}}": "Targeted([UptoOneTargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))])), UptoOneTargetGraveyardCard(And([{{SpecificCard[1]}}, InAPlayersGraveyard(SinglePlayer(You))])), UptoOneTargetGraveyardCard(And([{{SpecificCard[2]}}, InAPlayersGraveyard(SinglePlayer(You))])), UptoOneTargetGraveyardCard(And([{{SpecificCard[3]}}, InAPlayersGraveyard(SinglePlayer(You))])), UptoOneTargetGraveyardCard(And([{{SpecificCard[4]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutEachGraveyardCardIntoHand(Or([SingleGraveyardCard(Ref_TargetGraveyardCard1), SingleGraveyardCard(Ref_TargetGraveyardCard2), SingleGraveyardCard(Ref_TargetGraveyardCard3), SingleGraveyardCard(Ref_TargetGraveyardCard4), SingleGraveyardCard(Ref_TargetGraveyardCard5)])), ExileSpell(ThisSpell)]))",
    "Return up to {{Number}} target cards from your graveyard to your hand. Exile {{~Spell}}": "Targeted([UptoNumberTargetGraveyardCards({{Number[0]}}, InAPlayersGraveyard(SinglePlayer(You)))], ActionList([PutEachGraveyardCardIntoHand(Ref_TargetGraveyardCards), ExileSpell({{~Spell}})]))",
    "Return up to {{Number}} target permanent cards from your graveyard to your hand. Target player shuffles up to {{Number}} target cards from their graveyard into their library. Exile {{~Spell}}": "Targeted([UptoNumberTargetGraveyardCards({{Number[0]}}, And([IsPermanent, InAPlayersGraveyard(SinglePlayer(You))])), TargetPlayer(AnyPlayer), UptoNumberTargetGraveyardCards({{Number[1]}}, InAPlayersGraveyard(SinglePlayer(Ref_TargetPlayer)))], ActionList([PutEachGraveyardCardIntoHand(Ref_TargetGraveyardCards1), PlayerAction(Ref_TargetPlayer, ShuffleEachGraveyardCardIntoLibrary(Ref_TargetGraveyardCards2))]))",
    "Return up to {{Number}} target {{SpecificCards}} from your graveyard to the battlefield. Each of those creatures is {{a}} {{Black}} {{Zombie}} in addition to its other colors and types. Put {{~Spell}} on the bottom of its owner's library": "Targeted([UptoNumberTargetGraveyardCards({{Number[0]}}, And([{{SpecificCards[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([ReturnEachGraveyardCardToBattlefield(Ref_TargetGraveyardCards, [EntersWithLayerEffect([AddColor(SimpleColorList([{{Black[0]}}])), AddCreatureType({{Zombie[0]}})])]), ReturnSpellToBottomOfLibrary({{~Spell}})]))",
    "Return up to {{Number}} target {{SpecificCards}} from your graveyard to your hand. Each player gains {{Digits}} life. Exile {{~Spell}}": "Targeted([UptoNumberTargetGraveyardCards({{Number[0]}}, And([{{SpecificCards[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutEachGraveyardCardIntoHand(Ref_TargetGraveyardCards), EachPlayerAction(AnyPlayer, GainLife({{Digits[0]}})), ExileSpell({{~Spell}})]))",
    "Return up to {{Number}} target {{SpecificCards}} from your graveyard to your hand. Exile {{~Spell}}": "Targeted([UptoNumberTargetGraveyardCards({{Number[0]}}, And([{{SpecificCards[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutEachGraveyardCardIntoHand(Ref_TargetGraveyardCards), ExileSpell({{~Spell}})]))",
    "Return {{Number}} target cards from your graveyard to your hand. Exile {{~Spell}}": "Targeted([NumberTargetGraveyardCards({{Number[0]}}, InAPlayersGraveyard(SinglePlayer(You)))], ActionList([PutEachGraveyardCardIntoHand(Ref_TargetGraveyardCards), ExileSpell({{~Spell}})]))",
    "Reveal any number of {{SpecificCards}} in your hand. {{~Spell}} deals X damage to any target, where X is the number of cards revealed this way": "Targeted([AnyTarget], ActionList([RevealAnyNumberOfCardsOfTypeFromHand({{SpecificCards[0]}}), SpellDealsDamage({{~Spell}}, TheNumberOfCardsInHandRevealedThisWay, Ref_AnyTarget)]))",
    "Reveal cards from the top of your library until you reveal a nonland card. Put the revealed cards on the bottom of your library in a random order. When you reveal a nonland card this way, {{~Spell}} deals damage equal to that card's mana value to any target": "ActionList([RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed(IsNonCardtype(Land), [PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder]), If(ACardWasFoundThisWay, [ReflexiveTrigger(Targeted([AnyTarget], ActionList([SpellDealsDamage({{~Spell}}, ManaValueOfTheCardRevealedThisWay, Ref_AnyTarget)])))])])",
    "Reveal cards from the top of your library until you reveal {{a}} {{SpecificCard}}. Put that card onto the battlefield and the rest on the bottom of your library in a random order. {{~Spell}} deals damage to you equal to the number of cards revealed this way": "ActionList([RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed({{SpecificCard[0]}}, [PutTheCardFoundThisWayOntoTheBattlefield([EntersNormally]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder]), SpellDealsDamage({{~Spell}}, TheNumberOfLibraryCardsRevealedThisWay, Player(You))])",
    "Reveal cards from the top of your library until you reveal {{a}} {{SpecificCard}}. Put that card onto the battlefield and the rest on the bottom of your library in any order. Clash with an opponent. If you win, return {{~Spell}} to its owner's hand": "ActionList([RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed({{SpecificCard[0]}}, [PutTheCardFoundThisWayOntoTheBattlefield([EntersNormally]), PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder]), Clash(Opponent, [ReturnSpellToOwnersHand({{~Spell}})], [DoNothing])])",
    "Reveal the top {{Number}} cards of your library, then put those cards on the bottom of your library in any order. If {{a}} {{SpecificCard}} was revealed this way, {{~Spell}} deals {{Digits}} damage to any target": "Targeted([AnyTarget], ActionList([RevealTheTopNumberCardsOfLibrary({{Number[0]}}, [PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder]), If(ACardWasRevealedThisWay({{SpecificCard[0]}}), [SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Ref_AnyTarget)])]))",
    "Roll a d20.\n{{RawDigits}}-{{RawDigits}} | {{~Spell}} deals {{Digits}} damage to each {{Creature}}.\n{{RawDigits}}-{{RawDigits}} | You may choose {{a}} {{Creature}}. {{~Spell}} deals {{Digits}} damage to each {{Creature}} not chosen this way.\n{{RawDigits}} | {{~Spell}} deals {{Digits}} damage to each {{Creature}}": "ActionList([RollAD20, ValueActions(TheDiceResult, [ValueAction(BetweenValues({{RawDigits[0]}}, {{RawDigits[1]}}), [SpellDealsDamage({{~Spell}}, {{Digits[0]}}, EachPermanent({{Creature[0]}}))]), ValueAction(BetweenValues({{RawDigits[2]}}, {{RawDigits[3]}}), [MayAction(ChooseAPermanent({{Creature[1]}})), SpellDealsDamage({{~Spell}}, {{Digits[1]}}, EachPermanent(And([{{Creature[2]}}, NotChosenThisWay])))]), ValueAction(ExactValue({{RawDigits[4]}}), [SpellDealsDamage({{~Spell}}, {{Digits[2]}}, EachPermanent({{Creature[3]}}))])])])",
    "Roll a six-sided die. When you do, {{~Spell}} deals {{Digits}} damage to each of up to X target {{Creatures}}, where X is the result": "ActionList([MustCost(RollAD6), If(CostWasPaid, [ReflexiveTrigger(Targeted([UptoNumberTargetPermanents(TheDiceResult, {{Creatures[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, EachPermanent(Ref_TargetPermanents))])))])])",
    "Roll two d12 and choose one result. {{~Spell}} deals damage equal to that result to each {{Creature}}. Then create a number of Treasure tokens equal to the other result": "ActionList([RollTwoD12AndChooseAnOrder, SpellDealsDamage({{~Spell}}, TheFirstDiceResult, EachPermanent({{Creature[0]}})), CreateTokens([NumberTokens(TheSecondDiceResult, TreasureToken)])])",
    "Roll {{Number}} six-sided dice. Return any number of cards with total mana value X or less from your graveyard to your hand, where X is the total of those results. Exile {{~Spell}}": "ActionList([RollNumberD6({{Number[0]}}), ReturnAnyNumberOfGroupCardsFromGraveyardToHand(AnyCard, TotalManaValueIs(LessThanOrEqualTo(TheTotalOfTheDiceResults))), ExileSpell({{~Spell}})])",
    "Sacrifice any number of {{Permanents}}. {{~Spell}} deals that much damage to any target": "Targeted([AnyTarget], ActionList([SacrificeAnyNumberOfPermanents({{Permanents[0]}}), SpellDealsDamage({{~Spell}}, TheNumberOfPermanentsSacrificedThisWay, Ref_AnyTarget)]))",
    "Sacrifice any number of {{Permanents}}. {{~Spell}} deals that much damage to target player or planeswalker": "Targeted([TargetPlayerOrPermanent(AnyPlayer, IsCardtype(Planeswalker))], ActionList([SacrificeAnyNumberOfPermanents({{Permanents[0]}}), SpellDealsDamage({{~Spell}}, TheNumberOfPermanentsSacrificedThisWay, Ref_TargetPlayerOrPermanent)]))",
    "Sacrifice {{a}} {{Creature}}. {{~Spell}} deals damage equal to {{GameNumber(ThatCreature)}} to each {{Creature}} and each player": "ActionList([SacrificeAPermanent({{Creature[0]}}), SpellDealsDamage({{~Spell}}, {{GameNumber(ThatCreature=ThePermanentSacrificedThisWay)[0]}}, MultipleRecipients([EachPermanent({{Creature[0]}}), EachPlayer(AnyPlayer)]))])",
    "Sacrifice {{a}} {{Creature}}. {{~Spell}} deals damage equal to {{GameNumber[ThatSacrificedPermanent]}} to any target": "Targeted([AnyTarget], ActionList([SacrificeAPermanent({{Creature[0]}}), SpellDealsDamage({{~Spell}}, {{GameNumber[ThatSacrificedPermanent][0]}}, Ref_AnyTarget)]))",
    "Search your library for up to {{Number}} {{SpecificCards}} with different names and exile them. An opponent chooses one of those cards. Shuffle that card into your library. You may cast the other cards without paying their mana costs. Exile {{~Spell}}": "ActionList([SearchLibrary([FindNumberGroupCards({{Number[0]}}, {{SpecificCards[0]}}, DifferentNames), ExileFoundCards, APlayerChooseACardExiledThisWay(Opponent), PutExiledCardsOnTopOfLibraryIgnoreOrder(TheExiledCardChosenThisWay), Shuffle]), CastAnyNumberOfExiledCardsWithoutPaying(TheCardsExiledThisWay), ExileSpell({{~Spell}})])",
    "Search your library for {{a}} {{SpecificCard}}, put that card onto the battlefield tapped, then shuffle. {{~Spell}} deals X damage to target player or planeswalker, where X is {{GameNumber}}": "Targeted([TargetPlayerOrPermanent(AnyPlayer, IsCardtype(Planeswalker))], ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersTapped]), Shuffle]), SpellDealsDamage({{~Spell}}, {{GameNumber[0]}}, Ref_TargetPlayerOrPermanent)]))",
    "Search your library for {{a}} {{SpecificCard}}, reveal it, put it into your hand, shuffle, then discard a card at random. If an {{SpecificCard}} was discarded this way, {{~Spell}} deals {{Digits}} damage to each opponent": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle]), DiscardACardAtRandom, If(ACardWasDiscardedThisWay({{SpecificCard[1]}}), [SpellDealsDamage({{~Spell}}, {{Digits[0]}}, EachPlayer(Opponent))])])",
    "Shuffle your library, then reveal the top card. If it's a nonland card, you may cast it without paying its mana cost. If it's a land card, you may put it onto the battlefield and return {{~Spell}} to its owner's hand": "ActionList([Shuffle, RevealTopCardOfLibrary, IfElse(ACardWasRevealedThisWay(IsNonCardtype(Land)), [MayAction(CastTopCardOfLibraryWithoutPaying)], [MayAction(PutTopCardOfLibraryOfTypeOnBattlefield(IsCardtype(Land), [EntersNormally])), ReturnSpellToOwnersHand({{~Spell}})])])",
    "Shuffle {{~Spell}} and up to {{Number}} target cards from a single graveyard into their owners' libraries": "Targeted([UptoNumberTargetGroupGraveyardCards({{Number[0]}}, AnyCardInAnyGraveyard, ShareAGraveyard)], ActionList([ShuffleSpellAndGraveyardCardsIntoLibraries({{~Spell}}, Ref_TargetGraveyardCards)]))",
    "Starting with you, each player votes for Redhorn Pass or Mines of Moria. For each Redhorn Pass vote, search your library for {{a}} {{SpecificCard}} and put it onto the battlefield tapped. If you search your library this way, shuffle. For each Mines of Moria vote, return a card from your graveyard to your hand.\nExile {{~Spell}}": "ActionList([EachPlayerStartingWithAction(AnyPlayer, You, [VoteForAWord([\"Redhorn Pass\", \"Mines of Moria\"])]), If(WordWasVotedFor(\"Redhorn Pass\"), [SearchLibrary([FindNumberCardsOfType(TheNumberOfVotesForWord(\"Redhorn Pass\"), {{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersTapped]), Shuffle])]), ReturnNumberCardsFromPlayersGraveyardToHand(TheNumberOfVotesForWord(\"Mines of Moria\"), AnyCard, You), ExileSpell(ThisSpell)])",
    "Starting with you, each player votes for past or present. You mill a card for each past vote, then {{~Spell}} deals damage to each opponent equal to the total mana value of cards milled this way. Exile the top card of your library for each present vote. Until the end of your next turn, you may play the exiled cards": "ActionList([EachPlayerStartingWithAction(AnyPlayer, You, [VoteForAWord([\"Past\", \"Present\"])]), MillNumberCards(TheNumberOfVotesForWord(\"Past\")), SpellDealsDamage(ThisSpell, TotalManaValueOfMilledCards, EachPlayer(Opponent)), Exile([TheTopNumberCardsOfPlayersLibrary(TheNumberOfVotesForWord(\"Present\"), You)]), CreatePlayerEffectUntil(You, [MayPlayExiledCards(TheCardsExiledThisWay)], UntilTheEndOfPlayersNextTurn(You))])",
    "Starting with you, each player votes for return or embark. If return gets more votes, each player returns up to {{Number}} cards from their graveyard to their hand, then you exile {{~Spell}}. If embark gets more votes or the vote is tied, each player may discard their hand and draw {{Number}} cards": "ActionList([EachPlayerStartingWithAction(AnyPlayer, You, [VoteForAWord([\"Return\", \"Embark\"])]), If(MostVotesForWordIs(\"Return\"), [EachPlayerAction(AnyPlayer, PutUptoNumberCardsFromGraveyardToHand({{Number[0]}}, AnyCard)), ExileSpell({{~Spell}})]), If(MostVotesOrTiedForMostVotesForWordIs(\"Embark\"), [EachPlayerMayActions(AnyPlayer, [DiscardHand, DrawNumberCards({{Number[1]}})])])])",
    "Starting with you, each player votes for time or money. For each time vote, take an extra turn after this one. For each money vote, choose a permanent owned by the voter and gain control of it. Exile {{~Spell}}": "ActionList([EachPlayerStartingWithAction(AnyPlayer, You, [VoteForAWord([\"Time\", \"Money\"])]), TakeANumberOfExtraTurns(TheNumberOfVotesForWord(\"Time\")), ChooseAPermanentForEachPlayer(ChoseWord(\"Money\"), OwnedByAPlayer(SinglePlayer(EachablePlayer))), GainControlOfEachPermanent(ThePermanentsChosenThisWay), ExileSpell({{~Spell}})])",
    "Surveil {{Digits}}, then draw {{Number}} cards. {{~Spell}} deals {{Digits}} damage to you": "ActionList([Surveil({{Digits[0]}}), DrawNumberCards({{Number[0]}}), SpellDealsDamage({{~Spell}}, {{Digits[1]}}, Player(You))])",
    "Surveil {{Digits}}, then return {{a}} {{SpecificCard}} from your graveyard to the battlefield with {{a}} {{CounterType}} counter on it. Exile {{~Spell}} with {{Number}} {{CounterType}} counters on it": "ActionList([Surveil({{Digits[0]}}), ReturnACardFromGraveyardToBattlefield({{SpecificCard[0]}}, [EntersWithACounter({{CounterType[0]}})]), ExileSpellWithANumberOfCountersOnIt({{~Spell}}, {{Number[0]}}, {{CounterType[1]}})])",
    "Take an extra turn after this one. Exile {{~Spell}}": "ActionList([TakeAnExtraTurn, ExileSpell({{~Spell}})])",
    "Tap target {{Creature}}. That creature doesn't untap during its controller's next untap step.\nCipher": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), PermanentDoesntUntapDuringControllersNextUntap(Ref_TargetPermanent), Cipher(ThisSpell)]))",
    "Tap target {{Creature}}. {{~Spell}} deals {{Digits}} damage to that creature's controller": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Player(ControllerOfPermanent(Ref_TargetPermanent)))]))",
    "Target creature deals damage equal to its power to itself. If that creature is attacking, {{~Spell}} deals {{Digits}} damage to that creature's controller": "Targeted([TargetPermanent(IsCardtype(Creature))], ActionList([PermanentDealsDamage(Ref_TargetPermanent, PowerOfPermanent(Ref_TargetPermanent), Permanent(Ref_TargetPermanent)), If(PermanentPassesFilter(Ref_TargetPermanent, IsAttacking), [SpellDealsDamage(ThisSpell, {{Digits[0]}}, Player(ControllerOfPermanent(Ref_TargetPermanent)))])]))",
    "Target opponent chooses a card in your graveyard. You may pay {{ManaCost}}. If you do, repeat this process except that opponent can't choose a card already chosen for {{~Spell}}. Then put the last chosen card into your hand": "Targeted([TargetPlayer(Opponent)], ActionList([RepeatableActions([PlayerAction(Ref_TargetPlayer, ChooseAnUnchosenCardInPlayersGraveyard(AnyCard, You)), MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [RepeatThisProcess])]), ReturnGraveyardCardToHand(TheLastGraveyardCardChosenThisWay)]))",
    "Target opponent loses {{Digits}} life for each {{Eachable}}. {{~Spell}} deals damage to target {{Creature}} equal to {{GameNumber}}. Create {{a}} {{PT}} {{CreatureToken}} for each {{Eachable}}. You gain {{Digits}} life for each {{Eachable}}. Draw a card for each {{Eachable}}, then discard that many cards": "Targeted([TargetPlayer(Opponent), TargetPermanent({{Creature[0]}})], ActionList([PlayerAction(Ref_TargetPlayer, LoseLifeForEach({{Digits[0]}}, {{Eachable[0]}})), SpellDealsDamage({{~Spell}}, {{GameNumber[0]}}, Permanent(Ref_TargetPermanent)), CreateTokens([NumberTokens({{Eachable[1]}}, TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, []))]), GainLifeForEach({{Digits[1]}}, {{Eachable[2]}}), DrawNumberCards({{Eachable[3]}}), DiscardNumberCards(NumberOfCardsDrawnThisWay)]))",
    "Target opponent loses {{Digits}} life.\nCipher": "Targeted([TargetPlayer(Opponent)], ActionList([PlayerAction(Ref_TargetPlayer, LoseLife({{Digits[0]}})), Cipher(ThisSpell)]))",
    "Target opponent may have {{~Spell}} deal {{Digits}} damage to them. If that player doesn't, you draw {{Number}} cards": "Targeted([TargetPlayer(Opponent)], ActionList([PlayerMayCost(Ref_TargetPlayer, HaveSpellDealDamage({{~Spell}}, {{Digits[0]}}, Player(Ref_TargetPlayer))), Unless(CostWasPaid, [DrawNumberCards({{Number[0]}})])]))",
    "Target opponent reveals the top card of their library. {{~Spell}} deals damage equal to the revealed card's mana value to that player and each creature that player controls. If {{a}} {{SpecificCard}} is revealed this way, return {{~Spell}} to its owner's hand": "Targeted([TargetPlayer(Opponent)], ActionList([PlayerAction(Ref_TargetPlayer, RevealTopCardOfLibrary), SpellDealsDamage({{~Spell}}, ManaValueOfTheCardRevealedThisWay, MultipleRecipients([Player(Ref_TargetPlayer), EachPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]))])), If(ACardWasRevealedThisWay({{SpecificCard[0]}}), [ReturnSpellToOwnersHand({{~Spell}})])]))",
    "Target player discards a card.\nCipher": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, DiscardACard), Cipher(ThisSpell)]))",
    "Target player discards a card. If {{a}} {{SpecificCard}} is discarded this way, return {{~Spell}} to its owner's hand": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, DiscardACard), If(ACardWasDiscardedThisWay({{SpecificCard[0]}}), [ReturnSpellToOwnersHand({{~Spell}})])]))",
    "Target player discards {{Number}} cards at random unless that player has {{~Spell}} deal {{Digits}} damage to them": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerMayCost(Ref_TargetPlayer, HaveSpellDealDamage({{~Spell}}, {{Digits[0]}}, Player(ActionPlayer))), Unless(CostWasPaid, [PlayerAction(Ref_TargetPlayer, DiscardNumberCardsAtRandom({{Number[0]}}))])]))",
    "Target player draws X cards, {{~Spell}} deals X damage to any target, and you gain X life, where X is {{GameNumber[ThisSpell]}}": "Targeted([TargetPlayer(AnyPlayer), AnyTarget], ActionList([CreateValueX({{GameNumber[ThisSpell][0]}}), PlayerAction(Ref_TargetPlayer, DrawNumberCards(ValueX)), SpellDealsDamage(ThisSpell, ValueX, Ref_AnyTarget), GainLife(ValueX)]))",
    "Target player draws {{Number}} cards and loses {{Digits}} life.\nParadigm": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerActions(Ref_TargetPlayer, [DrawNumberCards({{Number[0]}}), LoseLife({{Digits[0]}})]), Paradigm(ThisSpell)]))",
    "Target player draws {{Number}} cards, then {{~Spell}} deals damage to that player equal to {{GameNumber(ThatPlayer)}}": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, DrawNumberCards({{Number[0]}})), SpellDealsDamage({{~Spell}}, {{GameNumber(ThatPlayer=DealsDamage_ThatPlayer)[0]}}, Player(Ref_TargetPlayer))]))",
    "Target player gains {{Digits}} life, {{~Spell}} deals {{Digits}} damage to any target, then you draw {{Number}} cards": "Targeted([TargetPlayer(AnyPlayer), AnyTarget], ActionList([PlayerAction(Ref_TargetPlayer, GainLife({{Digits[0]}})), SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Ref_AnyTarget), DrawNumberCards({{Number[0]}})]))",
    "Target player loses all poison counters. {{~Spell}} deals that much damage to that player": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, LoseAllPoisonCounters), SpellDealsDamage({{~Spell}}, NumberOfCountersRemovedThisWay, Player(Ref_TargetPlayer))]))",
    "Target player loses {{Digits}} life, discards a card, then sacrifices {{a}} {{Permanent}} of their choice.\nCipher": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, LoseLife({{Digits[0]}})), PlayerAction(Ref_TargetPlayer, DiscardACard), PlayerAction(Ref_TargetPlayer, SacrificeAPermanent({{Permanent[0]}})), Cipher(ThisSpell)]))",
    "Target player mills {{Number}} cards.\nCipher": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, MillNumberCards({{Number[0]}})), Cipher(ThisSpell)]))",
    "Target player reveals a card at random from their hand. {{~Spell}} deals damage to that player equal to that card's mana value": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerMustCost(Ref_TargetPlayer, RevealACardFromHandAtRandom), If(CostWasPaid, [SpellDealsDamage({{~Spell}}, ManaValueOfTheCardRevealedThisWay, Player(Ref_TargetPlayer))])]))",
    "Target player reveals their hand. {{~Spell}} deals damage to that player equal to the number of {{SpecificCards}} in their hand": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, RevealHand), SpellDealsDamage({{~Spell}}, TheNumberOfCardsOfTypeInPlayersHand({{SpecificCards[0]}}, Ref_TargetPlayer), Player(Ref_TargetPlayer))]))",
    "Target player reveals {{Number}} cards from their hand and you choose one of them. That player discards that card. Then if {{Condition(ThatPlayer)}}, return {{~Spell}} to its owner's hand": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, RevealANumberOfCardsFromHandAndPlayerChoosesACardToDiscard({{Number[0]}}, You)), If({{Condition(ThatPlayer=Ref_TargetPlayer)[0]}}, [ReturnSpellToOwnersHand({{~Spell}})])]))",
    "Target player sacrifices {{a}} {{Permanent}} and {{a}} {{Permanent}} of their choice. {{~Spell}} deals {{Digits}} damage to that player": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, SacrificePermanents([{{Permanent[0]}}, {{Permanent[1]}}])), SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Player(Ref_TargetPlayer))]))",
    "Target player sacrifices {{a}} {{Permanent}} of their choice. {{~Spell}} deals damage to that player equal to that permanent's mana value": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerMustCost(Ref_TargetPlayer, SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [SpellDealsDamage({{~Spell}}, ManaValueOfTheSacrificedPermanent, Player(Ref_TargetPlayer))])]))",
    "Target player takes an extra turn after this one. Return up to one target {{Permanent}} to its owner's hand. Exile {{~Spell}}": "Targeted([TargetPlayer(AnyPlayer), UptoOneTargetPermanent({{Permanent[0]}})], ActionList([PlayerAction(Ref_TargetPlayer, TakeAnExtraTurn), PutPermanentIntoItsOwnersHand(Ref_TargetPermanent), ExileSpell({{~Spell}})]))",
    "Target player takes an extra turn after this one. Shuffle {{~Spell}} into its owner's library": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, TakeAnExtraTurn), ShuffleSpellIntoLibrary({{~Spell}})]))",
    "Target {{Creature}} gains protection from the color of your choice until end of turn. Clash with an opponent. If you win, return {{~Spell}} to its owner's hand": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([ChooseAColor(AnyColor), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([Protection(FromColor(TheChosenColor))])], UntilEndOfTurn), Clash(Opponent, [ReturnSpellToOwnersHand({{~Spell}})], [DoNothing])]))",
    "Target {{Creature}} gains {{Hasable}} until end of turn. If {{Condition}}, return {{~Spell}} to its owner's hand": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), If({{Condition[0]}}, [ReturnSpellToOwnersHand({{~Spell}})])]))",
    "Target {{Creature}} gets {{PTMod}} until end of turn. Exile {{~Spell}} with {{Number}} {{CounterType}} counters on it": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), ExileSpellWithANumberOfCountersOnIt({{~Spell}}, {{Number[0]}}, {{CounterType[0]}})]))",
    "Target {{Creature}} gets {{PTMod}} until end of turn. {{~Spell}} deals {{Digits}} damage to that creature": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent))]))",
    "Target {{Creature}} gets {{PTMod}} until end of turn. {{~Spell}} deals {{Digits}} damage to that creature's controller": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Player(ControllerOfPermanent(Ref_TargetPermanent)))]))",
    "Target {{Creature}} loses {{CheckHasable}} until end of turn. {{~Spell}} deals damage to that creature equal to {{GameNumber}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [LosesAbility({{CheckHasable[0]}})], UntilEndOfTurn), SpellDealsDamage({{~Spell}}, {{GameNumber[0]}}, Player(ControllerOfPermanent(Ref_TargetPermanent)))]))",
    "Target {{Creature}} perpetually loses all abilities, then {{~Spell}} deals damage to it equal to {{GameNumber}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePerpetualPermanentEffect(Ref_TargetPermanent, [LosesAllAbilities]), SpellDealsDamage({{~Spell}}, {{GameNumber[0]}}, Permanent(Ref_TargetPermanent))]))",
    "Target {{Creature}} perpetually loses all abilities, then {{~Spell}} deals {{Digits}} damage to it": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePerpetualPermanentEffect(Ref_TargetPermanent, [LosesAllAbilities]), SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent))]))",
    "Target {{Creature}}'s controller reveals a card at random from their hand. {{~Spell}} deals damage to that creature and that player equal to the revealed card's mana value": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([PlayerAction(ControllerOfPermanent(Ref_TargetPermanent), RevealACardFromHandAtRandom), SpellDealsDamage({{~Spell}}, ManaValueOfTheCardRevealedThisWay, MultipleRecipients([Permanent(Ref_TargetPermanent), Player(ControllerOfPermanent(Ref_TargetPermanent))]))]))",
    "Target {{Permanent}} gets {{PTMod}} until end of turn if {{Condition[OtherSpellThisTurn]}}. Then it deals damage equal to its power to up to one target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}}), TargetPermanent({{Permanent[1]}})], ActionList([If({{Condition[OtherSpellThisTurn][0]}}, [CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)]), PermanentDealsDamage(Ref_TargetPermanent1, PowerOfPermanent(Ref_TargetPermanent1), Permanent(Ref_TargetPermanent2))]))",
    "The next time you would lose the game this turn, instead draw {{Number}} cards and your life total becomes {{Digits}}.\nExile {{~Spell}}": "ActionList([CreateFutureReplaceWouldLoseTheGame(NextTimePlayerWouldLoseTheGameThisTurn(You), [DrawNumberCards({{Number[0]}}), SetLifeTotal({{Digits[0]}})]), ExileSpell(ThisSpell)])",
    "The next time {{a}} {{DamageSource}} of your choice would deal damage to any target this turn, prevent that damage. If damage from {{a}} {{DamageSource}} is prevented this way, {{~Spell}} deals that much damage to the source's controller": "Targeted([AnyTarget], ActionList([ChooseADamageSource({{DamageSource[0]}}), CreateFuturePreventDamage(NextTimeDamageWouldBeDealtThisTurnBySourceToRecipient(TheChosenDamageSource, Ref_AnyTarget), [PreventThatDamage, If(DamageFromASourceWasPreventedThisWay({{DamageSource[1]}}), [SpellDealsDamage({{~Spell}}, TheAmountOfDamagePreventedThisWay, Player(WouldDealDamage_ControllerOfDamageSource))])])]))",
    "The next time {{a}} {{DamageSource}} of your choice would deal damage to you this turn, instead that source deals that much damage to you and {{~Spell}} deals that much damage to that source's controller": "ActionList([ChooseADamageSource({{DamageSource[0]}}), CreateFutureReplaceWouldDealDamage(NextTimeDamageWouldBeDealtThisTurnBySourceToRecipient(TheChosenDamageSource, Player(You)), [ContinueDealingDamage, SpellDealsDamage({{~Spell}}, WouldDealDamage_ThatMuchDamage, Player(WouldDealDamage_ControllerOfDamageSource))])])",
    "The next time {{a}} {{DamageSource}} of your choice would deal damage to you this turn, prevent that damage. If damage is prevented this way, {{~Spell}} deals that much damage to that source's controller": "ActionList([ChooseADamageSource({{DamageSource[0]}}), CreateFuturePreventDamage(NextTimeDamageWouldBeDealtThisTurnBySourceToRecipient(TheChosenDamageSource, Player(You)), [PreventThatDamage, SpellDealsDamage({{~Spell}}, TheAmountOfDamagePreventedThisWay, Player(WouldDealDamage_ControllerOfDamageSource))])])",
    "The next time {{a}} {{DamageSource}} of your choice would deal damage to you this turn, prevent that damage. When damage is prevented this way, {{~Spell}} deals that much damage to that source's controller and you draw that many cards": "ActionList([ChooseADamageSource({{DamageSource[0]}}), CreateFuturePreventDamage(NextTimeDamageWouldBeDealtThisTurnBySourceToRecipient(TheChosenDamageSource, Player(You)), [PreventThatDamage, If(DamageWasPreventedThisWay, [ReflexiveTrigger(ActionList([SpellDealsDamage({{~Spell}}, TheAmountOfDamagePreventedThisWay, Player(WouldDealDamage_ControllerOfDamageSource)), DrawNumberCards(TheAmountOfDamagePreventedThisWay)]))])])])",
    "This sorcery deals damage equal to {{GameNumber(ThatSpell)}} to any target. Then cards you own named {{NamedCard}} intensify by {{Digits}}": "Targeted([AnyTarget], ActionList([SpellDealsDamage({{~Spell}}, {{GameNumber(ThatSpell=^~Spell)[0]}}, Ref_AnyTarget), PerpetuallyIncreaseIntensityOfCardsOwnedByPlayer(IsNamed(NamedCard({{NamedCard[0]}})), You, {{Digits[0]}})]))",
    "This sorcery deals {{Digits}} damage to target {{CreatureOrPlaneswalker}}. If excess damage was dealt this way, note that excess damage, then you get a one-time boon with \"{{OneTimeBoonQuotedAbility}}\"": "Targeted([TargetPermanent({{CreatureOrPlaneswalker[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent)), If(ExcessDamageWasDealtThisWay, [NoteNumber(AmountOfExcessDamageDealtThisWay), GetOneTimeBoon({{OneTimeBoonQuotedAbility[0]}})])]))",
    "Until end of turn, whenever {{a}} {{Creature}} dies, it perpetually gains unearth {{ManaCost}}.\n{{~Spell}} deals {{Digits}} damage to each {{Permanent}}":
      "ActionList([CreateTriggerUntil(WhenACreatureOrPlaneswalkerDies({{Creature[0]}}), ActionList([CreatePerpetualGraveyardCardEffect(Trigger_ThatGraveyardCard, [AddAbility([Unearth(PayMana({{ManaCost[0]}}))])])]), UntilEndOfTurn), SpellDealsDamage(ThisSpell, {{Digits[0]}}, EachPermanent({{Permanent[0]}}))])",
    "Until end of turn, you may cast target {{SpecificCard}} from your graveyard without paying its mana cost. If that spell would be put into your graveyard, exile it instead. Exile {{~Spell}}": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([CreatePlayerEffectUntil(You, [MayCastGraveyardCardWithoutPayingIntoExile(Ref_TargetGraveyardCard)], UntilEndOfTurn), ExileSpell({{~Spell}})]))",
    "Until end of turn, {{Permanents}} gain \"When this permanent deals damage to the player who cast {{~Spell}}, sacrifice this permanent. You lose {{Digits}} life\"": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([TriggerA(WhenAPermanentDealsDamageToAPlayer(SinglePermanent(ThisPermanent), SinglePlayer(ThePlayerWhoCreatedThisAbility)), ActionList([SacrificePermanent(ThisPermanent), LoseLife({{Digits[0]}})]))])], UntilEndOfTurn)])",
    "Until the end of your next turn, whenever you cast {{a}} {{Spell}}, {{~Spell}} deals {{Digits}} damage to up to one target {{Creature}}": "ActionList([CreateTriggerUntil(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), Targeted([TargetPermanent({{Creature[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent))])), UntilTheEndOfPlayersNextTurn(You))])",
    "Until your next turn, your life total can't change and you gain protection from everything. All {{Permanents}} phase out. {{Reminder}}\nExile {{~Spell}}": "ActionList([CreatePlayerEffectUntil(You, [LifeTotalCantChange, Protection(FromEverything)], UntilPlayersNextTurn(You)), PhaseOutEachPermanent({{Permanents[0]}}), ExileSpell(ThisSpell)])",
    "Until your next turn, {{Creatures}} can't attack you. Exile {{~Spell}} with {{Number}} {{CounterType}} counters on it": "ActionList([CreateEachPermanentRuleEffectUntil({{Creatures[0]}}, [CantAttackPlayer(You)], UntilPlayersNextTurn(You)), ExileSpellWithANumberOfCountersOnIt({{~Spell}}, {{Number[0]}}, {{CounterType[0]}})])",
    "Up to one target {{Creature}} has base power and toughness {{PT}} until end of turn. Up to one other target {{Creature}} has base power and toughness {{PT}} until end of turn. Then {{~Spell}} deals {{Digits}} damage to each {{Creature}}": "Targeted([UptoOneTargetPermanent({{Creature[0]}}), UptoOneTargetPermanent(And([Other(Ref_TargetPermanent1), {{Creature[1]}}]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent1, [SetPT({{PT[0]}})], UntilEndOfTurn), CreatePermanentLayerEffectUntil(Ref_TargetPermanent2, [SetPT({{PT[1]}})], UntilEndOfTurn), SpellDealsDamage({{~Spell}}, {{Digits[0]}}, EachPermanent({{Creature[2]}}))]))",
