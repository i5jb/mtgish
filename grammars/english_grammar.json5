    "As an additional cost to cast this spell, sacrifice {{Number}} {{Permanents}}": "CastEffect(AdditionalCastingCost(SacrificeNumberPermanents({{Number[0]}}, {{Permanents[0]}})))",
    "As an additional cost to cast this spell, sacrifice {{a}} {{Permanent}}": "CastEffect(AdditionalCastingCost(SacrificeAPermanent({{Permanent[0]}})))",
