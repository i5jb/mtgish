    "Whenever equipped creature deals damage to {{a}} {{Creature}}, {{TriggerActions(ThatCreature)}}": "TriggerA(WhenAPermanentDealsDamageToAPermanent(SinglePermanent(HostPermanent), {{Creature[0]}}), {{TriggerActions(ThatCreature=Trigger_ThatOtherPermanent)[0]}})",
    "Whenever equipped creature dies, if {{Condition[WhenACreatureOrPlaneswalkerDies]}}, {{TriggerActions}}": "TriggerI(WhenACreatureOrPlaneswalkerDies(SinglePermanent(HostPermanent)), {{Condition[WhenACreatureOrPlaneswalkerDies][0]}}, {{TriggerActions[0]}})",
    "Whenever equipped creature dies, {{TriggerActions[WhenACreatureOrPlaneswalkerDies]}}": "TriggerA(WhenACreatureOrPlaneswalkerDies(SinglePermanent(HostPermanent)), {{TriggerActions[WhenACreatureOrPlaneswalkerDies][0]}})",
