    "As an additional cost to cast this spell, sacrifice {{a}} {{Permanent}} or pay {{ManaCost}}": "CastEffect(AdditionalCastingCost(Or([SacrificeAPermanent({{Permanent[0]}}), PayMana({{ManaCost[0]}})])))",
    "As an additional cost to cast this spell, sacrifice {{a}} {{Permanent}}, discard a card, or pay {{Digits}} life": "CastEffect(AdditionalCastingCost(Or([SacrificeAPermanent({{Permanent[0]}}), DiscardACard, PayLife({{Digits[0]}})])))",
    "As an additional cost to cast this spell, tap any number of {{Permanents}}": "CastEffect(AdditionalCastingCost(TapAnyNumberOfPermanents({{Permanents[0]}})))",
    "As an additional cost to cast this spell, tap {{Number}} {{Permanents}}": "CastEffect(AdditionalCastingCost(TapNumberPermanents({{Number[0]}}, {{Permanents[0]}})))",
    "As an additional cost to cast this spell, tap {{a}} {{Permanent}}": "CastEffect(AdditionalCastingCost(TapAPermanent({{Permanent[0]}})))",
    "As an additional cost to cast this spell, tap {{a}} {{Permanent}} or pay {{ManaCost}}": "CastEffect(AdditionalCastingCost(Or([TapAPermanent({{Permanent[0]}}), PayMana({{ManaCost[0]}})])))",
    "As an additional cost to cast this spell, waterbend {{ManaCost}}": "CastEffect(AdditionalCastingCost(Waterbend({{ManaCost[0]}})))",
    "As an additional cost to cast this spell, you may collect evidence {{Digits}}. This spell costs {{CostReduce}} less to cast if evidence was collected": "CastEffect(ReduceCastingCostForAlternateCost({{CostReduce[0]}}, CollectEvidence({{Digits[0]}})))",
    "As an additional cost to cast this spell, you may exile any number of creature cards from your graveyard. This spell costs {{CostReduce}} less to cast for each card exiled this way": "CastEffect(ReduceCastingCostForEachAlternateCost({{CostReduce[0]}}, Exile([AGraveyardCard(And([IsCardtype(Creature), InAPlayersGraveyard(SinglePlayer(You))]))])))",
    "As an additional cost to cast this spell, you may exile any number of {{SpecificCards}} from your hand. This spell costs {{CostReduce}} less to cast for each card exiled this way": "CastEffect(ReduceCastingCostForEachAlternateCost({{CostReduce[0]}}, ExileACardOfTypeFromHand({{SpecificCards[0]}})))",
    "As an additional cost to cast this spell, you may pay {{ManaCost}}": "CastEffect(OptionalAdditionalCastingCost(PayMana({{ManaCost[0]}})))",
    "As an additional cost to cast this spell, you may pay {{ManaCost}} any number of times": "CastEffect(OptionalAdditionalCastingCost(PayManaAnyNumberOfTimes({{ManaCost[0]}})))",
    "As an additional cost to cast this spell, you may remove any number of {{CounterType}} counters from among {{Permanents}}. This spell costs {{CostReduce}} less to cast for each counter removed this way": "CastEffect(ReduceCastingCostForEachAlternateCost({{CostReduce[0]}}, RemoveACounterOfTypeFromAPermanent({{CounterType[0]}}, {{Permanents[0]}})))",
    "As an additional cost to cast this spell, you may reveal {{a}} {{SpecificCard}} from your hand": "CastEffect(OptionalAdditionalCastingCost(RevealACardOfTypeFromHand({{SpecificCard[0]}})))",
    "As an additional cost to cast this spell, you may reveal {{a}} {{SpecificCard}} from your hand or choose {{a}} {{Permanent}}": "CastEffect(OptionalAdditionalCastingCost(Or([RevealACardOfTypeFromHand({{SpecificCard[0]}}), ChooseAPermanent({{Permanent[0]}})])))",
    "As an additional cost to cast this spell, you may reveal {{a}} {{SpecificCard}} from your hand.\nIf you revealed {{a}} {{SpecificCard}} or controlled {{a}} {{Permanent}} as you cast this spell, this spell can't be countered": "CastEffect(OptionalAdditionalCastingCost(RevealACardOfTypeFromHand({{SpecificCard[0]}}))), FromStackIf(Or([PlayerControlledAPermanentAsCast(You, {{Permanent[0]}}), PlayerRevealedACardAsCast(You, {{SpecificCard[1]}})]), ThisSpellEffect([CantBeCountered]))",
    "As an additional cost to cast this spell, you may sacrifice any number of artifacts and/or creatures. This spell costs {{CostReduce}} less to cast for each permanent sacrificed this way and {{CostReduce}} less to cast for each other artifact or creature you've sacrificed this turn": "CastEffect(ReduceCastingCostForEachAlternateCost({{CostReduce[0]}}, SacrificeAPermanent(Or([IsCardtype(Creature), IsCardtype(Artifact)])))), CastEffect(ReduceCastingCostForEach({{CostReduce[1]}}, NumberOfPermanentsSacrificedByPlayerThisTurn(Or([IsCardtype(Artifact), IsCardtype(Creature)]), You)))",
    "As an additional cost to cast this spell, you may sacrifice any number of creatures. This spell costs {{CostReduce}} less to cast for each creature sacrificed this way": "CastEffect(ReduceCastingCostForEachAlternateCost({{CostReduce[0]}}, SacrificeAPermanent(IsCardtype(Creature))))",
    "As an additional cost to cast this spell, you may sacrifice any number of nonland permanents. This spell costs {{CostReduce}} less to cast for each permanent sacrificed this way": "CastEffect(ReduceCastingCostForEachAlternateCost({{CostReduce[0]}}, SacrificeAPermanent(And([IsNonCardtype(Land), IsPermanent]))))",
    "As an additional cost to cast this spell, you may sacrifice any number of {{Permanents}}": "CastEffect(OptionalAdditionalCastingCost(SacrificeAnyNumberOfPermanents({{Permanents[0]}})))",
    "As an additional cost to cast this spell, you may sacrifice one or more creatures. When you do, copy this spell for each creature sacrificed this way": "CastEffect(OptionalAdditionalCastingCostForReflexiveTrigger(SacrificeAnyNumberOfPermanents(IsCardtype(Creature)), ActionList([CopySpellForEach(ThisSpell, TheNumberOfPermanentsSacrificedThisWay)])))",
    "As an additional cost to cast this spell, you may sacrifice {{a}} {{Permanent}}": "CastEffect(OptionalAdditionalCastingCost(SacrificeAPermanent({{Permanent[0]}})))",
    "As an additional cost to cast this spell, you may tap any number of untapped creatures you control. This spell costs {{CostReduce}} less to cast for each creature tapped this way": "CastEffect(ReduceCastingCostForEachAlternateCost({{CostReduce[0]}}, TapAPermanent(And([IsUntapped, IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))))"
  },
  "{{AlternateCostX}}": {
    "You may exile {{a}} {{Black}} card with mana value X from your hand rather than pay this spell's mana cost": "CastEffect(AlternateCastingCost(ExileACardOfTypeFromHand(And([IsColor({{Black[0]}}), ManaValueIs(EqualTo(ValueX))]))))"
  },
  "{{AlternateCost[ProvideManaCost]}}": {
    "As long as you've discarded a card this turn, you may pay {{ManaCost}} to cast this spell": "CastEffect(AlternateCastingCostIf(PayMana({{ManaCost[0]}}), PlayerPassesFilter(You, DiscardedACardThisTurn)))"
  },
  "{{AlternateCost}}": {
    "If {{Condition}}, rather than pay this spell's mana cost, you may have an opponent gain {{Digits}} life": "CastEffect(AlternateCastingCostIf(HaveAPlayerTakeAction(Opponent, GainLife({{Digits[0]}})), {{Condition[0]}}))",
    "If {{Condition}}, rather than pay this spell's mana cost, you may have each other player gain {{Digits}} life": "CastEffect(AlternateCastingCostIf(HaveEachPlayerTakeAction(Other(You), GainLife({{Digits[0]}})), {{Condition[0]}}))",
    "If {{Condition}}, you may exile {{a}} {{SpecificCard}} from your hand rather than pay this spell's mana cost": "CastEffect(AlternateCastingCostIf(ExileACardOfTypeFromHand({{SpecificCard[0]}}), {{Condition[0]}}))",
    "If {{Condition}}, you may pay {{Digits}} life rather than pay this spell's mana cost": "CastEffect(AlternateCastingCostIf(PayLife({{Digits[0]}}), {{Condition[0]}}))",
    "If {{Condition}}, you may pay {{ManaCost}} rather than pay this spell's mana cost": "CastEffect(AlternateCastingCostIf(PayMana({{ManaCost[0]}}), {{Condition[0]}}))",
    "If {{Condition}}, you may reveal your hand rather than pay this spell's mana cost": "CastEffect(AlternateCastingCostIf(RevealHand, {{Condition[0]}}))",
    "If {{Condition}}, you may sacrifice {{a}} {{Permanent}} rather than pay this spell's mana cost": "CastEffect(AlternateCastingCostIf(SacrificeAPermanent({{Permanent[0]}}), {{Condition[0]}}))",
    "If {{Condition}}, you may tap {{a}} {{Permanent}} rather than pay this spell's mana cost": "CastEffect(AlternateCastingCostIf(TapAPermanent({{Permanent[0]}}), {{Condition[0]}}))",
    "You may discard a {{Swamp}} card rather than pay this spell's mana cost": "CastEffect(AlternateCastingCost(DiscardACardOfType(IsLandType({{Swamp[0]}}))))",
    "You may discard {{a}} {{SpecificCard}} and another card rather than pay this spell's mana cost": "CastEffect(AlternateCastingCost(And([DiscardACardOfType({{SpecificCard[0]}}), DiscardACard])))",
    "You may exile the top {{Number}} {{SpecificCards}} of your graveyard rather than pay this spell's mana cost": "CastEffect(AlternateCastingCost(ExileEachGraveyardCard(TheTopNumberCardsOfTypeInPlayersGraveyard({{Number[0]}}, {{SpecificCards[0]}}, You))))",
    "You may exile {{Number}} {{SpecificCards}} from your hand rather than pay this spell's mana cost": "CastEffect(AlternateCastingCost(ExileNumberCardsOfTypeFromHand({{Number[0]}}, {{SpecificCards[0]}})))",
    "You may exile {{a}} {{SpecificCard}} from your hand rather than pay this spell's mana cost": "CastEffect(AlternateCastingCost(ExileACardOfTypeFromHand({{SpecificCard[0]}})))",
    "You may pay {{Digits}} life and exile {{a}} {{SpecificCard}} from your hand rather than pay this spell's mana cost": "CastEffect(AlternateCastingCost(And([PayLife({{Digits[0]}}), ExileACardOfTypeFromHand({{SpecificCard[0]}})])))",
    "You may pay {{Digits}} life and sacrifice {{Number}} {{Permanents}} rather than pay this spell's mana cost": "CastEffect(AlternateCastingCost(And([PayLife({{Digits[0]}}), SacrificeNumberPermanents({{Number[0]}}, {{Permanents[0]}})])))",
    "You may pay {{ManaCost}} and exile {{a}} {{SpecificCard}} from your graveyard rather than pay this spell's mana cost": "CastEffect(AlternateCastingCost(And([PayMana({{ManaCost[0]}}), Exile([AGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))])])))",
    "You may pay {{ManaCost}} and return {{a}} {{Permanent}} to its owner's hand rather than pay this spell's mana cost": "CastEffect(AlternateCastingCost(And([PayMana({{ManaCost[0]}}), PutAPermanentIntoItsOwnersHand({{Permanent[0]}})])))",
    "You may pay {{ManaCost}} and tap {{Number}} {{Permanents}} rather than pay this spell's mana cost": "CastEffect(AlternateCastingCost(And([PayMana({{ManaCost[0]}}), TapNumberPermanents({{Number[0]}}, {{Permanents[0]}})])))",
    "You may pay {{ManaCost}} and tap {{a}} {{Permanent}} rather than pay this spell's mana cost": "CastEffect(AlternateCastingCost(And([PayMana({{ManaCost[0]}}), TapAPermanent({{Permanent[0]}})])))",
    "You may pay {{ManaCost}} rather than pay this spell's mana cost": "CastEffect(AlternateCastingCost(PayMana({{ManaCost[0]}})))",
    "You may pay {{ManaCost}} rather than pay this spell's mana cost if {{Condition}}": "CastEffect(AlternateCastingCostIf(PayMana({{ManaCost[0]}}), {{Condition[0]}}))",
    "You may pay {{ManaCost}} rather than pay this spell's mana cost. Spend only mana produced by Treasures to cast it this way": "CastEffect(AlternateCastingCost(PayMana_OnlyProducedByTreasure({{ManaCost[0]}})))",
    "You may return {{Number}} {{Permanents}} to their owner's hand rather than pay this spell's mana cost": "CastEffect(AlternateCastingCost(PutNumberPermanentsIntoOwnersHand({{Number[0]}}, {{Permanents[0]}})))",
    "You may return {{a}} {{Permanent}} to its owner's hand rather than pay this spell's mana cost": "CastEffect(AlternateCastingCost(PutAPermanentIntoItsOwnersHand({{Permanent[0]}})))",
    "You may sacrifice {{Number}} {{Permanents}} rather than pay this spell's mana cost": "CastEffect(AlternateCastingCost(SacrificeNumberPermanents({{Number[0]}}, {{Permanents[0]}})))",
    "You may sacrifice {{a}} {{Permanent}} rather than pay this spell's mana cost": "CastEffect(AlternateCastingCost(SacrificeAPermanent({{Permanent[0]}})))",
    "You may tap {{Number}} {{Permanents}} rather than pay this spell's mana cost": "CastEffect(AlternateCastingCost(TapNumberPermanents({{Number[0]}}, {{Permanents[0]}})))"
  },
  "{{ArtifactCard}}": {
    "Equipment card": "IsArtifactType(Equipment)",
    "Equipment card with mana value {{Digits}}": "And([IsArtifactType(Equipment), ManaValueIs(EqualTo({{Digits[0]}}))])",
    "Equipment or Vehicle card": "Or([IsArtifactType(Equipment), IsArtifactType(Vehicle)])",
    "Vehicle card": "IsArtifactType(Vehicle)",
    "artifact card": "IsCardtype(Artifact)",
    "artifact card with a mana ability": "And([IsCardtype(Artifact), HasAbility(ManaAbility)])",
    "artifact card with mana cost {{ManaCost}} or {{ManaCost}}": "And([IsCardtype(Artifact), Or([ManaCostIs({{ManaCost[0]}}), ManaCostIs({{ManaCost[1]}})])])",
    "artifact card with mana value less than or equal to {{GameNumber}}": "And([IsCardtype(Artifact), ManaValueIs(LessThanOrEqualTo({{GameNumber[0]}}))])",
    "artifact card with mana value {{Digits}}": "And([IsCardtype(Artifact), ManaValueIs(EqualTo({{Digits[0]}}))])",
    "artifact card with mana value {{Digits}} or greater": "And([IsCardtype(Artifact), ManaValueIs(GreaterThanOrEqualTo({{Digits[0]}}))])",
    "artifact card with mana value {{Digits}} or less": "And([IsCardtype(Artifact), ManaValueIs(LessThanOrEqualTo({{Digits[0]}}))])",
    "artifact card with mana value {{Digits}} or {{Digits}}": "And([IsCardtype(Artifact), Or([ManaValueIs(EqualTo({{Digits[0]}})), ManaValueIs(EqualTo({{Digits[1]}}))])])",
    "legendary artifact card": "And([IsSupertype(Legendary), IsCardtype(Artifact)])",
    "noncreature artifact card": "And([IsNonCardtype(Creature), IsCardtype(Artifact)])",
    "noncreature artifact card with mana value {{Digits}} or less": "And([IsNonCardtype(Creature), IsCardtype(Artifact), ManaValueIs(LessThanOrEqualTo({{Digits[0]}}))])",
    "nonland artifact card": "And([IsNonCardtype(Land), IsCardtype(Artifact)])"
  },
  "{{ArtifactOrCreature}}": {
    "artifact or creature": "Or([IsCardtype(Artifact), IsCardtype(Creature)])",
    "artifact or creature an opponent controls": "And([Or([IsCardtype(Artifact), IsCardtype(Creature)]), ControlledByAPlayer(Opponent)])",
    "artifact or creature an opponent controls with mana value {{Digits}} or less": "And([Or([IsCardtype(Artifact), IsCardtype(Creature)]), ControlledByAPlayer(Opponent), ManaValueIs(LessThanOrEqualTo({{Digits[0]}}))])",
    "artifact or creature with mana value {{Digits}} or greater": "And([Or([IsCardtype(Artifact), IsCardtype(Creature)]), ManaValueIs(GreaterThanOrEqualTo({{Digits[0]}}))])",
    "artifact or creature you control": "And([Or([IsCardtype(Artifact), IsCardtype(Creature)]), ControlledByAPlayer(SinglePlayer(You))])",
    "artifact or creature you don't control": "And([Or([IsCardtype(Artifact), IsCardtype(Creature)]), ControlledByAPlayer(Other(You))])",
    "artifact or tapped creature": "Or([IsCardtype(Artifact), And([IsTapped, IsCardtype(Creature)])])",
    "creature or Food": "Or([IsCardtype(Creature), IsArtifactType(Food)])",
    "creature or artifact you control": "And([Or([IsCardtype(Creature), IsCardtype(Artifact)]), ControlledByAPlayer(SinglePlayer(You))])",
    "legendary artifact or legendary creature": "Or([And([IsSupertype(Legendary), IsCardtype(Artifact)]), And([IsSupertype(Legendary), IsCardtype(Creature)])])",
    "nontoken artifact or creature you control": "And([IsNonToken, Or([IsCardtype(Artifact), IsCardtype(Creature)]), ControlledByAPlayer(SinglePlayer(You))])",
    "nontoken creature or artifact you control": "And([IsNonToken, Or([IsCardtype(Creature), IsCardtype(Artifact)]), ControlledByAPlayer(SinglePlayer(You))])",
    "untapped artifact or creature you control": "And([IsUntapped, Or([IsCardtype(Artifact), IsCardtype(Creature)]), ControlledByAPlayer(SinglePlayer(You))])"
  },
  "{{Artifacts}}": {
    "Incubator tokens you control": "And([IsArtifactType(Incubator), IsToken, ControlledByAPlayer(SinglePlayer(You))])",
    "Artifacts": "IsCardtype(Artifact)",
    "Artifacts you control": "And([IsCardtype(Artifact), ControlledByAPlayer(SinglePlayer(You))])",
    "Artifacts your opponents control": "And([IsCardtype(Artifact), ControlledByAPlayer(Opponent)])",
    "Blood tokens": "And([IsArtifactType(Blood), IsToken])",
    "Blood tokens you control": "And([IsArtifactType(Blood), IsToken, ControlledByAPlayer(SinglePlayer(You))])",
    "Clues": "IsArtifactType(Clue)",
    "Clues you control": "And([IsArtifactType(Clue), ControlledByAPlayer(SinglePlayer(You))])",
    "Equipment": "IsArtifactType(Equipment)",
    "Equipment named {{NamedCard}}, {{NamedCard}}, and {{NamedCard}}": "And([IsArtifactType(Equipment), Or([IsNamed(NamedCard({{NamedCard[0]}})), IsNamed(NamedCard({{NamedCard[1]}})), IsNamed(NamedCard({{NamedCard[2]}}))])])",
    "Equipment you control": "And([IsArtifactType(Equipment), ControlledByAPlayer(SinglePlayer(You))])",
    "Foods": "IsArtifactType(Food)",
    "Foods you control": "And([IsArtifactType(Food), ControlledByAPlayer(SinglePlayer(You))])",
    "Noncreature, non-Equipment artifacts you control": "And([IsNonCardtype(Creature), IsNonArtifactType(Equipment), IsCardtype(Artifact), ControlledByAPlayer(SinglePlayer(You))])",
    "Nontoken artifacts you control": "And([IsNonToken, IsCardtype(Artifact), ControlledByAPlayer(SinglePlayer(You))])",
    "Treasures": "IsArtifactType(Treasure)",
    "Treasures you control": "And([IsArtifactType(Treasure), ControlledByAPlayer(SinglePlayer(You))])",
    "Vehicles": "IsArtifactType(Vehicle)",
    "Vehicles you control": "And([IsArtifactType(Vehicle), ControlledByAPlayer(SinglePlayer(You))])",
    "artifact tokens": "And([IsCardtype(Artifact), IsToken])",
    "artifact tokens you control": "And([IsCardtype(Artifact), IsToken, ControlledByAPlayer(SinglePlayer(You))])",
    "artifacts": "IsCardtype(Artifact)",
    "artifacts with mana value {{Digits}} or less": "And([IsCardtype(Artifact), ManaValueIs(LessThanOrEqualTo({{Digits[0]}}))])",
    "artifacts without mana abilities": "And([IsCardtype(Artifact), DoesntHaveAbility(ManaAbility)])",
    "artifacts you control": "And([IsCardtype(Artifact), ControlledByAPlayer(SinglePlayer(You))])",
    "artifacts you don't control": "And([IsCardtype(Artifact), ControlledByAPlayer(Other(You))])",
    "artifacts your opponents control": "And([IsCardtype(Artifact), ControlledByAPlayer(Opponent)])",
    "noncreature artifacts": "And([IsNonCardtype(Creature), IsCardtype(Artifact)])",
    "noncreature artifacts you control": "And([IsNonCardtype(Creature), IsCardtype(Artifact), ControlledByAPlayer(SinglePlayer(You))])",
    "nontoken artifacts": "And([IsNonToken, IsCardtype(Artifact)])",
    "nontoken artifacts you control": "And([IsNonToken, IsCardtype(Artifact), ControlledByAPlayer(SinglePlayer(You))])",
    "untapped Foods you control": "And([IsUntapped, IsArtifactType(Food), ControlledByAPlayer(SinglePlayer(You))])",
    "untapped artifacts you control": "And([IsUntapped, IsCardtype(Artifact), ControlledByAPlayer(SinglePlayer(You))])",
    "untapped nontoken artifacts you control": "And([IsUntapped, IsNonToken, IsCardtype(Artifact), ControlledByAPlayer(SinglePlayer(You))])"
  },
  "{{Artifact}}": {
    "Incubator token you control": "And([IsArtifactType(Incubator), IsToken, ControlledByAPlayer(SinglePlayer(You))])",
    "Attraction": "IsArtifactType(Attraction)",
    "Blood token": "And([IsArtifactType(Blood), IsToken])",
    "Blood token you control": "And([IsArtifactType(Blood), IsToken, ControlledByAPlayer(SinglePlayer(You))])",
    "Clue": "IsArtifactType(Clue)",
