    "Whenever {{a}} {{Creature}} deals combat damage to a player, if {{Condition(ThatPermanent)}}, {{TriggerActions}}": "TriggerI(WhenACreatureDealsCombatDamageToAPlayer({{Creature[0]}}, AnyPlayer), {{Condition(ThatPermanent=Trigger_ThatCreature)[0]}}, {{TriggerActions[0]}})",
    "Whenever {{a}} {{Creature}} deals combat damage to a player, {{TriggerActions(~Permanent)}}": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer({{Creature[0]}}, AnyPlayer), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
