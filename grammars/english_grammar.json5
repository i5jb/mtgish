    "Until end of turn, other {{Creatures}} get {{PTMod}} and gain {{Hasable}} and {{Hasable}}": "ActionList([CreateEachPermanentLayerEffectUntil(And([Other({{ThatPermanent}}), {{Creatures[0]}}]), [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)])",
    "Up to one other target {{Permanent}} gains your choice of {{Hasable}}, {{Hasable}}, or {{Hasable}} until end of turn": "Targeted([UptoOneTargetPermanent(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))], ActionList([ChooseAnAbility([{{Hasable[0]}}, {{Hasable[0]}}, {{Hasable[0]}}]), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbilityVariable(TheChosenAbility)], UntilEndOfTurn)]))",
    "You gain life equal to its power": "ActionList([GainLife(PowerOfPermanent({{ThatPermanent}}))])",
    "You gain life equal to {{GameNumber(ThatPermanent)}}": "ActionList([GainLife({{GameNumber(ThatPermanent=^ThatPermanent)[0]}})])",
    "You may sacrifice another {{Permanent}}. If you do, draw {{Number}} cards, then draw another card if the sacrificed permanent was a commander": "ActionList([MayCost(SacrificeAPermanent(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))), If(CostWasPaid, [DrawNumberCards({{Number[0]}}), If(APermanentWasSacrificedThisWay(IsACommander), [DrawACard])])])",
    "You may sacrifice another {{Permanent}}. If you do, you gain {{Digits}} life and draw a card": "ActionList([MayCost(SacrificeAPermanent(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))), If(CostWasPaid, [GainLife({{Digits[0]}}), DrawACard])])"
  },
  "{{ActivatedActions(ThatPermanent,X)}}": {
    "It deals X damage to any target": "Targeted([AnyTarget], ActionList([PermanentDealsDamage({{ThatPermanent}}, {{X}}, Ref_AnyTarget)]))",
    "It deals X damage to target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([PermanentDealsDamage({{ThatPermanent}}, {{X}}, Permanent(Ref_TargetPermanent))]))"
  },
  "{{ActivatedActions(X)}}": {
    "Add X mana in any combination of colors": "ActionList([AddCombinationMana(AnyManaColor, {{X}})])",
    "Add X mana in any combination of colors. Spend this mana only to cast {{PotentialSpells}} or activate abilities of {{Permanents}}": "ActionList([AddCombinationManaWithModifers(AnyManaColor, {{X}}, Or([CanOnlySpendOnSpells({{PotentialSpells[0]}}), CanOnlySpendToActivateAbilitiesOfPermanents({{Permanents[0]}})]))])",
    "Add X mana in any combination of {{ManaProduceSymbol}} and/or {{ManaProduceSymbol}}": "ActionList([AddCombinationMana(Or([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}]), {{X}})])",
    "Add X mana of any one color": "ActionList([AddManaRepeated(AnyManaColor, {{X}})])",
    "Add X mana of any one color. You gain X life": "ActionList([AddManaRepeated(AnyManaColor, {{X}}), GainLife({{X}})])",
    "Add an amount of {{ManaProduceSymbol}} equal to X plus one": "ActionList([AddManaRepeated({{ManaProduceSymbol[0]}}, Plus({{X}}, Integer(1)))])",
    "Amass Orcs X": "ActionList([Amass({{X}}, Orc)])",
    "Choose a card name. Target opponent reveals X cards at random from their hand. Then that player discards all cards with that name revealed this way": "Targeted([TargetPlayer(Opponent)], ActionList([ChooseACardName(AnyOracleCard), PlayerAction(Ref_TargetPlayer, RevealNumberCardsFromHandAtRandomAndDiscardEachCardOfType({{X}}, IsNamed(TheChosenName)))]))",
    "Choose a color. Target opponent exiles the top X cards of their library. For each card of the chosen color exiled this way, create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}}": "Targeted([TargetPlayer(Opponent)], ActionList([ChooseAColor(AnyColor), PlayerAction(Ref_TargetPlayer, ExileTheTopNumberCardsOfLibrary({{X}})), CreateTokens([NumberTokens(TheNumberOfLibraryCardsOfTypeExiledThisWay(IsColor(TheChosenColor)), TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}]))])]))",
    "Choose a creature type. Until end of turn, creatures you control of the chosen type have base power and toughness {{PTX}} and gain all creature types": "ActionList([ChooseACreatureType, CreateEachPermanentLayerEffectUntil(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), IsCreatureTypeVariable(TheChosenCreatureType)]), [SetPT(PTX({{PTX[0]}}, {{X}})), HasAllCreatureTypes], UntilEndOfTurn)])",
    "Copy target instant or sorcery spell you control with mana value X. You may choose new targets for the copy": "Targeted([TargetSpell(And([Or([IsCardtype(Instant), IsCardtype(Sorcery)]), ControlledByAPlayer(SinglePlayer(You)), ManaValueIs(EqualTo({{X}}))]))], ActionList([CopySpellAndMayChooseNewTargets(Ref_TargetSpell)]))",
    "Counter target {{Spell}} unless its controller pays {{ManaCostX}}": "Targeted([TargetSpell({{Spell[0]}})], ActionList([PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), PayManaX({{ManaCostX[0]}}, {{X}})), Unless(CostWasPaid, [CounterSpell(Ref_TargetSpell)])]))",
    "Counter target {{Spell}} with mana value X": "Targeted([TargetSpell(And([{{Spell[0]}}, ManaValueIs(EqualTo({{X}}))]))], ActionList([CounterSpell(Ref_TargetSpell)]))",
    "Create X Treasure tokens": "ActionList([CreateTokens([NumberTokens({{X}}, TreasureToken)])])",
    "Create X {{PT}} {{CreatureTokens}}": "ActionList([CreateTokens([NumberTokens({{X}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])])",
    "Create X {{PT}} {{CreatureTokens}} with \"{{TokenQuotedAbility}}\"": "ActionList([CreateTokens([NumberTokens({{X}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{TokenQuotedAbility[0]}}]))])])",
    "Create X {{PT}} {{CreatureTokens}} with {{Hasable}}": "ActionList([CreateTokens([NumberTokens({{X}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}]))])])",
    "Create a token that's a copy of a random creature card with mana value X": "ActionList([CreateTokens([TokenCopyOfACardAtRandom(And([IsCardtype(Creature), ManaValueIs(EqualTo({{X}}))]))])])",
    "Create a token that's a copy of {{a}} {{SpecificCard}} with mana value X chosen at random": "ActionList([CreateTokens([TokenCopyOfACardAtRandom(And([{{SpecificCard[0]}}, ManaValueIs(EqualTo({{X}}))]))])])",
    "Create {{a}} {{PTX}} {{CreatureToken}}": "ActionList([CreateTokens([TokenWithPT(PTX({{PTX[0]}}, {{X}}), {{CreatureToken[0]}}, [])])])",
