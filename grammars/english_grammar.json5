    "you may have target {{Artifact}} become {{a}} {{PT}} artifact creature. If you do, put {{Number}} {{CounterType}} counters on it": "Targeted([TargetPermanent({{Artifact[0]}})], ActionList([MayCost(CreatePermanentLayerEffect(Ref_TargetPermanent, [SetPT({{PT[0]}}), AddCardtype(Artifact), AddCardtype(Creature)])), If(CostWasPaid, [PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[0]}}, Ref_TargetPermanent)])]))",
    "you may have target {{Creature}} get {{PTModX}} until end of turn, where X is {{GameNumber}}. If you do, sacrifice that creature at the beginning of the next end step": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([MayCost(CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTX({{PTModX[0]}}, {{GameNumber[0]}})], UntilEndOfTurn)), If(CostWasPaid, [CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([SacrificePermanent(Ref_TargetPermanent)]))])]))",
    "you may have target {{Creature}} get {{PTMod}} and gain {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([MayAction(CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn))]))",
    "you may have target {{Creature}} get {{PTMod}} and gain {{Hasable}} until end of turn. If you do, sacrifice it at the beginning of the next end step": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([MayCost(CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)), If(CostWasPaid, [CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([SacrificePermanent(Ref_TargetPermanent)]))])]))",
    "you may have target {{Creature}} get {{PTMod}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([MayAction(CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn))]))",
    "you may have target {{Land}} become {{a}} {{PT}} {{Zombie}} creature with {{Hasable}} until end of turn. It's still a land": "Targeted([TargetPermanent({{Land[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [SetPT({{PT[0]}}), AddCreatureType({{Zombie[0]}}), AddCardtype(Creature), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "you may have target {{Permanent}} gain {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([MayAction(CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn))]))",
    "you may have target {{Permanent}} lose {{CheckHasable}} until end of turn": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([MayAction(CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [LosesAbility({{CheckHasable[0]}})], UntilEndOfTurn))]))",
    "you may have two target players exchange life totals": "Targeted([NumberTargetPlayers(Integer(2), AnyPlayer)], ActionList([PlayersExchangeLifeTotals(Ref_TargetPlayers_0, Ref_TargetPlayers_1)]))",
    "you may have your life total become {{Digits}}": "ActionList([MayAction(SetLifeTotal({{Digits[0]}}))])",
    "you may have your life total become {{GameNumber}}": "ActionList([MayAction(SetLifeTotal({{GameNumber[0]}}))])",
    "you may have {{Artifacts}} become {{PT}} {{Zombie}} {{Zombie}} artifact creatures in addition to their other types until end of turn": "ActionList([MayAction(CreateEachPermanentLayerEffectUntil({{Artifacts[0]}}, [SetPT({{PT[0]}}), AddCreatureType({{Zombie[0]}}), AddCreatureType({{Zombie[1]}}), AddCardtype(Artifact), AddCardtype(Creature)], UntilEndOfTurn))])",
    "you may have {{Creatures}} get {{PTMod}} until end of turn": "ActionList([MayAction(CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn))])",
    "you may have {{EnchantedPermanent}} fight target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([MayAction(Fight(HostPermanent, Ref_TargetPermanent))]))",
    "you may have {{Permanents}} gain {{Hasable}} until end of turn": "ActionList([MayAction(CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn))])",
    "you may investigate": "ActionList([MayAction(Investigate)])",
    "you may look at the top card of target opponent's library. If you do, you may put that card on the bottom of that player's library": "Targeted([TargetPlayer(Opponent)], ActionList([MayCost(LookAtTheTopCardOfPlayersLibrary(Ref_TargetPlayer)), If(CostWasPaid, [MayAction(PutTheTopCardOfPlayersLibraryOnTheBottomOfTheirLibrary(Ref_TargetPlayer))])]))",
    "you may look at the top card of your library. You may cast it without paying its mana cost if it's {{a}} {{PotentialSpell}}": "ActionList([MayCost(LookAtTopOfLibrary), If(CostWasPaid, [MayAction(CastTopSpellOfLibraryWithoutPaying({{PotentialSpell[0]}}))])])",
    "you may look at the top {{Number}} cards of your library, then put them back in any order": "ActionList([MayAction(LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [PutTheRemainingCardsOnTopOfLibraryInAnyOrder]))])",
    "you may look at the top {{Number}} cards of your library. If you do, reveal any number of {{SpecificCards}} from among them, then put those cards on top of your library in any order and the rest on the bottom in any order": "ActionList([MayAction(LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [MayRevealAnyNumberOfCardsOfTypeAndPutOnTopOfLibraryInAnyOrder({{SpecificCards[0]}}), PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder]))])",
    "you may look at the top {{Number}} cards of your library. If you do, reveal up to one {{SpecificCard}} from among them, then put that card on top of your library and the rest on the bottom in a random order": "ActionList([MayAction(LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [MayRevealACardOfTypeAndPutOnTopOfLibrary({{SpecificCard[0]}}), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder]))])",
    "you may look at the top {{Number}} cards of your library. If you do, reveal up to one {{SpecificCard}} from among them, then put that card on top of your library and the rest on the bottom in any order": "ActionList([MayAction(LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [MayRevealACardOfTypeAndPutOnTopOfLibrary({{SpecificCard[0]}}), PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder]))])",
