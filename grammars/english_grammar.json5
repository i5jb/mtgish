    "seek {{Number}} {{SpecificCards}}. Choose one of those cards and shuffle the rest into your library": "ActionList([SeekNumberCards({{Number[0]}}, {{SpecificCards[0]}}), ChooseACardInHand(TheCardsSeekedThisWay), ShuffleCardsFromHandIntoLibrary(And([Other(TheChosenCardInHand), TheCardsSeekedThisWay]))])",
    "seek {{a}} {{SpecificCard}}": "ActionList([SeekACard({{SpecificCard[0]}})])",
