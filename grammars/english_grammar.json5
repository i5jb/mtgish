    "Prevent all combat damage that would be dealt to and dealt by target {{Creature}} this turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePreventDamageUntil(Or([CombatDamageWouldBeDealtByCreature(Ref_TargetPermanent), CombatDamageWouldBeDealtToRecipient(Permanent(Ref_TargetPermanent))]), [PreventThatDamage], UntilEndOfTurn)]))",
    "Prevent all combat damage {{Creatures}} and {{Creatures}} would deal this turn": "ActionList([CreatePreventDamageUntil(CombatDamageWouldBeDealtByACreature(Or([{{Creatures[0]}}, {{Creatures[1]}}])), [PreventThatDamage], UntilEndOfTurn)])",
    "Prevent all combat damage {{a}} {{Permanent}} of your choice would deal this turn": "ActionList([ChooseAPermanent({{Permanent[0]}}), CreatePreventDamageUntil(CombatDamageWouldBeDealtByCreature(TheChosenPermanent), [PreventThatDamage], UntilEndOfTurn)])",
    "Prevent all damage target {{Creature}} would deal this turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePreventDamageUntil(DamageWouldBeDealtByPermanent(Ref_TargetPermanent), [PreventThatDamage], UntilEndOfTurn)]))",
    "Prevent all damage target {{Spell}} would deal this turn": "Targeted([TargetSpell({{Spell[0]}})], ActionList([CreatePreventDamageUntil(DamageWouldBeDealtBySpell(Ref_TargetSpell), [PreventThatDamage], UntilEndOfTurn)]))",
    "Prevent all damage that would be dealt by target {{Spell}} this turn": "Targeted([TargetSpell({{Spell[0]}})], ActionList([CreatePreventDamageUntil(DamageWouldBeDealtBySpell(Ref_TargetSpell), [PreventThatDamage], UntilEndOfTurn)]))",
    "Prevent all damage that would be dealt this turn by target {{Creature}}. That creature gets {{PTModX}} until end of turn, where X is its mana value": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePreventDamageUntil(DamageWouldBeDealtByPermanent(Ref_TargetPermanent), [PreventThatDamage], UntilEndOfTurn), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTX({{PTModX[0]}}, ManaValueOfPermanent(ActionPermanent))], UntilEndOfTurn)]))",
    "Prevent all damage that would be dealt to target player or planeswalker this turn by sources of the color of your choice": "Targeted([TargetPlayerOrPermanent(AnyPlayer, IsCardtype(Planeswalker))], ActionList([ChooseAColor(AnyColor), CreatePreventDamageUntil(DamageWouldBeDealtByASourceToRecipient(IsColor(TheChosenColor), Ref_TargetPlayerOrPermanent), [PreventThatDamage], UntilEndOfTurn)]))",
    "Prevent all damage that would be dealt to target {{Permanent}} this turn": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePreventDamageUntil(DamageWouldBeDealtToRecipient(Permanent(Ref_TargetPermanent)), [PreventThatDamage], UntilEndOfTurn)]))",
    "Prevent all damage that would be dealt to you this turn by a source of your choice": "ActionList([ChooseADamageSource(AnyDamageSource), CreatePreventDamageUntil(DamageWouldBeDealtBySourceToRecipient(TheChosenDamageSource, Player(You)), [PreventThatDamage], UntilEndOfTurn)])",
    "Prevent all damage that would be dealt to you this turn by {{Permanents}}": "ActionList([CreatePreventDamageUntil(DamageWouldBeDealtToRecipient(Player(You)), [PreventThatDamage], UntilEndOfTurn)])",
    "Prevent all damage {{a}} {{DamageSource}} of your choice would deal this turn": "ActionList([ChooseADamageSource({{DamageSource[0]}}), CreatePreventDamageUntil(DamageWouldBeDealtBySource(TheChosenDamageSource), [PreventThatDamage], UntilEndOfTurn)])",
    "Prevent all damage {{a}} {{DamageSource}} of your choice would deal to you this turn": "ActionList([ChooseADamageSource({{DamageSource[0]}}), CreatePreventDamageUntil(DamageWouldBeDealtBySourceToRecipient(TheChosenDamageSource, Player(You)), [PreventThatDamage], UntilEndOfTurn)])",
    "Prevent the next X damage that would be dealt to target {{Creature}} this turn, where X is {{GameNumber}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreateFuturePreventDamage(NextAmountOfDamageThatWouldBeDealtThisTurnToRecipient({{GameNumber[0]}}, Permanent(Ref_TargetPermanent)), [PreventThatDamage])]))",
    "Prevent the next {{Digits}} combat damage that would be dealt to you this turn": "ActionList([CreateFuturePreventDamage(NextAmountOfDamageThatWouldBeDealtThisTurnToRecipient({{Digits[0]}}, Player(You)), [PreventThatDamage])])",
    "Prevent the next {{Digits}} damage that would be dealt this turn to target {{Creature}}. Tap that creature. It doesn't untap during your next untap step": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreateFuturePreventDamage(NextAmountOfDamageThatWouldBeDealtThisTurnToRecipient({{Digits[0]}}, Permanent(Ref_TargetPermanent)), [PreventThatDamage]), TapPermanent(Ref_TargetPermanent), PermanentDoesntUntapDuringControllersNextUntap(Ref_TargetPermanent)]))",
    "Prevent the next {{Digits}} damage that would be dealt to any target this turn": "Targeted([AnyTarget], ActionList([CreateFuturePreventDamage(NextAmountOfDamageThatWouldBeDealtThisTurnToRecipient({{Digits[0]}}, Ref_AnyTarget), [PreventThatDamage])]))",
    "Prevent the next {{Digits}} damage that would be dealt to any target this turn. If it's {{a}} {{Black}} creature, prevent the next {{Digits}} damage instead": "Targeted([AnyTarget], ActionList([IfElse(PermanentPassesFilter(AnyTargetAsAPermanent, And([IsColor({{Black[0]}}), IsCardtype(Creature)])), [CreateFuturePreventDamage(NextAmountOfDamageThatWouldBeDealtThisTurnToRecipient({{Digits[1]}}, Ref_AnyTarget), [PreventThatDamage])], [CreateFuturePreventDamage(NextAmountOfDamageThatWouldBeDealtThisTurnToRecipient({{Digits[0]}}, Ref_AnyTarget), [PreventThatDamage])])]))",
    "Prevent the next {{Digits}} damage that would be dealt to each {{Creature}} and each player this turn": "ActionList([CreateFuturePreventDamage(NextAmountOfDamageThatWouldBeDealtThisTurnToEachRecipient({{Digits[0]}}, MultipleRecipients([EachPermanent({{Creature[0]}}), EachPlayer(AnyPlayer)])), [PreventThatDamage])])",
