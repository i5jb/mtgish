    "roll a 20-sided die.\n{{RawDigits}}-{{RawDigits}} | Add {{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}.\n{{RawDigits}}-{{RawDigits}} | Add {{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}.\n{{RawDigits}}-{{RawDigits}} | Add {{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}": "ActionList([RollAD20, ValueActions(TheDiceResult, [ValueAction(BetweenValues({{RawDigits[0]}}, {{RawDigits[1]}}), [AddMana(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}, {{ManaProduceSymbol[2]}}, {{ManaProduceSymbol[3]}}]))]), ValueAction(BetweenValues({{RawDigits[2]}}, {{RawDigits[3]}}), [AddMana(And([{{ManaProduceSymbol[4]}}, {{ManaProduceSymbol[5]}}, {{ManaProduceSymbol[6]}}, {{ManaProduceSymbol[7]}}, {{ManaProduceSymbol[8]}}]))]), ValueAction(BetweenValues({{RawDigits[4]}}, {{RawDigits[5]}}), [AddMana(And([{{ManaProduceSymbol[9]}}, {{ManaProduceSymbol[10]}}, {{ManaProduceSymbol[11]}}, {{ManaProduceSymbol[12]}}, {{ManaProduceSymbol[13]}}, {{ManaProduceSymbol[14]}}]))])])])",
    "roll a d20.\n{{RawDigits}}-{{RawDigits}} | Create a Treasure token. {{Reminder}}\n{{RawDigits}}-{{RawDigits}} | Create {{Number}} Treasure tokens.\n{{RawDigits}} | Create {{Number}} Treasure tokens": "ActionList([RollAD20, ValueActions(TheDiceResult, [ValueAction(BetweenValues({{RawDigits[0]}}, {{RawDigits[1]}}), [CreateTokens([TreasureToken])]), ValueAction(BetweenValues({{RawDigits[2]}}, {{RawDigits[3]}}), [CreateTokens([NumberTokens({{Number[0]}}, TreasureToken)])]), ValueAction(ExactValue({{RawDigits[4]}}), [CreateTokens([NumberTokens({{Number[1]}}, TreasureToken)])])])])",
    "roll a d20.\n{{RawDigits}}-{{RawDigits}} | Create {{a}} {{PT}} {{CreatureToken}}.\n{{RawDigits}}-{{RawDigits}} | Create {{Number}} of those tokens.\n{{RawDigits}} | Create {{Number}} of those tokens": "ActionList([RollAD20, ValueActions(TheDiceResult, [ValueAction(BetweenValues({{RawDigits[0]}}, {{RawDigits[1]}}), [CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])]), ValueAction(BetweenValues({{RawDigits[2]}}, {{RawDigits[3]}}), [CreateTokens([NumberTokens({{Number[0]}}, TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, []))])]), ValueAction(ExactValue({{RawDigits[4]}}), [CreateTokens([NumberTokens({{Number[1]}}, TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, []))])])])])",
    "roll a d20.\n{{RawDigits}}-{{RawDigits}} | Each player sacrifices {{a}} {{Permanent}} of their choice.\n{{RawDigits}}-{{RawDigits}} | Each opponent sacrifices {{a}} {{Permanent}} of their choice.\n{{RawDigits}} | Each opponent sacrifices {{Number}} {{Permanents}} of their choice": "ActionList([RollAD20, ValueActions(TheDiceResult, [ValueAction(BetweenValues({{RawDigits[0]}}, {{RawDigits[1]}}), [EachPlayerAction(AnyPlayer, SacrificeAPermanent({{Permanent[0]}}))]), ValueAction(BetweenValues({{RawDigits[2]}}, {{RawDigits[3]}}), [EachPlayerAction(Opponent, SacrificeAPermanent({{Permanent[0]}}))]), ValueAction(ExactValue({{RawDigits[4]}}), [EachPlayerAction(Opponent, SacrificeNumberPermanents({{Number[0]}}, {{Permanents[0]}}))])])])",
    "roll a d20.\n{{RawDigits}}-{{RawDigits}} | Exile the top card of your library. You may play it this turn.\n{{RawDigits}}-{{RawDigits}} | Exile the top {{Number}} cards of your library. You may play them this turn.\n{{RawDigits}} | Exile the top {{Number}} cards of your library. You may play them this turn": "ActionList([RollAD20, ValueActions(TheDiceResult, [ValueAction(BetweenValues({{RawDigits[0]}}, {{RawDigits[1]}}), [ExileTopCardOfLibrary, CreatePlayerEffectUntil(You, [MayPlayExiledCard(TheCardExiledThisWay)], UntilEndOfTurn)]), ValueAction(BetweenValues({{RawDigits[2]}}, {{RawDigits[3]}}), [ExileTheTopNumberCardsOfLibrary({{Number[0]}}), CreatePlayerEffectUntil(You, [MayPlayExiledCards(TheCardsExiledThisWay)], UntilEndOfTurn)]), ValueAction(ExactValue({{RawDigits[4]}}), [ExileTheTopNumberCardsOfLibrary({{Number[1]}}), CreatePlayerEffectUntil(You, [MayPlayExiledCards(TheCardsExiledThisWay)], UntilEndOfTurn)])])])",
    "roll a d20.\n{{RawDigits}}-{{RawDigits}} | Scry {{Digits}}.\n{{RawDigits}}-{{RawDigits}} | Scry {{Digits}}.\n{{RawDigits}} | Scry {{Digits}}": "ActionList([RollAD20, ValueActions(TheDiceResult, [ValueAction(BetweenValues({{RawDigits[0]}}, {{RawDigits[1]}}), [Scry({{Digits[0]}})]), ValueAction(BetweenValues({{RawDigits[2]}}, {{RawDigits[3]}}), [Scry({{Digits[1]}})]), ValueAction(ExactValue({{RawDigits[4]}}), [Scry({{Digits[2]}})])])])",
    "roll a d20.\n{{RawDigits}}-{{RawDigits}} | You draw a card and you lose {{Digits}} life.\n{{RawDigits}}-{{RawDigits}} | You draw {{Number}} cards and you lose {{Digits}} life.\n{{RawDigits}} | You draw {{Number}} cards and you lose {{Digits}} life": "ActionList([RollAD20, ValueActions(TheDiceResult, [ValueAction(BetweenValues({{RawDigits[0]}}, {{RawDigits[1]}}), [DrawACard, LoseLife({{Digits[0]}})]), ValueAction(BetweenValues({{RawDigits[2]}}, {{RawDigits[3]}}), [DrawNumberCards({{Number[0]}}), LoseLife({{Digits[1]}})]), ValueAction(ExactValue({{RawDigits[4]}}), [DrawNumberCards({{Number[1]}}), LoseLife({{Digits[2]}})])])])",
    "roll a d20.\n{{RawDigits}}-{{RawDigits}} | You gain {{Digits}} life.\n{{RawDigits}}-{{RawDigits}} | You gain {{Digits}} life.\n{{RawDigits}} | You gain {{Digits}} life": "ActionList([RollAD20, ValueActions(TheDiceResult, [ValueAction(BetweenValues({{RawDigits[0]}}, {{RawDigits[1]}}), [GainLife({{Digits[0]}})]), ValueAction(BetweenValues({{RawDigits[2]}}, {{RawDigits[3]}}), [GainLife({{Digits[1]}})]), ValueAction(ExactValue({{RawDigits[4]}}), [GainLife({{Digits[2]}})])])])",
    "roll a d20. Draw cards equal to the result. You have no maximum hand size for the rest of the game": "ActionList([RollAD20, DrawNumberCards(TheDiceResult), CreatePlayerEffect(You, [HasNoMaximumHandSize])])",
    "roll a d20. When you do, put X {{CounterType}} counters on each of up to {{Number}} target {{Permanents}}, where X is the result": "ActionList([RollAD20, ReflexiveTrigger(Targeted([UptoNumberTargetPermanents({{Number[0]}}, {{Permanents[0]}})], ActionList([PutNumberCountersOfTypeOnEachPermanent(TheDiceResult, {{CounterType[0]}}, Ref_TargetPermanents)])))])",
    "roll a d20. When you do, put any number of target {{SpecificCards}} with total mana value X or less from graveyards onto the battlefield under your control, where X is the result": "ActionList([RollAD20, ReflexiveTrigger(Targeted([AnyNumberOfTargetGroupGraveyardCards({{SpecificCards[0]}}, TotalManaValueIs(LessThanOrEqualTo(TheDiceResult)))], ActionList([ReturnEachGraveyardCardToBattlefield(Ref_TargetGraveyardCards, [EntersUnderPlayersControl(You)])])))])",
    "roll a d20. You create a number of Treasure tokens equal to the result": "ActionList([RollAD20, CreateTokens([NumberTokens(TheDiceResult, TreasureToken)])])",
    "roll a d20. You create a number of {{PT}} {{CreatureTokens}} with {{Hasable}} equal to the result": "ActionList([RollAD20, CreateTokens([NumberTokens(TheDiceResult, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}]))])])",
    "roll a d4. Scry X, where X is the result": "ActionList([RollAD4, Scry(TheDiceResult)])",
    "roll a six-sided die. If the result is {{Digits}} or less, you lose that much life": "ActionList([RollAD6, If(DiceResultIs(LessThanOrEqualTo({{Digits[0]}})), [LoseLife(TheDiceResult)])])",
    "roll to visit your Attractions": "ActionList([RollToVisitAttractions])",
    "roll {{Number}} six-sided dice and store those results on it": "ActionList([RollNumberD6AndStoreTheResult({{Number[0]}})])",
    "sacrifice a creature with the least toughness among creatures you control. Then investigate": "ActionList([SacrificeAPermanent(And([IsCardtype(Creature), ToughnessIs(EqualTo(TheLeastToughnessAmongPermanents(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))))])), Investigate])",
    "sacrifice all {{Permanents}}": "ActionList([SacrificeEachPermanent({{Permanents[0]}})])",
    "sacrifice all {{Permanents}}. Then return the exiled cards to the battlefield under your control": "ActionList([SacrificeEachPermanent({{Permanents[0]}}), PutEachExiledCardOntoTheBattlefield(TheExiledCards, [EntersUnderPlayersControl(You)])])",
    "sacrifice any number of artifacts. When you sacrifice one or more artifacts this way, tap up to that many target {{Permanents}} and draw that many cards": "ActionList([SacrificeAnyNumberOfPermanents(IsCardtype(Artifact)), If(CostWasPaid, [ReflexiveTrigger(Targeted([UptoNumberTargetPermanents(TheNumberOfPermanentsSacrificedThisWay, {{Permanents[0]}})], ActionList([TapEachPermanent(Ref_TargetPermanents), DrawNumberCards(TheNumberOfPermanentsSacrificedThisWay)])))])])",
    "sacrifice any number of {{Permanents}}, then draw that many cards": "ActionList([SacrificeAnyNumberOfPermanents({{Permanents[0]}}), DrawNumberCards(TheNumberOfPermanentsSacrificedThisWay)])",
    "sacrifice any number of {{Permanents}}. Create that many {{PT}} {{CreatureTokens}} with {{Hasable}} and {{Hasable}}": "ActionList([SacrificeAnyNumberOfPermanents({{Permanents[0]}}), CreateTokens([NumberTokens(TheNumberOfPermanentsSacrificedThisWay, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}, {{Hasable[1]}}]))])])",
    "sacrifice half the {{Permanents}}, rounded up": "ActionList([SacrificeHalfOfThePermanentsRoundedUp({{Permanents[0]}})])",
