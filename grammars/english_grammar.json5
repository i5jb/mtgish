  "{{SelfTransformsActions(~Permanent)}}": {
    "As this creature transforms into {{~Permanent}}, it becomes a copy of a creature card exiled with it, except its name is {{NamedCard}}, it's {{PT}}, and it's a legendary {{Black}} and {{Black}} {{Zombie}} in addition to its other colors and types. Put a number of {{CounterType}} counters on {{~Permanent}} equal to the number of {{SpecificCards}} exiled with it": "AsPermanentTransforms({{~Permanent}}, [BecomeACopyOfAnExiledCard(And([IsCardtype(Creature), WasExiledWithPermanent({{~Permanent}})]), CopyEffects([SetName({{NamedCard[0]}}), SetPT({{PT[0]}}), AddSupertypes([Legendary]), AddColor(SimpleColorList([{{Black[0]}}, {{Black[1]}}])), AddCreatureTypes([{{Zombie[0]}}])])), TransformsWithNumberCounters(NumCardsInExile(TheExiledCards), {{CounterType[0]}})])",
    "As this creature transforms into {{~Permanent}}, you get an emblem with \"{{EmblemQuotedAbility}}\"": "AsPermanentTransforms({{~Permanent}}, [GetAnEmblem([{{EmblemQuotedAbility[0]}}])])",
    "As this permanent transforms into {{~Permanent}}, attach it to a player": "AsPermanentTransforms({{~Permanent}}, [AttachPermanentToAPlayer({{~Permanent}}, AnyPlayer)])"
  },
  "{{SelfTurnedFaceUpActions(~Permanent)}}": {
    "As this Aura is turned face up, you may attach it to a creature": "AsPermanentIsTurnedFaceUp({{~Permanent}}, [MayActions([AttachPermanentToAPermanent({{~Permanent}}, IsCardtype(Creature))])])",
    "As this creature is turned face up, put {{Number}} {{CounterType}} counters on it": "AsPermanentIsTurnedFaceUp({{~Permanent}}, [PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[0]}}, {{~Permanent}})])"
  },
  "{{SpecificCards}}": {
    "Chorus cards": "IsSpellType(Chorus)",
    "Instant and sorcery cards": "Or([IsCardtype(Instant), IsCardtype(Sorcery)])",
    "Trap cards": "IsSpellType(Trap)",
    "battle cards": "IsCardtype(Battle)",
    "cards named {{NamedCard}}": "IsNamed(NamedCard({{NamedCard[0]}}))",
    "cards not named {{NamedCard}}": "IsNotNamed(NamedCard({{NamedCard[0]}}))",
    "cards that are {{Black}} or {{Black}}": "Or([IsColor({{Black[0]}}), IsColor({{Black[1]}})])",
    "cards that have an Adventure": "HasAnAdventure",
    "cards that have mana value {{Digits}}": "ManaValueIs(EqualTo({{Digits[0]}}))",
    "cards with cycling": "HasAbility(AnyCycling)",
    "cards with flashback": "HasAbility(AnyFlashback)",
    "cards with mana value {{Digits}} or greater": "ManaValueIs(GreaterThanOrEqualTo({{Digits[0]}}))",
    "cards with {X} in their mana cost": "HasXInManaCost",
    "colorless nonland cards": "And([IsColorless, IsNonCardtype(Land)])",
    "historic cards": "IsHistoric",
    "instant and sorcery cards": "Or([IsCardtype(Instant), IsCardtype(Sorcery)])",
    "instant and/or sorcery cards": "Or([IsCardtype(Instant), IsCardtype(Sorcery)])",
    "instant and/or sorcery cards with mana value {{Digits}}": "And([Or([IsCardtype(Instant), IsCardtype(Sorcery)]), ManaValueIs(EqualTo({{Digits[0]}}))])",
    "instant and/or sorcery cards with mana value {{Digits}} or less": "And([Or([IsCardtype(Instant), IsCardtype(Sorcery)]), ManaValueIs(LessThanOrEqualTo({{Digits[0]}}))])",
    "instant cards": "IsCardtype(Instant)",
    "instant, sorcery, and/or {{Liliana}} planeswalker cards": "Or([IsCardtype(Instant), IsCardtype(Sorcery), And([IsPlaneswalkerType({{Liliana[0]}}), IsCardtype(Planeswalker)])])",
    "legendary and/or enchantment cards": "Or([IsSupertype(Legendary), IsCardtype(Enchantment)])",
    "legendary cards": "IsSupertype(Legendary)",
    "monocolored cards": "IsMonocolored",
    "multicolored cards": "IsMulticolored",
    "non-{{Zombie}} instant and sorcery cards": "And([IsNonCreatureType({{Zombie[0]}}), Or([IsCardtype(Instant), IsCardtype(Sorcery)])])",
    "noncreature, nonland cards": "And([IsNonCardtype(Creature), IsNonCardtype(Land)])",
    "nonland cards": "IsNonCardtype(Land)",
    "nonland cards with mana value {{Digits}} or less": "And([IsNonCardtype(Land), ManaValueIs(LessThanOrEqualTo({{Digits[0]}}))])",
    "nonlegendary cards": "IsNonSupertype(Legendary)",
    "sorcery cards": "IsCardtype(Sorcery)",
    "{{Black}} cards": "IsColor({{Black[0]}})",
    "{{Black}} instant and/or sorcery cards": "And([IsColor({{Black[0]}}), Or([IsCardtype(Instant), IsCardtype(Sorcery)])])",
    "{{Black}}, {{Black}}, and/or {{Black}} creature cards": "And([Or([IsColor({{Black[0]}}), IsColor({{Black[1]}}), IsColor({{Black[2]}})]), IsCardtype(Creature)])",
    "{{PermanentCards}}": "{{PermanentCards[0]}}",
    "{{Zombie}} and Vehicle cards": "Or([IsCreatureType({{Zombie[0]}}), IsArtifactType(Vehicle)])",
    "{{Zombie}} and/or {{Zombie}} permanent cards": "And([Or([IsCreatureType({{Zombie[0]}}), IsCreatureType({{Zombie[1]}})]), IsPermanent])",
    "{{Zombie}} permanent cards": "And([IsCreatureType({{Zombie[0]}}), IsPermanent])"
  },
  "{{SpecificCard}}": {
    "Arcane card": "IsSpellType(Arcane)",
    "Equipment, instant, or sorcery card": "Or([IsArtifactType(Equipment), IsCardtype(Instant), IsCardtype(Sorcery)])",
    "Food card": "IsArtifactType(Food)",
    "Lesson card": "IsSpellType(Lesson)",
    "Lesson or {{Zombie}} card": "Or([IsSpellType(Lesson), IsCreatureType({{Zombie[0]}})])",
    "Lesson, Saga, or Shrine card": "Or([IsSpellType(Lesson), IsEnchantmentType(Saga), IsEnchantmentType(Shrine)])",
    "Room card that doesn't have the same name as a Room you control": "And([IsEnchantmentType(Room), DoesntShareANameWithAPermanent(And([IsEnchantmentType(Room), ControlledByAPlayer(SinglePlayer(You))]))])",
    "Spacecraft card": "IsArtifactType(Spacecraft)",
    "Trap card": "IsSpellType(Trap)",
    "artifact, enchantment, or legendary card": "Or([IsCardtype(Artifact), IsCardtype(Enchantment), IsSupertype(Legendary)])",
    "artifact, instant, or sorcery card": "Or([IsCardtype(Artifact), IsCardtype(Instant), IsCardtype(Sorcery)])",
    "card named {{NamedCard}}": "IsNamed(NamedCard({{NamedCard[0]}}))",
    "card named {{NamedCard}} or {{NamedCard}}": "Or([IsNamed(NamedCard({{NamedCard[0]}})), IsNamed(NamedCard({{NamedCard[1]}}))])",
    "card that has a cycling ability": "HasAbility(AnyCycling)",
    "card that has an Adventure": "HasAnAdventure",
    "card that's an instant or sorcery": "Or([IsCardtype(Instant), IsCardtype(Sorcery)])",
    "card that's exactly two colors": "IsNumberColors(EqualTo(Integer(2)))",
    "card with a name noted as you drafted cards named {{NamedCard}}": "IsNamed(TheNamePlayerNotedForCardDuringDraft(You, {{NamedCard[0]}}))",
    "card with a name you noted for cards named {{NamedCard}}": "IsNamed(TheNamePlayerNotedForCardDuringDraft(You, {{NamedCard[0]}}))",
    "card with mana value equal to {{GameNumber}}": "ManaValueIs(EqualTo({{GameNumber[0]}}))",
    "card with mana value less than or equal to {{GameNumber}}": "ManaValueIs(LessThanOrEqualTo({{GameNumber[0]}}))",
    "card with mana value {{Digits}} or greater": "ManaValueIs(GreaterThanOrEqualTo({{Digits[0]}}))",
    "card with mana value {{Digits}} or less": "ManaValueIs(LessThanOrEqualTo({{Digits[0]}}))",
    "card with start your engines!": "HasAbility(StartYourEngines)",
    "card with {X} in its mana cost": "HasXInManaCost",
    "card with {{CheckHasable}}": "HasAbility({{CheckHasable[0]}})",
    "card with {{CheckHasable}} or {{CheckHasable}}": "Or([HasAbility({{CheckHasable[0]}}), HasAbility({{CheckHasable[1]}})])",
    "colorless card": "IsColorless",
    "colorless card with mana value {{Digits}} or greater": "And([IsColorless, ManaValueIs(GreaterThanOrEqualTo({{Digits[0]}}))])",
    "creature or Food card": "Or([IsCardtype(Creature), IsArtifactType(Food)])",
    "enchantment, instant, or sorcery card": "Or([IsCardtype(Enchantment), IsCardtype(Instant), IsCardtype(Sorcery)])",
    "historic card": "IsHistoric",
    "instant and sorcery card": "Or([IsCardtype(Instant), IsCardtype(Sorcery)])",
    "instant card": "IsCardtype(Instant)",
    "instant card with mana value {{Digits}} or less": "And([IsCardtype(Instant), ManaValueIs(LessThanOrEqualTo({{Digits[0]}}))])",
    "instant or sorcery card": "Or([IsCardtype(Instant), IsCardtype(Sorcery)])",
    "instant or sorcery card with mana value {{Digits}}": "And([Or([IsCardtype(Instant), IsCardtype(Sorcery)]), ManaValueIs(EqualTo({{Digits[0]}}))])",
    "instant or sorcery card with mana value {{Digits}} or less": "And([Or([IsCardtype(Instant), IsCardtype(Sorcery)]), ManaValueIs(LessThanOrEqualTo({{Digits[0]}}))])",
    "instant or sorcery card with the same name as a card in your graveyard": "And([Or([IsCardtype(Instant), IsCardtype(Sorcery)]), SharesANameWithAGraveyardCard(InAPlayersGraveyard(SinglePlayer(You)))])",
    "instant or sorcery card with {{CheckHasable}}": "And([Or([IsCardtype(Instant), IsCardtype(Sorcery)]), HasAbility({{CheckHasable[0]}})])",
    "instant, sorcery, or artifact card": "Or([IsCardtype(Instant), IsCardtype(Sorcery), IsCardtype(Artifact)])",
    "instant, sorcery, or battle card": "Or([IsCardtype(Instant), IsCardtype(Sorcery), IsCardtype(Battle)])",
