    "seek {{a}} {{SpecificCard}} and put it into your graveyard, then conjure {{Number}} duplicates of it into your graveyard": "ActionList([SeekACard({{SpecificCard[0]}}), PutCardFromHandIntoGraveyard(TheCardSeekedThisWay), ConjureNumberDuplicateCardsIntoGraveyard({{Number[0]}}, TheCardSeekedThisWay)])",
    "seek {{a}} {{SpecificCard}} and put it onto the battlefield tapped": "ActionList([SeekACard({{SpecificCard[0]}}), PutCardFromHandOnBattlefield(TheCardSeekedThisWay, [EntersTapped])])",
    "seek {{a}} {{SpecificCard}} from among the top {{Number}} cards of your library, then shuffle": "ActionList([SeekACardFromTheTopNumberCardsOfLibrary({{SpecificCard[0]}}, {{Number[0]}}), Shuffle])",
    "seek {{a}} {{SpecificCard}} of the most prevalent creature type in your library": "ActionList([SeekACard(And([IsCardtype(Creature), SharesACreatureTypeWithMostPrevalentCreatureTypeInPlayersLibrary(You)]))])",
    "seek {{a}} {{SpecificCard}} with mana value X or less, where X is {{GameNumber}}. Put that card onto the battlefield": "ActionList([SeekACard(And([{{SpecificCard[0]}}, ManaValueIs(LessThanOrEqualTo({{GameNumber[0]}}))])), PutCardFromHandOnBattlefield(TheCardSeekedThisWay, [EntersNormally])])",
    "seek {{a}} {{SpecificCard}}, then put it onto the battlefield tapped": "ActionList([SeekACard({{SpecificCard[0]}}), PutCardFromHandOnBattlefield(TheCardSeekedThisWay, [EntersTapped])])",
    "seek {{a}} {{SpecificCard}}. Discard that card at the beginning of the next end step": "ActionList([SeekACard({{SpecificCard[0]}}), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([DiscardCard(TheCardSeekedThisWay)]))])",
    "seek {{a}} {{SpecificCard}}. That card gains {{Hasable}} until end of turn. You lose {{Digits}} life": "ActionList([SeekACard({{SpecificCard[0]}}), CreateCardInHandEffectUntil(TheCardSeekedThisWay, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), LoseLife({{Digits[0]}})])",
    "seek {{a}} {{SpecificCard}}. That card perpetually gains {{PerpetualHasable}}, \"{{PerpetualQuotedAbility}}\", and \"{{PerpetualQuotedAbility}}\"": "ActionList([SeekACard({{SpecificCard[0]}}), CreatePerpetualCardInHandEffect(TheCardSeekedThisWay, [AddAbility([{{PerpetualHasable[0]}}]), AddAbility([{{PerpetualQuotedAbility[0]}}]), AddAbility([{{PerpetualQuotedAbility[1]}}])])])",
    "seek {{a}} {{SpecificCard}}. That card perpetually gets {{PTMod}}": "ActionList([SeekACard({{SpecificCard[0]}}), CreatePerpetualCardInHandEffect(TheCardSeekedThisWay, [AdjustPT({{PTMod[0]}})])])",
    "seek {{a}} {{SpecificCard}}. Until end of turn, you may cast that card without paying its mana cost": "ActionList([SeekACard({{SpecificCard[0]}}), CreatePlayerEffectUntil(You, [MayCastCardInHandWithoutPaying(TheCardSeekedThisWay)], UntilEndOfTurn)])",
    "select target player at random. That player discards a card. If that player discards {{a}} {{SpecificCard}} this way, they lose {{Digits}} life": "Targeted([TargetPlayerAtRandom(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, DiscardACard), If(ACardWasDiscardedThisWay({{SpecificCard[0]}}), [PlayerAction(Ref_TargetPlayer, LoseLife({{Digits[0]}}))])]))",
