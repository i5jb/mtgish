    "Choose {{a}} {{Creature}}. Each other {{Permanent}} becomes a copy of that creature until end of turn": "ActionList([ChooseAPermanent({{Creature[0]}}), CreateEachPermanentLayerEffectUntil(And([Other(TheChosenPermanent), {{Permanent[0]}}]), [IsACopyOfPermanent(TheChosenPermanent, NoCopyEffects)], UntilEndOfTurn)])",
    "Choose {{a}} {{Creature}}. It deals damage equal to {{GameNumber(ThatCreature)}} to target {{Creature}}": "Targeted([TargetPermanent({{Creature[1]}})], ActionList([ChooseAPermanent({{Creature[0]}}), PermanentDealsDamage(TheChosenPermanent, {{GameNumber(ThatCreature=TheChosenPermanent)[0]}}, Permanent(Ref_TargetPermanent))]))",
    "Choose {{a}} {{DamageSource}} and flip a coin. If you win the flip, the next time that source would deal damage this turn, it deals double that damage instead. If you lose the flip, the next time it would deal damage this turn, prevent that damage": "ActionList([ChooseADamageSource({{DamageSource[0]}}), FlipACoin_OnWinAndLose([CreateFutureReplaceWouldDealDamage(NextTimeDamageWouldBeDealtThisTurnBySource(TheChosenDamageSource), [DealDamageInstead(Twice(WouldDealDamage_ThatMuchDamage))])], [CreateFuturePreventDamage(NextTimeDamageWouldBeDealtThisTurnBySource(TheChosenDamageSource), [PreventThatDamage])])])",
    "Choose {{a}} {{Permanent}}, then destroy all other {{Permanents}}": "ActionList([ChooseAPermanent({{Permanent[0]}}), DestroyEachPermanent(And([Other(ThePermanentChosenThisWay), {{Permanents[0]}}]))])",
    "Choose {{a}} {{Permanent}}. Create a token that's a copy of it": "ActionList([ChooseAPermanent({{Permanent[0]}}), CreateTokens([TokenCopyOfPermanent(ThePermanentChosenThisWay, NoTokenCopyEffects)])])",
    "Choose {{a}} {{Permanent}}. It gains {{Hasable}} until end of turn": "ActionList([ChooseAPermanent({{Permanent[0]}}), CreatePermanentLayerEffectUntil(ThePermanentChosenThisWay, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "Choose {{a}} {{SpecificCard}} in your hand or graveyard. That card perpetually incorporates {{ManaCost}} and gains \"{{PerpetualQuotedAbility}}\". Then return {{a}} {{SpecificCard}} from your graveyard to your hand": "ActionList([ChooseAnAction([[ChooseACardInHand({{SpecificCard[0]}}), CreatePerpetualCardInHandEffect(TheCardInHandChosenThisWay, [Incorporate({{ManaCost[0]}}), AddAbility([{{PerpetualQuotedAbility[0]}}])])], [ChooseACardInPlayersGraveyard({{SpecificCard[0]}}, You), CreatePerpetualGraveyardCardEffect(TheChosenGraveyardCard, [Incorporate({{ManaCost[0]}}), AddAbility([{{PerpetualQuotedAbility[0]}}])])]])])",
    "Clash with an opponent, then return target {{Creature}} to its owner's hand. If you win, you may put that creature on top of its owner's library instead": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([Clash(Opponent, [ChooseAnAction([[PutPermanentIntoItsOwnersHand(Ref_TargetPermanent)], [PutPermanentOnTopOfOwnersLibrary(Ref_TargetPermanent)]])], [PutPermanentIntoItsOwnersHand(Ref_TargetPermanent)])]))",
    "Clash with an opponent. If you win, target player discards {{Number}} cards. Otherwise, that player discards a card": "Targeted([TargetPlayer(AnyPlayer)], ActionList([Clash(Opponent, [PlayerAction(Ref_TargetPlayer, DiscardNumberCards({{Number[0]}}))], [PlayerAction(Ref_TargetPlayer, DiscardACard)])]))",
    "Conjure X cards named {{NamedCard}} onto the battlefield, where X is this spell's intensity.\nAll {{SpecificCards}} you own intensify by {{Digits}}": "ActionList([ConjureNumberCardsOntoBattlefield(IntensityOfSpell(ThisSpell), {{NamedCard[0]}}, [EntersNormally]), PerpetuallyIncreaseIntensityOfCardsOwnedByPlayer({{SpecificCards[0]}}, You, {{Digits[0]}})])",
    "Conjure a card named {{NamedCard}} into your hand": "ActionList([ConjureCardIntoHand({{NamedCard[0]}})])",
    "Conjure a card named {{NamedCard}} into your hand. If {{Condition}}, repeat this process": "ActionList([RepeatableActions([ConjureCardIntoHand({{NamedCard[0]}}), If({{Condition[0]}}, [RepeatThisProcess])])])",
    "Conjure a card named {{NamedCard}} onto the battlefield": "ActionList([ConjureCardOntoBattlefield({{NamedCard[0]}}, [EntersNormally])])",
    "Conjure a card named {{NamedCard}} onto the battlefield, then each player sacrifices {{a}} {{Permanent}}": "ActionList([ConjureCardOntoBattlefield({{NamedCard[0]}}, [EntersNormally]), EachPlayerAction(AnyPlayer, SacrificeAPermanent({{Permanent[0]}}))])",
    "Conjure a card of your choice from {{Spellbook}} onto the battlefield": "ActionList([ConjureACardOfChoiceFromSpellBookOntoBattlefield({{Spellbook[0]}}, [EntersNormally])])",
    "Conjure a duplicate of each of up to {{Number}} target {{Permanents}} into your hand": "Targeted([UptoNumberTargetPermanents({{Number[0]}}, {{Permanents[0]}})], ActionList([ConjureDuplicateOfEachPermanentIntoHand(Ref_TargetPermanents)]))",
    "Conjure a duplicate of target {{SpecificCard}} in an opponent's graveyard into your hand. It perpetually gains \"{{PerpetualQuotedAbility}}\"": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(Opponent)]))], ActionList([ConjureDuplicateOfGraveyardCardIntoHand(Ref_TargetGraveyardCard), CreatePerpetualCardInHandEffect(TheCardConjuredIntoHandThisWay, [AddAbility([{{PerpetualQuotedAbility[0]}}])])]))",
    "Conjure a random instant or sorcery card from the Lorwyn Eclipsed expansion into exile. Until end of turn, you may cast that card without paying its mana cost": "ActionList([ConjureARandomCardIntoExile(And([Or([IsCardtype(Instant), IsCardtype(Sorcery)]), FromTheLorwynEclipsedExpansion])), CreatePlayerEffectUntil(You, [MayCastExiledCardWithoutPaying(TheCardConjuredIntoExileThisWay)], UntilEndOfTurn)])",
    "Conjure {{Number}} cards named {{NamedCard}} onto the battlefield": "ActionList([ConjureNumberCardsOntoBattlefield({{Number[0]}}, {{NamedCard[0]}}, [EntersNormally])])",
    "Copy any number of target {{StackSpells}}. You may choose new targets for the copies": "Targeted([AnyNumberOfTargetSpells({{StackSpells[0]}})], ActionList([CopyEachSpellAndMayChooseNewTargets(Ref_TargetSpells)]))",
    "Copy target activated or triggered ability you control. You may choose new targets for the copy": "Targeted([TargetAbility(And([Or([ActivatedAbility, TriggeredAbility]), ControlledByAPlayer(SinglePlayer(You))]))], ActionList([CopyAbilityAndMayChooseNewTargets(Ref_TargetAbility)]))",
    "Copy target creature spell you control. The copy gains {{Hasable}} and \"{{QuotedAbility}}\"": "Targeted([TargetSpell(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))], ActionList([CopySpellWithModifiers(Ref_TargetSpell, [AddAbility([{{Hasable[0]}}, {{QuotedAbility[0]}}])])]))",
    "Copy target instant spell, sorcery spell, activated ability, or triggered ability. You may choose new targets for the copy": "Targeted([TargetSpellOrAbility(Or([IsSpell(IsCardtype(Instant)), IsSpell(IsCardtype(Sorcery)), ActivatedAbility, TriggeredAbility]))], ActionList([CopySpellOrAbilityAndMayChooseNewTargets(Ref_TargetSpellOrAbility)]))",
    "Copy target {{Spell}}, except it isn't legendary if the spell is legendary": "Targeted([TargetSpell({{Spell[0]}})], ActionList([CopySpellWithModifiers(Ref_TargetSpell, [RemoveSupertypes([Legendary])])]))",
    "Copy target {{Spell}}, except that the copy is {{Black}}. You may choose new targets for the copy": "Targeted([TargetSpell({{Spell[0]}})], ActionList([CopySpellAndMayChooseNewTargetsWithEffects(Ref_TargetSpell, [SetColor(SimpleColorList([{{Black[0]}}]))])]))",
    "Copy target {{Spell}}, then return it to its owner's hand. You may choose new targets for the copy": "Targeted([TargetSpell({{Spell[0]}})], ActionList([CopySpellAndMayChooseNewTargets(Ref_TargetSpell), ReturnSpellToOwnersHand(Ref_TargetSpell)]))",
    "Copy target {{Spell}}. You may choose new targets for the copy": "Targeted([TargetSpell({{Spell[0]}})], ActionList([CopySpellAndMayChooseNewTargets(Ref_TargetSpell)]))",
    "Count the number of cards in your library. Your life total becomes that number": "ActionList([SetLifeTotal(NumCardsInPlayersLibrary(You))])",
    "Counter all other spells": "ActionList([CounterEachSpell(Other(ThisSpell))])",
    "Counter all other spells. Draw a card for each spell countered this way": "ActionList([CounterEachSpell(Other(ThisSpell)), DrawNumberCards(TheNumberOfSpellsCounteredThisWay)])",
    "Counter all spells your opponents control and all abilities your opponents control. Create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}} for each spell and ability countered this way": "ActionList([CounterEachSpellAndAbility(ControlledByAPlayer(Opponent)), CreateTokens([NumberTokens(TheNumberOfSpellsAndAbilitiesCounteredThisWay, TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}]))])])",
    "Counter target activated ability from {{an}} {{AbilitySource}}": "Targeted([TargetAbility(And([ActivatedAbility, AbilityOfASource({{AbilitySource[0]}})]))], ActionList([CounterAbility(Ref_TargetAbility)]))",
    "Counter target activated ability from {{a}} {{Permanent}}. That permanent's activated abilities can't be activated this turn. {{Reminder}}\nDraw a card": "Targeted([TargetAbility(And([ActivatedAbility, AbilityOfAPermanent({{Permanent[0]}})]))], ActionList([CounterAbility(Ref_TargetAbility), CreatePermanentRuleEffectUntil(PermanentSourceOfAbility(Ref_TargetAbility), [AbilitiesCantBeActivated], UntilEndOfTurn), DrawACard]))",
    "Counter target activated ability, triggered ability, or {{Spell}}": "Targeted([TargetSpellOrAbility(Or([ActivatedAbility, TriggeredAbility, IsSpell({{Spell[0]}})]))], ActionList([CounterSpellOrAbility(Ref_TargetSpellOrAbility)]))",
    "Counter target activated or triggered ability. If a permanent's ability is countered this way, activated abilities of that permanent can't be activated this turn": "Targeted([TargetAbility(Or([ActivatedAbility, TriggeredAbility]))], ActionList([CounterAbility(Ref_TargetAbility), If(APermanentsAbilityIsCounteredThisWay(AnyPermanent), [CreatePermanentRuleEffectUntil(PermanentSourceOfAbilityCounteredThisWay, [AbilitiesCantBeActivated], UntilEndOfTurn)])]))",
    "Counter target loyalty ability of a planeswalker": "Targeted([TargetAbility(And([LoyaltyAbility, AbilityOfAPermanent(IsCardtype(Planeswalker))]))], ActionList([CounterAbility(Ref_TargetAbility)]))",
    "Counter target spell or ability an opponent controls that targets {{a}} {{Permanent}}. If a permanent's ability is countered this way, destroy that permanent.\nDraw {{Number}} cards": "Targeted_Modal([Targeted([TargetSpell(And([ControlledByAPlayer(Opponent), TargetsAPermanent({{Permanent[0]}})]))], ActionList([CounterSpell(Ref_TargetSpell), DrawNumberCards({{Number[0]}})])), Targeted([TargetAbility(And([ControlledByAPlayer(Opponent), TargetsAPermanent({{Permanent[0]}})]))], ActionList([CounterAbility(Ref_TargetAbility), DestroyPermanent(PermanentSourceOfAbilityCounteredThisWay), DrawNumberCards({{Number[0]}})]))])",
    "Counter target spell or ability that targets {{a}} {{Permanent}}": "Targeted([TargetSpellOrAbility(TargetsAPermanent({{Permanent[0]}}))], ActionList([CounterSpellOrAbility(Ref_TargetSpellOrAbility)]))",
    "Counter target spell with mana value less than or equal to the number of cards in its controller's graveyard": "Targeted([TargetSpell(ManaValueIs(LessThanOrEqualTo(TheNumberOfGraveyardCards(InAPlayersGraveyard(SinglePlayer(ThatSpellsController))))))], ActionList([CounterSpell(Ref_TargetSpell)]))",
    "Counter target triggered ability or colorless spell": "Targeted([TargetSpellOrAbility(Or([IsSpell(IsColorless), TriggeredAbility]))], ActionList([CounterSpellOrAbility(Ref_TargetSpellOrAbility)]))",
    "Counter target {{Ability}}": "Targeted([TargetAbility({{Ability[0]}})], ActionList([CounterAbility(Ref_TargetAbility)]))",
    "Counter target {{Ability}}. {{Reminder}}\nDraw a card": "Targeted([TargetAbility({{Ability[0]}})], ActionList([CounterAbility(Ref_TargetAbility), DrawACard]))",
    "Counter target {{Spell}}": "Targeted([TargetSpell({{Spell[0]}})], ActionList([CounterSpell(Ref_TargetSpell)]))",
    "Counter target {{Spell}} if {{Condition(ThatSpell)}}": "Targeted([TargetSpell({{Spell[0]}})], ActionList([If({{Condition(ThatSpell=Ref_TargetSpell)[0]}}, [CounterSpell(Ref_TargetSpell)])]))",
    "Counter target {{Spell}} if {{Condition(ThatSpell)}}.\nDraw a card at the beginning of the next turn's upkeep": "Targeted([TargetSpell({{Spell[0]}})], ActionList([If({{Condition(ThatSpell=Ref_TargetSpell)[0]}}, [CounterSpell(Ref_TargetSpell)]), CreateFutureTrigger(AtTheBeginningOfTheNextTurnsUpkeep, ActionList([DrawACard]))]))",
    "Counter target {{Spell}} unless its controller discards their hand": "Targeted([TargetSpell({{Spell[0]}})], ActionList([PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), DiscardHand), Unless(CostWasPaid, [CounterSpell(Ref_TargetSpell)])]))",
    "Counter target {{Spell}} unless its controller exiles all cards from their graveyard.\nDraw a card": "Targeted([TargetSpell({{Spell[0]}})], ActionList([PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), ExilePlayersGraveyard(ActionPlayer)), Unless(CostWasPaid, [CounterSpell(Ref_TargetSpell)]), DrawACard]))",
    "Counter target {{Spell}} unless its controller pays {{ManaCostX}}, where X is {{GameNumber(ThatSpell)}}": "Targeted([TargetSpell({{Spell[0]}})], ActionList([CreateValueX({{GameNumber(ThatSpell=Ref_TargetSpell)[0]}}), PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), PayManaX({{ManaCostX[0]}}, ValueX)), Unless(CostWasPaid, [CounterSpell(Ref_TargetSpell)])]))",
    "Counter target {{Spell}} unless its controller pays {{ManaCostX}}, where X is {{GameNumber}}": "Targeted([TargetSpell({{Spell[0]}})], ActionList([CreateValueX({{GameNumber[0]}}), PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), PayManaX({{ManaCostX[0]}}, ValueX)), Unless(CostWasPaid, [CounterSpell(Ref_TargetSpell)])]))",
    "Counter target {{Spell}} unless its controller pays {{ManaCost}}": "Targeted([TargetSpell({{Spell[0]}})], ActionList([PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [CounterSpell(Ref_TargetSpell)])]))",
    "Counter target {{Spell}} unless its controller pays {{ManaCost}} for each {{Eachable}}": "Targeted([TargetSpell({{Spell[0]}})], ActionList([PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), PayManaForEach({{ManaCost[0]}}, {{Eachable[0]}})), Unless(CostWasPaid, [CounterSpell(Ref_TargetSpell)])]))",
    "Counter target {{Spell}} unless its controller pays {{ManaCost}} plus an additional {{ManaCost}} for each {{Eachable}}": "Targeted([TargetSpell({{Spell[0]}})], ActionList([PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), And([PayMana({{ManaCost[0]}}), PayManaForEach({{ManaCost[0]}}, {{Eachable[0]}})])), Unless(CostWasPaid, [CounterSpell(Ref_TargetSpell)])]))",
    "Counter target {{Spell}} unless its controller pays {{ManaCost}}.\nAmass Zombies {{Digits}}": "Targeted([TargetSpell({{Spell[0]}})], ActionList([PlayerMayCost(ControllerOfTargetSpell, PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [CounterSpell(Ref_TargetSpell)]), Amass({{Digits[0]}}, Zombie)]))",
    "Counter target {{Spell}} unless its controller pays {{ManaCost}}.\nDraw a card": "Targeted([TargetSpell({{Spell[0]}})], ActionList([PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [CounterSpell(Ref_TargetSpell)]), DrawACard]))",
    "Counter target {{Spell}} unless its controller pays {{ManaCost}}.\nDraw a card at the beginning of the next turn's upkeep": "Targeted([TargetSpell({{Spell[0]}})], ActionList([PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [CounterSpell(Ref_TargetSpell)]), CreateFutureTrigger(AtTheBeginningOfTheNextTurnsUpkeep, ActionList([DrawACard]))]))",
    "Counter target {{Spell}} unless its controller pays {{ManaCost}}.\nSuspect up to one target {{Permanent}}": "Targeted([TargetSpell({{Spell[0]}}), TargetPermanent({{Permanent[0]}})], ActionList([PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [CounterSpell(Ref_TargetSpell)]), SuspectPermanent(Ref_TargetPermanent)]))",
    "Counter target {{Spell}} unless its controller pays {{ManaCost}}.\n{{AbilityWord}} - Counter that spell instead if {{Condition(ThatSpell)}}": "Targeted([TargetSpell({{Spell[0]}})], ActionList([IfElse({{Condition(ThatSpell=Ref_TargetSpell)[0]}}, [CounterSpell(Ref_TargetSpell)], [PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [CounterSpell(Ref_TargetSpell)])])]))",
    "Counter target {{Spell}} unless its controller pays {{ManaCost}}.\n{{AbilityWord}} - If {{Condition}}, counter that spell instead": "Targeted([TargetSpell({{Spell[0]}})], ActionList([IfElse({{Condition[0]}}, [CounterSpell(Ref_TargetSpell)], [PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [CounterSpell(Ref_TargetSpell)])])]))",
    "Counter target {{Spell}} unless its controller pays {{ManaCost}}.\n{{AbilityWord}} - If {{Condition}}, scry {{Digits}}": "Targeted([TargetSpell({{Spell[0]}})], ActionList([PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [CounterSpell(Ref_TargetSpell)]), If({{Condition[0]}}, [Scry({{Digits[0]}})])]))",
    "Counter target {{Spell}} unless its controller pays {{ManaCost}}. Create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}}": "Targeted([TargetSpell({{Spell[0]}})], ActionList([PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [CounterSpell(Ref_TargetSpell)]), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])])]))",
    "Counter target {{Spell}} unless its controller pays {{ManaCost}}. If that spell is countered this way, exile it instead of putting it into its owner's graveyard": "Targeted([TargetSpell({{Spell[0]}})], ActionList([PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [CounterSpellIntoExile(Ref_TargetSpell)])]))",
    "Counter target {{Spell}} unless its controller pays {{ManaCost}}. If they do, surveil {{Digits}}": "Targeted([TargetSpell({{Spell[0]}})], ActionList([PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), PayMana({{ManaCost[0]}})), IfElse(CostWasPaid, [Surveil({{Digits[0]}})], [CounterSpell(Ref_TargetSpell)])]))",
    "Counter target {{Spell}} unless its controller pays {{ManaCost}}. If they do, you create a Lander token": "Targeted([TargetSpell({{Spell[0]}})], ActionList([PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), PayMana({{ManaCost[0]}})), IfElse(CostWasPaid, [CreateTokens([LanderToken])], [CounterSpell(Ref_TargetSpell)])]))",
    "Counter target {{Spell}} unless its controller pays {{ManaCost}}. If they do, you incubate {{Digits}}": "Targeted([TargetSpell({{Spell[0]}})], ActionList([PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), PayMana({{ManaCost[0]}})), IfElse(CostWasPaid, [Incubate({{Digits[0]}})], [CounterSpell(Ref_TargetSpell)])]))",
    "Counter target {{Spell}} unless its controller pays {{ManaCost}}. If {{Condition}}, counter that spell unless its controller pays {{ManaCost}} instead": "Targeted([TargetSpell({{Spell[0]}})], ActionList([IfElse({{Condition[0]}}, [PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), PayMana({{ManaCost[1]}})), Unless(CostWasPaid, [CounterSpell(Ref_TargetSpell)])], [PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [CounterSpell(Ref_TargetSpell)])])]))",
    "Counter target {{Spell}} unless its controller pays {{ManaCost}}. If {{Condition}}, draw a card": "Targeted([TargetSpell({{Spell[0]}})], ActionList([PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [CounterSpell(Ref_TargetSpell), If({{Condition[0]}}, [DrawACard])])]))",
    "Counter target {{Spell}} unless its controller pays {{ManaCost}}. If {{Condition}}, instead counter that spell, then scry {{Digits}}": "Targeted([TargetSpell({{Spell[0]}})], ActionList([IfElse({{Condition[0]}}, [CounterSpell(Ref_TargetSpell), Scry({{Digits[0]}})], [PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [CounterSpell(Ref_TargetSpell)])])]))",
    "Counter target {{Spell}} unless its controller pays {{ManaCost}}. Scry {{Digits}}": "Targeted([TargetSpell({{Spell[0]}})], ActionList([PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [CounterSpell(Ref_TargetSpell), Scry({{Digits[0]}})])]))",
    "Counter target {{Spell}} unless its controller pays {{ManaCost}}. That player discards a card": "Targeted([TargetSpell({{Spell[0]}})], ActionList([PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [CounterSpell(Ref_TargetSpell), PlayerAction(ControllerOfSpell(Ref_TargetSpell), DiscardACard)])]))",
    "Counter target {{Spell}} unless its controller pays {{ManaCost}}. You create {{a}} {{PT}} {{CreatureToken}}. It has \"{{TokenQuotedAbility}}\"": "Targeted([TargetSpell({{Spell[0]}})], ActionList([PlayerMayCost(ControllerOfTargetSpell, PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [CounterSpell(Ref_TargetSpell)]), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{TokenQuotedAbility[0]}}])])]))",
    "Counter target {{Spell}} unless its controller pays {{ManaCost}}. You gain {{Digits}} life": "Targeted([TargetSpell({{Spell[0]}})], ActionList([PlayerMayCost(ControllerOfSpell(Ref_TargetSpell), PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [CounterSpell(Ref_TargetSpell), GainLife({{Digits[0]}})])]))",
    "Counter target {{Spell}}, then proliferate": "Targeted([TargetSpell({{Spell[0]}})], ActionList([CounterSpell(Ref_TargetSpell), Proliferate]))",
    "Counter target {{Spell}}.\nAmass {{Zombies}} {{Digits}}": "Targeted([TargetSpell({{Spell[0]}})], ActionList([CounterSpell(Ref_TargetSpell), Amass({{Digits[0]}}, {{Zombies[0]}})]))",
    "Counter target {{Spell}}.\nAt the beginning of your next upkeep, pay {{ManaCost}}. If you don't, you lose the game": "Targeted([TargetSpell({{Spell[0]}})], ActionList([CounterSpell(Ref_TargetSpell), CreateFutureTrigger(AtTheBeginningOfPlayersNextUpkeep(You), ActionList([MustCost(PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [LoseTheGame])]))]))",
    "Counter target {{Spell}}.\nDraw a card": "Targeted([TargetSpell({{Spell[0]}})], ActionList([CounterSpell(Ref_TargetSpell), DrawACard]))",
    "Counter target {{Spell}}.\nDraw a card, then mill {{Number}} cards.\nUntap target {{Permanent}}": "Targeted([TargetSpell({{Spell[0]}}), TargetPermanent({{Permanent[0]}})], ActionList([CounterSpell(Ref_TargetSpell), DrawACard, MillNumberCards({{Number[0]}}), UntapPermanent(Ref_TargetPermanent)]))",
    "Counter target {{Spell}}.\nInvestigate {{Number}} times": "Targeted([TargetSpell({{Spell[0]}})], ActionList([CounterSpell(Ref_TargetSpell), InvestigateTimes({{Number[0]}})]))",
    "Counter target {{Spell}}.\nSurveil {{Digits}}": "Targeted([TargetSpell({{Spell[0]}})], ActionList([CounterSpell(Ref_TargetSpell), Surveil({{Digits[0]}})]))",
    "Counter target {{Spell}}.\n{{AbilityWord}} - If {{Condition}}, draw a card": "Targeted([TargetSpell({{Spell[0]}})], ActionList([CounterSpell(Ref_TargetSpell), If({{Condition[0]}}, [DrawACard])]))",
    "Counter target {{Spell}}.\n{{AbilityWord}} - If {{Condition}}, search the graveyard, hand, and library of that spell's controller for any number of cards with the same name as that spell, exile those cards, then that player shuffles": "Targeted([TargetSpell({{Spell[0]}})], ActionList([CounterSpell(Ref_TargetSpell), If({{Condition[0]}}, [SearchPlayersLibraryAndGraveyardAndHand(ControllerOfSpell(Ref_TargetSpell), [FindAnyNumberOfCardsOfType(SharesANameWithSpell(Ref_TargetSpell)), ExileFoundCards, Shuffle])])]))",
    "Counter target {{Spell}}.\n{{AbilityWord}} - If {{Condition}}, you may copy the spell countered this way. You may choose new targets for the copy": "Targeted([TargetSpell({{Spell[0]}})], ActionList([CounterSpell(Ref_TargetSpell), If({{Condition[0]}}, [MayAction(CopySpellAndMayChooseNewTargets(Ref_TargetSpell))])]))",
    "Counter target {{Spell}}. At the beginning of your next first main phase, add X mana in any combination of colors, where X is {{GameNumber(ThatSpell)}}": "Targeted([TargetSpell({{Spell[0]}})], ActionList([CounterSpell(Ref_TargetSpell), CreateFutureTrigger(AtTheBeginningOfPlayersNextFirstMainPhase(You), ActionList([AddCombinationMana(AnyManaColor, {{GameNumber(ThatSpell=Ref_TargetSpell)[0]}})]))]))",
