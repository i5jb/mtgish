    "Whenever {{a}} {{Creature}} dies, {{TriggerActions[EquippedCreature]}}": "TriggerA(WhenACreatureOrPlaneswalkerDies({{Creature[0]}}), {{TriggerActions[EquippedCreature][0]}})",
