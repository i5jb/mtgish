    "Mill a card. You may play that card this turn": "ActionList([MillACard, CreatePlayerEffectUntil(You, [MayPlayCardsMilledThisWay], UntilEndOfTurn)])",
    "Mill a card. You may put {{a}} {{SpecificCard}} milled this way into your hand": "ActionList([MillACard, MayAction(PutACardOfTypeMilledThisWayIntoHand({{SpecificCard[0]}}))])",
    "Mill a card. You may put {{a}} {{SpecificCard}} milled this way into your hand. You gain {{Digits}} life if {{a}} {{SpecificCard}} is milled this way": "ActionList([MillACard, MayAction(PutACardOfTypeMilledThisWayIntoHand({{SpecificCard[0]}})), If(ACardWasMilledThisWay({{SpecificCard[1]}}), [GainLife({{Digits[0]}})])])",
    "Mill {{Number}} cards": "ActionList([MillNumberCards({{Number[0]}})])",
    "Mill {{Number}} cards, then put any number of {{SpecificCards}} milled this way into your hand": "ActionList([MillNumberCards({{Number[0]}}), ReturnAnyNumberCardsMilledThisWayToHand({{SpecificCards[0]}})])",
    "Mill {{Number}} cards, then return {{a}} {{SpecificCard}} from your graveyard to the battlefield": "ActionList([MillNumberCards({{Number[0]}}), ReturnACardFromGraveyardToBattlefield({{SpecificCard[0]}}, [EntersNormally])])",
    "Mill {{Number}} cards, then return {{a}} {{SpecificCard}} from your graveyard to the battlefield tapped": "ActionList([MillNumberCards({{Number[0]}}), ReturnACardFromGraveyardToBattlefield({{SpecificCard[0]}}, [EntersTapped])])",
    "Mill {{Number}} cards, then return {{a}} {{SpecificCard}} from your graveyard to your hand": "ActionList([MillNumberCards({{Number[0]}}), PutACardFromGraveyardIntoHand({{SpecificCard[0]}})])",
    "Mill {{Number}} cards, then return {{a}} {{SpecificCard}} of an opponent's choice from your graveyard to your hand": "ActionList([MillNumberCards({{Number[0]}}), APlayerAction(Opponent, ChooseACardInPlayersGraveyard({{SpecificCard[0]}}, You)), ReturnGraveyardCardToHand(TheChosenGraveyardCard)])",
    "Mill {{Number}} cards, then you may return {{a}} {{SpecificCard}} from your graveyard to the battlefield": "ActionList([MillNumberCards({{Number[0]}}), MayAction(PutACardFromPlayersGraveyardOnBattlefield({{SpecificCard[0]}}, You, [EntersNormally]))])",
    "Mill {{Number}} cards, then you may return {{a}} {{SpecificCard}} from your graveyard to your hand": "ActionList([MillNumberCards({{Number[0]}}), MayAction(PutACardFromGraveyardIntoHand({{SpecificCard[0]}}))])",
    "Mill {{Number}} cards. If at least one {{SpecificCard}} is milled this way, each opponent loses {{Digits}} life and you gain {{Digits}} life": "ActionList([MillNumberCards({{Number[0]}}), If(ACardWasMilledThisWay({{SpecificCard[0]}}), [EachPlayerAction(Opponent, LoseLife({{Digits[0]}})), GainLife({{Digits[1]}})])])",
    "Mill {{Number}} cards. Put all creature cards with activated abilities that aren't mana abilities from among the milled cards into your hand": "ActionList([MillNumberCards({{Number[0]}}), PutEachGraveyardCardIntoHand(CardsOfTypeMilledThisWay(And([IsCardtype(Creature), HasAbility(NonManaAbility)])))])",
    "Mill {{Number}} cards. Return all {{SpecificCards}} from your graveyard to the battlefield, then do the same for {{SpecificCards}}": "ActionList([MillNumberCards({{Number[0]}}), ReturnEachCardFromPlayersGraveyardToBattlefield({{SpecificCards[0]}}, You, [EntersNormally]), ReturnEachCardFromPlayersGraveyardToBattlefield({{SpecificCards[1]}}, You, [EntersNormally])])",
    "Mill {{Number}} cards. Then you may put {{a}} {{SpecificCard}} from your graveyard on top of your library": "ActionList([MillNumberCards({{Number[0]}}), MayAction(ReturnACardFromGraveyardToTopOfLibrary({{SpecificCard[0]}}))])",
    "Mill {{Number}} cards. You gain {{Digits}} life for each {{SpecificCard}} milled this way": "ActionList([MillNumberCards({{Number[0]}}), GainLifeForEach({{Digits[0]}}, NumCardsMilledThisWay({{SpecificCard[0]}}))])",
    "Mill {{Number}} cards. You may put a permanent card from among the milled cards into your hand": "ActionList([MillNumberCards({{Number[0]}}), MayAction(PutACardFromGraveyardIntoHand(CardsOfTypeMilledThisWay(IsPermanent)))])",
    "Mill {{Number}} cards. You may put {{a}} {{SpecificCard}} from among them into your hand": "ActionList([MillNumberCards({{Number[0]}}), PutACardOfTypeMilledThisWayIntoHand({{SpecificCard[0]}})])",
