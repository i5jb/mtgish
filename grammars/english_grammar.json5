    "end the turn": "ActionList([EndTheTurn])",
    "exchange control of a permanent you control chosen at random and a permanent target opponent controls chosen at random": "Targeted([TargetPlayer(Opponent)], ActionList([ChooseAPermanentAtRandom(ControlledByAPlayer(SinglePlayer(You))), ChooseASecondPermanentAtRandom(ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))), ExchangeControl(TheChosenPermanent, TheSecondChosenPermanent)]))",
    "exchange control of target {{Permanent}} and target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}}), TargetPermanent({{Permanent[0]}})], ActionList([ExchangeControl(Ref_TargetPermanent1, Ref_TargetPermanent2)]))",
    "exchange control of two target permanents that share a card type": "Targeted([NumberTargetGroupPermanents(Integer(2), AnyPermanent, ShareACardType)], ActionList([ExchangeControl(Ref_TargetPermanents_0, Ref_TargetPermanents_1)]))",
    "exile a card at random from each opponent's graveyard. You may cast any number of spells from among cards exiled this way without paying their mana costs. Then each player who owns a spell you cast this way loses life equal to its mana value": "ActionList([Exile([AGraveyardCardAtRandomInEachPlayersGraveyard(AnyCardInAnyGraveyard, Opponent)]), CastAnyNumberOfExiledCardsWithoutPaying(TheCardsExiledThisWay), EachPlayerAction(OwnsASpell(TheSpellsCastThisWay), LoseLife(TotalManaValueOfSpells(And([TheSpellsCastThisWay, OwnedByAPlayer(SinglePlayer(EachablePlayer))]))))])",
