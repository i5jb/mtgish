    "Remove {{Number}} {{CounterType}} counters from this land and sacrifice it": "And([RemoveNumberCountersOfTypeFromPermanent({{Number[0]}}, {{CounterType[0]}}, {{~Permanent}}), SacrificePermanent({{~Permanent}})])",
    "Remove {{Number}} {{CounterType}} counters from {{~Permanent}} and sacrifice it": "And([RemoveNumberCountersOfTypeFromPermanent({{Number[0]}}, {{CounterType[0]}}, {{~Permanent}}), SacrificePermanent({{~Permanent}})])",
    "Remove {{a}} {{CounterType}} counter from this enchantment and sacrifice it": "And([RemoveACounterOfTypeFromPermanent({{CounterType[0]}}, {{~Permanent}}), SacrificePermanent({{~Permanent}})])"
  },
  "{{RemoveCountersFromAPermanentCost(ThatPermanent)}}": {
