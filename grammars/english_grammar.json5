    "Whenever equipped creature becomes blocked by one or more {{Creatures}}, {{TriggerActions(ThatPermanent)}}": "TriggerA(WhenACreatureBecomesBlockedByAnyNumberOfCreatures(SinglePermanent(HostPermanent), {{Creatures[0]}}), {{TriggerActions(ThatPermanent=Trigger_ThatCreature)[0]}})",
    "Whenever equipped creature becomes blocked by {{a}} {{Creature}}, {{TriggerActions}}": "TriggerA(WhenACreatureBecomesBlockedByACreature(SinglePermanent(HostPermanent), {{Creature[0]}}), {{TriggerActions[0]}})",
