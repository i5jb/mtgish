  "{{DiscardACardCostX}}": {
    "Discard a card with mana value X": "DiscardACardOfType(ManaValueIs(EqualTo(ValueX)))"
  },
  "{{DiscardACardCost}}": {
    "Discard a card": "DiscardACard",
    "Discard a card at random": "DiscardACardAtRandom",
    "Discard a creature card": "DiscardACardOfType(IsCardtype(Creature))",
    "Discard a historic card": "DiscardACardOfType(IsHistoric)",
    "Discard a land card": "DiscardACardOfType(IsCardtype(Land))",
    "Discard a land card or Shrine card": "DiscardACardOfType(Or([IsCardtype(Land), IsEnchantmentType(Shrine)]))",
    "Discard a legendary card": "DiscardACardOfType(IsSupertype(Legendary))",
    "Discard a {{NonBlack}} card": "DiscardACardOfType(IsNonColor({{NonBlack[0]}}))",
    "Discard an artifact card": "DiscardACardOfType(IsCardtype(Artifact))",
    "Discard an enchantment, instant, or sorcery card": "DiscardACardOfType(Or([IsCardtype(Enchantment), IsCardtype(Instant), IsCardtype(Sorcery)]))",
    "Discard another card named {{NamedCard}}": "DiscardACardOfType(IsNamed(NamedCard({{NamedCard[0]}})))",
    "Discard the last card you drew this turn": "DiscardCard(TheLastCardDrawnThisTurn)",
    "Discard {{a}} {{Black}} card": "DiscardACardOfType(IsColor({{Black[0]}}))",
    "Discard {{a}} {{Swamp}} card or {{a}} {{Black}} card": "DiscardACardOfType(Or([IsLandType({{Swamp[0]}}), IsColor({{Black[0]}})]))",
    "Discard {{a}} {{Zombie}} card": "DiscardACardOfType(IsCreatureType({{Zombie[0]}}))",
    "Discard {{a}} {{Zombie}} or Arcane card": "DiscardACardOfType(Or([IsCreatureType({{Zombie[0]}}), IsSpellType(Arcane)]))"
  },
  "{{DiscardCardsCostX}}": {
    "Discard X cards": "DiscardNumberCards(ValueX)"
  },
  "{{DiscardCardsCost}}": {
    "Discard your hand": "DiscardHand",
    "Discard {{Number}} artifact cards": "DiscardNumberCardsOfType({{Number[0]}}, IsCardtype(Artifact))",
    "Discard {{Number}} cards": "DiscardNumberCards({{Number[0]}})",
    "Discard {{Number}} cards at random": "DiscardNumberCardsAtRandom({{Number[0]}})",
    "Discard {{Number}} cards with different names": "DiscardNumberGroupCards({{Number[0]}}, DifferentNames)",
    "Discard {{Number}} nonland cards with the same name": "DiscardNumberGroupCardsOfType({{Number[0]}}, IsNonCardtype(Land), SameNames)"
  },
  "{{DiscardSelfCost(~HandCard)}}": {
    "Discard this card": "DiscardCard({{~HandCard}})",
    "Discard {{~HandCard}}": "DiscardCard({{~HandCard}})"
  },
  "{{DraftEffect}}": {
    "Draft this card face up.\nAs long as this card is face up during the draft, you can't look at booster packs and must draft cards at random. After you draft {{Number}} cards this way, turn this card face down": "AsSelfDraft([DraftFaceUp]), FaceUpDraftEffect(DraftCardsAtRandomUntilNumberCardsHaveBeenDrafted_TurnThisDraftCardFaceDown({{Number[0]}}))",
    "Draft this card face up.\nAs you draft a card, you may draft an additional card from that booster pack. If you do, put this card into that booster pack": "AsSelfDraft([DraftFaceUp]), FaceUpDraftEffect(AsDraftACardMayDraftAnAdditionalCardFromPack_PutThisDraftCardIntoThatBooster)",
    "Draft this card face up.\nAs you draft a card, you may draft an additional card from that booster pack. If you do, turn this card face down, then pass the next booster pack without drafting a card from it": "AsSelfDraft([DraftFaceUp]), FaceUpDraftEffect(AsDraftACardMayDraftAnAdditionalCardFromPack_TurnThisDraftCardCardFaceDown_PassNextBoosterWithoutDrafting)",
    "Draft this card face up.\nAs you draft a card, you may remove it from the draft face down": "AsSelfDraft([DraftFaceUp]), FaceUpDraftEffect(MayRemoveCardsFromDraftFaceDown)",
    "Draft this card face up.\nAs you draft a card, you may remove it from the draft face up": "AsSelfDraft([DraftFaceUp]), FaceUpDraftEffect(MayRemoveCardsFromDraftFaceUp)",
    "Draft this card face up.\nAs you draft a card, you may reveal it, note its name, then turn this card face down": "AsSelfDraft([DraftFaceUp]), FaceUpDraftEffect(AsDraftACard_MayRevealIt_NoteItsName_TurnThisDraftCardFaceDown)",
    "Draft this card face up.\nAs you draft {{a}} {{SpecificCard}}, you may reveal it, note its creature types, then turn this card face down": "AsSelfDraft([DraftFaceUp]), FaceUpDraftEffect(AsDraftACardOfType_MayRevealIt_NoteItsCreatureTypes_TurnThisDraftCardFaceDown({{SpecificCard[0]}}))",
    "Draft this card face up.\nAs you draft {{a}} {{SpecificCard}}, you may reveal it, note its name, then turn this card face down": "AsSelfDraft([DraftFaceUp]), FaceUpDraftEffect(AsDraftACardOfType_MayRevealIt_NoteItsName_TurnThisDraftCardFaceDown({{SpecificCard[0]}}))",
    "Draft this card face up.\nDuring the draft, you may turn this card face down. If you do, look at any unopened booster pack in the draft or any booster pack not being looked at by another player": "AsSelfDraft([DraftFaceUp]), FaceUpDraftEffect(MayTurnThisDraftCardFaceDown_LookAtAnUnopenedBoosterPackOrABoosterPackNotBeingLookedAt)",
    "Draft this card face up.\nDuring the draft, you may turn this card face down. If you do, look at the next card drafted by a player of your choice": "AsSelfDraft([DraftFaceUp]), FaceUpDraftEffect(MayTurnThisDraftCardFaceDown_LookAtNextCardDraftedByPlayerOfChoice)",
    "Draft this card face up.\nEach player passes the last card from each booster pack to a player who drafted a card named {{NamedCard}}": "AsSelfDraft([DraftFaceUp]), FaceUpDraftEffect(LastCardInEachBoosterGoesToThisPlayer)",
    "Draft this card face up.\nImmediately after the draft, you may reveal a card in your card pool. Each other player may offer you one card in their card pool in exchange. You may accept any one offer": "AsSelfDraft([DraftFaceUp]), FaceUpDraftEffect(AfterDraftMayOfferATradeWithOtherPlayers)",
    "Draft this card face up.\nInstead of drafting a card from a booster pack, you may draft each card in that booster pack, one at a time. If you do, turn this card face down and you can't draft cards for the rest of this draft round": "AsSelfDraft([DraftFaceUp]), FaceUpDraftEffect(MayTurnThisDraftCardFaceDown_DraftEachCardInCurrentBoosterPackInsteadOfDraftingCardsThisRound)",
    "Reveal this card as you draft it and note how many cards you've drafted this draft round, including this card": "AsSelfDraft([RevealThisDraftedCard, NoteNumberOfCardsDraftedThisRound])",
    "Reveal this card as you draft it and note the player who passed it to you": "AsSelfDraft([RevealThisDraftedCard, NotePlayerWhoPassedPackToYou])",
    "Reveal this card as you draft it. After you draft this card, you may add a booster pack to the draft": "AsSelfDraft([RevealThisDraftedCard, MayAddBoosterBackToDraft])",
    "Reveal this card as you draft it. Reveal the next card you draft and note its name": "AsSelfDraft([RevealThisDraftedCard, RevealAndNoteNameOfNextDraftedCard])",
    "Reveal this card as you draft it. The next time a player drafts a card from this booster pack, guess that card's name. Then that player reveals the drafted card": "AsSelfDraft([RevealThisDraftedCard, GuessNameOfNextCardAPlayerDraftsFromThisPackAndTheyRevealThatCard])",
    "Reveal this card as you draft it. The player to your right chooses a color, you choose another color, then the player to your left chooses a third color": "AsSelfDraft([RevealThisDraftedCard, PlayerToRightChoosesAColor_YouChooseAColor_PlayerToLeftChoosesAColor])",
    "Reveal this card as you draft it. You may look at the next card drafted from this booster pack": "AsSelfDraft([RevealThisDraftedCard, MayLookAtNextCraftDraftedFromThisPack])"
  },
  "{{DungeonAction}}": {
    "Create a Treasure token": "ActionList([CreateTokens([TreasureToken])])",
    "Create a token that's a copy of one of your commanders, except it's not legendary": "ActionList([CreateTokens([TokenCopyOfCommander(TokenCopyEffects([RemoveSupertypes([Legendary])]))])])",
    "Create {{NamedCard}}, a legendary {{PT}} {{Black}} {{Zombie}} {{Zombie}} creature token with {{Hasable}}": "ActionList([CreateTokens([NamedTokenWithPT({{NamedCard[0]}}, {{PT[0]}}, Colors([{{Black[0]}}]), [Legendary], [Creature], SubtypesList([{{Zombie[0]}}, {{Zombie[1]}}]), [{{Hasable[0]}}])])])",
    "Create {{Number}} {{PT}} {{CreatureTokens}}": "ActionList([CreateTokens([NumberTokens({{Number[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])])",
    "Create {{Number}} {{PT}} {{CreatureTokens}} with {{Hasable}}": "ActionList([CreateTokens([NumberTokens({{Number[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}]))])])",
    "Create {{a}} {{PT}} {{CreatureToken}}": "ActionList([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])])",
    "Create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}}": "ActionList([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])])])",
    "Discard a card and sacrifice {{a}} {{Permanent}}, {{a}} {{Permanent}}, and {{a}} {{Permanent}}": "ActionList([DiscardACard, SacrificePermanents([{{Permanent[0]}}, {{Permanent[1]}}, {{Permanent[2]}}])])",
    "Distribute three {{CounterType}} counters among up to three target {{Permanents}}": "TargetedDistributed([UptoNumberTargetPermanents(Integer(3), {{Permanents[0]}})], DistributeNumberAmongTargets(Integer(3)), ActionList([PutDistributedCounters({{CounterType[0]}})]))",
    "Draw a card": "ActionList([DrawACard])",
    "Draw {{Number}} cards": "ActionList([DrawNumberCards({{Number[0]}})])",
    "Draw {{Number}} cards and reveal them. You may cast one of them without paying its mana cost": "ActionList([DrawNumberCards({{Number[0]}}), RevealTheCardsDrawnThisWay, CastASpellDrawnThisWayWithoutPaying])",
    "Each opponent loses {{Digits}} life": "ActionList([EachPlayerAction(Opponent, LoseLife({{Digits[0]}}))])",
    "Each opponent loses {{Digits}} life and you gain {{Digits}} life": "ActionList([EachPlayerAction(Opponent, LoseLife({{Digits[0]}})), GainLife({{Digits[1]}})])",
    "Each player loses {{Digits}} life": "ActionList([EachPlayerAction(AnyPlayer, LoseLife({{Digits[0]}}))])",
    "Each player loses {{Digits}} life unless they discard a card": "ActionList([EachPlayerMayCost(AnyPlayer, DiscardACard), EachPlayerAction(DidntPayCost, LoseLife({{Digits[0]}}))])",
    "Each player loses {{Digits}} life unless they sacrifice {{a}} {{Permanent}} of their choice": "ActionList([EachPlayerMayCost(AnyPlayer, SacrificeAPermanent({{Permanent[0]}})), EachPlayerAction(DidntPayCost, LoseLife({{Digits[0]}}))])",
    "Exile the top {{Number}} cards of your library. You may play them": "ActionList([ExileTheTopNumberCardsOfLibrary({{Number[0]}}), PlayAnyNumberOfExiledCards(TheCardsExiledThisWay)])",
    "For each opponent, goad up to one target {{Creature}} that player controls": "Targeted([TargetPermanentEachPlayerControls({{Creature[0]}}, Opponent)], ActionList([GoadEachCreature(Ref_TargetPermanents)]))",
    "Goad target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([GoadCreature(Ref_TargetPermanent)]))",
    "Put {{Number}} {{CounterType}} counters on target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[0]}}, Ref_TargetPermanent)]))",
    "Put {{a}} {{CounterType}} counter on target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent)]))",
    "Return up to {{Number}} target {{SpecificCards}} from your graveyard to your hand": "Targeted([UptoNumberTargetGraveyardCards({{Number[0]}}, And([{{SpecificCards[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutEachGraveyardCardIntoHand(Ref_TargetGraveyardCards)]))",
    "Reveal the top {{Number}} cards of your library and put them into your hand. Each opponent loses life equal to those cards' total mana value": "ActionList([RevealTheTopNumberCardsOfLibrary({{Number[0]}}, [PutTheRemainingCardsIntoHand]), EachPlayerAction(Opponent, LoseLife(ManaValueOfTheCardsRevealedThisWay))])",
    "Reveal the top {{Number}} cards of your library. Put {{a}} {{SpecificCard}} from among them onto the battlefield with {{Number}} {{CounterType}} counters on it. It gains {{Hasable}} until your next turn. Then shuffle": "ActionList([RevealTheTopNumberCardsOfLibrary({{Number[0]}}, [PutACardOfTypeOntoTheBattlefield({{SpecificCard[0]}}, [EntersWithNumberCounters({{Number[1]}}, {{CounterType[0]}})]), CreatePermanentLayerEffectUntil(ThePermanentPutOnTheBattlefieldThisWay, [AddAbility([{{Hasable[0]}}])], UntilPlayersNextTurn(You)), PutTheRemainingCardsBackIntoLibraryAndShuffle])])",
    "Roll 2d4 and create that many Treasure tokens": "ActionList([RollAD4, CreateTokens([NumberTokens(TheDiceResult, TreasureToken)])])",
    "Scry {{Digits}}": "ActionList([Scry({{Digits[0]}})])",
    "Search your library for {{a}} {{SpecificCard}}, reveal it, put it into your hand, then shuffle": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])",
    "Target player loses {{Digits}} life": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, LoseLife({{Digits[0]}}))]))",
    "Target {{Creature}} can't attack until your next turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [CantAttack], UntilPlayersNextTurn(You))]))",
    "Target {{Creature}} gets {{PTMod}} until your next turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilPlayersNextTurn(You))]))",
    "You gain {{Digits}} life": "ActionList([GainLife({{Digits[0]}})])",
    "You get an emblem with \"{{EmblemQuotedAbility}}\"": "ActionList([GetAnEmblem([{{EmblemQuotedAbility[0]}}])])",
    "You may put {{a}} {{SpecificCard}} from your hand onto the battlefield": "ActionList([MayAction(PutACardFromHandOnBattlefield({{SpecificCard[0]}}, [EntersNormally]))])",
    "You may sacrifice {{a}} {{Permanent}}. If you do, draw a card": "ActionList([MayCost(SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [DrawACard])])",
    "{{Creatures}} get {{PTMod}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])",
    "{{PotentialSpells}} you cast this turn cost {{CostReduce}} less to cast": "ActionList([CreatePlayerEffectUntil(You, [DecreaseSpellCost({{PotentialSpells[0]}}, {{CostReduce[0]}})], UntilEndOfTurn)])"
  },
  "{{Eachable(ThatPermanent)}}": {
    "Aura and Equipment attached to it": "TheNumberOfPermanentsOnTheBattlefield(And([Or([IsEnchantmentType(Aura), IsArtifactType(Equipment)]), AttachedToPermanent({{ThatPermanent}})]))",
    "Aura attached to it": "TheNumberOfPermanentsOnTheBattlefield(And([IsEnchantmentType(Aura), AttachedToPermanent({{ThatPermanent}})]))",
    "Equipment attached to him": "TheNumberOfPermanentsOnTheBattlefield(And([IsArtifactType(Equipment), AttachedToPermanent({{ThatPermanent}})]))",
    "Equipment attached to it": "TheNumberOfPermanentsOnTheBattlefield(And([IsArtifactType(Equipment), AttachedToPermanent({{ThatPermanent}})]))",
    "card exiled with it": "NumCardsInExile(WasExiledWithPermanent({{ThatPermanent}}))",
    "card in its controller's hand": "TheNumberOfCardsInPlayersHand(ControllerOfPermanent({{ThatPermanent}}))",
    "color among other legendary permanents you control": "NumColorsAmongPermanents(And([Other({{ThatPermanent}}), IsSupertype(Legendary), ControlledByAPlayer(SinglePlayer(You))]))",
    "counter on it": "NumCountersOnPermanent({{ThatPermanent}})",
    "creature blocking it": "TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), IsBlockingAttacker({{ThatPermanent}})]))",
    "creature blocking it beyond the first": "Minus(TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), IsBlockingAttacker({{ThatPermanent}})])), Integer(1))",
    "creature it's blocking": "TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), IsBlockedByDefender({{ThatPermanent}})]))",
    "creature that crewed it this turn": "TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), CrewedVehicleThisTurn({{ThatPermanent}})]))",
    "kind of counter on it": "TheNumberOfCounterTypesAmongPermanents(SinglePermanent({{ThatPermanent}}))",
    "of its colors": "NumColorsOfPermanent({{ThatPermanent}})",
    "other artifact you control": "TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatPermanent}}), IsCardtype(Artifact), ControlledByAPlayer(SinglePlayer(You))]))",
    "other attacking creature": "TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatPermanent}}), IsAttacking, IsCardtype(Creature)]))",
    "other attacking creature that shares a creature type with it": "TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatPermanent}}), IsAttacking, IsCardtype(Creature), SharesACreatureTypeWithPermanent({{ThatPermanent}})]))",
    "other attacking {{Zombie}}": "TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatPermanent}}), IsAttacking, IsCreatureType({{Zombie[0]}})]))",
    "other creature and/or artifact you control": "TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatPermanent}}), Or([IsCardtype(Creature), IsCardtype(Artifact)]), ControlledByAPlayer(SinglePlayer(You))]))",
    "other creature its controller controls that shares a creature type with it": "TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatPermanent}}), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(ControllerOfPermanent({{ThatPermanent}}))), SharesACreatureTypeWithPermanent({{ThatPermanent}})]))",
    "other creature named {{NamedCard}} you control": "TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatPermanent}}), IsCardtype(Creature), IsNamed(NamedCard({{NamedCard[0]}})), ControlledByAPlayer(SinglePlayer(You))]))",
    "other creature on the battlefield": "TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatPermanent}}), IsCardtype(Creature)]))",
    "other creature on the battlefield named {{NamedCard}}": "TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatPermanent}}), IsCardtype(Creature), IsNamed(NamedCard({{NamedCard[0]}}))]))",
    "other creature on the battlefield that shares a creature type with it": "TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatPermanent}}), IsCardtype(Creature), SharesACreatureTypeWithPermanent({{ThatPermanent}})]))",
    "other creature on the battlefield that shares at least one creature type with it": "TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatPermanent}}), IsCardtype(Creature), SharesACreatureTypeWithPermanent({{ThatPermanent}})]))",
    "other creature on the battlefield with {{CheckHasable}}": "TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatPermanent}}), IsCardtype(Creature), HasAbility({{CheckHasable[0]}})]))",
    "other creature you control": "TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatPermanent}}), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))",
    "other creature you control named {{NamedCard}}": "TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatPermanent}}), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), IsNamed(NamedCard({{NamedCard[0]}}))]))",
    "other creature you control that shares a creature type with it": "TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatPermanent}}), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), SharesACreatureTypeWithPermanent({{ThatPermanent}})]))",
    "other creature you control with the same name as that creature": "TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatPermanent}}), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), SharesANameWithPermanent({{ThatPermanent}})]))",
    "other creature you control with {{CheckHasable}}": "TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatPermanent}}), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), HasAbility({{CheckHasable[0]}})]))",
    "other creature you control with {{a}} {{CounterType}} counter on it": "TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatPermanent}}), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), HasACounterOfType({{CounterType[0]}})]))",
    "other enchantment on the battlefield": "TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatPermanent}}), IsCardtype(Enchantment)]))",
    "other legendary creature you control": "TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatPermanent}}), IsSupertype(Legendary), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))",
    "other modified creature you control": "TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatPermanent}}), IsModified, IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))",
    "other nontoken {{Zombie}} you control": "TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatPermanent}}), IsNonToken, IsCreatureType({{Zombie[0]}}), ControlledByAPlayer(SinglePlayer(You))]))",
    "other permanent you control with mana value {{Digits}} or greater": "TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatPermanent}}), ControlledByAPlayer(SinglePlayer(You)), ManaValueIs(GreaterThanOrEqualTo({{Digits[0]}}))]))",
    "other permanent you control with {{a}} {{CounterType}} counter on it": "TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatPermanent}}), ControlledByAPlayer(SinglePlayer(You)), HasACounterOfType({{CounterType[0]}})]))",
    "other snow permanent you control": "TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatPermanent}}), IsSupertype(Snow), ControlledByAPlayer(SinglePlayer(You))]))",
    "other {{Black}} creature you control": "TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatPermanent}}), IsColor({{Black[0]}}), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))",
    "other {{Swamp}} you control": "TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatPermanent}}), IsLandType({{Swamp[0]}}), ControlledByAPlayer(SinglePlayer(You))]))",
    "other {{Zombie}} and/or Food you control": "TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatPermanent}}), Or([IsCreatureType({{Zombie[0]}}), IsArtifactType(Food)]), ControlledByAPlayer(SinglePlayer(You))]))",
    "other {{Zombie}} and/or {{Zombie}} you control": "TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatPermanent}}), Or([IsCreatureType({{Zombie[0]}}), IsCreatureType({{Zombie[1]}})]), ControlledByAPlayer(SinglePlayer(You))]))",
    "other {{Zombie}} on the battlefield": "TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatPermanent}}), IsCreatureType({{Zombie[0]}})]))",
    "other {{Zombie}} that entered the battlefield under your control this turn": "NumEnteredTheBattlefieldThisTurn(And([Other({{ThatPermanent}}), IsCreatureType({{Zombie[0]}}), ControlledByAPlayer(SinglePlayer(You))]))",
    "other {{Zombie}} you control": "TheNumberOfPermanentsOnTheBattlefield(And([Other({{ThatPermanent}}), IsCreatureType({{Zombie[0]}}), ControlledByAPlayer(SinglePlayer(You))]))",
    "point of bushido it has": "NumPointsOfBushidoPermanentHas({{ThatPermanent}})",
    "poison counter its controller has": "TheNumberOfPoisonCountersPlayerHas(ControllerOfPermanent({{ThatPermanent}}))",
    "supertype, card type, and subtype it has": "Plus3(TheNumberOfSupertypesPermanentHas({{ThatPermanent}}), TheNumberOfCardTypesPermanentHas({{ThatPermanent}}), TheNumberOfSubtypesPermanentHas({{ThatPermanent}}))",
    "time it has attacked this turn": "NumTimesPermanentAttackedThisTurn({{ThatPermanent}})",
    "time it regenerated this turn": "NumTimesPermanentRegeneratedThisTurn({{ThatPermanent}})",
    "time this creature attacked this game": "TheNumberOfTimesCreatureAttackedThisGame({{ThatPermanent}})",
    "{{Black}} mana symbol in its mana cost": "NumColorManaSymbolsInCostsOfPermanent({{Black[0]}}, {{ThatPermanent}})",
    "{{CounterType}} counter among other creatures you control": "NumCountersOfTypeOnPermanents({{CounterType[0]}}, And([Other({{ThatPermanent}}), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))",
    "{{CounterType}} counter on it": "NumCountersOfTypeOnPermanent({{CounterType[0]}}, {{ThatPermanent}})",
    "{{CounterType}} counter on other creatures you control": "NumCountersOfTypeOnPermanents({{CounterType[0]}}, And([Other({{ThatPermanent}}), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))"
  },
