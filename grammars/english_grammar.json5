    "Each player chooses {{Number}} nonland permanents they control. Destroy all other nonland permanents": "ActionList([EachPlayerAction(AnyPlayer, ChooseNumberPermanents({{Number[0]}}, And([IsNonCardtype(Land), IsPermanent, ControlledByAPlayer(SinglePlayer(ActionPlayer))]))), DestroyEachPermanent(ThePermanentsNotChosenThisWay)])",
    "Each player discards a card": "ActionList([EachPlayerAction(AnyPlayer, DiscardACard)])",
