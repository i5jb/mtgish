    "Whenever equipped creature deals combat damage to a player, {{TriggerActions(ThatMuch)}}": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(HostPermanent), AnyPlayer), {{TriggerActions(ThatMuch=Trigger_AmountOfDamageDealt)[0]}})",
    "Whenever equipped creature deals combat damage to a player, {{TriggerActions(ThatPlayer)}}": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(HostPermanent), AnyPlayer), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "Whenever equipped creature deals combat damage to a player, {{TriggerActions}}": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(HostPermanent), AnyPlayer), {{TriggerActions[0]}})",
