    "{{~Permanent}} gains {{Hasable}} until end of turn. Target opponent creates {{a}} {{PT}} {{CreatureToken}}": "Targeted([TargetPlayer(Opponent)], ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), PlayerAction(Ref_TargetPlayer, CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])]))]))",
    "{{~Permanent}} gains {{Hasable}} until end of turn. Target opponent gains {{Digits}} life": "Targeted([TargetPlayer(Opponent)], ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), PlayerAction(Ref_TargetPlayer, GainLife({{Digits[0]}}))]))",
    "{{~Permanent}} gets {{PTModX}} until end of turn, where X is {{GameNumber(ThatCreature)}}": "ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [AdjustPTX({{PTModX[0]}}, {{GameNumber(ThatCreature=^~Permanent)[0]}})], UntilEndOfTurn)])",
    "{{~Permanent}} gets {{PTModX}} until end of turn, where X is {{GameNumber}}": "ActionList([CreateValueX({{GameNumber[0]}}), CreatePermanentLayerEffectUntil({{~Permanent}}, [AdjustPTX({{PTModX[0]}}, ValueX)], UntilEndOfTurn)])",
    "{{~Permanent}} gets {{PTMod}} and gains {{Hasable}} until end of turn": "ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "{{~Permanent}} gets {{PTMod}} until end of turn": "ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])",
    "{{~Permanent}} gets {{PTMod}} until end of turn. If {{Condition[ThisAbility]}}, put {{a}} {{CounterType}} counter on it instead": "ActionList([IfElse({{Condition[ThisAbility][0]}}, [PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{~Permanent}})], [CreatePermanentLayerEffectUntil({{~Permanent}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])])",
    "{{~Permanent}} gets {{PTMod}} until end of turn. When its power becomes {{Digits}} this way, it deals {{Digits}} damage to any target": "ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), If(PermanentPassesFilter({{~Permanent}}, PowerIs(EqualTo({{Digits[0]}}))), [ReflexiveTrigger(Targeted([AnyTarget], ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Ref_AnyTarget)])))])])",
    "{{~Permanent}} has base power and toughness {{PT}} until end of turn": "ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [SetPT({{PT[0]}})], UntilEndOfTurn)])",
    "{{~Permanent}} must be blocked each combat this turn if able": "ActionList([CreatePermanentRuleEffectUntil({{~Permanent}}, [MustBeBlocked], UntilEndOfTurn)])",
    "{{~Permanent}} perpetually becomes {{a}} {{Zombie}} {{Zombie}} with base power and toughness {{PT}} and gains {{Hasable}}": "ActionList([CreatePerpetualPermanentEffect({{~Permanent}}, [SetCreatureTypes([{{Zombie[0]}}, {{Zombie[1]}}]), SetPT({{PT[0]}}), AddAbility([{{Hasable[0]}}])])])",
    "{{~Permanent}} perpetually gets {{PTMod}}": "ActionList([CreatePerpetualPermanentEffect({{~Permanent}}, [AdjustPT({{PTMod[0]}})])])",
    "{{~Permanent}}'s controller loses {{Digits}} life and you draw a card": "ActionList([PlayerAction(ControllerOfPermanent({{~Permanent}}), LoseLife({{Digits[0]}})), DrawACard])"
  },
  "{{ActivatedActions(~Permanent,ThatPermanent)}}": {
    "Put {{a}} {{CounterType}} counter on another target creature, then {{~Permanent}} deals {{Digits}} damage to that creature": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), IsCardtype(Creature)]))], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent), PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent))]))"
  },
  "{{ActivatedActions(~Permanent,X)}}": {
    "Choose a creature card exiled with {{~Permanent}} with mana value X. {{~Permanent}} becomes a copy of that card": "ActionList([ChooseAnExiledCard(And([IsCardtype(Creature), ManaValueIs(EqualTo({{X}})), TheExiledCards])), CreatePermanentLayerEffect({{~Permanent}}, [IsACopyOfExiledCard(TheChosenExiledCard, NoCopyEffects)])])",
    "Destroy each {{Permanent}} with mana value X whose controller was dealt combat damage by this creature this turn": "ActionList([DestroyEachPermanent(And([{{Permanent[0]}}, ManaValueIs(EqualTo({{X}})), ControlledByAPlayer(WasDealtCombatDamageByPermanentThisTurn({{~Permanent}}))]))])",
    "Move X {{CounterType}} counters from {{~Permanent}} onto another target {{Artifact}}. That artifact gains {{Hasable}} until end of turn. If {{~Permanent}} has no {{CounterType}} counters on it, convert it": "Targeted([TargetPermanent(And([Other({{~Permanent}}), {{Artifact[0]}}]))], ActionList([MoveNumberCountersOfTypeFromPermanentOntoAnotherPermanent({{X}}, {{CounterType[0]}}, {{~Permanent}}, Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), If(PermanentPassesFilter({{~Permanent}}, HasNoCountersOfType({{CounterType[1]}})), [ConvertPermanent({{~Permanent}})])]))",
    "Prevent the next X damage that would be dealt to you this turn. If damage is prevented this way, this creature deals that much damage to target player or planeswalker": "Targeted([TargetPlayerOrPermanent(AnyPlayer, IsCardtype(Planeswalker))], ActionList([CreateFuturePreventDamage(NextAmountOfDamageThatWouldBeDealtThisTurnToRecipient({{X}}, Player(You)), [PreventThatDamage, PermanentDealsDamage({{~Permanent}}, TheAmountOfDamagePreventedThisWay, Ref_TargetPlayerOrPermanent)])]))",
    "Put X {{CounterType}} counters on {{ThisPermanent}}": "ActionList([PutNumberCountersOfTypeOnPermanent({{X}}, {{CounterType[0]}}, {{~Permanent}})])",
    "Put X {{CounterType}} counters on {{~Permanent}}": "ActionList([PutNumberCountersOfTypeOnPermanent({{X}}, {{CounterType[0]}}, {{~Permanent}})])",
    "Put X {{CounterType}} counters on {{~Permanent}}. Then you may have the base power and toughness of each other creature you control become equal to {{~Permanent}}'s power until end of turn": "ActionList([PutNumberCountersOfTypeOnPermanent({{X}}, {{CounterType[0]}}, {{~Permanent}}), MayAction(CreateEachPermanentLayerEffectUntil(And([Other(ThisPermanent), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]), [SetPowerAndToughnessBoth(PowerOfPermanent(ThisPermanent))], UntilEndOfTurn))])",
    "Put target card with mana value X exiled with this creature into its owner's graveyard. You gain X life": "Targeted([TargetExiledCard(And([ManaValueIs(EqualTo(ValueX)), WasExiledWithPermanent({{~Permanent}})]))], ActionList([PutExiledCardIntoOwnersGraveyard(Ref_TargetExiledCard), GainLife(ValueX)]))",
    "Put target creature card with mana value X exiled with this creature into its owner's graveyard": "Targeted([TargetExiledCard(And([IsCardtype(Creature), ManaValueIs(EqualTo({{X}})), WasExiledWithPermanent({{~Permanent}})]))], ActionList([PutExiledCardIntoOwnersGraveyard(Ref_TargetExiledCard)]))",
    "Put target creature card with mana value X exiled with {{~Permanent}} onto the battlefield tapped under your control": "Targeted([TargetExiledCard(And([IsCardtype(Creature), ManaValueIs(EqualTo({{X}})), WasExiledWithPermanent({{~Permanent}})]))], ActionList([PutExiledCardOntoBattlefield(Ref_TargetExiledCard, [EntersTapped, EntersUnderPlayersControl(You)])]))",
    "Put up to X {{CounterType}} counters on this creature. This ability can't cause the total number of {{CounterType}} counters on this creature to be greater than {{Number}}": "ActionList([PutUptoNumberCountersOfTypeOnPermanentWithMaxTotal({{X}}, {{CounterType[0]}}, {{~Permanent}}, {{Number[0]}})])",
    "Put {{a}} {{SpecificCard}} with mana value X exiled with {{~Permanent}} onto the battlefield under your control. That creature is {{a}} {{Zombie}} in addition to its other types": "ActionList([ReturnAnExiledCardToBattlefield(And([{{SpecificCard[0]}}, ManaValueIs(EqualTo({{X}})), WasExiledWithPermanent({{~Permanent}})]), [EntersUnderPlayersControl(You)]), CreatePermanentLayerEffect(ThePermanentPutOnTheBattlefieldThisWay, [AddCreatureType({{Zombie[0]}})])])",
    "Remove all {{CounterType}} counters from this creature and put X {{CounterType}} counters on it": "ActionList([RemoveAllCountersOfTypeFromPermanent({{CounterType[0]}}, {{~Permanent}}), PutNumberCountersOfTypeOnPermanent({{X}}, {{CounterType[1]}}, {{~Permanent}})])",
    "Remove up to X counters from target {{Permanent}}. For each counter removed this way, this creature gets {{PTMod}} until end of turn": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([RemoveUptoNumberCountersFromPermanent({{X}}, Ref_TargetPermanent), CreatePermanentLayerEffectUntil({{~Permanent}}, [AdjustPTForEach({{PTMod[0]}}, NumberOfCountersRemovedThisWay)], UntilEndOfTurn)]))",
    "Tap target creature with power X or less. It doesn't untap during its controller's untap step for as long as this artifact remains tapped": "Targeted([TargetPermanent(And([IsCardtype(Creature), PowerIs(LessThanOrEqualTo({{X}}))]))], ActionList([TapPermanent(Ref_TargetPermanent), CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [DoesntUntapDuringControllersUntap], ForAsLongAsPermanentRemainsTapped({{~Permanent}}))]))",
    "Target opponent mills a card, then repeats this process until {{a}} {{SpecificCard}} or X cards have been put into their graveyard this way, whichever comes first. If one or more {{SpecificCards}} were put into that graveyard this way, sacrifice this artifact and put one of them onto the battlefield under your control": "Targeted([TargetPlayer(Opponent)], ActionList([MillCardsUntilACardOfTypeIsMilledOrUntilNumberCardsHaveBeenPutIntoGraveyardThisWay({{SpecificCard[0]}}, {{X}}), If(NumCardsHaveBeenMilledIntoGraveyardThisWay(GreaterThanOrEqualTo(Integer(1)), {{SpecificCards[0]}}), [SacrificePermanent({{~Permanent}}), ReturnACardMilledThisWayToBattlefield({{SpecificCards[0]}}, [EntersUnderPlayersControl(You)])])]))",
    "Target opponent reveals cards from the top of their library until an artifact card or X cards are revealed, whichever comes first. If an artifact card is revealed this way, put it onto the battlefield under your control and sacrifice this artifact. Put the rest of the revealed cards into that player's graveyard": "Targeted([TargetPlayer(Opponent)], ActionList([PlayerAction(Ref_TargetPlayer, RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealedOrUntilNumberCardsAreRevealed(IsCardtype(Artifact), {{X}}, [If(ACardWasFoundThisWay, [PutTheCardFoundThisWayOntoTheBattlefield([EntersUnderPlayersControl(You)]), SacrificePermanent({{~Permanent}})]), PutTheRemainingCardsIntoGraveyard]))]))",
    "Target player draws X cards and gains X life. Put X {{CounterType}} counters on {{~Permanent}}": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerActions(Ref_TargetPlayer, [DrawNumberCards({{X}}), GainLife({{X}})]), PutNumberCountersOfTypeOnPermanent({{X}}, {{CounterType[0]}}, {{~Permanent}})]))",
    "Target {{Creature}} gets {{PTModX}} until end of turn and {{~Permanent}} gets {{PTModX}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTX({{PTModX[0]}}, {{X}})], UntilEndOfTurn), CreatePermanentLayerEffectUntil({{~Permanent}}, [AdjustPTX({{PTModX[1]}}, {{X}})], UntilEndOfTurn)]))",
    "The next X damage that would be dealt this turn to target {{Creature}} is dealt to {{~Permanent}} instead": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreateFutureReplaceWouldDealDamage(NextAmountOfDamageThatWouldBeDealtThisTurnToRecipient({{X}}, Permanent(Ref_TargetPermanent)), [DealToCreatureOrPlaneswalkerInstead({{~Permanent}})])]))",
    "This Vehicle deals X damage to any target. Put {{a}} {{CounterType}} counter on this Vehicle": "Targeted([AnyTarget], ActionList([PermanentDealsDamage(ThisPermanent, {{X}}, Ref_AnyTarget), PutACounterOfTypeOnPermanent({{CounterType[0]}}, ThisPermanent)]))",
    "This artifact becomes an X/X {{Zombie}} artifact creature until end of turn": "ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [SetPowerAndToughnessBoth({{X}}), AddCreatureType({{Zombie[0]}}), AddCardtype(Artifact), AddCardtype(Creature)], UntilEndOfTurn)])",
    "This artifact becomes an X/X {{Zombie}} artifact creature. Sacrifice it at the beginning of the next end step": "ActionList([CreatePermanentLayerEffect({{~Permanent}}, [SetPowerAndToughnessBoth({{X}}), AddCreatureType({{Zombie[0]}}), AddCardtype(Artifact), AddCardtype(Creature)]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([SacrificePermanent({{~Permanent}})]))])",
    "This creature becomes a copy of target creature card in your graveyard with mana value X, except it has {{Hasable}} and this ability": "Targeted([TargetGraveyardCard(And([IsCardtype(Creature), ManaValueIs(EqualTo({{X}})), InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([CreatePermanentLayerEffect({{~Permanent}}, [IsACopyOfGraveyardCard(Ref_TargetGraveyardCard, CopyEffects([AddAbility([{{Hasable[0]}}]), AddAbilityVariable(ThisAbility)]))])]))",
    "This creature deals X damage to each {{Creature}}": "ActionList([PermanentDealsDamage({{~Permanent}}, {{X}}, EachPermanent({{Creature[0]}}))])",
    "This creature deals X damage to each {{Creature}} and each player": "ActionList([PermanentDealsDamage({{~Permanent}}, {{X}}, MultipleRecipients([EachPermanent({{Creature[0]}}), EachPlayer(AnyPlayer)]))])",
    "This creature deals X damage to target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([PermanentDealsDamage({{~Permanent}}, {{X}}, Permanent(Ref_TargetPermanent))]))",
    "This creature deals half X damage, rounded down, to any target, and half X damage, rounded up, to you": "Targeted([AnyTarget], ActionList([PermanentDealsMultipleDamage({{~Permanent}}, [DamageToRecipients(HalfRoundedDown({{X}}), Ref_AnyTarget), DamageToRecipients(HalfRoundedUp({{X}}), Player(You))])]))",
    "This creature endures X": "ActionList([EndureWithPermanent({{X}}, ThisPermanent)])",
    "This enchantment becomes an X/X {{Zombie}} creature with {{Hasable}} in addition to its other types until end of turn": "ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [SetPowerAndToughnessBoth({{X}}), AddCreatureType({{Zombie[0]}}), AddCardtype(Creature), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "This enchantment deals X damage to any target": "Targeted([AnyTarget], ActionList([PermanentDealsDamage({{~Permanent}}, {{X}}, Ref_AnyTarget)]))",
    "This land becomes a copy of target nontoken artifact you control with mana value X": "Targeted([TargetPermanent(And([IsNonToken, IsCardtype(Artifact), ControlledByAPlayer(SinglePlayer(You)), ManaValueIs(EqualTo({{X}}))]))], ActionList([CreatePermanentLayerEffect({{~Permanent}}, [IsACopyOfPermanent(Ref_TargetPermanent, NoCopyEffects)])]))",
    "Until end of turn, this land becomes an X/X {{Black}} {{Zombie}} creature. It's still a land": "ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [SetPowerAndToughnessBoth({{X}}), AddColor(SimpleColorList([{{Black[0]}}])), AddCreatureType({{Zombie[0]}}), AddCardtype(Creature)], UntilEndOfTurn)])",
    "You may cast a spell with mana value X from among cards exiled with {{~Permanent}} without paying its mana cost": "ActionList([MayAction(CastASpellFromExileWithoutPaying(ManaValueIs(EqualTo({{X}})), WasExiledWithPermanent({{~Permanent}})))])",
    "You may cast any number of spells from among cards exiled with this artifact with total mana value X or less without paying their mana costs": "ActionList([CastAnyNumberOfGroupSpellsFromExileWithoutPaying(AnySpell, TotalManaValueIs(LessThanOrEqualTo({{X}})), WasExiledWithPermanent({{~Permanent}}))])",
    "You may put a creature card with mana value X from your hand onto the battlefield. If you do, return this creature to its owner's hand": "ActionList([MayCost(PutACardFromHandOnBattlefield(And([IsCardtype(Creature), ManaValueIs(EqualTo({{X}}))]), [EntersNormally])), If(CostWasPaid, [PutPermanentIntoItsOwnersHand({{~Permanent}})])])",
    "{{~Permanent}} becomes a copy of target creature card in your graveyard with mana value X, except its name is {{NamedCard}}, it's legendary in addition to its other types, and it has this ability": "Targeted([TargetGraveyardCard(And([IsCardtype(Creature), ManaValueIs(EqualTo({{X}})), InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([CreatePermanentLayerEffect({{~Permanent}}, [IsACopyOfGraveyardCard(Ref_TargetGraveyardCard, CopyEffects([SetName({{NamedCard[0]}}), AddSupertypes([Legendary]), AddAbilityVariable(ThisAbility)]))])]))",
    "{{~Permanent}} deals X damage divided as you choose among any number of target creatures. Creatures dealt damage this way can't block this turn": "TargetedDistributed([UptoNumberTargetPermanents({{X}}, IsCardtype(Creature))], DistributeNumberAmongTargets({{X}}), ActionList([PermanentDealsDistributedDamage({{~Permanent}}), CreateEachPermanentRuleEffectUntil(WasDealtDamageThisWay, [CantBlock], UntilEndOfTurn)]))",
    "{{~Permanent}} deals X damage to any target": "Targeted([AnyTarget], ActionList([PermanentDealsDamage({{~Permanent}}, {{X}}, Ref_AnyTarget)]))",
    "{{~Permanent}} deals X damage to each of up to {{Number}} targets": "Targeted([NumberAnyTargets({{Number[0]}})], ActionList([PermanentDealsDamage({{~Permanent}}, {{X}}, Ref_AnyTargets)]))",
    "{{~Permanent}} deals X damage to each {{Creature}}": "ActionList([PermanentDealsDamage({{~Permanent}}, {{X}}, EachPermanent({{Creature[0]}}))])",
    "{{~Permanent}} deals X damage to target {{CreatureOrPlaneswalker}} and you gain X life": "Targeted([TargetPermanent({{CreatureOrPlaneswalker[0]}})], ActionList([PermanentDealsDamage({{~Permanent}}, {{X}}, Permanent(Ref_TargetPermanent)), GainLife({{X}})]))",
    "{{~Permanent}} deals X damage to target {{CreatureOrPlaneswalker}}. If a permanent dealt damage this way would die this turn, exile it instead": "Targeted([TargetPermanent({{CreatureOrPlaneswalker[0]}})], ActionList([PermanentDealsDamage({{~Permanent}}, {{X}}, Permanent(Ref_TargetPermanent)), CreateReplaceWouldPutIntoGraveyardUntil(APermanentWouldDie(WasDealtDamageThisWay), [ExileItInstead], UntilEndOfTurn)]))",
    "{{~Permanent}} deals X damage to target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([PermanentDealsDamage({{~Permanent}}, {{X}}, Permanent(Ref_TargetPermanent))]))",
    "{{~Permanent}} deals X damage to target {{Creature}}. That creature's controller draws X cards": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([PermanentDealsDamage({{~Permanent}}, {{X}}, Permanent(Ref_TargetPermanent)), PlayerAction(ControllerOfPermanent(Ref_TargetPermanent), DrawNumberCards({{X}}))]))"
  },
  "{{ActivatedActions(~Sacrificed)}}": {
    "Choose target opponent. Return this card to the battlefield under that player's control at the beginning of their next upkeep": "Targeted([TargetPlayer(Opponent)], ActionList([CreateFutureTrigger(AtTheBeginningOfPlayersNextUpkeep(Ref_TargetPlayer), ActionList([PutGraveyardCardOntoBattlefield({{~Sacrificed}}, [EntersUnderPlayersControl(Ref_TargetPlayer)])]))]))",
    "Create {{a}} {{PTX}} {{CreatureToken}} with {{Hasable}}, where X is the number of {{CounterType}} counters on {{~Sacrificed}}": "ActionList([CreateTokens([TokenWithPT(PTX({{PTX[0]}}, NumCountersOfTypeOnPermanent({{CounterType[0]}}, {{~Sacrificed}})), {{CreatureToken[0]}}, [{{Hasable[0]}}])])])",
    "Target creature you control gains {{Hasable}} until end of turn. Put {{~Sacrificed}}'s counters on that creature and attach an Equipment that was attached to {{~Sacrificed}} to that creature": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), PutCountersOfDeadPermanentOnPermanent(Ref_TargetPermanent), AttachAPermanentToPermanent(And([IsArtifactType(Equipment), WasAttachedToDeadPermanent]), Ref_TargetPermanent)]))"
  },
  "{{ActivatedActions(~Vanguard)}}": {
    "If damage would be dealt to you this turn by {{a}} {{DamageSource}} of your choice, prevent that damage. {{~Vanguard}} deals damage to you and target {{PlayerOrPlaneswalker}} equal to half the damage prevented this way, rounded up": "Targeted([TargetPlayerOrPermanent({{PlayerOrPlaneswalker[0]}})], ActionList([ChooseADamageSource({{DamageSource[0]}}), CreatePreventDamageUntil(DamageWouldBeDealtBySourceToRecipient(TheChosenDamageSource, Player(You)), [PreventThatDamage, VanguardDealsDamage({{~Vanguard}}, HalfRoundedUp(WouldDealDamage_ThatMuchDamage), MultipleRecipients([Player(You), Ref_TargetPlayerOrPermanent]))], UntilEndOfTurn)]))",
    "{{~Vanguard}} deals {{Digits}} damage to any target": "Targeted([AnyTarget], ActionList([VanguardDealsDamage({{~Vanguard}}, {{Digits[0]}}, Ref_AnyTarget)]))",
    "{{~Vanguard}} deals {{Digits}} damage to each {{Creature}} and each player": "ActionList([VanguardDealsDamage({{~Vanguard}}, {{Digits[0]}}, MultipleRecipients([EachPermanent({{Creature[0]}}), EachPlayer(AnyPlayer)]))])"
  },
  "{{ActivatedActions(~Vanguard,X)}}": {
    "{{~Vanguard}} deals X damage to any target": "Targeted([AnyTarget], ActionList([VanguardDealsDamage({{~Vanguard}}, {{X}}, Ref_AnyTarget)]))",
    "{{~Vanguard}} deals an amount of damage chosen at random from 0 to X to any target": "Targeted([AnyTarget], ActionList([ChooseANumberBetweenAtRandom(Integer(0), ValueX), VanguardDealsDamage({{~Vanguard}}, TheChosenNumber, Ref_AnyTarget)]))"
  },
  "{{ActivatedActions[ActivationManaCost]}}": {
    "Prevent all damage that would be dealt to you this turn by a source of your choice that shares a color with the mana spent on this activation cost": "ActionList([ChooseADamageSource(SharesAColorWithAColorOfManaSpendOnActivationCost), CreatePreventDamageUntil(DamageWouldBeDealtBySourceToRecipient(TheChosenDamageSource, Player(You)), [PreventThatDamage], UntilEndOfTurn)])"
  },
  "{{ActivatedActions[AddEnchantCreature](~Permanent)}}": {
    "This creature loses this ability and becomes an Aura enchantment with enchant creature. Attach it to target {{Permanent}}. You may pay {{ManaCost}} to end this effect": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [LosesAbility(ThisAbility), AddEnchantmentType(Aura), AddCardtype(Enchantment), AddAbility([EnchantPermanent(IsCardtype(Creature))])], UntilPlayerPaysMana(You, {{ManaCost[0]}})), AttachPermanentToPermanent(ThisPermanent, Ref_TargetPermanent)]))"
  },
  "{{ActivatedActions[ChooseAColor](~Permanent)}}": {
    "Put {{a}} {{CounterType}} counter on this Aura and choose a color": "ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{~Permanent}}), ChooseAColor(AnyColor)])"
  },
  "{{ActivatedActions[CircledColors]}}": {
    "Add one mana of either of the circled colors": "ActionList([AddMana(AnyManaColorCircled)])"
  },
  "{{ActivatedActions[CountersRemoved](ThatPermanent)}}": {
    "It deals X damage to target {{Creature}}, where X is the number of counters removed this way": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([PermanentDealsDamage({{ThatPermanent}}, NumberOfCountersRemovedThisWay, Permanent(Ref_TargetPermanent))]))",
    "It deals damage to any target equal to the number of {{CounterType}} counters removed this way": "Targeted([AnyTarget], ActionList([PermanentDealsDamage({{ThatPermanent}}, NumberOfCountersOfTypeRemovedThisWay({{CounterType[0]}}), Ref_AnyTarget)]))",
    "It deals damage to target {{Creature}} equal to the number of {{CounterType}} counters removed this way": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([PermanentDealsDamage({{ThatPermanent}}, NumberOfCountersOfTypeRemovedThisWay({{CounterType[0]}}), Permanent(Ref_TargetPermanent))]))",
    "It deals that much damage to any target": "Targeted([AnyTarget], ActionList([PermanentDealsDamage({{ThatPermanent}}, NumberOfCountersRemovedThisWay, Ref_AnyTarget)]))",
    "It deals that much damage to target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([PermanentDealsDamage({{ThatPermanent}}, NumberOfCountersRemovedThisWay, Permanent(Ref_TargetPermanent))]))"
  },
  "{{ActivatedActions[CountersRemoved](~Permanent)}}": {
    "For each counter removed, this creature gets {{PTMod}} until end of turn": "ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [AdjustPTForEach({{PTMod[0]}}, NumberOfCountersRemovedThisWay)], UntilEndOfTurn)])",
    "Target player adds that much {{ManaProduceSymbol}}. This mana can't be spent to cast nonartifact spells. Convert {{~Permanent}}": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, AddManaRepeatedWithModifiers({{ManaProduceSymbol[0]}}, NumberOfCountersRemovedThisWay, CantSpendOnSpells(IsNonCardtype(Artifact)))), ConvertPermanent({{~Permanent}})]))"
  },
  "{{ActivatedActions[CountersRemoved](~Permanent,ThatPermanent)}}": {
    "It deals that much damage to target {{Creature}}. Convert {{~Permanent}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([PermanentDealsDamage({{ThatPermanent}}, NumberOfCountersRemovedThisWay, Permanent(Ref_TargetPermanent)), ConvertPermanent({{~Permanent}})]))"
  },
  "{{ActivatedActions[CountersRemoved]}}": {
    "Create that many {{PT}} {{CreatureTokens}}": "ActionList([CreateTokens([NumberTokens(NumberOfCountersRemovedThisWay, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])])",
    "Add that much {{ManaProduceSymbol}}": "ActionList([AddManaRepeated({{ManaProduceSymbol[0]}}, NumberOfCountersRemovedThisWay)])",
    "Add {{ManaProduceSymbol}} for each {{CounterType}} counter removed this way": "ActionList([AddManaRepeated({{ManaProduceSymbol[0]}}, NumberOfCountersOfTypeRemovedThisWay({{CounterType[0]}}))])",
    "Add {{ManaProduceSymbol}}, then add an additional {{ManaProduceSymbol}} for each {{CounterType}} counter removed this way": "ActionList([AddMana({{ManaProduceSymbol[0]}}), AddManaRepeated({{ManaProduceSymbol[1]}}, NumberOfCountersOfTypeRemovedThisWay({{CounterType[0]}}))])",
    "Create {{a}} {{PTX}} {{CreatureToken}}, where X is the number of {{CounterType}} counters removed this way": "ActionList([CreateTokens([TokenWithPT(PTX({{PTX[0]}}, NumberOfCountersRemovedThisWay), {{CreatureToken[0]}}, [])])])",
    "Create {{a}} {{PT}} {{CreatureToken}}. Put X {{CounterType}} counters on it, where X is the number of {{CounterType}} counters removed this way": "ActionList([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])]), PutNumberCountersOfTypeOnPermanent(NumberOfCountersOfTypeRemovedThisWay({{CounterType[1]}}), {{CounterType[0]}}, TheCreatedToken)])",
    "For each {{Number}} counters removed this way, take an extra turn after this one": "ActionList([TakeANumberOfExtraTurns(NumberOfBlocksOfNumberCountersRemovedThisWay({{Number[0]}}))])",
    "Gain control of target creature with power less than or equal to the number of {{CounterType}} counters removed this way": "Targeted([TargetPermanent(And([IsCardtype(Creature), PowerIs(LessThanOrEqualTo(NumberOfCountersOfTypeRemovedThisWay({{CounterType[0]}})))]))], ActionList([GainControlOfPermanent(Ref_TargetPermanent)]))",
    "Look at the top X cards of your library, where X is the number of {{CounterType}} counters removed this way. Put one of them into your hand and the rest on the bottom of your library in any order": "ActionList([LookAtTheTopNumberCardsOfLibrary(NumberOfCountersOfTypeRemovedThisWay({{CounterType[0]}}), [PutAGenericCardIntoHand, PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder])])",
    "Target {{Creature}} gets {{PTMod}} until end of turn for each {{CounterType}} counter removed this way": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTForEach({{PTMod[0]}}, NumberOfCountersOfTypeRemovedThisWay({{CounterType[0]}}))], UntilEndOfTurn)]))",
    "You gain {{Digits}} life for each {{CounterType}} counter removed this way": "ActionList([GainLifeForEach({{Digits[0]}}, NumberOfCountersOfTypeRemovedThisWay({{CounterType[0]}}))])"
  },
  "{{ActivatedActions[EnchantedCreature](~Permanent)}}": {
    "Attach this Aura to target creature other than {{EnchantedCreature}}": "Targeted([TargetPermanent(And([IsCardtype(Creature), Other(HostPermanent)]))], ActionList([AttachPermanentToPermanent({{~Permanent}}, Ref_TargetPermanent)]))",
    "Return {{EnchantedPermanent}} and this Aura to their owners' hands": "ActionList([PutEachPermanentIntoItsOwnersHand(Or([SinglePermanent(HostPermanent), SinglePermanent({{~Permanent}})]))])",
    "This Aura deals {{Digits}} damage to any target. Put {{a}} {{CounterType}} counter on {{EnchantedPermanent}}": "Targeted([AnyTarget], ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Ref_AnyTarget), PutACounterOfTypeOnPermanent({{CounterType[0]}}, HostPermanent)]))",
    "This creature gets {{PTMod}} until end of turn. If {{Condition(ThatPermanent)}}, {{EnchantedPermanent}} gets {{PTMod}} until end of turn instead": "ActionList([IfElse({{Condition(ThatPermanent=^~Permanent)[0]}}, [CreatePermanentLayerEffectUntil(HostPermanent, [AdjustPT({{PTMod[1]}})], UntilEndOfTurn)], [CreatePermanentLayerEffectUntil({{~Permanent}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])])",
    "This creature gets {{PTMod}} until end of turn. If {{Condition(~Permanent)}}, {{EnchantedCreature}} gets {{PTMod}} until end of turn instead": "ActionList([IfElse({{Condition(~Permanent=^~Permanent)[0]}}, [CreatePermanentLayerEffectUntil(HostPermanent, [AdjustPT({{PTMod[1]}})], UntilEndOfTurn)], [CreatePermanentLayerEffectUntil({{~Permanent}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])])"
  },
  "{{ActivatedActions[EnchantedPermanent][TheExiledCard]}}": {
    "{{EnchantedLand}} becomes a copy of the exiled card until end of turn and gains {{Hasable}}. It's still a land": "ActionList([CreatePermanentLayerEffectUntil(HostPermanent, [IsACopyOfExiledCard(TheExiledCard, CopyEffects([MergeTypeline])), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])"
  },
  "{{ActivatedActions[EnchantedPermanent]}}": {
    "Destroy all non-{{Zombie}} creatures blocking {{EnchantedCreature}}": "ActionList([DestroyEachPermanent(And([IsNonCreatureType({{Zombie[0]}}), IsCardtype(Creature), IsBlockingAttacker(HostPermanent)]))])",
    "Destroy {{EnchantedPermanent}}": "ActionList([DestroyPermanent(HostPermanent)])",
    "Exile {{EnchantedCreature}} and all Auras attached to it. At the beginning of the next end step, return that card to the battlefield under its owner's control. If you do, return the other cards exiled this way to the battlefield under their owners' control attached to that creature": "ActionList([ExileSinglePermanentAndEachPermanent(HostPermanent, And([IsEnchantmentType(Aura), AttachedToPermanent(HostPermanent)])), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([MustCost(PutExiledCardOntoBattlefield(TheSinglePermanentExiledThisWay, [EntersUnderOwnersControl])), If(CostWasPaid, [PutEachExiledCardOntoTheBattlefield(TheOtherPermanentsExiledThisWay, [EntersUnderOwnersControl, EntersAttachedToPermanent(ThePermanentPutOnTheBattlefieldThisWay)])])]))])",
    "Exile {{EnchantedPermanent}}": "ActionList([ExilePermanent(HostPermanent)])",
    "Exile {{EnchantedPermanent}}. Create a Blood token": "ActionList([ExilePermanent(HostPermanent), CreateTokens([BloodToken])])",
    "Exile {{EnchantedPermanent}}. Create {{a}} {{PT}} {{CreatureToken}}": "ActionList([ExilePermanent(HostPermanent), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])])",
    "Exile {{EnchantedPermanent}}. You create {{a}} {{PT}} {{CreatureToken}}": "ActionList([ExilePermanent(HostPermanent), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])])",
    "Prevent the next {{Digits}} damage that would be dealt to {{EnchantedCreature}} this turn": "ActionList([CreateFuturePreventDamage(NextAmountOfDamageThatWouldBeDealtThisTurnToRecipient({{Digits[0]}}, Permanent(HostPermanent)), [PreventThatDamage])])",
    "Put {{EnchantedPermanent}} into its owner's library third from the top": "ActionList([ReturnPermanentToLibraryUnderNumberCards(HostPermanent, Integer(2))])",
    "Put {{Number}} {{CounterType}} counters on {{EnchantedPermanent}}": "ActionList([PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[0]}}, HostPermanent)])",
    "Put {{a}} {{CounterType}} counter on {{EnchantedPermanent}}": "ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, HostPermanent)])",
    "Regenerate {{EnchantedPermanent}}": "ActionList([RegeneratePermanent(HostPermanent)])",
    "Return {{EnchantedPermanent}} to its owner's hand": "ActionList([PutPermanentIntoItsOwnersHand(HostPermanent)])",
    "Shuffle {{EnchantedPermanent}} into its owner's library": "ActionList([ShufflePermanentIntoLibrary(HostPermanent)])",
    "Shuffle {{EnchantedPermanent}} into its owner's library, then manifest dread": "ActionList([ShufflePermanentIntoLibrary(HostPermanent), ManifestDread])",
    "Tap {{EnchantedPermanent}}": "ActionList([TapPermanent(HostPermanent)])",
    "The next time {{a}} {{DamageSource}} of your choice would deal damage to {{EnchantedPermanent}} this turn, prevent that damage": "ActionList([ChooseADamageSource({{DamageSource[0]}}), CreateFuturePreventDamage(NextTimeDamageWouldBeDealtThisTurnBySourceToRecipient(TheChosenDamageSource, Permanent(HostPermanent)), [PreventThatDamage])])",
    "The next {{Digits}} damage that would be dealt to {{EnchantedPermanent}} this turn is dealt to any target instead": "Targeted([AnyTarget], ActionList([CreateFutureReplaceWouldDealDamage(NextTimeDamageWouldBeDealtThisTurnToRecipient(Permanent(HostPermanent)), [DealSomeDamageToRecipientInstead({{Digits[0]}}, Ref_AnyTarget)])]))",
    "Untap {{EnchantedPermanent}}": "ActionList([UntapPermanent(HostPermanent)])",
    "Until end of turn, {{EnchantedLand}} becomes {{a}} {{PT}} {{Black}} {{Zombie}} creature with \"{{QuotedAbility}}\". It's still a land": "ActionList([CreatePermanentLayerEffectUntil(HostPermanent, [SetPT({{PT[0]}}), AddColor(SimpleColorList([{{Black[0]}}])), AddCreatureType({{Zombie[0]}}), AddCardtype(Creature), AddAbility([{{QuotedAbility[0]}}])], UntilEndOfTurn)])",
    "{{EnchantedCreature}} and other creatures that share a creature type with it gain {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil(Or([SinglePermanent(HostPermanent), And([IsCardtype(Creature), SharesACreatureTypeWithPermanent(HostPermanent)])]), [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "{{EnchantedCreature}} and other creatures that share a creature type with it get {{PTMod}} and gain {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil(Or([SinglePermanent(HostPermanent), And([IsCardtype(Creature), SharesACreatureTypeWithPermanent(HostPermanent)])]), [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "{{EnchantedCreature}} and other creatures that share a creature type with it get {{PTMod}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil(Or([SinglePermanent(HostPermanent), And([IsCardtype(Creature), SharesACreatureTypeWithPermanent(HostPermanent)])]), [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])",
    "{{EnchantedCreature}} attacks this turn if able": "ActionList([CreatePermanentRuleEffectUntil(HostPermanent, [MustAttack], UntilEndOfTurn)])",
    "{{EnchantedCreature}} becomes the creature type of your choice until end of turn": "ActionList([ChooseACreatureType, CreatePermanentLayerEffectUntil(HostPermanent, [AddCreatureTypeVariable(TheChosenCreatureType)], UntilEndOfTurn)])",
    "{{EnchantedCreature}} can't block this turn": "ActionList([CreatePermanentRuleEffectUntil(HostPermanent, [MustBlock], UntilEndOfTurn)])",
    "{{EnchantedCreature}} gets {{PTMod}} or {{PTMod}} until end of turn": "ActionList([ChoosePTMod([PTMod({{PTMod[0]}}), PTMod({{PTMod[1]}})]), CreatePermanentLayerEffectUntil(HostPermanent, [AdjustPT_TheChosenPTMod], UntilEndOfTurn)])",
    "{{EnchantedCreature}} gets {{PTMod}} until end of turn": "ActionList([CreatePermanentLayerEffectUntil(HostPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])",
    "{{EnchantedLand}} becomes a legendary {{PT}} {{Zombie}} creature with {{Hasable}} until end of turn. It's still a land": "ActionList([CreatePermanentLayerEffectUntil(HostPermanent, [AddSupertype(Legendary), SetPT({{PT[0]}}), AddCreatureType({{Zombie[0]}}), AddCardtype(Creature), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "{{EnchantedLand}} becomes {{a}} {{PT}} {{Black}} {{Zombie}} creature until end of turn. It's still a land": "ActionList([CreatePermanentLayerEffectUntil(HostPermanent, [SetPT({{PT[0]}}), AddColor(SimpleColorList([{{Black[0]}}])), AddCreatureType({{Zombie[0]}}), AddCardtype(Creature)], UntilEndOfTurn)])",
    "{{EnchantedLand}} becomes {{a}} {{PT}} {{Black}} {{Zombie}} creature with {{Hasable}} until end of turn. It's still a land": "ActionList([CreatePermanentLayerEffectUntil(HostPermanent, [SetPT({{PT[0]}}), AddColor(SimpleColorList([{{Black[0]}}])), AddCreatureType({{Zombie[0]}}), AddCardtype(Creature), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "{{EnchantedPermanent}} becomes the color or colors of your choice": "ActionList([ChooseColors, CreatePermanentLayerEffect(HostPermanent, [SetColor(TheChosenColors)])])",
    "{{EnchantedPermanent}} deals {{Digits}} damage to target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([PermanentDealsDamage(HostPermanent, {{Digits[0]}}, Permanent(Ref_TargetPermanent))]))",
    "{{EnchantedPermanent}} gains {{Hasable}} until end of turn": "ActionList([CreatePermanentLayerEffectUntil(HostPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "{{EnchantedPermanent}} phases out": "ActionList([PhaseOutPermanent(HostPermanent)])",
    "{{EnchantedPermanent}}'s owner shuffles it into their library": "ActionList([ShufflePermanentIntoLibrary(HostPermanent)])"
  },
  "{{ActivatedActions[EquippedCreature](X)}}": {
    "{{EquippedCreature}} gets {{PTModX}} until end of turn": "ActionList([CreatePermanentLayerEffectUntil(HostPermanent, [AdjustPTX({{PTModX[0]}}, {{X}})], UntilEndOfTurn)])"
  },
  "{{ActivatedActions[EquippedCreature](~Permanent)}}": {
    "Choose target creature that's blocking {{EquippedCreature}}. Flip a coin. If you win the flip, exile the chosen creature. Otherwise, this Equipment deals {{Digits}} damage to it": "Targeted([TargetPermanent(And([IsCardtype(Creature), IsBlockingAttacker(HostPermanent)]))], ActionList([FlipACoin_OnWinAndLose([ExilePermanent(Ref_TargetPermanent)], [PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent))])]))"
  },
  "{{ActivatedActions[EquippedCreature]}}": {
    "Double {{EquippedCreature}}'s power until end of turn": "ActionList([DoubleCreaturesPowerUntilEndOfTurn(HostPermanent)])",
    "Put {{a}} {{CounterType}} counter on {{EquippedCreature}}": "ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, HostPermanent)])",
    "Regenerate {{EquippedCreature}}": "ActionList([RegeneratePermanent(HostPermanent)])",
    "Until end of turn, {{EquippedCreature}} gets {{PTModX}}, where X is the number of times this ability has resolved this turn": "ActionList([CreatePermanentLayerEffectUntil(HostPermanent, [AdjustPTX({{PTModX[0]}}, NumberOfTimesThisAbilityHasResolvedThisTurn)], UntilEndOfTurn)])",
    "You may tap or untap {{EquippedCreature}}": "ActionList([MayAction(TapOrUntapPermanent(HostPermanent))])",
    "{{EquippedCreature}} can't be blocked this turn. Sacrifice it at the beginning of the next end step": "ActionList([CreatePermanentRuleEffectUntil(HostPermanent, [CantBeBlocked], UntilEndOfTurn), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([SacrificePermanent(HostPermanent)]))])",
    "{{EquippedCreature}} gains {{Hasable}} until end of turn": "ActionList([CreatePermanentLayerEffectUntil(HostPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "{{EquippedCreature}} gets {{PTMod}} until end of turn": "ActionList([CreatePermanentLayerEffectUntil(HostPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])",
    "{{EquippedCreature}} phases out": "ActionList([PhaseOutPermanent(HostPermanent)])"
  },
  "{{ActivatedActions[GraveyardCardsExiledThisWay]}}": {
    "An opponent chooses one of the exiled cards. You put that card on the bottom of your library and return the other to the battlefield tapped. You become the monarch": "ActionList([APlayerAction(Opponent, ChooseAnExiledCard(TheCardsExiledThisWay)), PutExiledCardOnTheBottomOfItsOwnersLibrary(TheChosenExiledCard), PutEachExiledCardOntoTheBattlefield(TheCardsExiledThisWay, [EntersTapped]), BecomeTheMonarch])",
    "Create a tapped {{PTX}} {{CreatureToken}}, where X is twice the number of cards exiled this way": "ActionList([CreateTokens([TokenWithPT(PTX({{PTX[0]}}, Twice(NumGraveyardCardsExiledThisWay)), {{CreatureToken[0]}}, [])])])",
    "Create a token that's a copy of the exiled card, except it's an artifact in addition to its other types": "ActionList([CreateTokens([TokenCopyOfExiledCard(TheCardExiledThisWay, TokenCopyEffects([AddCardtypes([Artifact])]))])])",
    "Create a token that's a copy of the exiled card, except it's {{a}} {{PT}} {{Zombie}} artifact in addition to its other types and it has \"{{TokenQuotedAbility}}\". It gains {{Hasable}} until end of turn": "ActionList([CreateTokens([TokenCopyOfExiledCard(TheCardExiledThisWay, TokenCopyEffects([SetPT({{PT[0]}}), AddCreatureTypes([{{Zombie[0]}}]), AddCardtypes([Artifact]), AddAbility([{{TokenQuotedAbility[0]}}])]))]), CreatePermanentLayerEffectUntil(TheCreatedToken, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "Discover X, where X is the mana value of the exiled card": "ActionList([Discover(ManaValueOfTheCardExiledThisWay)])",
    "Target {{Creature}} gets {{PTModX}} until end of turn, where X is the number of cards exiled this way": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTX({{PTModX[0]}}, NumGraveyardCardsExiledThisWay)], UntilEndOfTurn)]))"
  },
  "{{ActivatedActions[PermanentsTappedThisWay]}}": {
    "You may put a creature card from your hand that shares a creature type with each creature tapped this way onto the battlefield": "ActionList([MayAction(PutACardFromHandOnBattlefield(And([IsCardtype(Creature), SharesACreatureTypeWithPermanents(ThePermanentsTappedThisWay)]), [EntersNormally]))])"
  },
  "{{ActivatedActions[ThatExiledCard](~Permanent)}}": {
    "If the exiled card is a snow land, {{ThisPermanent}} gets {{PTMod}} until end of turn": "ActionList([If(ExiledCardPassesFilter(TheCardExiledThisWay, And([IsSupertype(Snow), IsCardtype(Land)])), [CreatePermanentLayerEffectUntil({{~Permanent}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])])",
    "Put X {{CounterType}} counters on {{ThisPermanent}}, where X is the exiled card's mana value": "ActionList([PutNumberCountersOfTypeOnPermanent(ManaValueOfExiled(TheCardExiledThisWay), {{CounterType[0]}}, {{~Permanent}})])"
  },
  "{{ActivatedActions[ThatExiledCard]}}": {
    "Add X mana of any one color, where X is {{Digits}} plus the exiled creature's mana value. Spend this mana only to cast {{PotentialSpells}}": "ActionList([AddManaRepeatedWithModifiers(AnyManaColor, Plus({{Digits[0]}}, ManaValueOfTheCardExiledThisWay), CanOnlySpendOnSpells({{PotentialSpells[0]}}))])",
    "Counter target {{Spell}} if it has the same name as that card": "Targeted([TargetSpell({{Spell[0]}})], ActionList([If(SpellPassesFilter(Ref_TargetSpell, SharesANameWithExiled(TheCardExiledThisWay)), [CounterSpell(Ref_TargetSpell)])]))",
    "Create a token that's a copy of that card": "ActionList([CreateTokens([TokenCopyOfExiledCard(TheCardExiledThisWay, NoTokenCopyEffects)])])",
    "Create {{Number}} tokens that are copies of the exiled card": "ActionList([CreateTokens([NumberTokens({{Number[0]}}, TokenCopyOfExiledCard(TheCardExiledThisWay, NoTokenCopyEffects))])])",
    "Put {{Number}} {{CounterType}} counters on the exiled card. If it doesn't have suspend, it gains suspend": "ActionList([PutNumberCountersOnExiledCard({{Number[0]}}, {{CounterType[0]}}, TheCardExiledThisWay), CreateExiledCardEffect(TheCardExiledThisWay, [AddAbility([BasicSuspend])])])",
    "Return target card from your graveyard to your hand if it shares a card type with the card exiled this way": "Targeted([TargetGraveyardCard(InAPlayersGraveyard(SinglePlayer(You)))], ActionList([If(GraveyardCardPassesFilter(Ref_TargetGraveyardCard, SharesACardtypeWithExiledCard(TheCardExiledThisWay)), [PutGraveyardCardIntoHand(Ref_TargetGraveyardCard)])]))",
    "Target opponent loses life equal to the exiled card's power": "Targeted([TargetPlayer(Opponent)], ActionList([PlayerAction(Ref_TargetPlayer, LoseLife(ManaValueOfExiled(TheCardExiledThisWay)))]))",
    "Target opponent reveals cards from the top of their library until they reveal a card with mana value equal to {{Digits}} plus the exiled spell's mana value. Exile that card, then that player shuffles. You may cast that exiled card without paying its mana cost": "Targeted([TargetPlayer(Opponent)], ActionList([PlayerAction(Ref_TargetPlayer, RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed(ManaValueIs(EqualTo(Plus({{Digits[0]}}, ManaValueOfSpell(TheSpellExiledThisWay)))), [ExileTheCardFoundThisWay, PutTheRemainingCardsBackIntoLibraryAndShuffle])), MayAction(CastExiledCardWithoutPaying(TheCardExiledThisWay))]))",
    "You may play it": "ActionList([MayAction(PlayExiledCard(TheCardExiledThisWay))])",
    "You may play that card this turn": "ActionList([CreatePlayerEffectUntil(You, [MayPlayExiledCard(TheCardExiledThisWay)], UntilEndOfTurn)])"
  },
  "{{ActivatedActions[TheChosenCardtype]}}": {
    "The next spell you cast this turn of the chosen type can be cast without paying its mana cost": "ActionList([CreateFuturePlayerEffect(You, MayCastTheirNextSpellThisTurnWithoutPaying(IsCardtypeVariable(TheChosenCardtype)))])"
  },
  "{{ActivatedActions[TheChosenColor,TheChosenCreatureType](~Permanent)}}": {
    "Create {{a}} {{PTX}} creature token of the chosen color and type, where X is {{GameNumber(~Permanent)}}": "ActionList([If(And([AColorWasChosen, ACreatureTypeWasChosen]), [CreateTokens([TokenWithPT(PTX({{PTX[0]}}, {{GameNumber(~Permanent=^~Permanent)[0]}}), TheChosenColor, [], [Creature], TheChosenCreatureType, [])])])])"
  },
  "{{ActivatedActions[TheChosenColor,TheChosenCreatureType]}}": {
    "Create {{a}} {{PT}} creature token of the chosen color and type": "ActionList([If(And([AColorWasChosen, ACreatureTypeWasChosen]), [CreateTokens([TokenWithPT({{PT[0]}}, TheChosenColor, [], [Creature], TheChosenCreatureType, [])])])])"
  },
  "{{ActivatedActions[TheChosenColor]}}": {
    "Add one mana of a chosen color": "ActionList([AddMana(ManaOfAChosenColor)])",
    "Add one mana of the chosen color": "ActionList([AddMana(ManaOfTheChosenColor)])",
    "Add {{ManaProduceSymbol}} or one mana of the chosen color": "ActionList([AddMana(Or([{{ManaProduceSymbol[0]}}, ManaOfTheChosenColor]))])",
    "Add {{Number}} mana of the chosen color. Spend this mana only to activate abilities of land sources": "ActionList([AddManaRepeatedWithModifiers(ManaOfTheChosenColor, {{Number[0]}}, CanOnlySpendToActivateAbilitiesOfSources(IsCardtype(Land)))])",
    "Add {{Number}} mana of the chosen color. Spend this mana only to cast monocolored spells of that color": "ActionList([AddManaRepeatedWithModifiers(ManaOfTheChosenColor, {{Number[0]}}, CanOnlySpendOnSpells(And([IsMonocolored, IsColor(TheChosenColor)])))])",
    "Destroy target permanent of the chosen color": "Targeted([TargetPermanent(IsColor(TheChosenColor))], ActionList([DestroyPermanent(Ref_TargetPermanent)]))",
    "Target {{Permanent}} gains protection from the chosen color until end of turn": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([Protection(FromColor(TheChosenColor))])], UntilEndOfTurn)]))",
    "The next time a source of your choice of the chosen color would deal damage to you this turn, prevent that damage": "ActionList([ChooseADamageSource(IsColor(TheChosenColor)), CreateFuturePreventDamage(NextTimeDamageWouldBeDealtThisTurnBySourceToRecipient(TheChosenDamageSource, Player(You)), [PreventThatDamage])])"
  },
  "{{ActivatedActions[TheChosenCreatureType](~Permanent)}}": {
    "Gain control of target creature that isn't of the chosen type for as long as this creature remains tapped": "Targeted([TargetPermanent(And([IsCardtype(Creature), IsNonCreatureTypeVariable(TheChosenCreatureType)]))], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, ForAsLongAsPermanentRemainsTapped({{~Permanent}}))]))",
    "Until end of turn, this artifact becomes a copy of target creature you control of the chosen type, except it's an artifact in addition to its other types": "Targeted([TargetPermanent(And([IsCardtype(Creature), IsCreatureTypeVariable(TheChosenCreatureType)]))], ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [IsACopyOfPermanent(Ref_TargetPermanent, CopyEffects([AddCardtypes([Artifact])]))], UntilEndOfTurn)]))"
  },
  "{{ActivatedActions[TheChosenCreatureType]}}": {
    "Add one mana of any color. Spend this mana only to cast a creature spell of the chosen type": "ActionList([AddManaWithModifiers(AnyManaColor, CanOnlySpendOnSpells(And([IsCardtype(Creature), IsCreatureTypeVariable(TheChosenCreatureType)])))])",
    "Add one mana of any color. Spend this mana only to cast a creature spell of the chosen type or activate an ability of a creature source of the chosen type": "ActionList([AddManaWithModifiers(AnyManaColor, Or([CanOnlySpendOnSpells(And([IsCardtype(Creature), IsCreatureTypeVariable(TheChosenCreatureType)])), CanOnlySpendToActivateAbilitiesOfSources(And([IsCardtype(Creature), IsCreatureTypeVariable(TheChosenCreatureType)]))]))])",
    "Add one mana of any color. Spend this mana only to cast a creature spell of the chosen type, and that spell can't be countered": "ActionList([AddManaWithModifiers(AnyManaColor, And([CanOnlySpendOnSpells(And([IsCardtype(Creature), IsCreatureTypeVariable(TheChosenCreatureType)])), FlagSpellsCastWith(AnySpell, [CantBeCountered])]))])",
    "Add one mana of any color. Spend this mana only to cast a spell of the chosen type or activate an ability of a source of the chosen type": "ActionList([AddManaWithModifiers(AnyManaColor, Or([CanOnlySpendOnSpells(And([IsCardtype(Creature), IsCreatureTypeVariable(TheChosenCreatureType)])), CanOnlySpendToActivateAbilitiesOfSources(And([IsCardtype(Creature), IsCreatureTypeVariable(TheChosenCreatureType)]))]))])",
    "Add one mana of any color. Spend this mana only to cast spells of the chosen type": "ActionList([AddManaWithModifiers(AnyManaColor, CanOnlySpendOnSpells(IsCreatureTypeVariable(TheChosenCreatureType)))])",
    "Add {{ManaProduceSymbol}}. Spend this mana only to cast a creature spell of the chosen type or a legendary creature spell": "ActionList([AddManaWithModifiers({{ManaProduceSymbol[0]}}, Or([CanOnlySpendOnSpells(And([IsCardtype(Creature), IsCreatureTypeVariable(TheChosenCreatureType)])), CanOnlySpendOnSpells(And([IsSupertype(Legendary), IsCardtype(Creature)]))]))])",
    "Choose a color. Add an amount of mana of that color equal to the number of creatures you control of the chosen type": "ActionList([ChooseAColor(AnyColor), AddManaRepeated(ManaOfTheChosenColor, TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), IsCreatureTypeVariable(TheChosenCreatureType)])))])",
    "Look at the top {{Number}} cards of your library. You may reveal a creature card of the chosen type from among them and put it into your hand. Put the rest on the bottom of your library in a random order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [MayRevealACardOfTypeAndPutIntoHand(And([IsCardtype(Creature), IsCreatureTypeVariable(TheChosenCreatureType)])), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "Put {{a}} {{CounterType}} counter on target creature you control of the chosen type": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), IsCreatureTypeVariable(TheChosenCreatureType)]))], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent)]))",
    "Return target card of the chosen type from your graveyard to your hand": "Targeted([TargetGraveyardCard(And([IsCreatureTypeVariable(TheChosenCreatureType), InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardIntoHand(Ref_TargetGraveyardCard)]))",
    "Seek a card of the chosen type": "ActionList([SeekACard(IsCreatureTypeVariable(TheChosenCreatureType))])",
    "The next spell of the chosen type you cast this turn can be cast as though it had flash": "ActionList([CreateFutureSpellEffect(TheNextSpellPlayerCastsThisTurn(IsCreatureTypeVariable(TheChosenCreatureType), You), [MayCastAsThoughItHadFlash])])",
    "The next time a creature of the chosen type would deal damage to you this turn, prevent that damage": "ActionList([CreateFuturePreventDamage(NextTimeDamageWouldBeDealtThisTurnByAPermanentToRecipient(And([IsCardtype(Creature), IsCreatureTypeVariable(TheChosenCreatureType)]), Player(You)), [PreventThatDamage])])",
    "You may put a creature card of the chosen type from your hand onto the battlefield": "ActionList([MayAction(PutACardFromHandOnBattlefield(And([IsCardtype(Creature), IsCreatureTypeVariable(TheChosenCreatureType)]), [EntersNormally]))])"
  },
  "{{ActivatedActions[TheChosenName]}}": {
    "Counter target spell with the chosen name": "Targeted([TargetSpell(IsNamed(TheChosenName))], ActionList([CounterSpell(Ref_TargetSpell)]))"
  },
  "{{ActivatedActions[TheChosenPermanent]}}": {
    "The chosen creature gains {{Hasable}} until end of turn": "ActionList([CreatePermanentLayerEffectUntil(TheChosenPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])"
  },
  "{{ActivatedActions[TheChosenPlayer]}}": {
    "Choose new targets for target spell or ability if it's controlled by the chosen player and if it targets you or a permanent you control": "Targeted([TargetSpellOrAbility(AnySpellOrAbility)], ActionList([If(SpellOrAbilityPassesFilter(Ref_TargetSpellOrAbility, And([ControlledByAPlayer(SinglePlayer(TheChosenPlayer)), TargetsAPermanent(ControlledByAPlayer(SinglePlayer(You)))])), [ChooseNewTargetsForSpellOrAbility(Ref_TargetSpellOrAbility)])]))",
    "Exile target creature that's attacking you if it's controlled by the chosen player": "Targeted([TargetPermanent(And([IsCardtype(Creature), IsAttackingPlayer(You)]))], ActionList([If(PermanentPassesFilter(Ref_TargetPermanent, ControlledByAPlayer(SinglePlayer(TheChosenPlayer))), [ExilePermanent(Ref_TargetPermanent)])]))",
    "You and target permanent you control each gain protection from the chosen player until end of turn": "Targeted([TargetPermanent(ControlledByAPlayer(SinglePlayer(You)))], ActionList([CreatePlayerEffectUntil(You, [Protection(FromPlayers(SinglePlayer(TheChosenPlayer)))], UntilEndOfTurn), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([Protection(FromPlayers(SinglePlayer(TheChosenPlayer)))])], UntilEndOfTurn)]))"
  },
  "{{ActivatedActions[TheDiscardedCard](~Permanent)}}": {
    "If the discarded card was {{a}} {{SpecificCard}}, this enchantment deals {{Digits}} damage to target {{PlayerOrPlaneswalker}}": "Targeted([TargetPlayerOrPermanent({{PlayerOrPlaneswalker[0]}})], ActionList([If(DiscardedCardPassesFilter({{SpecificCard[0]}}), [PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Ref_TargetPlayerOrPermanent)])]))",
    "This artifact becomes an X/X {{Zombie}} artifact creature until end of turn, where X is the discarded card's mana value": "ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [SetPowerAndToughnessBoth(ManaValueOfTheDiscardedCard), SetCreatureType({{Zombie[0]}}), SetCardtypes([Artifact, Creature])], UntilEndOfTurn)])",
    "This creature deals damage to target creature equal to the discarded card's mana value": "Targeted([TargetPermanent(IsCardtype(Creature))], ActionList([PermanentDealsDamage({{~Permanent}}, ManaValueOfTheDiscardedCard, Permanent(Ref_TargetPermanent))]))",
    "This creature deals {{Digits}} damage to any target. If the discarded card was multicolored, this creature deals {{Digits}} damage instead": "Targeted([AnyTarget], ActionList([IfElse(DiscardedCardPassesFilter(IsMulticolored), [PermanentDealsDamage({{~Permanent}}, {{Digits[1]}}, Ref_AnyTarget)], [PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Ref_AnyTarget)])]))",
    "This enchantment deals damage to any target equal to the mana value of the discarded card": "Targeted([AnyTarget], ActionList([PermanentDealsDamage({{~Permanent}}, ManaValueOfTheDiscardedCard, Ref_AnyTarget)]))",
    "{{~Permanent}} gets {{PTModX}} until end of turn, where X is the discarded card's mana value": "ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [AdjustPTX({{PTModX[0]}}, ManaValueOfTheDiscardedCard)], UntilEndOfTurn)])"
  },
  "{{ActivatedActions[TheDiscardedCard]}}": {
    "Counter target {{Spell}} if it has the same mana value as the discarded card": "Targeted([TargetSpell({{Spell[0]}})], ActionList([If(SpellPassesFilter(Ref_TargetSpell, ManaValueIs(EqualTo(ManaValueOfTheDiscardedCard))), [CounterSpell(Ref_TargetSpell)])]))",
    "Draw a card. If the discarded card was {{a}} {{SpecificCard}}, amass Orcs {{Digits}}": "ActionList([DrawACard, If(ACardWasDiscardedThisWay({{SpecificCard[0]}}), [Amass({{Digits[0]}}, Orc)])])",
    "Draw a card. If the discarded card was {{a}} {{Zombie}} card, create a tapped {{PT}} {{CreatureToken}}": "ActionList([DrawACard, If(ACardWasDiscardedThisWay(IsCreatureType({{Zombie[0]}})), [CreateTokensWithFlags([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])], [EntersTapped])])])"
  },
  "{{ActivatedActions[TheExiledCard](~Permanent)}}": {
    "Add {{ManaProduceSymbol}}. If a card is exiled with this land, add {{ManaProduceSymbol}}{{ManaProduceSymbol}} instead": "ActionList([IfElse(AnExiledCardPassesFilter(TheExiledCards, AnyCard), [AddMana(And([{{ManaProduceSymbol[1]}}, {{ManaProduceSymbol[2]}}]))], [AddMana({{ManaProduceSymbol[0]}})])])",
    "Until end of turn, this Vehicle becomes a copy of the exiled card, except it's a Vehicle artifact in addition to its other types": "ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [IsACopyOfExiledCard(TheExiledCard, CopyEffects([AddArtifactTypes([Vehicle]), AddCardtypes([Artifact])]))], UntilEndOfTurn)])",
    "Until end of turn, you may play a card exiled with {{~Permanent}} without paying its mana cost": "ActionList([CreatePlayerEffectUntil(You, [MayPlayOneCardFromAmongExiled(WasExiledWithPermanent({{~Permanent}}))], UntilEndOfTurn)])"
  },
  "{{ActivatedActions[TheExiledCard]}}": {
    "Add one mana of any of the exiled card's colors": "ActionList([AddMana(AnyManaColorOfExiledCard(TheExiledCard))])",
    "Prevent all damage that would be dealt this turn by a source of your choice that shares a color with the exiled card": "ActionList([ChooseADamageSource(SharesAColorWithExiledCard(TheExiledCard)), CreatePreventDamageUntil(DamageWouldBeDealtBySource(TheChosenDamageSource), [PreventThatDamage], UntilEndOfTurn)])",
    "Put {{a}} {{CounterType}} counter on target {{Permanent}}. Then if {{Condition}}, you may play the exiled card without paying its mana cost": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent), If({{Condition[0]}}, [MayAction(PlayExiledCardWithoutPaying(TheExiledCard))])]))",
    "Return the exiled card to its owner's hand": "ActionList([PutExiledCardsIntoOwnersHand(TheExiledCards)])",
    "You may copy the exiled card. If you do, you may cast the copy without paying its mana cost": "ActionList([MayCost(CopyExiledCard(TheExiledCard)), If(CostWasPaid, [MayAction(CastCopiedCardWithoutPaying)])])",
    "You may play the exiled card without paying its mana cost if {{Condition}}": "ActionList([If({{Condition[0]}}, [MayAction(PlayExiledCardWithoutPaying(TheExiledCard))])])"
  },
  "{{ActivatedActions[TheExiledCards]}}": {
    "Add one mana of any of the exiled cards' colors": "ActionList([AddMana(AnyManaColorOfAnExiledCard(TheExiledCards))])"
  },
  "{{ActivatedActions[TheLifePaid](~Permanent)}}": {
    "Create {{a}} {{PTX}} {{CreatureToken}}, where X is the life paid as this artifact entered": "ActionList([CreateTokens([TokenWithPT(PTX({{PTX[0]}}, TheLifePaid), {{CreatureToken[0]}}, [])])])"
  },
  "{{ActivatedActions[TheMilledCard]}}": {
    "For each colored mana symbol in the milled card's mana cost, add one mana of that color": "ActionList([AddMana(OneManaOfEachColorInManaCostOfTheMilledCard)])"
  },
  "{{ActivatedActions[ThePermanentsSacrificedThisWay]}}": {
    "If there were {{Number}} or more card types among the sacrificed permanents, each opponent loses {{Digits}} life, you gain {{Digits}} life, and you draw {{Number}} cards": "ActionList([If(NumberOfCardTypesAmongThePermanentsSacrificedThisWayIs(GreaterThanOrEqualTo({{Number[0]}})), [EachPlayerAction(Opponent, LoseLife({{Digits[0]}})), GainLife({{Digits[1]}}), DrawNumberCards({{Number[0]}})])])"
  },
  "{{ActivatedActions[TheResult]}}": {
    "Monstrosity X, where X is the result": "ActionList([Monstrosity(TheDiceResult)])"
  },
  "{{ActivatedActions[TheSacrificedPermanent](~Permanent)}}": {
    "Exile the top X cards of your library, where X is {{Number}} plus the mana value of the sacrificed artifact. You may play those cards this turn": "ActionList([ExileTheTopNumberCardsOfLibrary(Plus({{Number[0]}}, ManaValueOfTheSacrificedPermanent)), CreatePlayerEffectUntil(You, [MayPlayExiledCards(TheCardsExiledThisWay)], UntilEndOfTurn)])",
    "Put X {{CounterType}} counters on {{~Permanent}}, where X is the sacrificed creature's power": "ActionList([PutNumberCountersOfTypeOnPermanent(PowerOfTheSacrificedCreature, {{CounterType[0]}}, {{~Permanent}})])",
    "Put a number of {{CounterType}} counters on this creature equal to the sacrificed creature's toughness": "ActionList([PutNumberCountersOfTypeOnPermanent(ToughnessOfTheSacrificedCreature, {{CounterType[0]}}, {{~Permanent}})])",
    "Put {{a}} {{CounterType}} counter on this creature. If an outlaw was sacrificed this way, create a Treasure token": "ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{~Permanent}}), If(APermanentWasSacrificedThisWay(IsAnOutlaw), [CreateTokens([TreasureToken])])])",
    "Put {{a}} {{CounterType}} counter on {{~Permanent}}. If the sacrificed permanent was a Treasure, {{~Permanent}} gains {{Hasable}} until end of turn": "ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{~Permanent}}), If(APermanentWasSacrificedThisWay(IsArtifactType(Treasure)), [CreatePermanentLayerEffectUntil({{~Permanent}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])])",
    "Remove {{a}} {{CounterType}} counter from this creature. If the sacrificed creature was {{a}} {{Zombie}}, put {{a}} {{CounterType}} counter on this creature": "ActionList([RemoveACounterOfTypeFromPermanent({{CounterType[0]}}, {{~Permanent}}), If(APermanentWasSacrificedThisWay(IsCreatureType({{Zombie[0]}})), [PutACounterOfTypeOnPermanent({{CounterType[1]}}, {{~Permanent}})])])",
    "This Aura deals damage equal to the sacrificed creature's power to each creature": "ActionList([PermanentDealsDamage({{~Permanent}}, PowerOfTheSacrificedCreature, EachPermanent(IsCardtype(Creature)))])",
    "This creature deals damage equal to the sacrificed creature's power to any target": "Targeted([AnyTarget], ActionList([PermanentDealsDamage({{~Permanent}}, PowerOfTheSacrificedCreature, Ref_AnyTarget)]))",
    "This creature deals damage equal to {{Digits}} plus the sacrificed permanent's mana value to any target": "Targeted([AnyTarget], ActionList([PermanentDealsDamage({{~Permanent}}, Plus({{Digits[0]}}, ManaValueOfTheSacrificedPermanent), Ref_AnyTarget)]))",
    "This creature deals damage to any target equal to half the sacrificed creature's power, rounded down": "Targeted([AnyTarget], ActionList([PermanentDealsDamage({{~Permanent}}, HalfRoundedDown(PowerOfTheSacrificedCreature), Ref_AnyTarget)]))",
    "This creature gains {{Hasable}} until end of turn. If the sacrificed creature was {{a}} {{Zombie}}, put {{a}} {{CounterType}} counter on this creature": "ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), If(APermanentWasSacrificedThisWay(IsCreatureType({{Zombie[0]}})), [PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{~Permanent}})])])",
    "This creature gets {{PTModX}} until end of turn, where X is the sacrificed enchantment's mana value": "ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [AdjustPTX({{PTModX[0]}}, ManaValueOfTheSacrificedPermanent)], UntilEndOfTurn)])",
    "This creature gets {{PTMod}} until end of turn. If {{a}} {{Zombie}} was sacrificed this way, you gain {{Digits}} life": "ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), If(APermanentWasSacrificedThisWay(IsCreatureType({{Zombie[0]}})), [GainLife({{Digits[0]}})])])",
    "This enchantment deals damage to any target equal to the number of {{Black}} mana symbols in the sacrificed creature's mana cost": "Targeted([AnyTarget], ActionList([PermanentDealsDamage({{~Permanent}}, NumberOfColorManaSymbolsInManaCostOfTheSacrificedPermanent({{Black[0]}}), Ref_AnyTarget)]))",
    "{{~Permanent}} becomes a copy of the sacrificed creature, except it has this ability": "ActionList([CreatePermanentLayerEffect({{~Permanent}}, [IsACopyOfPermanent(TheSacrificedPermanent, CopyEffects([AddAbilityVariable(ThisAbility)]))])])",
    "{{~Permanent}} deals X damage to target opponent or battle and you gain X life, where X is the sacrificed permanent's mana value": "Targeted([TargetPlayerOrPermanent(Opponent, IsCardtype(Battle))], ActionList([PermanentDealsDamage({{~Permanent}}, ManaValueOfTheSacrificedPermanent, Ref_TargetPlayerOrPermanent), GainLife(ManaValueOfTheSacrificedPermanent)]))",
    "{{~Permanent}} deals damage equal to the sacrificed artifact's mana value to any target": "Targeted([AnyTarget], ActionList([PermanentDealsDamage({{~Permanent}}, ManaValueOfTheSacrificedPermanent, Ref_AnyTarget)]))",
    "{{~Permanent}} deals damage equal to the sacrificed creature's power to each opponent. Then draw cards equal to the sacrificed creature's power": "ActionList([PermanentDealsDamage({{~Permanent}}, PowerOfTheSacrificedCreature, EachPlayer(Opponent)), DrawNumberCards(PowerOfTheSacrificedCreature)])",
    "{{~Permanent}} deals damage equal to the sacrificed creature's power to target player or planeswalker": "Targeted([TargetPlayerOrPermanent(AnyPlayer, IsCardtype(Planeswalker))], ActionList([PermanentDealsDamage({{~Permanent}}, PowerOfTheSacrificedCreature, Ref_TargetPlayerOrPermanent)]))",
    "{{~Permanent}} deals {{Digits}} damage to any target if the sacrificed creature was {{Black}}. Draw a card if the sacrificed creature was {{Black}}": "Targeted([AnyTarget], ActionList([If(APermanentWasSacrificedThisWay(IsColor({{Black[0]}})), [PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Ref_AnyTarget)]), If(APermanentWasSacrificedThisWay(IsColor({{Black[1]}})), [DrawACard])]))",
    "{{~Permanent}} gets {{PTModX}} until end of turn, where X is the sacrificed creature's power": "ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [AdjustPTX({{PTModX[0]}}, PowerOfTheSacrificedCreature)], UntilEndOfTurn)])"
  },
  "{{ActivatedActions[TheSacrificedPermanent]}}": {
    "Add an amount of {{ManaProduceSymbol}} equal to the sacrificed artifact's mana value": "ActionList([AddManaRepeated({{ManaProduceSymbol[0]}}, ManaValueOfTheSacrificedPermanent)])",
    "Add an amount of {{ManaProduceSymbol}} equal to the sacrificed artifact's mana value. Spend this mana only to cast artifact spells or activate abilities of artifacts": "ActionList([AddManaRepeatedWithModifiers({{ManaProduceSymbol[0]}}, ManaValueOfTheSacrificedPermanent, Or([CanOnlySpendOnSpells(IsCardtype(Artifact)), CanOnlySpendToActivateAbilitiesOfPermanents(IsCardtype(Artifact))]))])",
    "Add an amount of {{ManaProduceSymbol}} equal to the sacrificed creature's mana value": "ActionList([AddManaRepeated({{ManaProduceSymbol[0]}}, ManaValueOfTheSacrificedPermanent)])",
    "Add an amount of {{ManaProduceSymbol}} equal to the sacrificed creature's power": "ActionList([AddManaRepeated({{ManaProduceSymbol[0]}}, PowerOfTheSacrificedCreature)])",
    "Add one mana of any type the sacrificed land could produce": "ActionList([AddMana(AnyManaTypeTheSacrificedPermanentCouldProduce)])",
    "Count the colors of the sacrificed creature, then search your library for a creature card that's exactly that many colors plus one. Exile that card, then shuffle. You may cast the exiled card": "ActionList([SearchLibrary([FindACardOfType(And([IsCardtype(Creature), IsNumberColors(EqualTo(Plus(NumColorsOfPermanent(ThePermanentSacrificedThisWay), Integer(1))))])), ExileFoundCards, Shuffle]), MayAction(CastSpellFromExile(AnySpell, TheCardExiledThisWay))])",
    "Create X {{PT}} {{CreatureTokens}}, where X is the sacrificed creature's mana value": "ActionList([CreateTokens([NumberTokens(ManaValueOfTheSacrificedPermanent, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])])",
    "Create X {{PT}} {{CreatureTokens}}, where X is the sacrificed creature's power": "ActionList([CreateTokens([NumberTokens(PowerOfTheSacrificedCreature, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])])",
    "Create X {{PT}} {{CreatureTokens}}, where X is the sacrificed creature's toughness": "ActionList([CreateTokens([NumberTokens(ToughnessOfTheSacrificedCreature, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])])",
    "Create a Blood token. If you sacrificed {{a}} {{Zombie}} this way, create a number of Blood tokens equal to its toughness instead": "ActionList([IfElse(APermanentWasSacrificedThisWay(IsCreatureType({{Zombie[0]}})), [CreateTokens([NumberTokens(ToughnessOfTheSacrificedCreature, BloodToken)])], [CreateTokens([BloodToken])])])",
    "Create a Food token. If the sacrificed creature's toughness was {{Digits}} or greater, create {{Number}} Food tokens instead": "ActionList([IfElse(PermanentPassesFilter(ThePermanentSacrificedThisWay, ToughnessIs(GreaterThanOrEqualTo({{Digits[0]}}))), [CreateTokens([NumberTokens({{Number[0]}}, FoodToken)])], [CreateTokens([FoodToken])])])",
    "Create {{Number}} tokens that are copies of the sacrificed creature": "ActionList([CreateTokens([NumberTokens({{Number[0]}}, TokenCopyOfPermanent(ThePermanentSacrificedThisWay, NoTokenCopyEffects))])])",
    "Create {{a}} {{PTX}} {{CreatureToken}}, where X is the sacrificed creature's power": "ActionList([CreateTokens([TokenWithPT(PTX({{PTX[0]}}, PowerOfTheSacrificedCreature), {{CreatureToken[0]}}, [])])])",
    "Create {{a}} {{PTX}} {{CreatureToken}}, where X is the sacrificed creature's toughness": "ActionList([CreateTokens([TokenWithPT(PTX({{PTX[0]}}, ToughnessOfTheSacrificedCreature), {{CreatureToken[0]}}, [])])])",
    "Destroy each creature with the same mana value as the sacrificed creature": "ActionList([DestroyEachPermanent(And([IsCardtype(Creature), ManaValueIs(EqualTo(ManaValueOfTheSacrificedPermanent))]))])",
    "Destroy target {{Permanent}}. Search your library for a card with the same name as the sacrificed creature, reveal that card, put it into your hand, then shuffle": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([DestroyPermanent(Ref_TargetPermanent), SearchLibrary([FindACardOfType(IsNamed(TheNameOfTheSacrificedCreature)), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])]))",
    "Draw X cards, where X is that creature's power": "ActionList([DrawNumberCards(PowerOfTheSacrificedCreature)])",
    "Draw a card. If the sacrificed creature was suspected, draw {{Number}} cards instead": "ActionList([IfElse(PermanentPassesFilter(ThePermanentSacrificedThisWay, IsSuspected), [DrawNumberCards({{Number[0]}})], [DrawACard])])",
    "Draw cards equal to the sacrificed creature's power": "ActionList([DrawNumberCards(PowerOfTheSacrificedCreature)])",
    "Draw cards equal to the sacrificed creature's power, then discard a card": "ActionList([DrawNumberCards(PowerOfTheSacrificedCreature), DiscardACard])",
    "Draw cards equal to the sacrificed creature's power, then discard {{Number}} cards": "ActionList([DrawNumberCards(PowerOfTheSacrificedCreature), DiscardNumberCards({{Number[0]}})])",
    "Draw cards equal to the sacrificed creature's toughness, then discard cards equal to its power": "ActionList([DrawNumberCards(ToughnessOfTheSacrificedCreature), DiscardNumberCards(PowerOfTheSacrificedCreature)])",
    "Each opponent loses life equal to the sacrificed creature's power": "ActionList([EachPlayerAction(Opponent, LoseLife(PowerOfTheSacrificedCreature))])",
    "It deals damage equal to {{GameNumber}} to target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([PermanentDealsDamage(TheSacrificedPermanent, {{GameNumber[0]}}, Permanent(Ref_TargetPermanent))]))",
    "Reveal a number of cards from the top of your library equal to the sacrificed creature's power. Put one into your hand and exile the rest": "ActionList([RevealTheTopNumberCardsOfLibrary(PowerOfTheSacrificedCreature, [PutAGenericCardIntoHand, ExileTheRemainingCards])])",
    "Reveal the top {{Number}} cards of your library. Put up to {{Number}} {{PermanentCards}} with total mana value less than or equal to the sacrificed artifact's mana value from among them onto the battlefield and the rest on the bottom of your library in a random order": "ActionList([RevealTheTopNumberCardsOfLibrary({{Number[0]}}, [MayPutUptoNumberGroupCardsOntoTheBattlefield({{Number[0]}}, {{PermanentCards[0]}}, TotalManaValueIs(LessThanOrEqualTo(ManaValueOfTheSacrificedPermanent)), [EntersNormally]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "Search your library for a creature card that shares a creature type with the sacrificed creature and has mana value equal to {{Digits}} plus that creature's mana value. Put that card onto the battlefield, then shuffle": "ActionList([SearchLibrary([FindACardOfType(And([IsCardtype(Creature), SharesACreatureTypeWithPermanent(ThePermanentSacrificedThisWay), ManaValueIs(EqualTo(Plus({{Digits[0]}}, ManaValueOfTheSacrificedPermanent)))])), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle])])",
    "Search your library for a creature card with mana value equal to {{Digits}} plus the sacrificed creature's mana value, put that card onto the battlefield, then shuffle": "ActionList([SearchLibrary([FindACardOfType(And([IsCardtype(Creature), ManaValueIs(EqualTo(Plus({{Digits[0]}}, ManaValueOfTheSacrificedPermanent)))])), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle])])",
    "Search your library for an artifact card with mana value equal to {{Digits}} plus the sacrificed artifact's mana value, put it onto the battlefield, then shuffle": "ActionList([SearchLibrary([FindACardOfType(And([IsCardtype(Artifact), ManaValueIs(EqualTo(Plus({{Digits[0]}}, ManaValueOfTheSacrificedPermanent)))])), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle])])",
    "Search your library for an artifact card with mana value equal to {{Digits}} plus the sacrificed artifact's mana value, put that card onto the battlefield, then shuffle": "ActionList([SearchLibrary([FindACardOfType(And([IsCardtype(Artifact), ManaValueIs(EqualTo(Plus({{Digits[0]}}, ManaValueOfTheSacrificedPermanent)))])), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle])])",
    "Seek a creature card with mana value equal to {{Digits}} plus the sacrificed creature's mana value and put that card onto the battlefield. That creature is {{a}} {{Zombie}} in addition to its other types": "ActionList([SeekACard(And([IsCardtype(Creature), ManaValueIs(EqualTo(Plus({{Digits[0]}}, ManaValueOfTheSacrificedPermanent)))])), PutCardFromHandOnBattlefield(TheCardSeekedThisWay, [EntersWithLayerEffect([AddCreatureType({{Zombie[0]}})])])])",
    "Target opponent loses life equal to the sacrificed creature's toughness": "Targeted([TargetPlayer(Opponent)], ActionList([PlayerAction(Ref_TargetPlayer, LoseLife(PowerOfTheSacrificedCreature))]))",
    "Target player loses X life and you gain X life, where X is the sacrificed creature's power": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, LoseLife(PowerOfTheSacrificedCreature)), GainLife(PowerOfTheSacrificedCreature)]))",
    "Target player loses life equal to the sacrificed creature's power": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, LoseLife(PowerOfTheSacrificedCreature))]))",
    "Target player loses {{Digits}} life. If the sacrificed creature was legendary, amass Orcs {{Digits}}": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, LoseLife({{Digits[0]}})), If(APermanentWasSacrificedThisWay(IsSupertype(Legendary)), [Amass({{Digits[1]}}, Orc)])]))",
    "Target player mills cards equal to the sacrificed creature's power": "Targeted([TargetPlayer(AnyPlayer)], ActionList([MillNumberCards(PowerOfTheSacrificedCreature)]))",
    "Target {{Creature}} gains landwalk of each of the land types of the sacrificed land until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([Landwalk(IsLandTypeVariable(AnyLandTypeOfPermanent(ThePermanentSacrificedThisWay)))])], UntilEndOfTurn)]))",
    "You gain X life and put X {{CounterType}} counters on target {{Permanent}}, where X is the sacrificed creature's power": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([GainLife(PowerOfTheSacrificedCreature), PutNumberCountersOfTypeOnPermanent(PowerOfTheSacrificedCreature, {{CounterType[0]}}, Ref_TargetPermanent)]))",
    "You gain life equal to the sacrificed creature's toughness": "ActionList([GainLife(ToughnessOfTheSacrificedCreature)])",
    "You gain life equal to the sacrificed creature's toughness. Draw a card": "ActionList([GainLife(ToughnessOfTheSacrificedCreature), DrawACard])",
    "You gain life equal to the sacrificed enchantment's mana value": "ActionList([GainLife(ManaValueOfTheSacrificedPermanent)])"
  },
  "{{ActivatedActions[TheSacrificedPermanents]}}": {
    "Create {{a}} {{PT}} {{CreatureToken}} for each creature sacrificed this way": "ActionList([CreateTokens([NumberTokens(TheNumberOfPermanentsSacrificedThisWay, TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, []))])])"
  },
  "{{ActivatedActions[TheTappedPermanent](~Permanent)}}": {
    "This artifact deals damage equal to the tapped creature's power to target attacking or blocking creature with {{CheckHasable}}": "Targeted([TargetPermanent(And([Or([IsAttacking, IsBlocking]), IsCardtype(Creature), HasAbility({{CheckHasable[0]}})]))], ActionList([PermanentDealsDamage({{~Permanent}}, PowerOfPermanent(ThePermanentTappedThisWay), Permanent(Ref_TargetPermanent))]))",
    "This creature gets {{PTModX}} until end of turn, where X is the power of the creature tapped this way": "ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [AdjustPTX({{PTModX[0]}}, PowerOfPermanent(ThePermanentTappedThisWay))], UntilEndOfTurn)])"
  },
  "{{ActivatedActions[TheTappedPermanent]}}": {
    "Add one mana of any type that land could produce": "ActionList([AddMana(AnyManaTypePermanentCouldProduce(ThePermanentTappedThisWay))])",
    "Target creature other than the creature tapped this way gets {{PTMod}} until end of turn": "Targeted([TargetPermanent(And([IsCardtype(Creature), Other(ThePermanentTappedThisWay)]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)]))"
  },
  "{{ActivatedActions[ThisDiscardedCard]}}": {
    "Destroy up to one target {{Permanent}}. Shuffle this card into your library from your graveyard, then draw a card": "Targeted([UptoOneTargetPermanent({{Permanent[0]}})], ActionList([DestroyPermanent(Ref_TargetPermanent), ShuffleGraveyardCardIntoLibrary(ThisGraveyardCard), DrawACard]))",
    "It deals damage equal to {{GameNumber}} to target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([DiscardedCardDealsDamage(ThisCardInHand, {{GameNumber[0]}}, Permanent(Ref_TargetPermanent))]))",
    "It deals {{Digits}} damage to any target": "Targeted([AnyTarget], ActionList([DiscardedCardDealsDamage(ThisCardInHand, {{Digits[0]}}, Ref_AnyTarget)]))",
    "It deals {{Digits}} damage to each {{Permanent}}": "ActionList([DiscardedCardDealsDamage(ThisCardInHand, {{Digits[0]}}, EachPermanent({{Permanent[0]}}))])",
    "It deals {{Digits}} damage to target {{CreatureOrPlaneswalker}}": "Targeted([TargetPermanent({{CreatureOrPlaneswalker[0]}})], ActionList([DiscardedCardDealsDamage(ThisCardInHand, {{Digits[0]}}, Permanent(Ref_TargetPermanent))]))",
    "It deals {{Digits}} damage to target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([DiscardedCardDealsDamage(ThisCardInHand, {{Digits[0]}}, Permanent(Ref_TargetPermanent))]))",
    "Tap up to one target {{Permanent}}. Draw a card. Then you may exile {{Number}} other cards named {{NamedCard}} from your graveyard. When you do, return {{~GraveyardCard}} from your graveyard to the battlefield tapped": "Targeted([UptoOneTargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), DrawACard, MayCost(ExileNumberGraveyardCards({{Number[0]}}, And([Other(ThisGraveyardCard), IsNamed(NamedCard({{NamedCard[0]}})), InAPlayersGraveyard(SinglePlayer(You))]))), If(CostWasPaid, [ReflexiveTrigger(ActionList([PutGraveyardCardOntoBattlefield(ThisGraveyardCard, [EntersTapped])]))])]))"
  },
  "{{ActivatedActions[ThoseExiledCards]}}": {
    "Create {{NamedCard}}, a legendary {{PT}} {{Black}} {{Zombie}} {{Zombie}} creature token with {{Hasable}} and all triggered abilities of the exiled cards": "ActionList([CreateTokens([NamedTokenWithPTAndWithCopyEffects({{NamedCard[0]}}, {{PT[0]}}, Colors([{{Black[0]}}]), [Legendary], [Creature], SubtypesList([{{Zombie[0]}}, {{Zombie[1]}}]), [{{Hasable[0]}}], TokenCopyEffects([AddAbilityFromEachExiledHasable(TheExiledCards, [TriggeredAbility])]))])])"
  },
