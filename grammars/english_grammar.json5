    "Mill {{Number}} cards. Whenever {{a}} {{Creature}} attacks this turn, it gets {{PTMod}} until end of turn for each {{SpecificCard}} put into your graveyard this way": "ActionList([MillNumberCards({{Number[0]}}), CreateTriggerUntil(WhenACreatureAttacks({{Creature[0]}}), ActionList([CreatePermanentLayerEffectUntil(Trigger_ThatCreature, [AdjustPTForEach({{PTMod[0]}}, NumCardsMilledIntoGraveyardThisWay({{SpecificCard[0]}}))], UntilEndOfTurn)]), UntilEndOfTurn)])",
    "Mill {{Number}} cards. You may put up to {{Number}} {{SpecificCards}} from among the milled cards into your hand": "ActionList([MillNumberCards({{Number[0]}}), PutUptoNumberCardsOfTypeMilledThisWayIntoHand({{Number[1]}}, {{SpecificCards[0]}})])",
    "Mill {{Number}} cards. You may put {{a}} {{SpecificCard}} from among the cards milled this way into your hand": "ActionList([MillNumberCards({{Number[0]}}), PutACardFromGraveyardIntoHand(CardsOfTypeMilledThisWay({{SpecificCard[0]}}))])",
    "Mill {{Number}} cards. You may put {{a}} {{SpecificCard}} from among the cards milled this way into your hand. If {{Condition}} or returned {{a}} {{SpecificCard}} to your hand this way, create a Food token": "ActionList([MillNumberCards({{Number[0]}}), MayAction(PutACardOfTypeMilledThisWayIntoHand({{SpecificCard[0]}})), If(Or([{{Condition[0]}}, ACardWasPutIntoHandThisWay({{SpecificCard[1]}})]), [CreateTokens([FoodToken])])])",
    "Mill {{Number}} cards. You may put {{a}} {{SpecificCard}} from among the milled cards into your hand. You gain {{Digits}} life": "ActionList([MillNumberCards({{Number[0]}}), MayAction(PutACardFromGraveyardIntoHand(CardsOfTypeMilledThisWay({{SpecificCard[0]}}))), GainLife({{Digits[0]}})])",
    "Mill {{Number}} cards. You may put {{a}} {{SpecificCard}} from among them into your hand. You gain {{Digits}} life": "ActionList([MillNumberCards({{Number[0]}}), MayAction(PutACardFromGraveyardIntoHand(CardsOfTypeMilledThisWay({{SpecificCard[0]}}))), GainLife({{Digits[0]}})])",
    "Move all counters from target {{Permanent}} onto another target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}}), TargetPermanent(And([Other(Ref_TargetPermanent1), {{Permanent[1]}}]))], ActionList([MoveAllCountersFromPermanentOntoAnotherPermanent(Ref_TargetPermanent1, Ref_TargetPermanent2)]))",
    "Move any number of {{CounterType}} counters from target {{Permanent}} onto another target {{Permanent}} with the same controller": "Targeted([TargetPermanent({{Permanent[0]}}), TargetPermanent(And([Other(Ref_TargetPermanent1), {{Permanent[1]}}, ControlledByPlayer(ControllerOfPermanent(Ref_TargetPermanent1))]))], ActionList([MoveAnyNumberOfCountersOfTypeFromPermanentOntoNewPermanent({{CounterType[0]}}, Ref_TargetPermanent1, Ref_TargetPermanent2)]))",
    "One or more target {{Permanents}} become {{Black}} until end of turn": "Targeted([OneOrMoreTargetPermanents({{Permanents[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [SetColor(SimpleColorList([{{Black[0]}}]))], UntilEndOfTurn)]))",
    "One or two target {{Creatures}} can't block this turn": "Targeted([OneOrTwoTargetPermanents({{Creatures[0]}})], ActionList([CreateEachPermanentRuleEffectUntil(Ref_TargetPermanents, [CantBlock], UntilEndOfTurn)]))",
    "One or two target {{Creatures}} each gain {{Hasable}} until end of turn. For each of those creatures, create a Monster Role token attached to it": "Targeted([OneOrTwoTargetPermanents({{Creatures[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), ForEachPermanentCreateTokensWithFlags(Ref_TargetPermanents, [MonsterRoleToken], [EntersAttachedToPermanent(EachablePermanent)])]))",
    "One or two target {{Creatures}} each gain {{Hasable}} until end of turn. They can't be blocked this turn except by {{Creatures}}": "Targeted([OneOrTwoTargetPermanents({{Creatures[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), CreateEachPermanentRuleEffectUntil(Ref_TargetPermanents, [CantBeBlockedExceptByDefenders({{Creatures[1]}})], UntilEndOfTurn)]))",
    "One or two target {{Creatures}} each get {{PTMod}} and gain {{Hasable}} until end of turn": "Targeted([OneOrTwoTargetPermanents({{Creatures[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "One or two target {{Creatures}} each get {{PTMod}} until end of turn": "Targeted([OneOrTwoTargetPermanents({{Creatures[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)]))",
    "One or two target {{Creatures}} each get {{PTMod}} until end of turn. They each deal damage equal to their power to target {{Permanent}}": "Targeted([OneOrTwoTargetPermanents({{Creatures[0]}}), TargetPermanent({{Permanent[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), EachPermanentDealsDamage(Ref_TargetPermanents, PowerOfPermanent(EachablePermanent), Permanent(Ref_TargetPermanent))]))",
    "One or two target {{Permanents}} gain {{Hasable}} until end of turn": "Targeted([OneOrTwoTargetPermanents({{Permanents[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
