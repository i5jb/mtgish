    "{{Creatures}} get {{PTMod}} and gain {{Hasable}} and {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTMod}} and gain {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTMod}} and gain {{Hasable}} until end of turn. Untap those creatures": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), UntapEachPermanent({{Creatures[0]}})])",
    "{{Creatures}} get {{PTMod}} and gain {{Hasable}} until end of turn. You may turn {{a}} {{Creature}} face up": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), MayAction(TurnAPermanentFaceUp({{Creature[0]}}))])",
    "{{Creatures}} get {{PTMod}} and lose {{CheckHasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}}), LosesAbility({{CheckHasable[0]}})], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTMod}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTMod}} until end of turn for each {{Eachable(ThatPermanent)}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPTForEach({{PTMod[0]}}, {{Eachable(ThatPermanent=EachablePermanent)[0]}})], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTMod}} until end of turn.\nDraw a card": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), DrawACard])",
    "{{Creatures}} get {{PTMod}} until end of turn.\n{{AbilityWord}} - If {{Condition}}, choose a color. {{Creatures}} also gain protection from the chosen color until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), If({{Condition[0]}}, [ChooseAColor(AnyColor), CreateEachPermanentLayerEffectUntil({{Creatures[1]}}, [AddAbility([Protection(FromColor(TheChosenColor))])], UntilEndOfTurn)])])",
    "{{Creatures}} get {{PTMod}} until end of turn.\n{{AbilityWord}} - If {{Condition}}, those creatures also gain {{Hasable}} until end of turn": "ActionList([IfElse({{Condition[0]}}, [CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)], [CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])])",
    "{{Creatures}} get {{PTMod}} until end of turn.\n{{AbilityWord}} - If {{Condition}}, those creatures gain {{Hasable}} until end of turn": "ActionList([IfElse({{Condition[0]}}, [CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)], [CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])])",
    "{{Creatures}} get {{PTMod}} until end of turn.\n{{AbilityWord}} - If {{Condition}}, {{Creatures}} get {{PTMod}} until end of turn instead": "ActionList([IfElse({{Condition[0]}}, [CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)], [CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])])",
    "{{Creatures}} get {{PTMod}} until end of turn.\n{{Creatures}} get {{PTMod}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), CreateEachPermanentLayerEffectUntil({{Creatures[1]}}, [AdjustPT({{PTMod[1]}})], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTMod}} until end of turn. Each {{Creature}} blocks this turn if able": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), CreateEachPermanentRuleEffectUntil({{Creature[0]}}, [MustBlock], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTMod}} until end of turn. If {{Condition}}, draw a card": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), If({{Condition[0]}}, [DrawACard])])",
    "{{Creatures}} get {{PTMod}} until end of turn. If {{Condition}}, exile the top card of your library. Until the end of your next turn, you may play that card": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), If({{Condition[0]}}, [ExileTopCardOfLibrary, CreatePlayerEffectUntil(You, [MayPlayExiledCard(TheCardExiledThisWay)], UntilTheEndOfPlayersNextTurn(You))])])",
    "{{Creatures}} get {{PTMod}} until end of turn. If {{Condition}}, scry {{Digits}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), If({{Condition[0]}}, [Scry({{Digits[0]}})])])",
    "{{Creatures}} get {{PTMod}} until end of turn. If {{Condition}}, untap those creatures": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), If({{Condition[0]}}, [UntapEachPermanent(ThePermanentsAffectedThisWay)])])",
    "{{Creatures}} get {{PTMod}} until end of turn. Investigate": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), Investigate])",
    "{{Creatures}} get {{PTMod}} until end of turn. Other {{Creatures}} get {{PTMod}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), CreateEachPermanentLayerEffectUntil(And([ExceptFor({{Creatures[0]}}), {{Creatures[1]}}]), [AdjustPT({{PTMod[1]}})], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTMod}} until end of turn. The Ring tempts you": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), TemptWithRing])",
    "{{Creatures}} get {{PTMod}} until end of turn. They get an additional {{PTMod}} until end of turn unless any player pays {{ManaCost}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), AnyPlayerMayCost(AnyPlayer, PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[1]}})], UntilEndOfTurn)])])",
    "{{Creatures}} get {{PTMod}} until end of turn. Untap them": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), UntapEachPermanent(ThePermanentsAffectedThisWay)])",
    "{{Creatures}} get {{PTMod}} until end of turn. Untap those creatures": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), UntapEachPermanent(ThePermanentsAffectedThisWay)])",
    "{{Creatures}} get {{PTMod}} until end of turn. Whenever a creature blocks this turn, its controller gets a poison counter": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), CreateTriggerUntil(WhenACreatureBlocks(IsCardtype(Creature)), ActionList([PlayerAction(ControllerOfPermanent(Trigger_ThatCreature), GetAPoisonCounter)]), UntilEndOfTurn)])",
    "{{Creatures}} get {{PTMod}} until end of turn. Whenever {{a}} {{Creature}} dies this turn, create {{a}} {{PT}} {{CreatureToken}} with \"{{TokenQuotedAbility}}\"": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), CreateTriggerUntil(WhenACreatureOrPlaneswalkerDies({{Creature[0]}}), ActionList([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{TokenQuotedAbility[0]}}])])]), UntilEndOfTurn)])",
    "{{Creatures}} get {{PTMod}} until end of turn. {{Creatures}} also gain {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), CreateEachPermanentLayerEffectUntil({{Creatures[1]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTMod}} until end of turn. {{Creatures}} gain {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), CreateEachPermanentLayerEffectUntil({{Creatures[1]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTMod}} until end of turn. {{Creatures}} get an additional {{PTMod}} and gain {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), CreateEachPermanentLayerEffectUntil({{Creatures[1]}}, [AdjustPT({{PTMod[1]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "{{Creatures}} have base power and toughness {{PT}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [SetPT({{PT[0]}})], UntilEndOfTurn)])",
    "{{Creatures}} have base power and toughness {{PT}} until end of turn. You may search your library and/or graveyard for {{a}} {{SpecificCard}}, reveal it, and put it into your hand. If you search your library this way, shuffle": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [SetPT({{PT[0]}})], UntilEndOfTurn), MayAction(SearchLibraryAndOrGraveyard([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsIntoHand, ShuffleLibraryIfSearched]))])",
    "{{Creatures}} of the creature type of your choice get {{PTMod}} until end of turn": "ActionList([ChooseACreatureType, CreateEachPermanentLayerEffectUntil(And([{{Creatures[0]}}, IsCreatureTypeVariable(TheChosenCreatureType)]), [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])",
    "{{Creatures}} target player controls attack this turn if able": "Targeted([TargetPlayer(AnyPlayer)], ActionList([CreateEachPermanentRuleEffectUntil(And([{{Creatures[0]}}, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]), [MustAttack], UntilEndOfTurn)]))",
    "{{Creatures}} target player controls get {{PTMod}} and gain all creature types until end of turn": "Targeted([TargetPlayer(AnyPlayer)], ActionList([CreateEachPermanentLayerEffectUntil(And([{{Creatures[0]}}, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]), [AdjustPT({{PTMod[0]}}), HasAllCreatureTypes], UntilEndOfTurn)]))",
    "{{Creatures}} target player controls get {{PTMod}} and gain {{Hasable}} until end of turn": "Targeted([TargetPlayer(AnyPlayer)], ActionList([CreateEachPermanentLayerEffectUntil(And([{{Creatures[0]}}, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]), [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "{{Creatures}} target player controls get {{PTMod}} and lose all creature types until end of turn": "Targeted([TargetPlayer(AnyPlayer)], ActionList([CreateEachPermanentLayerEffectUntil(And([{{Creatures[0]}}, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]), [AdjustPT({{PTMod[0]}}), RemoveAllCreatureTypes], UntilEndOfTurn)]))",
    "{{Creatures}} target player controls get {{PTMod}} until end of turn": "Targeted([TargetPlayer(AnyPlayer)], ActionList([CreateEachPermanentLayerEffectUntil(And([{{Creatures[0]}}, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]), [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)]))",
    "{{Creatures}} target player controls get {{PTMod}} until end of turn. Untap them": "Targeted([TargetPlayer(AnyPlayer)], ActionList([CreateEachPermanentLayerEffectUntil(And([{{Creatures[0]}}, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]), [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), UntapEachPermanent(ThePermanentsAffectedThisWay)]))",
    "{{Number}} target players each draw a card": "Targeted([NumberTargetPlayers({{Number[0]}}, AnyPlayer)], ActionList([EachPlayerAction(Ref_TargetPlayers, DrawACard)]))",
    "{{Number}} target {{Creatures}} each deal damage equal to their power to target {{Creature}}": "Targeted([NumberTargetPermanents({{Number[0]}}, {{Creatures[0]}}), TargetPermanent({{Creature[0]}})], ActionList([EachPermanentDealsDamage(Ref_TargetPermanents, PowerOfPermanent(EachablePermanent), Permanent(Ref_TargetPermanent))]))",
    "{{Number}} target {{Creatures}} each get {{PTMod}} and gain {{Hasable}} until end of turn": "Targeted([NumberTargetPermanents({{Number[0]}}, {{Creatures[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "{{Number}} target {{Creatures}} each get {{PTMod}} until end of turn": "Targeted([NumberTargetPermanents({{Number[0]}}, {{Creatures[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)]))",
    "{{Permanents}} can't be the targets of {{StackSpells}} this turn": "ActionList([CreateEachPermanentRuleEffectUntil({{Permanents[0]}}, [CantBeTheTargetOfSpells({{StackSpells[0]}})], UntilEndOfTurn)])",
    "{{Permanents}} don't untap during target player's next untap step": "ActionList([EachPermanentDoesntUntapDuringControllersNextUntap({{Permanents[0]}})])",
    "{{Permanents}} enter tapped this turn.\nDraw a card": "ActionList([CreateReplaceWouldEnterUntil(APermanentWouldEnterTheBattlefield({{Permanents[0]}}), [EntersTapped], UntilEndOfTurn), DrawACard])",
    "{{Permanents}} gain all basic land types until end of turn.\nDraw a card": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddLandTypeVariable(EachBasicLandType)], UntilEndOfTurn), DrawACard])",
    "{{Permanents}} gain {{Hasable}} and {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)])",
    "{{Permanents}} gain {{Hasable}} and {{Hasable}} until end of turn.\nSeek {{a}} {{SpecificCard}} if {{Condition}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn), If({{Condition[0]}}, [SeekACard({{SpecificCard[0]}})])])",
    "{{Permanents}} gain {{Hasable}} and {{Hasable}} until end of turn. After this main phase, there is an additional combat phase followed by an additional main phase": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn), ThereIsAnAdditionalCombatPhase])",
    "{{Permanents}} gain {{Hasable}} and {{Hasable}} until end of turn. Prevent all damage that would be dealt to those permanents this turn. Proliferate": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn), CreatePreventDamageUntil(DamageWouldBeDealtToARecipient(APermanent(ThePermanentsAffectedThisWay)), [PreventThatDamage], UntilEndOfTurn), Proliferate])",
    "{{Permanents}} gain {{Hasable}} and {{Hasable}} until end of turn. Roll a d20.\n{{RawDigits}}-{{RawDigits}} | {{Creatures}} get {{PTMod}} until end of turn.\n{{RawDigits}}-{{RawDigits}} | Put {{Number}} {{CounterType}} counters on each {{Permanent}}.\n{{RawDigits}} | Put {{Number}} {{CounterType}} counters on each {{Permanent}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn), RollAD20, ValueActions(TheDiceResult, [ValueAction(BetweenValues({{RawDigits[0]}}, {{RawDigits[1]}}), [CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)]), ValueAction(BetweenValues({{RawDigits[2]}}, {{RawDigits[3]}}), [PutNumberCountersOfTypeOnEachPermanent({{Number[0]}}, {{CounterType[0]}}, {{Permanent[0]}})]), ValueAction(ExactValue({{RawDigits[4]}}), [PutNumberCountersOfTypeOnEachPermanent({{Number[1]}}, {{CounterType[1]}}, {{Permanent[1]}})])])])",
    "{{Permanents}} gain {{Hasable}} and {{Hasable}} until end of turn. You gain {{Digits}} life": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn), GainLife({{Digits[0]}})])",
    "{{Permanents}} gain {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "{{Permanents}} gain {{Hasable}} until end of turn.\nDraw a card": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), DrawACard])",
    "{{Permanents}} gain {{Hasable}} until end of turn. Draw a card": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), DrawACard])",
    "{{Permanents}} gain {{Hasable}} until end of turn. If this spell was cast from exile, prevent all damage that would be dealt to you this turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), If(SpellPassesFilter(ThisSpell, WasCastFromExile), [CreatePreventDamageUntil(DamageWouldBeDealtToRecipient(Player(You)), [PreventThatDamage], UntilEndOfTurn)])])",
    "{{Permanents}} gain {{Hasable}} until end of turn. Put {{a}} {{CounterType}} counter on each {{Permanent}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, {{Permanent[0]}})])",
    "{{Permanents}} gain {{Hasable}} until end of turn. Then target {{Creature}} fights target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}}), TargetPermanent({{Creature[1]}})], ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), HaveCreaturesFight(Ref_TargetPermanent1, Ref_TargetPermanent2)]))",
    "{{Permanents}} gain {{Hasable}} until end of turn. Untap each {{Permanent}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), UntapEachPermanent({{Permanent[0]}})])",
    "{{Permanents}} gain {{Hasable}} until end of turn. {{Reminder}}\nDraw a card": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), DrawACard])",
    "{{Permanents}} gain {{Hasable}} until your next turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])], UntilPlayersNextTurn(You))])",
    "{{Permanents}} gain {{Hasable}}, {{Hasable}}, and {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}]), AddAbility([{{Hasable[2]}}])], UntilEndOfTurn)])",
    "{{Permanents}} gain {{Hasable}}. Take an extra turn after this one. At the beginning of that turn's end step, you lose the game": "ActionList([CreateEachPermanentLayerEffect({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])]), TakeAnExtraTurn, CreateFutureTrigger(AtTheBeginningOfTheEndStepOfTheExtraTurnCreatedThisWay, ActionList([LoseTheGame]))])",
    "{{Permanents}} lose {{CheckHasable}} until end of turn.\nDestroy all {{Permanents}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [LosesAbility({{CheckHasable[0]}})], UntilEndOfTurn), DestroyEachPermanent({{Permanents[1]}})])",
    "{{Permanents}} target opponent controls don't untap during their next untap step": "Targeted([TargetPlayer(Opponent)], ActionList([EachPermanentDoesntUntapDuringControllersNextUntap(And([{{Permanents[0]}}, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]))]))",
    "{{Permanents}} target player controls don't untap during that player's next untap step": "Targeted([TargetPlayer(AnyPlayer)], ActionList([EachPermanentDoesntUntapDuringControllersNextUntap(And([{{Permanents[0]}}, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]))]))",
    "{{Permanents}} target player controls don't untap during their next untap step": "Targeted([TargetPlayer(AnyPlayer)], ActionList([EachPermanentDoesntUntapDuringControllersNextUntap(And([{{Permanents[0]}}, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]))]))",
    "{{Permanents}} target player controls gain {{Hasable}} until end of turn": "Targeted([TargetPlayer(AnyPlayer)], ActionList([CreateEachPermanentLayerEffectUntil(And([{{Permanents[0]}}, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]), [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "{{SpellActions(SpellDefendingPlayer)}}": "{{SpellActions(SpellDefendingPlayer=SpellDefendingPlayer)[0]}}",
    "{{SpellActions[Bargain]}}": "{{SpellActions[Bargain][0]}}",
    "{{SpellActions[PaidAdditionalManaCost]}}": "{{SpellActions[PaidAdditionalManaCost][0]}}",
    "{{SpellActions[RevealedACard]}}": "{{SpellActions[RevealedACard][0]}}",
    "{{SpellActions[TheSacrificedPermanents]}}": "{{SpellActions[TheSacrificedPermanents][0]}}",
    "{{SpellActions[TheTappedPermanents]}}": "{{SpellActions[TheTappedPermanents][0]}}"
  },
  "{{SpellQuotedAbility}}": {
    "When this creature enters, {{TriggerActions(ThatPermanent)}}": "TriggerA(WhenAPermanentEntersTheBattlefield(SinglePermanent(ThisPermanent)), {{TriggerActions(ThatPermanent=ThatEnteringPermanent)[0]}})"
  },
  "{{SpellStaticEffect(~Spell)}}": {
    "As long as {{~Spell}} is on the stack, each {{Permanent}} has \"{{TapSelfCost}}: Prevent the next {{Digits}} damage that would be dealt to this creature by {{~Spell}} this turn\"": "FromStack(EachPermanentLayerEffect({{Permanent[0]}}, [AddAbility([Activated({{TapSelfCost[0]}}, ActionList([CreateFuturePreventDamage(NextAmountOfDamageThatWouldBeDealtThisTurnBySpellToRecipient({{Digits[0]}}, TheSpellThatGrantedThisAbility, Permanent(ThisPermanent)), [PreventThatDamage])]))])]))",
    "As long as {{~Spell}} is on the stack, spells that target it cost {{ManaCost}} more to cast": "FromStack(EachPlayerEffect(AnyPlayer, [IncreaseSpellCost(TargetsSpell(ThisSpell), PayMana({{ManaCost[0]}}))]))"
  },
  "{{SpellWithX}}": {
    "permanent spell with a mana cost that contains {X}": "And([IsPermanent, HasXInCost])",
    "spell with {X} in its mana cost": "HasXInCost"
  },
