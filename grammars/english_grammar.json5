    "Enchanted creature gets {{PTMod}}, has {{Hasable}}, and can block an additional creature each combat": "PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])]), PermanentRuleEffect(HostPermanent, [CanBlockAnAdditionalCreature])",
    "Enchanted creature gets {{PTMod}}, has {{Hasable}}, and can block creatures with shadow as though they didn't have shadow": "PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])]), PermanentRuleEffect(HostPermanent, [CanBlockCreaturesWithShadowAsThoughTheyDidntHaveShadow])",
    "Enchanted creature gets {{PTMod}}, has {{Hasable}}, and can't attack you or planeswalkers you control": "PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])]), PermanentRuleEffect(HostPermanent, [CantAttackPlayerOrPlaneswalkerControlledBy(You)])",
