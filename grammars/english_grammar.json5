    "The next {{Digits}} damage that would be dealt to target {{Creature}} this turn is dealt to another target {{Creature}} instead": "Targeted([TargetPermanent({{Creature[0]}}), TargetPermanent(And([Other(Ref_TargetPermanent1), {{Creature[1]}}]))], ActionList([CreateFutureReplaceWouldDealDamage(NextAmountOfDamageThatWouldBeDealtThisTurnToRecipient({{Digits[0]}}, Permanent(Ref_TargetPermanent1)), [DealToCreatureOrPlaneswalkerInstead(Ref_TargetPermanent2)])]))",
    "The next {{Digits}} damage that would be dealt to target {{Creature}} this turn is dealt to you instead": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreateFutureReplaceWouldDealDamage(NextTimeDamageWouldBeDealtThisTurnToRecipient(Permanent(Ref_TargetPermanent)), [DealToPlayerInstead(You)])]))",
    "The next {{PotentialSpell}} you cast this turn costs {{CostReduceX}} less to cast, where X is {{GameNumber}} as this ability resolves": "ActionList([CreateFutureSpellEffect(TheNextSpellPlayerCastsThisTurn({{PotentialSpell[0]}}, You), [DecreaseManaCostX({{CostReduceX[0]}}, {{GameNumber[0]}})])])",
