    "+X/+0": "PlusX, Zero",
    "+X/+1": "PlusX, Integer(+1)",
    "+X/+X": "PlusX, PlusX",
    "+X/-X": "PlusX, MinusX",
    "+{{RawDigits}}/-X": "Integer(+{{RawDigits[0]}}), MinusX",
    "-0/-X": "Zero, MinusX",
