    "Whenever you sacrifice another {{Permanent}}, {{TriggerActions(~Permanent,ThatSacrificedPermanent)}}": "TriggerA(WhenAPlayerSacrificesAPermanent(SinglePlayer(You), And([Other(ThisPermanent), {{Permanent[0]}}])), {{TriggerActions(~Permanent=^~Permanent,ThatSacrificedPermanent=Trigger_ThatSacrificedPermanent)[0]}})",
    "Whenever you sacrifice one or more other {{Permanents}}, {{TriggerActions(~Permanent)}}. This ability triggers only once each turn": "TriggerOnceEachTurn(WhenAPlayerSacrificesAPermanent(SinglePlayer(You), And([Other({{~Permanent}}), {{Permanents[0]}}])), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "Whenever you sacrifice this artifact or another {{Permanent}}, you may pay {{ManaCost}}. If you do, at the beginning of the next end step, create a token that's a copy of that artifact": "TriggerA(Or([WhenAPlayerSacrificesAPermanent(SinglePlayer(You), SinglePermanent({{~Permanent}})), WhenAPlayerSacrificesAPermanent(SinglePlayer(You), And([Other({{~Permanent}}), {{Permanent[0]}}]))]), ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([CreateTokens([TokenCopyOfPermanent(Trigger_ThatPermanent, NoTokenCopyEffects)])]))])]))",
