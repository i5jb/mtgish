    "Whenever {{EnchantedCreature}} becomes blocked, you may have it deal damage equal to {{GameNumber(ThatCreature)}} to target creature. If you do, the first creature assigns no combat damage this turn": "TriggerA(WhenACreatureBecomesBlocked(SinglePermanent(HostPermanent)), Targeted([TargetPermanent(IsCardtype(Creature))], ActionList([MayCost(HavePermanentDealDamage(Trigger_ThatCreature, {{GameNumber(ThatCreature=Trigger_ThatCreature)[0]}}, Permanent(Ref_TargetPermanent))), If(CostWasPaid, [CreatePermanentRuleEffectUntil(Trigger_ThatCreature, [AssignsNoCombatDamage], UntilEndOfTurn)])])))",
    "Whenever {{EnchantedCreature}} becomes blocked, {{TriggerActions(DefendingPlayer)}}": "TriggerA(WhenACreatureBecomesBlocked(SinglePermanent(HostPermanent)), {{TriggerActions(DefendingPlayer=Trigger_DefendingPlayer)[0]}})",
    "Whenever {{EnchantedCreature}} becomes blocked, {{TriggerActions(ThatPermanent)}}": "TriggerA(WhenACreatureBecomesBlocked(SinglePermanent(HostPermanent)), {{TriggerActions(ThatPermanent=Trigger_ThatCreature)[0]}})",
    "Whenever {{EnchantedCreature}} becomes the target of a spell or ability, {{TriggerActions(ThatSpellOrAbility,ThatCreature)}}": "TriggerA(WhenAPermanentBecomesTheTargetOfASpellOrAbility(SinglePermanent(HostPermanent), AnySpellOrAbility), {{TriggerActions(ThatSpellOrAbility=Trigger_ThatSpellOrAbility,ThatCreature=Trigger_ThatPermanent)[0]}})",
    "Whenever {{EnchantedCreature}} blocks or becomes blocked by {{a}} {{Creature}}, destroy the other creature at end of combat": "TriggerA(Or([WhenACreatureBecomesBlockedByACreature(SinglePermanent(HostPermanent), {{Creature[0]}}), WhenACreatureBlocksACreature(SinglePermanent(HostPermanent), {{Creature[0]}})]), ActionList([CreateFutureTrigger(AtTheNextEndOfCombat, ActionList([DestroyPermanent(Trigger_ThatOtherCreature)]))]))",
    "Whenever {{EnchantedCreature}} blocks or becomes blocked by {{a}} {{Creature}}, destroy the other creature at end of combat. At the beginning of the next end step, if that creature was destroyed this way, put {{a}} {{CounterType}} counter on the first creature": "TriggerA(Or([WhenACreatureBecomesBlockedByACreature(SinglePermanent(HostPermanent), {{Creature[0]}}), WhenACreatureBlocksACreature(SinglePermanent(HostPermanent), {{Creature[0]}})]), ActionList([CreateFutureTrigger(AtTheNextEndOfCombat, ActionList([MustCost(DestroyPermanent(Trigger_ThatOtherCreature)), If(CostWasPaid, [CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Trigger_ThatCreature)]))])]))]))",
    "Whenever {{EnchantedCreature}} blocks or becomes blocked by {{a}} {{Creature}}, the other creature gains {{Hasable}} until end of turn": "TriggerA(Or([WhenACreatureBecomesBlockedByACreature(SinglePermanent(HostPermanent), {{Creature[0]}}), WhenACreatureBlocksACreature(SinglePermanent(HostPermanent), {{Creature[0]}})]), ActionList([CreatePermanentLayerEffectUntil(Trigger_ThatOtherCreature, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Whenever {{EnchantedCreature}} blocks or becomes blocked, {{TriggerActions(ThatPermanent)}}": "TriggerA(WhenACreatureBlocks(SinglePermanent(HostPermanent)), {{TriggerActions(ThatPermanent=Trigger_ThatCreature)[0]}}), TriggerA(WhenACreatureBecomesBlocked(SinglePermanent(HostPermanent)), {{TriggerActions(ThatPermanent=Trigger_ThatCreature)[0]}})",
    "Whenever {{EnchantedCreature}} blocks, {{TriggerActions}}": "TriggerA(WhenACreatureBlocks(SinglePermanent(HostPermanent)), {{TriggerActions[0]}})",
    "Whenever {{EnchantedCreature}} deals combat damage to a player, {{TriggerActions(ThatMuch)}}": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(HostPermanent), AnyPlayer), {{TriggerActions(ThatMuch=Trigger_AmountOfDamageDealt)[0]}})",
    "Whenever {{EnchantedCreature}} deals combat damage to a player, {{TriggerActions(ThatPermanent)}}": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(HostPermanent), AnyPlayer), {{TriggerActions(ThatPermanent=Trigger_ThatCreature)[0]}})",
    "Whenever {{EnchantedCreature}} deals combat damage to a player, {{TriggerActions(ThatPlayer)}}": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(HostPermanent), AnyPlayer), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "Whenever {{EnchantedCreature}} deals combat damage to a player, {{TriggerActions}}": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(HostPermanent), AnyPlayer), {{TriggerActions[0]}})",
    "Whenever {{EnchantedCreature}} deals combat damage to an opponent, it deals that much damage to each other opponent": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(HostPermanent), Opponent), ActionList([PermanentDealsDamage(Trigger_ThatPermanent, Trigger_ThatMuch, EachPlayer(And([Other(Trigger_ThatPlayer), Opponent])))]))",
    "Whenever {{EnchantedCreature}} deals combat damage to an opponent, {{TriggerActions}}": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(HostPermanent), Opponent), {{TriggerActions[0]}})",
    "Whenever {{EnchantedCreature}} deals combat damage to defending player, {{TriggerActions(ThatPlayer)}}": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(HostPermanent), SinglePlayer(PlayerCreatureIsAttacking(HostPermanent))), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "Whenever {{EnchantedCreature}} deals damage to {{a}} {{Creature}}, {{TriggerActions(TheOtherCreature)}}": "TriggerA(WhenAPermanentDealsDamageToAPermanent(SinglePermanent(HostPermanent), {{Creature[0]}}), {{TriggerActions(TheOtherCreature=Trigger_ThatOtherPermanent)[0]}})",
    "Whenever {{EnchantedCreature}} is dealt damage, {{TriggerActions(ThatMuch)}}": "TriggerA(WhenAPermanentIsDealtDamage(SinglePermanent(HostPermanent)), {{TriggerActions(ThatMuch=Trigger_AmountOfDamageDealt)[0]}})",
    "Whenever {{EnchantedCreature}} is dealt damage, {{TriggerActions(ThatPermanent,ThatMuch)}}": "TriggerA(WhenAPermanentIsDealtDamage(SinglePermanent(HostPermanent)), {{TriggerActions(ThatPermanent=Trigger_ThatPermanent,ThatMuch=Trigger_AmountOfDamageDealt)[0]}})",
    "Whenever {{EnchantedPermanent}} becomes tapped, {{TriggerActions(ThatPermanent)}}": "TriggerA(WhenAPermanentBecomesTapped(SinglePermanent(HostPermanent)), {{TriggerActions(ThatPermanent=Trigger_ThatPermanent)[0]}})",
    "Whenever {{EnchantedPermanent}} becomes tapped, {{TriggerActions}}": "TriggerA(WhenAPermanentBecomesTapped(SinglePermanent(HostPermanent)), {{TriggerActions[0]}})",
    "Whenever {{EnchantedPermanent}} deals damage to a player, {{TriggerActions(ThatPlayer)}}": "TriggerA(WhenAPermanentDealsDamageToAPlayer(SinglePermanent(HostPermanent), AnyPlayer), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "Whenever {{EnchantedPermanent}} deals damage to an opponent, {{TriggerActions}}": "TriggerA(WhenAPermanentDealsDamageToAPlayer(SinglePermanent(HostPermanent), Opponent), {{TriggerActions[0]}})",
    "Whenever {{EnchantedPermanent}} deals damage, {{TriggerActions(ThatMuch)}}": "TriggerA(WhenAPermanentDealsDamage(SinglePermanent(HostPermanent)), {{TriggerActions(ThatMuch=Trigger_AmountOfDamageDealt)[0]}})",
    "Whenever {{EnchantedPermanent}} deals damage, {{TriggerActions(ThatPermanent,ThatMuch)}}": "TriggerA(WhenAPermanentDealsDamage(SinglePermanent(HostPermanent)), {{TriggerActions(ThatPermanent=Trigger_ThatPermanent,ThatMuch=Trigger_AmountOfDamageDealt)[0]}})",
    "Whenever {{EnchantedPermanent}} is tapped for mana, {{TriggerActions(ThatPermanent)}}": "TriggerA(WhenAPermanentIsTappedForMana(SinglePermanent(HostPermanent)), {{TriggerActions(ThatPermanent=Trigger_ThatPermanent)[0]}})",
    "Whenever {{a}} {{Creature[EnchantedCreature]}} dies, {{TriggerActions(ThatCreature)}}": "TriggerA(WhenACreatureOrPlaneswalkerDies({{Creature[EnchantedCreature][0]}}), {{TriggerActions(ThatCreature=Trigger_ThatPermanent)[0]}})",
    "Whenever {{a}} {{Creature}} deals damage to {{EnchantedPlaneswalker}}, {{TriggerActions(ThatCreature)}}": "TriggerA(WhenAPermanentDealsDamageToAPermanent({{Creature[0]}}, SinglePermanent(HostPermanent)), {{TriggerActions(ThatCreature=Trigger_ThatPermanent)[0]}})",
    "Whenever {{a}} {{Creature}} dies, {{TriggerActions[EnchantedPermanent]}}": "TriggerA(WhenACreatureOrPlaneswalkerDies({{Creature[0]}}), {{TriggerActions[EnchantedPermanent][0]}})",
