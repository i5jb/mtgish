    "Enchanted creature gets {{PTMod}} and blocks each combat if able": "PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}})]), PermanentRuleEffect(HostPermanent, [MustBlock])",
    "Enchanted creature gets {{PTMod}} and can block creatures with landwalk abilities as though they didn't have those abilities": "PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}})]), PermanentRuleEffect(HostPermanent, [CanBlockCreaturesWithLandwalkAbilitiesAsThoughTheyDidntHaveThem])",
    "Enchanted creature gets {{PTMod}} and can only attack alone": "PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}})]), PermanentRuleEffect(HostPermanent, [CanOnlyAttackAlone])",
