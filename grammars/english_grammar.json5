  "{{TriggerEffect(~PermanentOrCommandCard)}}": {
    "At the beginning of combat on your turn, if {{~PermanentOrCommandCard}} is in the command zone or on the battlefield, another target {{Creature}} gets {{PTMod}} until end of turn": "FromCommandZoneOrBattlefield(TriggerI(AtTheBeginningOfCombatDuringAPlayersTurn(SinglePlayer(You)), ThisCardIsInTheCommandZoneOrOnTheBattlefield, Targeted([TargetPermanent(And([Other({{~PermanentOrCommandCard}}), {{Creature[0]}}]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)]))))",
    "Whenever another {{Permanent}} enters, if {{~PermanentOrCommandCard}} is in the command zone or on the battlefield, {{TriggerActions(ThatCreature)}}": "FromCommandZoneOrBattlefield(TriggerI(WhenAPermanentEntersTheBattlefield(And([Other(ThisPermanent), {{Permanent[0]}}])), ThisCardIsInTheCommandZoneOrOnTheBattlefield, {{TriggerActions(ThatCreature=ThatEnteringPermanent)[0]}}))",
    "Whenever you attack with one or more {{Creatures}}, if {{~PermanentOrCommandCard}} is in the command zone or on the battlefield, {{TriggerActions}}": "FromCommandZoneOrBattlefield(TriggerI(WhenAPlayerAttacksWithAnyNumberOfCreatures(SinglePlayer(You), {{Creatures[0]}}), ThisCardIsInTheCommandZoneOrOnTheBattlefield, {{TriggerActions[0]}}))",
    "Whenever you cast another {{Spell}}, if {{~PermanentOrCommandCard}} is in the command zone or on the battlefield, {{TriggerActions}}": "FromCommandZoneOrBattlefield(TriggerI(WhenAPlayerCastsASpell(SinglePlayer(You), And([Other(ThisSpell), {{Spell[0]}}])), ThisCardIsInTheCommandZoneOrOnTheBattlefield, {{TriggerActions[0]}}))"
  },
