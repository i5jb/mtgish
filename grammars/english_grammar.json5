    "Search your library for {{a}} {{SpecificCard}}, reveal it, put it into your hand, then shuffle": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}}, reveal it, put it into your hand, then shuffle. You gain {{Digits}} life": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle]), GainLife({{Digits[0]}})])",
    "Search your library for {{a}} {{SpecificCard}}, reveal it, then shuffle and put that card on top": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, SetAsideFoundCards, Shuffle, PutSetAsideCardsOnTopOfLibrary])])",
    "Search your library for {{a}} {{SpecificCard}}, reveal that card, put it into your hand, then shuffle": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}}, {{a}} {{SpecificCard}}, and {{a}} {{SpecificCard}}. Reveal those cards, put them into your hand, then shuffle": "ActionList([SearchLibrary([FindCardsOfType([{{SpecificCard[0]}}, {{SpecificCard[1]}}, {{SpecificCard[2]}}]), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])",
    "Search your library for {{a}} {{Zombie}} permanent card, put that card onto the battlefield, then shuffle. That {{Zombie}} gains {{Hasable}} until end of turn. Exile it at the beginning of the next end step": "ActionList([SearchLibrary([FindACardOfType(And([IsCreatureType({{Zombie[0]}}), IsPermanent])), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle]), CreatePermanentLayerEffectUntil(ThePermanentPutOnTheBattlefieldThisWay, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([ExilePermanent(ThePermanentPutOnTheBattlefieldThisWay)]))])",
    "Seek {{a}} {{SpecificCard}}": "ActionList([SeekACard({{SpecificCard[0]}})])",
    "Seek {{a}} {{SpecificCard}} and put it onto the battlefield tapped": "ActionList([SeekACard({{SpecificCard[0]}}), PutCardFromHandOnBattlefield(TheCardSeekedThisWay, [EntersTapped])])",
    "Separate all {{Permanents}} target player controls into two piles. That player sacrifices all permanents in the pile of their choice": "Targeted([TargetPlayer(AnyPlayer)], ActionList([SeparatePermanentsIntoNumberPiles(And([{{Permanents[0]}}, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]), Integer(2)), PlayerActions(Ref_TargetPlayer, [ChooseAPermanentPile, SacrificeEachPermanent(InThePermanentPileChosenThisWay)])]))",
    "Shuffle all nonland cards from your graveyard into your library. You gain life equal to the number of cards shuffled into your library this way": "ActionList([ShuffleEachGraveyardCardIntoLibrary(And([IsNonCardtype(Land), InAPlayersGraveyard(SinglePlayer(You))])), GainLife(NumCardsShuffledIntoLibraryThisWay)])",
    "Shuffle any number of cards from your hand into your library, then draw that many cards": "ActionList([ShuffleAnyNumberOfCardsFromHandIntoLibrary, DrawNumberCards(NumCardsShuffledIntoLibraryThisWay)])",
    "Shuffle any number of target cards from your graveyard into your library": "Targeted([AnyNumberOfTargetGraveyardCards(AnyCardInAnyGraveyard)], ActionList([ShuffleEachGraveyardCardIntoLibrary(Ref_TargetGraveyardCards)]))",
    "Shuffle target {{Permanent}} into its owner's library": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([ShufflePermanentIntoLibrary(Ref_TargetPermanent)]))",
    "Shuffle up to {{Number}} target cards from your graveyard into your library": "Targeted([UptoNumberTargetGraveyardCards({{Number[0]}}, InAPlayersGraveyard(SinglePlayer(You)))], ActionList([ShuffleEachGraveyardCardIntoLibrary(Ref_TargetGraveyardCards)]))",
    "Shuffle your graveyard and hand into your library, then draw {{Number}} cards": "ActionList([ShuffleHandAndGraveyardIntoLibrary, DrawNumberCards({{Number[0]}})])",
    "Shuffle your graveyard into your library": "ActionList([ShuffleGraveyardIntoLibrary])",
    "Shuffle your library": "ActionList([Shuffle])",
    "Shuffle your library, then exile the top X cards, where X is {{Number}} plus {{GameNumber}}. Until end of turn, you may play lands and cast spells from among cards exiled this way without paying their mana costs": "ActionList([Shuffle, ExileTheTopNumberCardsOfLibrary(Plus({{Number[0]}}, {{GameNumber[0]}})), CreatePlayerEffectUntil(You, [MayPlayLandsFromAmongExiled(TheCardsExiledThisWay), MayCastSpellsFromAmongExiledWithoutPaying(AnySpell, TheCardsExiledThisWay)], UntilEndOfTurn)])",
    "Shuffle your library, then exile the top card. Until end of turn, you may play that card without paying its mana cost": "ActionList([Shuffle, ExileTopCardOfLibrary, CreatePlayerEffectUntil(You, [MayPlayExiledCardWithoutPaying(TheCardExiledThisWay)], UntilEndOfTurn)])",
    "Shuffle your library, then reveal the top card. Until end of turn, for as long as that card remains on top of your library, play with the top card of your library revealed and you may play that card without paying its mana cost": "ActionList([Shuffle, RevealTopCardOfLibrary, CreatePlayerEffectUntil(You, [PlaysWithTopOfLibraryRevealed, MayPlayTopCardOfLibraryWithoutPaying], Or([UntilEndOfTurn, UntilTopCardOfPlayersLibraryChanges(You)]))])",
    "Spells you cast from your graveyard this turn cost {{CostReduce}} less to cast": "ActionList([CreatePlayerEffectUntil(You, [DecreaseSpellCost(WasCastFromAPlayersGraveyard(SinglePlayer(You)), {{CostReduce[0]}})], UntilEndOfTurn)])",
    "Spells you cast this turn that are {{Black}} and/or {{Black}} cost {{CostReduceX}} less to cast, where X is {{GameNumber}}": "ActionList([CreatePlayerEffectUntil(You, [DecreaseSpellCostX(Or([IsColor({{Black[0]}}), IsColor({{Black[1]}})]), {{CostReduceX[0]}}, {{GameNumber[0]}})], UntilEndOfTurn)])",
    "Support {{Digits}}": "Targeted([UptoNumberTargetPermanents({{Digits[0]}}, IsCardtype(Creature))], ActionList([Support(Ref_TargetPermanents)]))",
    "Surveil {{Digits}}": "ActionList([Surveil({{Digits[0]}})])",
    "Surveil {{Digits}}, then draw a card": "ActionList([Surveil({{Digits[0]}}), DrawACard])",
    "Surveil {{Digits}}, then draw {{Number}} cards": "ActionList([Surveil({{Digits[0]}}), DrawNumberCards({{Number[0]}})])",
    "Surveil {{Digits}}, then draw {{Number}} cards. You gain {{Digits}} life": "ActionList([Surveil({{Digits[0]}}), DrawNumberCards({{Number[0]}}), GainLife({{Digits[1]}})])",
    "Surveil {{Digits}}, then exile a card from a graveyard": "ActionList([Surveil({{Digits[0]}}), Exile([AGraveyardCard(AnyCardInAnyGraveyard)])])",
    "Surveil {{Digits}}. If you put a noncreature, nonland card into your graveyard this way, put that card into your hand": "ActionList([Surveil({{Digits[0]}}), If(ACardWasSurveiledIntoGraveyardThisWay(Or([IsNonCardtype(Creature), IsNonCardtype(Land)])), [PutEachGraveyardCardIntoHand(TheCardsSurveiledThisWay)])])",
    "Surveil {{Digits}}. Then draw a card for each {{Eachable}}": "ActionList([Surveil({{Digits[0]}}), DrawNumberCards({{Eachable[0]}})])",
    "Switch each {{Permanent}}'s power and toughness until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanent[0]}}, [SwitchPT], UntilEndOfTurn)])",
    "Switch target {{Creature}}'s power and toughness until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [SwitchPT], UntilEndOfTurn)]))",
    "Take an extra turn after this one": "ActionList([TakeAnExtraTurn])",
    "Take {{Number}} extra turns after this one": "ActionList([TakeANumberOfExtraTurns({{Number[0]}})])",
    "Tap all untapped {{Zombie}} creatures you control. Each {{Zombie}} tapped this way deals damage equal to its power to target {{Creature}}. That creature deals damage equal to its power divided as its controller chooses among any number of those {{Zombies}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([TapEachPermanent(And([IsUntapped, IsCreatureType({{Zombie[0]}}), ControlledByAPlayer(SinglePlayer(You))])), EachPermanentDealsDamage(ThePermanentsTappedThisWay, PowerOfPermanent(EachablePermanent), Permanent(Ref_TargetPermanent)), PermanentDealsDamageDividedAsPlayerChooses(Ref_TargetPermanent, PowerOfPermanent(Ref_TargetPermanent), EachPermanent(ThePermanentsTappedThisWay), ControllerOfPermanent(Ref_TargetPermanent))]))",
    "Tap all {{Permanents}}": "ActionList([TapEachPermanent({{Permanents[0]}})])",
    "Tap all {{Permanents}} target opponent controls. That player skips their next untap step": "Targeted([TargetPlayer(Opponent)], ActionList([TapEachPermanent(And([{{Permanents[0]}}, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))])), PlayerAction(Ref_TargetPlayer, SkipNextUntapStep)]))",
    "Tap all {{Permanents}} target player controls": "Targeted([TargetPlayer(AnyPlayer)], ActionList([TapEachPermanent(And([{{Permanents[0]}}, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]))]))",
    "Tap all {{Permanents}}. You take an extra turn after this one": "ActionList([TapEachPermanent({{Permanents[0]}}), TakeAnExtraTurn])",
    "Tap any number of untapped creatures you control. When you do, shuffle target nonland permanent an opponent controls with mana value X or less into its owner's library, where X is the number of creatures tapped this way": "ActionList([MayCost(TapAnyNumberOfPermanents(And([IsUntapped, IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPermanent(And([IsNonCardtype(Land), IsPermanent, ControlledByAPlayer(Opponent), ManaValueIs(LessThanOrEqualTo(TheNumberOfPermanentsTappedThisWay))]))], ActionList([ShufflePermanentIntoLibrary(Ref_TargetPermanent)])))])])",
    "Tap target {{Creature}} and put {{a}} {{CounterType}} counter on it. Until end of turn, that creature gains \"{{QuotedAbility}}\"": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{QuotedAbility[0]}}])], UntilEndOfTurn)]))",
    "Tap target {{Creature}} and target {{Creature}} of an opponent's choice they control. Those creatures fight each other": "Targeted([TargetPermanent({{Creature[0]}}), TargetPermanentOfAPlayersChoiceTheyControl({{Creature[1]}}, Opponent)], ActionList([TapEachPermanent(Or([SinglePermanent(Ref_TargetPermanent1), SinglePermanent(Ref_TargetPermanent2)])), Fight(Ref_TargetPermanent1, Ref_TargetPermanent2)]))",
    "Tap target {{Creature}}. Gain control of that creature instead if {{Condition}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([IfElse({{Condition[0]}}, [GainControlOfPermanent(Ref_TargetPermanent)], [TapPermanent(Ref_TargetPermanent)])]))",
    "Tap target {{Creature}}. If {{Condition(ThatPermanent)}}, exile it": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), If({{Condition(ThatPermanent=Ref_TargetPermanent)[0]}}, [ExilePermanent(Ref_TargetPermanent)])]))",
    "Tap target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent)]))",
    "Tap target {{Permanent}} and put {{a}} {{CounterType}} counter on it": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent)]))",
    "Tap target {{Permanent}} unless its controller pays {{Digits}} life": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PlayerMayCost(ControllerOfTargetPermanent, PayLife({{Digits[0]}})), Unless(CostWasPaid, [TapPermanent(Ref_TargetPermanent)])]))",
    "Tap target {{Permanent}} unless its controller pays {{ManaCost}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PlayerMayCost(ControllerOfTargetPermanent, PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [TapPermanent(Ref_TargetPermanent)])]))",
    "Tap target {{Permanent}}, then untap another target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}}), TargetPermanent(And([Other(Ref_TargetPermanent1), {{Permanent[0]}}]))], ActionList([TapPermanent(Ref_TargetPermanent1), UntapPermanent(Ref_TargetPermanent2)]))",
    "Tap target {{Permanent}}. Investigate": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), Investigate]))",
    "Tap target {{Permanent}}. It doesn't untap during its controller's next untap step": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), PermanentDoesntUntapDuringControllersNextUntap(Ref_TargetPermanent)]))",
    "Tap target {{Permanent}}. Its activated abilities can't be activated this turn": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [AbilitiesCantBeActivated], UntilEndOfTurn)]))",
    "Tap target {{Permanent}}. Put {{Number}} {{CounterType}} counters on it": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[0]}}, Ref_TargetPermanent)]))",
    "Tap target {{Permanent}}. Put {{a}} {{CounterType}} counter on it": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent)]))",
    "Tap up to one target {{Permanent}}. It doesn't untap during its controller's next untap step": "Targeted([UptoOneTargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), PermanentDoesntUntapDuringControllersNextUntap(Ref_TargetPermanent)]))",
    "Tap up to {{Number}} target {{Creatures}}. Those creatures don't untap during their controller's next untap step": "Targeted([UptoNumberTargetPermanents({{Number[0]}}, {{Creatures[0]}})], ActionList([TapEachPermanent(Ref_TargetPermanents), EachPermanentDoesntUntapDuringControllersNextUntap(Ref_TargetPermanents)]))",
    "Tap up to {{Number}} target {{Permanents}}": "Targeted([UptoNumberTargetPermanents({{Number[0]}}, {{Permanents[0]}})], ActionList([TapEachPermanent(Ref_TargetPermanents)]))",
    "Tap up to {{Number}} target {{Permanents}}. They don't untap during their controller's next untap step": "Targeted([UptoNumberTargetPermanents({{Number[0]}}, {{Permanents[0]}})], ActionList([TapEachPermanent(Ref_TargetPermanents), EachPermanentDoesntUntapDuringControllersNextUntap(Ref_TargetPermanents)]))",
    "Tap {{Number}} target {{Permanents}}": "Targeted([NumberTargetPermanents({{Number[0]}}, {{Permanents[0]}})], ActionList([TapEachPermanent(Ref_TargetPermanents)]))",
    "Target creature becomes a Treasure artifact with \"{{QuotedAbility}}\" and loses all other card types and abilities": "Targeted([TargetPermanent(IsCardtype(Creature))], ActionList([CreatePermanentLayerEffect(Ref_TargetPermanent, [SetArtifactType(Treasure), SetCardtype(Artifact), AddAbilityAndLoseAllOtherAbilities([{{QuotedAbility[0]}}])])]))",
    "Target creature loses banding and all \"bands with other\" abilities until end of turn": "Targeted([TargetPermanent(IsCardtype(Creature))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [LosesAbility(Banding), LosesAbility(AnyBandsWithOthers)], UntilEndOfTurn)]))",
    "Target opponent blights {{Digits}}": "Targeted([TargetPlayer(Opponent)], ActionList([PlayerAction(Ref_TargetPlayer, Blight({{Digits[0]}}))]))",
    "Target opponent chooses any number of creatures they control. During that player's next turn, the chosen creatures attack if able, and other creatures can't attack. At the beginning of that turn's end step, destroy each of the chosen creatures that didn't attack that turn": "Targeted([TargetPlayer(Opponent)], ActionList([PlayerAction(Ref_TargetPlayer, ChooseAnyNumberOfPermanents(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(ActionPlayer))]))), CreatePlayerEffectUntil(Ref_TargetPlayer, [MustAttackWithEachCreature(ThePermanentsChosenThisWay), CantAttackWithCreatures(ExceptFor(ThePermanentsChosenThisWay))], DuringPlayersNextTurn(Ref_TargetPlayer)), CreateFutureTrigger(AtTheBeginningOfPlayersNextEndStep(Ref_TargetPlayer), ActionList([DestroyEachPermanent(And([ThePermanentsChosenThisWay, DidntAttackThisTurn]))]))]))",
    "Target opponent chooses one of the top two cards of your graveyard. Exile that card and put the other one into your hand": "Targeted([TargetPlayer(Opponent)], ActionList([PlayerAction(Ref_TargetPlayer, ChooseACardFromAmongTheTopNumberCardsInPlayersGraveyard(AnyCard, Integer(2), You)), ExileGraveyardCard(TheChosenGraveyardCard), ReturnGraveyardCardsToHand(TheGraveyardCardsNotChosenThisWay)]))",
    "Target opponent chooses {{a}} {{Permanent}} they control and returns it to its owner's hand. Then they shuffle each {{Permanent}} they control into its owner's library": "Targeted([TargetPlayer(Opponent)], ActionList([PlayerAction(Ref_TargetPlayer, PutAPermanentIntoItsOwnersHand(And([{{Permanent[0]}}, ControlledByPlayer(PlayerAction_ThatPlayer)]))), PlayerAction(Ref_TargetPlayer, ShuffleEachPermanentIntoLibrary(And([{{Permanent[1]}}, ControlledByPlayer(PlayerAction_ThatPlayer)])))]))",
    "Target opponent creates X Treasure tokens, where X is {{GameNumber}}": "Targeted([TargetPlayer(Opponent)], ActionList([PlayerAction(Ref_TargetPlayer, CreateTokens([NumberTokens({{GameNumber[0]}}, TreasureToken)]))]))",
