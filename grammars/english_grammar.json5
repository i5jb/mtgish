    "Draw {{Number}} cards. Proliferate": "ActionList([DrawNumberCards({{Number[0]}}), Proliferate])",
    "Draw {{Number}} cards. Target player mills {{Number}} cards": "Targeted([TargetPlayer(AnyPlayer)], ActionList([DrawNumberCards({{Number[0]}}), PlayerAction(Ref_TargetPlayer, MillNumberCards({{Number[0]}}))]))",
    "Draw {{Number}} cards. Then discard a card at random unless you pay {{Energy}}": "ActionList([DrawNumberCards({{Number[0]}}), MayCost(PayEnergy(Integer({{Energy[0]}}))), Unless(CostWasPaid, [DiscardACardAtRandom])])",
    "Draw {{Number}} cards. Then discard a card unless you return {{a}} {{Permanent}} to its owner's hand": "ActionList([DrawNumberCards({{Number[0]}}), MayCost(PutAPermanentIntoItsOwnersHand({{Permanent[0]}})), Unless(CostWasPaid, [DiscardACard])])",
    "Draw {{Number}} cards. Then discard a card unless you waterbend {{ManaCost}}": "ActionList([DrawNumberCards({{Number[0]}}), MayCost(Waterbend({{ManaCost[0]}})), Unless(CostWasPaid, [DiscardACard])])",
    "Draw {{Number}} cards. Then discard a card unless {{Condition}}": "ActionList([DrawNumberCards({{Number[0]}}), Unless({{Condition[0]}}, [DiscardACard])])",
    "Draw {{Number}} cards. Then discard {{Number}} cards unless you discard {{a}} {{SpecificCard}}": "ActionList([DrawNumberCards({{Number[0]}}), MayCost(DiscardACardOfType({{SpecificCard[0]}})), Unless(CostWasPaid, [DiscardNumberCards({{Number[1]}})])])",
    "Draw {{Number}} cards. Then if any player pays {{ManaCost}}, discard {{Number}} cards": "ActionList([DrawNumberCards({{Number[0]}}), AnyPlayerMayCost(AnyPlayer, PayMana({{ManaCost[0]}})), If(CostWasPaid, [DiscardNumberCards({{Number[1]}})])])",
    "Draw {{Number}} cards. Then target opponent faces a villainous choice - They discard {{Number}} cards, or you may cast a spell from your hand without paying its mana cost": "Targeted([TargetPlayer(Opponent)], ActionList([DrawNumberCards({{Number[0]}}), PlayerAction(Ref_TargetPlayer, FaceAVillianousChoice([[PlayerAction(Ref_TargetPlayer, DiscardNumberCards({{Number[1]}}))], [MayAction(CastASpellFromHandWithoutPaying(AnySpell))]]))]))",
    "Draw {{Number}} cards. Then you may exile {{a}} {{SpecificCard}} from your hand. If you do, search your hand and library for any number of cards with the same name, exile them, then shuffle. Seek {{a}} {{SpecificCard}} for each card exiled from your hand this way": "ActionList([DrawNumberCards({{Number[0]}}), MayCost(ExileACardOfTypeFromHand({{SpecificCard[0]}})), If(CostWasPaid, [SearchHandAndLibrary([FindAnyNumberOfCardsOfType(SharesANameWithExiled(TheCardExiledThisWay)), ExileFoundCards, Shuffle]), SeekNumberCards(NumHandCardsExiledThisWay, {{SpecificCard[0]}})])])",
    "Draw {{Number}} cards. You lose half your life, rounded up": "ActionList([DrawNumberCards({{Number[0]}}), LoseLife(HalfRoundedUp(LifeTotalOfPlayer(You)))])",
    "Draw {{Number}} cards. You may play an additional land this turn": "ActionList([DrawNumberCards({{Number[0]}}), CreatePlayerEffectUntil(You, [MayPlayAnAdditionalLand], UntilEndOfTurn)])",
    "Draw {{Number}} cards. You may put {{a}} {{SpecificCard}} from your hand onto the battlefield": "ActionList([DrawNumberCards({{Number[0]}}), MayAction(PutACardFromHandOnBattlefield({{SpecificCard[0]}}, [EntersNormally]))])",
    "Draw {{Number}} cards. You may put {{a}} {{SpecificCard}} from your hand onto the battlefield tapped": "ActionList([DrawNumberCards({{Number[0]}}), MayAction(PutACardFromHandOnBattlefield({{SpecificCard[0]}}, [EntersTapped]))])",
    "Draw {{Number}} cards. You skip your next turn": "ActionList([DrawNumberCards({{Number[0]}}), SkipNextTurn])",
    "Draw {{Number}} cards. {{Creatures}} get {{PTMod}} until end of turn": "ActionList([DrawNumberCards({{Number[0]}}), CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])",
    "During target player's next turn, {{Creatures}} that player controls attack you if able": "Targeted([TargetPlayer(AnyPlayer)], ActionList([CreateEachPermanentRuleEffectUntil(And([{{Creatures[0]}}, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]), [MustAttackPlayer(You)], DuringPlayersNextTurn(Ref_TargetPlayer))]))",
    "Each attacking creature gets {{PTMod}} until end of turn for each {{Permanent}} defending player controls": "ActionList([CreateEachPermanentLayerEffectUntil(And([IsAttacking, IsCardtype(Creature)]), [AdjustPTForEach({{PTMod[0]}}, TheNumberOfPermanentsOnTheBattlefield(And([{{Permanent[0]}}, ControlledByPlayer(PlayerCreatureIsAttacking(EachablePermanent))])))], UntilEndOfTurn)])",
    "Each creature card in your graveyard perpetually gets {{PTModX}}, where X is {{GameNumber}}. Then return a creature card from your graveyard to the battlefield": "ActionList([CreatePerpetualCardsInPlayersGraveyardEffect(IsCardtype(Creature), You, [AdjustPTX({{PTModX[0]}}, {{GameNumber[0]}})]), PutACardFromPlayersGraveyardOnBattlefield(IsCardtype(Creature), You, [EntersNormally])])",
    "Each enchantment deals {{Digits}} damage to its controller, then each Aura attached to a creature deals {{Digits}} damage to the creature it's attached to": "ActionList([EachPermanentDealsDamage(IsCardtype(Enchantment), {{Digits[0]}}, Player(ControllerOfPermanent(ActionPermanent))), EachPermanentDealsDamage(And([IsEnchantmentType(Aura), AttachedToAPermanent(IsCardtype(Creature))]), {{Digits[1]}}, Permanent(HostPermanentOf(ActionPermanent)))])",
    "Each opponent can't cast {{PotentialSpells}} during that player's next turn": "ActionList([CreateEachPlayerEffectUntil(Opponent, [CantCastSpells({{PotentialSpells[0]}})], DuringPlayersNextTurn(EachablePlayer))])",
    "Each opponent chooses a creature they control. Tap and goad the chosen creatures": "ActionList([EachPlayerAction(Opponent, ChooseAPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(EachablePlayer))]))), TapEachPermanent(TheChosenPermanents), GoadEachCreature(TheChosenPermanents)])",
    "Each opponent chooses fame or fortune. For each player who chose fame, gain control of a creature that player controls until end of turn. Untap those creatures and they gain {{Hasable}} until end of turn. For each player who chose fortune, you draw a card and create a Treasure token": "ActionList([EachPlayerAction(Opponent, ChooseWord([\"Fame\", \"Fortune\"])), GainControlOfAPermanentControlledByEachPlayer(IsCardtype(Creature), ChoseWord(\"Fame\")), UntapEachPermanent(ThePermanentsGainedControlOfThisWay), CreateEachPermanentLayerEffectUntil(ThePermanentsGainedControlOfThisWay, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), DrawNumberCards(NumPlayers(ChoseWord(\"Fortune\"))), CreateTokens([NumberTokens(NumPlayers(ChoseWord(\"Fortune\")), TreasureToken)])])",
    "Each opponent chooses {{a}} {{Creature}} they control. You gain control of those creatures": "ActionList([EachPlayerAction(Opponent, ChooseAPermanent(And([{{Creature[0]}}, ControlledByAPlayer(SinglePlayer(ActionPlayer))]))), GainControlOfEachPermanent(ThePermanentsChosenThisWay)])",
    "Each opponent chooses {{a}} {{SpecificCard}} in their graveyard. Put those cards onto the battlefield under your control": "ActionList([EachPlayerAction(Opponent, ChooseACardInPlayersGraveyard({{SpecificCard[0]}}, ActionPlayer)), ReturnEachGraveyardCardToBattlefield(TheChosenGraveyardCards, [EntersUnderPlayersControl(You)])])",
    "Each opponent discards a card": "ActionList([EachPlayerAction(Opponent, DiscardACard)])",
    "Each opponent discards a card. You create {{a}} {{PT}} {{CreatureToken}} with \"{{TokenQuotedAbility}}\"": "ActionList([EachPlayerAction(Opponent, DiscardACard), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{TokenQuotedAbility[0]}}])])])",
    "Each opponent discards {{Number}} cards": "ActionList([EachPlayerAction(Opponent, DiscardNumberCards({{Number[0]}}))])",
    "Each opponent discards {{Number}} cards. If {{Condition}}, each opponent loses {{Digits}} life and you gain {{Digits}} life": "ActionList([EachPlayerAction(Opponent, DiscardNumberCards({{Number[0]}})), If({{Condition[0]}}, [EachPlayerAction(Opponent, LoseLife({{Digits[0]}})), GainLife({{Digits[1]}})])])",
    "Each opponent draws a card, then you draw a card for each opponent who drew a card this way": "ActionList([EachPlayerAction(Opponent, DrawACard), DrawNumberCards(NumberOfCardsDrawnThisWay)])",
    "Each opponent exiles cards from the top of their library until that player has exiled cards with total mana value {{Digits}} or greater": "ActionList([EachPlayerAction(Opponent, ExileTopCardsOfLibraryUntilGroupCardsAreExiled(TotalManaValueIs(GreaterThanOrEqualTo({{Digits[0]}}))))])",
    "Each opponent exiles cards from the top of their library until they exile a nonland card. You may cast any number of spells from among those nonland cards without paying their mana costs": "ActionList([EachPlayerAction(Opponent, ExileTopCardsOfLibraryUntilASingleCardOfTypeIsExiled(IsNonCardtype(Land))), CastAnyNumberOfExiledCardsWithoutPaying(And([IsNonCardtype(Land), WasExiledThisWay]))])",
    "Each opponent exiles cards from the top of their library until they have exiled cards with total mana value {{Digits}} or greater this way. Until end of turn, you may cast cards exiled this way without paying their mana costs": "ActionList([EachPlayerAction(Opponent, ExileTopCardsOfLibraryUntilGroupCardsAreExiled(TotalManaValueIs(GreaterThanOrEqualTo({{Digits[0]}})))), CreatePlayerEffectUntil(You, [MayCastSpellsFromAmongExiledWithoutPaying(AnySpell, TheCardsExiledThisWay)], UntilEndOfTurn)])",
    "Each opponent exiles the top card of their library. You may cast spells from among those cards this turn. If you cast a spell this way, pay life equal to that spell's mana value rather than pay its mana cost": "ActionList([EachPlayerAction(Opponent, ExileTopCardOfLibrary), CreatePlayerEffectUntil(You, [MayCastSpellsFromAmongExiledForAlternateCastingCost(AnySpell, TheCardsExiledThisWay, PayLifeEqualToItsManaValue)], UntilEndOfTurn)])",
    "Each opponent gets a poison counter.\nDraw a card": "ActionList([EachPlayerAction(Opponent, GetAPoisonCounter), DrawACard])",
    "Each opponent gets a poison counter. Then each {{Creature}} gets {{PTMod}} until end of turn for each {{Eachable(ThatPermanent)}}": "ActionList([EachPlayerAction(Opponent, GetAPoisonCounter), CreateEachPermanentLayerEffectUntil({{Creature[0]}}, [AdjustPTForEach({{PTMod[0]}}, {{Eachable(ThatPermanent=EachablePermanent)[0]}})], UntilEndOfTurn)])",
    "Each opponent loses X life, where X is {{GameNumber}}": "ActionList([EachPlayerAction(Opponent, LoseLife({{GameNumber[0]}}))])",
    "Each opponent loses all counters": "ActionList([EachPlayerAction(Opponent, LoseAllCounters)])",
    "Each opponent loses {{Digits}} life": "ActionList([EachPlayerAction(Opponent, LoseLife({{Digits[0]}}))])",
    "Each opponent loses {{Digits}} life and you gain {{Digits}} life": "ActionList([EachPlayerAction(Opponent, LoseLife({{Digits[0]}})), GainLife({{Digits[1]}})])",
    "Each opponent loses {{Digits}} life for each {{Eachable}}": "ActionList([EachPlayerAction(Opponent, LoseLifeForEach({{Digits[0]}}, {{Eachable[0]}}))])",
    "Each opponent loses {{Digits}} life. You gain life equal to the life lost this way": "ActionList([EachPlayerAction(Opponent, LoseLife({{Digits[0]}})), GainLife(LifeLostThisWay)])",
    "Each opponent mills {{Number}} cards": "ActionList([EachPlayerAction(Opponent, MillNumberCards({{Number[0]}}))])",
    "Each opponent mills {{Number}} cards, then you may cast a spell from each opponent's graveyard without paying its mana cost. If a spell cast this way would be put into a graveyard, exile it instead": "ActionList([EachPlayerAction(Opponent, MillNumberCards({{Number[0]}})), MayCastASpellFromEachPlayersGraveyardWithoutPayingIntoExile(AnySpell, Opponent)])",
    "Each opponent returns a nonland permanent they control with the greatest mana value among permanents they control to its owner's hand, then discards a card": "ActionList([EachPlayerActions(Opponent, [PutAPermanentIntoItsOwnersHand(APermanentWithTheHighestManaValue(And([IsNonCardtype(Land), ControlledByAPlayer(SinglePlayer(ActionPlayer))]))), DiscardACard])])",
    "Each opponent sacrifices a creature of their choice with {{CheckHasable}}": "ActionList([EachPlayerAction(Opponent, SacrificeAPermanent(And([IsCardtype(Creature), HasAbility({{CheckHasable[0]}})])))])",
    "Each opponent sacrifices a creature or planeswalker with the greatest mana value among creatures and planeswalkers they control": "ActionList([EachPlayerAction(Opponent, SacrificeAPermanent(And([IsCardtype(Creature), PowerIs(EqualTo(TheGreatestManaValueAmongPermanents(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(ActionPlayer))]))))])))])",
    "Each opponent sacrifices a creature they control with the greatest power": "ActionList([EachPlayerAction(Opponent, SacrificeAPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(EachablePlayer)), PowerIs(EqualTo(TheGreatestPowerAmongPermanents(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(EachablePlayer))]))))])))])",
    "Each opponent sacrifices a creature with the greatest power among creatures they control": "ActionList([EachPlayerAction(Opponent, SacrificeAPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(EachablePlayer)), PowerIs(EqualTo(TheGreatestPowerAmongPermanents(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(EachablePlayer))]))))])))])",
    "Each opponent sacrifices a nontoken creature. For each creature sacrificed this way, conjure a duplicate of it into your graveyard": "ActionList([EachPlayerAction(Opponent, SacrificeAPermanent(And([IsNonToken, IsCardtype(Creature)]))), ConjureADuplicateOfEachPermanentIntoGraveyard(ThePermanentsSacrificedThisWay)])",
    "Each opponent sacrifices an artifact of their choice. For each artifact sacrificed this way, you create a Treasure token": "ActionList([EachPlayerAction(Opponent, SacrificeAPermanent(IsCardtype(Artifact))), CreateTokens([NumberTokens(TheNumberOfPermanentsOfTypeSacrificedThisWay(IsCardtype(Artifact)), TreasureToken)])])",
    "Each opponent sacrifices {{a}} {{Permanent}} and {{a}} {{Permanent}} of their choice": "ActionList([EachPlayerAction(Opponent, SacrificePermanents([{{Permanent[0]}}, {{Permanent[1]}}]))])",
    "Each opponent sacrifices {{a}} {{Permanent}} of their choice": "ActionList([EachPlayerAction(Opponent, SacrificeAPermanent({{Permanent[0]}}))])",
    "Each opponent sacrifices {{a}} {{Permanent}} of their choice and gets a poison counter": "ActionList([EachPlayerAction(Opponent, SacrificeAPermanent({{Permanent[0]}})), EachPlayerAction(Opponent, GetAPoisonCounter)])",
    "Each opponent sacrifices {{a}} {{Permanent}} of their choice, then discards a card. You return {{a}} {{SpecificCard}} from your graveyard to your hand, then draw a card": "ActionList([EachPlayerActions(Opponent, [SacrificeAPermanent({{Permanent[0]}}), DiscardACard]), PutACardFromGraveyardIntoHand({{SpecificCard[0]}}), DrawACard])",
    "Each opponent sacrifices {{a}} {{Permanent}} of their choice.\nConjure a card named {{NamedCard}} into your graveyard": "ActionList([EachPlayerAction(Opponent, SacrificeAPermanent({{Permanent[0]}})), ConjureACardIntoGraveyard({{NamedCard[0]}})])",
    "Each opponent sacrifices {{a}} {{Permanent}} of their choice. Create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}} and \"{{TokenQuotedAbility}}\"": "ActionList([EachPlayerAction(Opponent, SacrificeAPermanent({{Permanent[0]}})), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}, {{TokenQuotedAbility[0]}}])])])",
    "Each opponent sacrifices {{a}} {{Permanent}} of their choice. Each opponent who can't loses half their life, rounded up": "ActionList([EachPlayerAction(Opponent, SacrificeAPermanent({{Permanent[0]}})), EachPlayerAction(DidntSacrificeAPermanentThisWay(AnyPermanent), LoseLife(HalfRoundedUp(LifeTotalOfPlayer(ActionPlayer))))])",
    "Each opponent sacrifices {{a}} {{Permanent}} of their choice. If {{Condition}}, each opponent also discards a card": "ActionList([EachPlayerAction(Opponent, SacrificeAPermanent({{Permanent[0]}})), If({{Condition[0]}}, [EachPlayerAction(Opponent, DiscardACard)])])",
    "Each opponent separates the creatures they control into two piles. For each opponent, you choose one of their piles. Each opponent sacrifices the creatures in their chosen pile": "ActionList([EachPlayerAction(Opponent, SeparatePermanentsIntoNumberPiles(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(ActionPlayer))]), Integer(2))), ChooseAPileCreatedByEachPlayer(Opponent), EachPlayerAction(Opponent, SacrificeEachPermanent(InTheChosenPiles))])",
    "Each other creature becomes a copy of target {{Creature}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(And([Other(Ref_TargetPermanent), IsCardtype(Creature)]), [IsACopyOfPermanent(Ref_TargetPermanent, NoCopyEffects)], UntilEndOfTurn)]))",
    "Each other player discards a card. You draw a card for each card discarded this way": "ActionList([EachPlayerAction(Other(You), DiscardACard), DrawNumberCards(NumCardsDiscardedThisWay)])",
    "Each other player sacrifices {{a}} {{Permanent}}. You create {{a}} {{PT}} {{CreatureToken}} for each {{Permanent}} sacrificed this way": "ActionList([EachPlayerAction(Other(You), SacrificeAPermanent({{Permanent[0]}})), CreateTokens([NumberTokens(TheNumberOfPermanentsOfTypeSacrificedThisWay({{Permanent[1]}}), TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, []))])])",
    "Each player antes the top card of their library": "ActionList([EachPlayerAction(AnyPlayer, AnteTopCardOfLibrary)])",
    "Each player chooses a card in their hand. Then each player reveals their chosen card. The owner of each creature card revealed this way with the lowest mana value puts it onto the battlefield": "ActionList([EachPlayerAction(AnyPlayer, RevealACardFromHand), EachPlayerAction(OwnerOfACardWithTheLowestManaValueRevealedThisWay(IsCardtype(Creature)), PutCardFromHandOnBattlefield(TheCardRevealedFromHandThisWay, [EntersNormally]))])",
    "Each player chooses a color. Then exile each permanent unless it's colorless or it's only the color its controller chose": "ActionList([EachPlayerAction(AnyPlayer, ChooseAColor(AnyColor)), ExileEachPermanent(And([IsPermanent, Not(Or([IsColorless, And([IsMonocolored, IsColor(TheColorChosenByItsController)])]))]))])",
    "Each player chooses a creature type. Destroy all {{Creatures}} that aren't of a type chosen this way. They can't be regenerated": "ActionList([EachPlayerAction(AnyPlayer, ChooseACreatureType), DestroyEachPermanentNoRegen(And([{{Creatures[0]}}, IsNonCreatureTypeVariable(TheChosenCreatureTypes)]))])",
    "Each player chooses a creature type. Each player returns all {{SpecificCards}} of a type chosen this way from their graveyard to the battlefield": "ActionList([EachPlayerAction(AnyPlayer, ChooseACreatureType), EachPlayerAction(AnyPlayer, ReturnEachCardFromPlayersGraveyardToBattlefield(And([{{SpecificCards[0]}}, IsCreatureTypeVariable(TheChosenCreatureTypes)]), ActionPlayer, [EntersNormally]))])",
    "Each player chooses a land they control of each basic land type. Return those lands to their owners' hands": "ActionList([EachPlayerAction(AnyPlayer, ChooseAPermanentOfEachBasicLandTypeAvailable(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(ActionPlayer))]))), PutEachPermanentIntoItsOwnersHand(ThePermanentsChosenThisWay)])",
    "Each player chooses a nonland permanent they control. Return all nonland permanents not chosen this way to their owners' hands. Then you draw a card for each {{Eachable}}": "ActionList([EachPlayerAction(AnyPlayer, ChooseAPermanent(And([IsNonCardtype(Land), ControlledByAPlayer(SinglePlayer(ActionPlayer))]))), PutEachPermanentIntoItsOwnersHand(And([IsNonCardtype(Land), ExceptFor(ThePermanentsChosenThisWay)])), DrawNumberCards({{Eachable[0]}})])",
    "Each player chooses a number of lands they control equal to the number of lands controlled by the player who controls the fewest, then sacrifices the rest. Players discard cards and sacrifice creatures the same way": "ActionList([EachPlayerAction(AnyPlayer, SacrificeAllPermanentsExceptForNum(IsCardtype(Land), TheLowestNumberOfPermanentsControlledAmongPlayers(IsCardtype(Land), AnyPlayer))), EachPlayerAction(AnyPlayer, DiscardAllButNumberCards(TheLowestNumberOfCardsInHandAmongPlayers(AnyPlayer))), EachPlayerAction(AnyPlayer, SacrificeAllPermanentsExceptForNum(IsCardtype(Creature), TheLowestNumberOfPermanentsControlledAmongPlayers(IsCardtype(Creature), AnyPlayer)))])",
    "Each player chooses a number of lands they control equal to the number of lands controlled by the player who controls the fewest, then sacrifices the rest. Players sacrifice creatures and discard cards the same way": "ActionList([EachPlayerAction(AnyPlayer, SacrificeAllPermanentsExceptForNum(IsCardtype(Land), TheLowestNumberOfPermanentsControlledAmongPlayers(IsCardtype(Land), AnyPlayer))), EachPlayerAction(AnyPlayer, SacrificeAllPermanentsExceptForNum(IsCardtype(Creature), TheLowestNumberOfPermanentsControlledAmongPlayers(IsCardtype(Creature), AnyPlayer))), EachPlayerAction(AnyPlayer, DiscardAllButNumberCards(TheLowestNumberOfCardsInHandAmongPlayers(AnyPlayer)))])",
    "Each player chooses a number of permanents they control equal to the number of permanents controlled by the player who controls the fewest, then sacrifices the rest. Each player discards cards the same way": "ActionList([EachPlayerAction(AnyPlayer, SacrificeAllPermanentsExceptForNum(AnyPermanent, TheLowestNumberOfPermanentsControlledAmongPlayers(AnyPermanent, AnyPlayer))), EachPlayerAction(AnyPlayer, DiscardAllButNumberCards(TheLowestNumberOfCardsInHandAmongPlayers(AnyPlayer)))])",
    "Each player chooses a party from among creatures they control, then sacrifices the rest": "ActionList([EachPlayerActions(AnyPlayer, [ChooseAPartyFromAmongPermanents(And([IsCardtype(Creature), ControlledByPlayer(EachPlayerAction_ThatPlayer)])), SacrificeEachPermanent(ExceptFor(ThePermanentsChosenThisWay))])])",
    "Each player chooses any number of creatures they control with total power {{Digits}} or less, then sacrifices all other creatures they control": "ActionList([EachPlayerActions(AnyPlayer, [ChooseAnyNumberOfGroupPermanents(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(ActionPlayer))]), TotalPowerIs(LessThanOrEqualTo({{Digits[0]}}))), SacrificeEachPermanent(And([ExceptFor(TheChosenPermanents), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(ActionPlayer))]))])])",
    "Each player chooses from among the permanents they control an artifact, a creature, an enchantment, and a land, then sacrifices the rest": "ActionList([EachPlayerActions(AnyPlayer, [ChooseMultiplePermanentsAmoungPermanents([IsCardtype(Artifact), IsCardtype(Creature), IsCardtype(Enchantment), IsCardtype(Land)], And([IsPermanent, ControlledByAPlayer(SinglePlayer(ActionPlayer))])), SacrificeEachPermanent(And([ExceptFor(ThePermanentsChosenThisWay), IsPermanent, ControlledByAPlayer(SinglePlayer(ActionPlayer))]))])])",
    "Each player chooses from the lands they control a land of each basic land type, then sacrifices the rest": "ActionList([EachPlayerAction(AnyPlayer, SacrificeAllPermanentsExceptForAPermanentOfEachLandType(IsCardtype(Land)))])",
    "Each player chooses up to {{Number}} creatures they control, then sacrifices the rest. Then you create a tapped Treasure token for each {{Eachable}}": "ActionList([EachPlayerAction(AnyPlayer, SacrificeAllPermanentsExceptForNum(IsCardtype(Creature), {{Number[0]}})), CreateTokensWithFlags([NumberTokens({{Eachable[0]}}, TreasureToken)], [EntersTapped])])",
    "Each player chooses {{Number}} {{Permanents}} they control, then sacrifices the rest": "ActionList([EachPlayerActions(AnyPlayer, [ChooseNumberPermanents({{Number[0]}}, And([{{Permanents[0]}}, ControlledByAPlayer(SinglePlayer(ActionPlayer))])), SacrificeEachPermanent(Other(ThePermanentChosenThisWay))])])",
    "Each player chooses {{a}} {{Permanent}} they control, then sacrifices the rest. Players can't cast {{PotentialSpells}} until the end of your next turn": "ActionList([EachPlayerActions(AnyPlayer, [ChooseAPermanent(And([{{Permanent[0]}}, ControlledByAPlayer(SinglePlayer(ActionPlayer))])), SacrificeEachPermanent(And([Other(TheChosenPermanent), {{Permanent[0]}}, ControlledByAPlayer(SinglePlayer(ActionPlayer))]))]), CreateEachPlayerEffectUntil(AnyPlayer, [CantCastSpells({{PotentialSpells[0]}})], UntilPlayersNextTurn(You))])",
    "Each player chooses {{a}} {{Permanent}} they control. Destroy the rest": "ActionList([EachPlayerAction(AnyPlayer, ChooseAPermanent(And([{{Permanent[0]}}, ControlledByAPlayer(SinglePlayer(ActionPlayer))]))), DestroyEachPermanent(And([{{Permanent[0]}}, ExceptFor(ThePermanentsChosenThisWay)]))])",
    "Each player creates {{a}} {{CreatureToken}}. Those creatures have \"{{TokenQuotedCDA_PT_0_0}}\"": "ActionList([EachPlayerAction(AnyPlayer, CreateTokens([TokenWithPT(PT(0, 0), {{CreatureToken[0]}}, [{{TokenQuotedCDA_PT_0_0[0]}}])]))])",
    "Each player creates {{a}} {{PT}} {{CreatureToken}} for each {{Eachable(ThatPlayer)}}": "ActionList([EachPlayerAction(AnyPlayer, CreateTokens([NumberTokens({{Eachable(ThatPlayer=ActionPlayer)[0]}}, TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, []))]))])",
    "Each player discards a card. Then each player who didn't discard {{a}} {{SpecificCard}} this way loses {{Digits}} life": "ActionList([EachPlayerAction(AnyPlayer, DiscardACard), EachPlayerAction(DidntDiscardedACardOfTypeThisWay({{SpecificCard[0]}}), LoseLife({{Digits[0]}}))])",
    "Each player discards all the cards in their hand, then creates that many {{PT}} {{CreatureTokens}}": "ActionList([EachPlayerAction(AnyPlayer, DiscardHand), EachPlayerAction(AnyPlayer, CreateTokens([NumberTokens(TheNumberOfCardsDiscardedByPlayerThisWay(EachablePlayer), TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))]))])",
    "Each player discards all the cards in their hand, then draws that many cards": "ActionList([EachPlayerAction(AnyPlayer, DiscardHand), EachPlayerAction(AnyPlayer, DrawNumberCards(TheNumberOfCardsDiscardedByPlayerThisWay(EachablePlayer)))])",
    "Each player discards all the cards in their hand, then draws that many cards minus {{Number}}": "ActionList([EachPlayerAction(AnyPlayer, DiscardHand), EachPlayerAction(AnyPlayer, DrawNumberCards(TheNumberOfCardsDiscardedByPlayerThisWay(EachablePlayer)))])",
    "Each player discards any number of cards, then draws that many cards.\nDraw a card": "ActionList([EachPlayerAction(AnyPlayer, DiscardAnyNumberOfCards), EachPlayerAction(AnyPlayer, DrawNumberCards(TheNumberOfCardsDiscardedByPlayerThisWay(EachablePlayer))), DrawACard])",
    "Each player discards their hand, then conjures a duplicate of each of {{Number}} random cards from the library of the player to their right into their hand. The duplicates perpetually gain \"{{PerpetualQuotedAbility}}\"": "ActionList([EachPlayerAction(AnyPlayer, DiscardHand), EachPlayerAction(AnyPlayer, ConjureDuplicatesOfNumberRandomCardsOfTypeFromPlayersLibraryIntoHand({{Number[0]}}, AnyCard, PlayerToTheRightOf(EachablePlayer))), CreatePerpetualCardsInEachPlayersHandEffect(TheCardsConjuredIntoHandThisWay, AnyPlayer, [AddAbility([{{PerpetualQuotedAbility[0]}}])])])",
    "Each player discards their hand, then draws cards equal to the greatest number of cards a player discarded this way": "ActionList([EachPlayerAction(AnyPlayer, DiscardHand), EachPlayerAction(AnyPlayer, DrawNumberCards(TheGreatestNumberOfCardsDiscardedThisWay))])",
    "Each player discards their hand, then draws {{Number}} cards": "ActionList([EachPlayerAction(AnyPlayer, DiscardHand), EachPlayerAction(AnyPlayer, DrawNumberCards({{Number[0]}}))])",
    "Each player discards {{Number}} cards": "ActionList([EachPlayerAction(AnyPlayer, DiscardNumberCards({{Number[0]}}))])",
