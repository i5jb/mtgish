    "Each creature with mana value X can't attack or block this turn": "ActionList([CreateEachPermanentRuleEffectUntil(And([IsCardtype(Creature), ManaValueIs(EqualTo({{X}}))]), [CantAttack, CantBlock], UntilEndOfTurn)])",
    "Each player draws X cards": "ActionList([EachPlayerAction(AnyPlayer, DrawNumberCards({{X}}))])",
    "Exile each permanent with mana value X or less that's one or more colors": "ActionList([ExileEachPermanent(And([ManaValueIs(LessThanOrEqualTo({{X}})), IsColored]))])",
    "Exile target creature card with mana value X from a graveyard. Create {{a}} {{PT}} {{CreatureToken}}. Put X {{CounterType}} counters on it": "Targeted([TargetGraveyardCard(And([IsCardtype(Creature), ManaValueIs(EqualTo({{X}}))]))], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])]), PutNumberCountersOfTypeOnPermanent({{X}}, {{CounterType[0]}}, TheCreatedToken)]))",
    "Exile target instant or sorcery card with mana value X from your graveyard and choose an Attraction you control that doesn't have {{a}} {{CounterType}} counter on it. Put {{a}} {{CounterType}} counter on it. For as long as that Attraction is on the battlefield, whenever you visit it, copy the exiled card. You may cast the copy without paying its mana cost": "Targeted([TargetGraveyardCard(And([Or([IsCardtype(Instant), IsCardtype(Sorcery)]), ManaValueIs(EqualTo({{X}})), InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard), ChooseAPermanent(And([IsArtifactType(Attraction), ControlledByAPlayer(SinglePlayer(You)), HasNoCountersOfType({{CounterType[0]}})])), PutACounterOfTypeOnPermanent({{CounterType[1]}}, ThePermanentChosenThisWay), CreateTriggerUntil(WhenAPlayerVisitsAnAttraction(SinglePlayer(You), SinglePermanent(ThePermanentChosenThisWay)), ActionList([CopyExiledCard(TheCardExiledThisWay), MayAction(CastCopiedCardWithoutPaying)]), UntilPermanentLeavesBattlefield(ThePermanentChosenThisWay))]))",
    "Exile target {{SpecificCard}} with mana value X from your graveyard. Create a token that's a copy of it, except it's {{a}} {{PT}} {{Black}} {{Zombie}}": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, ManaValueIs(EqualTo({{X}})), InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard), CreateTokens([TokenCopyOfExiledCard(TheCardExiledThisWay, TokenCopyEffects([SetPT({{PT[0]}}), SetColor(SimpleColorList([{{Black[0]}}])), SetCreatureTypes([{{Zombie[0]}}])]))])]))",
    "Exile target {{SpecificCard}} with mana value X from your graveyard. Create a token that's a copy of that card": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, ManaValueIs(EqualTo({{X}})), InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard), CreateTokens([TokenCopyOfExiledCard(TheCardExiledThisWay, NoTokenCopyEffects)])]))",
    "Exile the top X cards of target opponent's library. You may play lands and cast spells from among cards exiled this way without paying their mana costs": "Targeted([TargetPlayer(Opponent)], ActionList([ExileTheTopNumberCardsOfPlayersLibrary({{X}}, Ref_TargetPlayer), CreatePlayerEffectUntil(You, [MayPlayLandsFromAmongExiled(TheCardsExiledThisWay), MayCastSpellsFromAmongExiled(AnySpell, TheCardsExiledThisWay)], UntilCardsAreNoLongerExiled(TheCardsExiledThisWay))]))",
    "Exile the top X cards of your library and put {{a}} {{CounterType}} counter on each of them. Then you may put a card you own in exile with {{a}} {{CounterType}} counter on it into your hand": "ActionList([ExileTheTopNumberCardsOfLibrary({{X}}), PutACounterOnEachExiledCard({{CounterType[0]}}, TheCardsExiledThisWay), MayAction(PutAnExiledCardIntoOwnersHand(And([OwnedByAPlayer(SinglePlayer(You)), HasACounterOfType({{CounterType[0]}})])))])",
    "Exile up to X target cards from a single graveyard": "Targeted([UptoNumberTargetGroupGraveyardCards({{X}}, AnyCardInAnyGraveyard, ShareAGraveyard)], ActionList([ExileEachGraveyardCard(Ref_TargetGraveyardCards)]))",
    "If {{a}} {{DamageSource}} would deal noncombat damage to a permanent or player this turn, it deals that much damage plus X instead": "ActionList([CreateReplaceWouldDealDamageUntil(DamageWouldBeDealtByASourceToARecipient({{DamageSource[0]}}, APlayerOrAPermanent(AnyPlayer, AnyPermanent)), [DealDamageInstead(Plus(WouldDealDamage_ThatMuchDamage, {{X}}))], UntilEndOfTurn)])",
