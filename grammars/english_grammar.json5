    "You gain life equal to target {{Creature}}'s power. The next time that creature would deal damage this turn, prevent that damage": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([GainLife(PowerOfPermanent(Ref_TargetPermanent)), CreateFuturePreventDamage(NextTimeDamageWouldBeDealtThisTurnByPermanent(Ref_TargetPermanent), [PreventThatDamage])]))",
    "You gain life equal to {{GameNumber}}": "ActionList([GainLife({{GameNumber[0]}})])",
