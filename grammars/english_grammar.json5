    "Cast any number of {{PotentialSpells}} from among cards you own outside the game without paying their mana costs": "ActionList([CastAnyNumberOfSpellsFromOutsideTheGameWithoutPaying({{PotentialSpells[0]}})])",
    "Cast any number of {{SpecificCards}} from your graveyard without paying their mana costs": "ActionList([CastAnyNumberOfCardsInPlayersGraveyardWithoutPaying({{SpecificCards[0]}}, You)])",
    "Change the text of target {{Enchantment}} by replacing all instances of one color word with another. That enchantment gains \"{{QuotedAbility}}\"": "Targeted([TargetPermanent({{Enchantment[0]}})], ActionList([ChooseTwoColorWords, CreatePermanentLayerEffect(Ref_TargetPermanent, [ReplaceColorWordVariableWithNewColorWordVariable(TheFirstChosenColorWord, TheSecondChosenColorWord), AddAbility([{{QuotedAbility[0]}}])])]))",
    "Choose a basic land type. Each {{Land}} becomes that type until end of turn": "ActionList([ChooseABasicLandType, CreateEachPermanentLayerEffectUntil({{Land[0]}}, [SetLandTypeVariable(TheChosenLandType)], UntilEndOfTurn)])",
    "Choose a card name that hasn't been chosen from among {{NamedCard}}, {{NamedCard}}, {{NamedCard}}, {{NamedCard}}, {{NamedCard}}, and {{NamedCard}}. Create a copy of the card with the chosen name. You may cast the copy": "ActionList([ChooseACardNameThatHasntBeenChosen(Or([IsNamed(NamedCard({{NamedCard[0]}})), IsNamed(NamedCard({{NamedCard[1]}})), IsNamed(NamedCard({{NamedCard[2]}})), IsNamed(NamedCard({{NamedCard[3]}})), IsNamed(NamedCard({{NamedCard[4]}})), IsNamed(NamedCard({{NamedCard[5]}}))])), CopyCard(TheCardWithTheChosenName), MayAction(CastCopiedCard)])",
    "Choose a card name. Exile the top {{Number}} cards of your library, then reveal cards from the top of your library until you reveal a card with the chosen name. Put that card into your hand and exile all other cards revealed this way": "ActionList([ChooseACardName(AnyOracleCard), ExileTheTopNumberCardsOfLibrary({{Number[0]}}), RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed(IsNamed(TheChosenName), [PutTheCardFoundThisWayIntoHand, ExileTheRemainingCards])])",
    "Choose a card name. Search target opponent's graveyard, hand, and library for up to {{Number}} cards with that name and exile them. That player shuffles, then draws a card for each card exiled from their hand this way": "Targeted([TargetPlayer(Opponent)], ActionList([ChooseACardName(AnyOracleCard), SearchPlayersLibraryAndGraveyardAndHand(Ref_TargetPlayer, [FindUptoNumberCardsOfType({{Number[0]}}, IsNamed(TheChosenName)), ExileFoundCards, Shuffle]), PlayerAction(Ref_TargetPlayer, DrawNumberCards(NumHandCardsExiledThisWay))]))",
    "Choose a card name. Target opponent guesses whether a card with that name is in your hand. You may reveal your hand. If you do and your opponent guessed wrong, draw a card": "Targeted([TargetPlayer(Opponent)], ActionList([ChooseACardName(AnyOracleCard), PlayerAction(Ref_TargetPlayer, GuessIfACardIsInPlayersHand(IsNamed(TheChosenName), You)), RevealHand, If(PlayerGuessedWrong, [DrawACard])]))",
    "Choose a color of a card in your graveyard. Add one mana of that color": "ActionList([ChooseAColor(ColorsOfCardsInPlayersGraveyard(AnyCard, You)), AddMana(ManaOfTheChosenColor)])",
    "Choose a color of {{a}} {{Permanent}}. Add one mana of that color": "ActionList([ChooseAColor(ColorAmoungPermanents({{Permanent[0]}})), AddMana(ManaOfTheChosenColor)])",
    "Choose a color. Add an amount of mana of that color equal to your devotion to that color": "ActionList([ChooseAColor(AnyColor), AddManaRepeated(ManaOfTheChosenColor, PlayerDevotionTo(You, TheChosenColor))])",
    "Choose a color. Add one mana of that color for each {{Eachable}}": "ActionList([ChooseAColor(AnyColor), AddManaRepeated(ManaOfTheChosenColor, {{Eachable[0]}})])",
    "Choose a color. Add one mana of that color unless any player pays {{ManaCost}}": "ActionList([ChooseAColor(AnyColor), AnyPlayerMayCost(AnyPlayer, PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [AddMana(ManaOfTheChosenColor)])])",
    "Choose a color. {{Permanents}} gain protection from the chosen color until end of turn": "ActionList([ChooseAColor(AnyColor), CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([Protection(FromColor(TheChosenColor))])], UntilEndOfTurn)])",
    "Choose a counter on target permanent or player. Give that permanent or player another counter of that kind": "Targeted_Modal([Targeted([TargetPermanent(AnyPermanent)], ActionList([ChooseACounterTypeOnPermanent(Ref_TargetPermanent), PutACounterOfTypeOnPermanent(TheChosenCounterType, Ref_TargetPermanent)])), Targeted([TargetPlayer(AnyPlayer)], ActionList([ChooseACounterTypeOnPlayer(Ref_TargetPlayer), PutACounterOfTypeOnPlayer(TheChosenCounterType, Ref_TargetPlayer)]))])",
    "Choose a creature card name. Reveal the top {{Number}} cards of your library and put all of them with that name into your hand. Put the rest into your graveyard": "ActionList([ChooseACardName(IsCardtype(Creature)), RevealTheTopNumberCardsOfLibrary({{Number[0]}}, [PutEachCardOfTypeIntoHand(IsNamed(TheChosenName)), PutTheRemainingCardsIntoGraveyard])])",
    "Choose a creature type other than {{Zombie}}. Target {{Creature}} becomes that type until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([ChooseACreatureTypeOtherThan({{Zombie[0]}}), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddCreatureTypeVariable(TheChosenCreatureType)], UntilEndOfTurn)]))",
    "Choose a creature type. Each {{Creature}} becomes that type until end of turn": "ActionList([ChooseACreatureType, CreateEachPermanentLayerEffectUntil({{Creature[0]}}, [AddCreatureTypeVariable(TheChosenCreatureType)], UntilEndOfTurn)])",
    "Choose a creature type. Reveal cards from the top of your library until you reveal a creature card of that type. Put that card onto the battlefield and shuffle the rest into your library": "ActionList([ChooseACreatureType, RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed(And([IsCardtype(Creature), IsCreatureTypeVariable(TheChosenCreatureType)]), [PutTheCardFoundThisWayOntoTheBattlefield([EntersNormally]), PutTheRemainingCardsBackIntoLibraryAndShuffle])])",
    "Choose a creature type. Reveal the top card of your library. If that card is a creature card of the chosen type, put it into your hand. Otherwise, put it into your graveyard": "ActionList([ChooseACreatureType, RevealTopCardOfLibrary, IfElse(ACardWasRevealedThisWay(And([IsCardtype(Creature), IsCreatureTypeVariable(TheChosenCreatureType)])), [PutTopOfLibraryInHand], [PutTopOfLibraryInGraveyard])])",
    "Choose a creature type. You get an emblem with \"{{EmblemQuotedAbility}}\"": "ActionList([ChooseACreatureType, GetAnEmblem([{{EmblemQuotedAbility[0]}}])])",
    "Choose a land type. Target {{Creature}} gains snow landwalk of the chosen type until end of turn. Return that creature to its owner's hand at the beginning of the next end step": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([ChooseALandType, CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([Landwalk(And([IsSupertype(Snow), IsLandTypeVariable(TheChosenLandType)]))])], UntilEndOfTurn), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutPermanentIntoItsOwnersHand(Ref_TargetPermanent)]))]))",
    "Choose a nonland card name, then reveal the top {{Number}} cards of your library. Put all cards with the chosen name from among them into your hand and the rest into your graveyard": "ActionList([ChooseACardName(IsNonCardtype(Land)), RevealTheTopNumberCardsOfLibrary({{Number[0]}}, [PutEachCardOfTypeIntoHand(IsNamed(TheChosenName)), PutTheRemainingCardsIntoGraveyard])])",
    "Choose a number greater than 0 and a color. Target opponent reveals their hand. If that opponent reveals exactly the chosen number of cards of the chosen color, you draw a card": "Targeted([TargetPlayer(Opponent)], ActionList([ChooseANumberGreaterThanNumber(0), ChooseAColor(AnyColor), PlayerAction(Ref_TargetPlayer, RevealHand), If(ANumberOfCardsWereRevealedThisWay(EqualTo(TheChosenNumber), IsColor(TheChosenColor)), [DrawACard])]))",
    "Choose a player with the most life or tied for most life. Target {{Creature}} can't be blocked by creatures that player controls this turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([ChooseAPlayer(LifeTotalIs(EqualTo(TheHighestLifeTotalAmongPlayers(AnyPlayer)))), CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [CantBeBlockedByDefenders(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(TheChosenPlayer))]))], UntilEndOfTurn)]))",
    "Choose a player. That player adds one mana of any color they choose": "ActionList([ChooseAPlayer(AnyPlayer), PlayerAction(TheChosenPlayer, AddMana(AnyManaColor))])",
    "Choose a player. That player adds {{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}": "ActionList([ChooseAPlayer(AnyPlayer), PlayerAction(TheChosenPlayer, AddMana(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}, {{ManaProduceSymbol[2]}}])))])",
    "Choose an exiled card an opponent owns with {{a}} {{CounterType}} counter on it. You may play it this turn without paying its mana cost": "ActionList([ChooseAnExiledCard(And([OwnedByAPlayer(Opponent), HasACounterOfType({{CounterType[0]}})])), CreatePlayerEffectUntil(You, [MayPlayExiledCardWithoutPaying(TheChosenExiledCard)], UntilEndOfTurn)])",
    "Choose another player. That player gains control of target {{Permanent}}. You draw a card": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([APlayerAction(Other(You), GainControlOfPermanent(Ref_TargetPermanent)), DrawACard]))",
    "Choose any number of target {{Creatures}}. Each of those creatures gains {{Hasable}} until end of turn": "Targeted([AnyNumberOfTargetPermanents({{Creatures[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Choose left or right. Until your next turn, each player may attack only the nearest opponent in the last chosen direction and planeswalkers controlled by that opponent": "ActionList([ChooseLeftOrRight, CreateEachPlayerEffectUntil(AnyPlayer, [MayAttackOnlyPlayerOrPlaneswalkersControlledBy(NearestPlayerInChosenDirection(Opponent))], UntilPlayersNextTurn(You))])",
    "Choose target battle. If an opponent protects it, remove {{a}} {{CounterType}} counter from it. Otherwise, put {{a}} {{CounterType}} counter on it": "Targeted([TargetPermanent(IsCardtype(Battle))], ActionList([IfElse(APlayerPassesFilter(Opponent, IsProtectingBattle(Ref_TargetPermanent)), [RemoveACounterOfTypeFromPermanent({{CounterType[0]}}, Ref_TargetPermanent)], [PutACounterOfTypeOnPermanent({{CounterType[1]}}, Ref_TargetPermanent)])]))",
    "Choose target opponent who controls more {{Permanents}} than you do as you activate this ability. Create {{a}} {{PT}} {{CreatureToken}}": "Targeted([TargetPlayerAtTime(Opponent, ControlsMorePermanentThanPlayer(You, {{Permanents[0]}}))], ActionList([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])]))",
    "Choose target opponent who has at least {{Number}} fewer creature cards in their graveyard than you do as you activate this ability. Destroy target {{Permanent}} that player controls": "Targeted([TargetPlayerAtTime(Opponent, NumCardsInGraveyardIs(LessThan(Minus(TheNumberOfGraveyardCards(And([IsCardtype(Creature), InAPlayersGraveyard(SinglePlayer(You))])), {{Number[0]}})), IsCardtype(Creature))), TargetPermanent(And([{{Permanent[0]}}, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]))], ActionList([DestroyPermanent(Ref_TargetPermanent)]))",
    "Choose target opponent who has at least {{Number}} more cards in hand than you do as you activate this ability. Draw a card": "Targeted([TargetPlayerAtTime(Opponent, NumCardsInHandIs(GreaterThanOrEqualTo(Plus(TheNumberOfCardsInPlayersHand(You), {{Number[0]}}))))], ActionList([DrawACard]))",
    "Choose target opponent who has more life than you do as you activate this ability. You gain {{Digits}} life": "Targeted([TargetPlayerAtTime(Opponent, LifeTotalIs(GreaterThan(LifeTotalOfPlayer(You))))], ActionList([GainLife({{Digits[0]}})]))",
    "Choose target opponent. Conjure a duplicate of the top card of their library into your hand. It perpetually gains \"{{PerpetualQuotedAbility}}\". Then they exile the top card of their library face down": "Targeted([TargetPlayer(Opponent)], ActionList([ConjureDuplicateOfTheTopCardOfPlayersIntoHand(Ref_TargetPlayer), CreatePerpetualCardInHandEffect(TheCardConjuredIntoHandThisWay, [AddAbility([{{PerpetualQuotedAbility[0]}}])]), PlayerAction(Ref_TargetPlayer, ExileTopCardOfLibraryFaceDown)]))",
    "Choose target permanent you control or suspended card you own. If that permanent or card has {{a}} {{CounterType}} counter on it, you may remove {{a}} {{CounterType}} counter from it or put another {{CounterType}} counter on it": "Targeted_Modal([Targeted([TargetPermanent(ControlledByAPlayer(SinglePlayer(You)))], ActionList([If(PermanentPassesFilter(Ref_TargetPermanent, HasACounterOfType({{CounterType[0]}})), [MayAction(PutACounterOfTypeOnOrRemoveACounterOfTypeFromPermanent({{CounterType[1]}}, Ref_TargetPermanent))])])), Targeted([TargetExiledCard(And([IsSuspended, OwnedByAPlayer(SinglePlayer(You))]))], ActionList([If(ExiledCardPassesFilter(Ref_TargetExiledCard, HasACounterOfType({{CounterType[0]}})), [MayAction(PutACounterOnOrRemoveACounterOfTypeFromExiledCard({{CounterType[1]}}, Ref_TargetExiledCard))])]))])",
    "Choose target {{Artifact}} a player controls and target {{ArtifactCard}} in that player's graveyard. If both targets are still legal as this ability resolves, that player simultaneously sacrifices the artifact and returns the artifact card to the battlefield": "Targeted([TargetPermanent({{Artifact[0]}}), TargetGraveyardCard(And([{{ArtifactCard[0]}}, InAPlayersGraveyard(SinglePlayer(ControllerOfPermanent(Ref_TargetPermanent)))]))], ActionList([PlayerAction(ControllerOfPermanent(Ref_TargetPermanent), SimultaneouslySacrificePermanentAndPutGraveyardCardOntoBattlefield(Ref_TargetPermanent, Ref_TargetGraveyardCard, [EntersNormally]))]))",
    "Choose target {{Creature}}. Its controller may pay {{ManaCostX}}, where X is that creature's mana value. If they don't pay, that creature attacks this turn if able, and at the beginning of the next end step, destroy it if it didn't attack this turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([PlayerMayCost(ControllerOfPermanent(Ref_TargetPermanent), PayManaX({{ManaCostX[0]}}, ManaValueOfPermanent(Ref_TargetPermanent))), Unless(CostWasPaid, [CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [MustAttack], UntilEndOfTurn), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([If(PermanentPassesFilter(Ref_TargetPermanent, DidntAttackThisTurn), [DestroyPermanent(Ref_TargetPermanent)])]))])]))",
    "Choose target {{Creature}}. Put {{Number}} {{CounterType}} counters, {{a}} {{CounterType}} counter, {{a}} {{CounterType}} counter, {{a}} {{CounterType}} counter, and {{a}} {{CounterType}} counter on that creature": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[0]}}, Ref_TargetPermanent), PutACounterOfTypeOnPermanent({{CounterType[1]}}, Ref_TargetPermanent), PutACounterOfTypeOnPermanent({{CounterType[2]}}, Ref_TargetPermanent), PutACounterOfTypeOnPermanent({{CounterType[3]}}, Ref_TargetPermanent), PutACounterOfTypeOnPermanent({{CounterType[4]}}, Ref_TargetPermanent)]))",
    "Choose target {{Creature}}. That creature attacks this turn if able. Destroy it at the beginning of the next end step if it didn't attack this turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [MustAttack], UntilEndOfTurn), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([If(PermanentPassesFilter(Ref_TargetPermanent, DidntAttackThisTurn), [DestroyPermanent(Ref_TargetPermanent)])]))]))",
    "Choose target {{Creature}}. Until your next turn, if that creature would deal combat damage to one of your opponents, it deals triple that damage to that player instead": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreateReplaceWouldDealDamageUntil(CombatDamageWouldBeDealtByCreatureToARecipient(Ref_TargetPermanent, APlayer(Opponent)), [DealDamageInstead(Thrice(WouldDealDamage_ThatMuchDamage))], UntilPlayersNextTurn(You))]))",
    "Choose target {{Creature}}. When that creature dies this turn, return that card to its owner's hand": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreateTriggerUntil(WhenACreatureOrPlaneswalkerDies(SinglePermanent(Ref_TargetPermanent)), ActionList([ReturnDeadGraveyardCardToHand]), UntilEndOfTurn)]))",
    "Choose target {{Permanent}}. Put {{a}} {{CounterType}} counter on it if {{Condition(ThatPermanent)}} and {{a}} {{CounterType}} counter on it if {{Condition(ThatPermanent)}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([If({{Condition(ThatPermanent=Ref_TargetPermanent)[0]}}, [PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent)]), If({{Condition(ThatPermanent=Ref_TargetPermanent)[1]}}, [PutACounterOfTypeOnPermanent({{CounterType[1]}}, Ref_TargetPermanent)])]))",
    "Choose target {{SpecificCard}} in a graveyard or {{Permanent}} on the battlefield. Create {{Number}} tokens that are copies of it": "Targeted_Modal([Targeted([TargetGraveyardCard({{SpecificCard[0]}})], ActionList([CreateTokens([NumberTokens({{Number[0]}}, TokenCopyOfGraveyardCard(Ref_TargetGraveyardCard, NoTokenCopyEffects))])])), Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreateTokens([NumberTokens({{Number[0]}}, TokenCopyOfPermanent(Ref_TargetPermanent, NoTokenCopyEffects))])]))])",
    "Choose target {{SpecificCard}} in a graveyard. Exile it with {{a}} {{CounterType}} counter on it": "Targeted([TargetGraveyardCard({{SpecificCard[0]}})], ActionList([ExileGraveyardCardWithACounterOfType(Ref_TargetGraveyardCard, {{CounterType[0]}})]))",
    "Choose target {{SpecificCard}} in your graveyard that was put there from the battlefield this turn. Return it to the battlefield tapped": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You)), WasPutIntoGraveyardFromTheBattlefieldThisTurn]))], ActionList([PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersTapped])]))",
    "Choose target {{SpecificCard}} in your graveyard that was put there from the battlefield this turn. Return it to your hand": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You)), WasPutIntoGraveyardFromTheBattlefieldThisTurn]))], ActionList([PutGraveyardCardIntoHand(Ref_TargetGraveyardCard)]))",
    "Choose target {{SpecificCard}} in your graveyard. If you haven't cast a spell this turn, you may cast that card. If you do, you can't cast additional spells this turn": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([If(PlayerPassesFilter(You, HasntCastASpellThisTurn(AnySpell)), [MayCost(CastGraveyardCard(Ref_TargetGraveyardCard)), If(CostWasPaid, [CreatePlayerEffectUntil(You, [CantCastSpells(AnySpell)], UntilEndOfTurn)])])]))",
    "Choose target {{SpecificCard}} in your graveyard. You may cast that card this turn": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([CreatePlayerEffectUntil(You, [MayCastGraveyardCard(Ref_TargetGraveyardCard)], UntilEndOfTurn)]))",
    "Choose two target blocked attacking creatures. If each of those creatures could be blocked by all creatures that the other is blocked by, each creature that's blocking exactly one of those attacking creatures stops blocking it and is blocking the other attacking creature": "Targeted([NumberTargetPermanents(Integer(2), And([IsBlocked, IsAttacking, IsCardtype(Creature)]))], ActionList([TrySwappingBlockAssignmentsOfTwoAttackingCreatures(Ref_TargetPermanents_0, Ref_TargetPermanents_1)]))",
    "Choose two target blocking creatures controlled by the same opponent. If each of those creatures could block all creatures that the other is blocking, remove both of them from combat. Each one then blocks all creatures the other was blocking": "Targeted([NumberTargetGroupPermanents(Integer(2), And([IsBlocking, IsCardtype(Creature), ControlledByAPlayer(Opponent)]), ControlledByTheSamePlayer)], ActionList([TrySwappingBlockAssignmentsOfTwoBlockingCreatures(Ref_TargetPermanents_0, Ref_TargetPermanents_1)]))",
    "Choose up to one target {{Permanent}}, up to one target {{Permanent}}, and up to one target {{Permanent}}. Untap the chosen permanents you control. Tap the chosen permanents you don't control. You gain {{Digits}} life": "Targeted([UptoOneTargetPermanent({{Permanent[0]}}), UptoOneTargetPermanent({{Permanent[1]}}), UptoOneTargetPermanent({{Permanent[2]}})], ActionList([UntapEachPermanent(And([Or([SinglePermanent(Ref_TargetPermanent1), SinglePermanent(Ref_TargetPermanent2), SinglePermanent(Ref_TargetPermanent3)]), ControlledByAPlayer(SinglePlayer(You))])), TapEachPermanent(And([Or([SinglePermanent(Ref_TargetPermanent1), SinglePermanent(Ref_TargetPermanent2), SinglePermanent(Ref_TargetPermanent3)]), ControlledByAPlayer(Other(You))])), GainLife({{Digits[0]}})]))",
    "Choose up to one target {{Permanent}}. Put {{a}} {{CounterType}} counter and a counter from among {{CounterType}}, {{CounterType}}, {{CounterType}}, or {{CounterType}} on it": "Targeted([UptoOneTargetPermanent({{Permanent[0]}})], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent), PutACounterOfChoiceOnPermanent([{{CounterType[0]}}, {{CounterType[1]}}, {{CounterType[2]}}, {{CounterType[3]}}], Ref_TargetPermanent)]))",
    "Choose up to two target {{Creatures}}. Until your next turn, whenever either of those creatures deals combat damage, you draw a card": "Targeted([UptoNumberTargetPermanents(Integer(2), {{Creatures[0]}})], ActionList([CreateTriggerUntil(WhenACreatureDealsCombatDamage(Ref_TargetPermanents), ActionList([DrawACard]), UntilPlayersNextTurn(You))]))",
    "Choose up to {{Number}} face-up exiled cards you own. Exile all the cards from your library, then put the chosen cards on top of your library": "ActionList([ChooseUptoNumberExiledCards({{Number[0]}}, And([IsFaceUp, OwnedByAPlayer(SinglePlayer(You))])), ExileAllLibraryCards, PutExiledCardsOnTopOfLibraryInAnyOrder(TheExiledCardsChosenThisWay)])",
    "Choose up to {{Number}} target {{Permanents}}. For each of them, put a number of {{CounterType}} counters on it equal to the number of colors it is": "Targeted([UptoNumberTargetPermanents({{Number[0]}}, {{Permanents[0]}})], ActionList([PutNumberCountersOfTypeOnEachPermanent(NumColorsOfPermanent(EachablePermanent), {{CounterType[0]}}, Ref_TargetPermanents)]))",
    "Choose up to {{Number}} {{Permanents}}, then destroy the rest": "ActionList([ChooseUptoNumberPermanents({{Number[0]}}, {{Permanents[0]}}), DestroyEachPermanent(ExceptFor(ThePermanentsChosenThisWay))])",
    "Choose {{Hasable}} or {{Hasable}}. {{Permanents}} gain that ability until end of turn": "ActionList([ChooseAnAbility([{{Hasable[0]}}, {{Hasable[1]}}]), CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbilityVariable(TheChosenAbility)], UntilEndOfTurn)])",
    "Choose {{a}} {{Creature}} at random that attacked this turn. Destroy that creature": "ActionList([ChooseAPermanentAtRandom(And([{{Creature[0]}}, AttackedThisTurn])), DestroyPermanent(ThePermanentChosenThisWay)])",
    "Choose {{a}} {{Permanent}}. It becomes a copy of target {{Permanent}} except for its name": "Targeted([TargetPermanent({{Permanent[1]}})], ActionList([ChooseAPermanent({{Permanent[0]}}), CreatePermanentLayerEffect(TheChosenPermanent, [IsACopyOfPermanent(Ref_TargetPermanent, CopyEffects([KeepName]))])]))",
    "Choose {{a}} {{Permanent}}. Prevent all combat damage target {{Creature}} would deal this turn if it shares a color with that permanent": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([ChooseAPermanent({{Permanent[0]}}), If(PermanentPassesFilter(Ref_TargetPermanent, SharesAColorWithPermanent(TheChosenPermanent)), [CreatePreventDamageUntil(CombatDamageWouldBeDealtByCreature(Ref_TargetPermanent), [PreventThatDamage], UntilEndOfTurn)])]))",
    "Choose {{a}} {{SpecificCard}} at random from target opponent's graveyard. Put that card onto the battlefield under your control": "Targeted([TargetPlayer(Opponent)], ActionList([ChooseACardInPlayersGraveyardAtRandom({{SpecificCard[0]}}, Ref_TargetPlayer), PutGraveyardCardOntoBattlefield(TheChosenGraveyardCard, [EntersUnderPlayersControl(You)])]))",
    "Choose {{a}} {{SpecificCard}} in your hand. Conjure a duplicate of it into your hand": "ActionList([ChooseACardInHand({{SpecificCard[0]}}), ConjureDuplicateOfCardInHandIntoHand(TheChosenCardInHand)])",
    "Choose {{a}} {{SpecificCard}} in your hand. It perpetually gains \"{{PerpetualQuotedAbility}}\"": "ActionList([ChooseACardInHand({{SpecificCard[0]}}), CreatePerpetualCardInHandEffect(TheChosenCardInHand, [AddAbility([{{PerpetualQuotedAbility[0]}}])])])",
    "Choose {{a}} {{SpecificCard}} in your hand. It perpetually gains {{PerpetualHasable}}": "ActionList([ChooseACardInHand({{SpecificCard[0]}}), CreatePerpetualCardInHandEffect(TheChosenCardInHand, [AddAbility([{{PerpetualHasable[0]}}])])])",
    "Choose {{a}} {{SpecificCard}} in your hand. It perpetually gets {{PTMod}} and perpetually gains \"{{PerpetualQuotedAbility}}\"": "ActionList([ChooseACardInHand({{SpecificCard[0]}}), CreatePerpetualCardInHandEffect(TheChosenCardInHand, [AdjustPT({{PTMod[0]}}), AddAbility([{{PerpetualQuotedAbility[0]}}])])])",
    "Choose {{a}} {{SpecificCard}} in your hand. It perpetually incorporates {{ManaCost}} and gains \"{{PerpetualQuotedAbility}}\"": "ActionList([ChooseACardInHand({{SpecificCard[0]}}), CreatePerpetualCardInHandEffect(TheCardInHandChosenThisWay, [Incorporate({{ManaCost[0]}}), AddAbility([{{PerpetualQuotedAbility[0]}}])])])",
    "Cloak the top card of your library": "ActionList([CloakTheTopCardOfPlayersLibrary(You)])",
    "Conjure a card named {{NamedCard}} into your hand": "ActionList([ConjureCardIntoHand({{NamedCard[0]}})])",
    "Conjure a card named {{NamedCard}} onto the battlefield": "ActionList([ConjureCardOntoBattlefield({{NamedCard[0]}}, [EntersNormally])])",
    "Conjure a card of your choice from {{Spellbook}} into your hand": "ActionList([ConjureACardOfChoiceFromSpellBookIntoHand({{Spellbook[0]}})])",
    "Conjure a card of your choice from {{Spellbook}} onto the battlefield tapped with {{Number}} {{CounterType}} counters on it": "ActionList([ConjureACardOfChoiceFromSpellBookOntoBattlefield({{Spellbook[0]}}, [EntersTapped, EntersWithNumberCounters({{Number[0]}}, {{CounterType[0]}})])])",
    "Conjure a random card from {{Spellbook}} into your hand. It perpetually gains \"{{PerpetualQuotedAbility}}\"": "ActionList([ConjureARandomCardFromSpellBookIntoHand({{Spellbook[0]}}), CreatePerpetualCardInHandEffect(TheCardConjuredIntoHandThisWay, [AddAbility([{{PerpetualQuotedAbility[0]}}])])])",
    "Conjure {{Number}} cards named {{NamedCard}} into your hand": "ActionList([ConjureNumberCardsIntoHand({{Number[0]}}, {{NamedCard[0]}})])",
    "Copy target activated or triggered ability you control from another legendary source that's not a commander. You may choose new targets for the copy": "Targeted([TargetAbility(And([Or([ActivatedAbility, TriggeredAbility]), ControlledByAPlayer(SinglePlayer(You)), AbilityOfASource(And([IsSupertype(Legendary), IsNotACommander]))]))], ActionList([CopyAbilityAndMayChooseNewTargets(Ref_TargetAbility)]))",
