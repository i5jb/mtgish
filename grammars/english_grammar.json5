    "Target {{Permanent}} gains {{Hasable}} and {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)]))",
    "Target {{Permanent}} gains {{Hasable}} and {{Hasable}} until end of turn. If {{Condition(ThatPermanent)}}, put {{a}} {{CounterType}} counter on it": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn), If({{Condition(ThatPermanent=Ref_TargetPermanent)[0]}}, [PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent)])]))",
    "Target {{Permanent}} gains {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Target {{Permanent}} gains {{Hasable}} until end of turn. If this is the third time this ability has resolved this turn, add {{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), If(TimesThisAbilityHasResolvedThisTurnIs(EqualTo(Integer(3))), [AddMana(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}, {{ManaProduceSymbol[2]}}, {{ManaProduceSymbol[3]}}]))])]))",
