  "{{TriggerActions_Modal[EnchantedPermanent]}}": {
    "Destroy {{EnchantedPermanent}}": "ActionList([DestroyPermanent(HostPermanent)])"
  },
  "{{TriggerActions_Modal}}": {
    "Add {{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}": "ActionList([AddMana(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}, {{ManaProduceSymbol[2]}}]))])",
    "Choose target battle. If an opponent protects it, remove {{Number}} {{CounterType}} counters from it. Otherwise, put {{Number}} {{CounterType}} counters on it": "Targeted([TargetPermanent(IsCardtype(Battle))], ActionList([IfElse(APlayerPassesFilter(Opponent, IsProtectingBattle(Ref_TargetPermanent)), [RemoveNumberCountersOfTypeFromPermanent({{Number[0]}}, {{CounterType[0]}}, Ref_TargetPermanent)], [PutNumberCountersOfTypeOnPermanent({{Number[1]}}, {{CounterType[1]}}, Ref_TargetPermanent)])]))",
    "Choose {{a}} {{CreatureCard}} in your hand. It perpetually gets {{PTMod}} and gains {{PerpetualHasable}}": "ActionList([ChooseACardInHand({{CreatureCard[0]}}), CreatePerpetualCardInHandEffect(TheCardInHandChosenThisWay, [AdjustPT({{PTMod[0]}}), AddAbility([{{PerpetualHasable[0]}}])])])",
    "Choose {{a}} {{SpecificCard}} in your hand. It perpetually gains equip {{ManaCost}}": "ActionList([ChooseACardInHand({{SpecificCard[0]}}), CreatePerpetualCardInHandEffect(TheChosenCardInHand, [AddAbility([Equip(IsCardtype(Creature), PayMana({{ManaCost[0]}}))])])])",
    "Cloak a card from your hand": "ActionList([CloakACardFromHand])",
    "Conjure a card named {{NamedCard}} into your hand": "ActionList([ConjureCardIntoHand({{NamedCard[0]}})])",
    "Conjure a card of your choice from {{Spellbook}} onto the battlefield": "ActionList([ConjureACardOfChoiceFromSpellBookOntoBattlefield({{Spellbook[0]}}, [EntersNormally])])",
    "Copy target {{Spell}}. You may choose new targets for the copy": "Targeted([TargetSpell({{Spell[0]}})], ActionList([CopySpellAndMayChooseNewTargets(Ref_TargetSpell)]))",
    "Counter target spell, activated ability, or triggered ability. Its controller draws a card": "Targeted([TargetSpellOrAbility(Or([IsSpell(AnySpell), ActivatedAbility, TriggeredAbility]))], ActionList([CounterSpellOrAbility(Ref_TargetSpellOrAbility), PlayerAction(ControllerOfSpellOrAbility(Ref_TargetSpellOrAbility), DrawACard)]))",
    "Counter target {{Spell}}": "Targeted([TargetSpell({{Spell[0]}})], ActionList([CounterSpell(Ref_TargetSpell)]))",
    "Create X {{PT}} {{CreatureTokens}} with {{Hasable}}, where X is the number of other attacking creatures": "ActionList([CreateTokensWithFlags([NumberTokens(TheNumberOfPermanentsOnTheBattlefield(And([IsAttacking, IsCardtype(Creature)])), TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}]))], [EntersTapped, EntersAttacking])])",
    "Create a Food token": "ActionList([CreateTokens([FoodToken])])",
    "Create a Treasure token": "ActionList([CreateTokens([TreasureToken])])",
    "Create a Treasure token. You lose {{Digits}} life": "ActionList([CreateTokens([TreasureToken]), LoseLife({{Digits[0]}})])",
    "Create a Wicked Role token attached to target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreateTokensWithFlags([WickedRoleToken], [EntersAttachedToPermanent(Ref_TargetPermanent)])]))",
    "Create a tapped Powerstone token": "ActionList([CreateTokensWithFlags([PowerstoneToken], [EntersTapped])])",
    "Create a tapped Treasure token": "ActionList([CreateTokensWithFlags([TreasureToken], [EntersTapped])])",
    "Create a tapped and attacking {{PTX}} {{CreatureToken}} with {{Hasable}}, where X is the greatest power among other attacking creatures": "ActionList([CreateTokensWithFlags([TokenWithPT(PTX({{PTX[0]}}, TheNumberOfPermanentsOnTheBattlefield(And([IsAttacking, IsCardtype(Creature)]))), {{CreatureToken[0]}}, [{{Hasable[0]}}])], [EntersTapped, EntersAttacking])])",
    "Create a token that's a copy of target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreateTokens([TokenCopyOfPermanent(Ref_TargetPermanent, NoTokenCopyEffects)])]))",
    "Create {{NamedCard}}, a legendary {{PT}} {{Black}} {{Zombie}} creature token": "ActionList([CreateTokens([NamedTokenWithPT({{NamedCard[0]}}, {{PT[0]}}, Colors([{{Black[0]}}]), [Legendary], [Creature], SubtypesList([{{Zombie[0]}}]), [])])])",
    "Create {{Number}} Treasure tokens": "ActionList([CreateTokens([NumberTokens({{Number[0]}}, TreasureToken)])])",
    "Create {{Number}} tapped Powerstone tokens": "ActionList([CreateTokensWithFlags([NumberTokens({{Number[0]}}, PowerstoneToken)], [EntersTapped])])",
    "Create {{Number}} {{PT}} {{CreatureTokens}}": "ActionList([CreateTokens([NumberTokens({{Number[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])])",
    "Create {{Number}} {{PT}} {{CreatureTokens}} with \"{{TokenQuotedAbility}}\"": "ActionList([CreateTokens([NumberTokens({{Number[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{TokenQuotedAbility[0]}}]))])])",
    "Create {{Number}} {{PT}} {{CreatureTokens}} with {{Hasable}} that are tapped and attacking": "ActionList([CreateTokensWithFlags([NumberTokens({{Number[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}]))], [EntersTapped, EntersAttacking])])",
    "Create {{a}} {{PTX}} {{CreatureToken}}, where X is {{GameNumber}}": "ActionList([CreateTokens([TokenWithPT(PTX({{PTX[0]}}, {{GameNumber[0]}}), {{CreatureToken[0]}}, [])])])",
    "Create {{a}} {{PT}} {{CreatureToken}}": "ActionList([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])])",
    "Create {{a}} {{PT}} {{CreatureToken}} if {{Condition}}": "ActionList([If({{Condition[0]}}, [CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])])])",
    "Create {{a}} {{PT}} {{CreatureToken}} that's tapped and attacking": "ActionList([CreateTokensWithFlags([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])], [EntersTapped, EntersAttacking])])",
