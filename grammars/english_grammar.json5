    "Enchanted creature gets {{PTMod}} and has \"{{QuotedAbility}}\"": "PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{QuotedAbility[0]}}])])",
    "Enchanted creature gets {{PTMod}} and has protection from each color. This effect doesn't remove Auras": "PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([ProtectionAndDoesntRemovePermanents(FromColor(AnyColor), IsEnchantmentType(Aura))])])",
    "Enchanted creature gets {{PTMod}} and has {{Hasable}} and \"{{QuotedAbility}}\"": "PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}]), AddAbility([{{QuotedAbility[0]}}])])",
    "Enchanted creature gets {{PTMod}} and has {{Hasable}} and {{Hasable}}": "PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])])",
    "Enchanted creature gets {{PTMod}} and has {{Hasable}}, and all {{Creatures}} able to block it do so": "PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])]), PermanentRuleEffect(HostPermanent, [AllCreaturesMustBlockIt({{Creatures[0]}})])",
