    "noncreature card with mana value {{Digits}} or less": "And([IsNonCardtype(Creature), ManaValueIs(LessThanOrEqualTo({{Digits[0]}}))])",
    "noncreature, nonland card": "And([IsNonCardtype(Creature), IsNonCardtype(Land)])",
