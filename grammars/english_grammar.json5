    "artifact named {{NamedCard}}": "And([IsCardtype(Artifact), IsNamed(NamedCard({{NamedCard[0]}}))])",
    "artifact token": "And([IsCardtype(Artifact), IsToken])",
    "artifact token you control": "And([IsCardtype(Artifact), IsToken, ControlledByAPlayer(SinglePlayer(You))])",
    "artifact with mana value {{Digits}} or less": "And([IsCardtype(Artifact), ManaValueIs(LessThanOrEqualTo({{Digits[0]}}))])",
    "artifact you control": "And([IsCardtype(Artifact), ControlledByAPlayer(SinglePlayer(You))])",
    "artifact you control with mana value {{Digits}} or greater": "And([IsCardtype(Artifact), ControlledByAPlayer(SinglePlayer(You)), ManaValueIs(GreaterThanOrEqualTo({{Digits[0]}}))])",
    "artifact you don't control": "And([IsCardtype(Artifact), ControlledByAPlayer(Other(You))])",
    "double-faced artifact you control": "And([IsDoubleFaced, IsCardtype(Artifact), ControlledByAPlayer(SinglePlayer(You))])",
    "legendary artifact": "And([IsSupertype(Legendary), IsCardtype(Artifact)])",
    "non-Equipment artifact you control": "And([IsNonArtifactType(Equipment), IsCardtype(Artifact), ControlledByAPlayer(SinglePlayer(You))])",
    "noncreature artifact": "And([IsNonCardtype(Creature), IsCardtype(Artifact)])",
    "noncreature artifact with mana value {{Digits}} or less": "And([IsNonCardtype(Creature), IsCardtype(Artifact), ManaValueIs(LessThanOrEqualTo({{Digits[0]}}))])",
    "noncreature artifact you control": "And([IsNonCardtype(Creature), IsCardtype(Artifact), ControlledByAPlayer(SinglePlayer(You))])",
    "noncreature, non-Equipment artifact": "And([IsNonCardtype(Creature), IsNonArtifactType(Equipment), IsCardtype(Artifact)])",
    "noncreature, non-Vehicle artifact you control": "And([IsNonCardtype(Creature), IsNonArtifactType(Vehicle), IsCardtype(Artifact), ControlledByAPlayer(SinglePlayer(You))])",
    "nonland artifact with mana value {{Digits}} or less": "And([IsNonCardtype(Land), IsCardtype(Artifact), ManaValueIs(LessThanOrEqualTo({{Digits[0]}}))])",
    "nontoken artifact": "And([IsNonToken, IsCardtype(Artifact)])",
    "nontoken artifact or creature": "And([IsNonToken, Or([IsCardtype(Artifact), IsCardtype(Creature)])])",
    "nontoken artifact you control": "And([IsNonToken, IsCardtype(Artifact), ControlledByAPlayer(SinglePlayer(You))])",
    "untapped artifact you control": "And([IsUntapped, IsCardtype(Artifact), ControlledByAPlayer(SinglePlayer(You))])",
    "untapped nontoken artifact you control": "And([IsUntapped, IsNonToken, IsCardtype(Artifact), ControlledByAPlayer(SinglePlayer(You))])"
  },
  "{{AttractionActions(~Permanent)}}": {
    "After the first combat phase this turn, there's an additional combat phase. At the beginning of that combat, untap all {{Permanents}}": "ActionList([If(IsBeforeFirstCombatPhaseOfTurn, [ThereIsAnAdditionalCombatPhaseWithTrigger(ActionList([UntapEachPermanent({{Permanents[0]}})]))])])",
    "Choose an opponent. They choose a creature they control, then you choose a creature you control. You may exile the chosen creatures. If you do, return them to the battlefield under their owners' control at the beginning of the next end step. Otherwise, the chosen creatures fight each other": "ActionList([ChooseAPlayer(Opponent), PlayerAction(TheChosenPlayer, ChooseAPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(TheChosenPlayer))]))), ChooseAPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))])), MayCost(ExileEachPermanent(Or([SinglePermanent(TheFirstChosenPermanent), SinglePermanent(TheSecondChosenPermanent)]))), IfElse(CostWasPaid, [CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutEachExiledCardOntoTheBattlefield(TheCardsExiledThisWay, [EntersUnderOwnersControl])]))], [HaveCreaturesFight(TheFirstChosenPermanent, TheSecondChosenPermanent)])])",
    "Choose one.\n* Create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}}.\n* Sacrifice {{a}} {{Permanent}}. If you do, target {{Permanent}} gains {{Hasable}} until end of turn": "Modal_ChooseOne([ActionList([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])])]), Targeted([TargetPermanent({{Permanent[1]}})], ActionList([MustCost(SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)])]))])",
    "Choose target creature that hasn't been phased out with this Attraction. That creature phases out until you roll a {{Digits}} or less while rolling to visit your Attractions": "Targeted([TargetPermanent(And([IsCardtype(Creature), HasntBeenPhasedOutWithThisAbility]))], ActionList([PhaseOutPermanentUntil(Ref_TargetPermanent, UntilPlayerRollsValueWhileRollingToVisitAttractions(You, LessThanOrEqualTo({{Digits[0]}})))]))",
    "Choose target {{Creature}}. Each other {{Creature}} becomes a copy of that creature until end of turn, except it isn't legendary": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(And([Other(Ref_TargetPermanent), {{Creature[1]}}]), [IsACopyOfPermanent(Ref_TargetPermanent, CopyEffects([RemoveSupertypes([Legendary])]))], UntilEndOfTurn)]))",
    "Create a Food token": "ActionList([CreateTokens([FoodToken])])",
    "Create {{Number}} Treasure tokens, then sacrifice {{~Permanent}} and open an Attraction": "ActionList([CreateTokens([NumberTokens({{Number[0]}}, TreasureToken)]), SacrificePermanent({{~Permanent}}), OpenAnAttraction])",
    "Create {{a}} {{PT}} {{CreatureToken}}": "ActionList([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])])",
    "Draw a card": "ActionList([DrawACard])",
    "Exile the top X cards of your library, where X is {{GameNumber}}. You may play those cards this turn. At the beginning of the next end step, if any of those cards remain exiled, put them on the bottom of your library in any order": "ActionList([ExileTheTopNumberCardsOfLibrary({{GameNumber[0]}}), CreatePlayerEffectUntil(You, [MayPlayExiledCards(WasExiledThisWay)], UntilEndOfTurn), CreateFutureTriggerI(AtTheBeginningOfTheNextEndStep, AnExiledCardPassesFilter(WasExiledThisWay, InExile), ActionList([PutEachExiledCardOnTheBottomOfTheirOwnersLibraryInAnyOrder(WasExiledThisWay)]))])",
    "Mill {{Number}} cards, then return a card at random from your graveyard to your hand": "ActionList([MillNumberCards({{Number[0]}}), PutACardFromGraveyardIntoHandAtRandom(InAPlayersGraveyard(SinglePlayer(You)))])",
    "Put {{a}} {{CounterType}} counter on target {{Creature}}. That creature gains {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Return target {{SpecificCard}} from your graveyard to the battlefield. It gains {{Hasable}}. Exile it at the beginning of your next end step": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersNormally]), CreatePermanentLayerEffect(ThePermanentPutOnTheBattlefieldThisWay, [AddAbility([{{Hasable[0]}}])]), CreateFutureTrigger(AtTheBeginningOfPlayersNextEndStep(You), ActionList([ExilePermanent(ThePermanentPutOnTheBattlefieldThisWay)]))]))",
    "Return {{a}} {{Permanent}} to its owner's hand": "ActionList([PutAPermanentIntoItsOwnersHand({{Permanent[0]}})])",
    "Roll a six-sided die. Put a number of {{CounterType}} counters on {{~Permanent}} equal to the result and create a Treasure token. Then if {{Condition(~Permanent)}}, claim the prize": "ActionList([RollAD6, PutNumberCountersOfTypeOnPermanent(TheDiceResult, {{CounterType[0]}}, {{~Permanent}}), If({{Condition(~Permanent=^~Permanent)[0]}}, [ClaimThePrize])])",
    "Scry {{Digits}}": "ActionList([Scry({{Digits[0]}})])",
    "Tap target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent)]))",
    "Target {{Creature}} must be blocked this turn if able": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [MustBeBlocked], UntilEndOfTurn)]))",
    "Target {{Permanent}} gains {{Hasable}} until end of turn, or until any player rolls a 1, whichever comes first": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], Or([UntilEndOfTurn, UntilAPlayerRollsValue(AnyPlayer, EqualTo(Integer(1)))]))]))",
    "You may put a sticker on {{a}} {{Permanent}}": "ActionList([MayAction(PutAStickerOnAPermanent({{Permanent[0]}}))])",
    "{{Creatures}} get {{PTMod}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])",
    "{{Permanents}} gain {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])"
  },
