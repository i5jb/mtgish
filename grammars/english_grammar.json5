  "{{Commander}}": {
    "commander": "IsACommander",
    "commander an opponent controls": "And([IsACommander, ControlledByAPlayer(Opponent)])",
    "commander that entered this turn": "And([IsACommander, EnteredTheBattlefieldThisTurn])",
    "commander you control": "And([IsACommander, ControlledByAPlayer(SinglePlayer(You))])"
  },
  "{{Condition(DefendingPlayer)}}": {
    "defending player controls an artifact": "PlayerPassesFilter({{DefendingPlayer}}, ControlsA(IsCardtype(Artifact)))",
    "defending player controls an enchantment": "PlayerPassesFilter({{DefendingPlayer}}, ControlsA(IsCardtype(Enchantment)))",
    "defending player controls an untapped land": "PlayerPassesFilter({{DefendingPlayer}}, ControlsA(And([IsUntapped, IsCardtype(Land)])))",
    "defending player controls more lands than you": "PlayerPassesFilter({{DefendingPlayer}}, ControlsMorePermanentThanPlayer(You, IsCardtype(Land)))",
    "defending player controls no {{Black}} nontoken permanents": "PlayerPassesFilter({{DefendingPlayer}}, ControlsNo(And([IsColor({{Black[0]}}), IsNonToken])))",
    "defending player controls no {{Black}} permanents": "PlayerPassesFilter({{DefendingPlayer}}, ControlsNo(IsColor({{Black[0]}})))",
    "defending player controls no {{Zombies}}": "PlayerPassesFilter({{DefendingPlayer}}, ControlsNo(IsCreatureType({{Zombies[0]}})))",
    "defending player controls no {{Zombie}} creatures": "PlayerPassesFilter({{DefendingPlayer}}, ControlsNo(And([IsCreatureType({{Zombie[0]}}), IsCardtype(Creature)])))",
    "defending player controls the most creatures or is tied for the most": "PlayerPassesFilter({{DefendingPlayer}}, AControllerOfTheMostPermanentsAmongPlayers(AnyPlayer, IsCardtype(Creature)))",
    "defending player controls {{Number}} or more artifacts": "PlayerPassesFilter({{DefendingPlayer}}, ControlsNum(GreaterThanOrEqualTo({{Number[0]}}), IsCardtype(Artifact)))",
    "defending player has a rad counter": "PlayerPassesFilter({{DefendingPlayer}}, HasARadCounter)",
    "defending player has more cards in hand than you": "PlayerPassesFilter({{DefendingPlayer}}, NumCardsInHandIs(GreaterThan(TheNumberOfCardsInPlayersHand(You))))",
    "defending player has {{Number}} or fewer cards in hand": "PlayerPassesFilter({{DefendingPlayer}}, NumCardsInHandIs(LessThanOrEqualTo({{Number[0]}})))",
    "defending player is poisoned": "PlayerPassesFilter({{DefendingPlayer}}, Poisoned)"
  },
  "{{Condition(ThatActivatedAbility)}}": {
    "it isn't a mana ability": "ActivatedAbilityPassesFilter({{ThatActivatedAbility}}, ManaAbility)"
  },
  "{{Condition(ThatEnteringCreature)}}": {
    "that creature entered from a graveyard or you cast it from a graveyard": "EnteringPermanentPassesFilter(Or([EnteredFromAPlayersGraveyard(AnyPlayer), CastByPlayerFromAnyPlayersGraveyard(You, AnyPlayer)]))"
  },
  "{{Condition(ThatPermanent)}}": {
    "a {{Zombie}}, {{Zombie}}, or spell you controlled dealt damage to it this turn": "PermanentPassesFilter({{ThatPermanent}}, Or([WasDealtDamageByAnyPermanentThisTurn(And([IsCreatureType({{Zombie[0]}}), ControlledByAPlayer(SinglePlayer(You))])), WasDealtDamageByAnyPermanentThisTurn(And([IsCreatureType({{Zombie[1]}}), ControlledByAPlayer(SinglePlayer(You))])), WasDealtDamageBySpellThisTurn(ControlledByAPlayer(SinglePlayer(You)))]))",
    "another creature entered the battlefield under your control this turn": "APermanentEnteredTheBattlefieldUnderPlayersControlThisTurn(And([Other({{ThatPermanent}}), IsCardtype(Creature)]), You)",
    "another permanent with the same name is on the battlefield": "APermanentPassesFilter(And([Other({{ThatPermanent}}), SharesANameWithPermanent({{ThatPermanent}})]), OnTheBattlefield)",
    "another {{Zombie}} died under your control this turn": "ACreatureOrPlaneswalkerDiedThisTurn(And([Other({{ThatPermanent}}), IsCreatureType({{Zombie[0]}}), ControlledByAPlayer(SinglePlayer(You))]))",
    "another {{Zombie}} entered the battlefield under your control this turn": "APermanentEnteredTheBattlefieldUnderPlayersControlThisTurn(And([Other({{ThatPermanent}}), IsCreatureType({{Zombie[0]}})]), You)",
    "another {{Zombie}} or {{a}} {{Swamp}} entered the battlefield under your control this turn": "APermanentEnteredTheBattlefieldUnderPlayersControlThisTurn(Or([And([Other({{ThatPermanent}}), IsCreatureType({{Zombie[0]}})]), IsLandType({{Swamp[0]}})]), You)",
    "he was cast": "PermanentPassesFilter({{ThatPermanent}}, ItWasCast)",
    "it attacked a battle this turn": "PermanentPassesFilter({{ThatPermanent}}, AttackedABattleThisTurn(IsCardtype(Battle)))",
    "it attacked during its controller's last turn": "PermanentPassesFilter({{ThatPermanent}}, AttackedDuringLastPlayersTurn(ItsController))",
    "it attacked during your last turn": "PermanentPassesFilter({{ThatPermanent}}, AttackedDuringLastPlayersTurn(You))",
    "it attacked or blocked since your last upkeep": "PermanentPassesFilter({{ThatPermanent}}, Or([AttackedSincePlayersLastUpkeep(You), BlockedSincePlayersLastUpkeep(You)]))",
    "it attacked or blocked this turn": "PermanentPassesFilter({{ThatPermanent}}, Or([AttackedThisTurn, BlockedThisTurn]))",
    "it attacked this turn": "PermanentPassesFilter({{ThatPermanent}}, AttackedThisTurn)",
    "it came under your control this turn": "PermanentPassesFilter({{ThatPermanent}}, And([ControlledByAPlayer(SinglePlayer(You)), NotControlledSinceBeginningOfTurn]))",
    "it devoured a creature": "PermanentPassesFilter({{ThatPermanent}}, DevouredACreature)",
    "it didn't attack this turn": "PermanentPassesFilter({{ThatPermanent}}, DidntAttackThisTurn)",
    "it doesn't have the same name as another creature you control or a creature card in your graveyard": "PermanentPassesFilter({{ThatPermanent}}, And([DoesntShareANameWithAPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))])), DoesntShareANameWithACardInPlayersGraveyard(IsCardtype(Creature), You)]))",
    "it doesn't have {{CheckHasable}}": "PermanentPassesFilter({{ThatPermanent}}, DoesntHaveAbility({{CheckHasable[0]}}))",
    "it doesn't have {{a}} {{CounterType}} counter on it": "PermanentPassesFilter({{ThatPermanent}}, HasNoCountersOfType({{CounterType[0]}}))",
    "it entered this turn": "PermanentPassesFilter({{ThatPermanent}}, EnteredTheBattlefieldThisTurn)",
    "it had mana value {{Digits}} or less": "PermanentPassesFilter({{ThatPermanent}}, ManaValueIs(LessThanOrEqualTo({{Digits[0]}})))",
    "it has a counter on it": "PermanentPassesFilter({{ThatPermanent}}, HasACounter)",
