    "create a Cursed Role token attached to target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreateTokensWithFlags([CursedRoleToken], [EntersAttachedToPermanent(Ref_TargetPermanent)])]))",
    "create a Food token": "ActionList([CreateTokens([FoodToken])])",
    "create a Food token and exile up to one target card from a graveyard": "Targeted([UptoOneTargetGraveyardCard(InAPlayersGraveyard(SinglePlayer(You)))], ActionList([CreateTokens([FoodToken]), ExileGraveyardCard(Ref_TargetGraveyardCard)]))",
    "create a Food token and {{a}} {{PT}} {{CreatureToken}}": "ActionList([CreateTokens([FoodToken, TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])])",
    "create a Food token for each {{Eachable}}": "ActionList([CreateTokens([NumberTokens({{Eachable[0]}}, FoodToken)])])",
    "create a Food token or a Treasure token": "ActionList([ChooseAnAction([[CreateTokens([FoodToken])], [CreateTokens([TreasureToken])]])])",
    "create a Food token. If {{Condition}}, instead conjure a card named {{NamedCard}} onto the battlefield": "ActionList([IfElse({{Condition[0]}}, [ConjureCardOntoBattlefield({{NamedCard[0]}}, [EntersNormally])], [CreateTokens([FoodToken])])])",
    "create a Food token. When you do, target {{Creature}} gets {{PTMod}} until end of turn for each {{Eachable}}": "ActionList([MustCost(CreateTokens([FoodToken])), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTForEach({{PTMod[0]}}, {{Eachable[0]}})], UntilEndOfTurn)])))])])",
    "create a Junk token": "ActionList([CreateTokens([JunkToken])])",
    "create a Lander token": "ActionList([CreateTokens([LanderToken])])",
    "create a Lander token. At the beginning of the end step on your next turn, sacrifice that token": "ActionList([CreateTokens([LanderToken]), CreateFutureTrigger(AtTheBeginningOfPlayersNextEndStep(You), ActionList([SacrificeEachPermanent(TheTokensCreatedThisWay)]))])",
    "create a Lander token. It becomes {{a}} {{PT}} artifact creature and gains {{Hasable}}": "ActionList([CreateTokens([LanderToken]), CreateEachPermanentLayerEffect(TheTokensCreatedThisWay, [SetPT({{PT[0]}}), AddCardtype(Artifact), AddCardtype(Creature), AddAbility([{{Hasable[0]}}])])])",
    "create a Map token": "ActionList([CreateTokens([MapToken])])",
    "create a Monster Role token attached to up to one target {{Creature}}": "Targeted([UptoOneTargetPermanent({{Creature[0]}})], ActionList([CreateTokensWithFlags([MonsterRoleToken], [EntersAttachedToPermanent(Ref_TargetPermanent)])]))",
    "create a Mutagen token": "ActionList([CreateTokens([MutagenToken])])",
    "create a Tarmogoyf token": "ActionList([CreateTokens([OracleToken(\"Tarmogoyf\")])])",
    "create a Treasure token": "ActionList([CreateTokens([TreasureToken])])",
    "create a Treasure token and {{a}} {{PT}} {{CreatureToken}}": "ActionList([CreateTokens([TreasureToken, TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])])",
    "create a Treasure token for each {{Eachable}}": "ActionList([CreateTokens([NumberTokens({{Eachable[0]}}, TreasureToken)])])",
    "create a Treasure token if {{Condition}}. You gain {{Digits}} life if {{Condition}}. Create {{Number}} {{PT}} {{CreatureTokens}} if {{Condition}}. Draw a card if {{Condition}}": "ActionList([If({{Condition[0]}}, [CreateTokens([TreasureToken])]), If({{Condition[1]}}, [GainLife({{Digits[0]}})]), If({{Condition[2]}}, [CreateTokens([NumberTokens({{Number[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])]), If({{Condition[3]}}, [DrawACard])])",
    "create a Treasure token, then you may sacrifice a noncreature artifact. If you do, search your library for an artifact card with mana value equal to {{Digits}} plus the sacrificed artifact's mana value, put it onto the battlefield tapped, then shuffle": "ActionList([CreateTokens([TreasureToken]), MayCost(SacrificeAPermanent(And([IsNonCardtype(Creature), IsCardtype(Artifact)]))), If(CostWasPaid, [SearchLibrary([FindACardOfType(And([IsCardtype(Artifact), ManaValueIs(EqualTo(Plus({{Digits[0]}}, ManaValueOfTheSacrificedPermanent)))])), PutFoundCardsOntoBattlefield([EntersTapped]), Shuffle])])])",
    "create a Treasure token. Create {{Number}} of those tokens instead if {{Condition}}": "ActionList([IfElse({{Condition[0]}}, [CreateTokens([NumberTokens({{Number[0]}}, TreasureToken)])], [CreateTokens([TreasureToken])])])",
    "create a Treasure token. Then draw a card if {{Condition}}": "ActionList([CreateTokens([TreasureToken]), If({{Condition[0]}}, [DrawACard])])",
    "create a Treasure token. Until end of turn, you may look at the top card of your library any time, and you may play lands and cast spells from the top of your library": "ActionList([CreateTokens([TreasureToken]), CreatePlayerEffectUntil(You, [MayLookAtTopCardOfLibraryAnyTime, MayPlayLandsFromTopOfLibrary(AnyCard), MayCastSpellsFromTopOfLibrary(AnySpell)], UntilEndOfTurn)])",
    "create a Treasure token. When you next cast {{a}} {{Spell}} this turn, copy that spell. You may choose new targets for the copy": "ActionList([CreateTokens([TreasureToken]), CreateFutureTrigger(WhenPlayerCastsTheirNextSpellThisTurn(You, {{Spell[0]}}), ActionList([CopySpellAndMayChooseNewTargets(Trigger_ThatSpell)]))])",
    "create a Wicked Role token attached to target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreateTokensWithFlags([WickedRoleToken], [EntersAttachedToPermanent(Ref_TargetPermanent)])]))",
    "create a Young Hero Role token attached to up to one target {{Creature}}": "Targeted([UptoOneTargetPermanent({{Creature[0]}})], ActionList([CreateTokensWithFlags([YoungHeroRoleToken], [EntersAttachedToPermanent(Ref_TargetPermanent)])]))",
    "create a colorless Book Equipment artifact token named {{NamedCard}} with \"{{TokenQuotedAbility}}\" and equip {{ManaCost}}": "ActionList([CreateTokens([NamedToken({{NamedCard[0]}}, Colorless, [], [Artifact], SubtypesList([Book, Equipment]), [{{TokenQuotedAbility[0]}}, Equip(IsCardtype(Creature), PayMana({{ManaCost[0]}}))])])])",
    "create a colorless Equipment artifact token named {{NamedCard}} with \"{{TokenQuotedAbility}}\" and equip {{ManaCost}}": "ActionList([CreateTokens([NamedToken({{NamedCard[0]}}, Colorless, [], [Artifact], SubtypesList([Equipment]), [{{TokenQuotedAbility[0]}}, Equip(IsCardtype(Creature), PayMana({{ManaCost[0]}}))])])])",
    "create a colorless artifact token named {{NamedCard}}": "ActionList([CreateTokens([NamedToken({{NamedCard[0]}}, Colorless, [], [Artifact], SubtypesList([]), [])])])",
    "create a number of Food tokens equal to {{GameNumber}}": "ActionList([CreateTokens([NumberTokens({{GameNumber[0]}}, FoodToken)])])",
    "create a number of Treasure tokens equal to the number of artifacts and enchantments your opponents control. If they control fewer than four artifacts and enchantments, create four Treasure tokens instead": "ActionList([CreateTokens([NumberTokens(MaximumOf(Integer(4), TheNumberOfPermanentsOnTheBattlefield(And([Or([IsCardtype(Artifact), IsCardtype(Enchantment)]), ControlledByAPlayer(Opponent)]))), TreasureToken)])])",
    "create a number of {{PT}} {{CreatureTokens}} equal to the number of counters among creatures target player controls": "Targeted([TargetPlayer(AnyPlayer)], ActionList([CreateTokens([NumberTokens(TheTotalNumberOfCountersOnPermanents(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))])), TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])]))",
    "create a number of {{PT}} {{CreatureTokens}} equal to {{GameNumber}}": "ActionList([CreateTokens([NumberTokens({{GameNumber[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])])",
    "create a number of {{PT}} {{CreatureTokens}} with {{Hasable}} equal to {{GameNumber}}": "ActionList([CreateTokens([NumberTokens({{GameNumber[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}]))])])",
