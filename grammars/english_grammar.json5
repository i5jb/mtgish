    "Prevent all combat damage that would be dealt by target {{Creature}} this turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePreventDamageUntil(CombatDamageWouldBeDealtByCreature(Ref_TargetPermanent), [PreventThatDamage], UntilEndOfTurn)]))",
