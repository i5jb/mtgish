    "return {{a}} {{Permanent}} to its owner's hand": "ActionList([PutAPermanentIntoItsOwnersHand({{Permanent[0]}})])",
    "return {{a}} {{Permanent}} to its owner's hand. If it's {{a}} {{CreatureCard}}, it perpetually gets {{PTMod}}, gains {{Hasable}}, and becomes {{a}} {{Zombie}} in addition to its other types": "ActionList([PutAPermanentIntoItsOwnersHand({{Permanent[0]}}), If(TheCardReturnedToHandThisWayPassesFilter({{CreatureCard[0]}}), [CreatePerpetualCardInHandEffect(TheCardReturnedToHandThisWay, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}]), AddCreatureType({{Zombie[0]}})])])])",
    "return {{a}} {{SpecificCard}} at random from your graveyard to your hand": "ActionList([ReturnACardFromGraveyardToHandAtRandom({{SpecificCard[0]}})])",
    "return {{a}} {{SpecificCard}} from your graveyard to your hand or unlock a locked door of a Room you control": "ActionList([ChooseAnAction([[PutACardFromGraveyardIntoHand({{SpecificCard[0]}})], [UnlockADoorOfAPermanent(And([IsEnchantmentType(Room), ControlledByAPlayer(SinglePlayer(You))]))]])])",
    "reveal cards from the top of your library until you reveal X nonland cards, where X is the number of colors among permanents you control. For each of those colors, you may exile a card of that color from among the revealed cards. Then shuffle. You may cast the exiled cards this turn": "ActionList([RevealCardsFromTheTopOfLibraryUntilANumberOfCardsOfTypeAreRevealed(NumColorsAmongPermanents(And([IsPermanent, ControlledByAPlayer(SinglePlayer(You))])), IsNonCardtype(Land), [ForEachColorAmongPermanentsYouMayExileACardOfThatColorFoundThisWay(And([IsPermanent, ControlledByAPlayer(SinglePlayer(You))])), PutTheRemainingCardsBackIntoLibraryAndShuffle]), CreatePlayerEffectUntil(You, [MayCastSpellsFromAmongExiled(AnySpell, TheCardsExiledThisWay)], UntilEndOfTurn)])",
    "reveal cards from the top of your library until you reveal X permanent cards, where X is {{GameNumber}}. Put any number of those permanent cards onto the battlefield, then put the rest of the revealed cards on the bottom of your library in a random order": "ActionList([RevealCardsFromTheTopOfLibraryUntilANumberOfCardsOfTypeAreRevealed({{GameNumber[0]}}, IsPermanent, [PutAnyNumberOfFoundCardsOntoBattlefield([EntersNormally]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "reveal cards from the top of your library until you reveal {{a}} {{SpecificCard}}. Exile that card with {{Number}} {{CounterType}} counters on it. If it doesn't have suspend, it gains suspend. Put the rest of the revealed cards on the bottom of your library in a random order": "ActionList([RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed({{SpecificCard[0]}}, [ExileTheCardFoundThisWayWithNumberCountersOfType({{Number[0]}}, {{CounterType[0]}}), CreateExiledCardEffect(TheCardExiledThisWay, [AddAbilityIfItDoesntHaveIt([BasicSuspend])]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "reveal cards from the top of your library until you reveal {{a}} {{SpecificCard}}. Put that card into your hand and the rest on the bottom of your library in a random order": "ActionList([RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed({{SpecificCard[0]}}, [PutTheCardFoundThisWayIntoHand, PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "reveal cards from the top of your library until you reveal {{a}} {{SpecificCard}}. Put that card onto the battlefield and the rest on the bottom of your library in a random order": "ActionList([RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed({{SpecificCard[0]}}, [PutTheCardFoundThisWayOntoTheBattlefield([EntersNormally]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "reveal cards from the top of your library until you reveal {{a}} {{SpecificCard}}. Put that card onto the battlefield tapped and attacking and the rest on the bottom of your library in a random order": "ActionList([RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed({{SpecificCard[0]}}, [PutTheCardFoundThisWayOntoTheBattlefield([EntersTapped, EntersAttacking]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
