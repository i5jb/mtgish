    "Search your library for {{a}} {{SpecificCard}}, put it onto the battlefield tapped, then shuffle. Bolster {{Digits}}": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersTapped]), Shuffle]), Bolster({{Digits[0]}})])",
    "Search your library for {{a}} {{SpecificCard}}, put it onto the battlefield tapped, then shuffle. Create {{a}} {{PT}} {{CreatureToken}}. It has \"{{TokenQuotedAbility}}\"": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersTapped]), Shuffle]), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{TokenQuotedAbility[0]}}])])])",
    "Search your library for {{a}} {{SpecificCard}}, put it onto the battlefield tapped, then shuffle. Investigate": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersTapped]), Shuffle]), Investigate])",
    "Search your library for {{a}} {{SpecificCard}}, put it onto the battlefield tapped, then shuffle. Open an Attraction": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersTapped]), Shuffle]), OpenAnAttraction])",
    "Search your library for {{a}} {{SpecificCard}}, put it onto the battlefield tapped, then shuffle. Then if {{Condition}}, create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}}": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersTapped]), Shuffle]), If({{Condition[0]}}, [CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])])])])",
    "Search your library for {{a}} {{SpecificCard}}, put it onto the battlefield, then shuffle": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}}, put it onto the battlefield, then shuffle.\nEpic": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle]), Epic])",
    "Search your library for {{a}} {{SpecificCard}}, put it onto the battlefield, then shuffle. It gains {{Hasable}} until your next turn": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle]), CreatePermanentLayerEffectUntil(ThePermanentPutOnTheBattlefieldThisWay, [AddAbility([{{Hasable[0]}}])], UntilPlayersNextTurn(You))])",
