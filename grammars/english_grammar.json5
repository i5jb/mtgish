    "Gain control of all {{Permanents}} until end of turn. Untap them. They gain {{Hasable}} until end of turn": "ActionList([GainControlOfEachPermanent({{Permanents[0]}}), UntapEachPermanent(ThePermanentsGainedControlOfThisWay), CreateEachPermanentLayerEffectUntil(ThePermanentsGainedControlOfThisWay, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "Gain control of any number of target {{Creatures}} until end of turn. Untap those creatures. They gain {{Hasable}} until end of turn": "Targeted([AnyNumberOfTargetPermanents({{Creatures[0]}})], ActionList([GainControlOfEachPermanentUntil(Ref_TargetPermanents, UntilEndOfTurn), UntapEachPermanent(Ref_TargetPermanents), CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Gain control of each {{Permanent}}": "ActionList([GainControlOfEachPermanent({{Permanent[0]}})])",
    "Gain control of target Aura that's attached to a permanent. Attach it to another permanent it can enchant": "Targeted([TargetPermanent(And([IsEnchantmentType(Aura), AttachedToAPermanent(AnyPermanent)]))], ActionList([AttachPermanentToAPermanent(Ref_TargetPermanent, Other(HostPermanentOf(Ref_TargetPermanent)))]))",
    "Gain control of target creature until end of turn. If you control {{a}} {{Zombie}} with greater mana value than that creature, gain control of that creature until the end of your next turn instead. Untap that creature. It gains {{Hasable}} until end of turn":
      "Targeted([TargetPermanent(IsCardtype(Creature))], ActionList([IfElse(PlayerPassesFilter(You, ControlsA(And([IsCreatureType({{Zombie[0]}}), ManaValueIs(GreaterThan(ManaValueOfPermanent(Ref_TargetPermanent)))]))), [GainControlOfPermanentUntil(Ref_TargetPermanent, UntilPlayersNextTurn(You))], [GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn)]), UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Gain control of target {{Artifact}} until end of turn. Untap that artifact. It gains {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Artifact[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Gain control of target {{Artifact}}, then create {{a}} {{PT}} {{CreatureToken}} and attach that {{Artifact}} to it": "Targeted([TargetPermanent({{Artifact[0]}})], ActionList([GainControlOfPermanent(Ref_TargetPermanent), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])]), AttachPermanentToPermanent(Ref_TargetPermanent, TheCreatedToken)]))",
    "Gain control of target {{Creature}} if its power is less than or equal to {{GameNumber[ThisSpell]}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([If(PermanentPassesFilter(Ref_TargetPermanent, PowerIs(LessThanOrEqualTo({{GameNumber[ThisSpell][0]}}))), [GainControlOfPermanent(Ref_TargetPermanent)])]))",
    "Gain control of target {{Creature}} until end of turn. Put {{a}} {{CounterType}} counter on it and untap it. That creature gains {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent), UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Gain control of target {{Creature}} until end of turn. Untap that creature. It gains {{Hasable}} and {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)]))",
    "Gain control of target {{Creature}} until end of turn. Untap that creature. It gains {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), UntapPermanent(Ref_TargetPermanent)]))",
    "Gain control of target {{Creature}} until end of turn. Untap that creature. It gains {{Hasable}} until end of turn.\nCreate a Wicked Role token attached to up to one target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}}), UptoOneTargetPermanent({{Creature[1]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), CreateTokensWithFlags([WickedRoleToken], [EntersAttachedToPermanent(Ref_TargetPermanent)])]))",
    "Gain control of target {{Creature}} until end of turn. Untap that creature. It gains {{Hasable}} until end of turn. Add {{Number}} mana of any one color": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), AddManaRepeated(AnyManaColor, {{Number[0]}})]))",
    "Gain control of target {{Creature}} until end of turn. Untap that creature. It gains {{Hasable}} until end of turn. Create a Blood token": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), CreateTokens([BloodToken])]))",
    "Gain control of target {{Creature}} until end of turn. Untap that creature. It gains {{Hasable}} until end of turn. Create a Treasure token": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), CreateTokens([TreasureToken])]))",
    "Gain control of target {{Creature}} until end of turn. Untap that creature. It gains {{Hasable}} until end of turn. If it's equipped, you may destroy all Equipment attached to that creature": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), If(PermanentPassesFilter(Ref_TargetPermanent, IsEquipped), [MayAction(DestroyEachPermanent(And([IsArtifactType(Equipment), AttachedToPermanent(Ref_TargetPermanent)])))])]))",
    "Gain control of target {{Creature}} until end of turn. Untap that creature. It gains {{Hasable}} until end of turn. If {{Condition(ThatPermanent)}}, it also gets {{PTMod}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), If({{Condition(ThatPermanent=Ref_TargetPermanent)[0]}}, [CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])]))",
    "Gain control of target {{Creature}} until end of turn. Untap that creature. It gains {{Hasable}} until end of turn. If {{Condition}}, scry {{Digits}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), UntapPermanent(Ref_TargetPermanent), If({{Condition[0]}}, [Scry({{Digits[0]}})])]))",
    "Gain control of target {{Creature}} until end of turn. Untap that creature. It gains {{Hasable}} until end of turn. It perpetually gains \"{{PerpetualQuotedAbility}}\"": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), CreatePerpetualPermanentEffect(Ref_TargetPermanent, [AddAbility([{{PerpetualQuotedAbility[0]}}])])]))",
    "Gain control of target {{Creature}} until end of turn. Untap that creature. It gains {{Hasable}} until end of turn. Scry {{Digits}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), UntapPermanent(Ref_TargetPermanent), Scry({{Digits[0]}})]))",
    "Gain control of target {{Creature}} until end of turn. Untap that creature. It gains {{Hasable}} until end of turn. Suspect it": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), UntapPermanent(Ref_TargetPermanent), SuspectPermanent(Ref_TargetPermanent)]))",
    "Gain control of target {{Creature}} until end of turn. Untap that creature. It gains {{Hasable}} until end of turn. You may attach {{a}} {{Permanent}} to that creature. If you do, unattach it at the beginning of the next end step": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), UntapPermanent(Ref_TargetPermanent), MayCost(AttachAPermanentToPermanent({{Permanent[0]}}, Ref_TargetPermanent)), If(CostWasPaid, [CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([UnattachPermanent(ThePermanentAttachedThisWay)]))])]))",
    "Gain control of target {{Creature}} until end of turn. Untap that creature. It gets {{PTMod}} and gains {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Gain control of target {{Creature}} until end of turn. Untap that creature. It perpetually gains {{PerpetualHasable}}, \"{{PerpetualQuotedAbility}}\", and \"{{PerpetualQuotedAbility}}\"": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), UntapPermanent(Ref_TargetPermanent), CreatePerpetualPermanentEffect(Ref_TargetPermanent, [AddAbility([{{PerpetualHasable[0]}}]), AddAbility([{{PerpetualQuotedAbility[0]}}]), AddAbility([{{PerpetualQuotedAbility[1]}}])])]))",
    "Gain control of target {{Creature}} until end of turn. Untap that creature. Until end of turn, it gains {{Hasable}} and \"{{QuotedAbility}}\"": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}]), AddAbility([{{QuotedAbility[0]}}])], UntilEndOfTurn)]))",
    "Gain control of target {{Creature}} until end of turn. Untap that creature. Until end of turn, it gets {{PTMod}} and gains {{Hasable}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Gain control of target {{Creature}}. Change the text of that creature by replacing all instances of one creature type with {{Zombie}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([GainControlOfPermanent(Ref_TargetPermanent), ChooseACreatureType, CreatePermanentLayerEffect(Ref_TargetPermanent, [ReplaceCreatureTypeVariableWithNewCreatureType(TheChosenCreatureType, {{Zombie[0]}})])]))",
    "Gain control of target {{Creature}}. Untap that creature. It gains {{Hasable}} until end of turn. Sacrifice it at the beginning of the next end step": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([GainControlOfPermanent(Ref_TargetPermanent), UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([SacrificePermanent(Ref_TargetPermanent)]))]))",
    "Gain control of target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([GainControlOfPermanent(Ref_TargetPermanent)]))",
    "Gain control of target {{Permanent}} and put {{a}} {{CounterType}} counter on it": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([GainControlOfPermanent(Ref_TargetPermanent), PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent)]))",
    "Gain control of target {{Permanent}} of an opponent's choice they control": "Targeted([TargetPermanentOfAPlayersChoiceTheyControl({{Permanent[0]}}, Opponent)], ActionList([GainControlOfPermanent(Ref_TargetPermanent)]))",
    "Gain control of target {{Permanent}} until end of turn. Untap it. It gains {{Hasable}} and {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)]))",
    "Gain control of target {{Permanent}} until end of turn. Untap it. It gains {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Gain control of target {{Permanent}} until end of turn. Untap it. It gains {{Hasable}} until end of turn.\nYou may cast {{a}} {{PotentialSpell}} from your hand without paying its mana cost": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), MayAction(CastASpellFromHandWithoutPaying({{PotentialSpell[0]}}))]))",
    "Gain control of target {{Permanent}} until end of turn. Untap it. It gains {{Hasable}} until end of turn. Create a tapped Powerstone token": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), CreateTokensWithFlags([PowerstoneToken], [EntersTapped])]))",
    "Gain control of target {{Permanent}} until end of turn. Untap it. It gains {{Hasable}} until end of turn. You may discard a card. If you do, draw a card": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), MayCost(DiscardACard), If(CostWasPaid, [DrawACard])]))",
    "Gain control of target {{Permanent}} until end of turn. Untap that permanent. It gains {{Hasable}} until end of turn. If it's a Spacecraft, put {{Number}} {{CounterType}} counters on it. If you do, remove {{Number}} {{CounterType}} counters from it at the beginning of the next end step": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn), UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), If(PermanentPassesFilter(Ref_TargetPermanent, IsArtifactType(Spacecraft)), [PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[0]}}, Ref_TargetPermanent), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([RemoveNumberCountersOfTypeFromPermanent({{Number[0]}}, {{CounterType[0]}}, Ref_TargetPermanent)]))])]))",
    "Gain control of target {{Permanent}}. Untap it": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([GainControlOfPermanent(Ref_TargetPermanent), UntapPermanent(Ref_TargetPermanent)]))",
    "Gain control of target {{Permanent}}. Untap it. It gains {{Hasable}}. At the beginning of the next end step, sacrifice it": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([GainControlOfPermanent(Ref_TargetPermanent), UntapPermanent(Ref_TargetPermanent), CreatePermanentLayerEffect(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([SacrificePermanent(RefOuter_TargetPermanent)]))]))",
    "Gain control of target {{Permanent}}. {{Permanents}} don't untap during your next untap step": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([GainControlOfPermanent(Ref_TargetPermanent), CreateEachPermanentRuleEffectUntil({{Permanents[0]}}, [DoesntUntapDuringControllersUntap], DuringPlayersNextUntapStep(You))]))",
    "Gain control of target {{Spell}}. Copy it, then reselect the targets at random for the spell and the copy. The new targets can't be you or a permanent you control": "Targeted([TargetSpell({{Spell[0]}})], ActionList([GainControlOfSpellAndRandomlyChooseNewTargetsExceptFor(Ref_TargetSpell, APlayerOrAPermanent(SinglePlayer(You), ControlledByAPlayer(SinglePlayer(You)))), CopySpellAndRandomlyChooseNewTargetsExceptFor(Ref_TargetSpell, APlayerOrAPermanent(SinglePlayer(You), ControlledByAPlayer(SinglePlayer(You))))]))",
    "Gain control of target {{Spell}}. You may choose new targets for it": "Targeted([TargetSpell({{Spell[0]}})], ActionList([GainControlOfSpellAndMayChooseNewTargets(Ref_TargetSpell)]))",
    "Goad all {{Creatures}}": "ActionList([GoadEachCreature({{Creatures[0]}})])",
    "Goad all {{Creatures}}. Until your next turn, those creatures can't block": "ActionList([GoadEachCreature({{Creatures[0]}}), CreateEachPermanentRuleEffectUntil(WasGoadedThisWay, [CantBlock], UntilPlayersNextTurn(You))])",
    "Goad each {{Creature}} target player controls": "Targeted([TargetPlayer(AnyPlayer)], ActionList([GoadEachCreature(And([{{Creature[0]}}, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]))]))",
    "Heist target opponent's library": "Targeted([TargetPlayer(Opponent)], ActionList([HeistPlayersLibrary(Ref_TargetPlayer)]))",
    "If any {{DamageSource}} would deal {{Digits}} or more damage to a permanent or player this turn, it deals {{Digits}} damage to that permanent or player instead.\nDraw a card": "ActionList([CreateReplaceWouldDealDamageUntil(AnAmountOfDamageWouldBeDealtByASourceToARecipient(GreaterThanOrEqualTo({{Digits[0]}}), {{DamageSource[0]}}, APlayerOrAPermanent(AnyPlayer, AnyPermanent)), [DealDamageInstead({{Digits[1]}})], UntilEndOfTurn), DrawACard])",
    "If at least {{Number}} {{Black}} mana was spent to cast this spell, mill {{Number}} cards.\nYou may choose {{a}} {{SpecificCard}} in your graveyard. If you do, return it to the battlefield with an additional {{CounterType}} counter on it": "ActionList([If(CastSpellPassesFilter(ManaAmountOfTypeWasSpentToCastIt(GreaterThanOrEqualTo({{Number[0]}}), {{Black[0]}})), [MillNumberCards({{Number[0]}})]), MayCost(ChooseACardInPlayersGraveyard({{SpecificCard[0]}}, You)), If(CostWasPaid, [PutGraveyardCardOntoBattlefield(TheChosenGraveyardCard, [EntersWithACounter({{CounterType[0]}})])])])",
    "If target opponent has more cards in hand than you, draw cards equal to the difference": "Targeted([TargetPlayer(Opponent)], ActionList([If(PlayerPassesFilter(Ref_TargetPlayer, NumCardsInHandIs(GreaterThan(TheNumberOfCardsInPlayersHand(You)))), [DrawNumberCards(Minus(TheNumberOfCardsInPlayersHand(Ref_TargetPlayer), TheNumberOfCardsInPlayersHand(You)))])]))",
    "If target {{Creature}} has toughness {{Digits}} or greater, it gets {{PTMod}} until end of turn. Otherwise, it gets {{PTModX}} until end of turn, where X is its toughness minus {{Digits}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([IfElse(PermanentPassesFilter(Ref_TargetPermanent, ToughnessIs(GreaterThanOrEqualTo({{Digits[0]}}))), [CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)], [CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTX({{PTModX[0]}}, Minus(ToughnessOfPermanent(ActionPermanent), {{Digits[1]}}))], UntilEndOfTurn)])]))",
    "If target {{Spell}} has only one target and that target is {{a}} {{Creature}}, change that spell's target to another creature": "Targeted([TargetSpell({{Spell[0]}})], ActionList([If(SpellPassesFilter(Ref_TargetSpell, TargetsOnlyASinglePermanent({{Creature[0]}})), [ChangeTheTargetOfSpellToAPermanent(Ref_TargetSpell, And([Other(SingleTargetPermanentOfSpell(Ref_TargetSpell)), IsCardtype(Creature)]))])]))",
    "If the difference between your life total and target player's life total is {{Digits}} or less, exchange life totals with that player": "Targeted([TargetPlayer(AnyPlayer)], ActionList([If(DifferenceIs(LifeTotalOfPlayer(You), LifeTotalOfPlayer(Ref_TargetPlayer), LessThanOrEqualTo({{Digits[0]}})), [ExchangeLifeTotalWithPlayer(Ref_TargetPlayer)])]))",
    "If you control {{Number}} or more {{Zombies}} with different names, conjure each card from {{Spellbook}} onto the battlefield. If you control {{Number}} or fewer {{Zombies}} with different names, conjure {{Number}} cards of your choice from {{Spellbook}} into your hand, then put one of them onto the battlefield": "ActionList([If(PlayerPassesFilter(You, ControlsNum(GreaterThanOrEqualTo({{Number[0]}}), IsCreatureType({{Zombies[0]}}))), [ConjureEachCardFromSpellBookOntoTheBattlefield({{Spellbook[0]}}, [EntersNormally])]), If(PlayerPassesFilter(You, ControlsNum(LessThanOrEqualTo({{Number[1]}}), IsCreatureType({{Zombies[1]}}))), [ConjureNumberCardsOfChoiceFromSpellBookIntoHand({{Number[2]}}, {{Spellbook[1]}}), PutACardFromHandOnBattlefield(TheCardsConjuredIntoHandThisWay, [EntersNormally])])])",
    "If {{Condition}}, create {{Number}} {{PT}} {{CreatureTokens}}. They have \"{{TokenQuotedAbility}}\". Otherwise, create one of those tokens": "ActionList([IfElse({{Condition[0]}}, [CreateTokens([NumberTokens({{Number[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{TokenQuotedAbility[0]}}]))])], [CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{TokenQuotedAbility[0]}}])])])])",
    "If {{Condition}}, destroy target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([If({{Condition[0]}}, [DestroyPermanent(Ref_TargetPermanent)])]))",
    "If {{Condition}}, draft a card from {{Spellbook}}": "ActionList([If({{Condition[0]}}, [DraftACardFromSpellBook({{Spellbook[0]}})])])",
    "If {{Condition}}, draw {{Number}} cards. Draw {{Number}} cards instead if {{Condition}}": "ActionList([If({{Condition[0]}}, [IfElse({{Condition[1]}}, [DrawNumberCards({{Number[1]}})], [DrawNumberCards({{Number[0]}})])])])",
    "If {{Condition}}, each {{Creature}} gets {{PTMod}} until end of turn": "ActionList([If({{Condition[0]}}, [CreateEachPermanentLayerEffectUntil({{Creature[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])])",
    "If {{Condition}}, search your library for up to {{Number}} {{SpecificCards}}, reveal them, put them into your hand, then shuffle": "ActionList([If({{Condition[0]}}, [SearchLibrary([FindNumberCardsOfType({{Number[0]}}, {{SpecificCards[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])])",
    "If {{Condition}}, search your library for {{a}} {{SpecificCard}}, put it onto the battlefield tapped, then shuffle": "ActionList([If({{Condition[0]}}, [SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersTapped]), Shuffle])])])",
    "If {{Condition}}, seek {{a}} {{SpecificCard}} and {{a}} {{SpecificCard}}. Otherwise, seek {{Number}} {{SpecificCards}}": "ActionList([IfElse({{Condition[0]}}, [SeekCards([{{SpecificCard[0]}}, {{SpecificCard[1]}}])], [SeekNumberCards({{Number[0]}}, {{SpecificCards[0]}})])])",
    "If {{Condition}}, you gain {{Digits}} life": "ActionList([If({{Condition[0]}}, [GainLife({{Digits[0]}})])])",
    "If {{Condition}}, you gain {{Digits}} life.\nIf {{Condition}}, create {{Number}} {{PT}} {{CreatureTokens}}.\nIf {{Condition}}, draw a card": "ActionList([If({{Condition[0]}}, [GainLife({{Digits[0]}})]), If({{Condition[1]}}, [CreateTokens([NumberTokens({{Number[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])]), If({{Condition[0]}}, [DrawACard])])",
    "If {{Condition}}, you gain {{Digits}} life. If {{Condition}}, create {{Number}} {{PT}} {{CreatureTokens}}": "ActionList([If({{Condition[0]}}, [GainLife({{Digits[0]}})]), If({{Condition[1]}}, [CreateTokens([NumberTokens({{Number[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])])])",
    "If {{Condition}}, {{Creatures}} can't block this turn": "ActionList([If({{Condition[0]}}, [CreateGameEffect(UntilEndOfTurn, CreaturesCantBlock)])])",
    "If {{a}} {{Permanent}} would be put into a graveyard from the battlefield this turn, exile it instead. Return it to the battlefield under its owner's control at the beginning of the next end step": "ActionList([CreateReplaceWouldPutIntoGraveyardUntil(WouldPutAPermanentIntoAPlayersGraveyard({{Permanent[0]}}, AnyPlayer), [ExileItInstead, CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersUnderOwnersControl])]))], UntilEndOfTurn)])",
    "If {{a}} {{Permanent}} would enter the battlefield under an opponent's control this turn, it enters under your control instead": "ActionList([CreateReplaceWouldEnterUntil(APermanentWouldEnterTheBattlefieldUnderAPlayersControl({{Permanent[0]}}, Opponent), [EntersUnderPlayersControl(You)], UntilEndOfTurn)])",
    "Incubate X twice, where X is {{GameNumber}}": "ActionList([IncubateNumberTimes(Integer(2), {{GameNumber[0]}})])",
    "Incubate {{Digits}}, then transform {{a}} {{Permanent}}": "ActionList([Incubate({{Digits[0]}}), TransformAPermanent({{Permanent[0]}})])",
    "Incubate {{Digits}}. {{Reminder}}\nDraw a card": "ActionList([Incubate({{Digits[0]}}), DrawACard])",
    "Investigate": "ActionList([Investigate])",
    "Investigate, then target {{Creature}} gets {{PTMod}} until end of turn for each {{Eachable}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([Investigate, CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTForEach({{PTMod[0]}}, {{Eachable[0]}})], UntilEndOfTurn)]))",
    "Investigate. You may play an additional land this turn": "ActionList([Investigate, CreatePlayerEffectUntil(You, [MayPlayAnAdditionalLand], UntilEndOfTurn)])",
    "Investigate. {{Permanents}} get {{PTMod}} until end of turn. If any of them are suspected, they're no longer suspected": "ActionList([Investigate, CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), UnsuspectEachPermanent({{Permanents[0]}})])",
    "It becomes night. Discard any number of cards, then draw that many cards plus {{Number}}": "ActionList([BecomeNight, DiscardAnyNumberOfCards, DrawNumberCards(Plus(NumCardsDiscardedThisWay, {{Number[0]}}))])",
    "It becomes night. Until end of turn, target {{Creature}} gets {{PTMod}} and gains {{Hasable}} and \"{{QuotedAbility}}\"": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([BecomeNight, CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}]), AddAbility([{{QuotedAbility[0]}}])], UntilEndOfTurn)]))",
    "Look at target opponent's hand and choose a card from it. Put that card on top of that player's library": "Targeted([TargetPlayer(Opponent)], ActionList([LookAtPlayersHand(Ref_TargetPlayer), ChooseACardFromPlayersRevealedHand(AnyCard, Ref_TargetPlayer), PlayerAction(Ref_TargetPlayer, PutCardFromHandOnTopOfLibrary(TheChosenCardInHand))]))",
    "Look at target opponent's hand.\nDraw a card": "Targeted([TargetPlayer(Opponent)], ActionList([LookAtPlayersHand(Ref_TargetPlayer), DrawACard]))",
    "Look at target player's hand and choose up to {{Number}} cards from it. That player discards those cards": "Targeted([TargetPlayer(AnyPlayer)], ActionList([LookAtPlayersHand(Ref_TargetPlayer), ChooseUptoNumberCardsFromAmongCardsInPlayersHandRevealedThisWay({{Number[0]}}, AnyCard, Ref_TargetPlayer), PlayerAction(Ref_TargetPlayer, DiscardCards(TheChosenCardsInHand))]))",
    "Look at target player's hand and choose {{Number}} cards from it. Put them on top of that player's library in any order": "Targeted([TargetPlayer(AnyPlayer)], ActionList([LookAtPlayersHandAndChooseNumberCardsToPutOnTopOfTheirLibraryInAnyOrder(Ref_TargetPlayer, {{Number[0]}}, AnyCard)]))",
    "Look at target player's hand, the top card of that player's library, and any face-down creatures they control. Look at the top {{Number}} cards of your library, then put them back in any order": "Targeted([TargetPlayer(AnyPlayer)], ActionList([LookAtPlayersHand(Ref_TargetPlayer), LookAtTheTopCardOfPlayersLibrary(Ref_TargetPlayer), LookAtEachFaceDownPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))])), LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [PutTheRemainingCardsOnTopOfLibraryInAnyOrder])]))",
    "Look at target player's hand.\nDraw a card": "Targeted([TargetPlayer(AnyPlayer)], ActionList([LookAtPlayersHand(Ref_TargetPlayer), DrawACard]))",
    "Look at target player's hand.\nDraw a card at the beginning of the next turn's upkeep": "Targeted([TargetPlayer(AnyPlayer)], ActionList([LookAtPlayersHand(Ref_TargetPlayer), CreateFutureTrigger(AtTheBeginningOfTheNextTurnsUpkeep, ActionList([DrawACard]))]))",
    "Look at the top X cards of your library, where X is twice {{GameNumber}}. Put one of them into your hand and the rest on the bottom of your library in a random order": "ActionList([LookAtTheTopNumberCardsOfLibrary(Twice({{GameNumber[0]}}), [PutAGenericCardIntoHand, PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "Look at the top X cards of your library, where X is {{GameNumber[ThisSpell]}}. Put {{Number}} of them into your hand and the rest on the bottom of your library in a random order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{GameNumber[ThisSpell][0]}}, [PutNumberGenericCardsIntoHand({{Number[0]}}), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "Look at the top X cards of your library, where X is {{GameNumber}}. Put one of those cards into your hand and the rest on the bottom of your library in any order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{GameNumber[0]}}, [PutAGenericCardIntoHand, PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder])])",
    "Look at the top X cards of your library, where X is {{GameNumber}}. Put up to {{Number}} of them into your hand and the rest into your graveyard. You lose {{Digits}} life": "ActionList([CreateValueX({{GameNumber[0]}}), LookAtTheTopNumberCardsOfLibrary(ValueX, [PutUptoNumberGenericCardsIntoHand({{Number[0]}}), PutTheRemainingCardsIntoGraveyard]), LoseLife({{Digits[0]}})])",
    "Look at the top X cards of your library, where X is {{GameNumber}}. You may reveal {{a}} {{SpecificCard}} from among them and put it into your hand. Put the rest on the bottom of your library in a random order": "ActionList([LookAtTheTopNumberCardsOfLibrary({{GameNumber[0]}}, [MayRevealACardOfTypeAndPutIntoHand({{SpecificCard[0]}}), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "Look at the top X cards of your library, where X is {{Number}} plus {{GameNumber}}. Put {{Number}} of those cards into your hand and the rest on the bottom of your library in a random order": "ActionList([LookAtTheTopNumberCardsOfLibrary(Plus({{Number[0]}}, {{GameNumber[0]}}), [PutNumberGenericCardsIntoHand({{Number[1]}}), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "Look at the top card of target player's library. You may put that card into their graveyard": "Targeted([TargetPlayer(AnyPlayer)], ActionList([LookAtTheTopCardOfPlayersLibrary(Ref_TargetPlayer), MayAction(PutTheTopCardOfPlayersLibraryInGraveyard(Ref_TargetPlayer))]))",
    "Look at the top card of your library. You may put it onto the battlefield if it's {{a}} {{SpecificCard}}. If you don't, put it into your hand": "ActionList([LookAtTopOfLibrary, MayCost(PutTopCardOfLibraryOfTypeOnBattlefield({{SpecificCard[0]}}, [EntersNormally])), Unless(CostWasPaid, [PutTopOfLibraryInHand])])",
    "Look at the top three cards of your library. Put one of them into your hand, put one of them on the bottom of your library, and exile one of them. You may play the exiled card this turn": "ActionList([LookAtTheTopNumberCardsOfLibrary(Integer(3), [PutAGenericCardIntoHand, PutAGenericCardOnBottomOfLibrary, ExileTheRemainingCards]), CreatePlayerEffectUntil(You, [MayPlayExiledCard(TheCardExiledThisWay)], UntilEndOfTurn)])",
    "Look at the top three cards of your library. Put one of those cards into your hand, one into your graveyard, and one on the bottom of your library": "ActionList([LookAtTheTopNumberCardsOfLibrary(Integer(3), [PutAGenericCardIntoHand, PutAGenericCardIntoGraveyard, PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder])])",
    "Look at the top three cards of your library. Put one of those cards into your hand, one on top of your library, and one on the bottom of your library": "ActionList([LookAtTheTopNumberCardsOfLibrary(Integer(3), [PutAGenericCardIntoHand, PutAGenericCardOnTopOfLibrary, PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder])])",
    "Look at the top two cards of target opponent's library. Exile one of them face down and put the other on the bottom of that library. You may play the exiled card for as long as it remains exiled, and you may spend mana as though it were mana of any color to cast that spell": "Targeted([TargetPlayer(Opponent)], ActionList([LookAtTheTopNumberCardsOfPlayersLibrary(Ref_TargetPlayer, Integer(2), [ExileAGenericCardFaceDown, PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder]), CreatePlayerEffectUntil(You, [MayPlayExiledCardAndMaySpendManaAsThoughAnyColorToCast(TheCardExiledThisWay)], UntilCardIsNoLongerExiled(TheCardExiledThisWay))]))",
    "Look at the top two cards of your library. Put one of them into your hand and the other on the bottom of your library": "ActionList([LookAtTheTopNumberCardsOfLibrary(Integer(2), [PutAGenericCardIntoHand, PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder])])",
    "Look at the top {{Number}} cards of target opponent's library and exile those cards face down. You may play those cards for as long as they remain exiled, and mana of any type can be spent to cast them. Create a Treasure token": "Targeted([TargetPlayer(Opponent)], ActionList([LookAtTheTopNumberCardsOfPlayersLibrary(Ref_TargetPlayer, {{Number[0]}}, [ExileTheRemainingCardsFaceDown]), CreatePlayerEffectUntil(You, [MayPlayExiledCardsAndMaySpendManaAsThoughAnyTypeToCast(TheCardsExiledThisWay)], UntilCardsAreNoLongerExiled(TheCardsExiledThisWay)), CreateTokens([TreasureToken])]))",
