    "Put {{a}} {{CounterType}} counter on each of up to {{Number}} target {{Permanents}}": "Targeted([UptoNumberTargetPermanents({{Number[0]}}, {{Permanents[0]}})], ActionList([PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, Ref_TargetPermanents)]))",
    "Put {{a}} {{CounterType}} counter on each of up to {{Number}} target {{Permanents}}. You gain {{Digits}} life": "Targeted([UptoNumberTargetPermanents({{Number[0]}}, {{Permanents[0]}})], ActionList([PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, Ref_TargetPermanents), GainLife({{Digits[0]}})]))",
    "Put {{a}} {{CounterType}} counter on each other creature you control. Those creatures gain {{Hasable}} until end of turn": "ActionList([PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, And([Other(ThisPermanent), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))])), CreateEachPermanentLayerEffectUntil(HadCountersPutOnItThisWay, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "Put {{a}} {{CounterType}} counter on each {{Creature}}. Those creatures gain {{Hasable}}, {{Hasable}}, and {{Hasable}} until end of turn": "ActionList([CreatePermanentsList({{Creature[0]}}), PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, ThePermanentsList), CreateEachPermanentLayerEffectUntil(ThePermanentsList, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}]), AddAbility([{{Hasable[2]}}])], UntilEndOfTurn)])",
