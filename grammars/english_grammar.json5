    "you may pay {{ManaCost}}. If you do, create a token that's a copy of it. If the token isn't a creature, it becomes {{a}} {{PT}} {{Zombie}} {{Zombie}} creature in addition to its other types":
      "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [CreateTokens([TokenCopyOfPermanent({{ThatPermanent}}, NoTokenCopyEffects)]), CreateEachPermanentLayerEffect(And([TheCreatedTokens, IsNonCardtype(Creature)]), [SetPT({{PT[0]}}), AddCreatureType({{Zombie[0]}}), AddCreatureType({{Zombie[1]}}), AddCardtype(Creature)])])])",
    "you may pay {{ManaCost}}. If you do, it endures {{Digits}}": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [EndureWithPermanent({{Digits[0]}}, {{ThatPermanent}})])])",
    "you may pay {{ManaCost}}. If you do, it gains {{Hasable}} and gets {{PTModX}} until end of turn, where X is its power": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [CreatePermanentLayerEffectUntil({{ThatPermanent}}, [AddAbility([{{Hasable[0]}}]), AdjustPTX({{PTModX[0]}}, PowerOfPermanent({{ThatPermanent}}))], UntilEndOfTurn)])])",
    "you may pay {{ManaCost}}. If you do, it gains {{Hasable}} until end of turn": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [CreatePermanentLayerEffectUntil({{ThatPermanent}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])])",
    "you may pay {{ManaCost}}. If you do, put {{a}} {{CounterType}} counter on it. If it's {{a}} {{Zombie}}, put {{Number}} {{CounterType}} counters on it instead": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [IfElse(PermanentPassesFilter({{ThatPermanent}}, IsCreatureType({{Zombie[0]}})), [PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[1]}}, {{ThatPermanent}})], [PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{ThatPermanent}})])])])",
    "you may pay {{ManaCost}}. If you do, transform her": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [TransformPermanent({{ThatPermanent}})])])",
    "you may pay {{ManaCost}}. If you do, transform it": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [TransformPermanent({{ThatPermanent}})])])",
    "you may pay {{ManaCost}}. When you do, it deals {{Digits}} damage to any target": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [ReflexiveTrigger(Targeted([AnyTarget], ActionList([PermanentDealsDamage({{ThatPermanent}}, {{Digits[0]}}, Ref_AnyTarget)])))])])",
    "you may pay {{ManaCost}}. When you do, put {{a}} {{CounterType}} counter on another target creature you control, and that creature gains {{Hasable}} until end of turn": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPermanent(And([Other({{ThatPermanent}}), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])))])])",
    "you may put a name sticker on it": "ActionList([MayAction(PutANameStickerOnPermanent({{ThatPermanent}}))])",
    "you may put a name sticker on it, then look at the top X cards of your library, where X is the number of unique vowels on that sticker. Put one of those cards into your hand and the rest on the bottom of your library in any order": "ActionList([MayActions([PutANameStickerOnPermanent({{ThatPermanent}}), LookAtTheTopNumberCardsOfLibrary(TheNumberOfUniqueVowelsOnNameSticker(TheNameStickerPutOnPermanentThisWay), [PutAGenericCardIntoHand, PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder])])])",
    "you may put a name sticker on it. Add {{ManaProduceSymbol}} for each unique vowel on that sticker": "ActionList([MayActions([PutANameStickerOnPermanent({{ThatPermanent}}), AddManaRepeated({{ManaProduceSymbol[0]}}, TheNumberOfUniqueVowelsOnNameSticker(TheNameStickerPutOnPermanentThisWay))])])",
    "you may put a name sticker on it. Put {{a}} {{CounterType}} counter on it for each unique vowel on that sticker": "ActionList([MayActions([PutANameStickerOnPermanent({{ThatPermanent}}), PutNumberCountersOfTypeOnPermanent(TheNumberOfUniqueVowelsOnNameSticker(TheNameStickerPutOnPermanentThisWay), {{CounterType[0]}}, {{ThatPermanent}})])])",
    "you may put a name sticker on it. When you do, up to X target {{Creatures}} each get {{PTMod}} until end of turn, where X is the number of unique vowels on that sticker": "ActionList([MayCost(PutANameStickerOnPermanent({{ThatPermanent}})), If(CostWasPaid, [ReflexiveTrigger(Targeted([UptoNumberTargetPermanents(TheNumberOfUniqueVowelsOnNameSticker(TheNameStickerPutOnPermanentThisWay), {{Creatures[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])))])])",
    "you may put a name sticker on it. You gain X life, where X is the number of unique vowels on that sticker": "ActionList([MayActions([PutANameStickerOnPermanent({{ThatPermanent}}), GainLife(TheNumberOfUniqueVowelsOnNameSticker(TheNameStickerPutOnPermanentThisWay))])])",
    "you may put any number of {{SpecificCards}} from your graveyard and/or hand onto the battlefield attached to it": "ActionList([MayAction(PutAnyNumberOfCardsFromHandOrFromPlayersGraveyardOnBattlefield({{SpecificCards[0]}}, You, [EntersAttachedToPermanent({{ThatPermanent}})]))])",
    "you may put up to {{Number}} name stickers on it": "ActionList([MayAction(PutUptoNumberNameStickersOnPermanent({{Number[0]}}, {{ThatPermanent}}))])",
    "you may put {{Number}} {{CounterType}} counters on it": "ActionList([MayAction(PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[0]}}, {{ThatPermanent}}))])",
    "you may put {{a}} {{CounterType}} counter on another target {{Permanent}}": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))], ActionList([MayAction(PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent))]))",
    "you may put {{a}} {{CounterType}} counter on it": "ActionList([MayAction(PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{ThatPermanent}}))])",
    "you may put {{a}} {{SpecificCard}} from your hand onto the battlefield attached to it": "ActionList([MayAction(PutACardFromHandOnBattlefield({{SpecificCard[0]}}, [EntersAttachedToPermanent({{ThatPermanent}})]))])",
    "you may put {{a}} {{SpecificCard}} with equal or lesser mana value from your hand onto the battlefield": "ActionList([MayAction(PutACardFromHandOnBattlefield(And([{{SpecificCard[0]}}, ManaValueIs(LessThanOrEqualTo(ManaValueOfPermanent({{ThatPermanent}})))]), [EntersNormally]))])",
    "you may remove {{Number}} {{CounterType}} counters from it. If you do, when you next cast {{a}} {{Spell}} this turn, copy that spell. You may choose new targets for the copy": "ActionList([MayCost(RemoveNumberCountersOfTypeFromPermanent({{Number[0]}}, {{CounterType[0]}}, {{ThatPermanent}})), If(CostWasPaid, [CreateFutureTrigger(WhenPlayerCastsTheirNextSpellThisTurn(You, {{Spell[0]}}), ActionList([CopySpellAndMayChooseNewTargets(Trigger_ThatSpell)]))])])",
    "you may remove {{Number}} {{CounterType}} counters from it. If you do, you draw {{Number}} cards and you lose {{Digits}} life": "ActionList([MayCost(RemoveNumberCountersOfTypeFromPermanent({{Number[0]}}, {{CounterType[0]}}, {{ThatPermanent}})), If(CostWasPaid, [DrawNumberCards({{Number[1]}}), LoseLife({{Digits[0]}})])])",
    "you may remove {{Number}} {{CounterType}} counters from it. When you do, target {{Creature}} can't block this turn": "ActionList([MayCost(RemoveNumberCountersOfTypeFromPermanent({{Number[0]}}, {{CounterType[0]}}, {{ThatPermanent}})), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [CantBlock], UntilEndOfTurn)])))])])",
    "you may remove {{a}} {{CounterType}} counter from it. If you do, draw a card": "ActionList([MayCost(RemoveACounterOfTypeFromPermanent({{CounterType[0]}}, {{ThatPermanent}})), If(CostWasPaid, [DrawACard])])",
    "you may remove {{a}} {{CounterType}} counter from it. If you do, search your library for {{a}} {{SpecificCard}}, put it onto the battlefield tapped, then shuffle": "ActionList([MayCost(RemoveACounterOfTypeFromPermanent({{CounterType[0]}}, {{ThatPermanent}})), If(CostWasPaid, [SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersTapped]), Shuffle])])])",
    "you may remove {{a}} {{CounterType}} counter from it. If you do, untap it and it gets {{PTMod}} until end of turn": "ActionList([MayCost(RemoveACounterOfTypeFromPermanent({{CounterType[0]}}, {{ThatPermanent}})), If(CostWasPaid, [UntapPermanent({{ThatPermanent}}), CreatePermanentLayerEffectUntil({{ThatPermanent}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])])",
    "you may return another target {{Creature}} to its owner's hand. If you do, you gain life equal to that creature's mana value": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), {{Creature[0]}}]))], ActionList([MayCost(PutPermanentIntoItsOwnersHand(Ref_TargetPermanent)), If(CostWasPaid, [GainLife(ManaValueOfPermanent(Ref_TargetPermanent))])]))",
    "you may return another target {{Permanent}} to its owner's hand": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))], ActionList([MayAction(PutPermanentIntoItsOwnersHand(Ref_TargetPermanent))]))",
    "you may return another target {{Permanent}} to its owner's hand. If you do, scry {{Digits}}": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))], ActionList([MayCost(PutPermanentIntoItsOwnersHand(Ref_TargetPermanent)), If(CostWasPaid, [Scry({{Digits[0]}})])]))",
    "you may return another {{Permanent}} that shares a permanent type with it to its owner's hand": "ActionList([PutAPermanentIntoItsOwnersHand(And([Other({{ThatPermanent}}), {{Permanent[0]}}, SharesAPermanentCardtypeWithPermanent({{ThatPermanent}})]))])",
    "you may return another {{Permanent}} to its owner's hand": "ActionList([MayAction(PutAPermanentIntoItsOwnersHand(And([Other({{ThatPermanent}}), {{Permanent[0]}}])))])",
    "you may return another {{Permanent}} to its owner's hand. If you do, create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}} and \"{{TokenQuotedAbility}}\"": "ActionList([MayCost(PutAPermanentIntoItsOwnersHand(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))), If(CostWasPaid, [CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}, {{TokenQuotedAbility[0]}}])])])])",
    "you may return it to its owner's hand": "ActionList([MayAction(PutPermanentIntoItsOwnersHand({{ThatPermanent}}))])",
    "you may return that permanent to its owner's hand": "ActionList([MayAction(PutPermanentIntoItsOwnersHand({{ThatPermanent}}))])",
    "you may reveal {{a}} {{SpecificCard}} from your hand. If you do or if {{Condition(ThatPermanent)}}, you gain {{Digits}} life": "ActionList([MayCost(RevealACardOfTypeFromHand({{SpecificCard[0]}})), If(Or([CostWasPaid, {{Condition(ThatPermanent=^ThatPermanent)[0]}}]), [GainLife({{Digits[0]}})])])",
    "you may sacrifice another creature or a token. When you do, target {{Creature}} gets {{PTMod}} until end of turn": "ActionList([MayCost(Or([SacrificeAPermanent(And([Other({{ThatPermanent}}), IsCardtype(Creature)])), SacrificeAPermanent(IsToken)])), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])))])])",
    "you may sacrifice another creature. If you do, add an amount of {{ManaProduceSymbol}} equal to the sacrificed creature's power. Until end of combat, you don't lose this mana as steps end": "ActionList([MayCost(SacrificeAPermanent(And([Other({{ThatPermanent}}), IsCardtype(Creature)]))), If(CostWasPaid, [AddManaRepeatedWithModifiers({{ManaProduceSymbol[0]}}, PowerOfPermanent(ThePermanentSacrificedThisWay), DontLoseAsStepsAndPhasesEnd(UntilEndOfCombat))])])",
    "you may sacrifice another creature. If you do, draw X cards, then you may put a permanent card with mana value X or less from your hand onto the battlefield, where X is the sacrificed creature's mana value": "ActionList([MayCost(SacrificeAPermanent(And([Other({{ThatPermanent}}), IsCardtype(Creature)]))), If(CostWasPaid, [DrawNumberCards(ManaValueOfPermanent(ThePermanentSacrificedThisWay)), MayAction(PutACardFromHandOnBattlefield(And([IsPermanent, ManaValueIs(LessThanOrEqualTo(ManaValueOfPermanent(ThePermanentSacrificedThisWay)))]), [EntersNormally]))])])",
    "you may sacrifice another creature. If you do, you gain X life and draw X cards, where X is that creature's power": "ActionList([MayCost(SacrificeAPermanent(And([Other({{ThatPermanent}}), IsCardtype(Creature)]))), If(CostWasPaid, [GainLife(PowerOfPermanent(ThePermanentSacrificedThisWay)), DrawNumberCards(PowerOfPermanent(ThePermanentSacrificedThisWay))])])",
    "you may sacrifice another enchantment. If you do, search your library for a creature card with mana value equal to {{Digits}} plus the sacrificed enchantment's mana value, put that card onto the battlefield, then shuffle": "ActionList([MayCost(SacrificeAPermanent(And([Other(ThisPermanent), IsCardtype(Enchantment)]))), If(CostWasPaid, [SearchLibrary([FindACardOfType(And([IsCardtype(Creature), ManaValueIs(EqualTo(Plus({{Digits[0]}}, ManaValueOfTheSacrificedPermanent)))])), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle])])])",
    "you may sacrifice another {{Creature}}. If you do, create a number of Treasure tokens equal to {{GameNumber(ThatCreature)}}": "ActionList([MayCost(SacrificeAPermanent(And([Other({{ThatPermanent}}), {{Creature[0]}}]))), If(CostWasPaid, [CreateTokens([NumberTokens({{GameNumber(ThatCreature=ThePermanentSacrificedThisWay)[0]}}, TreasureToken)])])])",
    "you may sacrifice another {{Creature}}. If you do, reveal cards from the top of your library until you reveal a nonlegendary creature card with lesser mana value, put it onto the battlefield, then put the rest on the bottom of your library in a random order": "ActionList([MayCost(SacrificeAPermanent(And([Other({{ThatPermanent}}), {{Creature[0]}}]))), If(CostWasPaid, [RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed(And([IsNonSupertype(Legendary), IsCardtype(Creature), ManaValueIs(LessThan(ManaValueOfTheSacrificedPermanent))]), [PutTheCardFoundThisWayOntoTheBattlefield([EntersNormally]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])])",
    "you may sacrifice another {{Creature}}. If you do, {{Creatures}} have base power and toughness {{PTX}} until end of turn, where X is the sacrificed creature's mana value": "ActionList([MayCost(SacrificeAPermanent(And([Other({{ThatPermanent}}), {{Creature[0]}}]))), If(CostWasPaid, [CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [SetPT(PTX({{PTX[0]}}, ManaValueOfThePermanentSacrificedThisWay))], UntilEndOfTurn)])])",
    "you may sacrifice another {{Permanent}} or {{a}} {{Permanent}}. If you do, create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}} that's tapped and attacking": "ActionList([MayCost(SacrificeAPermanent(Or([And([Other({{ThatPermanent}}), {{Permanent[0]}}]), {{Permanent[1]}}]))), If(CostWasPaid, [CreateTokensWithFlags([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])], [EntersTapped, EntersAttacking])])])",
    "you may sacrifice another {{Permanent}} or {{a}} {{Permanent}}. When you do, draw {{Number}} cards unless target opponent pays {{Digits}} life": "ActionList([MayCost(SacrificeAPermanent(Or([And([Other({{ThatPermanent}}), {{Permanent[0]}}]), {{Permanent[1]}}]))), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPlayer(Opponent)], ActionList([PlayerMayCost(Ref_TargetPlayer, PayLife({{Digits[0]}})), Unless(CostWasPaid, [DrawNumberCards({{Number[0]}})])])))])])",
    "you may sacrifice another {{Permanent}} or {{a}} {{Permanent}}. When you do, return target {{PermanentCard}} from your graveyard to the battlefield. It gains {{Hasable}}. If its mana value is {{Digits}} or greater, sacrifice it at the beginning of your next end step": "ActionList([MayCost(SacrificeAPermanent(Or([And([Other({{ThatPermanent}}), {{Permanent[0]}}]), {{Permanent[1]}}]))), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetGraveyardCard(And([{{PermanentCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersNormally]), CreatePermanentLayerEffect(ThePermanentPutOnTheBattlefieldThisWay, [AddAbility([{{Hasable[0]}}])]), If(PermanentPassesFilter(ThePermanentPutOnTheBattlefieldThisWay, ManaValueIs(GreaterThanOrEqualTo({{Digits[0]}}))), [CreateFutureTrigger(AtTheBeginningOfPlayersNextEndStep(You), ActionList([SacrificePermanent(ThePermanentPutOnTheBattlefieldThisWay)]))])])))])])",
    "you may sacrifice another {{Permanent}} or {{a}} {{Permanent}}. When you do, return target {{SpecificCard}} from your graveyard to your hand": "ActionList([MayCost(SacrificeAPermanent(Or([And([Other({{ThatPermanent}}), {{Permanent[0]}}]), {{Permanent[1]}}]))), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardIntoHand(Ref_TargetGraveyardCard)])))])])",
    "you may sacrifice another {{Permanent}}. If you do, create a tapped Powerstone token": "ActionList([MayCost(SacrificeAPermanent(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))), If(CostWasPaid, [CreateTokensWithFlags([PowerstoneToken], [EntersTapped])])])",
    "you may sacrifice another {{Permanent}}. If you do, create {{a}} {{PT}} {{CreatureToken}}": "ActionList([MayCost(SacrificeAPermanent(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))), If(CostWasPaid, [CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])])])",
    "you may sacrifice another {{Permanent}}. If you do, draw a card": "ActionList([MayCost(SacrificeAPermanent(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))), If(CostWasPaid, [DrawACard])])",
    "you may sacrifice another {{Permanent}}. If you do, draw {{Number}} cards": "ActionList([MayCost(SacrificeAPermanent(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))), If(CostWasPaid, [DrawNumberCards({{Number[0]}})])])",
    "you may sacrifice another {{Permanent}}. If you do, draw {{Number}} cards and each opponent loses life equal to the mana value of the sacrificed permanent": "ActionList([MayCost(SacrificeAPermanent(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))), If(CostWasPaid, [DrawNumberCards({{Number[0]}}), EachPlayerAction(Opponent, LoseLife(ManaValueOfTheSacrificedPermanent))])])",
    "you may sacrifice another {{Permanent}}. If you do, surveil {{Digits}}": "ActionList([MayCost(SacrificeAPermanent(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))), If(CostWasPaid, [Surveil({{Digits[0]}})])])",
    "you may sacrifice another {{Permanent}}. If you do, you draw cards equal to that creature's power and you lose life equal to that creature's toughness": "ActionList([MayCost(SacrificeAPermanent(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))), If(CostWasPaid, [DrawNumberCards(PowerOfPermanent(ThePermanentSacrificedThisWay)), LoseLife(ToughnessOfPermanent(ThePermanentSacrificedThisWay))])])",
    "you may sacrifice another {{Permanent}}. When you do, destroy target {{Permanent}}": "ActionList([MayCost(SacrificeAPermanent(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPermanent({{Permanent[1]}})], ActionList([DestroyPermanent(Ref_TargetPermanent)])))])])",
    "you may sacrifice another {{Permanent}}. When you do, put {{a}} {{CounterType}} counter on each of up to {{Number}} target {{Permanents}}": "ActionList([MayCost(SacrificeAPermanent(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))), If(CostWasPaid, [ReflexiveTrigger(Targeted([UptoNumberTargetPermanents({{Number[0]}}, {{Permanents[0]}})], ActionList([PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, Ref_TargetPermanents)])))])])",
    "you may sacrifice it. If you do, destroy target {{Permanent}} and target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}}), TargetPermanent({{Permanent[1]}})], ActionList([MayCost(SacrificePermanent({{ThatPermanent}})), If(CostWasPaid, [DestroyEachPermanent(Or([SinglePermanent(Ref_TargetPermanent1), SinglePermanent(Ref_TargetPermanent2)]))])]))",
    "you may sacrifice it. If you do, discard your hand, then draw {{Number}} cards": "ActionList([MayCost(SacrificePermanent({{ThatPermanent}})), If(CostWasPaid, [DiscardHand, DrawNumberCards({{Number[0]}})])])",
    "you may sacrifice it. If you do, draw cards equal to its power": "ActionList([MayCost(SacrificePermanent({{ThatPermanent}})), If(CostWasPaid, [DrawNumberCards(PowerOfPermanent({{ThatPermanent}}))])])",
    "you may sacrifice it. If you do, draw {{Number}} cards": "ActionList([MayCost(SacrificePermanent({{ThatPermanent}})), If(CostWasPaid, [DrawNumberCards({{Number[0]}})])])",
    "you may sacrifice it. If you do, gain control of target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([MayCost(SacrificePermanent({{ThatPermanent}})), If(CostWasPaid, [DestroyPermanent(Ref_TargetPermanent)])]))",
    "you may sacrifice it. If you do, proliferate": "ActionList([MayCost(SacrificePermanent({{ThatPermanent}})), If(CostWasPaid, [Proliferate])])",
    "you may sacrifice it. When you do, choose one -\n* Draw a card.\n* Create a Treasure token": "ActionList([MayCost(SacrificePermanent({{ThatPermanent}})), If(CostWasPaid, [ReflexiveTrigger(Modal_ChooseOne([ActionList([DrawACard]), ActionList([CreateTokens([TreasureToken])])]))])])",
    "you may sacrifice it. When you do, destroy target {{Permanent}}": "ActionList([MayCost(SacrificePermanent({{ThatPermanent}})), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPermanent({{Permanent[0]}})], ActionList([DestroyPermanent(Ref_TargetPermanent)])))])])",
    "you may sacrifice it. When you do, return target creature card from your graveyard to the battlefield": "ActionList([MayCost(SacrificePermanent({{ThatPermanent}})), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetGraveyardCard(And([IsCardtype(Creature), InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersNormally])])))])])",
    "you may sacrifice {{Number}} other {{Permanents}}. If you do, return {{a}} {{SpecificCard}} from your graveyard to the battlefield with {{a}} {{CounterType}} counter on it": "ActionList([MayCost(SacrificeNumberPermanents({{Number[0]}}, And([Other({{ThatPermanent}}), {{Permanents[0]}}]))), If(CostWasPaid, [ReturnACardFromGraveyardToBattlefield({{SpecificCard[0]}}, [EntersWithACounter({{CounterType[0]}})])])])",
    "you may suspect it": "ActionList([MayAction(SuspectPermanent({{ThatPermanent}}))])",
    "you may tap it. If you do, proliferate": "ActionList([MayCost(TapPermanent({{ThatPermanent}})), If(CostWasPaid, [Proliferate])])",
    "you may transform it": "ActionList([MayAction(TransformPermanent({{ThatPermanent}}))])",
    "you may untap it and remove it from combat": "ActionList([MayActions([UntapPermanent({{ThatPermanent}}), RemoveCreatureFromCombat({{ThatPermanent}})])])",
    "you win the game if {{Condition(ThatPermanent)}} or {{Condition}}": "ActionList([If(Or([{{Condition(ThatPermanent=^ThatPermanent)[0]}}, {{Condition[0]}}]), [WinTheGame])])"
  },
  "{{TriggerActions(ThatPermanent,DefendingPlayer)}}": {
    "create X tokens that are copies of it and that are tapped and attacking, where X is the number of creatures defending player controls. Exile the tokens at the beginning of the next end step": "ActionList([CreateTokensWithFlags([NumberTokens(TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(DefendingPlayer))])), TokenCopyOfPermanent({{ThatPermanent}}, NoTokenCopyEffects))], [EntersTapped, EntersAttacking]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([DestroyEachPermanent(TheCreatedTokens)]))])",
    "defending player sacrifices a creature of their choice that's blocking it": "ActionList([PlayerAction({{DefendingPlayer}}, SacrificeAPermanent(And([IsCardtype(Creature), IsBlockingAttacker({{ThatPermanent}})])))])",
    "it assigns no combat damage this turn and defending player loses {{Digits}} life": "ActionList([CreatePermanentRuleEffectUntil({{ThatPermanent}}, [AssignsNoCombatDamage], UntilEndOfTurn), PlayerAction({{DefendingPlayer}}, LoseLife({{Digits[0]}}))])",
    "it deals X damage to defending player, where X is {{GameNumber(ThatPlayer)}}": "ActionList([PermanentDealsDamage({{ThatPermanent}}, {{GameNumber(ThatPlayer=^DefendingPlayer)[0]}}, Player({{DefendingPlayer}}))])",
    "it deals damage equal to its power to target creature defending player controls": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByPlayer({{DefendingPlayer}})]))], ActionList([PermanentDealsDamage({{ThatPermanent}}, PowerOfPermanent({{ThatPermanent}}), Permanent(Ref_TargetPermanent))]))",
    "it deals damage to defending player equal to {{GameNumber(ThatPlayer)}}": "ActionList([PermanentDealsDamage({{ThatPermanent}}, {{GameNumber(ThatPlayer=^DefendingPlayer)[0]}}, Player(DefendingPlayer))])",
    "it deals {{Digits}} damage to defending player": "ActionList([PermanentDealsDamage({{ThatPermanent}}, {{Digits[0]}}, Player({{DefendingPlayer}}))])",
    "it deals {{Digits}} damage to each {{Creature}} defending player controls": "ActionList([PermanentDealsDamage({{ThatPermanent}}, {{Digits[0]}}, EachPermanent(And([{{Creature[0]}}, ControlledByPlayer({{DefendingPlayer}})])))])",
    "put {{a}} {{CounterType}} counter on it and tap up to one target {{Creature}} defending player controls": "Targeted([UptoOneTargetPermanent(And([IsCardtype(Creature), ControlledByPlayer({{DefendingPlayer}})]))], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{ThatPermanent}}), TapPermanent(Ref_TargetPermanent)]))",
    "you may have it assign no combat damage this turn. If you do, defending player discards a card at random": "ActionList([MayCost(CreatePermanentRuleEffectUntil({{ThatPermanent}}, [AssignsNoCombatDamage], UntilEndOfTurn)), If(CostWasPaid, [PlayerAction({{DefendingPlayer}}, DiscardACardAtRandom)])])",
    "you may have it deal {{Digits}} damage to each {{Creature}} defending player controls": "ActionList([MayAction(HavePermanentDealDamage({{ThatPermanent}}, {{Digits[0]}}, EachPermanent(And([{{Creature[0]}}, ControlledByPlayer({{DefendingPlayer}})]))))])",
    "you may sacrifice it. If you do, defending player discards {{Number}} cards": "ActionList([MayCost(SacrificePermanent({{ThatPermanent}})), If(CostWasPaid, [PlayerAction({{DefendingPlayer}}, DiscardNumberCards({{Number[0]}}))])])"
  },
  "{{TriggerActions(ThatPermanent,ThatMuch)}}": {
    "it deals that much damage to any other target. If a player is dealt damage this way, they can't gain life for the rest of the game": "Targeted([AnyTargetExceptPermanent({{ThatPermanent}})], ActionList([PermanentDealsDamage({{ThatPermanent}}, {{ThatMuch}}, Ref_AnyTarget), If(APlayerWasDealtDamageThisWay(AnyPlayer), [CreateEachPlayerEffectUntil(PlayerDealtDamageThisWay, [CantGainLife], UntilEndOfGame)])]))",
    "it deals that much damage to any target": "Targeted([AnyTarget], ActionList([PermanentDealsDamage({{ThatPermanent}}, {{ThatMuch}}, Ref_AnyTarget)]))",
    "it deals that much damage to any target that isn't {{a}} {{Zombie}}": "Targeted([AnyTargetExceptAPermanent(IsCreatureType({{Zombie[0]}}))], ActionList([PermanentDealsDamage({{ThatPermanent}}, {{ThatMuch}}, Ref_AnyTarget)]))",
    "it deals that much damage to each opponent": "ActionList([PermanentDealsDamage({{ThatPermanent}}, {{ThatMuch}}, EachPlayer(Opponent))])",
    "it deals that much damage to each player": "ActionList([PermanentDealsDamage({{ThatPermanent}}, {{ThatMuch}}, EachPlayer(AnyPlayer))])",
    "it deals that much damage to its controller": "ActionList([PermanentDealsDamage({{ThatPermanent}}, {{ThatMuch}}, Player(ControllerOfPermanent({{ThatPermanent}})))])",
    "it deals that much damage to target opponent": "Targeted([TargetPlayer(Opponent)], ActionList([PermanentDealsDamage({{ThatPermanent}}, {{ThatMuch}}, Player(Ref_TargetPlayer))]))",
    "it deals that much damage to target opponent or planeswalker": "Targeted([TargetPlayerOrPermanent(Opponent, IsCardtype(Planeswalker))], ActionList([PermanentDealsDamage({{ThatPermanent}}, {{ThatMuch}}, Ref_TargetPlayerOrPermanent)]))",
    "it deals that much damage to target player": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PermanentDealsDamage({{ThatPermanent}}, {{ThatMuch}}, Player(Ref_TargetPlayer))]))",
    "it deals that much damage to you": "ActionList([PermanentDealsDamage({{ThatPermanent}}, {{ThatMuch}}, Player(You))])",
    "its controller creates that many {{PT}} {{CreatureTokens}}": "ActionList([PlayerAction(ControllerOfPermanent({{ThatPermanent}}), CreateTokens([NumberTokens({{ThatMuch}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))]))])",
    "its controller gains that much life": "ActionList([PlayerAction(ControllerOfPermanent({{ThatPermanent}}), GainLife({{ThatMuch}}))])",
    "its controller loses that much life": "ActionList([PlayerAction(ControllerOfPermanent({{ThatPermanent}}), LoseLife({{ThatMuch}}))])",
    "its controller may exile that many cards from the top of their library. They may play those cards until the end of their next turn": "ActionList([PlayerAction(ControllerOfPermanent({{ThatPermanent}}), ExileTheTopNumberCardsOfLibrary({{ThatMuch}})), CreatePlayerEffectUntil(ControllerOfPermanent({{ThatPermanent}}), [MayPlayExiledCards(TheCardsExiledThisWay)], UntilTheEndOfPlayersNextTurn(ControllerOfPermanent({{ThatPermanent}})))])",
    "put that many {{CounterType}} counters on it": "ActionList([PutNumberCountersOfTypeOnPermanent({{ThatMuch}}, {{CounterType[0]}}, {{ThatPermanent}})])",
    "sacrifice it and create that many Treasure tokens": "ActionList([SacrificePermanent({{ThatPermanent}}), CreateTokens([NumberTokens({{ThatMuch}}, TreasureToken)])])",
    "she deals that much damage to target {{PlayerOrPlaneswalker}}": "Targeted([TargetPlayerOrPermanent({{PlayerOrPlaneswalker[0]}})], ActionList([PermanentDealsDamage({{ThatPermanent}}, {{ThatMuch}}, Ref_TargetPlayerOrPermanent)]))"
  },
  "{{TriggerActions(ThatPermanent,ThatMuch,ThatPlayer)}}": {
    "it deals that much damage to each other opponent": "ActionList([PermanentDealsDamage({{ThatPermanent}}, {{ThatMuch}}, EachPlayer(And([Other({{ThatPlayer}}), Opponent])))])",
    "it deals that much damage to each {{Creature}} that player controls": "ActionList([PermanentDealsDamage({{ThatPermanent}}, {{ThatMuch}}, EachPermanent(And([{{Creature[0]}}, ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))])))])",
    "it deals that much damage to target planeswalker that player controls": "Targeted([TargetPermanent(And([IsCardtype(Planeswalker), ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))], ActionList([PermanentDealsDamage({{ThatPermanent}}, {{ThatMuch}}, Permanent(Ref_TargetPermanent))]))",
    "it deals that much damage to target planeswalker that player controls or battle that player protects": "Targeted([TargetPermanent(Or([And([IsCardtype(Planeswalker), ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]), And([IsCardtype(Battle), ProtectedByAPlayer(SinglePlayer({{ThatPlayer}}))])]))], ActionList([PermanentDealsDamage({{ThatPermanent}}, {{ThatMuch}}, Permanent(Ref_TargetPermanent))]))",
    "you may have it deal that much damage to target {{Creature}} that player controls": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([MayAction(HavePermanentDealDamage({{ThatPermanent}}, {{ThatMuch}}, Permanent(Ref_TargetPermanent)))]))"
  },
  "{{TriggerActions(ThatPermanent,ThatPlayer)}}": {
    "they lose life equal to its mana value": "ActionList([PlayerAction({{ThatPlayer}}, LoseLife(ManaValueOfPermanent({{ThatPermanent}})))])",
    "they may tap that permanent. If they don't, you create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}}": "ActionList([PlayerMayCost({{ThatPlayer}}, TapPermanent({{ThatPermanent}})), Unless(CostWasPaid, [CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])])])])",
    "you may have it deal {{Digits}} damage to target creature that player controls": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))], ActionList([MayAction(HavePermanentDealDamage({{ThatPermanent}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent)))]))",
    "you may remove {{a}} {{CounterType}} counter from it. When you do, exile target artifact or enchantment that player controls": "ActionList([MayCost(RemoveACounterOfTypeFromPermanent({{CounterType[0]}}, {{ThatPermanent}})), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPermanent(And([Or([IsCardtype(Artifact), IsCardtype(Enchantment)]), ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))], ActionList([ExilePermanent(Ref_TargetPermanent)])))])])",
    "you may remove {{a}} {{CounterType}} counter from it. When you do, that player reveals their hand and you choose {{a}} {{SpecificCard}} from it. Exile that card": "ActionList([MayCost(RemoveACounterOfTypeFromPermanent({{CounterType[0]}}, {{ThatPermanent}})), If(CostWasPaid, [ReflexiveTrigger(ActionList([PlayerAction({{ThatPlayer}}, RevealHandAndPlayerChoosesACardToExile(You, {{SpecificCard[0]}}))]))])])",
    "you may sacrifice it. If you do, destroy target creature that player controls": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))], ActionList([MayCost(SacrificePermanent({{ThatPermanent}})), If(CostWasPaid, [DestroyPermanent(Ref_TargetPermanent)])]))",
    "you may sacrifice it. If you do, gain control of target creature that player controls": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))], ActionList([MayCost(SacrificePermanent({{ThatPermanent}})), If(CostWasPaid, [GainControlOfPermanent(Ref_TargetPermanent)])]))",
    "you may transform it. If you do, attach it to target creature that player controls": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))], ActionList([MayCost(TransformPermanent({{ThatPermanent}})), If(CostWasPaid, [AttachPermanentToPermanent({{ThatPermanent}}, Ref_TargetPermanent)])]))"
  },
  "{{TriggerActions(ThatPermanent,X)}}": {
    "choose one -\n* {{TriggerActions_Modal(ThatPermanent,X)}}.\n* {{TriggerActions_Modal(X)}}": "Modal_ChooseOne([{{TriggerActions_Modal(ThatPermanent=^ThatPermanent,X=^X)[0]}}, {{TriggerActions_Modal(X=^X)[0]}}])",
    "distribute X {{CounterType}} counters among it and any number of {{Permanents}}": "ActionList([DistributeNumberCountersOfTypeAmongAnyNumberOfPermanents({{X}}, {{CounterType[0]}}, Or([SinglePermanent({{ThatPermanent}}), {{Permanents[0]}}]))])",
    "exile up to X other target {{Permanents}} from the battlefield and/or {{SpecificCards}} from graveyards": "Targeted([UptoNumberTargetPermanentsAndOrCardsInAnyPlayersGraveyard({{X}}, And([Other({{ThatPermanent}}), {{Permanents[0]}}]), {{SpecificCards[0]}}, AnyPlayer)], ActionList([ExileEachPermanentAndGraveyardCard(Ref_TargetPermanentsAndGraveyardCards)]))",
    "it deals X damage to any target": "Targeted([AnyTarget], ActionList([PermanentDealsDamage({{ThatPermanent}}, {{X}}, Ref_AnyTarget)]))",
    "it deals X damage to each of up to X target {{Creatures}}": "Targeted([UptoNumberTargetPermanents({{X}}, {{Creatures[0]}})], ActionList([PermanentDealsDamage({{ThatPermanent}}, {{X}}, EachPermanent(Ref_TargetPermanents))]))",
    "it deals X damage to each player and each other {{Creature}}": "ActionList([PermanentDealsDamage({{ThatPermanent}}, {{X}}, MultipleRecipients([EachPlayer(AnyPlayer), EachPermanent(And([Other({{ThatPermanent}}), {{Creature[0]}}]))]))])",
    "it deals X damage to each {{Creature}}": "ActionList([PermanentDealsDamage({{ThatPermanent}}, {{X}}, EachPermanent({{Creature[0]}}))])",
    "it explores X times": "ActionList([ExploreWithPermanentNumberTimes({{ThatPermanent}}, {{X}})])",
    "put X {{CounterType}} counters on it": "ActionList([PutNumberCountersOfTypeOnPermanent({{X}}, {{CounterType[0]}}, {{ThatPermanent}})])",
    "put X {{CounterType}} counters on it and mill twice X cards": "ActionList([PutNumberCountersOfTypeOnPermanent({{X}}, {{CounterType[0]}}, {{ThatPermanent}}), MillNumberCards(Twice({{X}}))])",
    "you may put an ability sticker with ticket cost X or less on it without paying that sticker's ticket cost": "ActionList([MayAction(PutAnAbilityStickerWithTicketCostOnPermanentWithoutPaying(LessThanOrEqualTo({{X}}), {{ThatPermanent}}))])"
  },
  "{{TriggerActions(ThatPlane)}}": {
    "it deals damage equal to {{GameNumber(ThatPlane)}} to each creature and each planeswalker": "ActionList([PlaneDealsDamage({{ThatPlane}}, {{GameNumber(ThatPlane=^ThatPlane)[0]}}, EachPermanent(Or([IsCardtype(Creature), IsCardtype(Planeswalker)])))])",
    "put {{a}} {{CounterType}} counter on it": "ActionList([PutACounterOnPlane({{CounterType[0]}}, {{ThatPlane}})])"
  },
  "{{TriggerActions(ThatPlaneswalker)}}": {
    "destroy that planeswalker": "ActionList([DestroyPermanent({{ThatPlaneswalker}})])"
  },
  "{{TriggerActions(ThatPlayer)}}": {
    "a random {{SpecificCard}} in that player's hand perpetually gains \"{{PerpetualQuotedAbility}}\"": "ActionList([ChooseACardOfTypeInPlayersHandAtRandom({{SpecificCard[0]}}, {{ThatPlayer}}), CreatePerpetualCardInHandEffect(TheChosenCardInHand, [AddAbility([{{PerpetualQuotedAbility[0]}}])])])",
    "any number of target players other than that player each draw cards equal to the number of Curses attached to that player": "Targeted([AnyNumberOfTargetPlayers(Other({{ThatPlayer}}))], ActionList([EachPlayerAction(Ref_TargetPlayers, DrawNumberCards(TheNumberOfPermanentsOnTheBattlefield(And([IsEnchantmentType(Curse), AttachedToPlayer({{ThatPlayer}})]))))]))",
    "choose a card in your hand. That player guesses whether the card's mana value is greater than {{Digits}}. If the player guessed wrong, you may cast the card without paying its mana cost": "ActionList([ChooseACardInHand(AnyCard), PlayerAction({{ThatPlayer}}, GuessIfCardInHandPassesFilter(TheCardInHandChosenThisWay, ManaValueIs(GreaterThanOrEqualTo({{Digits[0]}})))), If(PlayerGuessedWrong, [MayAction(CastCardInHandWithoutPaying(TheCardInHandChosenThisWay))])])",
    "choose a card name. That player reveals their hand. If a card with the chosen name is revealed this way, search your library for {{a}} {{SpecificCard}}, reveal it, put it into your hand, then shuffle": "ActionList([ChooseACardName(AnyOracleCard), PlayerAction({{ThatPlayer}}, RevealHand), If(ACardWasRevealedThisWay(IsNamed(TheChosenName)), [SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])])",
    "choose one -\n* Goad target creature that player controls.\n* Exile the top card of that player's library. Until end of turn, you may cast that card and you may spend mana as though it were mana of any color to cast that spell": "Modal_ChooseOne([Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))], ActionList([GoadCreature(Ref_TargetPermanent)])), ActionList([ExileTheTopCardOfPlayersLibrary({{ThatPlayer}}), MayAction(CastExiledCardAndMaySpendManaAsThoughAnyColorToCast(TheCardExiledThisWay))])])",
    "choose one -\n* That player returns a permanent they control to its owner's hand.\n* That player discards a card": "Modal_ChooseOne([ActionList([PlayerAction({{ThatPlayer}}, PutAPermanentIntoItsOwnersHand(ControlledByAPlayer(SinglePlayer(ActionPlayer))))]), ActionList([PlayerAction({{ThatPlayer}}, DiscardACard)])])",
    "choose target creature that player controls. The player sacrifices that creature": "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))], ActionList([PlayerAction({{ThatPlayer}}, SacrificePermanent(Ref_TargetPermanent))]))",
    "choose target nontoken creature that's attacking that player. Create a token that's a copy of that creature, except it's {{PT}}. The token enters tapped and attacking that player. Sacrifice it at the beginning of the next end step": "Targeted([TargetPermanent(And([IsNonToken, IsCardtype(Creature), IsAttackingPlayer({{ThatPlayer}})]))], ActionList([CreateTokensWithFlags([TokenCopyOfPermanent(Ref_TargetPermanent, TokenCopyEffects([SetPT({{PT[0]}})]))], [EntersTapped, EntersAttackingPlayer({{ThatPlayer}})]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([SacrificeEachPermanent(TheTokensCreatedThisWay)]))]))",
    "cloak the top card of that player's library": "ActionList([CloakTheTopCardOfPlayersLibrary({{ThatPlayer}})])",
    "create a Gold token. Each opponent attacking that player does the same": "ActionList([CreateTokens([GoldToken]), EachPlayerAction(And([Opponent, IsAttackingPlayer({{ThatPlayer}})]), CreateTokens([GoldToken]))])",
    "create a Treasure token and exile the top card of that player's library. Until end of turn, you may cast that card": "ActionList([CreateTokens([TreasureToken]), ExileTheTopCardOfPlayersLibrary({{ThatPlayer}}), CreatePlayerEffectUntil(You, [MayCastExiledCard(TheCardExiledThisWay)], UntilEndOfTurn)])",
    "create a Treasure token and manifest the top card of that player's library": "ActionList([CreateTokens([TreasureToken]), ManifestTheTopCardOfPlayersLibrary({{ThatPlayer}})])",
    "create a Treasure token for each {{Eachable(ThatPlayer)}}": "ActionList([CreateTokens([NumberTokens({{Eachable(ThatPlayer=^ThatPlayer)[0]}}, TreasureToken)])])",
    "create a Treasure token, then look at the top card of that player's library and exile it face down. You may cast that card for as long as it remains exiled": "ActionList([CreateTokens([TreasureToken]), LookAtTheTopCardOfPlayersLibrary({{ThatPlayer}}), ExileTheTopCardOfPlayersLibraryFaceDown({{ThatPlayer}}), CreatePlayerEffectUntil(You, [MayCastExiledCard(TheCardExiledThisWay)], UntilCardIsNoLongerExiled(TheCardExiledThisWay))])",
    "create a token that's a copy of target artifact that player controls": "Targeted([TargetPermanent(And([IsCardtype(Artifact), ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))], ActionList([CreateTokens([TokenCopyOfPermanent(Ref_TargetPermanent, NoTokenCopyEffects)])]))",
    "create {{a}} {{PT}} {{CreatureToken}} that's tapped and attacking that player": "ActionList([CreateTokensWithFlags([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])], [EntersTapped, EntersAttackingPlayer({{ThatPlayer}})])])",
    "create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}} that's tapped and attacking that player": "ActionList([CreateTokensWithFlags([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])], [EntersTapped, EntersAttackingPlayer({{ThatPlayer}})])])",
    "create {{a}} {{PT}} {{CreatureToken}}. Each opponent attacking that player does the same": "ActionList([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])]), EachPlayerAction(And([Opponent, IsAttackingPlayer({{ThatPlayer}})]), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])]))])",
    "destroy all {{Permanents}} that player controls that didn't attack, except for {{Permanents}} the player hasn't controlled continuously since the beginning of the turn": "ActionList([DestroyEachPermanent(And([{{Permanents[0]}}, ControlledByAPlayer(SinglePlayer({{ThatPlayer}})), DidntAttackThisTurn, Not(And([{{Permanents[1]}}, NotControlledSinceBeginningOfTurn]))]))])",
    "destroy target nonland permanent of that player's choice that one of your opponents controls": "Targeted([TargetPermanentOfPlayersChoice(And([IsNonCardtype(Land), ControlledByAPlayer(Opponent)]), {{ThatPlayer}})], ActionList([DestroyPermanent(Ref_TargetPermanent)]))",
    "destroy target {{Permanent}} that player controls": "Targeted([TargetPermanent(And([{{Permanent[0]}}, ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))], ActionList([DestroyPermanent(Ref_TargetPermanent)]))",
    "destroy target {{Permanent}} that player controls of their choice. It can't be regenerated": "Targeted([TargetPermanentOfPlayersChoice(And([{{Permanent[0]}}, ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]), {{ThatPlayer}})], ActionList([DestroyPermanentNoRegen(Ref_TargetPermanent)]))",
    "destroy up to one target {{Permanent}} that player controls": "Targeted([UptoOneTargetPermanent(And([{{Permanent[0]}}, ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))], ActionList([DestroyPermanent(Ref_TargetPermanent)]))",
    "draw a card if {{Condition(ThatPlayer)}}. Then you create a Treasure token if {{Condition(ThatPlayer)}}. Then you gain {{Digits}} life if {{Condition(ThatPlayer)}}": "ActionList([If({{Condition(ThatPlayer=^ThatPlayer)[0]}}, [DrawACard]), If({{Condition(ThatPlayer=^ThatPlayer)[1]}}, [CreateTokens([TreasureToken])]), If({{Condition(ThatPlayer=^ThatPlayer)[2]}}, [GainLife({{Digits[0]}})])])",
    "draw a card, then discard a card. That player loses life equal to the discarded card's mana value": "ActionList([DrawACard, DiscardACard, PlayerAction({{ThatPlayer}}, LoseLife(ManaValueOfTheCardDiscardedThisWay))])",
    "each of that player's opponents may draw a card": "ActionList([EachPlayerAction(OpponentOf({{ThatPlayer}}), DrawACard)])",
    "each other player draws a card": "ActionList([EachPlayerAction(Other({{ThatPlayer}}), DrawACard)])",
    "exile a random creature card from that player's library. Create a token that's a copy of that card, except it's {{a}} {{PT}} enchantment creature": "ActionList([ExileACardOfTypeFromPlayersLibraryAtRandom(IsCardtype(Creature), {{ThatPlayer}}), CreateTokens([TokenCopyOfExiledCard(TheCardExiledThisWay, TokenCopyEffects([SetPT({{PT[0]}}), SetCardtypes([Enchantment, Creature])]))])])",
    "exile all cards from that player's hand, then they draw that many cards. You may play lands and cast spells from among the exiled cards for as long as they remain exiled. If you cast a spell this way, you may spend mana as though it were mana of any color to cast it": "ActionList([ExilePlayersHand({{ThatPlayer}}), PlayerAction({{ThatPlayer}}, DrawNumberCards(NumHandCardsExiledThisWay)), CreatePlayerEffectUntil(You, [MayPlayLandsFromAmongExiled(TheCardsExiledThisWay), MayCastSpellsFromAmongExiledWithoutPaying(AnySpell, TheCardsExiledThisWay)], UntilCardsAreNoLongerExiled(TheCardsExiledThisWay))])",
    "exile target {{Permanent}} that player controls": "Targeted([TargetPermanent(And([{{Permanent[0]}}, ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))], ActionList([ExilePermanent(Ref_TargetPermanent)]))",
    "exile the top card of that player's library face down. You may look at and play that card for as long as it remains exiled, and you may spend mana as though it were mana of any color to cast that spell": "ActionList([ExileTheTopCardOfPlayersLibraryFaceDown({{ThatPlayer}}), CreatePlayerEffectUntil(You, [MayLookAtFaceDownExiledCard(TheCardExiledThisWay), MayCastExiledCardAndMaySpendManaAsThoughAnyColorToCast(TheCardExiledThisWay)], UntilCardIsNoLongerExiled(TheCardExiledThisWay))])",
    "exile the top card of that player's library face down. You may look at it for as long as it remains exiled": "ActionList([ExileTheTopCardOfPlayersLibraryFaceDown({{ThatPlayer}}), CreatePlayerEffectUntil(You, [MayLookAtFaceDownExiledCard(TheCardExiledThisWay)], UntilCardIsNoLongerExiled(TheCardExiledThisWay))])",
    "exile the top card of that player's library. If it's a permanent card, you may put it onto the battlefield under your control. If you don't, create {{a}} {{PT}} {{CreatureToken}}": "ActionList([ExileTheTopCardOfPlayersLibrary({{ThatPlayer}}), If(ACardWasExiledThisWay(IsPermanent), [MayCost(PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersUnderPlayersControl(You)])), If(CostWasPaid, [CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])])])])",
    "exile the top card of that player's library. It perpetually becomes an artifact if it's a nonland permanent card. Until end of turn, you may play the exiled card": "ActionList([ExileTheTopCardOfPlayersLibrary({{ThatPlayer}}), If(ExiledCardPassesFilter(TheCardExiledThisWay, And([IsNonCardtype(Land), IsPermanent])), [CreatePerpetualExiledCardEffect(TheCardExiledThisWay, [AddCardtype(Artifact)])]), CreatePlayerEffectUntil(You, [MayPlayExiledCard(TheCardExiledThisWay)], UntilEndOfTurn)])",
    "exile the top card of that player's library. You gain life equal to that card's mana value. Until end of turn, you may cast that card and you may spend mana as though it were mana of any color to cast that spell": "ActionList([ExileTheTopCardOfPlayersLibrary({{ThatPlayer}}), GainLife(ManaValueOfExiled(TheCardExiledThisWay)), CreatePlayerEffectUntil(You, [MayCastExiledCardAndMaySpendManaAsThoughAnyColorToCast(TheCardExiledThisWay)], UntilEndOfTurn)])",
    "exile the top card of that player's library. You may cast it. If you don't, create a Treasure token": "ActionList([ExileTheTopCardOfPlayersLibrary({{ThatPlayer}}), MayCost(CastSpellFromExile(AnySpell, TheCardExiledThisWay)), If(CostWasntPaid, [CreateTokens([TreasureToken])])])",
    "exile the top card of that player's library. You may cast that card for as long as it remains exiled": "ActionList([ExileTheTopCardOfPlayersLibrary({{ThatPlayer}}), CreatePlayerEffectUntil(You, [MayCastExiledCard(TheCardExiledThisWay)], UntilCardIsNoLongerExiled(TheCardExiledThisWay))])",
    "exile the top card of that player's library. You may play that card for as long as it remains exiled, and you may spend mana as though it were mana of any color to cast it": "ActionList([ExileTheTopCardOfPlayersLibrary({{ThatPlayer}}), CreatePlayerEffectUntil(You, [MayCastExiledCardAndMaySpendManaAsThoughAnyColorToCast(TheCardExiledThisWay)], UntilCardIsNoLongerExiled(TheCardExiledThisWay))])",
    "exile the top card of their library. During any turn you attacked with {{a}} {{Permanent}}, you may cast that card and you may spend mana as though it were mana of any color to cast that spell": "ActionList([ExileTheTopCardOfPlayersLibrary({{ThatPlayer}}), CreatePlayerEffectUntil(You, [MayCastExiledCardAndMaySpendManaAsThoughAnyColorToCastIf(TheCardExiledThisWay, PlayerPassesFilter(You, AttackedWithCreaturesThisTurn))], UntilCardIsNoLongerExiled(TheCardExiledThisWay))])",
    "exile the top {{Number}} cards of that player's library, then put a creature card from among them onto the battlefield under your control": "ActionList([ExileTheTopNumberCardsOfPlayersLibrary({{Number[0]}}, {{ThatPlayer}}), ReturnAnExiledCardToBattlefield(And([IsCardtype(Creature), WasExiledThisWay]), [EntersUnderPlayersControl(You)])])",
    "exile up to {{Number}} target cards from that player's graveyard": "Targeted([UptoNumberTargetGraveyardCards({{Number[0]}}, InAPlayersGraveyard(SinglePlayer({{ThatPlayer}})))], ActionList([ExileEachGraveyardCard(Ref_TargetGraveyardCards)]))",
    "exile {{a}} {{SpecificCard}} from their library at random. During any turn you attacked with {{a}} {{Zombie}} or {{Zombie}}, you may cast that card and you may spend mana as though it were mana of any color to cast that spell": "ActionList([ExileACardOfTypeFromPlayersLibraryAtRandom({{SpecificCard[0]}}, {{ThatPlayer}}), CreatePlayerEffectUntil(You, [MayCastExiledCardAndMaySpendManaAsThoughAnyColorToCastIf(TheCardExiledThisWay, PlayerPassesFilter(You, AttackedWithACreatureThisTurn(Or([IsCreatureType({{Zombie[0]}}), IsCreatureType({{Zombie[1]}})]))))], UntilCardIsNoLongerExiled(TheCardExiledThisWay))])",
    "gain control of all artifacts that player controls": "ActionList([GainControlOfEachPermanent(And([IsCardtype(Artifact), ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))])",
    "gain control of target {{Permanent}} that player controls": "Targeted([TargetPermanent(And([{{Permanent[0]}}, ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))], ActionList([GainControlOfPermanent(Ref_TargetPermanent)]))",
    "gain control of target {{Permanent}} that player controls for as long as they're the monarch": "Targeted([TargetPermanent(And([{{Permanent[0]}}, ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilAPlayerIsNoLongerTheMonarch(SinglePlayer({{ThatPlayer}})))]))",
    "goad each creature that player controls": "ActionList([GoadEachCreature(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))])",
    "goad target {{Creature}} that player controls": "Targeted([TargetPermanent(And([{{Creature[0]}}, ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))], ActionList([GoadCreature(Ref_TargetPermanent)]))",
    "look at that player's hand": "ActionList([LookAtPlayersHand({{ThatPlayer}})])",
    "look at that player's hand and choose a card from it. The player discards that card": "ActionList([LookAtPlayersHandAndChooseACardToDiscard({{ThatPlayer}}, AnyCard)])",
