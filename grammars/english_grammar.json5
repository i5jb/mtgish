    "land with {{a}} {{CounterType}} counter on it": "And([IsCardtype(Land), HasACounterOfType({{CounterType[0]}})])",
    "land without {{a}} {{CounterType}} counter on it": "And([IsCardtype(Land), HasNoCountersOfType({{CounterType[0]}})])",
    "land you control": "And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You))])",
    "land you control named {{NamedCard}}": "And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You)), IsNamed(NamedCard({{NamedCard[0]}}))])",
    "land you don't control": "And([IsCardtype(Land), ControlledByAPlayer(Other(You))])",
    "legendary land": "And([IsSupertype(Legendary), IsCardtype(Land)])",
    "non-{{Swamp}} land": "And([IsNonLandType({{Swamp[0]}}), IsCardtype(Land)])",
    "non-{{Swamp}} land you control": "And([IsNonLandType({{Swamp[0]}}), IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You))])",
    "nonbasic land": "And([IsNonSupertype(Basic), IsCardtype(Land)])",
    "nonbasic land an opponent controls": "And([IsNonSupertype(Basic), IsCardtype(Land), ControlledByAPlayer(Opponent)])",
    "nonbasic land you don't control": "And([IsNonSupertype(Basic), IsCardtype(Land), ControlledByAPlayer(Other(You))])",
    "noncreature land you control": "And([IsNonCardtype(Creature), IsCardtype(Land)])",
    "nonsnow basic land": "And([IsNonSupertype(Snow), IsSupertype(Basic), IsCardtype(Land)])",
    "nonsnow land you control": "And([IsNonSupertype(Snow), IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You))])",
    "snow land": "And([IsSupertype(Snow), IsCardtype(Land)])",
    "snow land you control": "And([IsSupertype(Snow), IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You))])",
    "snow {{Swamp}}": "And([IsSupertype(Snow), IsLandType({{Swamp[0]}})])",
    "tapped land an opponent controls": "And([IsTapped, IsCardtype(Land), ControlledByAPlayer(Opponent)])",
    "tapped land you control": "And([IsTapped, IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You))])",
    "untapped land": "And([IsUntapped, IsCardtype(Land)])",
    "untapped snow land you control": "And([IsUntapped, IsSupertype(Snow), ControlledByAPlayer(SinglePlayer(You))])",
    "untapped {{Swamp}} you control": "And([IsUntapped, IsLandType({{Swamp[0]}}), ControlledByAPlayer(SinglePlayer(You))])",
    "{{Swamp}}": "IsLandType({{Swamp[0]}})",
    "{{Swamp}} an opponent controls": "And([IsLandType({{Swamp[0]}}), ControlledByAPlayer(Opponent)])",
    "{{Swamp}} or {{Swamp}}": "Or([IsLandType({{Swamp[0]}}), IsLandType({{Swamp[1]}})])",
    "{{Swamp}} or {{Swamp}} an opponent controls": "And([Or([IsLandType({{Swamp[0]}}), IsLandType({{Swamp[1]}})]), ControlledByAPlayer(Opponent)])",
    "{{Swamp}} you control": "And([IsLandType({{Swamp[0]}}), ControlledByAPlayer(SinglePlayer(You))])",
    "{{Swamp}}, {{Swamp}}, or {{Swamp}}": "Or([IsLandType({{Swamp[0]}}), IsLandType({{Swamp[1]}}), IsLandType({{Swamp[2]}})])"
