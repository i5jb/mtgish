  },
  "{{RemoveCountersFromAPermanentCost}}": {
    "Remove a counter from {{a}} {{Permanent}}": "RemoveACounterFromAPermanent({{Permanent[0]}})",
    "Remove one or more {{CounterType}} counters from among {{Permanents}}": "RemoveNumberOrMoreCountersOfTypeFromAmongPermanents(Integer(1), {{CounterType[0]}}, {{Permanents[0]}})",
    "Remove {{Number}} counters from among {{Permanents}}": "RemoveNumberCountersFromAmongPermanents({{Number[0]}}, {{Permanents[0]}})",
    "Remove {{Number}} {{CounterType}} counters from among {{Permanents}}": "RemoveNumberCountersOfTypeFromAmongPermanents({{Number[0]}}, {{CounterType[0]}}, {{Permanents[0]}})",
    "Remove {{a}} {{CounterType}} counter from {{a}} {{Permanent}}": "RemoveACounterOfTypeFromAPermanent({{CounterType[0]}}, {{Permanent[0]}})",
    "Remove {{a}} {{CounterType}} counter from {{a}} {{Permanent}} or suspended card you own": "Or([RemoveACounterOfTypeFromAPermanent({{CounterType[0]}}, {{Permanent[0]}}), RemoveACounterOfTypeFromAnExiledCard({{CounterType[0]}}, IsSuspended)])",
    "Remove {{a}} {{CounterType}} counter or {{a}} {{CounterType}} counter from {{a}} {{Permanent}}": "RemoveACounterOfTypeFromAPermanent(Or([{{CounterType[0]}}, {{CounterType[1]}}]), {{Permanent[0]}})"
  },
  "{{RemoveCountersFromReturnToHandSelfCost(~Permanent)}}": {
    "Remove {{a}} {{CounterType}} counter from this land and return it to its owner's hand": "And([RemoveACounterOfTypeFromPermanent({{CounterType[0]}}, {{~Permanent}}), PutPermanentIntoItsOwnersHand({{~Permanent}})])"
  },
  "{{RemoveCountersFromSelfAndExileCostX(~Permanent)}}": {
    "Remove X {{CounterType}} counters from this artifact and exile it": "RemoveNumberCountersOfTypeFromPermanent(ValueX, {{CounterType[0]}}, {{~Permanent}}), ExilePermanent({{~Permanent}})"
  },
  "{{RemoveCountersFromSelfCost(~Permanent)}}": {
    "Remove a counter from {{ThisPermanent}}": "RemoveACounterFromPermanent({{~Permanent}})",
    "Remove a counter from {{~Permanent}}": "RemoveACounterFromPermanent({{~Permanent}})",
    "Remove all {{CounterType}} counters from {{ThisPermanent}}": "RemoveAllCountersOfTypeFromPermanent({{CounterType[0]}}, {{~Permanent}})",
    "Remove all {{CounterType}} counters from {{~Permanent}}": "RemoveAllCountersOfTypeFromPermanent({{CounterType[0]}}, {{~Permanent}})",
    "Remove {{Digits}} {{CounterType}} counters from {{ThisPermanent}}": "RemoveNumberCountersOfTypeFromPermanent({{Digits[0]}}, {{CounterType[0]}}, {{~Permanent}})",
    "Remove {{Number}} counters from {{ThisPermanent}}": "RemoveNumberCountersFromPermanent({{Number[0]}}, {{~Permanent}})",
    "Remove {{Number}} counters from {{~Permanent}}": "RemoveNumberCountersFromPermanent({{Number[0]}}, {{~Permanent}})",
    "Remove {{Number}} {{CounterType}} counters from {{ThisPermanent}}": "RemoveNumberCountersOfTypeFromPermanent({{Number[0]}}, {{CounterType[0]}}, {{~Permanent}})",
    "Remove {{Number}} {{CounterType}} counters from {{~Permanent}}": "RemoveNumberCountersOfTypeFromPermanent({{Number[0]}}, {{CounterType[0]}}, {{~Permanent}})",
    "Remove {{a}} {{CounterType}} counter from {{ThisPermanent}}": "RemoveACounterOfTypeFromPermanent({{CounterType[0]}}, {{~Permanent}})",
    "Remove {{a}} {{CounterType}} counter from {{~Permanent}}": "RemoveACounterOfTypeFromPermanent({{CounterType[0]}}, {{~Permanent}})"
  },
  "{{RemoveCountersFromSelfCostX(~Permanent)}}": {
    "Remove X {{CounterType}} counters from {{ThisPermanent}}": "RemoveNumberCountersOfTypeFromPermanent(ValueX, {{CounterType[0]}}, {{~Permanent}})",
    "Remove X {{CounterType}} counters from {{~Permanent}}": "RemoveNumberCountersOfTypeFromPermanent(ValueX, {{CounterType[0]}}, {{~Permanent}})"
  },
  "{{ReturnPermanentToHandCostX}}": {
    "Return {{a}} {{Permanent}} with mana value X to its owner's hand": "PutAPermanentIntoItsOwnersHand(And([{{Permanent[0]}}, ManaValueIs(EqualTo(ValueX))]))"
  },
  "{{ReturnPermanentToHandCost}}": {
    "Return {{Number}} {{Permanents}} to their owner's hand": "PutNumberPermanentsIntoOwnersHand({{Number[0]}}, {{Permanents[0]}})",
    "Return {{a}} {{Permanent}} to its owner's hand": "PutAPermanentIntoItsOwnersHand({{Permanent[0]}})"
  },
  "{{ReturnSelfToHandCost(~Permanent)}}": {
    "Return this Aura to its owner's hand": "PutPermanentIntoItsOwnersHand(ThisPermanent)",
    "Return this creature to its owner's hand": "PutPermanentIntoItsOwnersHand(ThisPermanent)",
    "Return this enchantment to its owner's hand": "PutPermanentIntoItsOwnersHand(ThisPermanent)",
    "Return this land to its owner's hand": "PutPermanentIntoItsOwnersHand(ThisPermanent)",
    "Return {{~Permanent}} to its owner's hand": "PutPermanentIntoItsOwnersHand(ThisPermanent)"
  },
  "{{RevealCardsFromHandCost}}": {
    "Reveal your hand": "RevealHand",
    "Reveal {{Number}} cards from your hand that share a color": "RevealNumberGroupCardsFromHand({{Number[0]}}, AnyCard, ShareAColor)",
    "Reveal {{a}} {{SpecificCard}} in your hand": "RevealACardOfTypeFromHand({{SpecificCard[0]}})"
  },
  "{{RevealChoiceCost[TheChosenPlayer]}}": {
    "Reveal the player you chose": "RevealTheChosenPlayer"
  },
  "{{RevealHandCardCostX}}": {
    "Reveal X {{SpecificCards}} from your hand": "RevealAnyNumberOfCardsOfTypeFromHand({{SpecificCards[0]}})"
  },
  "{{RevealHandSelfCost(~HandCard)}}": {
    "Reveal this card from your hand": "RevealCardFromHand({{~HandCard}})",
    "Reveal {{~HandCard}} from your hand": "RevealCardFromHand({{~HandCard}})"
  },
  "{{RollADiceCost}}": {
    "Roll a d8": "RollAD8"
  },
  "{{SacrificeAPermanentCost(ThatPermanent)}}": {
    "Sacrifice another {{Permanent}}": "SacrificeAPermanent(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))",
    "Sacrifice another {{Permanent}} or {{a}} {{Permanent}}": "SacrificeAPermanent(Or([And([Other({{ThatPermanent}}), {{Permanent[0]}}]), {{Permanent[1]}}]))",
    "Sacrifice {{a}} {{Permanent}} or another {{Permanent}}": "SacrificeAPermanent(Or([{{Permanent[0]}}, And([Other({{ThatPermanent}}), {{Permanent[1]}}])]))"
  },
  "{{SacrificeAPermanentCost(~Permanent)}}": {
    "Sacrifice an Equipment attached to {{~Permanent}}": "SacrificeAPermanent(And([IsArtifactType(Equipment), AttachedToPermanent(ThisPermanent)]))",
    "Sacrifice an Aura attached to {{ThisPermanent}}": "SacrificeAPermanent(And([IsEnchantmentType(Aura), AttachedToPermanent(ThisPermanent)]))"
  },
  "{{SacrificeAPermanentCostX(~Permanent)}}": {
    "Sacrifice a creature you control with mana value X other than {{~Permanent}}": "SacrificeAPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), ManaValueIs(EqualTo(ValueX)), Other(ThisPermanent)]))"
  },
  "{{SacrificeAPermanentCostX}}": {
    "Sacrifice an artifact with mana value X": "SacrificeAPermanent(And([IsCardtype(Artifact), ManaValueIs(EqualTo(ValueX))]))"
  },
  "{{SacrificeAPermanentCost[EnchantedPermanent]}}": {
    "Sacrifice {{EnchantedPermanent}}": "SacrificePermanent(HostPermanent)"
  },
  "{{SacrificeAPermanentCost[TheChosenCreatureType]}}": {
    "Sacrifice a creature of the chosen type": "SacrificeAPermanent(And([IsCardtype(Creature), IsCreatureTypeVariable(TheChosenCreatureType)]))"
  },
  "{{SacrificeAPermanentCost}}": {
    "Sacrifice {{a}} {{Permanent}}": "SacrificeAPermanent({{Permanent[0]}})"
  },
  "{{SacrificePermanentsCost(ThatPermanent)}}": {
    "Sacrifice {{Number}} other {{Permanents}}": "SacrificeNumberPermanents({{Number[0]}}, And([Other({{ThatPermanent}}), {{Permanents[0]}}]))"
  },
  "{{SacrificePermanentsCost(X)}}": {
    "Sacrifice X {{Permanents}}": "SacrificeNumberPermanents({{X}}, {{Permanents[0]}})"
  },
  "{{SacrificePermanentsCost(X,ThatPermanent)}}": {
    "Sacrifice X other {{Permanents}}": "SacrificeNumberPermanents({{X}}, And([Other(ThisPermanent), {{Permanents[0]}}]))"
  },
  "{{SacrificePermanentsCost}}": {
    "Sacrifice all {{Permanents}}": "SacrificeEachPermanent({{Permanents[0]}})",
    "Sacrifice up to {{Number}} {{Permanents}}": "SacrificeUptoNumberPermanents({{Number[0]}}, {{Permanents[0]}})",
    "Sacrifice {{Number}} {{Permanents}}": "SacrificeNumberPermanents({{Number[0]}}, {{Permanents[0]}})",
    "Sacrifice {{Number}} {{Permanents}} with different names": "SacrificeNumberGroupPermanents({{Number[0]}}, {{Permanents[0]}}, DifferentNames)",
    "Sacrifice {{a}} {{Permanent}} and {{a}} {{Permanent}}": "And([SacrificeAPermanent({{Permanent[0]}}), SacrificeAPermanent({{Permanent[1]}})])",
    "Sacrifice {{a}} {{Permanent}}, {{a}} {{Permanent}}, and {{a}} {{Permanent}}": "And([SacrificeAPermanent({{Permanent[0]}}), SacrificeAPermanent({{Permanent[1]}}), SacrificeAPermanent({{Permanent[2]}})])"
  },
  "{{SacrificeSelfAndOthersCost(~Permanent)}}": {
    "Sacrifice this artifact and {{Number}} {{Permanents}}": "And([SacrificePermanent({{~Permanent}}), SacrificeNumberPermanents({{Number[0]}}, {{Permanents[0]}})])",
    "Sacrifice this creature and another {{Permanent}}": "And([SacrificePermanent({{~Permanent}}), SacrificeAPermanent({{Permanent[0]}})])",
    "Sacrifice this creature and any number of other {{Permanents}}": "And([SacrificePermanent({{~Permanent}}), SacrificeAnyNumberOfPermanents({{Permanents[0]}})])",
    "Sacrifice this creature and {{a}} {{Permanent}}": "And([SacrificePermanent({{~Permanent}}), SacrificeAPermanent({{Permanent[0]}})])",
    "Sacrifice this land and {{a}} {{Permanent}}": "And([SacrificePermanent({{~Permanent}}), SacrificeAPermanent({{Permanent[0]}})])",
    "Sacrifice {{Number}} {{Permanents}} and this artifact": "And([SacrificeNumberPermanents({{Number[0]}}, {{Permanents[0]}}), SacrificePermanent({{~Permanent}})])",
    "Sacrifice {{a}} {{Permanent}}, {{a}} {{Permanent}}, and this creature": "And([SacrificeAPermanent({{Permanent[0]}}), SacrificeAPermanent({{Permanent[1]}}), SacrificePermanent({{~Permanent}})])",
    "Sacrifice {{~Permanent}} and {{a}} {{Permanent}}": "And([SacrificePermanent({{~Permanent}}), SacrificeAPermanent({{Permanent[0]}})])"
  },
  "{{SacrificeSelfCost(~Permanent)}}": {
    "Sacrifice this Aura": "SacrificePermanent({{~Permanent}})",
    "Sacrifice this Equipment": "SacrificePermanent({{~Permanent}})",
    "Sacrifice this artifact": "SacrificePermanent({{~Permanent}})",
    "Sacrifice this creature": "SacrificePermanent({{~Permanent}})",
    "Sacrifice this enchantment": "SacrificePermanent({{~Permanent}})",
    "Sacrifice this land": "SacrificePermanent({{~Permanent}})",
    "Sacrifice {{~Permanent}}": "SacrificePermanent({{~Permanent}})"
  },
  "{{SagaActions(~Permanent)}}": {
    "Gain control of up to {{Number}} target creatures with total mana value {{Digits}} or less for as long as {{ThisPermanent}} remains on the battlefield":
      "Targeted([UptoNumberTargetGroupPermanents({{Number[0]}}, IsCardtype(Creature), TotalManaValueIs(LessThanOrEqualTo({{Digits[0]}})))], ActionList([GainControlOfEachPermanentUntil(Ref_TargetPermanents, UntilPermanentLeavesBattlefield(ThisPermanent))]))",
    "Add {{ManaProduceSymbol}}": "ActionList([AddMana({{ManaProduceSymbol[0]}})])",
    "Add {{ManaProduceSymbol}} for each {{CounterType}} counter on {{ThisPermanent}}. You may cast an instant or sorcery card exiled with {{ThisPermanent}}, and mana of any type can be spent to cast that spell": "ActionList([AddManaRepeated({{ManaProduceSymbol[0]}}, NumCountersOfTypeOnPermanent({{CounterType[0]}}, ThisPermanent)), MayAction(CastAnExiledCardAndMaySpendManaAsThoughAnyTypeToCast(And([Or([IsCardtype(Instant), IsCardtype(Sorcery)]), TheExiledCards])))])",
    "Add {{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}. If {{~Permanent}} has {{Number}} or more {{CounterType}} counters on it, exile it, then return it to the battlefield": "ActionList([AddMana(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}, {{ManaProduceSymbol[2]}}, {{ManaProduceSymbol[3]}}])), If(PermanentPassesFilter(ThisPermanent, HasNumCountersOfType(GreaterThanOrEqualTo({{Number[0]}}), {{CounterType[0]}})), [ExilePermanent(ThisPermanent), PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersNormally])])])",
    "Another target creature you control gets {{PTMod}} and gains {{Hasable}} until end of turn": "Targeted([TargetPermanent(And([Other({{~Permanent}}), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Another target {{Permanent}} phases out. It can't phase in for as long as you control {{ThisPermanent}}": "Targeted([TargetPermanent(And([Other({{~Permanent}}), {{Permanent[0]}}]))], ActionList([PhaseOutPermanent(Ref_TargetPermanent), CreateGameEffect(UntilPermanentChangesControl(You, {{~Permanent}}), PermanentCantPhaseIn(Ref_TargetPermanent))]))",
    "Choose a creature card name, then goad all creatures with a name chosen for {{ThisPermanent}}": "ActionList([ChooseACardName(IsCardtype(Creature)), GoadEachCreature(And([IsCardtype(Creature), IsNamed(ANameChosenByPermanent({{~Permanent}}))]))])",
    "Choose one at random -\n* {{FlavorWord}} - Put {{Number}} {{CounterType}} counters on target {{Permanent}}.\n* {{FlavorWord}} - Put {{a}} {{CounterType}} counter on target {{Permanent}}. You gain {{Digits}} life.\n* {{FlavorWord}} - {{ThisPermanent}} fights up to one target {{Creature}}": "Modal_ChooseOneAtRandom([Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[0]}}, Ref_TargetPermanent)])), Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutACounterOfTypeOnPermanent({{CounterType[1]}}, Ref_TargetPermanent)])), Targeted([TargetPermanent({{Creature[0]}})], ActionList([HaveCreaturesFight(ThisPermanent, Ref_TargetPermanent)]))])",
    "Choose up to {{Number}} {{Zombies}}. You may exile all other creatures. If you do, {{ThisPermanent}} deals {{Digits}} damage to you": "ActionList([ChooseUptoNumberPermanents({{Number[0]}}, IsCreatureType({{Zombies[0]}})), MayCost(ExileEachPermanent(And([ExceptFor(ThePermanentsChosenThisWay), IsCardtype(Creature)]))), If(CostWasPaid, [PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Player(You))])])",
    "Create a token that's a copy of a card exiled with {{ThisPermanent}}, except it isn't legendary and is {{a}} {{Zombie}} in addition to its other types": "ActionList([CreateTokens([TokenCopyOfAnExiledCard(TheExiledCards, TokenCopyEffects([RemoveSupertypes([Legendary]), AddCreatureTypes([{{Zombie[0]}}])]))])])",
    "Create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}} for each {{Eachable(~Permanent)}}": "ActionList([CreateTokens([NumberTokens({{Eachable(~Permanent=^~Permanent)[0]}}, TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}]))])])",
    "Destroy all other permanents except for artifacts, lands, and {{Zombies}}. Exile {{ThisPermanent}}, then return it to the battlefield": "ActionList([DestroyEachPermanent(And([Other({{~Permanent}}), ExceptFor(Or([IsCardtype(Artifact), IsCardtype(Land), IsCreatureType({{Zombies[0]}})]))])), ExilePermanent({{~Permanent}}), PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersNormally])])",
    "Destroy target {{Permanent}}. Exile {{~Permanent}}, then return it to the battlefield": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([DestroyPermanent(Ref_TargetPermanent), ExilePermanent(ThisPermanent), PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersNormally])]))",
    "Discard a card, then draw {{Number}} cards. When you discard a card this way, {{ThisPermanent}} deals damage equal to that card's mana value to each opponent": "ActionList([DiscardACard, If(ACardWasDiscardedThisWay(AnyCard), [ReflexiveTrigger(ActionList([PermanentDealsDamage(ThisPermanent, ManaValueOfTheCardDiscardedThisWay, EachPlayer(Opponent))]))]), DrawNumberCards({{Number[0]}})])",
    "Draw a card. Then you may reveal {{a}} {{SpecificCard}} from your hand. When you do, {{ThisPermanent}} deals {{Digits}} damage to target {{PlayerOrPlaneswalker}}": "ActionList([DrawACard, MayCost(RevealACardOfTypeFromHand({{SpecificCard[0]}})), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPlayerOrPermanent({{PlayerOrPlaneswalker[0]}})], ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Ref_TargetPlayerOrPermanent)])))])])",
    "Draw cards equal to {{GameNumber}}. You have no maximum hand size for as long as you control {{ThisPermanent}}": "ActionList([DrawNumberCards({{GameNumber[0]}}), CreatePlayerEffectUntil(You, [HasNoMaximumHandSize], UntilPermanentChangesControl(You, {{~Permanent}}))])",
    "Each opponent sacrifices {{a}} {{Permanent}} of their choice and loses {{Digits}} life": "ActionList([EachPlayerActions(Opponent, [SacrificeAPermanent({{Permanent[0]}}), LoseLife({{Digits[0]}})])])",
    "Each player creates {{Number}} tapped {{PT}} {{CreatureTokens}}. The tokens are goaded for as long as {{ThisPermanent}} remains on the battlefield": "ActionList([EachPlayerAction(AnyPlayer, CreateTokensWithFlags([NumberTokens({{Number[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))], [EntersTapped])), CreateEachPermanentRuleEffectUntil(TheTokensCreatedThisWay, [IsGoadedByPlayer(You)], UntilPermanentLeavesBattlefield({{~Permanent}}))])",
    "Exile cards from the top of your library until you exile {{a}} {{SpecificCard}}. You may play that card for as long as {{ThisPermanent}} remains on the battlefield. Put the rest of those exiled cards on the bottom of your library in a random order": "ActionList([ExileTopCardsOfLibraryUntilASingleCardOfTypeIsExiled({{SpecificCard[0]}}), CreatePlayerEffectUntil(You, [MayPlayExiledCard(TheSpecificCardExiledThisWay)], UntilPermanentLeavesBattlefield({{~Permanent}})), PutEachExiledCardOnTheBottomOfTheirOwnersLibraryInARandomOrder(TheNonSpecificCardsExiledThisWay)])",
    "Exile target {{Permanent}} until {{ThisPermanent}} leaves the battlefield": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([ExilePermanentUntil(Ref_TargetPermanent, UntilPermanentLeavesBattlefield({{~Permanent}}))]))",
    "Exile the top card of your library. During any turn you put {{a}} {{CounterType}} counter on {{ThisPermanent}}, you may play that card": "ActionList([ExileTopCardOfLibrary, CreatePlayerEffect(You, [MayPlayExiledCardIf(TheCardExiledThisWay, PlayerPassesFilter(You, HasPutANumberOfCountersOfTypeOnAPermanentThisTurn(GreaterThanOrEqualTo(Integer(1)), {{CounterType[0]}}, SinglePermanent(ThisPermanent))))])])",
    "Exile {{a}} {{SpecificCard}} from each graveyard": "ActionList([ExileACardFromEachPlayersGraveyard({{SpecificCard[0]}}, AnyPlayer)])",
    "For each opponent, gain control of up to one target {{Permanent}} that player controls for as long as {{ThisPermanent}} remains on the battlefield": "Targeted([UptoOneTargetPermanentEachPlayerControls({{Permanent[0]}}, Opponent)], ActionList([GainControlOfEachPermanentUntil(Ref_TargetPermanents, UntilPermanentLeavesBattlefield({{~Permanent}}))]))",
    "For each player, exile up to one other target {{Permanent}} that player controls until {{ThisPermanent}} leaves the battlefield": "Targeted([UptoOneTargetPermanentEachPlayerControls(And([Other({{~Permanent}}), {{Permanent[0]}}]), AnyPlayer)], ActionList([ExileEachPermanentUntil(Ref_TargetPermanents, UntilPermanentLeavesBattlefield({{~Permanent}}))]))",
    "For each player, exile up to one target {{Permanent}} that player controls until {{ThisPermanent}} leaves the battlefield": "Targeted([UptoOneTargetPermanentEachPlayerControls({{Permanent[0]}}, AnyPlayer)], ActionList([ExileEachPermanentUntil(Ref_TargetPermanents, UntilPermanentLeavesBattlefield({{~Permanent}}))]))",
    "Gain control of target {{Permanent}} for as long as you control {{ThisPermanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilPermanentChangesControl(You, {{~Permanent}}))]))",
    "Gain control of target {{Permanent}} for as long as {{ThisPermanent}} remains on the battlefield": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilPermanentLeavesBattlefield({{~Permanent}}))]))",
    "Gain control of up to one target {{Permanent}} for as long as you control {{ThisPermanent}}. The Ring tempts you": "Targeted([UptoOneTargetPermanent({{Permanent[0]}})], ActionList([GainControlOfPermanentUntil(Ref_TargetPermanent, UntilPermanentChangesControl(You, {{~Permanent}})), TemptWithRing]))",
    "Mill {{Number}} cards. When you do, {{ThisPermanent}} deals damage equal to {{GameNumber}} to target {{Creature}}": "ActionList([MustCost(MillNumberCards({{Number[0]}})), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPermanent({{Creature[0]}})], ActionList([PermanentDealsDamage(ThisPermanent, {{GameNumber[0]}}, Permanent(Ref_TargetPermanent))])))])])",
    "Note a creature type that hasn't been noted for {{ThisPermanent}}. When you next cast a creature spell of that type this turn, that creature enters with an additional {{CounterType}} counter on it": "ActionList([NoteAnUnnotedCreatureType(AnyCreatureType), CreateFutureTrigger(WhenPlayerCastsTheirNextSpellThisTurn(You, And([IsCardtype(Creature), IsCreatureTypeVariable(TheNotedCreatureType)])), ActionList([CreateSpellEffect(Trigger_ThatSpell, [EntersWithACounter({{CounterType[0]}})])]))])",
    "Put all {{SpecificCards}} exiled with {{ThisPermanent}} onto the battlefield face down under your control. They're {{PT}} {{Zombie}} artifact creatures": "ActionList([PutEachExiledCardOntoTheBattlefieldFaceDownAsAnArtifactCreature(And([{{SpecificCards[0]}}, WasExiledWithPermanent({{~Permanent}})]), {{PT[0]}}, {{Zombie[0]}})])",
    "Put all {{SpecificCards}} from all graveyards onto the battlefield under your control. Exile {{ThisPermanent}}, then return it to the battlefield": "ActionList([PutEachCardFromEachPlayersGraveyardOntoTheBattlefield({{SpecificCards[0]}}, AnyPlayer, [EntersUnderPlayersControl(You)]), ExilePermanent({{~Permanent}}), PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersNormally])])",
    "Return any number of target creature cards with total mana value {{Digits}} or less from your graveyard to the battlefield. Exile {{~Permanent}}, then return it to the battlefield": "Targeted([AnyNumberOfTargetGroupGraveyardCards(And([IsCardtype(Creature), InAPlayersGraveyard(SinglePlayer(You))]), TotalManaValueIs(LessThanOrEqualTo({{Digits[0]}})))], ActionList([PutEachGraveyardCardOntoBattlefield(Ref_TargetGraveyardCards, [EntersNormally]), ExilePermanent(ThisPermanent), PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersNormally])]))",
    "Return {{Number}} cards exiled with {{ThisPermanent}} to the battlefield under their owners' control and put the rest on the bottom of their owners' libraries": "ActionList([PutNumberCardsFromExileOntoBattlefield({{Number[0]}}, WasExiledWithPermanent({{~Permanent}}), [EntersUnderOwnersControl]), PutEachExiledCardOnTheBottomOfTheirOwnersLibraryInAnyOrder(WasExiledWithPermanent({{~Permanent}}))])",
    "Sacrifice {{a}} {{Permanent}}. If you do, {{ThisPermanent}} deals {{Digits}} damage to each {{Creature}}": "ActionList([MayCost(SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, EachPermanent({{Creature[0]}}))])])",
    "Starting with you, each player votes for innocent or guilty. If guilty gets more votes, the owner of each card exiled with {{ThisPermanent}} puts that card on the bottom of their library": "ActionList([EachPlayerStartingWithAction(AnyPlayer, You, [VoteForAWord([\"Innocent\", \"Guilty\"])]), If(MostVotesForWordIs(\"Guilty\"), [PutEachExiledCardOnTheBottomOfTheirOwnersLibraryInAnyOrder(WasExiledWithPermanent({{~Permanent}}))])])",
    "Tap all lands your opponents control. Exile {{~Permanent}}, then return it to the battlefield": "ActionList([TapEachPermanent(And([IsCardtype(Land), ControlledByAPlayer(Opponent)])), ExilePermanent(ThisPermanent), PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersNormally])])",
    "Tap any number of untapped artifacts you control. When you do, {{ThisPermanent}} deals that much damage to target {{CreatureOrPlaneswalker}}": "ActionList([MayCost(TapAnyNumberOfPermanents(And([IsUntapped, IsCardtype(Artifact), ControlledByAPlayer(SinglePlayer(You))]))), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPermanent({{CreatureOrPlaneswalker[0]}})], ActionList([PermanentDealsDamage({{~Permanent}}, TheNumberOfPermanentsTappedThisWay, Permanent(Ref_TargetPermanent))])))])])",
    "Tap target {{Permanent}}. It doesn't untap during its controller's untap step for as long as you control {{ThisPermanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), PermanentDoesntUntapDuringControllersNextUntap(Ref_TargetPermanent)]))",
    "Target {{Permanent}} gains {{Hasable}} for as long as you control {{ThisPermanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilPermanentChangesControl(You, {{~Permanent}}))]))",
    "Until end of turn, target {{Creature}} gains {{Hasable}} and gets {{PTModX}}, where X is {{GameNumber(~Permanent)}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}]), AdjustPTX({{PTModX[0]}}, {{GameNumber(~Permanent=^~Permanent)[0]}})], UntilEndOfTurn)]))",
    "Until end of turn, you may cast spells from among cards exiled with {{ThisPermanent}}, and you may spend mana as though it were mana of any color to cast those spells": "ActionList([CreatePlayerEffectUntil(You, [MayCastSpellsFromAmongExiledAndMaySpendManaAsThoughAnyColorToCast(AnySpell, TheExiledCards)], UntilEndOfTurn)])",
    "Until end of turn, you may cast {{PotentialSpells}} from any graveyard. If a spell cast this way would be put into a graveyard, exile it instead. Exile {{ThisPermanent}}, then return it to the battlefield": "ActionList([CreatePlayerEffectUntil(You, [MayCastSpellsFromGraveyardIntoExile({{PotentialSpells[0]}})], UntilEndOfTurn), ExilePermanent({{~Permanent}}), PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersNormally])])",
    "Until end of turn, {{Permanents}} gain \"{{QuotedAbility}}\". Exile {{ThisPermanent}}, then return it to the battlefield": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{QuotedAbility[0]}}])], UntilEndOfTurn), ExilePermanent({{~Permanent}}), PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersNormally])])",
    "Up to one target {{Creature}} can't block for as long as you control {{ThisPermanent}}. The Ring tempts you": "Targeted([UptoOneTargetPermanent({{Creature[0]}})], ActionList([CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [CantBlock], UntilPermanentChangesControl(You, {{~Permanent}}))]))",
    "You may cast any number of spells from your hand without paying their mana costs. Exile {{ThisPermanent}}, then return it to the battlefield": "ActionList([MayAction(CastAnyNumberOfSpellsFromHandWithoutPaying(AnySpell)), ExilePermanent({{~Permanent}}), PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersNormally])])",
    "You may sacrifice {{a}} {{Permanent}}. When you do, {{ThisPermanent}} deals {{Digits}} damage to any target": "ActionList([MayCost(SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [ReflexiveTrigger(Targeted([AnyTarget], ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Ref_AnyTarget)])))])])",
    "{{ThisPermanent}} deals X damage to target opponent, where X is {{GameNumber}}": "Targeted([TargetPlayer(Opponent)], ActionList([PermanentDealsDamage(ThisPermanent, {{GameNumber[0]}}, Player(Ref_TargetPlayer))]))",
    "{{ThisPermanent}} deals X damage to any target and X damage to any other target, where X is {{GameNumber}}": "Targeted([NumberAnyTargets(Integer(2))], ActionList([PermanentDealsDamage({{~Permanent}}, {{GameNumber[0]}}, Ref_AnyTargets)]))",
    "{{ThisPermanent}} deals damage equal to the total mana value of other permanents you control to each opponent": "ActionList([PermanentDealsDamage(ThisPermanent, TotalManaValueOfPermanents(And([Other(ThisPermanent), IsPermanent, ControlledByAPlayer(SinglePlayer(You))])), EachPlayer(Opponent))])",
    "{{ThisPermanent}} deals damage equal to {{GameNumber}} to target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([PermanentDealsDamage(ThisPermanent, {{GameNumber[0]}}, Permanent(Ref_TargetPermanent))]))",
    "{{ThisPermanent}} deals {{Digits}} damage to any target": "Targeted([AnyTarget], ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Ref_AnyTarget)]))",
    "{{ThisPermanent}} deals {{Digits}} damage to each of up to {{Number}} target {{Creatures}}": "Targeted([UptoNumberTargetPermanents({{Number[0]}}, {{Creatures[0]}})], ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, EachPermanent(Ref_TargetPermanents))]))",
    "{{ThisPermanent}} deals {{Digits}} damage to each opponent": "ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, EachPlayer(Opponent))])",
    "{{ThisPermanent}} deals {{Digits}} damage to each opponent and each planeswalker they control": "ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, MultipleRecipients([EachPlayer(Opponent), EachPermanent(And([IsCardtype(Planeswalker), ControlledByAPlayer(Opponent)]))]))])",
    "{{ThisPermanent}} deals {{Digits}} damage to each opponent and you gain {{Digits}} life": "ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, EachPlayer(Opponent)), GainLife({{Digits[1]}})])",
    "{{ThisPermanent}} deals {{Digits}} damage to each opponent. Then if {{Condition}}, draw {{Number}} cards. Otherwise, exile {{ThisPermanent}} and you may cast it this turn": "ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, EachPlayer(Opponent)), IfElse({{Condition[0]}}, [DrawNumberCards({{Number[0]}})], [ExilePermanent({{~Permanent}}), CreatePlayerEffectUntil(You, [MayCastExiledCard(TheCardExiledThisWay)], UntilEndOfTurn)])])",
    "{{ThisPermanent}} deals {{Digits}} damage to each {{CreatureOrPlaneswalker}}": "ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, EachPermanent({{CreatureOrPlaneswalker[0]}}))])",
    "{{ThisPermanent}} deals {{Digits}} damage to each {{Creature}}": "ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, EachPermanent({{Creature[0]}}))])",
    "{{ThisPermanent}} deals {{Digits}} damage to each {{Creature}} and each opponent": "ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, MultipleRecipients([EachPermanent({{Creature[0]}}), EachPlayer(Opponent)]))])",
    "{{ThisPermanent}} deals {{Digits}} damage to each {{Creature}} and each {{Planeswalker}}": "ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, MultipleRecipients([EachPermanent({{Creature[0]}}), EachPermanent({{Planeswalker[0]}})]))])",
    "{{ThisPermanent}} deals {{Digits}} damage to target opponent and each creature they control": "Targeted([TargetPlayer(Opponent)], ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, MultipleRecipients([Player(Ref_TargetPlayer), EachPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]))]))]))",
    "{{ThisPermanent}} deals {{Digits}} damage to target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent))]))",
    "{{ThisPermanent}} gains \"{{SagaQuotedAbility}}\"": "ActionList([CreatePermanentLayerEffect({{~Permanent}}, [AddAbility([{{SagaQuotedAbility[0]}}])])])",
    "{{~Permanent}} deals {{Digits}} damage to each creature and each planeswalker. {{~Permanent}} gains \"{{QuotedAbility}}\"": "ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, MultipleRecipients([EachPermanent(IsCardtype(Creature)), EachPermanent(IsCardtype(Planeswalker))])), CreatePermanentLayerEffect({{~Permanent}}, [AddAbility([{{QuotedAbility[0]}}])])])",
    "{{~Permanent}} deals {{Digits}} damage to each opponent": "ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, EachPlayer(Opponent))])",
    "{{~Permanent}} deals {{Digits}} damage to each {{Creature}} and each {{Planeswalker}}": "ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, MultipleRecipients([EachPermanent({{Creature[0]}}), EachPermanent({{Planeswalker[0]}})]))])",
    "{{~Permanent}} fights up to one other target creature": "Targeted([UptoOneTargetPermanent(And([Other(ThisPermanent), IsCardtype(Creature)]))], ActionList([HaveCreaturesFight(ThisPermanent, Ref_TargetPermanent)]))"
  },
  "{{SagaActions[ExileACard]}}": {
    "Exile up to one target {{Permanent}}": "Targeted([UptoOneTargetPermanent({{Permanent[0]}})], ActionList([ExilePermanent(Ref_TargetPermanent)]))",
    "Exile {{a}} {{SpecificCard}} from your graveyard. You gain life equal to its mana value": "ActionList([Exile([AGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))]), GainLife(ManaValueOfExiled(TheCardExiledThisWay))])",
    "Search your library for a card, exile it face down, then shuffle": "ActionList([SearchLibrary([FindAGenericCard, ExileFoundCardsFaceDown, Shuffle])])"
  },
  "{{SagaActions[TheExiledCard](~Permanent)}}": {
    "Return {{ThisPermanent}} and the exiled card to their owner's hand": "ActionList([PutPermanentIntoOwnersGraveyard({{~Permanent}}), PutExiledCardIntoOwnersHand(TheExiledCard)])"
  },
  "{{SagaActions[TheExiledCard]}}": {
    "Put a number of {{CounterType}} counters on target {{Permanent}} equal to the mana value of the exiled card": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutNumberCountersOfTypeOnPermanent(ManaValueOfExiled(TheExiledCard), {{CounterType[0]}}, Ref_TargetPermanent)]))",
    "Return the exiled card to the battlefield under its owner's control": "ActionList([PutExiledCardOntoBattlefield(TheExiledCard, [EntersUnderOwnersControl])])",
    "Turn the exiled card face up. If it's {{a}} {{SpecificCard}}, you lose life equal to its mana value": "ActionList([TurnExiledCardFaceUp(TheExiledCard), If(ExiledCardPassesFilter(TheExiledCard, {{SpecificCard[0]}}), [LoseLife(ManaValueOfExiled(TheExiledCard))])])",
    "You may put the exiled card onto the battlefield if it's {{a}} {{SpecificCard}}. If you don't put it onto the battlefield, put it into its owner's hand": "ActionList([If(ExiledCardPassesFilter(TheExiledCard, {{SpecificCard[0]}}), [MayActions([PutExiledCardOntoBattlefield(TheExiledCard, [EntersNormally])]), PutExiledCardIntoOwnersHand(TheExiledCard)])])"
  },
  "{{SagaActions}}": {
    "You may put {{a}} {{SpecificCard}} from your hand onto the battlefield. If you don't, draw a card": "ActionList([MayCost(PutACardFromHandOnBattlefield({{SpecificCard[0]}}, [EntersNormally])), Unless(CostWasPaid, [DrawACard])])",
    "Create a Treasure token for each {{Eachable}}": "ActionList([CreateTokens([NumberTokens({{Eachable[0]}}, TreasureToken)])])",

    "Add one mana of any color": "ActionList([AddMana(AnyManaColor)])",
    "Add {{ManaProduceSymbol}} for each {{Eachable}}. Until end of turn, you don't lose this mana as steps and phases end": "ActionList([AddManaRepeatedWithModifiers({{ManaProduceSymbol[0]}}, {{Eachable[0]}}, DontLoseAsStepsAndPhasesEnd(UntilEndOfTurn))])",
    "Add {{ManaProduceSymbol}}. Put {{Number}} {{CounterType}} counters on up to one target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([AddMana({{ManaProduceSymbol[0]}}), PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[0]}}, Ref_TargetPermanent)]))",
    "Add {{ManaProduceSymbol}}{{ManaProduceSymbol}}": "ActionList([AddMana(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}]))])",
    "Add {{ManaProduceSymbol}}{{ManaProduceSymbol}}, {{ManaProduceSymbol}}{{ManaProduceSymbol}}, {{ManaProduceSymbol}}{{ManaProduceSymbol}}, {{ManaProduceSymbol}}{{ManaProduceSymbol}}, and {{ManaProduceSymbol}}{{ManaProduceSymbol}}. Exile {{~Permanent}}, then return it to the battlefield": "ActionList([AddMana(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}, {{ManaProduceSymbol[2]}}, {{ManaProduceSymbol[3]}}, {{ManaProduceSymbol[4]}}, {{ManaProduceSymbol[5]}}, {{ManaProduceSymbol[6]}}, {{ManaProduceSymbol[7]}}, {{ManaProduceSymbol[8]}}, {{ManaProduceSymbol[9]}}])), ExilePermanent(ThisPermanent), PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersNormally])])",
    "Add {{ManaProduceSymbol}}{{ManaProduceSymbol}}. Spend this mana only to foretell cards or cast spells that have foretell": "ActionList([AddManaWithModifiers(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}]), Or([CanOnlySpendToForetellCards, CanOnlySpendToCastForetoldSpells]))])",
    "Add {{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}": "ActionList([AddMana(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}, {{ManaProduceSymbol[2]}}]))])",
    "Add {{Number}} {{ManaProduceSymbol}}": "ActionList([AddManaRepeated({{ManaProduceSymbol[0]}}, {{Number[0]}})])",
    "All creature cards you own with mana value {{Digits}} or less perpetually get {{PTMod}}": "ActionList([CreatePerpetualAllCardsEffect(And([IsCardtype(Creature), OwnedByAPlayer(SinglePlayer(You)), ManaValueIs(LessThanOrEqualTo({{Digits[0]}}))]), [AdjustPT({{PTMod[0]}})])])",
    "Amass Orcs {{Digits}}": "ActionList([Amass({{Digits[0]}}, Orc)])",
    "Any number of target {{Creatures}} have base power and toughness {{PT}}": "Targeted([AnyNumberOfTargetPermanents({{Creatures[0]}})], ActionList([CreateEachPermanentLayerEffect(Ref_TargetPermanents, [SetPT({{PT[0]}})])]))",
    "Choose a card name": "ActionList([ChooseACardName(AnyOracleCard)])",
    "Choose a card name. Search target opponent's graveyard, hand, and library for up to {{Number}} cards with that name and exile them. Then that player shuffles": "Targeted([TargetPlayer(Opponent)], ActionList([ChooseACardName(AnyOracleCard), SearchPlayersLibraryAndGraveyardAndHand(Ref_TargetPlayer, [FindUptoNumberCardsOfType({{Number[0]}}, IsNamed(TheChosenName)), ExileFoundCards, Shuffle])]))",
    "Choose a card name. Whenever a creature with the chosen name deals combat damage to a player this turn, draw a card": "ActionList([ChooseACardName(AnyOracleCard), CreateTriggerUntil(WhenACreatureDealsCombatDamageToAPlayer(And([IsCardtype(Creature), IsNamed(TheChosenName)]), AnyPlayer), ActionList([DrawACard]), UntilEndOfTurn)])",
    "Choose any number of {{Permanents}} with different names. For each of them, create a token that's a copy of it": "ActionList([ChooseAnyNumberOfGroupPermanents({{Permanents[0]}}, DifferentNames), CreateTokens([TokenCopyOfEachPermanent(TheChosenPermanents, NoTokenCopyEffects)])])",
    "Choose one -\n* Target {{Creature}} gets {{PTMod}} until end of turn.\n* Target {{Creature}} gets {{PTMod}} until end of turn.\n* You gain {{Digits}} life": "Modal_ChooseOne([Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])), Targeted([TargetPermanent({{Creature[1]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[1]}})], UntilEndOfTurn)])), ActionList([GainLife({{Digits[0]}})])])",
    "Choose target opponent. If they control fewer lands than you, create a number of {{PT}} {{CreatureTokens}} with {{Hasable}} equal to the difference": "Targeted([TargetPlayer(AnyPlayer)], ActionList([If(PlayerPassesFilter(Ref_TargetPlayer, ControlsLessPermanentThanPlayer(You, IsCardtype(Land))), [CreateTokens([NumberTokens(Minus(TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(You))])), TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]))), TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}]))])])]))",
    "Choose target {{Creature}}. Create a token that's a copy of it, except it isn't legendary, is {{a}} {{Zombie}} in addition to its other types, and has {{Hasable}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreateTokens([TokenCopyOfPermanent(Ref_TargetPermanent, TokenCopyEffects([RemoveSupertypes([Legendary]), AddCreatureTypes([{{Zombie[0]}}]), AddAbility([{{Hasable[0]}}])]))])]))",
    "Choose target {{Creature}}. Until end of turn, double its power and toughness and it gains {{Hasable}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([DoubleCreaturesPowerAndToughnessUntilEndOfTurn(Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Choose target {{Permanent}}. Its owner shuffles it into their library, then investigates": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([ShufflePermanentIntoLibrary(Ref_TargetPermanent), PlayerAction(OwnerOfPermanent(Ref_TargetPermanent), Investigate)]))",
    "Choose two target players. Until your next turn, each creature they control attacks the other chosen player each combat if able": "Targeted([NumberTargetPlayers(Integer(2), AnyPlayer)], ActionList([CreateEachPermanentRuleEffectUntil(And([IsCardtype(Creature), ControlledByAPlayer(Ref_TargetPlayers)]), [MustAttackAPlayer(Ref_TargetPlayers)], UntilPlayersNextTurn(You))]))",
    "Choose up to one target {{CreatureOrPlaneswalker}}. Each {{Creature}} deals damage equal to {{GameNumber(ThatCreature)}} to that permanent": "Targeted([UptoOneTargetPermanent({{CreatureOrPlaneswalker[0]}})], ActionList([EachPermanentDealsDamage({{Creature[0]}}, {{GameNumber(ThatCreature=EachablePermanent)[0]}}, Permanent(Ref_TargetPermanent))]))",
    "Choose up to {{Number}} target {{PermanentCards}} with total mana value {{Digits}} or less in your graveyard. Return each of them to the battlefield with {{a}} {{CounterType}} counter on it. They're artifacts in addition to their other types": "Targeted([UptoNumberTargetGroupGraveyardCards({{Number[0]}}, And([{{PermanentCards[0]}}, InAPlayersGraveyard(SinglePlayer(You))]), TotalManaValueIs(LessThanOrEqualTo({{Digits[0]}})))], ActionList([ReturnEachGraveyardCardToBattlefield(Ref_TargetGraveyardCards, [EntersWithACounter({{CounterType[0]}})]), CreateEachPermanentLayerEffect(ThePermanentsPutOnTheBattlefieldThisWay, [AddCardtype(Artifact)])]))",
    "Choose {{Number}} cards in each graveyard. Their owners shuffle those cards into their libraries": "ActionList([ChooseNumberCardsInEachPlayersGraveyard({{Number[0]}}, AnyCard, AnyPlayer), ShuffleEachGraveyardCardIntoLibrary(TheChosenGraveyardCards)])",
    "Choose {{a}} {{Creature}}. Until your next turn, all damage that would be dealt to {{Creatures}} is dealt to that creature instead": "ActionList([ChooseAPermanent({{Creature[0]}}), CreateReplaceWouldDealDamageUntil(DamageWouldBeDealtToARecipient(APermanent({{Creatures[0]}})), [DealToCreatureOrPlaneswalkerInstead(TheChosenPermanent)], UntilPlayersNextTurn(You))])",
    "Conjure a card named {{NamedCard}} onto the battlefield": "ActionList([ConjureCardOntoBattlefield({{NamedCard[0]}}, [EntersNormally])])",
    "Count the number of cards in your hand. You may cast a spell with mana value equal to that number from your hand without paying its mana cost": "ActionList([MayAction(CastASpellFromHandWithoutPaying(ManaValueIs(EqualTo(TheNumberOfCardsInPlayersHand(You)))))])",
    "Create X Treasure tokens, where X is {{GameNumber}}": "ActionList([CreateTokens([NumberTokens({{GameNumber[0]}}, TreasureToken)])])",
    "Create X {{PT}} {{CreatureTokens}}, where X is {{GameNumber}}": "ActionList([CreateTokens([NumberTokens({{GameNumber[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])])",
    "Create a Cursed Role token attached to up to one target {{Permanent}}": "Targeted([UptoOneTargetPermanent({{Permanent[0]}})], ActionList([CreateTokensWithFlags([CursedRoleToken], [EntersAttachedToPermanent(Ref_TargetPermanent)])]))",
    "Create a Food token": "ActionList([CreateTokens([FoodToken])])",
    "Create a Food token and {{a}} {{PT}} {{CreatureToken}} with \"{{TokenQuotedAbility}}\"": "ActionList([CreateTokens([FoodToken, TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{TokenQuotedAbility[0]}}])])])",
    "Create a Gold token": "ActionList([CreateTokens([GoldToken])])",
    "Create a Spellgorger Weird token": "ActionList([CreateTokens([OracleToken(\"Spellgorger Weird\")])])",
    "Create a Treasure token": "ActionList([CreateTokens([TreasureToken])])",
    "Create a Treasure token and {{a}} {{PT}} {{CreatureToken}} with {{Hasable}}": "ActionList([CreateTokens([TreasureToken, TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])])])",
    "Create a Wicked Role token attached to target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreateTokensWithFlags([WickedRoleToken], [EntersAttachedToPermanent(Ref_TargetPermanent)])]))",
    "Create a token that's a copy of target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreateTokens([TokenCopyOfPermanent(Ref_TargetPermanent, NoTokenCopyEffects)])]))",
    "Create a token that's a copy of target {{Permanent}}, except it's a legendary {{Zombie}} named {{NamedCard}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreateTokens([TokenCopyOfPermanent(Ref_TargetPermanent, TokenCopyEffects([AddSupertypes([Legendary]), AddCreatureTypes([{{Zombie[0]}}]), SetName({{NamedCard[0]}})]))])]))",
    "Create a token that's a copy of target {{Permanent}}. It gains {{Hasable}}. If it's a Saga, put up to {{Number}} {{CounterType}} counters on it. Sacrifice it at the beginning of your next end step": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreateTokens([TokenCopyOfPermanent(Ref_TargetPermanent, NoTokenCopyEffects)]), CreateEachPermanentLayerEffect(TheTokensCreatedThisWay, [AddAbility([{{Hasable[0]}}])]), ForEachPermanentPutUptoNumberCountersOfTypeOnIt(And([TheTokensCreatedThisWay, IsEnchantmentType(Saga)]), {{Number[0]}}, {{CounterType[0]}}), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([SacrificeEachPermanent(TheTokensCreatedThisWay)]))]))",
    "Create {{NamedCard}}, a legendary {{PT}} {{Black}} {{Zombie}} {{Zombie}} creature token with {{Hasable}}, {{Hasable}}, and \"{{TokenQuotedAbility}}\"": "ActionList([CreateTokens([NamedTokenWithPT({{NamedCard[0]}}, {{PT[0]}}, Colors([{{Black[0]}}]), [Legendary], [Creature], SubtypesList([{{Zombie[0]}}, {{Zombie[1]}}]), [{{Hasable[0]}}, {{Hasable[1]}}, {{TokenQuotedAbility[0]}}])])])",
    "Create {{NamedCard}}, a legendary {{PT}} {{Black}} {{Zombie}} creature token with {{Hasable}}, {{Hasable}}, and {{Hasable}}": "ActionList([CreateTokens([NamedTokenWithPT({{NamedCard[0]}}, {{PT[0]}}, Colors([{{Black[0]}}]), [Legendary], [Creature], SubtypesList([{{Zombie[0]}}]), [{{Hasable[0]}}, {{Hasable[1]}}, {{Hasable[2]}}])])])",
    "Create {{NamedCard}}, a legendary {{PT}} {{Black}} {{Zombie}} creature token with {{Hasable}}, {{Hasable}}, and \"{{TokenQuotedAbility}}\"": "ActionList([CreateTokens([NamedTokenWithPT({{NamedCard[0]}}, {{PT[0]}}, Colors([{{Black[0]}}]), [Legendary], [Creature], SubtypesList([{{Zombie[0]}}]), [{{Hasable[0]}}, {{Hasable[1]}}, {{TokenQuotedAbility[0]}}])])])",
    "Create {{Number}} Treasure tokens": "ActionList([CreateTokens([NumberTokens({{Number[0]}}, TreasureToken)])])",
    "Create {{Number}} tapped Powerstone tokens": "ActionList([CreateTokensWithFlags([NumberTokens({{Number[0]}}, PowerstoneToken)], [EntersTapped])])",
    "Create {{Number}} tapped {{PT}} {{CreatureTokens}} with {{Hasable}}": "ActionList([CreateTokensWithFlags([NumberTokens({{Number[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}]))], [EntersTapped])])",
    "Create {{Number}} {{PT}} {{CreatureTokens}}": "ActionList([CreateTokens([NumberTokens({{Number[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])])",
    "Create {{Number}} {{PT}} {{CreatureTokens}} with {{Hasable}}": "ActionList([CreateTokens([NumberTokens({{Number[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}]))])])",
    "Create {{Number}} {{PT}} {{CreatureTokens}} with {{Hasable}} and {{Hasable}}": "ActionList([CreateTokens([NumberTokens({{Number[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}, {{Hasable[1]}}]))])])",
    "Create {{a}} {{PTX}} {{CreatureToken}}, where X is half {{GameNumber}}, rounded up. It deals X damage to you": "ActionList([CreateValueX(HalfRoundedUp({{GameNumber[0]}})), CreateTokens([TokenWithPT(PTX({{PTX[0]}}, ValueX), {{CreatureToken[0]}}, [])]), PermanentDealsDamage(ThePermanentPutOnTheBattlefieldThisWay, ValueX, Player(You))])",
    "Create {{a}} {{PT}} {{CreatureToken}}": "ActionList([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])])",
    "Create {{a}} {{PT}} {{CreatureToken}} and a Food token": "ActionList([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, []), FoodToken])])",
    "Create {{a}} {{PT}} {{CreatureToken}} for each {{Eachable}}": "ActionList([CreateTokens([NumberTokens({{Eachable[0]}}, TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, []))])])",
    "Create {{a}} {{PT}} {{CreatureToken}} with \"{{TokenQuotedAbility}}\"": "ActionList([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{TokenQuotedAbility[0]}}])])])",
    "Create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}}": "ActionList([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])])])",
    "Create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}} and \"{{TokenQuotedAbility}}\"": "ActionList([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}, {{TokenQuotedAbility[0]}}])])])",
    "Create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}} and {{Hasable}}": "ActionList([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}, {{Hasable[1]}}])])])",
    "Create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}} and {{a}} {{PT}} {{CreatureToken}}": "ActionList([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}]), TokenWithPT({{PT[1]}}, {{CreatureToken[1]}}, [])])])",
    "Create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}} for each {{Eachable}}": "ActionList([CreateTokens([NumberTokens({{Eachable[0]}}, TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}]))])])",
    "Create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}} named {{NamedCard}}": "ActionList([CreateTokens([NamedTokenWithPT({{NamedCard[0]}}, {{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])])])",
    "Create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}}, {{Hasable}}, and \"{{TokenQuotedAbility}}\"": "ActionList([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}, {{Hasable[1]}}, {{TokenQuotedAbility[0]}}])])])",
    "Create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}}. It gains {{Hasable}} until end of turn": "ActionList([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])]), CreatePermanentLayerEffectUntil(TheCreatedToken, [AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)])",
    "Create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}}. The Ring tempts you": "ActionList([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])]), TemptWithRing])",
    "Create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}}. You gain {{Digits}} life": "ActionList([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])]), GainLife({{Digits[0]}})])",
    "Create {{a}} {{PT}} {{CreatureToken}}, then put {{a}} {{CounterType}} counter on {{a}} {{Permanent}}": "ActionList([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])]), PutACounterOfTypeOnAPermanent({{CounterType[0]}}, {{Permanent[0]}})])",
    "Destroy all {{Creatures}}. For each creature destroyed this way, its controller creates {{a}} {{PT}} {{CreatureToken}}": "ActionList([DestroyEachPermanent({{Creatures[0]}}), ActionForEachPermanentDestroyedThisWay([PlayerAction(ControllerOfEachableDestroyedPermanent, CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])]))])])",
