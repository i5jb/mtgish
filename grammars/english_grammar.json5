    "When you planeswalk away from {{~Plane}}, {{TriggerActions(ThatPlane)}}": "TriggerA(WhenAPlayerPlaneswalksAwayFromAPlane(SinglePlayer(You), SinglePlane({{~Plane}})), {{TriggerActions(ThatPlane=^~Plane)[0]}})",
    "When you planeswalk away from {{~Plane}}, {{TriggerActions}}": "TriggerA(WhenAPlayerPlaneswalksAwayFromAPlane(SinglePlayer(You), SinglePlane({{~Plane}})), {{TriggerActions[0]}})",
    "When you planeswalk to {{~Plane}} and at the beginning of your first main phase, {{TriggerActions(~Plane)}}": "TriggerA(Or([WhenAPlayerPlaneswalksToAPlane(SinglePlayer(You), SinglePlane({{~Plane}})), AtTheBeginningOfAPlayersFirstMainPhase(SinglePlayer(You))]), {{TriggerActions(~Plane=^~Plane)[0]}})",
    "When you planeswalk to {{~Plane}} and at the beginning of your upkeep, {{TriggerActions(ThatPlane)}}": "TriggerA(Or([WhenAPlayerPlaneswalksToAPlane(SinglePlayer(You), SinglePlane({{~Plane}})), AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You))]), {{TriggerActions(ThatPlane=^~Plane)[0]}})",
    "When you planeswalk to {{~Plane}} and at the beginning of your upkeep, {{TriggerActions(~Plane)}}": "TriggerA(Or([WhenAPlayerPlaneswalksToAPlane(SinglePlayer(You), SinglePlane({{~Plane}})), AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You))]), {{TriggerActions(~Plane=^~Plane)[0]}})",
    "When you planeswalk to {{~Plane}} and at the beginning of your upkeep, {{TriggerActions}}": "TriggerA(Or([WhenAPlayerPlaneswalksToAPlane(SinglePlayer(You), SinglePlane({{~Plane}})), AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You))]), {{TriggerActions[0]}})",
    "When you planeswalk to {{~Plane}}, {{TriggerActions}}": "TriggerA(WhenAPlayerPlaneswalksToAPlane(SinglePlayer(You), SinglePlane({{~Plane}})), {{TriggerActions[0]}})",
    "When {{~Plane}} has {{Number}} or more {{CounterType}} counters on it, {{TriggerActions}}": "TriggerA(WhenAPlaneHasNumberCountersOfType(SinglePlane({{~Plane}}), GreaterThanOrEqualTo({{Number[0]}}), {{CounterType[0]}}), {{TriggerActions[0]}})",
    "Whenever a player taps {{a}} {{Permanent}} for mana, {{TriggerActions(~Plane,ThatPlayer)}}": "TriggerA(WhenAPlayerTapsAPermanentForMana(AnyPlayer, {{Permanent[0]}}), {{TriggerActions(~Plane=^~Plane,ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "Whenever chaos ensues, {{TriggerActions(OtherThanThisPlayer)}}": "TriggerA(WhenChaosEnsues, {{TriggerActions(OtherThanThisPlayer=You)[0]}})",
