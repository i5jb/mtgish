    "Search your library for {{a}} {{SpecificCard}} and/or {{a}} {{SpecificCard}}, reveal them, put them into your hand, then shuffle": "ActionList([SearchLibrary([FindCardsOfType([{{SpecificCard[0]}}, {{SpecificCard[1]}}]), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}} or {{a}} {{SpecificCard}}, reveal it, put it into your hand, then shuffle": "ActionList([SearchLibrary([FindACardOfType(Or([{{SpecificCard[0]}}, {{SpecificCard[1]}}])), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}} or {{a}} {{SpecificCard}}, reveal it, put it into your hand, then shuffle. You gain {{Digits}} life": "ActionList([SearchLibrary([FindACardOfType(Or([{{SpecificCard[0]}}, {{SpecificCard[1]}}])), RevealFoundCards, PutFoundCardsIntoHand, Shuffle]), GainLife({{Digits[0]}})])",
    "Search your library for {{a}} {{SpecificCard}}, put it onto the battlefield tapped, then shuffle": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersTapped]), Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}}, put it onto the battlefield tapped, then shuffle. Then if {{Condition}}, untap that land": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersTapped]), Shuffle]), If({{Condition[0]}}, [UntapPermanent(ThePermanentPutOnTheBattlefieldThisWay)])])",
    "Search your library for {{a}} {{SpecificCard}}, put it onto the battlefield, attach it to {{a}} {{Permanent}}, then shuffle": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle]), AttachPermanentToAPermanent(ThePermanentPutOnTheBattlefieldThisWay, {{Permanent[0]}})])",
    "Search your library for {{a}} {{SpecificCard}}, put it onto the battlefield, then shuffle": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}}, put it onto the battlefield, then shuffle. If {{Condition}}, you win the game": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle]), If({{Condition[0]}}, [WinTheGame])])",
    "Search your library for {{a}} {{SpecificCard}}, put it onto the battlefield, then shuffle. It gains {{Hasable}}. Return it to your hand at the beginning of the next end step": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle]), CreatePermanentLayerEffect(ThePermanentPutOnTheBattlefieldThisWay, [AddAbility([{{Hasable[0]}}])]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutPermanentIntoItsOwnersHand(ThePermanentPutOnTheBattlefieldThisWay)]))])",
