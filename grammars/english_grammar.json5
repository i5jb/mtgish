    "Put {{a}} {{CounterType}} counter on target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent)]))",
    "Put {{a}} {{CounterType}} counter on target {{Permanent}}. It becomes a legendary {{Zombie}} {{Zombie}} in addition to its other types": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent), CreatePermanentLayerEffect(Ref_TargetPermanent, [AddSupertype(Legendary), AddCreatureType({{Zombie[0]}}), AddCreatureType({{Zombie[1]}})])]))",
    "Put {{a}} {{CounterType}} counter on target {{Permanent}}. It becomes {{a}} {{Zombie}} in addition to its other types": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent), CreatePermanentLayerEffect(Ref_TargetPermanent, [AddCreatureType({{Zombie[0]}})])]))",
    "Put {{a}} {{CounterType}} counter on target {{Permanent}}. It gains {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Put {{a}} {{CounterType}} counter on up to one target {{Creature}}. That creature becomes an artifact in addition to its other types": "Targeted([UptoOneTargetPermanent({{Creature[0]}})], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent), CreatePermanentLayerEffect(Ref_TargetPermanent, [AddCardtype(Artifact)])]))",
    "Put {{a}} {{CounterType}} counter on up to one target {{Permanent}}": "Targeted([UptoOneTargetPermanent({{Permanent[0]}})], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent)]))",
    "Put {{a}} {{CounterType}} counter on up to one target {{Permanent}}. Create a Food token": "Targeted([UptoOneTargetPermanent({{Permanent[0]}})], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent), CreateTokens([FoodToken])]))",
    "Put {{a}} {{CounterType}} counter on up to one target {{Permanent}}. You become the monarch": "Targeted([UptoOneTargetPermanent({{Permanent[0]}})], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent), BecomeTheMonarch]))",
    "Return all {{Permanents}} to their owners' hands": "ActionList([PutEachPermanentIntoItsOwnersHand({{Permanents[0]}})])",
    "Return all {{SpecificCards}} from your graveyard to the battlefield tapped": "ActionList([ReturnEachCardFromPlayersGraveyardToBattlefield({{SpecificCards[0]}}, You, [EntersTapped])])",
    "Return all {{SpecificCards}} from your graveyard to the battlefield, then shuffle your graveyard into your library": "ActionList([ReturnEachCardFromPlayersGraveyardToBattlefield({{SpecificCards[0]}}, You, [EntersNormally]), ShuffleGraveyardIntoLibrary])",
    "Return each {{Permanent}} to its owner's hand": "ActionList([PutEachPermanentIntoItsOwnersHand({{Permanent[0]}})])",
    "Return target {{SpecificCard}} from your graveyard to the battlefield": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersNormally])]))",
    "Return target {{SpecificCard}} from your graveyard to the battlefield with an additional {{CounterType}} counter on it": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersWithACounter({{CounterType[0]}})])]))",
    "Return target {{SpecificCard}} from your graveyard to the battlefield with {{a}} {{CounterType}} counter on it. That creature is {{a}} {{Zombie}} {{Zombie}} in addition to its other types": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersWithACounter({{CounterType[0]}})]), CreatePermanentLayerEffect(ThePermanentPutOnTheBattlefieldThisWay, [AddCreatureType({{Zombie[0]}}), AddCreatureType({{Zombie[1]}})])]))",
    "Return target {{SpecificCard}} from your graveyard to the battlefield. Put your choice of {{a}} {{CounterType}}, {{CounterType}}, or {{CounterType}} counter on it": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersNormally]), PutACounterOfChoiceOnPermanent([{{CounterType[0]}}, {{CounterType[1]}}, {{CounterType[2]}}], ThePermanentPutOnTheBattlefieldThisWay)]))",
    "Return target {{SpecificCard}} from your graveyard to the battlefield. Put {{a}} {{CounterType}} counter on it. It gains {{Hasable}} until your next turn": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersNormally]), PutACounterOfTypeOnPermanent({{CounterType[0]}}, ThePermanentPutOnTheBattlefieldThisWay), CreatePermanentLayerEffectUntil(ThePermanentPutOnTheBattlefieldThisWay, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Return target {{SpecificCard}} from your graveyard to the battlefield. Put {{a}} {{CounterType}} counter or {{a}} {{CounterType}} counter on it": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersNormally]), PutACounterOfChoiceOnPermanent([{{CounterType[0]}}, {{CounterType[1]}}], ThePermanentPutOnTheBattlefieldThisWay)]))",
    "Return target {{SpecificCard}} from your graveyard to your hand": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardIntoHand(Ref_TargetGraveyardCard)]))",
    "Return up to one other target {{Permanent}} to its owner's hand. Then each opponent discards a card": "Targeted([UptoOneTargetPermanent({{Permanent[0]}})], ActionList([PutPermanentIntoItsOwnersHand(Ref_TargetPermanent), EachPlayerAction(Opponent, DiscardACard)]))",
    "Return up to one target {{Permanent}} to its owner's hand": "Targeted([UptoOneTargetPermanent({{Permanent[0]}})], ActionList([PutPermanentIntoItsOwnersHand(Ref_TargetPermanent)]))",
    "Return up to {{Number}} target {{SpecificCards}} from your graveyard to your hand": "Targeted([UptoNumberTargetGraveyardCards({{Number[0]}}, And([{{SpecificCards[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutEachGraveyardCardIntoHand(Ref_TargetGraveyardCards)]))",
    "Return {{a}} {{SpecificCard}} from your graveyard to your hand. If you can't, draw a card": "ActionList([MustCost(PutACardFromGraveyardIntoHand({{SpecificCard[0]}})), Unless(CostWasPaid, [DrawACard])])",
    "Reveal cards from the top of your library until you reveal {{a}} {{SpecificCard}}, {{a}} {{SpecificCard}}, or {{a}} {{SpecificCard}}. Put that card into your hand and the rest on the bottom of your library in a random order": "ActionList([RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed(Or([{{SpecificCard[0]}}, {{SpecificCard[1]}}, {{SpecificCard[2]}}]), [PutTheCardFoundThisWayIntoHand, PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "Reveal the top card of your library. If it's a permanent card, put it into your hand": "ActionList([RevealTopCardOfLibrary, If(ACardWasRevealedThisWay(IsPermanent), [PutTopOfLibraryInHand])])",
    "Reveal up to {{Number}} {{SpecificCards}} from your hand. For each of those cards that has the same mana value as another card revealed this way, create a Treasure token": "ActionList([RevealUptoNumberCardsOfTypeFromHand({{Number[0]}}, {{SpecificCards[0]}}), CreateTokens([NumberTokens(TheNumberOfCardsInHandRevealedThisWayThatShareAManaValue, TreasureToken)])])",
    "Sacrifice all {{Permanents}}": "ActionList([SacrificeEachPermanent({{Permanents[0]}})])",
    "Sacrifice any number of creatures. Search your library and/or graveyard for a creature card with mana value less than or equal to the number of creatures sacrificed this way and put it onto the battlefield. If you search your library this way, shuffle": "ActionList([SacrificeAnyNumberOfPermanents(IsCardtype(Creature)), SearchLibraryAndOrGraveyard([FindACardOfType(And([IsCardtype(Creature), ManaValueIs(LessThanOrEqualTo(TheNumberOfPermanentsSacrificedThisWay))])), PutFoundCardsOntoBattlefield([EntersNormally]), ShuffleLibraryIfSearched])])",
    "Scry {{Digits}}": "ActionList([Scry({{Digits[0]}})])",
    "Scry {{Digits}}, then draw a card": "ActionList([Scry({{Digits[0]}}), DrawACard])",
    "Scry {{Digits}}, then draw {{Number}} cards": "ActionList([Scry({{Digits[0]}}), DrawNumberCards({{Number[0]}})])",
    "Scry {{Digits}}, then you may reveal the top card of your library. If {{a}} {{SpecificCard}} is revealed this way, put it into your hand": "ActionList([Scry({{Digits[0]}}), MayCost(RevealTopCardOfLibrary), If(CostWasPaid, [If(ACardWasRevealedThisWay({{SpecificCard[0]}}), [PutTopOfLibraryInHand])])])",
    "Search your library for a card, put that card into your hand, then shuffle. You lose {{Digits}} life": "ActionList([SearchLibrary([FindAGenericCard, PutFoundCardsIntoHand, Shuffle]), LoseLife({{Digits[0]}})])",
    "Search your library for up to {{Number}} {{SpecificCards}}, reveal them, put them into your hand, then shuffle": "ActionList([SearchLibrary([FindNumberCardsOfType({{Number[0]}}, {{SpecificCards[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}} or {{a}} {{SpecificCard}}, reveal it, put it into your hand, then shuffle": "ActionList([SearchLibrary([FindACardOfType(Or([{{SpecificCard[0]}}, {{SpecificCard[1]}}])), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}}, put it onto the battlefield tapped, then shuffle": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersTapped]), Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}}, put it onto the battlefield, then shuffle": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle])])",
    "Search your library for {{a}} {{SpecificCard}}, reveal it, put it into your hand, then shuffle": "ActionList([SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])",
    "Seek a card with mana value greater than {{GameNumber}}": "ActionList([SeekACard(ManaValueIs(GreaterThan({{GameNumber[0]}})))])",
    "Seek a card with mana value less than {{GameNumber}}": "ActionList([SeekACard(ManaValueIs(LessThan({{GameNumber[0]}})))])",
    "Seek {{a}} {{SpecificCard}} and put it onto the battlefield": "ActionList([SeekACard({{SpecificCard[0]}}), PutCardFromHandOnBattlefield(TheCardSeekedThisWay, [EntersNormally])])",
    "Shuffle any number of target cards from your graveyard into your library. Add {{ManaProduceSymbol}}{{ManaProduceSymbol}}": "Targeted([AnyNumberOfTargetGraveyardCards(AnyCardInAnyGraveyard)], ActionList([ShuffleEachGraveyardCardIntoLibrary(Ref_TargetGraveyardCards), AddMana(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}]))]))",
    "Shuffle up to {{Number}} target cards from your graveyard into your library": "Targeted([UptoNumberTargetGraveyardCards({{Number[0]}}, InAPlayersGraveyard(SinglePlayer(You)))], ActionList([ShuffleEachGraveyardCardIntoLibrary(Ref_TargetGraveyardCards)]))",
    "Starting with you, each player chooses up to one {{Permanent}} from among {{Permanents}}. Exile those permanents": "ActionList([EachPlayerStartingWithAction(AnyPlayer, You, [ChooseUptoOnePermanent(And([{{Permanent[0]}}, {{Permanents[0]}}]))]), ExileEachPermanent(ThePermanentsChosenThisWay)])",
    "Starting with you, each player chooses {{a}} {{Permanent}}. Destroy each {{Permanent}} chosen this way": "ActionList([EachPlayerStartingWithAction(AnyPlayer, You, [ChooseAPermanent({{Permanent[0]}})]), DestroyEachPermanent(And([{{Permanent[1]}}, ThePermanentsChosenThisWay]))])",
    "Surveil {{Digits}}": "ActionList([Surveil({{Digits[0]}})])",
    "Tap all {{Permanents}}": "ActionList([TapEachPermanent({{Permanents[0]}})])",
    "Tap all {{Permanents}} target opponent controls. They don't untap during their controller's next untap step": "Targeted([TargetPlayer(Opponent)], ActionList([CreatePermanentsList(And([{{Permanents[0]}}, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))])), TapEachPermanent(ThePermanentsList), EachPermanentDoesntUntapDuringControllersNextUntap(ThePermanentsList)]))",
    "Tap target {{Permanent}}. Put {{a}} {{CounterType}} counter on it": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent)]))",
    "Tap up to one target {{Permanent}} and put {{a}} {{CounterType}} counter on it": "Targeted([UptoOneTargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent)]))",
    "Tap up to one target {{Permanent}} and put {{a}} {{CounterType}} counter on it. You get {{Energy}}": "Targeted([UptoOneTargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent), GetEnergy(Integer({{Energy[0]}}))]))",
    "Tap up to {{Number}} target {{Permanents}}. Put {{a}} {{CounterType}} counter on each of them": "Targeted([UptoNumberTargetPermanents({{Number[0]}}, {{Permanents[0]}})], ActionList([TapEachPermanent(Ref_TargetPermanents), PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, ThePermanentsTappedThisWay)]))",
    "Target opponent faces a villainous choice - Destroy all {{Permanents}} and each of your opponents loses life equal to {{GameNumber}}, or destroy all {{Permanents}}": "Targeted([TargetPlayer(Opponent)], ActionList([PlayerAction(Ref_TargetPlayer, FaceAVillianousChoice([[DestroyEachPermanent({{Permanents[0]}}), EachPlayerAction(Opponent, LoseLife({{GameNumber[0]}}))], [DestroyEachPermanent({{Permanents[1]}})]]))]))",
    "Target opponent may sacrifice {{a}} {{Permanent}} of their choice. If they don't, they lose {{Digits}} life and you draw a card": "Targeted([TargetPlayer(Opponent)], ActionList([PlayerMayCost(Ref_TargetPlayer, SacrificeAPermanent({{Permanent[0]}})), Unless(CostWasPaid, [PlayerAction(PlayerAction_ThatPlayer, LoseLife({{Digits[0]}})), DrawACard])]))",
    "Target opponent reveals their hand. You choose {{a}} {{SpecificCard}} from it. That player discards that card": "Targeted([TargetPlayer(Opponent)], ActionList([PlayerAction(Ref_TargetPlayer, RevealHandAndPlayerChoosesACardToDiscard(You, {{SpecificCard[0]}}))]))",
    "Target player loses {{Digits}} life and you gain {{Digits}} life": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, LoseLife({{Digits[0]}})), GainLife({{Digits[1]}})]))",
    "Target player mills {{Number}} cards": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, MillNumberCards({{Number[0]}}))]))",
    "Target player mills {{Number}} cards, then exiles their graveyard": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, MillNumberCards({{Number[0]}})), ExilePlayersGraveyard(Ref_TargetPlayer)]))",
    "Target {{Creature}} becomes {{a}} {{PT}} legendary {{Zombie}} creature named {{NamedCard}} and loses all abilities": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffect(Ref_TargetPermanent, [SetPT({{PT[0]}}), AddSupertype(Legendary), SetCreatureType({{Zombie[0]}}), SetCardtype(Creature), SetName({{NamedCard[0]}}), LosesAllAbilities])]))",
    "Target {{Creature}} can't be blocked this turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [CantBeBlocked], UntilEndOfTurn)]))",
    "Target {{Creature}} fights another target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}}), TargetPermanent(And([Other(Ref_TargetPermanent1), {{Creature[1]}}]))], ActionList([HaveCreaturesFight(Ref_TargetPermanent1, Ref_TargetPermanent2)]))",
    "Target creature you control fights up to one other target creature":
      "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))])), UptoOneTargetPermanent(And([Other(Ref_TargetPermanent1), IsCardtype(Creature)]))], ActionList([Fight(Ref_TargetPermanent1, Ref_TargetPermanent2)]))",
    "Target {{Creature}} fights up to one target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}}), UptoOneTargetPermanent({{Creature[1]}})], ActionList([Fight(Ref_TargetPermanent1, Ref_TargetPermanent2)]))",
    "Target {{Creature}} gets {{PTModX}} and gains {{Hasable}} until end of turn, where X is {{GameNumber}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreateValueX({{GameNumber[0]}}), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTX({{PTModX[0]}}, ValueX), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Target {{Creature}} gets {{PTMod}} and gains {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Target {{Creature}} gets {{PTMod}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)]))",
    "Target {{Creature}} gets {{PTMod}} until end of turn for each {{Eachable}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTForEach({{PTMod[0]}}, {{Eachable[0]}})], UntilEndOfTurn)]))",
    "Target {{Permanent}} gains {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Target {{Permanent}} gains {{Hasable}}, {{Hasable}}, and {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}]), AddAbility([{{Hasable[2]}}])], UntilEndOfTurn)]))",
    "The Ring tempts you, then each player mills cards equal to {{GameNumber}}": "ActionList([TemptWithRing, EachPlayerAction(AnyPlayer, MillNumberCards({{GameNumber[0]}}))])",
    "The next {{Black}} or {{Black}} creature spell you cast this turn can be cast without paying its mana cost": "ActionList([CreateFuturePlayerEffect(You, MayCastTheirNextSpellThisTurnWithoutPaying(And([Or([IsColor({{Black[0]}}), IsColor({{Black[1]}})]), IsCardtype(Creature)])))])",
    "The next {{PotentialSpell}} you cast this turn costs {{CostReduce}} less to cast": "ActionList([CreateFutureSpellEffect(TheNextSpellPlayerCastsThisTurn({{PotentialSpell[0]}}, You), [DecreaseManaCost({{CostReduce[0]}})])])",
    "Time travel, then time travel": "ActionList([TimeTravel, TimeTravel])",
    "Until end of turn, another target creature you control gains {{Hasable}} and gets {{PTModX}}, where X is {{GameNumber}}": "Targeted([TargetPermanent(And([Other(ThisPermanent), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}]), AdjustPTX({{PTModX[0]}}, {{GameNumber[0]}})], UntilEndOfTurn)]))",
    "Until end of turn, target {{Creature}} gains \"{{QuotedAbility}}\". Then that creature fights up to one other target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}}), UptoOneTargetPermanent(And([Other(Ref_TargetPermanent1), {{Creature[1]}}]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent1, [AddAbility([{{QuotedAbility[0]}}])], UntilEndOfTurn), HaveCreaturesFight(Ref_TargetPermanent1, Ref_TargetPermanent2)]))",
    "Until end of turn, whenever you cast {{a}} {{Spell}}, copy it. You may choose new targets for the copy": "ActionList([CreateTriggerUntil(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), ActionList([CopySpellAndMayChooseNewTargets(Trigger_ThatSpell)]), UntilEndOfTurn)])",
    "Until end of turn, whenever {{a}} {{Creature}} attacks, draw a card": "ActionList([CreateTriggerUntil(WhenACreatureAttacks({{Creature[0]}}), ActionList([DrawACard]), UntilEndOfTurn)])",
    "Until end of turn, whenever {{a}} {{Creature}} deals combat damage to a player, it deals that much damage to target creature that player controls": "ActionList([CreateTriggerUntil(WhenACreatureDealsCombatDamageToAPlayer({{Creature[0]}}, AnyPlayer), Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(Trigger_ThatPlayer))]))], ActionList([PermanentDealsDamage(Trigger_ThatPermanent, Trigger_ThatMuch, Permanent(Ref_TargetPermanent))])), UntilEndOfTurn)])",
    "Until end of turn, {{Permanents}} gain \"{{QuotedAbility}}\"": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{QuotedAbility[0]}}])], UntilEndOfTurn)])",
    "Until your next turn, each creature attacks each combat if able and attacks a player other than you if able": "ActionList([CreateEachPermanentRuleEffectUntil(IsCardtype(Creature), [MustAttack, MustAttackAPlayer(Other(You))], UntilPlayersNextTurn(You))])",
    "Until your next turn, whenever a creature attacks you or a planeswalker you control, it gets {{PTMod}} until end of turn": "ActionList([CreateTriggerUntil(WhenACreatureAttacksAPlayerOrPlaneswalkerTheyControl(IsCardtype(Creature), SinglePlayer(You)), ActionList([CreatePermanentLayerEffectUntil(Trigger_ThatPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)]), UntilPlayersNextTurn(You))])",
    "Until your next turn, whenever you cast {{a}} {{Spell}}, target player mills cards equal to that spell's mana value": "ActionList([CreateTriggerUntil(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, MillNumberCards(ManaValueOfSpell(Trigger_ThatSpell)))])), UntilPlayersNextTurn(You))])",
    "Until your next turn, {{Creatures}} attack each combat if able": "ActionList([CreateEachPermanentRuleEffectUntil({{Creatures[0]}}, [MustAttack], UntilPlayersNextTurn(You))])",
    "Until your next turn, {{Creatures}} can't attack you unless their controller pays {{ManaCost}} for each of those creatures": "ActionList([CreateEachPermanentRuleEffectUntil({{Creatures[0]}}, [CantAttackPlayerUnlessCost(You, PayMana({{ManaCost[0]}}))], UntilPlayersNextTurn(You))])",
    "Until your next turn, {{Permanents}} gain \"{{QuotedAbility}}\"": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{QuotedAbility[0]}}])], UntilPlayersNextTurn(You))])",
    "Up to one target {{Artifact}} becomes an artifact creature with base power and toughness {{PT}} until end of turn": "Targeted([UptoOneTargetPermanent({{Artifact[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddCardtype(Artifact), AddCardtype(Creature), SetPT({{PT[0]}})], UntilEndOfTurn)]))",
    "Up to {{Number}} target {{Creatures}} can't block this turn": "Targeted([NumberTargetPermanents({{Number[0]}}, {{Creatures[0]}})], ActionList([CreateEachPermanentRuleEffectUntil(Ref_TargetPermanents, [CantBlock], UntilEndOfTurn)]))",
    "Up to {{Number}} target {{Creatures}} each get {{PTMod}} and gain {{Hasable}} until end of turn": "Targeted([UptoNumberTargetPermanents({{Number[0]}}, {{Creatures[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Up to {{Number}} target {{Permanents}} each gain {{Hasable}} until end of turn": "Targeted([UptoNumberTargetPermanents({{Number[0]}}, {{Permanents[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "When you cast a spell with the chosen name for the first time this turn, draw {{Number}} cards": "ActionList([CreateTriggerOnce(UntilEndOfTurn, WhenAPlayerCastsASpell(SinglePlayer(You), IsNamed(TheChosenName)), ActionList([DrawNumberCards({{Number[0]}})]))])",
    "When you next cast a creature spell this turn, copy it, except the copy isn't legendary": "ActionList([CreateFutureTrigger(WhenPlayerCastsTheirNextSpellThisTurn(You, IsCardtype(Creature)), ActionList([CopySpellWithModifiers(Trigger_ThatSpell, [RemoveSupertypes([Legendary])])]))])",
    "When you next cast a creature spell this turn, it gains {{Hasable}} until end of turn": "ActionList([CreateFutureTrigger(WhenPlayerCastsTheirNextSpellThisTurn(You, IsCardtype(Creature)), ActionList([CreateSpellEffect(Trigger_ThatSpell, [EntersWithLayerEffectUntil([AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])]))])",
    "When you next cast a creature spell this turn, that creature enters with an additional {{CounterType}} counter on it": "ActionList([CreateFutureTrigger(WhenPlayerCastsTheirNextSpellThisTurn(You, IsCardtype(Creature)), ActionList([CreateSpellEffect(Trigger_ThatSpell, [EntersWithACounter({{CounterType[0]}})])]))])",
    "When you next cast {{a}} {{Spell}} this turn, copy it twice. You may choose new targets for the copies": "ActionList([CreateFutureTrigger(WhenPlayerCastsTheirNextSpellThisTurn(You, {{Spell[0]}}), ActionList([CopySpellNumberTimesAndMayChooseNewTargets(Trigger_ThatSpell, Integer(2))]))])",
    "When you next cast {{a}} {{Spell}} this turn, copy it. You may choose new targets for the copy": "ActionList([CreateFutureTrigger(WhenPlayerCastsTheirNextSpellThisTurn(You, {{Spell[0]}}), ActionList([CopySpellAndMayChooseNewTargets(Trigger_ThatSpell)]))])",
    "When you next cast {{a}} {{Spell}} this turn, copy that spell. You may choose new targets for the copy": "ActionList([CreateFutureTrigger(WhenPlayerCastsTheirNextSpellThisTurn(You, {{Spell[0]}}), ActionList([CopySpellAndMayChooseNewTargets(Trigger_ThatSpell)]))])",
    "Whenever one or more {{Creatures}} deal combat damage to a player this turn, look at that player's hand and draw a card": "ActionList([CreateTriggerUntil(WhenAnyNumberOfCreaturesDealCombatDamageToAPlayer({{Creatures[0]}}, AnyPlayer), ActionList([LookAtPlayersHand(Trigger_ThatPlayer), DrawACard]), UntilEndOfTurn)])",
    "Whenever you cast {{a}} {{Spell}} this turn, create a token that's a copy of {{a}} {{Permanent}}": "ActionList([CreateTriggerUntil(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), ActionList([CreateTokens([TokenCopyOfAPermanent({{Permanent[0]}}, NoTokenCopyEffects)])]), UntilEndOfTurn)])",
    "Whenever you cast {{a}} {{Spell}} this turn, draw {{Number}} cards, then discard a card": "ActionList([CreateTriggerUntil(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), ActionList([DrawNumberCards({{Number[0]}}), DiscardACard]), UntilEndOfTurn)])",
    "Whenever you cast {{a}} {{Spell}} this turn, put {{a}} {{CounterType}} counter on target {{Permanent}}": "ActionList([CreateTriggerUntil(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent)])), UntilEndOfTurn)])",
    "Whenever you cast {{a}} {{Spell}} this turn, target {{Permanent}} gains {{Hasable}} until end of turn": "ActionList([CreateTriggerUntil(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])), UntilEndOfTurn)])",
    "Whenever {{a}} {{Creature}} attacks this turn, create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}} that's tapped and attacking": "ActionList([CreateTriggerUntil(WhenACreatureAttacks({{Creature[0]}}), ActionList([CreateTokensWithFlags([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])], [EntersTapped, EntersAttacking])]), UntilEndOfTurn)])",
    "Whenever {{a}} {{Creature}} attacks this turn, target {{Creature}} gets {{PTMod}} until end of turn": "ActionList([CreateTriggerUntil(WhenACreatureAttacks({{Creature[0]}}), Targeted([TargetPermanent({{Creature[1]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])), UntilEndOfTurn)])",
    "Whenever {{a}} {{Creature}} attacks this turn, you draw a card and you lose {{Digits}} life": "ActionList([CreateTriggerUntil(WhenACreatureAttacks({{Creature[0]}}), ActionList([DrawACard, LoseLife({{Digits[0]}})]), UntilEndOfTurn)])",
    "Whenever {{a}} {{Creature}} deals combat damage to a player this turn, time travel": "ActionList([CreateTriggerUntil(WhenACreatureDealsCombatDamageToAPlayer({{Creature[0]}}, AnyPlayer), ActionList([TimeTravel]), UntilEndOfTurn)])",
    "Whenever {{a}} {{Permanent}} attacks alone this turn, put {{Number}} {{CounterType}} counters on it. It gains {{Hasable}}, {{Hasable}}, and {{Hasable}} until end of turn": "ActionList([CreateTriggerUntil(WhenACreatureAttacksAlone({{Permanent[0]}}), ActionList([PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[0]}}, Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}]), AddAbility([{{Hasable[2]}}])], UntilEndOfTurn)]), UntilEndOfTurn)])",
    "Whenever {{a}} {{Permanent}} attacks this turn, put {{a}} {{CounterType}} counter on it": "ActionList([CreateTriggerUntil(WhenACreatureAttacks({{Permanent[0]}}), ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Trigger_ThatPermanent)]), UntilEndOfTurn)])",
    "Whenever {{a}} {{Permanent}} enters this turn, each opponent loses {{Digits}} life and you gain {{Digits}} life": "ActionList([CreateTriggerUntil(WhenAPermanentEntersTheBattlefield({{Permanent[0]}}), ActionList([EachPlayerAction(Opponent, LoseLife({{Digits[0]}})), GainLife({{Digits[1]}})]), UntilEndOfTurn)])",
    "You and target opponent each create a Food token": "Targeted([TargetPlayer(Opponent)], ActionList([EachPlayerAction(Or([SinglePlayer(You), SinglePlayer(Ref_TargetPlayer)]), CreateTokens([FoodToken]))]))",
    "You and target opponent each draw {{Number}} cards": "Targeted([TargetPlayer(Opponent)], ActionList([EachPlayerAction(Or([SinglePlayer(You), SinglePlayer(Ref_TargetPlayer)]), DrawNumberCards({{Number[0]}}))]))",
    "You draw a card and you lose {{Digits}} life": "ActionList([DrawACard, LoseLife({{Digits[0]}})])",
    "You draw {{Number}} cards and you lose {{Digits}} life": "ActionList([DrawNumberCards({{Number[0]}}), LoseLife({{Digits[0]}})])",
    "You gain X life and scry X, where X is {{GameNumber}}": "ActionList([CreateValueX({{GameNumber[0]}}), GainLife(ValueX), Scry(ValueX)])",
    "You gain life equal to {{GameNumber}}": "ActionList([GainLife({{GameNumber[0]}})])",
    "You gain {{Digits}} life": "ActionList([GainLife({{Digits[0]}})])",
    "You gain {{Digits}} life and scry {{Digits}}": "ActionList([GainLife({{Digits[0]}}), Scry({{Digits[1]}})])",
    "You gain {{Digits}} life for each {{Eachable}}": "ActionList([GainLifeForEach({{Digits[0]}}, {{Eachable[0]}})])",
    "You gain {{Digits}} life. Look at the top {{Number}} cards of your library. Exile one of them face down with {{a}} {{CounterType}} counter on it, then put the rest on the bottom of your library in any order": "ActionList([GainLife({{Digits[0]}}), LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [ExileAGenericCardWithACounter({{CounterType[0]}}), PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder])])",
    "You may activate the loyalty abilities of {{Planeswalkers}} twice this turn rather than only once": "ActionList([CreatePlayerEffectUntil(You, [MayActivateLoyaltyAbilitiesTwiceEachTurn({{Planeswalkers[0]}})], UntilEndOfTurn)])",
    "You may cast {{a}} {{Spell}} from your hand without paying its mana cost": "ActionList([MayAction(CastASpellFromHandWithoutPaying({{Spell[0]}}))])",
    "You may discard a card. If you do, draw a card": "ActionList([MayCost(DiscardACard), If(CostWasPaid, [DrawACard])])",
    "You may discard a card. If you do, exile the top {{Number}} cards of your library. You may play them until the end of your next turn": "ActionList([MayCost(DiscardACard), If(CostWasPaid, [ExileTheTopNumberCardsOfLibrary({{Number[0]}}), CreatePlayerEffectUntil(You, [MayPlayExiledCards(TheCardsExiledThisWay)], UntilEndOfTurn)])])",
    "You may discard a card. When you do, return target {{SpecificCard}} from your graveyard to the battlefield tapped": "ActionList([MayCost(DiscardACard), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersTapped])])))])])",
    "You may discard a card. When you do, return target {{SpecificCard}} from your graveyard to your hand": "ActionList([MayCost(DiscardACard), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardIntoHand(Ref_TargetGraveyardCard)])))])])",
    "You may discard up to {{Number}} cards. If you do, draw that many cards": "ActionList([MayCost(DiscardNumberCards({{Number[0]}})), If(CostWasPaid, [DrawNumberCards(NumCardsDiscardedThisWay)])])",
    "You may draw a card for each {{Eachable}}. If you do, each opponent draws a card": "ActionList([MayCost(DrawNumberCards({{Eachable[0]}})), If(CostWasPaid, [EachPlayerAction(Opponent, DrawACard)])])",
    "You may exchange control of two target {{Permanents}}": "Targeted([NumberTargetPermanents(Integer(2), {{Permanents[0]}})], ActionList([MayAction(ExchangeControl(Ref_TargetPermanents_0, Ref_TargetPermanents_1))]))",
    "You may exchange control of two target {{Permanents}} that share a card type": "Targeted([NumberTargetGroupPermanents(Integer(2), {{Permanents[0]}}, ShareACardType)], ActionList([MayAction(ExchangeControl(Ref_TargetPermanents_0, Ref_TargetPermanents_1))]))",
    "You may exile {{a}} {{Permanent}} and {{a}} {{Permanent}}. If you do, search your library for {{a}} {{SpecificCard}}, put it onto the battlefield, then shuffle": "ActionList([MayCost(And([ExileAPermanent({{Permanent[0]}}), ExileAPermanent({{Permanent[1]}})])), If(CostWasPaid, [SearchLibrary([FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle])])])",
    "You may exile {{a}} {{Permanent}}. When you do, exile all {{Permanents}}": "ActionList([MayCost(ExileAPermanent({{Permanent[0]}})), If(CostWasPaid, [ReflexiveTrigger(ActionList([ExileEachPermanent({{Permanents[0]}})]))])])",
    "You may have target opponent draw {{Number}} cards. If you do, draw {{Number}} cards": "Targeted([TargetPlayer(Opponent)], ActionList([MayCost(HavePlayerTakeAction(Ref_TargetPlayer, DrawNumberCards({{Number[0]}}))), If(CostWasPaid, [DrawNumberCards({{Number[1]}})])]))",
    "You may play an additional land this turn": "ActionList([CreatePlayerEffectUntil(You, [MayPlayAnAdditionalLand], UntilEndOfTurn)])",
    "You may put a card you own from outside the game on top of your library": "ActionList([MayAction(PutACardFromOutsideGameOnTopOfLibrary(AnyCard))])",
    "You may put {{a}} {{PermanentCard}} from your hand onto the battlefield. If its mana cost contains {X}, it enters with a number of {{CounterType}} counters on it equal to {{GameNumber}}": "ActionList([MayAction(PutACardFromHandOnBattlefield({{PermanentCard[0]}}, [IfPassesFilter(HasXInManaCost, [EntersWithNumberCounters({{GameNumber[0]}}, {{CounterType[0]}})])]))])",
    "You may put {{a}} {{SpecificCard}} from your hand onto the battlefield": "ActionList([MayAction(PutACardFromHandOnBattlefield({{SpecificCard[0]}}, [EntersNormally]))])",
    "You may put {{a}} {{SpecificCard}} from your hand or graveyard onto the battlefield. If an Equipment is put onto the battlefield this way, you may attach it to {{a}} {{Permanent}}": "ActionList([MayActions([PutACardFromHandOrGraveyardOnBattlefield({{SpecificCard[0]}}, You, [EntersNormally]), If(APermanentOfTypeWasPutOntoTheBattlefieldThisWay(IsArtifactType(Equipment)), [MayAction(AttachPermanentToAPermanent(ThePermanentPutOnTheBattlefieldThisWay, {{Permanent[0]}}))])])])",
    "You may sacrifice {{a}} {{Permanent}}. If you do, each opponent discards a card": "ActionList([MayCost(SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [EachPlayerAction(Opponent, DiscardACard)])])",
    "You may sacrifice {{a}} {{Permanent}}. If you do, search your library for {{a}} {{SpecificCard}}, reveal it, put it into your hand, then shuffle": "ActionList([MayCost(SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])])])",
    "You may tap {{a}} {{Permanent}} and sacrifice {{a}} {{Permanent}}. If you do, conjure a card named {{NamedCard}} onto the battlefield": "ActionList([MayCost(And([TapAPermanent({{Permanent[0]}}), SacrificeAPermanent({{Permanent[1]}})])), If(CostWasPaid, [ConjureCardOntoBattlefield({{NamedCard[0]}}, [EntersNormally])])])",
    "{{Artifacts}} become artifact creatures with base power and toughness {{PT}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Artifacts[0]}}, [AddCardtype(Artifact), AddCardtype(Creature), SetPT({{PT[0]}})], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTMod}} and gain {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTMod}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTMod}} until your next turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilPlayersNextTurn(You))])",
    "{{Permanents}} gain {{Hasable}} and {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)])",
    "{{Permanents}} gain {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "{{Permanents}} gain {{Hasable}} until end of turn. The Ring tempts you": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), TemptWithRing])",
    "{{PotentialSpells}} you cast this turn cost {{CostReduce}} less to cast": "ActionList([CreateEachSpellEffect(And([{{PotentialSpells[0]}}, CastByPlayer(You)]), [DecreaseManaCost({{CostReduce[0]}})], UntilEndOfTurn)])",
    "{{PotentialSpells}} your opponents cast cost {{ManaCost}} more to cast until your next turn": "ActionList([CreateEachPlayerEffectUntil(Opponent, [IncreaseSpellCost({{PotentialSpells[0]}}, PayMana({{ManaCost[0]}}))], UntilPlayersNextTurn(You))])"
  },
  "{{SagaChapterNumbers}}": {
    "I": "[1]",
    "I, II": "[1, 2]",
    "I, II, III": "[1, 2, 3]",
    "I, II, III, IV": "[1, 2, 3, 4]",
    "I, II, III, IV, V, VI": "[1, 2, 3, 4, 5, 6]",
    "I, III": "[1, 3]",
    "II": "[2]",
    "II, III": "[2, 3]",
    "II, III, IV": "[2, 3, 4]",
    "II, III, IV, V": "[2, 3, 4, 5]",
    "II, III, IV, V, VI": "[2, 3, 4, 5, 6]",
    "II, IV": "[2, 4]",
    "III": "[3]",
    "III, IV": "[3, 4]",
    "IV": "[4]",
    "V": "[5]",
    "VI": "[6]"
  },
  "{{SagaChapter[ExileACard]}}": {
    "{{SagaChapterNumbers}} - {{SagaActions[ExileACard]}}.": "SagaChapter({{SagaChapterNumbers[0]}}, {{SagaActions[ExileACard][0]}})"
  },
  "{{SagaChapter[TheExiledCard](~Permanent)}}": {
    "{{SagaChapterNumbers}} - {{SagaActions[TheExiledCard](~Permanent)}}.": "SagaChapter({{SagaChapterNumbers[0]}}, {{SagaActions[TheExiledCard](~Permanent=^~Permanent)[0]}})"
  },
  "{{SagaChapter[TheExiledCard]}}": {
    "{{SagaChapterNumbers}} - {{SagaActions[TheExiledCard]}}.": "SagaChapter({{SagaChapterNumbers[0]}}, {{SagaActions[TheExiledCard][0]}})"
  },
  "{{SagaChapter}}": {
    "{{SagaChapterNumbers}} - {{AbilityWord}} - {{SagaActions}}.": "SagaChapter({{SagaChapterNumbers[0]}}, {{SagaActions[0]}})",
    "{{SagaChapterNumbers}} - {{FlavorWord}} - {{SagaActions(~Permanent)}}.": "SagaChapter({{SagaChapterNumbers[0]}}, {{SagaActions(~Permanent=ThisPermanent)[0]}})",
    "{{SagaChapterNumbers}} - {{FlavorWord}} - {{SagaActions(~Permanent)}}. {{Reminder}}": "SagaChapter({{SagaChapterNumbers[0]}}, {{SagaActions(~Permanent=ThisPermanent)[0]}})",
    "{{SagaChapterNumbers}} - {{FlavorWord}} - {{SagaActions}}.": "SagaChapter({{SagaChapterNumbers[0]}}, {{SagaActions[0]}})",
    "{{SagaChapterNumbers}} - {{FlavorWord}} - {{SagaActions}}. {{Reminder}}": "SagaChapter({{SagaChapterNumbers[0]}}, {{SagaActions[0]}})",
    "{{SagaChapterNumbers}} - {{SagaActions(~Permanent)}}.": "SagaChapter({{SagaChapterNumbers[0]}}, {{SagaActions(~Permanent=ThisPermanent)[0]}})",
    "{{SagaChapterNumbers}} - {{SagaActions(~Permanent)}}. {{Reminder}}": "SagaChapter({{SagaChapterNumbers[0]}}, {{SagaActions(~Permanent=ThisPermanent)[0]}})",
    "{{SagaChapterNumbers}} - {{SagaActions}}.": "SagaChapter({{SagaChapterNumbers[0]}}, {{SagaActions[0]}})",
    "{{SagaChapterNumbers}} - {{SagaActions}}. {{Reminder}}": "SagaChapter({{SagaChapterNumbers[0]}}, {{SagaActions[0]}})"
  },
  "{{SagaQuotedAbility}}": {
    "Whenever this creature deals combat damage to a player, {{TriggerActions(ThatPlayer)}}": "TriggerA(WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(ThisPermanent), AnyPlayer), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "{{ManaCost}}, {{TapSelfCost}}: {{ActivatedActions}}": "Activated(And([PayMana({{ManaCost[0]}}), {{TapSelfCost[0]}}]), {{ActivatedActions[0]}})",
    "{{Permanents}} have '{{QuotedAbility}}'": "EachPermanentLayerEffect({{Permanents[0]}}, [AddAbility([{{QuotedAbility[0]}}])])",
    "{{TapSelfCost}}: {{ActivatedActions}}": "Activated({{TapSelfCost[0]}}, {{ActivatedActions[0]}})"
  },
  "{{SelfAttachActions[ChooseACardToCopy](~Permanent)}}": {
    "As this Equipment becomes attached to a creature, choose an exiled creature card used to craft this Equipment": "AsPermanentBecomesAttachedToAPermanent(ThisPermanent, IsCardtype(Creature), [ChooseAnExiledCardToCopy(UsedToCraftPermanent({{~Permanent}}))])"
  },
  "{{SelfAttachActions[ChooseAColor](~Permanent)}}": {
    "As this Equipment becomes attached to a creature, choose a color": "AsPermanentBecomesAttachedToAPermanent(ThisPermanent, IsCardtype(Creature), [ChooseAColor(AnyColor)])"
  },
  "{{SelfCastModifier(X)}}": {
    "Spend only {{Black}} and/or {{Black}} mana on X": "CastEffect(SpendOnlyColorsOfManaOnX([{{Black[0]}}, {{Black[1]}}]))",
    "Spend only {{Black}} mana on X": "CastEffect(SpendOnlyColorManaOnX({{Black[0]}}))",
    "X can't be 0": "CastEffect(XCantBeZero)",
    "X can't be greater than {{GameNumber}}": "CastEffect(XIs(LessThan({{GameNumber[0]}})))",
    "X is the number of artifact and/or creature cards in an opponent's graveyard as you cast this spell": "CastEffect(XIs(ANumberOfCardsInAPlayersGraveyard(Or([IsCardtype(Artifact), IsCardtype(Creature)]), Opponent)))",
    "You may cast this spell as though it had flash if X is {{Digits}} or less": "CastEffect(MayCastAsThoughItHadFlashIfXIs(LessThanOrEqualTo({{Digits[0]}})))"
  },
  "{{SelfCastModifier[Kicker]}}": {
    "Kicker {{ManaCost}} {{Reminder}}\nIf this spell was kicked, it has {{Keyword[Spell]}}": "KickerForSpellAbility(PayMana({{ManaCost[0]}}), {{Keyword[Spell][0]}})"
  },
  "{{SelfCastModifier}}": {
    "As long as {{Condition}}, you may cast this spell as though it had flash": "CastEffect(MayCastAsThoughItHadFlashIf({{Condition[0]}}))",
    "Cast this spell only after combat": "CastEffect(CantBeCastUnless(IsAfterCombat))",
    "Cast this spell only before attackers are declared": "CastEffect(CantBeCastUnless(IsBeforeAttackersDeclared))",
    "Cast this spell only before blockers are declared": "CastEffect(CantBeCastUnless(IsBeforeBlockersDeclared))",
    "Cast this spell only before combat or during combat before blockers are declared": "CastEffect(CantBeCastUnless(Or([IsBeforeCombat, And([IsDuringCombat, IsBeforeBlockersDeclared])])))",
    "Cast this spell only before the combat damage step": "CastEffect(CantBeCastUnless(IsBeforeCombatDamageStep))",
    "Cast this spell only during an opponent's turn after their upkeep step": "CastEffect(CantBeCastUnless(And([IsAPlayersTurn(Opponent), IsAfterUpkeep])))",
    "Cast this spell only during an opponent's turn, before attackers are declared": "CastEffect(CantBeCastUnless(And([IsAPlayersTurn(Opponent), IsBeforeAttackersDeclared])))",
    "Cast this spell only during an opponent's upkeep": "CastEffect(CantBeCastUnless(And([IsAPlayersTurn(Opponent), IsDuringUpkeep])))",
    "Cast this spell only during combat": "CastEffect(CantBeCastUnless(IsDuringCombat))",
    "Cast this spell only during combat after blockers are declared": "CastEffect(CantBeCastUnless(And([IsDuringCombat, IsAfterBlockersAreDeclared])))",
    "Cast this spell only during combat before blockers are declared": "CastEffect(CantBeCastUnless(And([IsDuringCombat, IsBeforeBlockersDeclared])))",
    "Cast this spell only during combat on an opponent's turn": "CastEffect(CantBeCastUnless(And([IsDuringCombat, IsAPlayersTurn(Opponent)])))",
    "Cast this spell only during combat on your turn": "CastEffect(CantBeCastUnless(And([IsPlayersTurn(You), IsDuringCombat])))",
    "Cast this spell only during combat on your turn before blockers are declared": "CastEffect(CantBeCastUnless(And([IsPlayersTurn(You), IsDuringCombat, IsBeforeBlockersDeclared])))",
    "Cast this spell only during the declare attackers step": "CastEffect(CantBeCastUnless(IsDuringDeclareAttackersStep))",
    "Cast this spell only during the declare attackers step and only if you've been attacked this step": "CastEffect(CantBeCastUnless(And([IsDuringDeclareAttackersStep, PlayerPassesFilter(You, IsAttacked)])))",
    "Cast this spell only during the declare blockers step": "CastEffect(CantBeCastUnless(IsDuringDeclareBlockersStep))",
    "Cast this spell only during the declare blockers step on an opponent's turn": "CastEffect(CantBeCastUnless(And([IsDuringDeclareBlockersStep, IsAPlayersTurn(Opponent)])))",
    "Cast this spell only during your declare attackers step": "CastEffect(CantBeCastUnless(And([IsPlayersTurn(You), IsDuringDeclareAttackersStep])))",
    "Cast this spell only during your end step": "CastEffect(CantBeCastUnless(And([IsPlayersTurn(You), IsDuringEndStep])))",
    "Cast this spell only during your turn": "CastEffect(CantBeCastUnless(IsPlayersTurn(You)))",
    "Cast this spell only if {{Condition[OtherSpellThisTurn]}}": "CastEffect(CantBeCastUnless({{Condition[OtherSpellThisTurn][0]}}))",
    "Cast this spell only if {{Condition}}": "CastEffect(CantBeCastUnless({{Condition[0]}}))",
    "During turns other than yours, this spell costs {{ManaCost}} more to cast": "CastEffect(AdditionalCastingCostIf(PayMana({{ManaCost[0]}}), IsAPlayersTurn(Other(You))))",
    "During your turn, this spell costs {{CostReduce}} less to cast": "CastEffect(ReduceCastingCostIf({{CostReduce[0]}}, IsPlayersTurn(You)))",
    "If this spell is the first spell you've cast this game, you may cast it without paying its mana cost": "CastEffect(MayCastWithoutPayingIf(PlayerPassesFilter(You, HasntCastASpellThisGame(AnySpell))))",
    "If you've cast another {{Spell}} this turn, you may cast this spell without paying its mana cost": "CastEffect(MayCastWithoutPayingIf(PlayerPassesFilter(You, CastASpellThisTurn({{Spell[0]}}))))",
    "If your life total is less than your starting life total, this spell costs {{CostReduceX}} less to cast, where X is the difference": "CastEffect(ReduceCastingCostX({{CostReduceX[0]}}, Minus(StartingLifeTotalOfPlayer(You), LifeTotalOfPlayer(You))))",
    "If {{Condition}}, this spell can't be countered": "FromStackIf({{Condition[0]}}, ThisSpellEffect([CantBeCountered]))",
    "If {{Condition}}, this spell costs {{CostReduce}} less to cast": "CastEffect(ReduceCastingCostIf({{CostReduce[0]}}, {{Condition[0]}}))",
    "If {{Condition}}, you may cast this spell as though it had flash": "CastEffect(MayCastAsThoughItHadFlashIf({{Condition[0]}}))",
    "If {{Condition}}, you may cast this spell without paying its mana cost": "CastEffect(MayCastWithoutPayingIf({{Condition[0]}}))",
    "If {{Condition}}, you may cast this spell without paying its mana cost and as though it had flash": "CastEffect(MayCastAsThoughItHadFlashIf({{Condition[0]}})), CastEffect(MayCastWithoutPayingIf({{Condition[0]}}))",
    "If {{Condition}}, you may cast {{~Spell}} as though it had flash": "CastEffect(MayCastAsThoughItHadFlashIf({{Condition[0]}}))",
    "Rather than pay {2} for each previous time you've cast this spell from the command zone this game, pay {{Digits}} life that many times": "CastEffect(PayLifeForEachPreviousCastRatherThanManaForEachPreviousCast({{Digits[0]}}))",
    "Spend only mana produced by {{Permanents}} to cast this spell": "CastEffect(SpendOnlyManaFromPermanentsToCast({{Permanents[0]}}))",
    "This spell can't be copied": "FromStack(ThisSpellEffect([CantBeCopied]))",
    "This spell can't be countered": "FromStack(ThisSpellEffect([CantBeCountered]))",
    "This spell costs {{CostReduceX}} less to cast, where X is {{GameNumber}}": "CastEffect(ReduceCastingCostX({{CostReduceX[0]}}, {{GameNumber[0]}}))",
    "This spell costs {{CostReduce}} less to cast as long as {{Condition}}": "CastEffect(ReduceCastingCostIf({{CostReduce[0]}}, {{Condition[0]}}))",
    "This spell costs {{CostReduce}} less to cast during your end step": "CastEffect(ReduceCastingCostIf({{CostReduce[0]}}, And([IsPlayersTurn(You), IsDuringEndStep])))",
    "This spell costs {{CostReduce}} less to cast during your turn": "CastEffect(ReduceCastingCostIf({{CostReduce[0]}}, IsPlayersTurn(You)))",
    "This spell costs {{CostReduce}} less to cast for each other spell cast this turn": "CastEffect(ReduceCastingCostForEach({{CostReduce[0]}}, NumSpellsCastThisTurn(Other(ThisSpell))))",
    "This spell costs {{CostReduce}} less to cast for each {{Eachable}}": "CastEffect(ReduceCastingCostForEach({{CostReduce[0]}}, {{Eachable[0]}}))",
    "This spell costs {{CostReduce}} less to cast for each {{Eachable}} and each {{Eachable}}": "CastEffect(ReduceCastingCostForEach({{CostReduce[0]}}, Plus({{Eachable[0]}}, {{Eachable[1]}})))",
    "This spell costs {{CostReduce}} less to cast for each {{Eachable}}. This effect can't reduce the amount of mana this spell costs by more than {{CostReduce}}": "CastEffect(ReduceCastingCostForEachWithMaxReduction({{CostReduce[0]}}, {{Eachable[0]}}, {{CostReduce[0]}}))",
    "This spell costs {{CostReduce}} less to cast if it targets a spell or ability that targets {{a}} {{Permanent}}": "CastEffect(ReduceCastingCostIfItTargetsASpellOrAbility({{CostReduce[0]}}, TargetsAPermanent({{Permanent[0]}})))",
    "This spell costs {{CostReduce}} less to cast if it targets {{a}} {{Permanent}}": "CastEffect(ReduceCastingCostIfItTargetsAPermanent({{CostReduce[0]}}, {{Permanent[0]}}))",
    "This spell costs {{CostReduce}} less to cast if it targets {{a}} {{SpecificCard}}": "CastEffect(ReduceCastingCostIfItTargetsACard({{CostReduce[0]}}, {{SpecificCard[0]}}))",
    "This spell costs {{CostReduce}} less to cast if it targets {{a}} {{Spell}}": "CastEffect(ReduceCastingCostIfItTargetsASpell({{CostReduce[0]}}, {{Spell[0]}}))",
    "This spell costs {{CostReduce}} less to cast if it's bargained": "CastEffect(ReduceCastingCostIfItsBargained({{CostReduce[0]}}))",
    "This spell costs {{CostReduce}} less to cast if you have no other creature cards in hand or if the only other creature cards in your hand are named {{NamedCard}}": "CastEffect(ReduceCastingCostIf({{CostReduce[0]}}, Or([PlayerPassesFilter(You, NumCardsOfTypeInHandIs(EqualTo(Integer(0)), And([Other(ThisCardInHand), IsCardtype(Creature)]))), PlayerPassesFilter(You, AllCardsInHandAre(And([Other(ThisCardInHand), IsCardtype(Creature)]), IsNamed(NamedCard({{NamedCard[0]}}))))])))",
    "This spell costs {{CostReduce}} less to cast if you've cast another {{Spell}} this turn": "CastEffect(ReduceCastingCostIf({{CostReduce[0]}}, PlayerPassesFilter(You, CastASpellThisTurn({{Spell[0]}}))))",
    "This spell costs {{CostReduce}} less to cast if {{Condition}}": "CastEffect(ReduceCastingCostIf({{CostReduce[0]}}, {{Condition[0]}}))",
    "This spell costs {{CostReduce}} less to cast if {{Condition}} and {{CostReduce}} less to cast if {{Condition}}": "CastEffect(ReduceCastingCostIf({{CostReduce[0]}}, {{Condition[0]}})), CastEffect(ReduceCastingCostIf({{CostReduce[1]}}, {{Condition[1]}}))",
    "This spell costs {{CostReduce}} less to cast if {{Condition}}. It also costs {{CostReduce}} less to cast if {{Condition}}": "CastEffect(ReduceCastingCostIf({{CostReduce[0]}}, {{Condition[0]}})), CastEffect(ReduceCastingCostIf({{CostReduce[1]}}, {{Condition[1]}}))",
    "This spell costs {{Digits}} life more to cast for each target": "CastEffect(AdditionalCastingCostForEachTarget(PayLife({{Digits[0]}})))",
    "This spell costs {{ManaCost}} more to cast for each target beyond the first": "CastEffect(AdditionalCastingCostForEachTargetBeyondTheFirst(PayMana({{ManaCost[0]}})))",
    "This spell costs {{ManaCost}} more to cast if it targets {{a}} {{Permanent}}": "CastEffect(AdditionalCastingCostIfItTargetsAPermanent(PayMana({{ManaCost[0]}}), {{Permanent[0]}}))",
    "This spell has cascade as long as {{Condition}}": "FromStackIf({{Condition[0]}}, ThisSpellEffect([Cascade]))",
    "This spell has flash as long as {{Condition}}": "FlashForCasters({{Condition[0]}})",
    "You can't cast {{~Spell}} during your first, second, or third turns of the game": "CastEffect(CantBeCastIf(IsPlayersNthTurn(You, OneOf([1, 2, 3]))))",
    "You can't cast {{~Spell}} if {{Condition}}": "CastEffect(CantBeCastIf({{Condition[0]}}))",
    "You can't cast {{~Spell}} unless {{Condition}}": "CastEffect(CantBeCastUnless({{Condition[0]}}))",
    "You can't choose an untapped creature as this spell's target as you cast it": "CastEffect(CantChooseATarget(And([IsUntapped, IsCardtype(Creature)])))",
    "You can't choose an untapped permanent as this spell's target as you cast it": "CastEffect(CantChooseATarget(IsUntapped))",
    "You can't spend mana to cast this spell": "CastEffect(CantSpendManaToCast)",
    "You may cast this spell as though it had flash by tapping {{Number}} {{Permanents}} in addition to paying its other costs": "CastEffect(MayCastAsThoughItHadFlashForAdditionalCost(TapNumberPermanents({{Number[0]}}, {{Permanents[0]}})))",
    "You may cast this spell as though it had flash if it targets a commander": "CastEffect(MayCastAsThoughItHadFlashIfItTargetsAPermanent(IsACommander))",
    "You may cast this spell as though it had flash if it targets a permanent you control": "CastEffect(MayCastAsThoughItHadFlashIfItTargetsAPermanent(And([IsPermanent, ControlledByAPlayer(SinglePlayer(You))])))",
    "You may cast this spell as though it had flash if you behold a Dragon as an additional cost to cast it": "CastEffect(MayCastAsThoughItHadFlashForAdditionalCost(BeholdA(IsCreatureType(Dragon))))",
    "You may cast this spell as though it had flash if you pay {{ManaCost}} more to cast it": "CastEffect(MayCastAsThoughItHadFlashForAdditionalCost(PayMana({{ManaCost[0]}})))",
    "You may cast this spell as though it had flash if {{Condition}}": "CastEffect(MayCastAsThoughItHadFlashIf({{Condition[0]}}))",
    "You may cast this spell as though it had flash. If you cast it any time a sorcery couldn't have been cast, the controller of the permanent it becomes sacrifices it at the beginning of the next cleanup step": "CastEffect(MayCastAsThoughItHadFlashWithSpecialAction([CreateFutureTrigger(AtTheBeginningOfTheNextCleanupStep, ActionList([PlayerAction(ControllerOfPermanent(ThePermanentThisSpellBecame), SacrificePermanent(ThePermanentThisSpellBecame))]))]))",
    "{{~Spell}} has flash as long as {{Condition}}": "FlashForCasters({{Condition[0]}})"
  },
  "{{SelfCastTriggerEffect[DoubleKicker](~Spell)}}": {
    "When you cast this spell, if it was kicked with its {{ManaCost}} kicker, {{TriggerActions}}": "FromStack(TriggerI(WhenAPlayerCastsASpell(SinglePlayer(You), SingleSpell(ThisSpell)), CastSpellPassesFilter(WasKickedWithKicker({{ManaCost[0]}})), {{TriggerActions[0]}}))"
  },
  "{{SelfCastTriggerEffect[Kicker](~Spell)}}": {
    "When you cast this spell, choose one. If it was kicked, choose both instead.\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}": "FromStack(TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), SingleSpell(ThisSpell)), Modal_ChooseOneOrBothIf(CastSpellPassesFilter(WasKicked), [{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal[1]}}])))",
    "When you cast this spell, if it was kicked, {{TriggerActions}}": "FromStack(TriggerI(WhenAPlayerCastsASpell(SinglePlayer(You), SingleSpell(ThisSpell)), CastSpellPassesFilter(WasKicked), {{TriggerActions[0]}}))"
  },
  "{{SelfCastTriggerEffect(X)}}": {
    "When you cast this spell, copy it X times. You may choose new targets for the copies":
      "FromStack(TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), SingleSpell(ThisSpell)), ActionList([CopySpellNumberTimesAndMayChooseNewTargets(ThisSpell, ValueX)])))",
  },
  "{{SelfCastTriggerEffect}}": {
    "When you cast this spell from anywhere other than exile, {{TriggerActions(ThatSpell)}}": "FromStack(TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), And([SingleSpell(ThisSpell), WasntCastFromExile])), {{TriggerActions(ThatSpell=Trigger_ThatSpell)[0]}}))",
    "When you cast this spell from your hand, {{TriggerActions(ThatSpell)}}": "FromStack(TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), And([SingleSpell(ThisSpell), WasCastFromTheirHand])), {{TriggerActions(ThatSpell=Trigger_ThatSpell)[0]}}))",
    "When you cast this spell from your graveyard, {{TriggerActions}}": "FromStack(TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), And([SingleSpell(ThisSpell), WasCastFromTheirGraveyard])), {{TriggerActions[0]}}))",
    "When you cast this spell while {{Condition}}, you may copy this spell": "FromStack(TriggerA(If({{Condition[0]}}, WhenAPlayerCastsASpell(SinglePlayer(You), SingleSpell(ThisSpell))), ActionList([MayAction(CopySpell(ThisSpell))])))",
    "When you cast this spell, create a number of {{PT}} {{CreatureTokens}} named {{NamedCard}} equal to the amount of mana spent to cast it": "FromStack(TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), SingleSpell(ThisSpell)), ActionList([CreateTokens([NumberTokens(AmountOfManaSpentToCastSpell(Trigger_ThatSpell), NamedTokenWithPT({{NamedCard[0]}}, {{PT[0]}}, {{CreatureTokens[0]}}, []))])])))",
    "When you cast this spell, create a token that's a copy of it, except it isn't legendary": "FromStack(TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), SingleSpell(ThisSpell)), ActionList([CreateTokens([TokenCopyOfSpell(ThisSpell, TokenCopyEffects([RemoveSupertypes([Legendary])]))])])))",
    "When you cast this spell, each player reveals the top card of their library. This creature enters with X {{CounterType}} counters on it, where X is the total mana value of all cards revealed this way": "FromStack(TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), SingleSpell(ThisSpell)), ActionList([EachPlayerAction(AnyPlayer, RevealTopCardOfLibrary), CreateSpellEffect(ThisSpell, [EntersWithNumberCounters(TotalManaValueOfTheCardsRevealedThisWay, {{CounterType[0]}})])])))",
    "When you cast this spell, each player sacrifices X creatures. This creature enters with {{Number}} {{CounterType}} counters on it for each creature sacrificed this way": "FromStack(TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), SingleSpell(ThisSpell)), ActionList([EachPlayerAction(AnyPlayer, SacrificeNumberPermanents(Trigger_ValueXOfThatSpell, IsCardtype(Creature))), CreateSpellEffect(ThisSpell, [EntersWithNumberCounters(Multiply({{Number[0]}}, TheNumberOfPermanentsOfTypeSacrificedThisWay(IsCardtype(Creature))), {{CounterType[0]}})])])))",
    "When you cast this spell, if you have fewer than {{Number}} cards in hand, draw cards equal to the difference": "FromStack(TriggerI(WhenAPlayerCastsASpell(SinglePlayer(You), SingleSpell(ThisSpell)), PlayerPassesFilter(You, NumCardsInHandIs(LessThan({{Number[0]}}))), ActionList([DrawNumberCards(Minus({{Number[0]}}, TheNumberOfCardsInPlayersHand(You)))])))",
    "When you cast this spell, if you've cast another spell this turn, copy this spell": "FromStack(TriggerI(WhenAPlayerCastsASpell(SinglePlayer(You), SingleSpell(ThisSpell)), PlayerPassesFilter(You, CastASpellThisTurn(Other(Trigger_ThatSpell))), ActionList([CopySpell(Trigger_ThatSpell)])))",
    "When you cast this spell, if {{Condition}}, copy this spell twice. You may choose new targets for the copies": "FromStack(TriggerI(WhenAPlayerCastsASpell(SinglePlayer(You), SingleSpell(ThisSpell)), {{Condition[0]}}, ActionList([CopySpellNumberTimesAndMayChooseNewTargets(ThisSpell, Integer(2))])))",
    "When you cast this spell, if {{Condition}}, {{TriggerActions(~Spell)}}": "FromStack(TriggerI(WhenAPlayerCastsASpell(SinglePlayer(You), SingleSpell(ThisSpell)), {{Condition[0]}}, {{TriggerActions(~Spell=ThisSpell)[0]}}))",
    "When you cast this spell, if {{ManaProduceSymbol}} was spent to cast it, {{TriggerActions}}": "FromStack(TriggerI(WhenAPlayerCastsASpell(SinglePlayer(You), SingleSpell(ThisSpell)), CastSpellPassesFilter(ManaWasSpentToCastIt([{{ManaProduceSymbol[0]}}])), {{TriggerActions[0]}}))",
    "When you cast this spell, if {{ManaProduceSymbol}} wasn't spent to cast it, {{TriggerActions}}": "FromStack(TriggerI(WhenAPlayerCastsASpell(SinglePlayer(You), SingleSpell(ThisSpell)), CastSpellPassesFilter(ManaWasntSpentToCastIt({{ManaProduceSymbol[0]}})), {{TriggerActions[0]}}))",
    "When you cast this spell, {{TriggerActions(ThatSpell)}}": "FromStack(TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), SingleSpell(ThisSpell)), {{TriggerActions(ThatSpell=Trigger_ThatSpell)[0]}}))",
    "When you cast this spell, {{TriggerActions(X)}}": "FromStack(TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), SingleSpell(ThisSpell)), {{TriggerActions(X=Trigger_ValueXOfThatSpell)[0]}}))",
    "When you cast this spell, {{TriggerActions(~Spell)}}": "FromStack(TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), SingleSpell(ThisSpell)), {{TriggerActions(~Spell=ThisSpell)[0]}}))",
    "When you cast this spell, {{TriggerActions}}": "FromStack(TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), SingleSpell(ThisSpell)), {{TriggerActions[0]}}))"
  },
  "{{SelfEntersActions(~Permanent)}}": {
    "As {{ThisPermanent}} enters or is turned face up, it becomes your choice of {{PT}} or {{PT}}": "AsPermanentEntersOrIsTurnedFaceUp({{~Permanent}}, [EntersWithPTOfChoice([{{PT[0]}}, {{PT[1]}}])])",
    "As {{ThisPermanent}} enters or is turned face up, put X {{CounterType}} counters on it, where X is {{GameNumber(ThatPermanent)}}": "AsPermanentEntersOrIsTurnedFaceUp({{~Permanent}}, [EntersWithNumberCounters({{GameNumber(ThatPermanent=^~Permanent)[0]}}, {{CounterType[0]}})])",
    "As {{ThisPermanent}} enters or is turned face up, you may choose another creature on the battlefield. If you do, until this creature is turned face down, it becomes a copy of that creature, except it has \"{{QuotedAbility}}\"": "AsPermanentEntersOrIsTurnedFaceUp({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanentUntil(And([Other({{~Permanent}}), IsCardtype(Creature)]), CopyEffects([AddAbility([{{QuotedAbility[0]}}])]), UntilPermanentIsTurnedFaceDown({{~Permanent}}))])])",
    "As {{ThisPermanent}} enters, choose Abzan or Mardu.\n* Abzan - {{TriggerEffect}}.\n* Mardu - {{TriggerEffect}}": "AsPermanentEnters(ThisPermanent, [ChooseWord([\"Abzan\", \"Mardu\"])]), AnchorWord(\"Abzan\", {{TriggerEffect[0]}}), AnchorWord(\"Mardu\", {{TriggerEffect[1]}})",
    "As {{ThisPermanent}} enters, choose Believe or Doubt.\n* Believe - {{TriggerEffect}}.\n* Doubt - {{TriggerEffect}}": "AsPermanentEnters({{~Permanent}}, [ChooseWord([\"Believe\", \"Doubt\"])]), AnchorWord(\"Believe\", {{TriggerEffect[0]}}), AnchorWord(\"Doubt\", {{TriggerEffect[1]}})",
    "As {{ThisPermanent}} enters, choose Brotherhood or Enclave.\n* Brotherhood - {{TriggerEffect}}.\n* Enclave - {{TriggerEffect}}": "AsPermanentEnters({{~Permanent}}, [ChooseWord([\"Brotherhood\", \"Enclave\"])]), AnchorWord(\"Brotherhood\", {{TriggerEffect[0]}}), AnchorWord(\"Enclave\", {{TriggerEffect[1]}})",
    "As {{ThisPermanent}} enters, choose Jeskai or Temur.\n* Jeskai - {{TriggerEffect}}.\n* Temur - {{StaticEffect}}": "AsPermanentEnters(ThisPermanent, [ChooseWord([\"Jeskai\", \"Temur\"])]), AnchorWord(\"Jeskai\", {{TriggerEffect[0]}}), AnchorWord(\"Temur\", {{StaticEffect[0]}})",
    "As {{ThisPermanent}} enters, choose Khans or Dragons.\n* Khans - {{TriggerEffect}}.\n* Dragons - {{StaticEffect}}": "AsPermanentEnters({{~Permanent}}, [ChooseWord([\"Khans\", \"Dragons\"])]), AnchorWord(\"Khans\", {{TriggerEffect[0]}}), AnchorWord(\"Dragons\", {{StaticEffect[0]}})",
    "As {{ThisPermanent}} enters, choose Khans or Dragons.\n* Khans - {{TriggerEffect}}.\n* Dragons - {{TriggerEffect(~Permanent)}}": "AsPermanentEnters({{~Permanent}}, [ChooseWord([\"Khans\", \"Dragons\"])]), AnchorWord(\"Khans\", {{TriggerEffect[0]}}), AnchorWord(\"Dragons\", {{TriggerEffect(~Permanent=^~Permanent)[0]}})",
    "As {{ThisPermanent}} enters, choose Khans or Dragons.\n* Khans - {{TriggerEffect}}.\n* Dragons - {{TriggerEffect}}": "AsPermanentEnters({{~Permanent}}, [ChooseWord([\"Khans\", \"Dragons\"])]), AnchorWord(\"Khans\", {{TriggerEffect[0]}}), AnchorWord(\"Dragons\", {{TriggerEffect[1]}})",
    "As {{ThisPermanent}} enters, choose Mardu or Jeskai.\n* Mardu - {{StaticEffect}}.\n* Jeskai - {{TriggerEffect}}": "AsPermanentEnters(ThisPermanent, [ChooseWord([\"Mardu\", \"Jeskai\"])]), AnchorWord(\"Mardu\", {{StaticEffect[0]}}), AnchorWord(\"Jeskai\", {{TriggerEffect[0]}})",
    "As {{ThisPermanent}} enters, choose Mirran or Phyrexian.\n* Mirran - {{TriggerEffect}}.\n* Phyrexian - {{TriggerEffect}}": "AsPermanentEnters({{~Permanent}}, [ChooseWord([\"Mirran\", \"Phyrexian\"])]), AnchorWord(\"Mirran\", {{TriggerEffect[0]}}), AnchorWord(\"Phyrexian\", {{TriggerEffect[1]}})",
    "As {{ThisPermanent}} enters, choose NCR or Legion.\n* NCR - {{TriggerEffect}}.\n* Legion - {{TriggerEffect}}": "AsPermanentEnters({{~Permanent}}, [ChooseWord([\"NCR\", \"Legion\"])]), AnchorWord(\"NCR\", {{TriggerEffect[0]}}), AnchorWord(\"Legion\", {{TriggerEffect[0]}})",
    "As {{ThisPermanent}} enters, choose Sultai or Abzan.\n* Sultai - {{TriggerEffect}}.\n* Abzan - {{TriggerEffect}}": "AsPermanentEnters({{~Permanent}}, [ChooseWord([\"Sultai\", \"Abzan\"])]), AnchorWord(\"Sultai\", {{TriggerEffect[0]}}), AnchorWord(\"Abzan\", {{TriggerEffect[1]}})",
    "As {{ThisPermanent}} enters, choose Temur or Sultai.\n* Temur - {{TriggerEffect}}.\n* Sultai - {{StaticEffect}}": "AsPermanentEnters(ThisPermanent, [ChooseWord([\"Temur\", \"Sultai\"])]), AnchorWord(\"Temur\", {{TriggerEffect[0]}}), AnchorWord(\"Sultai\", {{StaticEffect[0]}})",
    "As {{ThisPermanent}} enters, choose a {{Creature}} it could be attached to. If you do, it enters attached to that creature": "AsPermanentEnters({{~Permanent}}, [EntersAttachedToAPermanent({{Creature[0]}})])",
    "As {{ThisPermanent}} enters, choose an opponent. This creature enters with {{a}} {{CounterType}} counter on it for each {{Eachable(ThatPlayer)}}": "AsPermanentEnters({{~Permanent}}, [ChooseAPlayer(Opponent), EntersWithNumberCounters({{Eachable(ThatPlayer=TheChosenPlayer)[0]}}, {{CounterType[0]}})])",
    "As {{ThisPermanent}} enters, discard your hand": "AsPermanentEnters({{~Permanent}}, [DiscardHand])",
    "As {{ThisPermanent}} enters, draft a card from {{Spellbook}} and exile it face down": "AsPermanentEnters({{~Permanent}}, [DraftACardFromSpellBook({{Spellbook[0]}}), ExileCardFromHandFaceDown(TheCardDraftedThisWay)])",
    "As {{ThisPermanent}} enters, each player chooses war or peace": "AsPermanentEnters({{~Permanent}}, [EachPlayerAction(AnyPlayer, ChooseWord([\"War\", \"Peace\"]))])",
    "As {{ThisPermanent}} enters, flip a coin. If the coin comes up heads, this creature enters as {{a}} {{PT}} creature with {{Hasable}}. If it comes up tails, this creature enters as {{a}} {{PT}} creature with {{Hasable}}": "AsPermanentEnters({{~Permanent}}, [FlipACoin_OnHeadAndOnTails([EntersWithLayerEffect([SetCopiablePT({{PT[0]}}), AddCopiableCardtype(Creature), AddCopiableAbility([{{Hasable[0]}}])])], [EntersWithLayerEffect([SetCopiablePT({{PT[1]}}), AddCopiableCardtype(Creature), AddCopiableAbility([{{Hasable[1]}}])])])])",
    "As {{ThisPermanent}} enters, it becomes your choice of {{a}} {{PT}} artifact creature, {{a}} {{PT}} artifact creature with {{Hasable}}, or {{a}} {{PT}} {{Zombie}} artifact creature with {{Hasable}} in addition to its other types": "AsPermanentEnters({{~Permanent}}, [EntersWithLayerEffectOfChoice([[SetCopiablePT({{PT[0]}}), AddCopiableCardtype(Artifact), AddCopiableCardtype(Creature)], [SetCopiablePT({{PT[1]}}), AddCopiableCardtype(Artifact), AddCopiableCardtype(Creature), AddCopiableAbility([{{Hasable[0]}}])], [SetCopiablePT({{PT[0]}}), AddCopiableCreatureType({{Zombie[0]}}), AddCopiableCardtype(Artifact), AddCopiableCardtype(Creature), AddCopiableAbility([{{Hasable[1]}}])]])])",
    "As {{ThisPermanent}} enters, it becomes your choice of {{a}} {{PT}} creature with {{Hasable}}, {{a}} {{PT}} creature with {{Hasable}}, or {{a}} {{PT}} creature with {{Hasable}}": "AsPermanentEnters({{~Permanent}}, [EntersWithLayerEffectOfChoice([[SetCopiablePT({{PT[0]}}), AddCopiableCardtype(Creature), AddCopiableAbility([{{Hasable[0]}}])], [SetCopiablePT({{PT[1]}}), AddCopiableCardtype(Creature), AddCopiableAbility([{{Hasable[1]}}])], [SetCopiablePT({{PT[0]}}), AddCopiableCardtype(Creature), AddCopiableAbility([{{Hasable[2]}}])]])])",
    "As {{ThisPermanent}} enters, it becomes your choice of {{a}} {{PT}} creature, {{a}} {{PT}} creature with {{Hasable}}, or {{a}} {{PT}} creature with {{Hasable}}": "AsPermanentEnters({{~Permanent}}, [EntersWithLayerEffectOfChoice([[SetCopiablePT({{PT[0]}}), AddCopiableCardtype(Creature)], [SetCopiablePT({{PT[1]}}), AddCopiableCardtype(Creature), AddCopiableAbility([{{Hasable[0]}}])], [SetCopiablePT({{PT[0]}}), AddCopiableCardtype(Creature), AddCopiableAbility([{{Hasable[1]}}])]])])",
    "As {{ThisPermanent}} enters, note your life total": "AsPermanentEnters({{~Permanent}}, [RememberLifeTotal])",
    "As {{ThisPermanent}} enters, put {{a}} {{CounterType}} counter on {{a}} {{Permanent}}": "AsPermanentEnters({{~Permanent}}, [PutACounterOfTypeOnAPermanent({{CounterType[0]}}, {{Permanent[0]}})])",
    "As {{ThisPermanent}} enters, remove all counters from all permanents. This creature enters with {{a}} {{CounterType}} counter on it for each counter removed this way": "AsPermanentEnters({{~Permanent}}, [RemoveAllCountersFromEachPermanent(AnyPermanent), EntersWithNumberCounters(NumberOfCountersRemovedThisWay, {{CounterType[0]}})])",
    "As {{ThisPermanent}} enters, roll a six-sided die twice. Its base power becomes the first result and its base toughness becomes the second result": "AsPermanentEnters({{~Permanent}}, [RollTwoD6, EntersWithLayerEffect([SetPower(TheFirstDiceResult), SetToughness(TheSecondDiceResult)])])",
    "As {{ThisPermanent}} enters, sacrifice all {{Permanents}}": "AsPermanentEnters({{~Permanent}}, [SacrificeEachPermanent({{Permanents[0]}})])",
    "As {{ThisPermanent}} enters, sacrifice any number of {{Permanents}}": "AsPermanentEnters({{~Permanent}}, [SacrificeAnyNumberOfPermanents({{Permanents[0]}})])",
    "As {{ThisPermanent}} enters, sacrifice any number of {{Permanents}}. This creature's power becomes the total power of those creatures and its toughness becomes their total toughness": "AsPermanentEnters({{~Permanent}}, [SacrificeAnyNumberOfPermanents({{Permanents[0]}}), EntersWithLayerEffect([SetPower(TotalPowerOfPermanents(ThePermanentsSacrificedThisWay)), SetToughness(TotalToughnessOfPermanents(ThePermanentsSacrificedThisWay))])])",
    "As {{ThisPermanent}} enters, turn all other nontoken creatures face down": "AsPermanentEnters({{~Permanent}}, [TurnEachPermanentFaceDown(And([Other({{~Permanent}}), IsNonToken, IsCardtype(Creature)]))])",
    "As {{ThisPermanent}} enters, you lose life equal to your life total": "AsPermanentEnters({{~Permanent}}, [LoseLife(LifeTotalOfPlayer(You))])",
    "As {{ThisPermanent}} enters, you may have it become a copy of any {{Permanent}} on the battlefield until end of turn, except it has {{Hasable}}": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanentUntil({{Permanent[0]}}, CopyEffects([AddAbility([{{Hasable[0]}}])]), UntilEndOfTurn)])])",
    "As {{ThisPermanent}} enters, you may pay {{Digits}} life. If you don't, it enters tapped": "AsPermanentEnters({{~Permanent}}, [MayCost(PayLife({{Digits[0]}})), Unless(CostWasPaid, [EntersTapped])])",
    "As {{ThisPermanent}} enters, you may put {{Number}} cards your opponents own from exile into their owners' graveyards. If you do, this creature enters with {{Number}} {{CounterType}} counters on it": "AsPermanentEnters({{~Permanent}}, [MayCost(PutANumberOfExiledCardsIntoOwnersGraveyard({{Number[0]}}, OwnedByAPlayer(Opponent))), If(CostWasPaid, [EntersWithNumberCounters({{Number[1]}}, {{CounterType[0]}})])])",
    "As {{ThisPermanent}} enters, you may return {{a}} {{Permanent}} to its owner's hand. If you do, this creature enters with {{a}} {{CounterType}} counter on it": "AsPermanentEnters({{~Permanent}}, [MayCost(PutAPermanentIntoItsOwnersHand({{Permanent[0]}})), If(CostWasPaid, [EntersWithACounter({{CounterType[0]}})])])",
    "As {{ThisPermanent}} enters, you may reveal any number of other {{SpecificCards}} from your hand. This creature enters with {{a}} {{CounterType}} counter on it for each card revealed this way": "AsPermanentEnters({{~Permanent}}, [MayCost(RevealAnyNumberOfCardsOfTypeFromHand({{SpecificCards[0]}})), If(CostWasPaid, [EntersWithNumberCounters(TheNumberOfCardsInHandRevealedThisWay, {{CounterType[0]}})])])",
    "As {{ThisPermanent}} enters, you may reveal {{a}} {{SpecificCard}} from your hand. If you do or if {{Condition}}, this creature enters with {{a}} {{CounterType}} counter on it": "AsPermanentEnters({{~Permanent}}, [MayCost(RevealACardOfTypeFromHand({{SpecificCard[0]}})), If(Or([CostWasPaid, {{Condition[0]}}]), [EntersWithACounter({{CounterType[0]}})])])",
    "As {{ThisPermanent}} enters, you may reveal {{a}} {{SpecificCard}} from your hand. If you don't, {{ThisPermanent}} enters tapped": "AsPermanentEnters({{~Permanent}}, [MayCost(RevealACardOfTypeFromHand({{SpecificCard[0]}})), Unless(CostWasPaid, [EntersTapped])])",
    "As {{ThisPermanent}} enters, you may reveal {{a}} {{SpecificCard}} from your hand. {{ThisPermanent}} enters tapped unless you revealed {{a}} {{SpecificCard}} this way or {{Condition}}": "AsPermanentEnters({{~Permanent}}, [MayCost(RevealACardOfTypeFromHand({{SpecificCard[0]}})), Unless(Or([CostWasPaid, {{Condition[0]}}]), [EntersTapped])])",
    "As {{ThisPermanent}} enters, you may sacrifice any number of {{Permanents}}. If you do, it enters with twice that many {{CounterType}} counters on it": "AsPermanentEnters({{~Permanent}}, [SacrificeAnyNumberOfPermanents({{Permanents[0]}}), EntersWithNumberCounters(TheNumberOfPermanentsSacrificedThisWay, {{CounterType[0]}})])",
    "As {{~Permanent}} enters the battlefield, choose {{a}} {{Permanent}}. When the chosen permanent is put into a graveyard from the battlefield, conjure a card named {{NamedCard}} into your hand": "AsPermanentEnters({{~Permanent}}, [ChooseAPermanent({{Permanent[0]}}), CreateFutureTrigger(WhenPermanentIsPutIntoAPlayersGraveyard(ThePermanentChosenThisWay, AnyPlayer), ActionList([ConjureCardIntoHand({{NamedCard[0]}})]))])",
    "As {{~Permanent}} enters, discard any number of creature cards. It enters with {{an}} {{AbilityCounter}} counter on it if a card discarded this way has {{CheckHasable}}. The same is true for {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, and {{CheckHasable}}": "AsPermanentEnters({{~Permanent}}, [DiscardAnyNumberOfCardsOfType(IsCardtype(Creature)), EntersWithAnAbilityCounterForEachAbilityOnACardDiscardedThisWay([{{CheckHasable[0]}}, {{CheckHasable[1]}}, {{CheckHasable[2]}}, {{CheckHasable[3]}}, {{CheckHasable[4]}}, {{CheckHasable[5]}}, {{CheckHasable[6]}}, {{CheckHasable[7]}}, {{CheckHasable[8]}}, {{CheckHasable[9]}}, {{CheckHasable[10]}}, {{CheckHasable[11]}}])])",
    "As {{~Permanent}} enters, remove all counters from any number of {{Permanents}}. {{~Permanent}} enters with X {{CounterType}} counters on it, where X is twice the number of counters removed this way": "AsPermanentEnters({{~Permanent}}, [RemoveAllCountersFromAnyNumberOfPermanents({{Permanents[0]}}), EntersWithNumberCounters(Twice(NumberOfCountersRemovedThisWay), {{CounterType[0]}})])",
    "As {{~Permanent}} enters, sacrifice any number of {{Permanents}}. {{~Permanent}} enters with that many {{CounterType}} counters on it": "AsPermanentEnters({{~Permanent}}, [SacrificeAnyNumberOfPermanents({{Permanents[0]}}), EntersWithNumberCounters(TheNumberOfPermanentsSacrificedThisWay, {{CounterType[0]}})])",
    "As {{~Permanent}} enters, you get an emblem with \"You may play cards exiled with {{~Permanent}}, and you may spend mana as though it were mana of any color to cast those spells\"": "AsPermanentEnters({{~Permanent}}, [GetAnEmblem([PlayerEffect(You, [MayPlayExiledCardsAndMaySpendManaAsThoughAnyColorToCast(WasExiledWithPermanent(ThePermanentThatCreatedThisEmblem))])])])",
    "As {{~Permanent}} enters, you may exchange his text box and another creature's": "AsPermanentEnters({{~Permanent}}, [MayActions([ChooseAPermanent(And([Other(ThisPermanent), IsCardtype(Creature)])), ExchangeTextBoxesOfTwoPermanents(ThisPermanent, ThePermanentChosenThisWay)])])",
    "As {{~Permanent}} enters, you may exile two creature cards from graveyards. If you do, it enters as a copy of one of those cards with a number of additional {{CounterType}} counters on it equal to the power of the other card": "AsPermanentEnters({{~Permanent}}, [MayCost(ExileTwoCardsFromAmongPlayersGraveyards(IsCardtype(Creature), AnyPlayer)), If(CostWasPaid, [EnterAsCopyOfExiled(TheFirstCardExiledThisWay, NoCopyEffects), EntersWithNumberCounters(PowerOfExiledCard(TheSecondCardExiledThisWay), {{CounterType[0]}})])])",
    "As {{~Permanent}} enters, you may pay {{Digits}} life. If you don't, it enters tapped": "AsPermanentEnters({{~Permanent}}, [MayCost(PayLife({{Digits[0]}})), Unless(CostWasPaid, [EntersTapped])])",
    "During your first {{Number}} turns of the game, {{~Permanent}} enters tapped if you were the starting player": "AsPermanentEnters({{~Permanent}}, [If(And([IsTheNthTurnOfTheGame(LessThanOrEqualTo({{Number[0]}})), PlayerPassesFilter(You, IsTheStartingPlayer)]), [EntersTapped])])",
    "If at least {{Number}} mana of the same color was spent to cast this spell, this creature enters with {{a}} {{CounterType}} counter on it": "AsPermanentEnters({{~Permanent}}, [If(EnteringPermanentPassesFilter(ManaAmountOfSameColorWasSpentToCastIt(GreaterThanOrEqualTo({{Number[0]}}))), [EntersWithACounter({{CounterType[0]}})])])",
    "If at least {{Number}} {{Black}} mana was spent to cast this spell, this creature enters with {{a}} {{CounterType}} counter on it": "AsPermanentEnters({{~Permanent}}, [IfPassesFilter(ManaAmountOfTypeWasSpentToCastIt(GreaterThanOrEqualTo({{Number[0]}}), {{Black[0]}}), [EntersWithACounter({{CounterType[0]}})])])",
    "If it's neither day nor night, it becomes day as this creature enters": "AsPermanentEnters({{~Permanent}}, [If(ItsNeitherDayOrNight, [BecomeDay])])",
    "If it's neither day nor night, it becomes day as {{~Permanent}} enters": "AsPermanentEnters({{~Permanent}}, [If(ItsNeitherDayOrNight, [BecomeDay])])",
    "If this artifact would enter, you may discard a land card instead. If you do, put this artifact onto the battlefield. If you don't, put it into its owner's graveyard": "ReplaceWouldEnter(PermanentWouldEnterTheBattlefield({{~Permanent}}), [MayCost(DiscardACardOfType(IsCardtype(Land))), IfElse(CostWasPaid, [EntersNormally], [PutIntoGraveyardInstead])])",
    "If this creature would enter and it wasn't cast or no mana was spent to cast it, exile it instead": "ReplaceWouldEnter(PermanentWouldEnterTheBattlefieldAndWasntCastOrNoManaWasSpentToCast({{~Permanent}}), [ExileItInstead])",
    "If this land would enter, instead sacrifice each other permanent named {{NamedCard}} you control, then put this land onto the battlefield":
      "ReplaceWouldEnter(PermanentWouldEnterTheBattlefield({{~Permanent}}), [SacrificeEachPermanent(And([IsNamed(NamedCard({{NamedCard[0]}})), ControlledByAPlayer(SinglePlayer(You))])), EntersNormally])",
    "If this land would enter, sacrifice an untapped {{Swamp}} instead. If you do, put this land onto the battlefield. If you don't, put it into its owner's graveyard": "ReplaceWouldEnter(PermanentWouldEnterTheBattlefield({{~Permanent}}), [MustCost(SacrificeAPermanent(And([IsUntapped, IsLandType({{Swamp[0]}})]))), IfElse(CostWasPaid, [EntersNormally], [PutIntoGraveyardInstead])])",
    "If this land would enter, sacrifice {{Number}} untapped lands instead. If you do, put this land onto the battlefield. If you don't, put it into its owner's graveyard": "ReplaceWouldEnter(PermanentWouldEnterTheBattlefield({{~Permanent}}), [MustCost(SacrificeNumberPermanents({{Number[0]}}, And([IsUntapped, IsCardtype(Land)]))), IfElse(CostWasPaid, [EntersNormally], [PutIntoGraveyardInstead])])",
    "If this land would enter, sacrifice {{a}} {{Swamp}} instead. If you do, put this land onto the battlefield. If you don't, put it into its owner's graveyard": "ReplaceWouldEnter(PermanentWouldEnterTheBattlefield({{~Permanent}}), [MustCost(SacrificeAPermanent(IsLandType({{Swamp[0]}}))), IfElse(CostWasPaid, [EntersNormally], [PutIntoGraveyardInstead])])",
    "If {{Condition(ThatPermanent)}}, this land enters tapped": "AsPermanentEnters({{~Permanent}}, [If({{Condition(ThatPermanent=^~Permanent)[0]}}, [EntersTapped])])",
    "If {{Condition}}, this creature enters with {{Number}} {{CounterType}} counters and {{a}} {{CounterType}} counter on it": "If({{Condition[0]}}, [AsPermanentEnters({{~Permanent}}, [EntersWithNumberCounters({{Number[0]}}, {{CounterType[0]}}), EntersWithACounter({{CounterType[1]}})])])",
    "If {{Condition}}, this land enters tapped": "AsPermanentEnters({{~Permanent}}, [If({{Condition[0]}}, [EntersTapped])])",
    "If {{Condition}}, you may have this creature enter as a copy of any creature on the battlefield": "AsPermanentEnters({{~Permanent}}, [If({{Condition[0]}}, [MayActions([EnterAsACopyOfAPermanent(IsCardtype(Creature), NoCopyEffects)])])])",
    "You may have {{ThisPermanent}} enter as a copy of any creature card in a graveyard": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfACardInAPlayersGraveyard(IsCardtype(Creature), AnyPlayer, NoCopyEffects)])])",
    "You may have {{ThisPermanent}} enter as a copy of any creature card in a graveyard that was put there from the battlefield this turn, except it's {{a}} {{Zombie}} in addition to its other types": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfACardInAPlayersGraveyard(And([IsCardtype(Creature), WasPutIntoGraveyardFromTheBattlefieldThisTurn]), AnyPlayer, CopyEffects([AddCreatureTypes([{{Zombie[0]}}])]))])])",
    "You may have {{ThisPermanent}} enter as a copy of any creature card in a graveyard, except it's {{a}} {{PT}} {{Black}} {{Zombie}} in addition to its other colors and types": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfACardInAPlayersGraveyard(IsCardtype(Creature), AnyPlayer, CopyEffects([SetPT({{PT[0]}}), AddColor(SimpleColorList([{{Black[0]}}])), AddCreatureTypes([{{Zombie[0]}}])]))])])",
    "You may have {{ThisPermanent}} enter as a copy of any creature on the battlefield, except it enters with {{a}} {{CounterType}} counter on it if you control that creature": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent(IsCardtype(Creature), NoCopyEffects), If(APermanentWasCopiedThisWay(ControlledByAPlayer(SinglePlayer(You))), [EntersWithACounter({{CounterType[0]}})])])])",
    "You may have {{ThisPermanent}} enter as a copy of any {{Creature}} on the battlefield, except it's an artifact and it has \"{{QuotedAbility}}\"": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent({{Creature[0]}}, CopyEffects([SetCardtypes([Artifact]), AddAbility([{{QuotedAbility[0]}}])]))])])",
    "You may have {{ThisPermanent}} enter as a copy of any {{Permanent}}": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent({{Permanent[0]}}, NoCopyEffects)])])",
    "You may have {{ThisPermanent}} enter as a copy of any {{Permanent}} on the battlefield": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent({{Permanent[0]}}, NoCopyEffects)])])",
    "You may have {{ThisPermanent}} enter as a copy of any {{Permanent}} on the battlefield with mana value less than or equal to the amount of mana spent to cast this creature, except it's {{a}} {{Zombie}} in addition to its other types and it has {{Hasable}}": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent(And([{{Permanent[0]}}, ManaValueIs(LessThanOrEqualTo(AmountOfManaSpentToCastSpell(ThisSpell)))]), CopyEffects([AddCreatureTypes([{{Zombie[0]}}]), AddAbility([{{Hasable[0]}}])]))])])",
    "You may have {{ThisPermanent}} enter as a copy of any {{Permanent}} on the battlefield, except if this creature was embalmed, the token has no mana cost, it's {{Black}}, and it's {{a}} {{Zombie}} in addition to its other types": "AsPermanentEnters({{~Permanent}}, [IfElsePassesFilter(WasEmbalmed, [MayActions([EnterAsACopyOfAPermanent({{Permanent[0]}}, CopyEffects([HasNoManaCost, SetColor(SimpleColorList([{{Black[0]}}])), AddCreatureTypes([{{Zombie[0]}}])]))])], [MayActions([EnterAsACopyOfAPermanent({{Permanent[0]}}, NoCopyEffects)])])])",
    "You may have {{ThisPermanent}} enter as a copy of any {{Permanent}} on the battlefield, except it doesn't copy that creature's color and it has \"{{QuotedAbility}}\"": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent({{Permanent[0]}}, CopyEffects([KeepColor, AddAbility([{{QuotedAbility[0]}}])]))])])",
    "You may have {{ThisPermanent}} enter as a copy of any {{Permanent}} on the battlefield, except it has \"{{QuotedAbility}}\"": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent({{Permanent[0]}}, CopyEffects([AddAbility([{{QuotedAbility[0]}}])]))])])",
    "You may have {{ThisPermanent}} enter as a copy of any {{Permanent}} on the battlefield, except it has vanishing {{RawDigits}} if that creature doesn't have vanishing": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent({{Permanent[0]}}, CopyEffects([AddAbilityIfItDoesntHaveAbility(VanishingEnters({{RawDigits[0]}}), AnyVanishing)]))])])",
    "You may have {{ThisPermanent}} enter as a copy of any {{Permanent}} on the battlefield, except it has {{Hasable}}": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent({{Permanent[0]}}, CopyEffects([AddAbility([{{Hasable[0]}}])]))])])",
    "You may have {{ThisPermanent}} enter as a copy of any {{Permanent}} on the battlefield, except it has {{Hasable}} and {{Hasable}}": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent({{Permanent[0]}}, CopyEffects([AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])]))])])",
    "You may have {{ThisPermanent}} enter as a copy of any {{Permanent}} on the battlefield, except it isn't legendary, is an artifact in addition to its other types, and has {{Hasable}}": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent({{Permanent[0]}}, CopyEffects([RemoveSupertypes([Legendary]), AddCardtypes([Artifact]), AddAbility([{{Hasable[0]}}])]))])])",
    "You may have {{ThisPermanent}} enter as a copy of any {{Permanent}} on the battlefield, except it's an artifact in addition to its other types": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent({{Permanent[0]}}, CopyEffects([AddCardtypes([Artifact])]))])])",
    "You may have {{ThisPermanent}} enter as a copy of any {{Permanent}} on the battlefield, except it's an enchantment in addition to its other types": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent({{Permanent[0]}}, CopyEffects([AddCardtypes([Enchantment])]))])])",
    "You may have {{ThisPermanent}} enter as a copy of any {{Permanent}} on the battlefield, except it's {{PT}}": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent({{Permanent[0]}}, CopyEffects([SetPT({{PT[0]}})]))])])",
    "You may have {{ThisPermanent}} enter as a copy of any {{Permanent}} on the battlefield, except it's {{a}} {{Zombie}} artifact creature in addition to its other types": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent({{Permanent[0]}}, CopyEffects([AddCreatureTypes([{{Zombie[0]}}]), AddCardtypes([Artifact, Creature])]))])])",
    "You may have {{ThisPermanent}} enter as a copy of any {{Permanent}} on the battlefield, except it's {{a}} {{Zombie}} in addition to its other creature types": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent({{Permanent[0]}}, CopyEffects([AddCreatureTypes([{{Zombie[0]}}])]))])])",
    "You may have {{ThisPermanent}} enter as a copy of any {{Permanent}} on the battlefield, except it's {{a}} {{Zombie}} in addition to its other types": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent({{Permanent[0]}}, CopyEffects([AddCreatureTypes([{{Zombie[0]}}])]))])])",
    "You may have {{ThisPermanent}} enter as a copy of any {{Permanent}} on the battlefield, except it's {{a}} {{Zombie}} in addition to its other types and has {{Hasable}}. When you do, tap the copied creature and it doesn't untap during its controller's untap step for as long as you control this creature": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent({{Permanent[0]}}, CopyEffects([AddCreatureTypes([{{Zombie[0]}}]), AddAbility([{{Hasable[0]}}])])), ReflexiveTrigger(ActionList([TapPermanent(ThePermanentChosenThisWay), CreatePermanentRuleEffectUntil(ThePermanentChosenThisWay, [DoesntUntapDuringControllersUntap], UntilPermanentChangesControl(You, {{~Permanent}}))]))])])",
    "You may have {{ThisPermanent}} enter as a copy of any {{Permanent}} on the battlefield, except it's {{a}} {{Zombie}} in addition to its other types and it has \"{{QuotedAbility}}\"": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent({{Permanent[0]}}, CopyEffects([AddCreatureTypes([{{Zombie[0]}}]), AddAbility([{{QuotedAbility[0]}}])]))])])",
    "You may have {{ThisPermanent}} enter as a copy of {{a}} {{Creature}}, except it's a Vehicle artifact with crew {{RawDigits}} and it loses all other card types": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent({{Creature[0]}}, CopyEffects([SetCardtypes([Artifact]), SetArtifactTypes([Vehicle]), AddAbility([Crew({{RawDigits[0]}})])]))])])",
    "You may have {{ThisPermanent}} enter as a copy of {{a}} {{Permanent}}": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent({{Permanent[0]}}, NoCopyEffects)])])",
    "You may have {{ThisPermanent}} enter as a copy of {{a}} {{Permanent}}, except it enters with an additional {{CounterType}} counter on it if it's a creature, it enters with an additional {{CounterType}} counter on it if it's a planeswalker, and it isn't legendary": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent({{Permanent[0]}}, CopyEffects([RemoveSupertypes([Legendary])])), If(APermanentWasCopiedThisWay(IsCardtype(Creature)), [EntersWithACounter({{CounterType[0]}})]), If(APermanentWasCopiedThisWay(IsCardtype(Planeswalker)), [EntersWithACounter({{CounterType[0]}})])])])",
    "You may have {{ThisPermanent}} enter as a copy of {{a}} {{Permanent}}, except it has \"{{QuotedAbility}}\"": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent({{Permanent[0]}}, CopyEffects([AddAbility([{{QuotedAbility[0]}}])]))])])",
    "You may have {{ThisPermanent}} enter as a copy of {{a}} {{Permanent}}, except it's an artifact creature in addition to its other types, and its power and toughness are equal to this creature's power and toughness": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent({{Permanent[0]}}, CopyEffects([AddCardtypes([Artifact, Creature]), KeepPT]))])])",
    "You may have {{ThisPermanent}} enter as a copy of {{a}} {{Permanent}}, except it's {{a}} {{Zombie}} in addition to its other types and it has {{Hasable}}": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent({{Permanent[0]}}, CopyEffects([AddCreatureTypes([{{Zombie[0]}}]), AddAbility([{{Hasable[0]}}])]))])])",
    "You may have {{ThisPermanent}} enter as a copy of {{a}} {{Permanent}}, except it's {{a}} {{Zombie}} {{Zombie}} in addition to its other types": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent({{Permanent[0]}}, CopyEffects([AddCreatureTypes([{{Zombie[0]}}, {{Zombie[1]}}])]))])])",
    "You may have {{ThisPermanent}} enter as a copy of {{a}} {{Permanent}}, except it's {{a}} {{Zombie}} {{Zombie}} in addition to its other types and it has {{Hasable}}": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent({{Permanent[0]}}, CopyEffects([AddCreatureTypes([{{Zombie[0]}}, {{Zombie[1]}}]), AddAbility([{{Hasable[0]}}])]))])])",
    "You may have {{ThisPermanent}} enter tapped as a copy of any land card in a graveyard, except it's {{a}} {{Swamp}} in addition to its other types": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfACardInAPlayersGraveyard(IsCardtype(Land), AnyPlayer, CopyEffects([AddLandTypes([{{Swamp[0]}}])])), EntersTapped])])",
    "You may have {{ThisPermanent}} enter tapped as a copy of any {{Permanent}} on the battlefield": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent({{Permanent[0]}}, NoCopyEffects), EntersTapped])])",
    "You may have {{ThisPermanent}} enter tapped as a copy of any {{Permanent}} on the battlefield, except it has \"{{QuotedAbility}}\"": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent({{Permanent[0]}}, CopyEffects([AddAbility([{{QuotedAbility[0]}}])])), EntersTapped])])",
    "You may have {{ThisPermanent}} enter tapped. If you do, you get {{Number}} rad counters": "AsPermanentEnters({{~Permanent}}, [MayCost(EntersTapped), If(CostWasPaid, [GetNumberRadCounters({{Number[0]}})])])",
    "You may have {{~Permanent}} enter as a copy of any creature card in a graveyard, except his name is {{NamedCard}} and he's {{a}} {{PT}} {{Zombie}} {{Zombie}} {{Zombie}} in addition to his other types. When you do, exile that card": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfACardInAPlayersGraveyard(IsCardtype(Creature), AnyPlayer, CopyEffects([SetName({{NamedCard[0]}}), SetPT({{PT[0]}}), AddCreatureTypes([{{Zombie[0]}}, {{Zombie[1]}}, {{Zombie[2]}}])])), ReflexiveTrigger(ActionList([ExileGraveyardCard(TheGraveyardCardChosenThisWay)]))])])",
    "You may have {{~Permanent}} enter as a copy of any {{Permanent}} on the battlefield, except it's an artifact in addition to its other types": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent({{Permanent[0]}}, CopyEffects([AddCardtypes([Artifact])]))])])",
    "You may have {{~Permanent}} enter as a copy of any {{Permanent}} on the battlefield, except its name is {{NamedCard}}, it's legendary in addition to its other types, and it has \"{{ManaCost}}: Return {{~Permanent}} to its owner's hand at the beginning of the next end step\"": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent({{Permanent[0]}}, CopyEffects([SetName({{NamedCard[0]}}), AddSupertypes([Legendary]), AddAbility([Activated(PayMana({{ManaCost[0]}}), ActionList([CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutPermanentIntoItsOwnersHand(ThisPermanent)]))]))])]))])])",
    "You may have {{~Permanent}} enter as a copy of {{a}} {{Permanent}}, except his name is {{NamedCard}}": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent({{Permanent[0]}}, CopyEffects([SetName({{NamedCard[0]}})]))])])",
    "You may have {{~Permanent}} enter as a copy of {{a}} {{Permanent}}, except it's legendary and snow in addition to its other types and, if it's a creature, it enters with {{Number}} additional {{CounterType}} counters on it and has {{Hasable}}": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfAPermanent({{Permanent[0]}}, CopyEffects([AddSupertypes([Legendary, Snow])])), If(APermanentWasCopiedThisWay(IsCardtype(Creature)), [EntersWithNumberCounters({{Number[0]}}, {{CounterType[0]}}), EntersWithLayerEffect([AddCopiableAbility([{{Hasable[0]}}])])])])])",
    "You may have {{~Permanent}} enter as a copy of {{a}} {{SpecificCard}} in exile with {{a}} {{CounterType}} counter on it": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfACardInExile(And([{{SpecificCard[0]}}, HasACounterOfType({{CounterType[0]}})]), NoCopyEffects)])])",
    "You may have {{~Permanent}} enter as a copy of {{a}} {{Zombie}} card in your graveyard that was put there from your library this turn. If you do, it gains {{Hasable}} until end of turn": "AsPermanentEnters({{~Permanent}}, [MayActions([EnterAsACopyOfACardInAPlayersGraveyard(And([IsCreatureType({{Zombie[0]}}), WasPutIntoGraveyardFromLibraryThisTurn]), SinglePlayer(You), NoCopyEffects), EntersWithLayerEffectUntil([AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])])",
    "{{ThisPermanent}} enters prepared": "AsPermanentEnters({{~Permanent}}, [EntersPrepared])",
    "{{ThisPermanent}} enters tapped": "AsPermanentEnters({{~Permanent}}, [EntersTapped])",
    "{{ThisPermanent}} enters tapped and doesn't untap during your untap step": "AsPermanentEnters({{~Permanent}}, [EntersTapped]), PermanentRuleEffect({{~Permanent}}, [DoesntUntapDuringControllersUntap])",
    "{{ThisPermanent}} enters tapped and with {{Number}} {{CounterType}} counters on it": "AsPermanentEnters({{~Permanent}}, [EntersTapped, EntersWithNumberCounters({{Number[0]}}, {{CounterType[0]}})])",
    "{{ThisPermanent}} enters tapped if {{Condition}}": "AsPermanentEnters({{~Permanent}}, [If({{Condition[0]}}, [EntersTapped])])",
    "{{ThisPermanent}} enters tapped unless {{Condition(ThatPermanent)}}": "AsPermanentEnters({{~Permanent}}, [Unless({{Condition(ThatPermanent=^~Permanent)[0]}}, [EntersTapped])])",
    "{{ThisPermanent}} enters tapped unless {{Condition}}": "AsPermanentEnters({{~Permanent}}, [Unless({{Condition[0]}}, [EntersTapped])])",
    "{{ThisPermanent}} enters tapped with {{Number}} {{CounterType}} counters on it": "AsPermanentEnters({{~Permanent}}, [EntersTapped, EntersWithNumberCounters({{Number[0]}}, {{CounterType[0]}})])",
    "{{ThisPermanent}} enters tapped with {{a}} {{CounterType}} counter on it": "AsPermanentEnters({{~Permanent}}, [EntersTapped, EntersWithACounter({{CounterType[0]}})])",
    "{{ThisPermanent}} enters under the control of an opponent of your choice": "AsPermanentEnters({{~Permanent}}, [EntersUnderAPlayersControl(Opponent)])",
    "{{ThisPermanent}} enters with X {{CounterType}} counters on it, where X is {{GameNumber(ThatPermanent)}}": "AsPermanentEnters({{~Permanent}}, [EntersWithNumberCounters({{GameNumber(ThatPermanent=ThatEnteringPermanent)[0]}}, {{CounterType[0]}})])",
    "{{ThisPermanent}} enters with X {{CounterType}} counters on it, where X is {{GameNumber}}": "AsPermanentEnters({{~Permanent}}, [EntersWithNumberCounters({{GameNumber[0]}}, {{CounterType[0]}})])",
    "{{ThisPermanent}} enters with a number of {{CounterType}} counters on it equal to {{GameNumber}}": "AsPermanentEnters({{~Permanent}}, [EntersWithNumberCounters({{GameNumber[0]}}, {{CounterType[0]}})])",
