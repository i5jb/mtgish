    "{{TapSelfCost}}: {{ActivatedActions}}. {{ActivateModifiers(~Permanent)}}": "ActivatedWithModifiers({{TapSelfCost[0]}}, {{ActivatedActions[0]}}, {{ActivateModifiers(~Permanent=^~Permanent)[0]}})"
  },
  "{{Activated(~PermanentOrGraveyardCard)}}": {
    "{{DiscardACardCost}}: {{ActivatedActions}}. You may also activate this ability while {{~PermanentOrGraveyardCard}} is in your graveyard": "Activated({{DiscardACardCost[0]}}, {{ActivatedActions[0]}}), FromGraveyard(Activated({{DiscardACardCost[0]}}, {{ActivatedActions[0]}}))",
    "{{ManaCost}}: Return {{~PermanentOrGraveyardCard}} to its owner's hand. Activate only if {{~PermanentOrGraveyardCard}} is on the battlefield or in your graveyard": "Activated(PayMana({{ManaCost[0]}}), ActionList([PutPermanentIntoItsOwnersHand(ThisPermanent)])), FromGraveyard(Activated(PayMana({{ManaCost[0]}}), ActionList([ReturnGraveyardCardToHand(ThisGraveyardCard)])))"
  },
  "{{Activated(~Vanguard)}}": {
    "{{ManaCostX}}, {{SacrificeAPermanentCostX}}: {{ActivatedActions(~Vanguard,X)}}": "Activated(And([PayManaX({{ManaCostX[0]}}, ValueX), {{SacrificeAPermanentCostX[0]}}]), {{ActivatedActions(~Vanguard=^~Vanguard,X=ValueX)[0]}})",
    "{{ManaCostX}}: {{ActivatedActions(~Vanguard,X)}}. {{ActivateModifiers}}": "ActivatedWithModifiers(PayManaX({{ManaCostX[0]}}, ValueX), {{ActivatedActions(~Vanguard=^~Vanguard,X=ValueX)[0]}}, {{ActivateModifiers[0]}})",
    "{{ManaCost}}: {{ActivatedActions(~Vanguard)}}": "Activated(PayMana({{ManaCost[0]}}), {{ActivatedActions(~Vanguard=^~Vanguard)[0]}})",
    "{{ManaCost}}: {{ActivatedActions(~Vanguard)}}. {{ActivateModifiers}}": "ActivatedWithModifiers(PayMana({{ManaCost[0]}}), {{ActivatedActions(~Vanguard=^~Vanguard)[0]}}, {{ActivateModifiers[0]}})",
    "{{SacrificeAPermanentCost}}: {{ActivatedActions(~Vanguard)}}": "Activated({{SacrificeAPermanentCost[0]}}, {{ActivatedActions(~Vanguard=^~Vanguard)[0]}})"
  },
  "{{ActivatedActions(ThatGraveyardCard)}}": {
    "Conjure a duplicate of another target creature card in your graveyard onto the top of your library. The duplicate perpetually gets {{PTMod}} and gains {{Hasable}}": "Targeted([TargetGraveyardCard(And([Other({{ThatGraveyardCard}}), IsCardtype(Creature), InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([ConjureDuplicateOfGraveyardCardOnTopOfPlayersLibrary(Ref_TargetGraveyardCard, You), CreatePerpetualCardInLibraryEffect(TheCardConjureIntoLibraryThisWay, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])])]))",
    "Return another target {{SpecificCard}} from your graveyard to your hand": "Targeted([TargetGraveyardCard(And([Other({{ThatGraveyardCard}}), {{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardIntoHand(Ref_TargetGraveyardCard)]))"
  },
  "{{ActivatedActions(ThatPermanent)}}": {
    "Add X mana of any one color, where X is {{GameNumber(ThatPermanent)}}": "ActionList([AddManaRepeated(AnyManaColor, {{GameNumber(ThatPermanent=^ThatPermanent)[0]}})])",
    "Add X {{ManaProduceSymbol}} or X {{ManaProduceSymbol}}, where X is {{GameNumber(ThatPermanent)}}": "ActionList([CreateValueX({{GameNumber(ThatPermanent=^ThatPermanent)[0]}}), ChooseAnAction([[AddManaRepeated({{ManaProduceSymbol[0]}}, ValueX)], [AddManaRepeated({{ManaProduceSymbol[1]}}, ValueX)]])])",
    "All other {{Creatures}} get {{PTMod}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil(And([Other({{ThatPermanent}}), {{Creatures[0]}}]), [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])",
    "All other {{Permanents}} lose {{CheckHasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil(And([Other({{ThatPermanent}}), {{Permanents[0]}}]), [LosesAbility({{CheckHasable[0]}})], UntilEndOfTurn)])",
    "Another target creature you control gains protection from colorless or from the color of your choice until end of turn": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))], ActionList([ChooseAColorOrColorless(AnyColor), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([Protection(FromColor(TheChosenColor))])], UntilEndOfTurn)]))",
    "Another target {{Artifact}} becomes an artifact creature until end of turn": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), {{Artifact[0]}}]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddCardtype(Artifact), AddCardtype(Creature)], UntilEndOfTurn)]))",
    "Another target {{Creature}} can't be blocked this turn": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), {{Creature[0]}}]))], ActionList([CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [CantBeBlocked], UntilEndOfTurn)]))",
    "Another target {{Creature}} can't be blocked this turn except by {{Creatures}}": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), {{Creature[0]}}]))], ActionList([CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [CantBeBlockedExceptByDefenders({{Creatures[0]}})], UntilEndOfTurn)]))",
    "Another target {{Creature}} gets {{PTMod}} and gains {{Hasable}} until end of turn": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), {{Creature[0]}}]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Another target {{Creature}} gets {{PTMod}} until end of turn": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), {{Creature[0]}}]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)]))",
    "Another target {{Permanent}} gains protection from the card type of your choice until end of turn": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))], ActionList([ChooseACardtype, CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([Protection(FromTypes(IsCardtypeVariable(TheChosenCardtype)))])], UntilEndOfTurn)]))",
    "Another target {{Permanent}} gains {{Hasable}} and {{Hasable}} until end of turn": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)]))",
    "Another target {{Permanent}} gains {{Hasable}} until end of turn": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Another target {{Permanent}} perpetually gains {{PerpetualHasable}}": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))], ActionList([CreatePerpetualPermanentEffect(Ref_TargetPermanent, [AddAbility([{{PerpetualHasable[0]}}])])]))",
    "Another target {{Zombie}} or {{Zombie}} you control fights target creature you don't control": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), Or([IsCreatureType({{Zombie[0]}}), IsCreatureType({{Zombie[1]}})]), ControlledByAPlayer(SinglePlayer(You))])), TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(Other(You))]))], ActionList([Fight(Ref_TargetPermanent1, Ref_TargetPermanent2)]))",
    "Choose a color. Another target {{Creature}} gains {{Hasable}} and hexproof from that color until end of turn. It can't be blocked by creatures of that color this turn": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), {{Creature[0]}}]))], ActionList([ChooseAColor(AnyColor), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}]), AddAbility([Protection(FromColor(TheChosenColor))])], UntilEndOfTurn), CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [CantBeBlockedByDefenders(And([IsCardtype(Creature), IsColor(TheChosenColor)]))], UntilEndOfTurn)]))",
