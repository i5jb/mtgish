    "Exile all cards from target player's library, then that player shuffles their hand into their library": "Targeted([TargetPlayer(AnyPlayer)], ActionList([ExileAllCardsInPlayersLibrary(Ref_TargetPlayer), PlayerAction(Ref_TargetPlayer, ShuffleHandIntoLibrary)]))",
    "Exile all graveyards": "ActionList([ExileEachPlayersGraveyard(AnyPlayer)])",
    "Exile all graveyards. Add {{ManaProduceSymbol}}{{ManaProduceSymbol}}{{ManaProduceSymbol}}": "ActionList([ExileEachPlayersGraveyard(AnyPlayer), AddMana(And([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}, {{ManaProduceSymbol[2]}}]))])",
    "Exile all graveyards. Draw a card": "ActionList([ExileEachPlayersGraveyard(AnyPlayer), DrawACard])",
    "Exile all {{Creatures}}. At the beginning of the next combat, return those cards to the battlefield under their owner's control and those creatures gain {{Hasable}} until end of turn": "ActionList([ExileEachPermanent({{Creatures[0]}}), CreateFutureTrigger(AtTheBeginningOfTheNextCombat, ActionList([PutEachExiledCardOntoTheBattlefield(TheCardsExiledThisWay, [EntersUnderOwnersControl]), CreatePermanentLayerEffectUntil(ThePermanentPutOnTheBattlefieldThisWay, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))])",
    "Exile all {{Permanents}}": "ActionList([ExileEachPermanent({{Permanents[0]}})])",
    "Exile all {{Permanents}}. At the beginning of the next end step, return those cards to the battlefield under their owners' control": "ActionList([ExileEachPermanent({{Permanents[0]}}), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutEachExiledCardOntoTheBattlefield(TheCardsExiledThisWay, [EntersUnderOwnersControl])]))])",
    "Exile any number of cards from your hand face down. Put that many cards from the top of your library into your hand. Then look at the exiled cards and put them on top of your library in any order": "ActionList([ExileAnyNumberOfCardsFromHandFaceDown, PutTheTopNumberCardsOfLibraryInHand(NumHandCardsExiledThisWay), LookAtFaceDownExiledCards(TheCardsExiledThisWay), PutExiledCardsOnTopOfLibraryInAnyOrder(TheCardsExiledThisWay)])",
    "Exile any number of target cards from your graveyard. Add {{ManaProduceSymbol}} for each card exiled this way. You may play those cards this turn": "Targeted([AnyNumberOfTargetGraveyardCards(AnyCardInAnyGraveyard)], ActionList([ExileEachGraveyardCard(Ref_TargetGraveyardCards), AddManaRepeated({{ManaProduceSymbol[0]}}, NumGraveyardCardsExiledThisWay), CreatePlayerEffectUntil(You, [MayPlayExiledCards(TheCardsExiledThisWay)], UntilEndOfTurn)]))",
    "Exile any number of target players' graveyards. Draw a card": "Targeted([AnyNumberOfTargetPlayers(AnyPlayer)], ActionList([ExileEachPlayersGraveyard(Ref_TargetPlayers), DrawACard]))",
    "Exile cards from the top of your library until you exile {{a}} {{SpecificCard}}. You may cast that card without paying its mana cost": "ActionList([ExileCardsFromTheTopOfLibraryUntilACardOfTypeIsExiled({{SpecificCard[0]}}), MayAction(CastExiledCardWithoutPaying(TheSpecificCardExiledThisWay))])",
    "Exile each opponent's graveyard": "ActionList([ExileEachPlayersGraveyard(Opponent)])",
    "Exile each {{Permanent}}": "ActionList([ExileEachPermanent({{Permanent[0]}})])",
    "Exile target card from a graveyard": "Targeted([TargetGraveyardCard(AnyCardInAnyGraveyard)], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard)]))",
    "Exile target card from a graveyard. Create a Mutagen token": "Targeted([TargetGraveyardCard(AnyCardInAnyGraveyard)], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard), CreateTokens([MutagenToken])]))",
    "Exile target card from a graveyard. Draw a card": "Targeted([TargetGraveyardCard(AnyCardInAnyGraveyard)], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard), DrawACard]))",
    "Exile target card from a graveyard. If it was {{a}} {{SpecificCard}}, create {{a}} {{PT}} {{CreatureToken}}": "Targeted([TargetGraveyardCard(AnyCardInAnyGraveyard)], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard), If(ACardWasExiledThisWay({{SpecificCard[0]}}), [CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])])]))",
    "Exile target card from a graveyard. If {{a}} {{SpecificCard}} is exiled this way, create {{a}} {{PT}} {{CreatureToken}} with \"{{TokenQuotedAbility}}\"": "Targeted([TargetGraveyardCard(AnyCardInAnyGraveyard)], ActionList([Exile([GraveyardCard(Ref_TargetGraveyardCard)]), If(ACardWasExiledThisWay({{SpecificCard[0]}}), [CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{TokenQuotedAbility[0]}}])])])]))",
    "Exile target card from a graveyard. If {{a}} {{SpecificCard}} was exiled this way, create a Food token": "Targeted([TargetGraveyardCard(AnyCardInAnyGraveyard)], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard), If(ACardWasExiledThisWay({{SpecificCard[0]}}), [CreateTokens([FoodToken])])]))",
    "Exile target card from a graveyard. When {{a}} {{SpecificCard}} is exiled this way, put {{a}} {{CounterType}} counter on target {{Permanent}}": "Targeted([TargetGraveyardCard(AnyCardInAnyGraveyard)], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard), If(ACardWasExiledThisWay({{SpecificCard[0]}}), [ReflexiveTrigger(Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent)])))])]))",
    "Exile target card from a graveyard. You gain {{Digits}} life": "Targeted([TargetGraveyardCard(AnyCardInAnyGraveyard)], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard), GainLife({{Digits[0]}})]))",
    "Exile target card from an opponent's graveyard. If it was {{a}} {{SpecificCard}}, you create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}}": "Targeted([TargetGraveyardCard(InAPlayersGraveyard(Opponent))], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard), If(ACardWasExiledThisWay({{SpecificCard[0]}}), [CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])])])]))",
    "Exile target player's graveyard": "Targeted([TargetPlayer(AnyPlayer)], ActionList([ExilePlayersGraveyard(Ref_TargetPlayer)]))",
    "Exile target player's graveyard. Draw a card": "Targeted([TargetPlayer(AnyPlayer)], ActionList([ExilePlayersGraveyard(Ref_TargetPlayer), DrawACard]))",
    "Exile target {{CreatureCard}} from your graveyard. Create a token that's a copy of that card, except it's {{PT}}, it's {{a}} {{Zombie}} in addition to its other types, and it has {{Hasable}}. Create {{a}} {{CreatureToken}} with power equal to that card's power and toughness equal to that card's toughness": "Targeted([TargetGraveyardCard(And([{{CreatureCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([CreateTokens([TokenCopyOfGraveyardCard(Ref_TargetGraveyardCard, TokenCopyEffects([SetPT({{PT[0]}}), AddCreatureTypes([{{Zombie[0]}}]), AddAbility([{{Hasable[0]}}])]))]), CreateTokens([TokenWithPT(ManualPT(PowerOfGraveyardCard(Ref_TargetGraveyardCard), ToughnessOfGraveyardCard(Ref_TargetGraveyardCard)), {{CreatureToken[0]}}, [])])]))",
    "Exile target {{Creature}}. Its controller gains life equal to {{GameNumber(ThatCreature)}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([ExilePermanent(Ref_TargetPermanent), PlayerAction(ControllerOfPermanent(Ref_TargetPermanent), GainLife({{GameNumber(ThatCreature=Ref_TargetPermanent)[0]}}))]))",
    "Exile target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([ExilePermanent(Ref_TargetPermanent)]))",
    "Exile target {{Permanent}} until target {{Permanent}} leaves the battlefield": "Targeted([TargetPermanent({{Permanent[0]}}), TargetPermanent({{Permanent[1]}})], ActionList([ExilePermanentUntil(Ref_TargetPermanent1, UntilPermanentLeavesBattlefield(Ref_TargetPermanent2))]))",
    "Exile target {{Permanent}} you control. For each other player, exile up to one target {{Permanent}} that player controls": "Targeted([TargetPermanent({{Permanent[0]}}), UptoOneTargetPermanentEachPlayerControls({{Permanent[1]}}, Other(You))], ActionList([ExilePermanent(Ref_TargetPermanent), ExileEachPermanent(Ref_TargetPermanents)]))",
    "Exile target {{Permanent}}, then return it to the battlefield under its owner's control": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([ExilePermanent(Ref_TargetPermanent), PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersUnderOwnersControl])]))",
    "Exile target {{Permanent}}, then return it to the battlefield under your control": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([ExilePermanent(Ref_TargetPermanent), PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersUnderPlayersControl(You)])]))",
    "Exile target {{Permanent}}, then reveal cards from the top of your library until you reveal a creature card with greater mana value. Put that card onto the battlefield and the rest on the bottom of your library in a random order": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([ExilePermanent(Ref_TargetPermanent), RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed(And([IsCardtype(Creature), ManaValueIs(GreaterThan(ManaValueOfExiled(TheCardExiledThisWay)))]), [PutTheCardFoundThisWayOntoTheBattlefield([EntersNormally]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])]))",
    "Exile target {{Permanent}}. At the beginning of the next end step, return it to the battlefield tapped under its owner's control": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([ExilePermanent(Ref_TargetPermanent), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersTapped, EntersUnderOwnersControl])]))]))",
    "Exile target {{Permanent}}. If it wasn't an Aura, create a token that's a copy of it, except it's {{a}} {{PT}} {{Black}} {{Zombie}} creature with {{Hasable}} in addition to its other types": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([ExilePermanent(Ref_TargetPermanent), If(APermanentWasExiledThisWay(IsNonEnchantmentType(Aura)), [CreateTokens([TokenCopyOfPermanent(Ref_TargetPermanent, TokenCopyEffects([SetPT({{PT[0]}}), SetColor(SimpleColorList([{{Black[0]}}])), AddCreatureTypes([{{Zombie[0]}}]), AddCardtypes([Creature]), AddAbility([{{Hasable[0]}}])]))])])]))",
    "Exile target {{Permanent}}. Its controller draws {{Number}} cards": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([ExilePermanent(Ref_TargetPermanent), PlayerAction(ControllerOfTargetPermanent, DrawNumberCards({{Number[0]}}))]))",
    "Exile target {{Permanent}}. Its controller gains {{Digits}} life": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([ExilePermanent(Ref_TargetPermanent), PlayerAction(ControllerOfTargetPermanent, GainLife({{Digits[0]}}))]))",
    "Exile target {{Permanent}}. Return it to the battlefield under its owner's control at the beginning of the next end step": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([ExilePermanent(Ref_TargetPermanent), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersUnderOwnersControl])]))]))",
    "Exile target {{Permanent}}. Return it to the battlefield under your control at the beginning of the next end step": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([ExilePermanent(Ref_TargetPermanent), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersUnderPlayersControl(You)])]))]))",
    "Exile target {{Permanent}}. Return that card to the battlefield under its owner's control at the beginning of the next end step": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([ExilePermanent(Ref_TargetPermanent), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersUnderOwnersControl])]))]))",
    "Exile target {{Permanent}}. Return the exiled card to the battlefield under its owner's control at the beginning of the next end step": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([ExilePermanent(Ref_TargetPermanent), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersUnderOwnersControl])]))]))",
    "Exile target {{Permanent}}. You gain {{Digits}} life": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([ExilePermanent(Ref_TargetPermanent), GainLife({{Digits[0]}})]))",
    "Exile target {{Permanent}}. {{Permanents}} become copies of it until the beginning of the next end step. Return it to the battlefield under its owner's control at the beginning of the next end step": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([ExilePermanent(Ref_TargetPermanent), CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [IsACopyOfPermanent(Ref_TargetPermanent, NoCopyEffects)], UntilTheBeginningOfTheNextEndStep), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersUnderOwnersControl])]))]))",
    "Exile target {{SpecificCard}} from a graveyard": "Targeted([TargetGraveyardCard({{SpecificCard[0]}})], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard)]))",
    "Exile target {{SpecificCard}} from a graveyard that was put there this turn. Create a token that's a copy of it, except it's {{a}} {{Zombie}} in addition to its other types. Then exile all other {{Zombie}} tokens you control": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, WasPutIntoGraveyardFromAnywhereThisTurn]))], ActionList([Exile([GraveyardCards(SingleGraveyardCard(Ref_TargetGraveyardCard))]), CreateTokens([TokenCopyOfGraveyardCard(Ref_TargetGraveyardCard, TokenCopyEffects([AddCreatureTypes([{{Zombie[0]}}])]))]), Exile([Permanents(And([ExceptFor(TheTokensCreatedThisWay), IsCreatureType({{Zombie[1]}}), IsToken, ControlledByAPlayer(SinglePlayer(You))]))])]))",
    "Exile target {{SpecificCard}} from a graveyard, all other cards from graveyards with the same name as that card, and all permanents with that name": "Targeted([TargetGraveyardCard({{SpecificCard[0]}})], ActionList([ExileGraveyardCardEachCardInEachPlayersGraveyardAndEachPermanent(Ref_TargetGraveyardCard, SharesANameWithGraveyardCard(Ref_TargetGraveyardCard), AnyPlayer, SharesANameWithGraveyardCard(Ref_TargetGraveyardCard))]))",
