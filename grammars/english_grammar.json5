    "You may pay {{ManaCost}} rather than pay the equip cost of the first equip ability you activate during each of your turns": "If(IsPlayersTurn(You), [PlayerEffect(You, [MayPayAlternateCostForFirstEquipCostEachTurn({{ManaCost[0]}})])])",
    "You may pay {{ManaCost}} rather than pay the equip cost of the first equip ability you activate each turn": "PlayerEffect(You, [MayPayAlternateCostForFirstEquipCostEachTurn({{ManaCost[0]}})])",
