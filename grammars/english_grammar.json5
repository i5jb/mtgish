    "Choose target {{Creature}}. At this turn's next end of combat, destroy all {{Creatures}} that blocked or were blocked by it this turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreateFutureTrigger(AtNextEndOfCombatThisTurn, ActionList([DestroyEachPermanent(And([{{Creatures[0]}}, Or([BlockedAttackerThisTurn(Ref_TargetPermanent), WasBlockedByDefenderThisTurn(Ref_TargetPermanent)])]))]))]))",
    "Choose target {{Creature}}. At this turn's next end of combat, destroy all {{Creatures}} that were blocked by that creature this turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreateFutureTrigger(AtNextEndOfCombatThisTurn, ActionList([DestroyEachPermanent(And([{{Creatures[0]}}, WasBlockedByDefenderThisTurn(Ref_TargetPermanent)]))]))]))",
    "Choose target {{Creature}}. Create a token that's a copy of that creature. Each opponent may create a token that's a copy of that creature. For each opponent who does, create a token that's a copy of that creature": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreateTokens([TokenCopyOfPermanent(Ref_TargetPermanent, NoTokenCopyEffects)]), EachPlayerMayAction(Opponent, CreateTokens([TokenCopyOfPermanent(Ref_TargetPermanent, NoTokenCopyEffects)])), CreateTokens([NumberTokens(TheNumberOfPlayersWhoTookAnActionThisWay, TokenCopyOfPermanent(Ref_TargetPermanent, NoTokenCopyEffects))])]))",
    "Choose target {{Creature}}. Destroy all {{Creatures}} with power less than that creature's power": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([DestroyEachPermanent(And([{{Creatures[0]}}, PowerIs(LessThan(PowerOfPermanent(Ref_TargetPermanent)))]))]))",
    "Choose target {{Creature}}. Each other {{Creature}} becomes a copy of it until end of turn, except those creatures aren't legendary": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(And([Other(Ref_TargetPermanent), {{Creature[0]}}]), [IsACopyOfPermanent(Ref_TargetPermanent, CopyEffects([RemoveSupertypes([Legendary])]))], UntilEndOfTurn)]))",
