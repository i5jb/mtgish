    "Scry {{Digits}}, then draw a card": "ActionList([Scry({{Digits[0]}}), DrawACard])",
    "Scry {{Digits}}, then draw {{Number}} cards": "ActionList([Scry({{Digits[0]}}), DrawNumberCards({{Number[0]}})])",
    "Scry {{Digits}}, then draw {{Number}} cards. You get {{Energy}}": "ActionList([Scry({{Digits[0]}}), DrawNumberCards({{Number[0]}}), GetEnergy(Integer({{Energy[0]}}))])",
    "Scry {{Digits}}, then draw {{Number}} cards. You lose {{Digits}} life": "ActionList([Scry({{Digits[0]}}), DrawNumberCards({{Number[0]}}), LoseLife({{Digits[1]}})])",
    "Scry {{Digits}}, then reveal the top card of your library. Draw cards equal to that card's mana value": "ActionList([Scry({{Digits[0]}}), RevealTopCardOfLibrary, DrawNumberCards(ManaValueOfTheCardRevealedThisWay)])",
    "Scry {{Digits}}, then reveal the top card of your library. If it's {{a}} {{SpecificCard}}, draw a card": "ActionList([Scry({{Digits[0]}}), RevealTopCardOfLibrary, If(ACardWasRevealedThisWay({{SpecificCard[0]}}), [DrawACard])])",
    "Scry {{Digits}}, then reveal the top card of your library. If it's {{a}} {{SpecificCard}}, you draw cards equal to its power and you gain life equal to its toughness": "ActionList([Scry({{Digits[0]}}), RevealTopCardOfLibrary, If(ACardWasRevealedThisWay({{SpecificCard[0]}}), [DrawNumberCards(PowerOfTheRevealedCard), GainLife(ToughnessOfTheRevealedCard)])])",
    "Scry {{Digits}}, then you may reveal the top card of your library. If it's {{a}} {{SpecificCard}}, draw a card": "ActionList([Scry({{Digits[0]}}), MayActions([RevealTopCardOfLibrary, If(ACardWasRevealedThisWay({{SpecificCard[0]}}), [DrawACard])])])",
    "Scry {{Digits}}. {{Reminder}}\nDraw a card": "ActionList([Scry({{Digits[0]}}), DrawACard])",
    "Search target opponent's library for a card and exile it face down. Then that player shuffles. You may play that card for as long as it remains exiled": "Targeted([TargetPlayer(Opponent)], ActionList([SearchPlayersLibrary(Ref_TargetPlayer, [FindAGenericCard, ExileFoundCardsFaceDown, Shuffle]), CreatePlayerEffectUntil(You, [MayLookAtFaceDownExiledCard(TheCardExiledThisWay), MayPlayExiledCard(TheCardExiledThisWay)], UntilCardIsNoLongerExiled(TheCardExiledThisWay))]))",
    "Search target opponent's library for a card and exile it. You gain life equal to its mana value. Then that player shuffles": "Targeted([TargetPlayer(Opponent)], ActionList([SearchPlayersLibrary(Ref_TargetPlayer, [FindAGenericCard, ExileFoundCards, GainLife(ManaValueOfExiled(TheCardExiledThisWay)), Shuffle])]))",
    "Search target opponent's library for {{a}} {{SpecificCard}} and put that card onto the battlefield under your control. Then that player shuffles": "Targeted([TargetPlayer(Opponent)], ActionList([SearchPlayersLibrary(Ref_TargetPlayer, [FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersUnderPlayersControl(You)]), Shuffle])]))",
    "Search target opponent's library for {{a}} {{SpecificCard}}. Put that card onto the battlefield under your control. Then that player shuffles.\nEpic": "Targeted([TargetPlayer(Opponent)], ActionList([SearchPlayersLibrary(Ref_TargetPlayer, [FindACardOfType({{SpecificCard[0]}}), PutFoundCardsOntoBattlefield([EntersUnderPlayersControl(You)]), Shuffle]), Epic]))",
    "Search target opponent's library for {{a}} {{SpecificCard}}. You may cast that card without paying its mana cost. Then that player shuffles":
      "Targeted([TargetPlayer(Opponent)], ActionList([SearchPlayersLibrary(Ref_TargetPlayer, [FindACardOfType({{SpecificCard[0]}}), MayCastFoundCardsWithoutPaying, Shuffle])]))",
