    "target attacking creature gets {{PTMod}} until end of turn. When that creature dies this turn, surveil {{Digits}}": "Targeted([TargetPermanent(And([IsAttacking, IsCardtype(Creature)]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), CreateTriggerUntil(WhenACreatureOrPlaneswalkerDies(SinglePermanent(Ref_TargetPermanent)), ActionList([Surveil({{Digits[0]}})]), UntilEndOfTurn)]))",
    "target creature card in your graveyard that's an artifact or that has mana value {{Digits}} or less gains escape until end of turn. The escape cost is equal to its mana cost plus exile {{Number}} other cards from your graveyard": "Targeted([TargetGraveyardCard(And([IsCardtype(Creature), Or([IsCardtype(Artifact), ManaValueIs(LessThanOrEqualTo({{Digits[0]}}))]), InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([CreateGraveyardCardEffectUntil(Ref_TargetGraveyardCard, [AddAbility([Escape(And([ItsManaCost, ExileNumberGraveyardCards({{Number[0]}}, And([Other(ThisGraveyardCard), InAPlayersGraveyard(SinglePlayer(You))]))]))])], UntilEndOfTurn)]))",
    "target creature card in your graveyard without unearth perpetually gains unearth. The unearth cost is equal to its mana cost": "Targeted([TargetGraveyardCard(And([IsCardtype(Creature), InAPlayersGraveyard(SinglePlayer(You)), DoesntHaveAbility(AnyUnearth)]))], ActionList([CreatePerpetualGraveyardCardEffect(Ref_TargetGraveyardCard, [AddAbility([Unearth(ItsManaCost)])])]))",
