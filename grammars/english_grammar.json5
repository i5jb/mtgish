    "you may mill cards equal to {{GameNumber}}": "ActionList([MayAction(MillNumberCards({{GameNumber[0]}}))])",
    "you may mill {{Number}} cards": "ActionList([MayAction(MillNumberCards({{Number[0]}}))])",
    "you may mill {{Number}} cards. If you do, return up to {{Number}} {{SpecificCards}} from your graveyard to your hand": "ActionList([MayCost(MillNumberCards({{Number[0]}})), If(CostWasPaid, [PutUptoNumberCardsFromGraveyardToHand({{Number[0]}}, {{SpecificCards[0]}})])])",
    "you may move a counter from target {{Permanent}} onto a second target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}}), TargetPermanent({{Permanent[1]}})], ActionList([MayAction(MoveACounterFromPermanentOntoAnotherPermanent(Ref_TargetPermanent1, Ref_TargetPermanent2))]))",
    "you may pay X life, where X is {{GameNumber}}. If you do, create {{a}} {{PTX}} {{CreatureToken}} with {{Hasable}}": "ActionList([CreateValueX({{GameNumber[0]}}), MayCost(PayLife(ValueX)), If(CostWasPaid, [CreateTokens([TokenWithPT(PTX({{PTX[0]}}, ValueX), {{CreatureToken[0]}}, [{{Hasable[0]}}])])])])",
    "you may pay X life, where X is {{GameNumber}}. If you do, draw X cards": "ActionList([CreateValueX({{GameNumber[0]}}), MayCost(PayLife(ValueX)), If(CostWasPaid, [DrawNumberCards(ValueX)])])",
    "you may pay an amount of {E} equal to target {{Permanent}}'s mana value. When you do, destroy that permanent": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([MayCost(PayEnergy(ManaValueOfPermanent(Ref_TargetPermanent))), If(CostWasPaid, [ReflexiveTrigger(ActionList([DestroyPermanent(RefOuter_TargetPermanent)]))])]))",
    "you may pay any amount of life": "ActionList([MayAction(PayAnyAmountOfLife)])",
    "you may pay any amount of life. If you do, draw that many cards": "ActionList([MayCost(PayAnyAmountOfLife), If(CostWasPaid, [DrawNumberCards(AmountOfLifePaidThisWay)])])",
    "you may pay one or more {E}. If you do, create {{a}} {{PTX}} colorless Vehicle artifact token named {{NamedCard}} with {{Hasable}} and {{Hasable}}, where X is the amount of {E} paid this way": "ActionList([MayCost(PayAnyAmountOfEnergy), If(CostWasPaid, [CreateTokens([NamedTokenWithPT({{NamedCard[0]}}, PTX({{PTX[0]}}, TheAmountOfEnergyPaidThisWay), Colorless, [], [Artifact], SubtypesList([Vehicle]), [{{Hasable[0]}}, {{Hasable[1]}}])])])])",
    "you may pay {{Digits}} life. If you do, until end of turn, creatures you control with toughness greater than their power assign combat damage equal to their toughness rather than their power":
      "ActionList([MayCost(PayLife({{Digits[0]}})), If(CostWasPaid, [CreateEachPermanentRuleEffectUntil(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), PowerIsLessThanToughness]), [AssignsToughnessCombatDamage], UntilEndOfTurn)])])",
    "you may pay {{Digits}} life. If you do, create a Treasure token": "ActionList([MayCost(PayLife({{Digits[0]}})), If(CostWasPaid, [CreateTokens([TreasureToken])])])",
    "you may pay {{Digits}} life. If you do, create a number of {{PT}} {{CreatureTokens}} with {{Hasable}} equal to {{GameNumber}}": "ActionList([MayCost(PayLife({{Digits[0]}})), If(CostWasPaid, [CreateTokens([NumberTokens({{GameNumber[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}]))])])])",
    "you may pay {{Digits}} life. If you do, draw a card": "ActionList([MayCost(PayLife({{Digits[0]}})), If(CostWasPaid, [DrawACard])])",
    "you may pay {{Digits}} life. If you do, each other player sacrifices {{a}} {{Permanent}} of their choice": "ActionList([MayCost(PayLife({{Digits[0]}})), If(CostWasPaid, [EachPlayerAction(Other(You), SacrificeAPermanent({{Permanent[0]}}))])])",
    "you may pay {{Digits}} life. If you do, search your library for a card, then shuffle and put that card on top": "ActionList([MayCost(PayLife({{Digits[0]}})), If(CostWasPaid, [SearchLibrary([FindAGenericCard, SetAsideFoundCards, Shuffle, PutSetAsideCardsOnTopOfLibrary])])])",
    "you may pay {{Digits}} life. When you do, each player discards a card and sacrifices {{a}} {{Permanent}}": "ActionList([MayCost(PayLife({{Digits[0]}})), If(CostWasPaid, [ReflexiveTrigger(ActionList([EachPlayerActions(AnyPlayer, [DiscardACard, SacrificeAPermanent({{Permanent[0]}})])]))])])",
    "you may pay {{Digits}} life. When you do, target {{Creature}} gets {{PTMod}} until end of turn": "ActionList([MayCost(PayLife({{Digits[0]}})), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])))])])",
    "you may pay {{Energy}}. If you do, create {{a}} {{PT}} {{CreatureToken}}": "ActionList([MayCost(PayEnergy(Integer({{Energy[0]}}))), If(CostWasPaid, [CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])])])",
    "you may pay {{Energy}}. If you do, draw a card": "ActionList([MayCost(PayEnergy(Integer({{Energy[0]}}))), If(CostWasPaid, [DrawACard])])",
    "you may pay {{Energy}}. If you do, put {{a}} {{CounterType}} counter on each {{Permanent}}": "ActionList([MayCost(PayEnergy(Integer({{Energy[0]}}))), If(CostWasPaid, [PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, {{Permanent[0]}})])])",
    "you may pay {{Energy}}. If you do, target {{Creature}} can't block this turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([MayCost(PayEnergy(Integer({{Energy[0]}}))), If(CostWasPaid, [CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [CantBlock], UntilEndOfTurn)])]))",
    "you may pay {{Energy}}. If you do, you draw a card and you lose {{Digits}} life": "ActionList([MayCost(PayEnergy(Integer({{Energy[0]}}))), If(CostWasPaid, [DrawACard, LoseLife({{Digits[0]}})])])",
    "you may pay {{Energy}}. When you do, create a token that's a copy of target {{Permanent}}, except it's {{a}} {{PT}} artifact creature in addition to its other types and has {{Hasable}}. Sacrifice it at the beginning of the next end step": "ActionList([MayCost(PayEnergy(Integer({{Energy[0]}}))), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreateTokens([TokenCopyOfPermanent(Ref_TargetPermanent, TokenCopyEffects([SetPT({{PT[0]}}), AddCardtypes([Artifact, Creature]), AddAbility([{{Hasable[0]}}])]))]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([SacrificeEachPermanent(TheTokensCreatedThisWay)]))])))])])",
    "you may pay {{Energy}}. When you do, put {{Number}} {{CounterType}} counters and {{a}} {{CounterType}} counter on target {{Creature}}. It becomes {{a}} {{Zombie}} in addition to its other types": "ActionList([MayCost(PayEnergy(Integer({{Energy[0]}}))), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPermanent({{Creature[0]}})], ActionList([PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[0]}}, Ref_TargetPermanent), PutACounterOfTypeOnPermanent({{CounterType[1]}}, Ref_TargetPermanent), CreatePermanentLayerEffect(Ref_TargetPermanent, [AddCreatureType({{Zombie[0]}})])])))])])",
    "you may pay {{Energy}}. When you do, target {{Permanent}} gains {{Hasable}} until end of turn": "ActionList([MayCost(PayEnergy(Integer({{Energy[0]}}))), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])))])])",
    "you may pay {{Energy}}. When you do, target {{SpecificCard}} in your graveyard gains jump-start until end of turn": "ActionList([MayCost(PayEnergy(Integer({{Energy[0]}}))), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([CreateGraveyardCardEffectUntil(Ref_TargetGraveyardCard, [AddAbility([JumpStart])], UntilEndOfTurn)])))])])",
    "you may pay {{ManaCostX}}. If you do, create X {{PT}} {{CreatureTokens}}": "ActionList([MayCost(PayManaAnyX({{ManaCostX[0]}})), If(CostWasPaid, [CreateTokens([NumberTokens(ValueX, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])])])",
    "you may pay {{ManaCostX}}. If you do, create X {{PT}} {{CreatureTokens}} that are tapped and attacking. At the beginning of the next end step, exile those tokens unless {{Condition}}": "ActionList([MayCost(PayManaAnyX({{ManaCostX[0]}})), If(CostWasPaid, [CreateTokensWithFlags([NumberTokens(ValueX, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))], [EntersTapped, EntersAttacking]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([Unless({{Condition[0]}}, [ExileEachPermanent(TheTokensCreatedThisWay)])]))])])",
    "you may pay {{ManaCostX}}. If you do, create X {{PT}} {{CreatureTokens}} with {{Hasable}}. X can't be greater than {{GameNumber}}": "ActionList([MayCost(PayManaAnyXRestricted({{ManaCostX[0]}}, LessThanOrEqualTo({{GameNumber[0]}}))), If(CostWasPaid, [CreateTokens([NumberTokens(ValueX, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}]))])])])",
    "you may pay {{ManaCostX}}. If you do, draw X cards": "ActionList([MayCost(PayManaAnyX({{ManaCostX[0]}})), If(CostWasPaid, [DrawNumberCards(ValueX)])])",
    "you may pay {{ManaCostX}}. If you do, draw X cards. X can't be greater than {{GameNumber}}": "ActionList([MayCost(PayManaAnyXRestricted({{ManaCostX[0]}}, LessThanOrEqualTo({{GameNumber[0]}}))), If(CostWasPaid, [DrawNumberCards(ValueX)])])",
    "you may pay {{ManaCostX}}. If you do, if X is 1 or more, conjure a duplicate of a random creature card with mana value X into your hand. Cloak it. It gains \"{{QuotedAbility}}\" for as long as it remains face down": "ActionList([MayCost(PayManaAnyX({{ManaCostX[0]}})), If(CostWasPaid, [If(ValueIs(ValueX, GreaterThanOrEqualTo(Integer(1))), [ConjureDuplicateOfARandomCardOfTypeIntoHand(And([IsCardtype(Creature), ManaValueIs(EqualTo(ValueX))])), CloakCardFromHand(TheCardConjuredIntoHandThisWay), CreatePermanentLayerEffectUntil(ThePermanentPutOnTheBattlefieldThisWay, [AddAbility([{{QuotedAbility[0]}}])], ForAsLongAsPermanentRemainsFaceDown(ThePermanentPutOnTheBattlefieldThisWay))])])])",
    "you may pay {{ManaCostX}}. If you do, put each {{Permanent}} target player controls with mana value X or less on the bottom of its owner's library": "Targeted([TargetPlayer(AnyPlayer)], ActionList([MayCost(PayManaAnyX({{ManaCostX[0]}})), If(CostWasPaid, [PutEachPermanentOnBottomOfOwnersLibraryInOrderOfOwnersChoice(And([{{Permanent[0]}}, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer)), ManaValueIs(LessThanOrEqualTo(ValueX))]))])]))",
    "you may pay {{ManaCostX}}. If you do, reveal the top X cards of your library, put all {{SpecificCards}} from among them into your hand, then put the rest on the bottom of your library in a random order": "ActionList([MayCost(PayManaAnyX({{ManaCostX[0]}})), If(CostWasPaid, [RevealTheTopNumberCardsOfLibrary(ValueX, [PutEachCardOfTypeIntoHand({{SpecificCards[0]}}), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])])",
    "you may pay {{ManaCostX}}. If you do, search your library for an Equipment card with mana value X or less, put that card onto the battlefield, then shuffle": "ActionList([MayCost(PayManaAnyX({{ManaCostX[0]}})), If(CostWasPaid, [SearchLibrary([FindACardOfType(And([IsArtifactType(Equipment), ManaValueIs(LessThanOrEqualTo(ValueX))])), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle])])])",
    "you may pay {{ManaCostX}}. If you do, target {{Creature}} gets {{PTModX}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([MayCost(PayManaAnyX({{ManaCostX[0]}})), If(CostWasPaid, [CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTX({{PTModX[0]}}, ValueX)], UntilEndOfTurn)])]))",
    "you may pay {{ManaCostX}}. If you do, you gain X life": "ActionList([MayCost(PayManaAnyX({{ManaCostX[0]}})), If(CostWasPaid, [GainLife(ValueX)])])",
