    "exile a card from the top of your library face down for each {{Eachable}}": "ActionList([ExileTheTopNumberCardsOfLibrary({{Eachable[0]}})])",
    "exile a card from your graveyard": "ActionList([ExileAGraveyardCard(InAPlayersGraveyard(SinglePlayer(You)))])",
