    "Whenever {{a}} {{Permanent}} enters and whenever this creature or another {{Permanent}} is turned face up, {{TriggerActions(~Permanent)}}": "TriggerA(Or([WhenAPermanentEntersTheBattlefield({{Permanent[0]}}), WhenAPermanentIsTurnedFaceUp(Or([SinglePermanent({{~Permanent}}), And([Other({{~Permanent}}), {{Permanent[1]}}])]))]), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "Whenever {{a}} {{Permanent}} enters and whenever you fully unlock a Room, {{TriggerActions(~Permanent)}}": "TriggerA(Or([WhenAPermanentEntersTheBattlefield({{Permanent[0]}}), WhenAPlayerFullyUnlocksARoom(SinglePlayer(You), IsEnchantmentType(Room))]), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "Whenever {{a}} {{Permanent}} enters during your turn, {{TriggerActions(~Permanent)}}": "TriggerA(If(IsPlayersTurn(You), WhenAPermanentEntersTheBattlefield({{Permanent[0]}})), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "Whenever {{a}} {{Permanent}} enters from your graveyard, {{TriggerActions(~Permanent,ThatPermanent)}}": "TriggerA(WhenAPermanentEntersTheBattlefieldFromAPlayersGraveyard({{Permanent[0]}}, SinglePlayer(You)), {{TriggerActions(~Permanent=^~Permanent,ThatPermanent=Trigger_ThatPermanent)[0]}})",
    "Whenever {{a}} {{Permanent}} enters under your control, {{TriggerActions(~Permanent)}}": "TriggerA(WhenAPermanentEntersTheBattlefieldUnderAPlayersControl({{Permanent[0]}}, SinglePlayer(You)), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "Whenever {{a}} {{Permanent}} enters, if {{Condition(ThatPermanent)}}, {{TriggerActions(~Permanent)}}": "TriggerI(WhenAPermanentEntersTheBattlefield({{Permanent[0]}}), {{Condition(ThatPermanent=ThatEnteringPermanent)[0]}}, {{TriggerActions(~Permanent=^~Permanent)[0]}})",
