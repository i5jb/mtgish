    "discard up to {{Number}} cards, then draw that many cards": "ActionList([DiscardUptoNumberCards({{Number[0]}}), DrawNumberCards(NumCardsDiscardedThisWay)])",
    "discard your hand": "ActionList([DiscardHand])",
    "discard your hand, then draw {{Number}} cards": "ActionList([DiscardHand, DrawNumberCards({{Number[0]}})])",
    "discard your hand, then investigate {{Number}} times": "ActionList([DiscardHand, InvestigateTimes({{Number[0]}})])",
    "discard your hand. Each opponent sacrifices {{a}} {{Permanent}} of their choice for each card discarded this way": "ActionList([DiscardHand, EachPlayerAction(Opponent, SacrificeNumberPermanents(NumCardsDiscardedThisWay, {{Permanent[0]}}))])",
    "discard {{Number}} cards, then draw {{Number}} cards": "ActionList([DiscardNumberCards({{Number[0]}}), DrawNumberCards({{Number[0]}})])",
    "discard {{Number}} cards, then draw {{Number}} cards. For each {{SpecificCard}} discarded this way, create {{a}} {{PT}} {{CreatureToken}}": "ActionList([DiscardNumberCards({{Number[0]}}), DrawNumberCards({{Number[1]}}), CreateTokens([NumberTokens(NumCardsOfTypeDiscardedThisWay({{SpecificCard[0]}}), TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, []))])])",
    "discover {{Digits}}": "ActionList([Discover({{Digits[0]}})])",
    "distribute three {{CounterType}} counters among one, two, or three target creatures. For each {{CounterType}} counter you put on a creature this way, remove {{a}} {{CounterType}} counter from that creature at the beginning of the next end step": "TargetedDistributed([BetweenOneAndNumberTargetPermanents(Integer(3), IsCardtype(Creature))], DistributeNumberAmongTargets(Integer(3)), ActionList([PutDistributedCounters({{CounterType[0]}}), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([RemoveCountersDistributedThisWay]))]))",
    "distribute three {{CounterType}} counters among one, two, or three target {{Permanents}}": "TargetedDistributed([BetweenOneAndNumberTargetPermanents(Integer(3), {{Permanents[0]}})], DistributeNumberAmongTargets(Integer(3)), ActionList([PutDistributedCounters({{CounterType[0]}})]))",
    "distribute three {{CounterType}} counters among one, two, or three target {{Permanents}}, then you gain life equal to {{GameNumber}}": "TargetedDistributed([BetweenOneAndNumberTargetPermanents(Integer(3), {{Permanents[0]}})], DistributeNumberAmongTargets(Integer(3)), ActionList([PutDistributedCounters({{CounterType[0]}}), GainLife({{GameNumber[0]}})]))",
    "distribute two {{CounterType}} counters among one or two target creatures. Then if {{Condition}}, double the number of {{CounterType}} counters on those creatures": "TargetedDistributed([BetweenOneAndNumberTargetPermanents(Integer(2), IsCardtype(Creature))], DistributeNumberAmongTargets(Integer(2)), ActionList([PutDistributedCounters({{CounterType[0]}}), If({{Condition[0]}}, [DoubleCountersOfTypeOnEachPermanent({{CounterType[1]}}, Ref_TargetPermanents)])]))",
    "distribute two {{CounterType}} counters among one or two target {{Permanents}}": "TargetedDistributed([BetweenOneAndNumberTargetPermanents(Integer(2), {{Permanents[0]}})], DistributeNumberAmongTargets(Integer(2)), ActionList([PutDistributedCounters({{CounterType[0]}})]))",
    "distribute two {{CounterType}} counters among up to two target {{Permanents}}. Then if {{Condition}}, double the number of {{CounterType}} counters on each {{Permanent}}": "TargetedDistributed([UptoNumberTargetPermanents(Integer(2), {{Permanents[0]}})], DistributeNumberAmongTargets(Integer(2)), ActionList([PutDistributedCounters({{CounterType[0]}}), If({{Condition[0]}}, [DoubleCountersOfTypeOnEachPermanent({{CounterType[1]}}, {{Permanent[0]}})])]))",
    "distribute up to two art stickers among one or two {{Permanents}}": "ActionList([DistrbuteUptoNumberArtStickersAmongAnyNumberOfPermanents(Integer(2), {{Permanents[0]}})])",
    "distribute {{Number}} {{CounterType}} counters among any number of target {{Permanents}}": "TargetedDistributed([UptoNumberTargetPermanents({{Number[0]}}, {{Permanents[0]}})], DistributeNumberAmongTargets({{Number[0]}}), ActionList([PutDistributedCounters({{CounterType[0]}})]))",
    "double target {{Creature}}'s power and toughness until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([DoubleCreaturesPowerAndToughnessUntilEndOfTurn(Ref_TargetPermanent)]))",
    "double target {{Creature}}'s power until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([DoubleCreaturesPowerUntilEndOfTurn(Ref_TargetPermanent)]))",
    "double the number of each kind of counter on any number of target {{Permanents}}": "Targeted([AnyNumberOfTargetPermanents({{Permanents[0]}})], ActionList([DoubleCountersOfEachTypeOnEachPermanent(Ref_TargetPermanents)]))",
    "double the number of each kind of counter on each {{Permanent}}": "ActionList([DoubleCountersOfEachTypeOnEachPermanent({{Permanent[0]}})])",
    "double the number of {{CounterType}} counters on each {{Permanent}}": "ActionList([DoubleCountersOfTypeOnEachPermanent({{CounterType[0]}}, {{Permanent[0]}})])",
    "double the number of {{CounterType}} counters on target {{Creature}}. That creature can't be blocked by {{Creatures}} this turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([DoubleCountersOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent), CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [CantBeBlockedByDefenders({{Creatures[0]}})], UntilEndOfTurn)]))",
    "double the number of {{CounterType}} counters on target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([DoubleCountersOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent)]))",
    "double the power and toughness of each {{Creature}} until end of turn": "ActionList([DoubleEachCreaturesPowerAndToughnessUntilEndOfTurn({{Creature[0]}})])",
    "double the power of each {{Creature}} until end of turn": "ActionList([DoubleEachCreaturesPowerUntilEndOfTurn({{Creature[0]}})])",
    "double the power of target {{Creature}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([DoubleCreaturesPowerUntilEndOfTurn(Ref_TargetPermanent)]))",
    "double the toughness of each {{Creature}} until end of turn": "ActionList([DoubleEachCreaturesToughnessUntilEndOfTurn({{Creature[0]}})])",
    "double your life total": "ActionList([SetLifeTotal(Twice(LifeTotalOfPlayer(You)))])",
    "draft a card from {{Spellbook}}": "ActionList([DraftACardFromSpellBook({{Spellbook[0]}})])",
    "draft a card from {{Spellbook}} and exile it. Until end of turn, you may cast that card": "ActionList([DraftACardFromSpellBook({{Spellbook[0]}}), ExileCardFromHand(TheCardDraftedThisWay), CreatePlayerEffectUntil(You, [MayCastExiledCard(TheCardExiledThisWay)], UntilEndOfTurn)])",
    "draft a card from {{Spellbook}} and put it onto the battlefield": "ActionList([DraftACardFromSpellBook({{Spellbook[0]}}), PutCardFromHandOnBattlefield(TheCardDraftedThisWay, [EntersNormally])])",
    "draft a card from {{Spellbook}} and put it onto the battlefield. When an Equipment enters this way, attach it to target {{Permanent}}": "ActionList([DraftACardFromSpellBook({{Spellbook[0]}}), PutCardFromHandOnBattlefield(TheCardDraftedThisWay, [EntersNormally]), If(APermanentOfTypeWasPutOntoTheBattlefieldThisWay(IsArtifactType(Equipment)), [ReflexiveTrigger(Targeted([TargetPermanent({{Permanent[0]}})], ActionList([AttachPermanentToPermanent(ThePermanentPutOnTheBattlefieldThisWay, Ref_TargetPermanent)])))])])",
    "draft a card from {{Spellbook}} and put it onto the battlefield. When an Equipment enters this way, attach it to up to one target {{Permanent}}": "ActionList([DraftACardFromSpellBook({{Spellbook[0]}}), PutCardFromHandOnBattlefield(TheCardDraftedThisWay, [EntersNormally]), If(APermanentOfTypeWasPutOntoTheBattlefieldThisWay(IsArtifactType(Equipment)), [ReflexiveTrigger(Targeted([UptoOneTargetPermanent({{Permanent[0]}})], ActionList([AttachPermanentToPermanent(ThePermanentPutOnTheBattlefieldThisWay, Ref_TargetPermanent)])))])])",
    "draft a card from {{Spellbook}} twice, then put those cards onto the battlefield": "ActionList([DraftACardFromSpellBookNumberTimes({{Spellbook[0]}}, Integer(2)), PutCardsFromHandOnBattlefield(TheCardsDraftedThisWay, [EntersNormally])])",
    "draft a card from {{Spellbook}}, then discard a card": "ActionList([DraftACardFromSpellBook({{Spellbook[0]}}), DiscardACard])",
    "draft a card from {{Spellbook}}, then exile it. Until end of turn, you may play that card": "ActionList([DraftACardFromSpellBook({{Spellbook[0]}}), ExileCardFromHand(TheCardDraftedThisWay), CreatePlayerEffectUntil(You, [MayPlayExiledCard(TheCardExiledThisWay)], UntilEndOfTurn)])",
    "draft a card from {{Spellbook}}. It perpetually becomes a Food artifact in addition to its other types and perpetually gains \"{{PerpetualQuotedAbility}}\"": "ActionList([DraftACardFromSpellBook({{Spellbook[0]}}), CreatePerpetualCardInHandEffect(TheCardPutInHandThisWay, [AddArtifactType(Food), AddCardtype(Artifact), AddAbility([{{PerpetualQuotedAbility[0]}}])])])",
    "draft a card from {{Spellbook}}. That card perpetually becomes an artifact creature": "ActionList([DraftACardFromSpellBook({{Spellbook[0]}}), CreatePerpetualCardInHandEffect(TheCardPutInHandThisWay, [AddCardtype(Artifact), AddCardtype(Creature)])])",
    "draft a card from {{Spellbook}}. That card perpetually gains \"{{PerpetualQuotedAbility}}\" and \"{{PerpetualQuotedAbility}}\"": "ActionList([DraftACardFromSpellBook({{Spellbook[0]}}), CreatePerpetualCardInHandEffect(TheCardPutInHandThisWay, [AddAbility([{{PerpetualQuotedAbility[0]}}]), AddAbility([{{PerpetualQuotedAbility[1]}}])])])",
    "draw X cards, where X is {{GameNumber}}": "ActionList([DrawNumberCards({{GameNumber[0]}})])",
    "draw a card": "ActionList([DrawACard])",
    "draw a card and blight {{Digits}}": "ActionList([DrawACard, Blight({{Digits[0]}})])",
    "draw a card and create a tapped {{PT}} {{CreatureToken}} with {{Hasable}}": "ActionList([DrawACard, CreateTokensWithFlags([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])], [EntersTapped])])",
    "draw a card and you get {{Energy}}": "ActionList([DrawACard, GetEnergy(Integer({{Energy[0]}}))])",
    "draw a card at the beginning of the next turn's upkeep": "ActionList([CreateFutureTrigger(AtTheBeginningOfTheNextTurnsUpkeep, ActionList([DrawACard]))])",
    "draw a card for each {{Eachable}}": "ActionList([DrawNumberCards({{Eachable[0]}})])",
    "draw a card for each {{Eachable}}, then create a Treasure token for each {{Eachable}}": "ActionList([DrawNumberCards({{Eachable[0]}}), CreateTokens([NumberTokens({{Eachable[1]}}, TreasureToken)])])",
    "draw a card if your library has more cards in it than target opponent's library. Otherwise, each opponent mills {{Number}} cards": "Targeted([TargetPlayer(Opponent)], ActionList([IfElse(PlayerPassesFilter(You, NumCardsInLibraryIs(GreaterThan(NumCardsInPlayersLibrary(Ref_TargetPlayer)))), [DrawACard], [EachPlayerAction(Opponent, MillNumberCards({{Number[0]}}))])]))",
    "draw a card if {{Condition}}": "ActionList([If({{Condition[0]}}, [DrawACard])])",
    "draw a card if {{Condition}}. If {{Condition}}, create {{a}} {{PT}} {{CreatureToken}}": "ActionList([If({{Condition[0]}}, [DrawACard]), If({{Condition[1]}}, [CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])])])",
    "draw a card if {{Condition}}. Otherwise, discard a card": "ActionList([IfElse({{Condition[0]}}, [DrawACard], [DiscardACard])])",
    "draw a card if {{Condition}}. Otherwise, each player sacrifices {{a}} {{Permanent}} of their choice": "ActionList([IfElse({{Condition[0]}}, [DrawACard], [EachPlayerAction(AnyPlayer, SacrificeAPermanent({{Permanent[0]}}))])])",
    "draw a card if {{Condition}}. Otherwise, put {{a}} {{CounterType}} counter on {{a}} {{Permanent}}": "ActionList([IfElse({{Condition[0]}}, [DrawACard], [PutACounterOfTypeOnAPermanent({{CounterType[0]}}, {{Permanent[0]}})])])",
    "draw a card if {{Condition}}. Otherwise, you gain {{Digits}} life": "ActionList([IfElse({{Condition[0]}}, [DrawACard], [GainLife({{Digits[0]}})])])",
    "draw a card if {{Condition}}. Otherwise, you gain {{Digits}} life and scry {{Digits}}": "ActionList([IfElse({{Condition[0]}}, [DrawACard], [GainLife({{Digits[0]}}), Scry({{Digits[1]}})])])",
    "draw a card unless target opponent sacrifices {{a}} {{Permanent}} of their choice or pays {{Digits}} life": "Targeted([TargetPlayer(Opponent)], ActionList([PlayerMayCost(Ref_TargetPlayer, Or([SacrificeAPermanent({{Permanent[0]}}), PayLife({{Digits[0]}})])), Unless(CostWasPaid, [DrawACard])]))",
    "draw a card, then create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}}": "ActionList([DrawACard, CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])])])",
    "draw a card, then discard a card": "ActionList([DrawACard, DiscardACard])",
    "draw a card, then discard a card. If {{Condition}}, instead draw {{Number}} cards": "ActionList([IfElse({{Condition[0]}}, [DrawNumberCards({{Number[0]}})], [DrawACard, DiscardACard])])",
    "draw a card, then discard a card. If {{Condition}}, instead draw {{Number}} cards, then discard a card": "ActionList([IfElse({{Condition[0]}}, [DrawNumberCards({{Number[0]}}), DiscardACard], [DrawACard, DiscardACard])])",
    "draw a card, then discard a card. Then if {{Condition}}, target opponent loses the game": "Targeted([TargetPlayer(Opponent)], ActionList([DrawACard, DiscardACard, If({{Condition[0]}}, [PlayerAction(Ref_TargetPlayer, LoseTheGame)])]))",
    "draw a card, then discard a card. When you discard a card this way, put {{a}} {{CounterType}} counter on target {{Permanent}}": "ActionList([DrawACard, DiscardACard, ReflexiveTriggerNumberTimes(NumCardsDiscardedThisWay, Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent)])))])",
    "draw a card, then discard a card. When you discard {{a}} {{SpecificCard}} this way, put {{a}} {{CounterType}} counter on target {{Permanent}}": "ActionList([DrawACard, DiscardACard, If(ACardWasDiscardedThisWay({{SpecificCard[0]}}), [ReflexiveTrigger(Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent)])))])])",
    "draw a card, then exile a card from your hand face down. It becomes foretold. Its foretell cost is its mana cost reduced by {{CostReduce}}": "ActionList([DrawACard, ExileACardFromHandFaceDown, CreateExiledCardEffect(TheCardExiledThisWay, [IsForetoldForCost(ItsManaCostReducedBy({{CostReduce[0]}}))])])",
    "draw a card, then scry {{Digits}}": "ActionList([DrawACard, Scry({{Digits[0]}})])",
    "draw a card, then you lose life equal to {{GameNumber}}": "ActionList([DrawACard, LoseLife({{GameNumber[0]}})])",
    "draw a card, then you may put a permanent card with mana value less than or equal to {{GameNumber}} from your hand onto the battlefield tapped": "ActionList([DrawACard, MayAction(PutACardFromHandOnBattlefield(And([IsPermanent, ManaValueIs(LessThanOrEqualTo({{GameNumber[0]}}))]), [EntersTapped]))])",
    "draw a card, then you may put {{a}} {{SpecificCard}} from your hand onto the battlefield": "ActionList([DrawACard, MayAction(PutACardFromHandOnBattlefield({{SpecificCard[0]}}, [EntersNormally]))])",
    "draw a card, then you may put {{a}} {{SpecificCard}} from your hand onto the battlefield. If you put {{a}} {{Swamp}} onto the battlefield this way, you gain {{Digits}} life": "ActionList([DrawACard, MayAction(PutACardFromHandOnBattlefield({{SpecificCard[0]}}, [EntersNormally])), If(APermanentWasPutOntoTheBattlefieldThisWay(IsLandType({{Swamp[0]}})), [GainLife({{Digits[0]}})])])",
    "draw a card, then you may put {{a}} {{SpecificCard}} from your hand or graveyard onto the battlefield": "ActionList([DrawACard, MayAction(PutACardFromHandOrGraveyardOnBattlefield({{SpecificCard[0]}}, You, [EntersNormally]))])",
    "draw a card. Draw another card if {{Condition}}": "ActionList([DrawACard, If({{Condition[0]}}, [DrawACard])])",
    "draw a card. Each player loses {{Digits}} life": "ActionList([DrawACard, EachPlayerAction(AnyPlayer, LoseLife({{Digits[0]}}))])",
    "draw a card. Each player may put {{a}} {{SpecificCard}} from their hand onto the battlefield, then each opponent who didn't draws a card": "ActionList([DrawACard, EachPlayerMayCost(AnyPlayer, PutACardFromHandOnBattlefield({{SpecificCard[0]}}, [EntersNormally])), EachPlayerAction(DidntPayCost, DrawACard)])",
    "draw a card. If {{Condition}}, each opponent loses {{Digits}} life and you gain {{Digits}} life. Otherwise, you lose {{Digits}} life": "ActionList([DrawACard, IfElse({{Condition[0]}}, [EachPlayerAction(Opponent, LoseLife({{Digits[0]}})), GainLife({{Digits[1]}})], [LoseLife({{Digits[2]}})])])",
    "draw a card. Then discard a card unless {{Condition}}": "ActionList([DrawACard, Unless({{Condition[0]}}, [DiscardACard])])",
    "draw a card. Then each opponent faces a villainous choice - That player discards a card, or you may put {{a}} {{SpecificCard}} from your hand onto the battlefield": "ActionList([DrawACard, EachPlayerMakesAVillainousChoice(Opponent, [[PlayerAction(EachablePlayer, DiscardACard)], [MayAction(PutACardFromHandOnBattlefield({{SpecificCard[0]}}, [EntersNormally]))]])])",
    "draw a card. Then if you have fewer than {{Number}} cards in hand, draw cards equal to the difference": "ActionList([DrawACard, If(PlayerPassesFilter(You, NumCardsInHandIs(LessThan({{Number[0]}}))), [DrawNumberCards(Minus({{Number[0]}}, TheNumberOfCardsInPlayersHand(You)))])])",
    "draw a card. Then if {{Condition}}, put a card from your hand on the bottom of your library": "ActionList([DrawACard, If({{Condition[0]}}, [PutACardFromHandOnBottomOfLibrary])])",
    "draw a card. Then if {{Condition}}, untap each {{Permanent}}. Then if {{Condition}}, each opponent loses half their life, rounded up": "ActionList([DrawACard, If({{Condition[0]}}, [UntapEachPermanent({{Permanent[0]}})]), If({{Condition[1]}}, [EachPlayerAction(Opponent, LoseLife(HalfRoundedUp(LifeTotalOfPlayer(EachablePlayer))))])])",
    "draw a card. Then you may cast a spell from your hand with mana value {{Digits}} or less without paying its mana cost": "ActionList([DrawACard, MayAction(CastASpellFromHandWithoutPaying(ManaValueIs(LessThanOrEqualTo({{Digits[0]}}))))])",
    "draw a card. Then you may exile {{a}} {{SpecificCard}} from your hand. If you do, create a token that's a copy of the exiled card, except it's {{a}} {{PT}} {{Zombie}} artifact creature in addition to its other types": "ActionList([DrawACard, MayCost(ExileACardOfTypeFromHand({{SpecificCard[0]}})), If(CostWasPaid, [CreateTokens([TokenCopyOfExiledCard(TheCardExiledThisWay, TokenCopyEffects([SetPT({{PT[0]}}), AddCreatureTypes([{{Zombie[0]}}]), AddCardtypes([Artifact, Creature])]))])])])",
    "draw an additional card": "ActionList([DrawACard])",
    "draw an additional card for each {{Eachable}}": "ActionList([DrawNumberCards({{Eachable[0]}})])",
    "draw an additional card, then discard a card": "ActionList([DrawACard, DiscardACard])",
    "draw cards equal to {{GameNumber}}": "ActionList([DrawNumberCards({{GameNumber[0]}})])",
    "draw cards equal to {{GameNumber}} or {{GameNumber}}, whichever is greater": "ActionList([DrawNumberCards(MaximumOf({{GameNumber[0]}}, {{GameNumber[1]}}))])",
    "draw {{Number}} additional cards": "ActionList([DrawNumberCards({{Number[0]}})])",
    "draw {{Number}} cards": "ActionList([DrawNumberCards({{Number[0]}})])",
    "draw {{Number}} cards if {{Condition}}": "ActionList([If({{Condition[0]}}, [DrawNumberCards({{Number[0]}})])])",
    "draw {{Number}} cards, then discard a card": "ActionList([DrawNumberCards({{Number[0]}}), DiscardACard])",
    "draw {{Number}} cards, then discard {{Number}} cards": "ActionList([DrawNumberCards({{Number[0]}}), DiscardNumberCards({{Number[1]}})])",
    "draw {{Number}} cards, then discard {{Number}} of them": "ActionList([DrawNumberCardsThenDiscardNumberOfThem({{Number[0]}}, {{Number[1]}})])",
    "draw {{Number}} cards, then put {{Number}} cards from your hand on the bottom of your library": "ActionList([DrawNumberCards({{Number[0]}}), PutNumCardsFromHandOnBottomOfLibraryAnyOrder({{Number[1]}})])",
    "draw {{Number}} cards, then put {{Number}} cards from your hand on top of your library in any order": "ActionList([DrawNumberCards({{Number[0]}}), PutNumCardsFromHandOnTopOfLibraryAnyOrder({{Number[1]}})])",
    "draw {{Number}} cards. At the beginning of your next upkeep, discard {{Number}} cards at random": "ActionList([DrawNumberCards({{Number[0]}}), CreateFutureTrigger(AtTheBeginningOfPlayersNextUpkeep(You), ActionList([DiscardNumberCardsAtRandom({{Number[1]}})]))])",
    "draw {{Number}} cards. Then discard {{Number}} cards unless you discard {{a}} {{SpecificCard}}": "ActionList([DrawNumberCards({{Number[0]}}), MayCost(DiscardACardOfType({{SpecificCard[0]}})), Unless(CostWasPaid, [DiscardNumberCards({{Number[1]}})])])",
    "draw {{Number}} cards. Then discard {{Number}} cards unless you discard {{a}} {{SpecificCard}} or {{a}} {{SpecificCard}}": "ActionList([DrawNumberCards({{Number[0]}}), MayCost(Or([DiscardACardOfType({{SpecificCard[0]}}), DiscardACardOfType({{SpecificCard[1]}})])), Unless(CostWasPaid, [DiscardNumberCards({{Number[1]}})])])",
    "draw {{Number}} cards. You have no maximum hand size until your next turn": "ActionList([DrawNumberCards({{Number[0]}}), CreatePlayerEffectUntil(You, [HasNoMaximumHandSize], UntilEndOfTurn)])",
    "draw {{Number}} cards. You have no maximum hand size until your next turn. If {{Condition}}, you may cast up to {{Number}} spells from your hand without paying their mana costs": "ActionList([DrawNumberCards({{Number[0]}}), CreatePlayerEffectUntil(You, [HasNoMaximumHandSize], UntilPlayersNextTurn(You)), If({{Condition[0]}}, [CastUptoNumberSpellsFromHandWithoutPaying({{Number[1]}}, AnySpell)])])",
    "draw {{Number}} cards. You may play an additional land this turn": "ActionList([DrawNumberCards({{Number[0]}}), CreatePlayerEffectUntil(You, [MayPlayAnAdditionalLand], UntilEndOfTurn)])",
    "draw {{Number}} cards. {{PotentialSpells}} you cast this turn cost {{CostReduce}} less to cast": "ActionList([DrawNumberCards({{Number[0]}}), CreatePlayerEffectUntil(You, [DecreaseSpellCost({{PotentialSpells[0]}}, {{CostReduce[0]}})], UntilEndOfTurn)])",
    "each blank roll of the planar die is a {CHAOS} roll until a player planeswalks away from a plane": "ActionList([CreateGameEffect(UntilAPlayerPlaneswalks(AnyPlayer), PlanarDieBlanksRollsAreChaos)])",
    "each creature target opponent controls loses all abilities, becomes {{a}} {{Zombie}} in addition to its other types, and has base power and toughness {{PT}}": "Targeted([TargetPlayer(Opponent)], ActionList([CreateEachPermanentLayerEffect(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]), [LosesAllAbilities, AddCreatureType({{Zombie[0]}}), SetPT({{PT[0]}})])]))",
    "each creature you control attacking a player gets {{PTMod}} until end of turn for each creature that player controls": "ActionList([CreateEachPermanentLayerEffectUntil(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), IsAttackingAPlayer(AnyPlayer)]), [AdjustPTForEach({{PTMod[0]}}, TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), ControlledByPlayer(PlayerCreatureIsAttacking(EachablePermanent))])))], UntilEndOfTurn)])",
    "each creature you control gets {{PTMod}} until end of turn if it has the same name as another creature you control or a creature card in your graveyard": "ActionList([CreateEachPermanentLayerEffectUntil(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You)), Or([SharesANameWithAPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))])), SharesANameWithCardInPlayersGraveyard(IsCardtype(Creature), You)])]), [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])",
    "each of your opponents discards a card": "ActionList([EachPlayerAction(Opponent, DiscardACard)])",
    "each opponent blights {{Digits}}": "ActionList([EachPlayerAction(Opponent, Blight({{Digits[0]}}))])",
    "each opponent can't block with more than one creature this combat": "ActionList([CreateEachPlayerEffectUntil(Opponent, [CantBlockWithMoreThanOneCreature], UntilEndOfCombat)])",
    "each opponent can't cast {{PotentialSpells}} during that player's next turn": "ActionList([EachPlayerCantCastSpellsDuringTheirNextTurn(Opponent, {{PotentialSpells[0]}})])",
    "each opponent chooses money, friends, or secrets. For each player who chose money, you and that player each create a Treasure token. For each player who chose friends, you and that player each create {{a}} {{PT}} {{CreatureToken}}. For each player who chose secrets, you and that player each draw a card": "ActionList([EachPlayerAction(Opponent, ChooseWord([\"Money\", \"Friends\", \"Secrets\"])), EachPlayerAction(ChoseWord(\"Money\"), EachPlayerAction(Or([SinglePlayer(You), SinglePlayer(EachablePlayer)]), CreateTokens([TreasureToken]))), EachPlayerAction(ChoseWord(\"Friends\"), EachPlayerAction(Or([SinglePlayer(You), SinglePlayer(EachablePlayer)]), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])]))), EachPlayerAction(ChoseWord(\"Secrets\"), EachPlayerAction(Or([SinglePlayer(You), SinglePlayer(EachablePlayer)]), DrawACard))])",
    "each opponent chooses {{a}} {{Permanent}} they control and exiles it": "ActionList([EachPlayerAction(Opponent, ChooseAPermanent(And([{{Permanent[0]}}, ControlledByPlayer(EachPlayerAction_ThatPlayer)]))), EachPlayerAction(Opponent, ExilePermanent(ThePermanentChosenByPlayerThisWay(EachablePlayer)))])",
