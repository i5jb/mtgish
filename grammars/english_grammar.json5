    "Pay {{ManaCost}} for each {{Eachable(~Permanent)}}": "PayManaForEach({{ManaCost[0]}}, {{Eachable(~Permanent=^~Permanent)[0]}})"
  },
  "{{PayManaCost[EnchantedPermanent]}}": {
    "Pay {{EnchantedPermanent}}'s mana cost": "PayManaCostOfPermanent(HostPermanent)"
  },
  "{{Permanent(DefendingPlayer)}}": {
    "artifact or enchantment defending player controls": "And([Or([IsCardtype(Artifact), IsCardtype(Enchantment)]), ControlledByPlayer({{DefendingPlayer}})])",
    "creature defending player controls": "And([IsCardtype(Creature), ControlledByPlayer({{DefendingPlayer}})])",
    "creature defending player controls with toughness {{Digits}} or less": "And([IsCardtype(Creature), ControlledByPlayer({{DefendingPlayer}}), ToughnessIs(LessThanOrEqualTo({{Digits[0]}}))])"
  },
  "{{Permanent(~Permanent)}}": {
    "artifact and creature with mana value equal to {{GameNumber(~Permanent)}}": "And([Or([IsCardtype(Artifact), IsCardtype(Creature)]), ManaValueIs(EqualTo({{GameNumber(~Permanent=^~Permanent)[0]}}))])",
    "legendary permanent other than {{~Permanent}}": "And([IsSupertype(Legendary), Other({{~Permanent}})])",
    "nonland permanent other than this creature": "And([IsNonCardtype(Land), Other({{~Permanent}})])",
    "nonland permanent with mana value equal to {{GameNumber(~Permanent)}}": "And([IsNonCardtype(Land), ManaValueIs(EqualTo({{GameNumber(~Permanent=^~Permanent)[0]}}))])",
    "nonland permanent with mana value less than or equal to {{GameNumber(~Permanent)}}": "And([IsNonCardtype(Land), ManaValueIs(LessThanOrEqualTo({{GameNumber(~Permanent=^~Permanent)[0]}}))])",
    "permanent other than this creature": "Other({{~Permanent}})",
    "permanent other than this enchantment": "Other({{~Permanent}})",
    "permanent other than {{~Permanent}}": "Other({{~Permanent}})",
    "permanent you control other than this creature": "And([ControlledByAPlayer(SinglePlayer(You)), Other({{~Permanent}})])",
    "{{Creature(~Permanent)}}": "{{Creature(~Permanent=^~Permanent)[0]}}"
  },
  "{{PermanentCards}}": {
    "Artifact cards": "IsCardtype(Artifact)",
    "Aura and/or Equipment cards": "Or([IsEnchantmentType(Aura), IsArtifactType(Equipment)])",
    "Aura cards": "IsEnchantmentType(Aura)",
    "Nonland permanent cards": "And([IsNonCardtype(Land), IsPermanent])",
    "Permanent cards": "IsPermanent",
    "Spacecraft cards": "IsArtifactType(Equipment)",
    "artifact and creature cards": "Or([IsCardtype(Artifact), IsCardtype(Creature)])",
    "artifact and enchantment cards": "Or([IsCardtype(Artifact), IsCardtype(Enchantment)])",
    "artifact and/or creature cards": "Or([IsCardtype(Artifact), IsCardtype(Creature)])",
    "artifact and/or creature cards with mana value {{Digits}} or less": "And([Or([IsCardtype(Artifact), IsCardtype(Creature)]), ManaValueIs(LessThanOrEqualTo({{Digits[0]}}))])",
    "artifact and/or enchantment cards": "Or([IsCardtype(Artifact), IsCardtype(Enchantment)])",
    "artifact cards": "IsCardtype(Artifact)",
    "artifact creature cards": "And([IsCardtype(Artifact), IsCardtype(Creature)])",
    "artifact or creature cards": "Or([IsCardtype(Artifact), IsCardtype(Creature)])",
    "artifact, creature, and land cards": "Or([IsCardtype(Artifact), IsCardtype(Creature), IsCardtype(Land)])",
    "artifact, creature, and/or enchantment cards with mana value {{Digits}} or less": "And([Or([IsCardtype(Artifact), IsCardtype(Creature), IsCardtype(Enchantment)]), ManaValueIs(LessThanOrEqualTo({{Digits[0]}}))])",
