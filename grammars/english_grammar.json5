    "The next time {{a}} {{DamageSource}} of your choice would deal damage to target {{Creature}} this turn, prevent that damage": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([ChooseADamageSource({{DamageSource[0]}}), CreateFuturePreventDamage(NextTimeDamageWouldBeDealtThisTurnBySourceToRecipient(TheChosenDamageSource, Permanent(Ref_TargetPermanent)), [PreventThatDamage])]))",
    "The next time {{a}} {{DamageSource}} of your choice would deal damage to target {{Creature}} this turn, that source deals that damage to you instead": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([ChooseADamageSource({{DamageSource[0]}}), CreateFutureReplaceWouldDealDamage(NextTimeDamageWouldBeDealtThisTurnBySourceToRecipient(TheChosenDamageSource, Permanent(Ref_TargetPermanent)), [DealToPlayerInstead(You)])]))",
    "The next time {{a}} {{DamageSource}} of your choice would deal damage to you this turn, prevent half that damage, rounded down": "ActionList([ChooseADamageSource({{DamageSource[0]}}), CreateFuturePreventDamage(NextTimeDamageWouldBeDealtThisTurnBySourceToRecipient(TheChosenDamageSource, Player(You)), [PreventSomeOfThatDamage(HalfRoundedDown(WouldDealDamage_ThatMuchDamage))])])",
    "The next time {{a}} {{DamageSource}} of your choice would deal damage to you this turn, prevent that damage": "ActionList([ChooseADamageSource({{DamageSource[0]}}), CreateFuturePreventDamage(NextTimeDamageWouldBeDealtThisTurnBySourceToRecipient(TheChosenDamageSource, Player(You)), [PreventThatDamage])])",
    "The next time {{a}} {{DamageSource}} of your choice would deal damage to you this turn, prevent that damage. Exile cards from the top of your library equal to the damage prevented this way": "ActionList([CreateFuturePreventDamage(NextTimeDamageWouldBeDealtThisTurnBySourceToRecipient(TheChosenDamageSource, Player(You)), [PreventThatDamage, ExileTheTopNumberCardsOfLibrary(TheAmountOfDamagePreventedThisWay)])])",
