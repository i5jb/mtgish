    "This creature can't attack its owner": "PermanentRuleEffect(ThisPermanent, [CantAttackPlayer(OwnerOfPermanent(ThisPermanent))])",
    "This creature can't attack or block unless its controller pays {{ManaCost}} for each {{Zombie}} on the battlefield": "PermanentRuleEffect(ThisPermanent, [CantAttackUnlessCost(PayManaForEach({{ManaCost[0]}}, TheNumberOfPermanentsOnTheBattlefield(IsCreatureType({{Zombie[0]}})))), CantBlockUnlessCost(PayManaForEach({{ManaCost[0]}}, TheNumberOfPermanentsOnTheBattlefield(IsCreatureType({{Zombie[0]}}))))])",
    "This creature can't attack unless defending player controls {{a}} {{Swamp}}": "PermanentRuleEffect(ThisPermanent, [CantAttackUnlessDefendingPlayer(PlayerPassesFilter(DefendingPlayer, ControlsA(IsLandType({{Swamp[0]}}))))])",
    "This creature can't be blocked": "PermanentRuleEffect(ThisPermanent, [CantBeBlocked])",
