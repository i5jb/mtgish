    "As an additional cost to cast this spell, forage or pay {{ManaCost}}": "CastEffect(AdditionalCastingCost(Or([Forage, PayMana({{ManaCost[0]}})])))",
    "As an additional cost to cast this spell, pay {{Digits}} life": "CastEffect(AdditionalCastingCost(PayLife({{Digits[0]}})))",
