    "{{~Spell}} deals {{Digits}} damage to target {{Creature}}. When that creature dies this turn, exile its controller's graveyard": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent)), CreateTriggerUntil(WhenACreatureOrPlaneswalkerDies(SinglePermanent(Ref_TargetPermanent)), ActionList([ExilePlayersGraveyard(OwnerOfGraveyrdCard(Trigger_ThatGraveyardCard))]), UntilEndOfTurn)]))",
    "{{~Spell}} deals {{Digits}} damage to target {{Creature}}. When that creature dies this turn, {{~Spell}} deals {{Digits}} damage to the creature's controller": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent)), CreateTriggerUntil(WhenACreatureOrPlaneswalkerDies(SinglePermanent(Ref_TargetPermanent)), ActionList([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Player(ControllerOfPermanent(Ref_TargetPermanent)))]), UntilEndOfTurn)]))",
    "{{~Spell}} deals {{Digits}} damage to target {{Creature}}. You gain life equal to the excess damage dealt this way": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent)), GainLife(AmountOfExcessDamageDealtThisWay)]))",
    "{{~Spell}} deals {{Digits}} damage to target {{Creature}}. You gain {{Digits}} life": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent)), GainLife({{Digits[0]}})]))",
    "{{~Spell}} deals {{Digits}} damage to target {{Creature}}. You gain {{Digits}} life if {{Condition}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent)), If({{Condition[0]}}, [GainLife({{Digits[0]}})])]))",
    "{{~Spell}} deals {{Digits}} damage to target {{Creature}}. You may exile a card from your graveyard. If you do, {{~Spell}} also deals {{Digits}} damage to that creature's controller": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([SpellDealsDamage(ThisSpell, {{Digits[0]}}, Permanent(Ref_TargetPermanent)), MayCost(Exile([AGraveyardCard(InAPlayersGraveyard(SinglePlayer(You)))])), If(CostWasPaid, [SpellDealsDamage(ThisSpell, {{Digits[1]}}, Player(ControllerOfPermanent(Ref_TargetPermanent)))])]))",
    "{{~Spell}} deals {{Digits}} damage to target {{Creature}}. You may put a card from your hand on the bottom of your library. If you do, draw a card": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent)), MayCost(PutACardFromHandOnBottomOfLibrary), If(CostWasPaid, [DrawACard])]))",
    "{{~Spell}} deals {{Digits}} damage to target {{Creature}}. You may search your library and/or graveyard for {{a}} {{SpecificCard}}, reveal it, and put it into your hand. If you search your library this way, shuffle": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent)), MayAction(SearchLibraryAndOrGraveyard([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsIntoHand, ShuffleLibraryIfSearched]))]))",
    "{{~Spell}} deals {{Digits}} damage to target {{Creature}}. {{Creatures}} can't block this turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent)), CreateEachPermanentRuleEffectUntil({{Creatures[0]}}, [CantBlock], UntilEndOfTurn)]))",
    "{{~Spell}} deals {{Digits}} damage to target {{Creature}}. {{~Spell}} deals {{Digits}} damage to that creature instead if you controlled {{a}} {{Zombie}} as you cast this spell": "Modal_IfElse(PlayerPassesFilter(You, ControlsA(IsCreatureType({{Zombie[0]}}))), Targeted([TargetPermanent({{Creature[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{Digits[1]}}, Permanent(Ref_TargetPermanent))])), Targeted([TargetPermanent({{Creature[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent))])))",
    "{{~Spell}} deals {{Digits}} damage to target {{PlayerOrPlaneswalker}}": "Targeted([TargetPlayerOrPermanent({{PlayerOrPlaneswalker[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Ref_TargetPlayerOrPermanent)]))",
    "{{~Spell}} deals {{Digits}} damage to target {{PlayerOrPlaneswalker}} and you gain {{Digits}} life": "Targeted([TargetPlayerOrPermanent({{PlayerOrPlaneswalker[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Ref_TargetPlayerOrPermanent), GainLife({{Digits[0]}})]))",
    "{{~Spell}} deals {{Digits}} damage to target {{PlayerOrPlaneswalker}} and {{Digits}} damage to target {{Creature}}": "Targeted([TargetPlayerOrPermanent({{PlayerOrPlaneswalker[0]}}), TargetPermanent({{Creature[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, MultipleRecipients([Ref_TargetPlayerOrPermanent, Permanent(Ref_TargetPermanent)]))]))",
    "{{~Spell}} deals {{Digits}} damage to target {{PlayerOrPlaneswalker}}.\nSearch your library and/or graveyard for {{a}} {{SpecificCard}}, reveal it, and put it into your hand. If you search your library this way, shuffle": "Targeted([TargetPlayerOrPermanent({{PlayerOrPlaneswalker[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Ref_TargetPlayerOrPermanent), SearchLibraryAndOrGraveyard([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsIntoHand, ShuffleLibraryIfSearched])]))",
    "{{~Spell}} deals {{Digits}} damage to target {{PlayerOrPlaneswalker}}. If {{Condition}}, draw a card": "Targeted([TargetPlayerOrPermanent({{PlayerOrPlaneswalker[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Ref_TargetPlayerOrPermanent), If({{Condition[0]}}, [DrawACard])]))",
    "{{~Spell}} deals {{Digits}} damage to target {{PlayerOrPlaneswalker}}. You gain {{Digits}} life": "Targeted([TargetPlayerOrPermanent({{PlayerOrPlaneswalker[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Ref_TargetPlayerOrPermanent), GainLife({{Digits[0]}})]))",
    "{{~Spell}} deals {{Digits}} damage to target {{PlayerOrPlaneswalker}}. You gain {{Digits}} life.\nDraw a card at the beginning of the next turn's upkeep": "Targeted([TargetPlayerOrPermanent({{PlayerOrPlaneswalker[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Ref_TargetPlayerOrPermanent), GainLife({{Digits[0]}}), CreateFutureTrigger(AtTheBeginningOfTheNextTurnsUpkeep, ActionList([DrawACard]))]))",
    "{{~Spell}} deals {{Digits}} damage to the controller of the last {{Spell}} that dealt damage to you this turn": "ActionList([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Player(ControllerOfLastSpellThatDealtDamageToPlayerThisTurn({{Spell[0]}}, You)))])",
    "{{~Spell}} deals {{Digits}} damage to up to one target {{Creature}}. Look at the top two cards of your library. Put one of those cards into your hand and the other on the bottom of your library": "Targeted([UptoOneTargetPermanent({{Creature[0]}})], ActionList([SpellDealsDamage(ThisSpell, {{Digits[0]}}, Permanent(Ref_TargetPermanent)), LookAtTheTopNumberCardsOfLibrary(Integer(2), [PutAGenericCardIntoHand, PutTheRemainingCardsOnTheBottomOfLibraryInAnyOrder])]))"
  },
  "{{SpellActions(~Spell,ThatPlayer)}}": {
    "You put {{a}} {{CounterType}} counter on each {{Permanent}} that player controls and {{~Spell}} deals {{Digits}} damage to that player": "ActionList([PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, And([{{Permanent[0]}}, ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))])), SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Player({{ThatPlayer}}))])"
  },
  "{{SpellActions(~Spell,X)}}": {
    "Choose a color. {{~Spell}} deals X damage to each creature of the chosen color": "ActionList([ChooseAColor(AnyColor), SpellDealsDamage({{~Spell}}, {{X}}, EachPermanent(And([IsCardtype(Creature), IsColor(TheChosenColor)])))])",
    "Counter target {{Spell}} unless its controller pays {{ManaCostX}}. {{~Spell}} deals X damage to that spell's controller": "Targeted([TargetSpell({{Spell[0]}})], ActionList([PlayerMayCost(ControllerOfSpell({{~Spell}}), PayManaX({{ManaCostX[0]}}, {{X}})), Unless(CostWasPaid, [CounterSpell(Ref_TargetSpell)]), SpellDealsDamage({{~Spell}}, {{X}}, Player(ControllerOfSpell(Ref_TargetSpell)))]))",
    "Create X tapped {{PT}} {{CreatureTokens}}, then you gain life equal to {{GameNumber}}. Exile {{~Spell}}": "ActionList([CreateTokensWithFlags([NumberTokens({{X}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))], [EntersTapped]), GainLife({{GameNumber[0]}}), ExileSpell({{~Spell}})])",
    "Create X {{PT}} {{CreatureTokens}}. Shuffle {{~Spell}} into its owner's library": "ActionList([CreateTokens([NumberTokens({{X}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))]), ShuffleSpellIntoLibrary({{~Spell}})])",
    "Damage can't be prevented this turn. {{~Spell}} deals X damage to target creature and {{Digits}} damage to each other creature with the same controller": "Targeted([TargetPermanent(IsCardtype(Creature))], ActionList([CreateGameEffect(UntilEndOfTurn, DamageCantBePrevented), SpellDealsMultipleDamage({{~Spell}}, [DamageToRecipients({{X}}, Permanent(Ref_TargetPermanent)), DamageToRecipients({{Digits[0]}}, EachPermanent(And([Other(Ref_TargetPermanent), IsCardtype(Creature), ControlledByPlayer(ControllerOfPermanent(Ref_TargetPermanent))])))])]))",
    "Destroy X target artifacts. {{~Spell}} deals damage to each player equal to the number of artifacts they controlled that were put into a graveyard this way": "Targeted([NumberTargetPermanents({{X}}, IsCardtype(Artifact))], ActionList([DestroyEachPermanent(Ref_TargetPermanents), SpellDealsDamage({{~Spell}}, TheNumberOfPermanentsPutIntoAPlayersGraveyardThisWay(And([IsCardtype(Artifact), ControlledByPlayer(DealsDamage_ThatPlayer)]), AnyPlayer), EachPlayer(AnyPlayer))]))",
    "Destroy X target {{Swamps}}. {{~Spell}} deals damage to each creature and each player equal to the number of {{Swamps}} put into a graveyard this way": "Targeted([NumberTargetPermanents({{X}}, IsLandType({{Swamps[0]}}))], ActionList([DestroyEachPermanent(Ref_TargetPermanents), SpellDealsDamage({{~Spell}}, TheNumberOfPermanentsPutIntoAPlayersGraveyardThisWay(IsLandType({{Swamps[1]}}), AnyPlayer), MultipleRecipients([EachPermanent(IsCardtype(Creature)), EachPlayer(AnyPlayer)]))]))",
    "Destroy target artifact with mana value X. It can't be regenerated. {{~Spell}} deals X damage to that artifact's controller": "Targeted([TargetPermanent(And([IsCardtype(Artifact), ManaValueIs(EqualTo({{X}}))]))], ActionList([DestroyPermanentNoRegen(Ref_TargetPermanent), SpellDealsDamage({{~Spell}}, {{X}}, Player(ControllerOfPermanent(Ref_TargetPermanent)))]))",
    "Destroy target creature with mana value X. If that creature dies this way, {{~Spell}} deals damage equal to {{GameNumber(ThatCreature)}} to the creature's controller": "Targeted([TargetPermanent(And([IsCardtype(Creature), ManaValueIs(EqualTo({{X}}))]))], ActionList([DestroyPermanent(Ref_TargetPermanent), If(PermanentDiesThisWay, [SpellDealsDamage({{~Spell}}, {{GameNumber(ThatCreature=Ref_TargetPermanent)[0]}}, Player(ControllerOfPermanent(Ref_TargetPermanent)))])]))",
    "Discard X cards, then return a card from your graveyard to your hand for each card discarded this way. Exile {{~Spell}}": "ActionList([DiscardNumberCards({{X}}), ReturnNumberCardsFromPlayersGraveyardToHand(NumCardsDiscardedThisWay, AnyCard, You), ExileSpell({{~Spell}})])",
    "Draw X cards. If X is {{Digits}} or more, instead shuffle your graveyard into your library, draw X cards, untap up to {{Number}} {{Permanents}}, and you have no maximum hand size for the rest of the game.\nExile {{~Spell}}": "ActionList([IfElse(SpellXIs(GreaterThanOrEqualTo({{Digits[0]}})), [ShuffleGraveyardIntoLibrary, DrawNumberCards({{X}}), UntapUptoNumberPermanents({{Number[0]}}, {{Permanents[0]}}), CreatePlayerEffectUntil(You, [HasNoMaximumHandSize], UntilEndOfGame)], [DrawNumberCards({{X}})]), ExileSpell(ThisSpell)])",
    "Each player sacrifices X {{Permanents}} of their choice. {{~Spell}} deals X damage to each {{Creature}}": "ActionList([EachPlayerAction(AnyPlayer, SacrificeNumberPermanents({{X}}, {{Permanents[0]}})), SpellDealsDamage({{~Spell}}, {{X}}, EachPermanent({{Creature[0]}}))])",
    "Exile the top X cards of your library. For each {{SpecificCard}} exiled this way, create a Treasure token. For each {{SpecificCard}} exiled this way, draw a card. For each {{SpecificCard}} exiled this way, {{~Spell}} deals {{Digits}} damage to each opponent": "ActionList([ExileTheTopNumberCardsOfLibrary({{X}}), CreateTokens([NumberTokens(TheNumberOfLibraryCardsOfTypeExiledThisWay({{SpecificCard[0]}}), TreasureToken)]), DrawNumberCards(TheNumberOfLibraryCardsOfTypeExiledThisWay({{SpecificCard[1]}})), SpellDealsDamageForEach({{~Spell}}, {{Digits[0]}}, EachPlayer(Opponent), TheNumberOfLibraryCardsOfTypeExiledThisWay({{SpecificCard[2]}}))])",
    "For each opponent, choose up to one target creature that player controls. {{~Spell}} deals X damage to each of those creatures. You create a Mutagen token for each creature dealt damage this way": "Targeted([UptoOneTargetPermanentEachPlayerControls(IsCardtype(Creature), Opponent)], ActionList([SpellDealsDamage(ThisSpell, {{X}}, EachPermanent(Ref_TargetPermanents)), CreateTokens([NumberTokens(TheNumberOfPermanentsDealtDamageThisWay(IsCardtype(Creature)), MutagenToken)])]))",
    "Prevent the next X damage that would be dealt to you and/or permanents you control this turn. If damage is prevented this way, {{~Spell}} deals that much damage to any target": "Targeted([AnyTarget], ActionList([CreateFuturePreventDamage(NextAmountOfDamageThatWouldBeDealtThisTurnToARecipient({{X}}, APlayerOrAPermanent(SinglePlayer(You), ControlledByAPlayer(SinglePlayer(You)))), [PreventThatDamage, SpellDealsDamage({{~Spell}}, TheAmountOfDamagePreventedThisWay, Ref_AnyTarget)])]))",
    "Put X {{CounterType}} counters on each {{Permanent}}. Shuffle {{~Spell}} into its owner's library": "ActionList([PutNumberCountersOfTypeOnEachPermanent({{X}}, {{CounterType[0]}}, {{Permanent[0]}}), ShuffleSpellIntoLibrary({{~Spell}})])",
    "Return X cards at random from your graveyard to your hand. Exile {{~Spell}}": "ActionList([ReturnNumberCardsFromPlayersGraveyardToHandAtRandom({{X}}, AnyCard, You), ExileSpell({{~Spell}})])",
    "Return X target cards from your graveyard to your hand. Exile {{~Spell}}": "Targeted([NumberTargetGraveyardCards({{X}}, InAPlayersGraveyard(SinglePlayer(You)))], ActionList([PutEachGraveyardCardIntoHand(Ref_TargetGraveyardCards), ExileSpell({{~Spell}})]))",
    "Return X target cards with different mana values from your graveyard to your hand. If {{Number}} or more cards were returned to your hand this way, your life total becomes equal to your starting life total. Exile {{~Spell}}": "Targeted([NumberTargetGroupGraveyardCards({{X}}, InAPlayersGraveyard(SinglePlayer(You)), DifferentManaValues)], ActionList([PutEachGraveyardCardIntoHand(Ref_TargetGraveyardCards), If(ANumberOfGraveyardCardsWereReturnedToHandThisWay(GreaterThanOrEqualTo({{Number[0]}})), [SetLifeTotal(StartingLifeTotalOfPlayer(ActionPlayer))]), ExileSpell({{~Spell}})]))",
    "Return all {{SpecificCards}} with mana value X or less from your graveyard to the battlefield. Exile {{~Spell}}": "ActionList([ReturnEachCardFromPlayersGraveyardToBattlefield(And([{{SpecificCards[0]}}, ManaValueIs(LessThanOrEqualTo({{X}}))]), You, [EntersNormally]), ExileSpell({{~Spell}})])",
    "Return each creature card with mana value X or less from your graveyard to the battlefield. Exile those creatures at the beginning of your next upkeep. Exile {{~Spell}}": "ActionList([ReturnEachCardFromPlayersGraveyardToBattlefield(And([IsCardtype(Creature), ManaValueIs(LessThanOrEqualTo({{X}}))]), You, [EntersNormally]), CreateFutureTrigger(AtTheBeginningOfPlayersNextEndStep(You), ActionList([ExileEachPermanent(ThePermanentsPutOnTheBattlefieldThisWay)])), ExileSpell({{~Spell}})])",
    "Return up to X target {{SpecificCards}} from your graveyard to your hand.\nExile {{~Spell}}": "Targeted([UptoNumberTargetGraveyardCards({{X}}, And([{{SpecificCards[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutEachGraveyardCardIntoHand(Ref_TargetGraveyardCards), ExileSpell(ThisSpell)]))",
    "Search your library and graveyard for up to {{Number}} creature cards with different names that each have mana value X or less and reveal them. An opponent chooses {{Number}} of those cards. Shuffle the chosen cards into your library and put the rest onto the battlefield. Exile {{~Spell}}": "ActionList([SearchLibraryAndGraveyard([FindUptoNumberGroupCards({{Number[0]}}, And([IsCardtype(Creature), ManaValueIs(LessThanOrEqualTo({{X}}))]), DifferentNames), RevealFoundCards, APlayerChoosesNumberFoundCards(Opponent, {{Number[1]}}), SetAsideNonchosenFoundCards, Shuffle, PutSetAsideCardsOntoBattlefield([EntersNormally])]), ExileSpell({{~Spell}})])",
    "Search your library for {{a}} {{Black}} creature card with mana value X or less, put it onto the battlefield, then shuffle. Shuffle {{~Spell}} into its owner's library": "ActionList([SearchLibrary([FindACardOfType(And([IsColor({{Black[0]}}), IsCardtype(Creature), ManaValueIs(LessThanOrEqualTo({{X}}))])), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle]), ShuffleSpellIntoLibrary({{~Spell}})])",
    "Tap X target {{Creatures}}. {{~Spell}} deals {{Digits}} damage to each of those {{Creatures}}": "Targeted([NumberTargetPermanents({{X}}, {{Creatures[0]}})], ActionList([TapEachPermanent(Ref_TargetPermanents), SpellDealsDamage({{~Spell}}, {{Digits[0]}}, EachPermanent(Ref_TargetPermanents))]))",
    "Target player draws X cards. Shuffle {{~Spell}} into its owner's library": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, DrawNumberCards({{X}})), ShuffleSpellIntoLibrary({{~Spell}})]))",
    "Target player draws X cards. {{~Spell}} deals X damage to up to one target {{CreatureOrPlaneswalker}}": "Targeted([TargetPlayer(AnyPlayer), UptoOneTargetPermanent({{CreatureOrPlaneswalker[0]}})], ActionList([PlayerAction(Ref_TargetPlayer, DrawNumberCards({{X}})), SpellDealsDamage({{~Spell}}, {{X}}, Permanent(Ref_TargetPermanent))]))",
    "X target {{Creatures}} become blocked. {{~Spell}} deals {{Digits}} damage to each of those creatures": "Targeted([NumberTargetPermanents({{X}}, {{Creatures[0]}})], ActionList([SetEachCreatureAsBlocked(Ref_TargetPermanents), SpellDealsDamage({{~Spell}}, {{Digits[0]}}, EachPermanent(Ref_TargetPermanents))]))",
    "You gain twice X life. Put {{~Spell}} on the bottom of its owner's library": "ActionList([GainLife(Twice({{X}})), ReturnSpellToBottomOfLibrary({{~Spell}})])",
    "{{SpellActions[Bargain](~Spell,X)}}": "{{SpellActions[Bargain](~Spell=^~Spell,X=^X)[0]}}",
    "{{~Spell}} deals X damage divided as you choose among any number of target {{Creatures}}": "TargetedDistributed([UptoNumberTargetPermanents({{X}}, {{Creatures[0]}})], DistributeNumberAmongTargets({{X}}), ActionList([SpellDealsDistributedDamage({{~Spell}})]))",
    "{{~Spell}} deals X damage divided as you choose among any number of target {{Creatures}}. Whenever a creature dealt damage this way dies this turn, populate": "TargetedDistributed([UptoNumberTargetPermanents({{X}}, {{Creatures[0]}})], DistributeNumberAmongTargets({{X}}), ActionList([SpellDealsDistributedDamage({{~Spell}}), CreateTriggerUntil(WhenACreatureOrPlaneswalkerDies(And([IsCardtype(Creature), WasDealtDamageThisWay])), ActionList([Populate]), UntilEndOfTurn)]))",
    "{{~Spell}} deals X damage divided as you choose among any number of targets": "TargetedDistributed([UptoNumberAnyTargets({{X}})], DistributeNumberAmongTargets({{X}}), ActionList([SpellDealsDistributedDamage({{~Spell}})]))",
    "{{~Spell}} deals X damage divided as you choose among any number of targets. Tap each creature dealt damage this way. Players dealt damage this way can't cast {{PotentialSpells}} this turn": "TargetedDistributed([UptoNumberAnyTargets({{X}})], DistributeNumberAmongTargets({{X}}), ActionList([SpellDealsDistributedDamage({{~Spell}}), TapEachPermanent(And([IsCardtype(Creature), WasDealtDamageThisWay])), CreateEachPlayerEffectUntil(WasDealtDamageThisWay, [CantCastSpells({{PotentialSpells[0]}})], UntilEndOfTurn)]))",
    "{{~Spell}} deals X damage divided as you choose among up to {{Number}} target {{CreaturesOrPlaneswalkers}}. If X is {{Digits}} or more, {{~Spell}} deals twice X damage divided as you choose among them instead": "TargetedDistributed([UptoNumberTargetPermanents({{Number[0]}}, {{CreaturesOrPlaneswalkers[0]}})], IfElse(SpellXIs(GreaterThanOrEqualTo({{Digits[0]}})), DistributeNumberAmongTargets(Twice({{X}})), DistributeNumberAmongTargets({{X}})), ActionList([SpellDealsDistributedDamage({{~Spell}})]))",
    "{{~Spell}} deals X damage divided evenly, rounded down, among all creatures target opponent controls": "Targeted([TargetPlayer(Opponent)], ActionList([SpellDealsDamageDividedAmongRecipientsRoundedDown({{~Spell}}, {{X}}, EachPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))])))]))",
    "{{~Spell}} deals X damage divided evenly, rounded down, among any number of targets": "Targeted([AnyNumberOfAnyTargets], ActionList([SpellDealsDamageDividedAmongRecipientsRoundedDown({{~Spell}}, {{X}}, Ref_AnyTargets)]))",
    "{{~Spell}} deals X damage to any target": "Targeted([AnyTarget], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, Ref_AnyTarget)]))",
    "{{~Spell}} deals X damage to any target and you gain X life": "Targeted([AnyTarget], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, Ref_AnyTarget), GainLife({{X}})]))",
    "{{~Spell}} deals X damage to any target.\nCreate {{a}} {{PT}} {{CreatureToken}} with \"{{TokenQuotedAbility}}\"": "Targeted([AnyTarget], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, Ref_AnyTarget), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{TokenQuotedAbility[0]}}])])]))",
    "{{~Spell}} deals X damage to any target.\nThe next {{Spell}} you cast costs {{CostReduceX}} less to cast": "Targeted([AnyTarget], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, Ref_AnyTarget), CreateFutureSpellEffect(TheNextSpellPlayerCasts({{Spell[0]}}, You), [DecreaseManaCostX({{CostReduceX[0]}}, {{X}})])]))",
    "{{~Spell}} deals X damage to any target.\n{{AbilityWord}} - {{~Spell}} deals X plus {{Digits}} damage instead if {{Condition}}": "Targeted([AnyTarget], ActionList([IfElse({{Condition[0]}}, [SpellDealsDamage({{~Spell}}, Plus({{X}}, {{Digits[0]}}), Ref_AnyTarget)], [SpellDealsDamage({{~Spell}}, {{X}}, Ref_AnyTarget)])]))",
    "{{~Spell}} deals X damage to any target. Clash with an opponent. If you win, return {{~Spell}} to its owner's hand": "Targeted([AnyTarget], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, Ref_AnyTarget), Clash(Opponent, [ReturnSpellToOwnersHand({{~Spell}})], [DoNothing])]))",
    "{{~Spell}} deals X damage to any target. Draw {{Number}} cards, then discard a card": "Targeted([AnyTarget], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, Ref_AnyTarget), DrawNumberCards({{Number[0]}}), DiscardACard]))",
    "{{~Spell}} deals X damage to any target. If a creature dealt damage this way would die this turn, exile it instead. Shuffle {{~Spell}} into its owner's library": "Targeted([AnyTarget], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, Ref_AnyTarget), CreateReplaceWouldPutIntoGraveyardUntil(APermanentWouldDie(And([IsCardtype(Creature), WasDealtDamageThisWay])), [ExileItInstead], UntilEndOfTurn), ShuffleSpellIntoLibrary({{~Spell}})]))",
    "{{~Spell}} deals X damage to any target. If a creature is dealt damage this way, it loses {{CheckHasable}} until end of turn. If that creature would die this turn, exile it instead": "Targeted([AnyTarget], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, Ref_AnyTarget), CreateEachPermanentLayerEffectUntil(And([IsCardtype(Creature), WasDealtDamageThisWay]), [LosesAbility({{CheckHasable[0]}})], UntilEndOfTurn), CreateReplaceWouldPutIntoGraveyardUntil(APermanentWouldDie(And([IsCardtype(Creature), WasDealtDamageThisWay])), [ExileItInstead], UntilEndOfTurn)]))",
    "{{~Spell}} deals X damage to any target. If it's a creature, it can't be regenerated this turn, and if it would die this turn, exile it instead": "Targeted([AnyTarget], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, Ref_AnyTarget), If(PermanentPassesFilter(AnyTargetAsAPermanent, IsCardtype(Creature)), [CreatePermanentRuleEffectUntil(AnyTargetAsAPermanent, [CantBeRegenerated], UntilEndOfTurn), CreateReplaceWouldPutIntoGraveyardUntil(APermanentWouldDie(SinglePermanent(AnyTargetAsAPermanent)), [ExileItInstead], UntilEndOfTurn)])]))",
    "{{~Spell}} deals X damage to any target. If {{~Spell}} would deal damage to a creature, that damage can't be prevented or dealt instead to another permanent or player": "Targeted([AnyTarget], ActionList([CreateSpellEffect({{~Spell}}, [DamageToPermanentsCantBePreventedOrRedirected(IsCardtype(Creature))]), SpellDealsDamage({{~Spell}}, {{X}}, Ref_AnyTarget)]))",
    "{{~Spell}} deals X damage to any target. It deals X plus {{Digits}} damage instead if that target is {{a}} {{CreatureOrPlaneswalker}}": "Targeted([AnyTarget], ActionList([IfElse(PermanentPassesFilter(AnyTargetAsAPermanent, {{CreatureOrPlaneswalker[0]}}), [SpellDealsDamage({{~Spell}}, Plus({{X}}, {{Digits[0]}}), Ref_AnyTarget)], [SpellDealsDamage({{~Spell}}, {{X}}, Ref_AnyTarget)])]))",
    "{{~Spell}} deals X damage to any target. Put up to X {{SpecificCards}} from your hand and/or graveyard onto the battlefield tapped": "Targeted([AnyTarget], ActionList([SpellDealsDamage({{~Spell}}, ValueX, Ref_AnyTarget), PutUptoNumberCardsFromHandAndOrGraveyardOnBattlefield(ValueX, {{SpecificCards[0]}}, You, [EntersTapped])]))",
    "{{~Spell}} deals X damage to any target. Target player draws X cards": "Targeted([AnyTarget, TargetPlayer(AnyPlayer)], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, Ref_AnyTarget), PlayerAction(Ref_TargetPlayer, DrawNumberCards({{X}}))]))",
    "{{~Spell}} deals X damage to any target. You gain X life": "Targeted([AnyTarget], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, Ref_AnyTarget), GainLife({{X}})]))",
    "{{~Spell}} deals X damage to any target. You gain life equal to the damage dealt, but not more life than the player's life total before the damage was dealt, the planeswalker's loyalty before the damage was dealt, or the creature's toughness": "Targeted([AnyTarget], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, Ref_AnyTarget), GainLife(TheClampedAmountOfDamageDealtThisWay)]))",
    "{{~Spell}} deals X damage to any target. You gain life equal to the damage dealt, but not more than the amount of {{ManaCostSymbol}} spent on X, the player's life total before the damage was dealt, the planeswalker's loyalty before the damage was dealt, or the creature's toughness": "Targeted([AnyTarget], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, Ref_AnyTarget), GainLife(MinimumOf(TheClampedAmountOfDamageDealtThisWay, TheAmountOfColorManaSpentOnX({{ManaCostSymbol[0]}})))]))",
    "{{~Spell}} deals X damage to any target. You may cast a spell with mana value X or less from your hand without paying its mana cost": "Targeted([AnyTarget], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, Ref_AnyTarget), MayAction(CastASpellFromHandWithoutPaying(ManaValueIs(LessThanOrEqualTo({{X}}))))]))",
    "{{~Spell}} deals X damage to each of X targets": "Targeted([NumberAnyTargets({{X}})], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, Ref_AnyTargets)]))",
    "{{~Spell}} deals X damage to each of up to {{Number}} targets": "Targeted([UptoNumberAnyTargets({{Number[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, Ref_AnyTargets)]))",
    "{{~Spell}} deals X damage to each opponent and each creature they control": "ActionList([SpellDealsDamage({{~Spell}}, {{X}}, MultipleRecipients([EachPlayer(Opponent), EachPermanent(And([IsCardtype(Creature), ControlledByAPlayer(Opponent)]))]))])",
    "{{~Spell}} deals X damage to each {{Creature}}": "ActionList([SpellDealsDamage({{~Spell}}, {{X}}, EachPermanent({{Creature[0]}}))])",
    "{{~Spell}} deals X damage to each {{Creature}} and each player": "ActionList([SpellDealsDamage({{~Spell}}, {{X}}, MultipleRecipients([EachPermanent({{Creature[0]}}), EachPlayer(AnyPlayer)]))])",
    "{{~Spell}} deals X damage to each {{Creature}} and each {{Planeswalker}}": "ActionList([SpellDealsDamage({{~Spell}}, {{X}}, EachPermanent(Or([{{Creature[0]}}, {{Planeswalker[0]}}])))])",
    "{{~Spell}} deals X damage to each {{Creature}} and {{Digits}} additional damage to each {{Creature}}": "ActionList([SpellDealsMultipleDamage({{~Spell}}, [DamageToRecipients({{X}}, EachPermanent({{Creature[0]}})), DamageToRecipients({{Digits[0]}}, EachPermanent({{Creature[1]}}))])])",
    "{{~Spell}} deals X damage to each {{Creature}}. For each mana from {{a}} {{Swamp}} spent to cast this spell, create a tapped Treasure token": "ActionList([SpellDealsDamage({{~Spell}}, {{X}}, EachPermanent({{Creature[0]}})), CreateTokensWithFlags([NumberTokens(TheAmountOfManaFromPermanentsSpentToCastSpell(IsLandType({{Swamp[0]}}), ThisSpell), TreasureToken)], [EntersTapped])])",
    "{{~Spell}} deals X damage to each {{Creature}}. If X is {{Digits}} or more, destroy all {{Permanents}}. If X is {{Digits}} or more, create {{a}} {{PT}} {{CreatureToken}}": "ActionList([SpellDealsDamage({{~Spell}}, {{X}}, EachPermanent({{Creature[0]}})), If(SpellXIs(GreaterThanOrEqualTo({{Digits[0]}})), [DestroyEachPermanent({{Permanents[0]}})]), If(SpellXIs(GreaterThanOrEqualTo({{Digits[1]}})), [CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])])])",
    "{{~Spell}} deals X damage to target opponent or planeswalker. That player or that planeswalker's controller discards X cards": "Targeted([TargetPlayerOrPermanent(Opponent, IsCardtype(Planeswalker))], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, Ref_TargetPlayerOrPermanent), PlayerAction(PlayerOrControllerOfPermanent(Ref_TargetPlayerOrPermanent), DiscardNumberCards({{X}}))]))",
    "{{~Spell}} deals X damage to target player or planeswalker": "Targeted([TargetPlayerOrPermanent(AnyPlayer, IsCardtype(Planeswalker))], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, Ref_TargetPlayerOrPermanent)]))",
    "{{~Spell}} deals X damage to target player or planeswalker and each creature that player or that planeswalker's controller controls": "Targeted([TargetPlayerOrPermanent(AnyPlayer, IsCardtype(Planeswalker))], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, MultipleRecipients([Ref_TargetPlayerOrPermanent, EachPermanent(And([IsCardtype(Creature), ControlledByPlayer(PlayerOrControllerOfPermanent(Ref_TargetPlayerOrPermanent))]))]))]))",
    "{{~Spell}} deals X damage to target player or planeswalker. That player or that planeswalker's controller may choose a creature they control and have {{~Spell}} deal that damage to it instead": "Targeted([TargetPlayerOrPermanent(AnyPlayer, IsCardtype(Planeswalker))], ActionList([PlayerMayCost(PlayerOrControllerOfPermanent(Ref_TargetPlayerOrPermanent), ChooseAPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(ActionPlayer))]))), IfElse(CostWasPaid, [SpellDealsDamage({{~Spell}}, {{X}}, Permanent(ThePermanentChosenThisWay))], [SpellDealsDamage({{~Spell}}, {{X}}, Ref_TargetPlayerOrPermanent)])]))",
    "{{~Spell}} deals X damage to target {{CreatureOrPlaneswalker}}": "Targeted([TargetPermanent({{CreatureOrPlaneswalker[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, Permanent(Ref_TargetPermanent))]))",
    "{{~Spell}} deals X damage to target {{CreatureOrPlaneswalker}} and you gain X life": "Targeted([TargetPermanent({{CreatureOrPlaneswalker[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, Permanent(Ref_TargetPermanent)), GainLife({{X}})]))",
    "{{~Spell}} deals X damage to target {{CreatureOrPlaneswalker}}. If you controlled {{a}} {{Permanent}} as you cast this spell, it deals X plus {{Digits}} damage instead": "Modal_IfElse(PlayerPassesFilter(You, ControlsA({{Permanent[0]}})), Targeted([TargetPermanent({{CreatureOrPlaneswalker[0]}})], ActionList([SpellDealsDamage({{~Spell}}, Plus({{X}}, {{Digits[0]}}), Permanent(Ref_TargetPermanent))])), Targeted([TargetPermanent({{CreatureOrPlaneswalker[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, Permanent(Ref_TargetPermanent))])))",
    "{{~Spell}} deals X damage to target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, Permanent(Ref_TargetPermanent))]))",
    "{{~Spell}} deals X damage to target {{Creature}} and each other creature that shares a color with it. You gain life equal to the damage dealt this way": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, MultipleRecipients([Permanent(Ref_TargetPermanent), EachPermanent(And([Other(Ref_TargetPermanent), IsCardtype(Creature), SharesAColorWithPermanent(Ref_TargetPermanent)]))])), GainLife(TheAmountOfDamageDealtThisWay)]))",
    "{{~Spell}} deals X damage to target {{Creature}} and you gain X life": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, Permanent(Ref_TargetPermanent)), GainLife({{X}})]))",
    "{{~Spell}} deals X damage to target {{Creature}}.\n{{AbilityWord}} - If {{Condition}}, {{~Spell}} also deals X damage to that creature's controller": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, Permanent(Ref_TargetPermanent)), If({{Condition[0]}}, [SpellDealsDamage({{~Spell}}, {{X}}, Player(ControllerOfPermanent(Ref_TargetPermanent)))])]))",
    "{{~Spell}} deals X damage to target {{Creature}}. Create a number of tapped Treasure tokens equal to the amount of excess damage dealt to that creature this way": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, Permanent(Ref_TargetPermanent)), CreateTokensWithFlags([NumberTokens(AmountOfExcessDamageDealtToPermanentsThisWay(SinglePermanent(Ref_TargetPermanent)), TreasureToken)], [EntersTapped])]))",
    "{{~Spell}} deals X damage to target {{Creature}}. Create a number of {{PT}} {{CreatureTokens}} equal to the amount of excess damage dealt to that creature this way": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, Permanent(Ref_TargetPermanent)), CreateTokens([NumberTokens(AmountOfExcessDamageDealtThisWay, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])]))",
    "{{~Spell}} deals X damage to target {{Creature}}. If X is {{Digits}} or more, scry {{Digits}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, Permanent(Ref_TargetPermanent)), If(SpellXIs(GreaterThanOrEqualTo({{Digits[0]}})), [Scry({{Digits[1]}})])]))",
    "{{~Spell}} deals X damage to target {{Creature}}. When that creature dies this turn, exile a number of cards from the top of your library equal to its power, then choose a card exiled this way. Until the end of your next turn, you may play that card": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, Permanent(Ref_TargetPermanent)), CreateTriggerUntil(WhenACreatureOrPlaneswalkerDies(SinglePermanent(Ref_TargetPermanent)), ActionList([Exile([TheTopNumberCardsOfPlayersLibrary(PowerOfPermanent(Trigger_ThatPermanent), You)]), ChooseAnExiledCard(TheCardsExiledThisWay), CreatePlayerEffectUntil(You, [MayPlayExiledCard(TheExiledCardChosenThisWay)], UntilTheEndOfPlayersNextTurn(You))]), UntilEndOfTurn)]))",
    "{{~Spell}} deals X plus {{Digits}} damage divided as you choose among any number of targets": "TargetedDistributed([UptoNumberAnyTargets(Plus({{X}}, {{Digits[0]}}))], DistributeNumberAmongTargets(Plus({{X}}, {{Digits[0]}})), ActionList([SpellDealsDistributedDamage({{~Spell}})]))",
    "{{~Spell}} deals X plus {{Digits}} damage to each {{Creature}}": "ActionList([SpellDealsDamage({{~Spell}}, Plus({{X}}, {{Digits[0]}}), EachPermanent({{Creature[0]}}))])",
    "{{~Spell}} deals twice X damage to each {{Creature}}": "ActionList([SpellDealsDamage({{~Spell}}, Twice({{X}}), EachPermanent({{Creature[0]}}))])",
    "{{~Spell}} deals twice X damage to target creature. If excess damage was dealt to that creature this way, investigate": "Targeted([TargetPermanent(IsCardtype(Creature))], ActionList([SpellDealsDamage({{~Spell}}, Twice({{X}}), Permanent(Ref_TargetPermanent)), If(ExcessDamageWasDealtToAPermanentThisWay(SinglePermanent(Ref_TargetPermanent)), [Investigate])]))",
    "{{~Spell}} deals twice X damage to target {{CreatureOrPlaneswalker}}": "Targeted([TargetPermanent({{CreatureOrPlaneswalker[0]}})], ActionList([SpellDealsDamage({{~Spell}}, Twice({{X}}), Permanent(Ref_TargetPermanent))]))",
    "{{~Spell}} deals {{Digits}} damage divided as you choose among X target {{CreaturesOrPlaneswalkers}}": "TargetedDistributed([NumberTargetPermanents({{X}}, {{CreaturesOrPlaneswalkers[0]}})], DistributeNumberAmongTargets({{Digits[0]}}), ActionList([SpellDealsDistributedDamage({{~Spell}})]))",
    "{{~Spell}} deals {{Digits}} damage to each of X targets": "Targeted([NumberAnyTargets({{X}})], ActionList([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Ref_AnyTargets)]))",
    "{{~Spell}} deals {{Number}} times X damage to each of up to X targets": "Targeted([UptoNumberAnyTargets({{X}})], ActionList([SpellDealsDamage({{~Spell}}, Multiply({{Number[0]}}, {{X}}), Ref_AnyTargets)]))"
  },
  "{{SpellActions[Bargain](~Spell)}}": {
    "{{~Spell}} deals {{Digits}} damage to target {{CreatureOrPlaneswalker}}. If this spell was bargained, instead it deals {{Digits}} damage to that permanent and you scry {{Digits}}.\nIf a permanent dealt damage by {{~Spell}} would die this turn, exile it instead": "Targeted([TargetPermanent({{CreatureOrPlaneswalker[0]}})], ActionList([IfElse(SpellPassesFilter(ThisSpell, WasBargained), [SpellDealsDamage({{~Spell}}, {{Digits[1]}}, Permanent(Ref_TargetPermanent)), Scry({{Digits[2]}})], [SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent))]), CreateReplaceWouldPutIntoGraveyardUntil(APermanentWouldDie(And([IsPermanent, WasDealtDamageByThisSpell])), [ExileItInstead], UntilEndOfTurn)]))",
    "{{~Spell}} deals {{Digits}} damage to target {{Creature}}. If this spell was bargained, destroy that creature instead": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([IfElse(SpellPassesFilter(ThisSpell, WasBargained), [DestroyPermanent(Ref_TargetPermanent)], [SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent))])]))"
  },
  "{{SpellActions[Bargain](~Spell,X)}}": {
    "{{~Spell}} deals X damage to target {{CreatureOrPlaneswalker}}. If this spell was bargained, it deals twice X damage to that permanent instead": "Targeted([TargetPermanent({{CreatureOrPlaneswalker[0]}})], ActionList([IfElse(SpellPassesFilter(ThisSpell, WasBargained), [SpellDealsDamage({{~Spell}}, Twice({{X}}), Permanent(Ref_TargetPermanent))], [SpellDealsDamage({{~Spell}}, {{X}}, Permanent(Ref_TargetPermanent))])]))"
  },
  "{{SpellActions[Bargain]}}": {
    "If this spell was bargained, look at the top {{Number}} cards of your library, then put up to {{Number}} of them back on top of your library in any order and the rest into your graveyard.\nYou draw {{Number}} cards and you lose {{Digits}} life": "ActionList([If(SpellPassesFilter(ThisSpell, WasBargained), [LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [PutUptoNumberGenericCardsOnTopOfLibraryInAnyOrder({{Number[1]}}), PutTheRemainingCardsIntoGraveyard])]), DrawNumberCards({{Number[2]}}), LoseLife({{Digits[0]}})])",
    "If this spell was bargained, target {{Land}} becomes {{a}} {{PT}} {{Zombie}} creature with {{Hasable}} that's still a land.\nSearch your library for {{a}} {{SpecificCard}}, reveal it, put it into your hand, then shuffle": "Targeted([TargetPermanent({{Land[0]}})], ActionList([If(SpellPassesFilter(ThisSpell, WasBargained), [CreatePermanentLayerEffect(Ref_TargetPermanent, [SetPT({{PT[0]}}), AddCreatureType({{Zombie[0]}}), AddCardtype(Creature), AddAbility([{{Hasable[0]}}])])]), SearchLibrary([FindACardOfType({{SpecificCard[0]}}), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])]))",
    "Look at the top {{Number}} cards of your library. If this spell was bargained, look at the top {{Number}} cards of your library instead. Put {{Number}} of them into your hand and the rest on the bottom of your library in a random order": "ActionList([IfElse(SpellPassesFilter(ThisSpell, WasBargained), [LookAtTheTopNumberCardsOfLibrary({{Number[1]}}, [PutNumberGenericCardsIntoHand({{Number[2]}}), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])], [LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [PutNumberGenericCardsIntoHand({{Number[2]}}), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])])",
    "Look at the top {{Number}} cards of your library. You may reveal up to {{Number}} {{SpecificCards}} from among them. If this spell was bargained, put the revealed cards onto the battlefield. Otherwise, put the revealed cards into your hand. Then shuffle": "ActionList([IfElse(SpellPassesFilter(ThisSpell, WasBargained), [LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [MayPutUptoNumberCardsOntoTheBattlefield({{Number[1]}}, {{SpecificCards[0]}}, [EntersNormally]), PutTheRemainingCardsBackIntoLibraryAndShuffle])], [LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [MayRevealUptoNumberCardsOfTypeAndPutIntoHand({{Number[1]}}, {{SpecificCards[0]}}), PutTheRemainingCardsBackIntoLibraryAndShuffle])])])",
    "Return up to {{Number}} target {{SpecificCards}} from your graveyard to your hand. If this spell was bargained, you may put one of those cards with mana value {{Digits}} or less onto the battlefield instead of putting it into your hand": "Targeted([UptoNumberTargetGraveyardCards({{Number[0]}}, And([{{SpecificCards[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([If(SpellPassesFilter(ThisSpell, WasBargained), [MayAction(PutAGraveyardCardOntoBattlefield(Ref_TargetGraveyardCards, [EntersNormally]))]), PutEachGraveyardCardIntoHand(Ref_TargetGraveyardCards)]))",
    "Search your library for a card, exile it face down, then shuffle. If this spell was bargained, you may cast the exiled card without paying its mana cost if that spell's mana value is {{Digits}} or less. Put the exiled card into your hand if it wasn't cast this way": "ActionList([SearchLibrary([FindAGenericCard, ExileFoundCardsFaceDown, Shuffle]), If(SpellPassesFilter(ThisSpell, WasBargained), [MayAction(CastSpellFromExileWithoutPaying(ManaValueIs(LessThanOrEqualTo({{Digits[0]}})), TheCardExiledThisWay))]), PutExiledCardIntoOwnersHand(TheCardExiledThisWay)])",
    "Target {{Creature}} gets {{PTMod}} until end of turn. If this spell was bargained, that creature also gains {{Hasable}} and {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), If(SpellPassesFilter(ThisSpell, WasBargained), [CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)])]))",
    "Target {{Creature}} gets {{PTMod}} until end of turn. If this spell was bargained, that creature gets {{PTMod}} until end of turn instead": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([IfElse(SpellPassesFilter(ThisSpell, WasBargained), [CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[1]}})], UntilEndOfTurn)], [CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])]))"
  },
  "{{SpellActions[Cleave](~Spell)}}": {
    "Take an extra turn after this one. During that turn, damage can't be prevented. [At the beginning of that turn's end step, you lose the game].\nExile {{~Spell}}": "CleavePaid(ActionList([TakeAnExtraTurn, CreateGameEffect(DuringTheExtraTurnCreatedThisWay, DamageCantBePrevented), ExileSpell({{~Spell}})])), CleaveNotPaid(ActionList([TakeAnExtraTurn, CreateGameEffect(DuringTheExtraTurnCreatedThisWay, DamageCantBePrevented), CreateFutureTrigger(AtTheBeginningOfTheEndStepOfTheExtraTurnCreatedThisWay, ActionList([LoseTheGame])), ExileSpell({{~Spell}})]))",
    "{{~Spell}} deals {{Digits}} damage to target [{{Zombie}}] creature. You gain {{Digits}} life": "CleavePaid(Targeted([TargetPermanent(IsCardtype(Creature))], ActionList([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent)), GainLife({{Digits[1]}})]))), CleaveNotPaid(Targeted([TargetPermanent(And([IsCreatureType({{Zombie[0]}}), IsCardtype(Creature)]))], ActionList([SpellDealsDamage({{~Spell}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent)), GainLife({{Digits[1]}})])))"
  },
  "{{SpellActions[Cleave](~Spell,X)}}": {
    "{{~Spell}} deals X damage to target {{CreatureOrPlaneswalker}} and you gain X life. [X is {{GameNumber}}]": "CleavePaid(Targeted([TargetPermanent({{CreatureOrPlaneswalker[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{X}}, Permanent(Ref_TargetPermanent))]))), CleaveNotPaid(Targeted([TargetPermanent({{CreatureOrPlaneswalker[0]}})], ActionList([SpellDealsDamage({{~Spell}}, {{GameNumber[0]}}, Permanent(Ref_TargetPermanent))])))"
  },
  "{{SpellActions[Cleave]}}": {
    "Counter target spell [that wasn't cast from its owner's hand]": "CleavePaid(Targeted([TargetSpell(AnySpell)], ActionList([CounterSpell(Ref_TargetSpell)]))), CleaveNotPaid(Targeted([TargetSpell(WasntCastFromTheirHand)], ActionList([CounterSpell(Ref_TargetSpell)])))",
    "Destroy all creatures [with mana value {{Digits}} or less]": "CleavePaid(ActionList([DestroyEachPermanent(IsCardtype(Creature))])), CleaveNotPaid(ActionList([DestroyEachPermanent(And([IsCardtype(Creature), ManaValueIs(LessThanOrEqualTo({{Digits[0]}}))]))]))",
    "Destroy target [attacking] creature": "CleavePaid(Targeted([TargetPermanent(IsCardtype(Creature))], ActionList([DestroyPermanent(Ref_TargetPermanent)]))), CleaveNotPaid(Targeted([TargetPermanent(And([IsAttacking, IsCardtype(Creature)]))], ActionList([DestroyPermanent(Ref_TargetPermanent)])))",
    "Draw a card for each creature you control [with {{CheckHasable}}]": "CleavePaid(ActionList([DrawNumberCards(TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))])))])), CleaveNotPaid(ActionList([DrawNumberCards(TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Creature), HasAbility({{CheckHasable[0]}}), ControlledByAPlayer(SinglePlayer(You))])))]))",
    "Draw {{Number}} cards. [Your maximum hand size is reduced by {{Number}} for the rest of the game]": "CleavePaid(ActionList([DrawNumberCards({{Number[0]}})])), CleaveNotPaid(ActionList([DrawNumberCards({{Number[0]}}), CreatePlayerEffect(You, [ReduceMaximumHandSize({{Number[0]}})])]))",
    "Return target [{{Zombie}} or {{Zombie}}] creature to its owner's hand": "CleavePaid(Targeted([TargetPermanent(IsCardtype(Creature))], ActionList([PutPermanentIntoItsOwnersHand(Ref_TargetPermanent)]))), CleaveNotPaid(Targeted([TargetPermanent(And([Or([IsCreatureType({{Zombie[0]}}), IsCreatureType({{Zombie[1]}})]), IsCardtype(Creature)]))], ActionList([PutPermanentIntoItsOwnersHand(Ref_TargetPermanent)])))",
    "Return target nonland permanent [you control] to its owner's hand": "CleavePaid(Targeted([TargetPermanent(IsNonCardtype(Land))], ActionList([PutPermanentIntoItsOwnersHand(Ref_TargetPermanent)]))), CleaveNotPaid(Targeted([TargetPermanent(And([IsNonCardtype(Land), ControlledByAPlayer(SinglePlayer(You))]))], ActionList([PutPermanentIntoItsOwnersHand(Ref_TargetPermanent)])))",
    "Search your library for a [basic land] card, [reveal it,] put it into your hand, then shuffle": "CleavePaid(ActionList([SearchLibrary([FindAGenericCard, PutFoundCardsIntoHand, Shuffle])])), CleaveNotPaid(ActionList([SearchLibrary([FindACardOfType(And([IsSupertype(Basic), IsCardtype(Land)])), RevealFoundCards, PutFoundCardsIntoHand, Shuffle])]))",
    "Target player reveals their hand. You choose a nonland card from it [with mana value {{Digits}} or less]. That player discards that card": "CleavePaid(Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, RevealHand), ChooseACardFromPlayersRevealedHand(IsNonCardtype(Land), Ref_TargetPlayer), PlayerAction(Ref_TargetPlayer, DiscardCard(TheCardChosenThisWay))]))), CleaveNotPaid(Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, RevealHand), ChooseACardFromPlayersRevealedHand(And([IsNonCardtype(Land), ManaValueIs(LessThanOrEqualTo({{Digits[0]}}))]), Ref_TargetPlayer), PlayerAction(Ref_TargetPlayer, DiscardCard(TheCardChosenThisWay))])))"
  },
  "{{SpellActions[Condition](X)}}": {
    "Create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}} and {{Hasable}}. If this spell was foretold, create X of those tokens instead": "ActionList([IfElse(SpellPassesFilter(ThisSpell, WasForetold), [CreateTokens([NumberTokens({{X}}, TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}, {{Hasable[1]}}]))])], [CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}, {{Hasable[1]}}])])])])",
    "Target player mills X cards. If this spell was cast from a graveyard, that player mills twice that many cards instead": "Targeted([TargetPlayer(AnyPlayer)], ActionList([IfElse(CastSpellPassesFilter(WasCastFromAPlayersGraveyard(AnyPlayer)), [MillNumberCards(Twice({{X}}))], [MillNumberCards({{X}})])]))",
