  "{{Eachable(ThatPlayer)}}": {
    "artifact that player controls": "TheNumberOfPermanentsOnTheBattlefield(And([IsCardtype(Artifact), ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))",
