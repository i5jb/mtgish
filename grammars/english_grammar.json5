    "{{Number}} or more creatures are attacking": "NumPermanentsPassFilter(GreaterThanOrEqualTo({{Number[0]}}), IsCardtype(Creature), IsAttacking)",
    "{{Number}} or more creatures died this turn": "ANumberOfPermanentsDiedThisTurn(GreaterThanOrEqualTo({{Number[0]}}), IsCardtype(Creature))",
    "{{Number}} or more creatures died under your control this turn": "ANumberOfPermanentsDiedThisTurn(GreaterThanOrEqualTo({{Number[0]}}), And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))",
