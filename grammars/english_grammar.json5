      "TriggerA(If(IsPlayersTurn(You), WhenAPermanentBecomesTappedForTheFirstTimeEachTurn({{Permanent[0]}})), ActionList([UntapPermanent(Trigger_ThatPermanent)]))",
    "Whenever {{a}} {{Permanent}} becomes the target of a spell or ability an opponent controls, {{TriggerActions(ThatPermanent)}}": "TriggerA(WhenAPermanentBecomesTheTargetOfASpellOrAbility({{Permanent[0]}}, ControlledByAPlayer(Opponent)), {{TriggerActions(ThatPermanent=Trigger_ThatPermanent)[0]}})",
    "Whenever {{a}} {{Permanent}} becomes the target of a spell or ability an opponent controls, {{TriggerActions(ThatPlayer)}}": "TriggerA(WhenAPermanentBecomesTheTargetOfASpellOrAbility({{Permanent[0]}}, ControlledByAPlayer(Opponent)), {{TriggerActions(ThatPlayer=Trigger_ControllerOfThatSpellOrAbility)[0]}})",
    "Whenever {{a}} {{Permanent}} becomes the target of a spell or ability an opponent controls, {{TriggerActions(ThatSpellOrAbility)}}": "TriggerA(WhenAPermanentBecomesTheTargetOfASpellOrAbility({{Permanent[0]}}, ControlledByAPlayer(Opponent)), {{TriggerActions(ThatSpellOrAbility=Trigger_ThatSpellOrAbility)[0]}})",
    "Whenever {{a}} {{Permanent}} becomes the target of a spell or ability an opponent controls, {{TriggerActions}}": "TriggerA(WhenAPermanentBecomesTheTargetOfASpellOrAbility({{Permanent[0]}}, ControlledByAPlayer(Opponent)), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Permanent}} becomes the target of a spell or ability, {{TriggerActions(ThatPermanent)}}": "TriggerA(WhenAPermanentBecomesTheTargetOfASpellOrAbility({{Permanent[0]}}, AnySpellOrAbility), {{TriggerActions(ThatPermanent=Trigger_ThatPermanent)[0]}})",
    "Whenever {{a}} {{Permanent}} becomes the target of {{a}} {{Spell}}, {{TriggerActions}}": "TriggerA(WhenAPermanentBecomesTheTargetOfASpell({{Permanent[0]}}, {{Spell[0]}}), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Permanent}} becomes untapped, {{TriggerActions(ThatPermanent)}}": "TriggerA(WhenAPermanentBecomesUntapped({{Permanent[0]}}), {{TriggerActions(ThatPermanent=Trigger_ThatPermanent)[0]}})",
    "Whenever {{a}} {{Permanent}} deals damage to one or more players for the first time each turn, {{TriggerActions(ThatPermanent)}}": "TriggerA(WhenAPermanentDealsDamageToAnyNumberOfPlayersForTheFirstTimeEachTurn({{Permanent[0]}}, AnyPlayer), {{TriggerActions(ThatPermanent=Trigger_ThatPermanent)[0]}})",
    "Whenever {{a}} {{Permanent}} deals damage to you, {{TriggerActions(ThatPermanent)}}": "TriggerA(WhenAPermanentDealsDamageToAPlayer({{Permanent[0]}}, SinglePlayer(You)), {{TriggerActions(ThatPermanent=Trigger_ThatPermanent)[0]}})",
    "Whenever {{a}} {{Permanent}} deals damage, {{TriggerActions(ThatPermanent,ThatMuch)}}": "TriggerA(WhenAPermanentDealsDamage({{Permanent[0]}}), {{TriggerActions(ThatPermanent=Trigger_ThatPermanent,ThatMuch=Trigger_AmountOfDamageDealt)[0]}})",
    "Whenever {{a}} {{Permanent}} dies, you may put that card onto the battlefield under your control. Do this only once each turn": "TriggerMayOnceEachTurn(WhenACreatureOrPlaneswalkerDies({{Permanent[0]}}), ActionList([PutGraveyardCardOntoBattlefield(Trigger_ThatGraveyardCard, [EntersUnderPlayersControl(You)])]))",
    "Whenever {{a}} {{Permanent}} entering causes a triggered ability to trigger, {{TriggerActions(ThatTriggeredAbility)}}": "TriggerA(WhenAPermanentEnteringTheBattlefieldCausesAnAbilityToTrigger({{Permanent[0]}}), {{TriggerActions(ThatTriggeredAbility=Trigger_ThatTriggeredAbility)[0]}})",
    "Whenever {{a}} {{Permanent}} enters and whenever you fully unlock a Room, {{TriggerActions}}": "TriggerA(Or([WhenAPermanentEntersTheBattlefield({{Permanent[0]}}), WhenAPlayerFullyUnlocksARoom(SinglePlayer(You), IsEnchantmentType(Room))]), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Permanent}} enters during combat, {{TriggerActions}}": "TriggerA(If(IsDuringCombat, WhenAPermanentEntersTheBattlefield({{Permanent[0]}})), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Permanent}} enters from anywhere other than your hand or you cast {{a}} {{Spell}} from anywhere other than your hand, {{TriggerActions}}": "TriggerA(Or([WhenAPermanentEntersTheBattlefieldFromAnywhereOtherThanTheirHand({{Permanent[0]}}), WhenAPlayerCastsASpell(SinglePlayer(You), And([{{Spell[0]}}, WasntCastFromTheirHand]))]), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Permanent}} enters or is turned face up, {{TriggerActions(ThatPermanent)}}": "TriggerA(Or([WhenAPermanentEntersTheBattlefield({{Permanent[0]}}), WhenAPermanentIsTurnedFaceUp({{Permanent[0]}})]), {{TriggerActions(ThatPermanent=Trigger_ThatPermanent)[0]}})",
    "Whenever {{a}} {{Permanent}} enters tapped, {{TriggerActions(ThatPermanent)}}": "TriggerA(WhenAPermanentEntersTheBattlefieldTapped({{Permanent[0]}}), {{TriggerActions(ThatPermanent=Trigger_ThatPermanent)[0]}})",
    "Whenever {{a}} {{Permanent}} enters the battlefield under your control, {{TriggerActions}}": "TriggerA(WhenAPermanentEntersTheBattlefieldUnderAPlayersControl({{Permanent[0]}}, SinglePlayer(You)), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Permanent}} enters under your control, if {{Condition}}, {{TriggerActions}}": "TriggerI(WhenAPermanentEntersTheBattlefieldUnderAPlayersControl({{Permanent[0]}}, SinglePlayer(You)), {{Condition[0]}}, {{TriggerActions[0]}})",
    "Whenever {{a}} {{Permanent}} enters under your control, {{TriggerActions(ThatPermanent)}}": "TriggerA(WhenAPermanentEntersTheBattlefieldUnderAPlayersControl({{Permanent[0]}}, SinglePlayer(You)), {{TriggerActions(ThatPermanent=Trigger_ThatPermanent)[0]}})",
    "Whenever {{a}} {{Permanent}} enters under your control, {{TriggerActions}}": "TriggerA(WhenAPermanentEntersTheBattlefieldUnderAPlayersControl({{Permanent[0]}}, SinglePlayer(You)), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Permanent}} enters with a counter on it, {{TriggerActions(ThatCreature)}}": "TriggerA(WhenAPermanentEntersTheBattlefieldWithAnyCounters({{Permanent[0]}}), {{TriggerActions(ThatCreature=Trigger_ThatPermanent)[0]}})",
    "Whenever {{a}} {{Permanent}} enters, if you didn't cast it from your hand, {{TriggerActions(ThatPermanent)}}": "TriggerI(WhenAPermanentEntersTheBattlefield({{Permanent[0]}}), PermanentPassesFilter(Trigger_ThatPermanent, WasntCastFromHand), {{TriggerActions(ThatPermanent=Trigger_ThatPermanent)[0]}})",
    "Whenever {{a}} {{Permanent}} enters, if {{Condition(ThatPermanent)}}, {{TriggerActions(ThatPermanent)}}": "TriggerI(WhenAPermanentEntersTheBattlefield({{Permanent[0]}}), {{Condition(ThatPermanent=Trigger_ThatPermanent)[0]}}, {{TriggerActions(ThatPermanent=Trigger_ThatPermanent)[0]}})",
    "Whenever {{a}} {{Permanent}} enters, if {{Condition(ThatPermanent)}}, {{TriggerActions}}": "TriggerI(WhenAPermanentEntersTheBattlefield({{Permanent[0]}}), {{Condition(ThatPermanent=Trigger_ThatPermanent)[0]}}, {{TriggerActions[0]}})",
    "Whenever {{a}} {{Permanent}} enters, if {{Condition[ThatEnteringPermanent]}}, {{TriggerActions(ThatPermanent)}}": "TriggerI(WhenAPermanentEntersTheBattlefield({{Permanent[0]}}), {{Condition[ThatEnteringPermanent][0]}}, {{TriggerActions(ThatPermanent=Trigger_ThatPermanent)[0]}})",
    "Whenever {{a}} {{Permanent}} enters, if {{Condition}}, {{TriggerActions}}": "TriggerI(WhenAPermanentEntersTheBattlefield({{Permanent[0]}}), {{Condition[0]}}, {{TriggerActions[0]}})",
    "Whenever {{a}} {{Permanent}} enters, you may create a token that's a copy of it. Do this only once each turn": "TriggerMayOnceEachTurn(WhenAPermanentEntersTheBattlefield({{Permanent[0]}}), ActionList([CreateTokens([TokenCopyOfPermanent(Trigger_ThatPermanent, NoTokenCopyEffects)])]))",
    "Whenever {{a}} {{Permanent}} enters, you may have target player other than its controller create a token that's a copy of it, then you draw a card if an opponent created a token this way. Do this only once each turn": "TriggerMayOnceEachTurn(WhenAPermanentEntersTheBattlefield({{Permanent[0]}}), Targeted([TargetPlayer(Other(ControllerOfPermanent(Trigger_ThatPermanent)))], ActionList([MayCost(HavePlayerTakeAction(Ref_TargetPlayer, CreateTokens([TokenCopyOfPermanent(Trigger_ThatPermanent, NoTokenCopyEffects)]))), If(CostWasPaid, [DrawACard])])))",
    "Whenever {{a}} {{Permanent}} enters, you may put {{a}} {{CounterType}} counter on each {{Permanent}}. Do this only once each turn": "TriggerMayOnceEachTurn(WhenAPermanentEntersTheBattlefield({{Permanent[0]}}), ActionList([PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, {{Permanent[1]}})]))",
    "Whenever {{a}} {{Permanent}} enters, {{TriggerActions(ThatPermanent)}}": "TriggerA(WhenAPermanentEntersTheBattlefield({{Permanent[0]}}), {{TriggerActions(ThatPermanent=Trigger_ThatPermanent)[0]}})",
    "Whenever {{a}} {{Permanent}} enters, {{TriggerActions}}": "TriggerA(WhenAPermanentEntersTheBattlefield({{Permanent[0]}}), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Permanent}} enters, {{TriggerActions}}. This ability triggers only once each turn": "TriggerOnceEachTurn(WhenAPermanentEntersTheBattlefield({{Permanent[0]}}), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Permanent}} explores {{a}} {{SpecificCard}}, {{TriggerActions}}": "TriggerA(WhenAPermanentExploresACardOfType({{Permanent[0]}}, {{SpecificCard[0]}}), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Permanent}} explores, {{TriggerActions}}": "TriggerA(WhenAPermanentExplores({{Permanent[0]}}), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Permanent}} is exiled, if it was unearthed, shuffle that card into its owner's library": "TriggerI(WhenAPermanentIsExiled({{Permanent[0]}}), ExiledPermanentWasUnearthed, ActionList([ShuffleExiledCardIntoLibrary(WhenAPermanentIsExiled_ThatExiledPermanent)]))",
    "Whenever {{a}} {{Permanent}} is put into a graveyard from the battlefield, if it had counters on it, put those counters on up to one target {{Permanent}}": "TriggerI(WhenAPermanentIsPutIntoAPlayersGraveyard({{Permanent[0]}}, AnyPlayer), PermanentPassesFilter(Trigger_ThatPermanent, HasACounter), Targeted([UptoOneTargetPermanent({{Permanent[1]}})], ActionList([PutCountersOfDeadPermanentOnPermanent(Ref_TargetPermanent)])))",
    "Whenever {{a}} {{Permanent}} is put into a graveyard from the battlefield, if {{Condition[WhenAPermanentIsPutIntoAGraveyard]}}, {{TriggerActions}}": "TriggerI(WhenAPermanentIsPutIntoAPlayersGraveyard({{Permanent[0]}}, AnyPlayer), {{Condition[WhenAPermanentIsPutIntoAGraveyard][0]}}, {{TriggerActions[0]}})",
    "Whenever {{a}} {{Permanent}} is put into a graveyard from the battlefield, {{TriggerActions[WhenAPermanentIsPutIntoAGraveyard]}}": "TriggerA(WhenAPermanentIsPutIntoAPlayersGraveyard({{Permanent[0]}}, AnyPlayer), {{TriggerActions[WhenAPermanentIsPutIntoAGraveyard][0]}})",
    "Whenever {{a}} {{Permanent}} is put into a graveyard from the battlefield, {{TriggerActions}}": "TriggerA(WhenAPermanentIsPutIntoAPlayersGraveyard({{Permanent[0]}}, AnyPlayer), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Permanent}} is put into a graveyard from the battlefield, {{TriggerActions}}. This ability triggers only once each turn": "TriggerOnceEachTurn(WhenAPermanentIsPutIntoAPlayersGraveyard({{Permanent[0]}}, AnyPlayer), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Permanent}} is put into a graveyard, {{TriggerActions}}": "TriggerA(WhenAPermanentIsPutIntoAPlayersGraveyard({{Permanent[0]}}, AnyPlayer), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Permanent}} is put into a player's graveyard from the battlefield, {{TriggerActions(ThatPlayer)}}": "TriggerA(WhenAPermanentIsPutIntoAPlayersGraveyard({{Permanent[0]}}, AnyPlayer), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "Whenever {{a}} {{Permanent}} is put into an opponent's graveyard from the battlefield, {{TriggerActions[WhenAPermanentIsPutIntoAGraveyard]}}": "TriggerA(WhenAPermanentIsPutIntoAPlayersGraveyard({{Permanent[0]}}, Opponent), {{TriggerActions[WhenAPermanentIsPutIntoAGraveyard][0]}})",
    "Whenever {{a}} {{Permanent}} is put into an opponent's graveyard from the battlefield, {{TriggerActions}}": "TriggerA(WhenAPermanentIsPutIntoAPlayersGraveyard({{Permanent[0]}}, Opponent), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Permanent}} is put into an opponent's graveyard, {{TriggerActions(ThatPlayer)}}": "TriggerA(WhenAPermanentIsPutIntoAPlayersGraveyard({{Permanent[0]}}, Opponent), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "Whenever {{a}} {{Permanent}} is put into your graveyard from the battlefield, {{TriggerActions[WhenAPermanentIsPutIntoAGraveyard]}}": "TriggerA(WhenAPermanentIsPutIntoAPlayersGraveyard({{Permanent[0]}}, SinglePlayer(You)), {{TriggerActions[WhenAPermanentIsPutIntoAGraveyard][0]}})",
    "Whenever {{a}} {{Permanent}} is put into your graveyard from the battlefield, {{TriggerActions}}": "TriggerA(WhenAPermanentIsPutIntoAPlayersGraveyard({{Permanent[0]}}, SinglePlayer(You)), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Permanent}} is returned to a player's hand, {{TriggerActions(ThatPlayer)}}": "TriggerA(WhenAPermanentIsReturnedToAPlayersHand({{Permanent[0]}}, AnyPlayer), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "Whenever {{a}} {{Permanent}} is returned to your hand, {{TriggerActions}}": "TriggerA(WhenAPermanentIsReturnedToAPlayersHand({{Permanent[0]}}, SinglePlayer(You)), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Permanent}} is tapped for mana, {{TriggerActions(ThatPermanent)}}": "TriggerA(WhenAPermanentIsTappedForMana({{Permanent[0]}}), {{TriggerActions(ThatPermanent=Trigger_ThatPermanent)[0]}})",
    "Whenever {{a}} {{Permanent}} is turned face up, if {{Condition(ThatPermanent)}}, {{TriggerActions(ThatPermanent)}}": "TriggerI(WhenAPermanentIsTurnedFaceUp({{Permanent[0]}}), {{Condition(ThatPermanent=Trigger_ThatPermanent)[0]}}, {{TriggerActions(ThatPermanent=Trigger_ThatPermanent)[0]}})",
    "Whenever {{a}} {{Permanent}} is turned face up, {{TriggerActions}}": "TriggerA(WhenAPermanentIsTurnedFaceUp({{Permanent[0]}}), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Permanent}} leaves the battlefield, create a Mutagen token for each {{CounterType}} counter on it": "TriggerA(WhenAPermanentLeavesTheBattlefield({{Permanent[0]}}), ActionList([CreateTokens([NumberTokens(NumCountersOfTypeOnPermanent({{CounterType[0]}}, Trigger_ThatPermanent), MutagenToken)])]))",
    "Whenever {{a}} {{Permanent}} leaves the battlefield, if it had counters on it, put those counters on target {{Permanent}}": "TriggerI(WhenAPermanentLeavesTheBattlefield({{Permanent[0]}}), LeavingPermanentPassesFilter(HasACounter), Targeted([TargetPermanent({{Permanent[1]}})], ActionList([PutFormerCountersOnPermanent(Ref_TargetPermanent)])))",
    "Whenever {{a}} {{Permanent}} leaves the battlefield, {{TriggerActions[LeavesTheBattlefield](ThatPermanent)}}": "TriggerA(WhenAPermanentLeavesTheBattlefield({{Permanent[0]}}), {{TriggerActions[LeavesTheBattlefield](ThatPermanent=Trigger_ThatPermanent)[0]}})",
    "Whenever {{a}} {{Permanent}} leaves the battlefield, {{TriggerActions[WhenAPermanentLeavesTheBattlefield]}}": "TriggerA(WhenAPermanentLeavesTheBattlefield({{Permanent[0]}}), {{TriggerActions[WhenAPermanentLeavesTheBattlefield][0]}})",
    "Whenever {{a}} {{Permanent}} leaves the battlefield, {{TriggerActions}}": "TriggerA(WhenAPermanentLeavesTheBattlefield({{Permanent[0]}}), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Permanent}} or {{a}} {{Spell}} becomes the target of a spell or ability an opponent controls, {{TriggerActions}}": "TriggerA(Or([WhenAPermanentBecomesTheTargetOfASpellOrAbility({{Permanent[0]}}, ControlledByAPlayer(Opponent)), WhenASpellBecomesTheTargetOfASpellOrAbility({{Spell[0]}}, ControlledByAPlayer(Opponent))]), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Permanent}} transforms into {{a}} {{Permanent}}, {{TriggerActions(ThatPermanent)}}": "TriggerA(WhenAPermanentTransformsFromIntoAPermanent({{Permanent[0]}}, {{Permanent[1]}}), {{TriggerActions(ThatPermanent=Trigger_ThatPermanent)[0]}})",
    "Whenever {{a}} {{Permanent}} transforms into {{a}} {{Permanent}}, {{TriggerActions}}": "TriggerA(WhenAPermanentTransformsFromIntoAPermanent({{Permanent[0]}}, {{Permanent[1]}}), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Permanent}} transforms or {{a}} {{Permanent}} enters transformed, you may draw a card. Do this only once each turn": "TriggerMayOnceEachTurn(Or([WhenAPermanentTransforms({{Permanent[0]}}), WhenAPermanentEntersTheBattlefieldTransformed({{Permanent[1]}})]), ActionList([DrawACard]))",
    "Whenever {{a}} {{SpecificCard}} is put into a player's graveyard from anywhere, {{TriggerActions(ThatPlayer)}}": "TriggerA(WhenACardIsPutIntoAPlayersGraveyardFromAnywhere({{SpecificCard[0]}}, AnyPlayer), {{TriggerActions(ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "Whenever {{a}} {{SpecificCard}} is put into an opponent's graveyard from anywhere, {{TriggerActions[WhenACardIsPutIntoAGraveyardFromAnywhere]}}": "TriggerA(WhenACardIsPutIntoAPlayersGraveyardFromAnywhere({{SpecificCard[0]}}, Opponent), {{TriggerActions[WhenACardIsPutIntoAGraveyardFromAnywhere][0]}})",
    "Whenever {{a}} {{SpecificCard}} is put into an opponent's graveyard from anywhere, {{TriggerActions}}": "TriggerA(WhenACardIsPutIntoAPlayersGraveyardFromAnywhere({{SpecificCard[0]}}, Opponent), {{TriggerActions[0]}})",
    "Whenever {{a}} {{SpecificCard}} is put into an opponent's graveyard from their library, {{TriggerActions[WhenACardIsPutIntoAGraveyardFromTheirLibrary]}}": "TriggerA(WhenACardIsPutIntoAPlayersGraveyardFromTheirLibrary({{SpecificCard[0]}}, Opponent), {{TriggerActions[WhenACardIsPutIntoAGraveyardFromTheirLibrary][0]}})",
    "Whenever {{a}} {{SpecificCard}} is put into your graveyard from anywhere other than the battlefield, put it onto the battlefield": "TriggerA(WhenACardIsPutIntoAGraveyardFromAnywhereOtherThanTheBattlefield(AnyCard, SinglePlayer(You)), ActionList([PutGraveyardCardOntoBattlefield(Trigger_ThatGraveyardCard, [EntersNormally])]))",
    "Whenever {{a}} {{SpecificCard}} is put into your graveyard from anywhere, {{TriggerActions}}": "TriggerA(WhenACardIsPutIntoAPlayersGraveyardFromAnywhere({{SpecificCard[0]}}, SinglePlayer(You)), {{TriggerActions[0]}})",
    "Whenever {{a}} {{SpecificCard}} is put into your graveyard from your library or hand, {{TriggerActions[WhenACardIsPutIntoAGraveyard]}}": "TriggerA(Or([WhenACardIsPutIntoAPlayersGraveyardFromTheirLibrary({{SpecificCard[0]}}, SinglePlayer(You)), WhenACardIsPutIntoAPlayersGraveyardFromTheirHand({{SpecificCard[0]}}, SinglePlayer(You))]), {{TriggerActions[WhenACardIsPutIntoAGraveyard][0]}})",
    "Whenever {{a}} {{SpecificCard}} is put into your graveyard from your library, {{TriggerActions[WhenACardIsPutIntoAGraveyard]}}": "TriggerA(WhenACardIsPutIntoAPlayersGraveyardFromTheirLibrary({{SpecificCard[0]}}, SinglePlayer(You)), {{TriggerActions[WhenACardIsPutIntoAGraveyard][0]}})",
    "Whenever {{a}} {{SpecificCard}} is put into your graveyard from your library, {{TriggerActions}}": "TriggerA(WhenACardIsPutIntoAPlayersGraveyardFromTheirLibrary({{SpecificCard[0]}}, SinglePlayer(You)), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Spell}} deals damage, {{TriggerActions}}": "TriggerA(WhenASpellDealsDamage({{Spell[0]}}), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Spell}} you've cast is countered, {{TriggerActions}}": "TriggerA(WhenASpellIsCountered(And([{{Spell[0]}}, CastByPlayer(You)])), {{TriggerActions[0]}})",
    "Whenever {{a}} {{Zombie}} card is put into your hand from your library, conjure a duplicate of that card into your hand": "TriggerA(WhenASpecificCardIsPutIntoAPlayersHandFromTheirLibrary(IsCreatureType({{Zombie[0]}}), SinglePlayer(You)), ActionList([ConjureDuplicateOfCardInHandIntoHand(Trigger_ThatCardInHand)]))",
    "Whenever {{a}} {{Zombie}} you control deals damage to a creature, that {{Zombie}} deals that much damage to that creature's controller": "TriggerA(WhenACreatureDealsCombatDamageToAPermanent(And([IsCreatureType({{Zombie[0]}}), ControlledByAPlayer(SinglePlayer(You))]), IsCardtype(Creature)), ActionList([PermanentDealsDamage(Trigger_ThatCreature, Trigger_ThatMuch, Player(ControllerOfPermanent(Trigger_ThatPermanent)))]))",
    "∞ - At the beginning of your upkeep, {{TriggerActions}}": "TriggerA(If(PermanentPassesFilter(ThisPermanent, IsHarnessed), AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You))), {{TriggerActions[0]}})"
  },
