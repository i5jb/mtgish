    "Prevent all combat damage target {{Creature}} would deal this turn.\nPrevent all combat damage that would be dealt to target {{Creature}} this turn": "Targeted([TargetPermanent({{Creature[0]}}), TargetPermanent({{Creature[1]}})], ActionList([CreatePreventDamageUntil(CombatDamageWouldBeDealtByCreature(Ref_TargetPermanent1), [PreventThatDamage], UntilEndOfTurn), CreatePreventDamageUntil(CombatDamageWouldBeDealtToRecipient(Permanent(Ref_TargetPermanent2)), [PreventThatDamage], UntilEndOfTurn)]))",
    "Prevent all combat damage that would be dealt by target {{Creature}} this turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePreventDamageUntil(CombatDamageWouldBeDealtByCreature(Ref_TargetPermanent), [PreventThatDamage], UntilEndOfTurn)]))",
    "Prevent all combat damage that would be dealt by target {{Creature}} this turn.\nDraw a card": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePreventDamageUntil(CombatDamageWouldBeDealtByCreature(Ref_TargetPermanent), [PreventThatDamage], UntilEndOfTurn), DrawACard]))",
    "Prevent all combat damage that would be dealt by target {{Creature}} this turn. That creature gets {{PTModX}} until end of turn, where X is {{GameNumber(ThatPermanent)}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePreventDamageUntil(CombatDamageWouldBeDealtByCreature(Ref_TargetPermanent), [PreventThatDamage], UntilEndOfTurn), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTX({{PTModX[0]}}, {{GameNumber(ThatPermanent=ActionPermanent)[0]}})], UntilEndOfTurn)]))",
    "Prevent all combat damage that would be dealt by {{Creatures}} other than target {{Creature}} this turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePreventDamageUntil(CombatDamageWouldBeDealtByACreature(And([{{Creatures[0]}}, Other(Ref_TargetPermanent)])), [PreventThatDamage], UntilEndOfTurn)]))",
    "Prevent all combat damage that would be dealt by {{Creatures}} this turn": "ActionList([CreatePreventDamageUntil(CombatDamageWouldBeDealtByACreature({{Creatures[0]}}), [PreventThatDamage], UntilEndOfTurn)])",
    "Prevent all combat damage that would be dealt this turn": "ActionList([CreatePreventDamageUntil(CombatDamageWouldBeDealt, [PreventThatDamage], UntilEndOfTurn)])",
    "Prevent all combat damage that would be dealt this turn by {{Creatures}}": "ActionList([CreatePreventDamageUntil(CombatDamageWouldBeDealtByACreature({{Creatures[0]}}), [PreventThatDamage], UntilEndOfTurn)])",
    "Prevent all combat damage that would be dealt this turn except combat damage that would be dealt by {{Creatures}}. Scry {{Digits}}": "ActionList([CreatePreventDamageUntil(CombatDamageWouldBeDealtByACreature(Not({{Creatures[0]}})), [PreventThatDamage], UntilEndOfTurn), Scry({{Digits[0]}})])",
    "Prevent all combat damage that would be dealt this turn.\nEach {{Permanent}} doesn't untap during its controller's next untap step": "ActionList([CreatePreventDamageUntil(CombatDamageWouldBeDealt, [PreventThatDamage], UntilEndOfTurn), EachPermanentDoesntUntapDuringControllersNextUntap({{Permanent[0]}})])",
    "Prevent all combat damage that would be dealt this turn.\n{{AbilityWord}} - If {{Condition}}, instead prevent all combat damage that would be dealt this turn by {{Creatures}}": "ActionList([IfElse({{Condition[0]}}, [CreatePreventDamageUntil(CombatDamageWouldBeDealtByACreature({{Creatures[0]}}), [PreventThatDamage], UntilEndOfTurn)], [CreatePreventDamageUntil(CombatDamageWouldBeDealt, [PreventThatDamage], UntilEndOfTurn)])])",
    "Prevent all combat damage that would be dealt this turn.\n{{AbilityWord}} - If {{Condition}}, tap all {{Creatures}}. Those creatures don't untap during their controller's next untap step": "ActionList([CreatePreventDamageUntil(CombatDamageWouldBeDealt, [PreventThatDamage], UntilEndOfTurn), If({{Condition[0]}}, [TapEachPermanent({{Creatures[0]}}), EachPermanentDoesntUntapDuringControllersNextUntap(ThePermanentsTappedThisWay)])])",
    "Prevent all combat damage that would be dealt this turn. Clash with an opponent. If you win, creatures that player controls don't untap during the player's next untap step": "ActionList([CreatePreventDamageUntil(CombatDamageWouldBeDealt, [PreventThatDamage], UntilEndOfTurn), Clash(Opponent, [CreateEachPermanentRuleEffectUntil(And([IsCardtype(Creature), ControlledByPlayer(ClashOpponent)]), [DoesntUntapDuringControllersUntap], DuringPlayersNextUntapStep(ClashOpponent))], [DoNothing])])",
    "Prevent all combat damage that would be dealt this turn. You gain {{Digits}} life for each {{Eachable}}": "ActionList([CreatePreventDamageUntil(CombatDamageWouldBeDealt, [PreventThatDamage], UntilEndOfTurn), GainLifeForEach({{Digits[0]}}, {{Eachable[0]}})])",
    "Prevent all combat damage that would be dealt this turn. You may look at each face-down creature that's attacking or blocking": "ActionList([CreatePreventDamageUntil(CombatDamageWouldBeDealt, [PreventThatDamage], UntilEndOfTurn), MayAction(LookAtEachFaceDownPermanent(And([IsFaceDown, IsCardtype(Creature), Or([IsAttacking, IsBlocking])])))])",
    "Prevent all combat damage that would be dealt to players this turn": "ActionList([CreatePreventDamageUntil(CombatDamageWouldBeDealtToARecipient(APlayer(AnyPlayer)), [PreventThatDamage], UntilEndOfTurn)])",
    "Prevent all combat damage that would be dealt to you and {{Creatures}} this turn": "ActionList([CreatePreventDamageUntil(CombatDamageWouldBeDealtToARecipient(APlayerOrAPermanent(SinglePlayer(You), {{Creatures[0]}})), [PreventThatDamage], UntilEndOfTurn)])",
    "Prevent all combat damage that would be dealt to you and {{Planeswalkers}} this turn. Untap all attacking creatures and goad them. After this phase, there is an additional combat phase": "ActionList([CreatePreventDamageUntil(CombatDamageWouldBeDealtToARecipient(APlayerOrAPermanent(SinglePlayer(You), {{Planeswalkers[0]}})), [PreventThatDamage], UntilEndOfTurn), UntapEachPermanent(And([IsAttacking, IsCardtype(Creature)])), GoadEachCreature(And([IsAttacking, IsCardtype(Creature)])), ThereIsAnAdditionalCombatPhase])",
    "Prevent all combat damage that would be dealt to you this turn. For each 1 damage prevented this way, create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}}": "ActionList([CreatePreventDamageUntil(CombatDamageWouldBeDealtToRecipient(Player(You)), [PreventThatDamage, CreateTokens([NumberTokens(TheAmountOfDamagePreventedThisWay, TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}]))])], UntilEndOfTurn)])",
    "Prevent all combat damage that would be dealt to you this turn. Populate": "ActionList([CreatePreventDamageUntil(CombatDamageWouldBeDealtToRecipient(Player(You)), [PreventThatDamage], UntilEndOfTurn), Populate])",
    "Prevent all damage one or two target {{Creatures}} would deal this turn": "Targeted([OneOrTwoTargetPermanents({{Creatures[0]}})], ActionList([CreatePreventDamageUntil(DamageWouldBeDealtByAPermanent(Ref_TargetPermanents), [PreventThatDamage], UntilEndOfTurn)]))",
    "Prevent all damage target {{Creature}} would deal this turn. If {{Condition(ThatPermanent)}}, destroy it": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePreventDamageUntil(DamageWouldBeDealtByPermanent(Ref_TargetPermanent), [PreventThatDamage], UntilEndOfTurn), If({{Condition(ThatPermanent=Ref_TargetPermanent)[0]}}, [DestroyPermanent(Ref_TargetPermanent)])]))",
    "Prevent all damage target {{Creature}} would deal this turn. That creature's controller may sacrifice {{a}} {{Permanent}} of their choice. If the player does, they may copy this spell and may choose a new target for that copy": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePreventDamageUntil(DamageWouldBeDealtByPermanent(Ref_TargetPermanent), [PreventThatDamage], UntilEndOfTurn), PlayerMayCost(ControllerOfPermanent(Ref_TargetPermanent), SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [PlayerMayAction(ControllerOfPermanent(Ref_TargetPermanent), CopySpellAndMayChooseNewTargets(ThisSpell))])]))",
    "Prevent all damage target {{Spell}} would deal this turn": "Targeted([TargetSpell({{Spell[0]}})], ActionList([CreatePreventDamageUntil(DamageWouldBeDealtBySpell(Ref_TargetSpell), [PreventThatDamage], UntilEndOfTurn)]))",
    "Prevent all damage target {{Spell}} would deal this turn. You gain life equal to the damage prevented this way": "Targeted([TargetSpell({{Spell[0]}})], ActionList([CreatePreventDamageUntil(DamageWouldBeDealtBySpell(Ref_TargetSpell), [PreventThatDamage, GainLife(TheAmountOfDamagePreventedThisWay)], UntilEndOfTurn)]))",
    "Prevent all damage that sources of the color of your choice would deal this turn": "ActionList([ChooseAColor(AnyColor), CreatePreventDamageUntil(DamageWouldBeDealtByASource(IsColor(TheChosenColor)), [PreventThatDamage], UntilEndOfTurn)])",
    "Prevent all damage that would be dealt by {{Permanents}} this turn": "ActionList([CreatePreventDamageUntil(DamageWouldBeDealtByAPermanent(Ref_TargetPermanents), [PreventThatDamage], UntilEndOfTurn)])",
    "Prevent all damage that would be dealt by {{Permanents}} this turn. You gain life equal to the damage prevented this way": "ActionList([CreatePreventDamageUntil(DamageWouldBeDealtByAPermanent({{Permanents[0]}}), [PreventThatDamage, GainLife(TheAmountOfDamagePreventedThisWay)], UntilEndOfTurn)])",
    "Prevent all damage that would be dealt this turn by {{DamageSources}}": "ActionList([CreatePreventDamageUntil(DamageWouldBeDealtByASource({{DamageSources[0]}}), [PreventThatDamage], UntilEndOfTurn)])",
    "Prevent all damage that would be dealt this turn by {{Permanents}}": "ActionList([CreatePreventDamageUntil(DamageWouldBeDealtByAPermanent(Ref_TargetPermanents), [PreventThatDamage], UntilEndOfTurn)])",
    "Prevent all damage that would be dealt this turn to up to {{Number}} target {{Permanents}}": "Targeted([UptoNumberTargetPermanents({{Number[0]}}, {{Permanents[0]}})], ActionList([CreatePreventDamageUntil(DamageWouldBeDealtByAPermanent(Ref_TargetPermanents), [PreventThatDamage], UntilEndOfTurn)]))",
    "Prevent all damage that would be dealt this turn to {{Creatures}}": "ActionList([CreatePreventDamageUntil(DamageWouldBeDealtToARecipient(APermanent({{Creatures[0]}})), [PreventThatDamage], UntilEndOfTurn)])",
    "Prevent all damage that would be dealt to target {{Creature}} this turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePreventDamageUntil(DamageWouldBeDealtToRecipient(Permanent(Ref_TargetPermanent)), [PreventThatDamage], UntilEndOfTurn)]))",
    "Prevent all damage that would be dealt to target {{Creature}} this turn. For each 1 damage prevented this way, put {{a}} {{CounterType}} counter on that creature": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePreventDamageUntil(DamageWouldBeDealtToRecipient(Permanent(Ref_TargetPermanent)), [PreventThatDamage, PutNumberCountersOfTypeOnPermanent(TheAmountOfDamagePreventedThisWay, {{CounterType[0]}}, Ref_TargetPermanent)], UntilEndOfTurn)]))",
    "Prevent all damage that would be dealt to you and {{Permanents}} this turn": "ActionList([CreatePreventDamageUntil(DamageWouldBeDealtToARecipient(APlayerOrAPermanent(SinglePlayer(You), {{Permanents[0]}})), [PreventThatDamage], UntilEndOfTurn)])",
    "Prevent all damage that would be dealt to you and {{Permanents}} this turn by {{Permanents}}": "ActionList([CreatePreventDamageUntil(DamageWouldBeDealtByAPermanentToARecipient({{Permanents[1]}}, APlayerOrAPermanent(SinglePlayer(You), {{Permanents[0]}})), [PreventThatDamage], UntilEndOfTurn)])",
    "Prevent all damage that would be dealt to you this turn by a source of your choice. Whenever damage from {{a}} {{DamageSource}} is prevented this way this turn, you gain that much life": "ActionList([ChooseADamageSource(AnyDamageSource), CreatePreventDamageUntil(DamageWouldBeDealtBySourceToRecipient(TheChosenDamageSource, Player(You)), [PreventThatDamage, If(DamageFromASourceWasPreventedThisWay({{DamageSource[0]}}), [ReflexiveTrigger(ActionList([GainLife(TheAmountOfDamagePreventedThisWay)]))])], UntilEndOfTurn)])",
    "Prevent all damage that would be dealt to you this turn by sources your opponents control. Whenever damage from a creature is prevented this way, each commander creature you control deals damage equal to its power to that creature": "ActionList([CreatePreventDamageUntil(DamageWouldBeDealtByASourceToRecipient(ControlledByAPlayer(Opponent), Player(You)), [PreventThatDamage, If(DamageFromAPermanentSourceWasPreventedThisWay(IsCardtype(Creature)), [ReflexiveTrigger(ActionList([EachPermanentDealsDamage(And([IsACommander, IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]), PowerOfPermanent(EachablePermanent), Permanent(WouldDealDamage_DamageRecipientPermanent))]))])], UntilEndOfTurn)])",
    "Prevent all damage that would be dealt to you this turn by {{Permanents}}": "ActionList([CreatePreventDamageUntil(DamageWouldBeDealtByAPermanentToRecipient({{Permanents[0]}}, Player(You)), [PreventThatDamage], UntilEndOfTurn)])",
    "Prevent all damage that would be dealt to {{Creatures}} this turn": "ActionList([CreatePreventDamageUntil(DamageWouldBeDealtToARecipient(APermanent({{Creatures[0]}})), [PreventThatDamage], UntilEndOfTurn)])",
    "Prevent all damage that would be dealt to {{Permanents}} this turn. {{Permanents}} gain {{Hasable}} until end of turn": "ActionList([CreatePreventDamageUntil(DamageWouldBeDealtByAPermanent({{Permanents[0]}}), [PreventThatDamage], UntilEndOfTurn), CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "Prevent all damage that {{DamageSources}} and {{DamageSources}} would deal this turn": "ActionList([CreatePreventDamageUntil(DamageWouldBeDealtByASource(Or([{{DamageSources[0]}}, {{DamageSources[1]}}])), [PreventThatDamage], UntilEndOfTurn)])",
    "Prevent all damage that {{Permanents}} would deal to players this turn": "ActionList([CreatePreventDamageUntil(DamageWouldBeDealtByAPermanentToARecipient({{Permanents[0]}}, APlayer(AnyPlayer)), [PreventThatDamage], UntilEndOfTurn)])",
    "Prevent all damage {{a}} {{DamageSource}} of your choice would deal this turn": "ActionList([ChooseADamageSource({{DamageSource[0]}}), CreatePreventDamageUntil(DamageWouldBeDealtBySource(TheChosenDamageSource), [PreventThatDamage], UntilEndOfTurn)])",
    "Prevent the next {{Digits}} damage that would be dealt this turn to any number of targets, divided as you choose": "TargetedDistributed([UptoNumberAnyTargets({{Digits[0]}})], DistributeNumberAmongTargets({{Digits[0]}}), ActionList([ActionForEachDistributedAnyTarget([CreateFuturePreventDamage(NextAmountOfDamageThatWouldBeDealtThisTurnToRecipient(DistributedNumber, DistributedAnyTarget), [PreventThatDamage])])]))",
    "Prevent the next {{Digits}} damage that would be dealt to any target this turn": "Targeted([AnyTarget], ActionList([CreateFuturePreventDamage(NextAmountOfDamageThatWouldBeDealtThisTurnToRecipient({{Digits[0]}}, Ref_AnyTarget), [PreventThatDamage])]))",
    "Prevent the next {{Digits}} damage that would be dealt to any target this turn by a source of your choice. You gain {{Digits}} life": "Targeted([AnyTarget], ActionList([ChooseADamageSource(AnyDamageSource), CreateFuturePreventDamage(NextAmountOfDamageThatWouldBeDealtThisTurnBySourceToRecipient({{Digits[0]}}, TheChosenDamageSource, Ref_AnyTarget), [PreventThatDamage, GainLife(TheAmountOfDamagePreventedThisWay)])]))",
    "Prevent the next {{Digits}} damage that would be dealt to any target this turn.\nDraw a card": "Targeted([AnyTarget], ActionList([CreateFuturePreventDamage(NextAmountOfDamageThatWouldBeDealtThisTurnToRecipient({{Digits[0]}}, Ref_AnyTarget), [PreventThatDamage]), DrawACard]))",
    "Prevent the next {{Digits}} damage that would be dealt to any target this turn.\nDraw a card at the beginning of the next turn's upkeep": "Targeted([AnyTarget], ActionList([CreateFuturePreventDamage(NextAmountOfDamageThatWouldBeDealtThisTurnToRecipient({{Digits[0]}}, Ref_AnyTarget), [PreventThatDamage]), CreateFutureTrigger(AtTheBeginningOfTheNextTurnsUpkeep, ActionList([DrawACard]))]))",
    "Prevent the next {{Digits}} damage that would be dealt to any target this turn. If it's {{a}} {{Creature}}, put {{a}} {{CounterType}} counter on it for each 1 damage prevented this way at the beginning of the next end step": "Targeted([AnyTarget], ActionList([CreateFuturePreventDamage(NextAmountOfDamageThatWouldBeDealtThisTurnToRecipient({{Digits[0]}}, Ref_AnyTarget), [PreventThatDamage, If(PermanentPassesFilter(AnyTargetAsAPermanent, {{Creature[0]}}), [CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutNumberCountersOfTypeOnPermanent(TheAmountOfDamagePreventedThisWay, {{CounterType[0]}}, AnyTargetAsAPermanent)]))])])]))",
    "Prevent the next {{Digits}} damage that would be dealt to any target this turn. You gain life equal to the damage prevented this way": "Targeted([AnyTarget], ActionList([CreateFuturePreventDamage(NextAmountOfDamageThatWouldBeDealtThisTurnToRecipient({{Digits[0]}}, Ref_AnyTarget), [PreventThatDamage, GainLife(TheAmountOfDamagePreventedThisWay)])]))",
    "Prevent the next {{Digits}} damage that would be dealt to target {{Creature}} this turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreateFuturePreventDamage(NextAmountOfDamageThatWouldBeDealtThisTurnToRecipient({{Digits[0]}}, Permanent(Ref_TargetPermanent)), [PreventThatDamage])]))",
    "Prevent the next {{Digits}} damage that would be dealt to target {{Creature}} this turn. At the beginning of the next end step, put {{a}} {{CounterType}} counter on that creature for each 1 damage prevented this way": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreateFuturePreventDamage(NextAmountOfDamageThatWouldBeDealtThisTurnToRecipient({{Digits[0]}}, Permanent(Ref_TargetPermanent)), [PreventThatDamage, CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutNumberCountersOfTypeOnPermanent(TheAmountOfDamagePreventedThisWay, {{CounterType[0]}}, Ref_TargetPermanent)]))])]))",
    "Prevent the next {{Digits}} damage that would be dealt to target {{Creature}} this turn. For each 1 damage prevented this way, put {{a}} {{CounterType}} counter on that creature": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreateFuturePreventDamage(NextAmountOfDamageThatWouldBeDealtThisTurnToRecipient({{Digits[0]}}, Permanent(Ref_TargetPermanent)), [PreventThatDamage, PutNumberCountersOfTypeOnPermanent(TheAmountOfDamagePreventedThisWay, {{CounterType[0]}}, Ref_TargetPermanent)])]))",
    "Proliferate": "ActionList([Proliferate])",
    "Proliferate, then choose any number of permanents you control that had a counter put on them this way. Those permanents phase out": "ActionList([Proliferate, ChooseAnyNumberOfPermanents(HadCountersPutOnItThisWay), PhaseOutEachPermanent(ThePermanentsChosenThisWay)])",
    "Proliferate. {{Reminder}}\nDraw a card": "ActionList([Proliferate, DrawACard])",
    "Proliferate. {{Reminder}}\nTarget {{Creature}} fights up to one target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}}), UptoOneTargetPermanent({{Creature[1]}})], ActionList([Proliferate, HaveCreaturesFight(Ref_TargetPermanent1, Ref_TargetPermanent2)]))",
    "Put X {{CounterType}} counters on target creature that target {{Zombie}} blocked this turn, where X is the power of that blocked creature. The creature gains \"{{QuotedAbility}}\" and \"{{QuotedAbility}}\"": "Targeted([TargetPermanent(IsCreatureType({{Zombie[0]}})), TargetPermanent(And([IsCardtype(Creature), WasBlockedByDefenderThisTurn(Ref_TargetPermanent1)]))], ActionList([PutNumberCountersOfTypeOnPermanent(PowerOfPermanent(Ref_TargetPermanent2), {{CounterType[0]}}, Ref_TargetPermanent2), CreatePermanentLayerEffectUntil(Ref_TargetPermanent2, [AddAbility([{{QuotedAbility[0]}}]), AddAbility([{{QuotedAbility[1]}}])], UntilEndOfTurn)]))",
    "Put X {{CounterType}} counters on target {{Creature}}, where X is {{GameNumber(ThatCreature)}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([PutNumberCountersOfTypeOnPermanent({{GameNumber(ThatCreature=Ref_TargetPermanent)[0]}}, {{CounterType[0]}}, Ref_TargetPermanent)]))",
    "Put X {{CounterType}} counters on target {{Creature}}, where X is {{GameNumber[ThisSpell]}}. That creature gains {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([PutNumberCountersOfTypeOnPermanent({{GameNumber[ThisSpell][0]}}, {{CounterType[0]}}, Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Put X {{CounterType}} counters on target {{Creature}}, where X is {{GameNumber}}. It gains {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([PutNumberCountersOfTypeOnPermanent({{GameNumber[0]}}, {{CounterType[0]}}, Ref_TargetPermanent), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Put a card you own from outside the game into your hand": "ActionList([PutACardFromOutsideGameInHand(AnyCard)])",
    "Put all {{Permanents}} on the bottom of their owners' libraries": "ActionList([PutEachPermanentOnBottomOfOwnersLibraryInOrderOfOwnersChoice({{Permanents[0]}})])",
    "Put all {{Permanents}} on top of their owners' libraries": "ActionList([PutEachPermanentOnTheTopOfOwnersLibraryInOrderOfOwnersChoice({{Permanents[0]}})])",
    "Put all {{SpecificCards}} from all graveyards onto the battlefield under your control": "ActionList([PutEachCardFromEachPlayersGraveyardOntoTheBattlefield({{SpecificCards[0]}}, AnyPlayer, [EntersUnderPlayersControl(You)])])",
    "Put any number of cards from your hand on the bottom of your library, then draw that many cards plus {{Number}}": "ActionList([PutAnyNumberOfCardsFromHandOnBottomOfLibraryInAnyOrder, DrawNumberCards(Plus(NumCardsPutIntoLibraryThisWay, {{Number[0]}}))])",
    "Put any number of target {{SpecificCards}} from target player's graveyard on top of their library in any order": "Targeted([TargetPlayer(AnyPlayer), AnyNumberOfTargetGraveyardCards(And([{{SpecificCards[0]}}, InAPlayersGraveyard(SinglePlayer(Ref_TargetPlayer))]))], ActionList([ReturnGraveyardCardsToTopOfLibraryInAnyOrder(Ref_TargetGraveyardCards)]))",
    "Put any number of target {{SpecificCards}} from your graveyard on top of your library.\nDraw a card": "Targeted([AnyNumberOfTargetGraveyardCards(And([{{SpecificCards[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([ReturnGraveyardCardsToTopOfLibraryInAnyOrder(Ref_TargetGraveyardCards), DrawACard]))",
    "Put any number of target {{SpecificCards}} from your graveyard on top of your library.\nDraw a card at the beginning of the next turn's upkeep": "Targeted([AnyNumberOfTargetGraveyardCards(And([{{SpecificCards[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([ReturnGraveyardCardsToTopOfLibraryInAnyOrder(Ref_TargetGraveyardCards), CreateFutureTrigger(AtTheBeginningOfTheNextTurnsUpkeep, ActionList([DrawACard]))]))",
    "Put one, two, or three target {{SpecificCards}} from graveyards onto the battlefield under your control. Each of them enters with an additional {{CounterType}} counter on it": "Targeted([BetweenOneAndNumberTargetGraveyardCards(Integer(3), {{SpecificCards[0]}})], ActionList([PutEachGraveyardCardOntoBattlefield(Ref_TargetGraveyardCards, [EntersUnderPlayersControl(You), EntersWithACounter({{CounterType[0]}})])]))",
    "Put onto the battlefield under your control all {{SpecificCards}} in all graveyards that were put there from the battlefield this turn": "ActionList([ReturnEachCardFromEachPlayersGraveyardToBattlefieldThatWasPutThereFromTheBattlefieldThisTurn({{SpecificCards[0]}}, AnyPlayer, [EntersUnderPlayersControl(You)])])",
    "Put target card from a graveyard on top of its owner's library": "Targeted([TargetGraveyardCard(AnyCardInAnyGraveyard)], ActionList([PutGraveyardCardOnTopOfLibrary(Ref_TargetGraveyardCard)]))",
    "Put target card from a graveyard on your choice of the top or bottom of its owner's library. Create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}}": "Targeted([TargetGraveyardCard(AnyCardInAnyGraveyard)], ActionList([ReturnGraveyardCardToTopOrBottomOfLibrary(Ref_TargetGraveyardCard), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])])]))",
    "Put target card from your graveyard on top of your library": "Targeted([TargetGraveyardCard(InAPlayersGraveyard(SinglePlayer(You)))], ActionList([PutGraveyardCardOnTopOfLibrary(Ref_TargetGraveyardCard)]))",
    "Put target face-up exiled card into its owner's graveyard": "Targeted([TargetExiledCard(IsFaceUp)], ActionList([PutExiledCardIntoOwnersGraveyard(Ref_TargetExiledCard)]))",
    "Put target spell or nonland permanent into its owner's library {{Nth}} from the top": "Targeted_Modal([Targeted([TargetSpell(AnySpell)], ActionList([PutSpellInOwnersLibraryNthFromTheTop(Ref_TargetSpell, {{Nth[0]}})])), Targeted([TargetPermanent(IsNonCardtype(Land))], ActionList([PutPermanentInOwnersLibraryNthFromTheTop(Ref_TargetPermanent, {{Nth[0]}})]))])",
    "Put target {{CreatureCard}} from a graveyard onto the battlefield under your control with {{a}} {{CounterType}} counter on it. You take the initiative. If that creature would leave the battlefield, exile it instead of putting it anywhere else": "Targeted([TargetGraveyardCard(And([{{CreatureCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersUnderPlayersControl(You), EntersWithACounter({{CounterType[0]}})]), TakeTheInitiative, CreateFutureReplaceWouldLeaveTheBattlefield(PermanentWouldLeaveTheBattlefield(ThePermanentPutOnTheBattlefieldThisWay), [ExileItInstead])]))",
    "Put target {{Creature}} on the bottom of its owner's library. Its controller gains life equal to {{GameNumber(ThatCreature)}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([ReturnPermanentToTopOrBottomOfLibrary(Ref_TargetPermanent), PlayerAction(ControllerOfPermanent(Ref_TargetPermanent), GainLife({{GameNumber(ThatCreature=Ref_TargetPermanent)[0]}}))]))",
    "Put target {{Creature}} on top of its owner's library. If {{Condition(ThatPermanent)}}, you may put it on the bottom of its owner's library instead": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([IfElse({{Condition(ThatPermanent=Ref_TargetPermanent)[0]}}, [ReturnPermanentToTopOrBottomOfLibrary(Ref_TargetPermanent)], [PutPermanentOnTopOfOwnersLibrary(Ref_TargetPermanent)])]))",
    "Put target {{Permanent}} an opponent controls on top of its owner's library. That opponent may put {{a}} {{SpecificCard}} from their hand onto the battlefield": "Targeted([TargetPermanent(And([{{Permanent[0]}}, ControlledByAPlayer(Opponent)]))], ActionList([ReturnPermanentToTopOrBottomOfLibrary(Ref_TargetPermanent), PlayerMayAction(ControllerOfPermanent(Ref_TargetPermanent), PutACardFromHandOnBattlefield({{SpecificCard[0]}}, [EntersNormally]))]))",
    "Put target {{Permanent}} into its owner's library {{Nth}} from the top": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutPermanentInOwnersLibraryNthFromTheTop(Ref_TargetPermanent, {{Nth[0]}})]))",
    "Put target {{Permanent}} into its owner's library {{Nth}} from the top. Its controller gains {{Digits}} life": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutPermanentInOwnersLibraryNthFromTheTop(Ref_TargetPermanent, {{Nth[0]}}), PlayerAction(ControllerOfPermanent(Ref_TargetPermanent), GainLife({{Digits[0]}}))]))",
