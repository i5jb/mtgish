  "{{OneTimeBoonQuotedAbility}}": {
    "When one or more {{Permanents}} enter under your control, create a Wicked Role token attached to one of them": "WhenAnyNumberOfPermanentsEnterTheBattlefieldUnderAPlayersControl({{Permanents[0]}}, SinglePlayer(You)), ActionList([CreateTokensWithFlags([WickedRoleToken], [EntersAttachedToAPermanent(Trigger_ThosePermanents)])])",
    "When you cast {{a}} {{CreatureSpell}}, it gains your choice of {{Hasable}} or {{Hasable}}": "WhenAPlayerCastsASpell(SinglePlayer(You), {{CreatureSpell[0]}}), ActionList([ChooseAnAction([[CreateSpellEffect(Trigger_ThatSpell, [AddAbility([{{Hasable[0]}}])])], [CreateSpellEffect(Trigger_ThatSpell, [AddAbility([{{Hasable[1]}}])])]])])",
    "When you cast {{a}} {{CreatureSpell}}, that creature enters tapped and with {{a}} {{CounterType}} counter on it": "WhenAPlayerCastsASpell(SinglePlayer(You), {{CreatureSpell[0]}}), ActionList([CreateSpellEffect(Trigger_ThatSpell, [EntersTapped, EntersWithACounter({{CounterType[0]}})])])",
    "When you cast {{a}} {{Spell}}, this boon deals damage equal to the noted number to target {{CreatureOrPlaneswalker}}": "WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), Targeted([TargetPermanent({{CreatureOrPlaneswalker[0]}})], ActionList([BoonDealsDamage(ThisBoon, TheNotedNumber, Permanent(Ref_TargetPermanent))]))",
    "When you cast {{a}} {{Spell}}, {{TriggerActions(ThatSpell)}}": "WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), {{TriggerActions(ThatSpell=Trigger_ThatSpell)[0]}}",
    "When you cast {{a}} {{Spell}}, {{TriggerActions}}": "WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), {{TriggerActions[0]}}",
    "Whenever a creature you control enters, {{TriggerActions(ThatPermanent)}}": "WhenAPermanentEntersTheBattlefield(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))])), {{TriggerActions(ThatPermanent=Trigger_ThatPermanent)[0]}}",
    "Whenever one or more {{Permanents}} enter under your control, {{TriggerActions}}": "WhenAnyNumberOfPermanentsEnterTheBattlefieldUnderAPlayersControl({{Permanents[0]}}, SinglePlayer(You)), {{TriggerActions[0]}}",
    "Whenever you sacrifice one or more permanents, {{TriggerActions}}": "WhenAPlayerSacrificesAnyNumberOfPermanents(SinglePlayer(You)), {{TriggerActions[0]}}"
  },
  "{{OneTimeConditionalBoonQuotedAbility}}": {
    "At the beginning of your end step, if {{Number}} or more creatures died this turn, each opponent loses {{Digits}} life and you gain {{Digits}} life": "AtTheBeginningOfAPlayersEndStep(SinglePlayer(You)), ANumberOfPermanentsDiedThisTurn(GreaterThanOrEqualTo({{Number[0]}}), IsCardtype(Creature)), ActionList([EachPlayerAction(Opponent, LoseLife({{Digits[0]}})), GainLife({{Digits[1]}})])"
  },
  "{{OthersMayActivate}}": {
    "Any player may activate this ability": "OtherPlayersMayActivate(AnyPlayer)",
    "Any player may activate this ability but only as a sorcery": "And([OtherPlayersMayActivate(AnyPlayer), ActivateOnlyAsASorcery])",
    "Any player may activate this ability but only during any upkeep step": "And([OtherPlayersMayActivate(AnyPlayer), ActivateOnlyIf(IsDuringUpkeep)])",
    "Any player may activate this ability but only during their draw step": "And([OtherPlayersMayActivate(AnyPlayer), ActivateOnlyDuringTheirTurn, ActivateOnlyIf(IsDuringDrawStep)])",
    "Any player may activate this ability but only during their turn": "And([OtherPlayersMayActivate(AnyPlayer), ActivateOnlyDuringTheirTurn])",
    "Any player may activate this ability but only during their turn before the end step": "And([OtherPlayersMayActivate(AnyPlayer), ActivateOnlyDuringTheirTurn, ActivateOnlyIf(IsBeforeEndStep)])",
    "Only your opponents may activate this ability": "OnlyOtherPlayersMayActivate(Opponent)",
    "Only your opponents may activate this ability and only as a sorcery": "And([OnlyOtherPlayersMayActivate(Opponent), ActivateOnlyAsASorcery])"
  },
  "{{PTModXY}}": {
