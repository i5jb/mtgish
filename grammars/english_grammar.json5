    "Whenever equipped creature deals combat damage, {{TriggerActions(ThatCreature,ThatMuch)}}": "TriggerA(WhenACreatureDealsCombatDamage(SinglePermanent(HostPermanent)), {{TriggerActions(ThatCreature=Trigger_ThatCreature,ThatMuch=Trigger_AmountOfDamageDealt)[0]}})",
    "Whenever equipped creature deals combat damage, {{TriggerActions(ThatPermanent)}}": "TriggerA(WhenACreatureDealsCombatDamage(SinglePermanent(HostPermanent)), {{TriggerActions(ThatPermanent=Trigger_ThatCreature)[0]}})",
