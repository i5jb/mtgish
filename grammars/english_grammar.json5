    "Enchanted creature can't be blocked except by {{Creatures}} and/or {{Creatures}}": "PermanentRuleEffect(HostPermanent, [CantBeBlockedExceptByDefenders(Or([{{Creatures[0]}}, {{Creatures[1]}}]))])",
    "Enchanted creature can't be blocked unless defending player pays {{ManaCost}} for each creature they control that's blocking it": "PermanentRuleEffect(HostPermanent, [CantBeBlockedUnlessCost(PayMana({{ManaCost[0]}}))])",
    "Enchanted creature can't block": "PermanentRuleEffect(HostPermanent, [CantBlock])",
    "Enchanted creature can't block creatures with power equal to or greater than the enchanted creature's toughness": "PermanentRuleEffect(HostPermanent, [CantBlockAttackers(And([IsCardtype(Creature), PowerIs(GreaterThanOrEqualTo(ToughnessOfPermanent(HostPermanent)))]))])",
    "Enchanted creature can't block {{Creatures}}": "PermanentRuleEffect(HostPermanent, [CantBlockAttackers({{Creatures[0]}})])",
    "Enchanted creature can't block, and its activated abilities can't be activated": "PermanentRuleEffect(HostPermanent, [CantBlock, AbilitiesCantBeActivated])",
    "Enchanted creature gets an additional {{PTMod}} as long as {{Condition}}": "If({{Condition[0]}}, [PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}})])])",
    "Enchanted creature gets {{PTModXY}}, where X is half {{GameNumber}}, rounded down, and Y is half {{GameNumber}}, rounded up": "PermanentLayerEffect(HostPermanent, [AdjustPTXY({{PTModXY[0]}}, HalfRoundedDown({{GameNumber[0]}}), HalfRoundedUp({{GameNumber[1]}}))])",
    "Enchanted creature gets {{PTModXY}}. If that creature is attacking, X is the number of snow lands defending player controls. Otherwise, X is {{GameNumber(ThatPermanent)}}. Y is equal to X or to {{EnchantedCreature}}'s toughness minus {{Digits}}, whichever is smaller": "IfElse(PermanentPassesFilter(HostPermanent, IsAttacking), [PermanentLayerEffect(HostPermanent, [AdjustPTXY({{PTModXY[0]}}, TheNumberOfPermanentsOnTheBattlefield(And([IsSupertype(Snow), IsCardtype(Land), ControlledByPlayer(PlayerCreatureIsAttacking(HostPermanent))])), MinimumOf(TheNumberOfPermanentsOnTheBattlefield(And([IsSupertype(Snow), IsCardtype(Land), ControlledByPlayer(PlayerCreatureIsAttacking(HostPermanent))])), Minus(ToughnessOfPermanent(HostPermanent), {{Digits[0]}})))])], [PermanentLayerEffect(HostPermanent, [AdjustPTXY({{PTModXY[0]}}, {{GameNumber(ThatPermanent=HostPermanent)[0]}}, MinimumOf({{GameNumber(ThatPermanent=HostPermanent)[0]}}, Minus(ToughnessOfPermanent(HostPermanent), {{Digits[0]}})))])])",
    "Enchanted creature gets {{PTModX}}, where X is {{GameNumber(ThatPermanent)}}": "PermanentLayerEffect(HostPermanent, [AdjustPTX({{PTModX[0]}}, {{GameNumber(ThatPermanent=HostPermanent)[0]}})])",
    "Enchanted creature gets {{PTMod}}": "PermanentLayerEffect(HostPermanent, [AdjustPT({{PTMod[0]}})])",
