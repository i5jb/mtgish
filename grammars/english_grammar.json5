    "Tap target {{Permanent}}. It doesn't untap during its controller's untap step for as long as this artifact remains tapped": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), CreatePermanentRuleEffectUntil(ThePermanentTappedThisWay, [DoesntUntapDuringControllersUntap], ForAsLongAsPermanentRemainsTapped({{~Permanent}}))]))",
    "Tap target {{Permanent}}. It doesn't untap during its controller's untap step for as long as this creature remains tapped": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), CreatePermanentRuleEffectUntil(ThePermanentTappedThisWay, [DoesntUntapDuringControllersUntap], ForAsLongAsPermanentRemainsTapped({{~Permanent}}))]))",
    "Tap target {{Permanent}}. It doesn't untap during its controller's untap step for as long as this land remains tapped": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), CreatePermanentRuleEffectUntil(ThePermanentTappedThisWay, [DoesntUntapDuringControllersUntap], ForAsLongAsPermanentRemainsTapped({{~Permanent}}))]))",
    "Tap target {{Permanent}}. That permanent doesn't untap during its controller's untap step for as long as this artifact remains tapped": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), CreatePermanentRuleEffectUntil(ThePermanentTappedThisWay, [DoesntUntapDuringControllersUntap], ForAsLongAsPermanentRemainsTapped({{~Permanent}}))]))",
    "Tap target {{Permanent}}. Transform this artifact": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), TransformPermanent({{~Permanent}})]))",
    "Tap target {{Permanent}}. You may put {{a}} {{CounterType}} counter on it. If you do, put {{a}} {{CounterType}} counter on this creature": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TapPermanent(Ref_TargetPermanent), MayCost(PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent)), If(CostWasPaid, [PutACounterOfTypeOnPermanent({{CounterType[1]}}, {{~Permanent}})])]))",
    "Tap this creature. It gains {{Hasable}} until end of turn": "ActionList([TapPermanent({{~Permanent}}), CreatePermanentLayerEffectUntil({{~Permanent}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "Target opponent discards a card. Then if {{Condition(ThatPlayer)}}, flip this creature": "Targeted([TargetPlayer(Opponent)], ActionList([PlayerAction(Ref_TargetPlayer, DiscardACard), If({{Condition(ThatPlayer=Ref_TargetPlayer)[0]}}, [FlipPermanent({{~Permanent}})])]))",
    "Target opponent exiles the top card of their library. If it's {{a}} {{SpecificCard}}, you may return this creature to its owner's hand": "Targeted([TargetPlayer(Opponent)], ActionList([PlayerAction(Ref_TargetPlayer, ExileTopCardOfLibrary), If(ACardWasExiledThisWay({{SpecificCard[0]}}), [MayAction(PutPermanentIntoItsOwnersHand({{~Permanent}}))])]))",
    "Target opponent gains control of this artifact": "Targeted([TargetPlayer(Opponent)], ActionList([PlayerAction(Ref_TargetPlayer, GainControlOfPermanent({{~Permanent}}))]))",
