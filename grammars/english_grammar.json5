    "Target {{Permanent}} gains {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "Target {{Permanent}} perpetually gains equip {{ManaCost}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePerpetualPermanentEffect(Ref_TargetPermanent, [AddAbility([Equip(IsCardtype(Creature), PayMana({{ManaCost[0]}}))])])]))",
    "Transform all {{Permanents}}": "ActionList([TransformEachPermanent({{Permanents[0]}})])",
    "Transform target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([TransformPermanent(Ref_TargetPermanent)]))",
    "Untap target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([UntapPermanent(Ref_TargetPermanent)]))",
    "Untap up to {{Number}} target {{Permanents}}": "Targeted([UptoNumberTargetPermanents({{Number[0]}}, {{Permanents[0]}})], ActionList([UntapEachPermanent(Ref_TargetPermanents)]))",
    "Until end of turn, whenever you cast an instant or sorcery spell, copy it. You may choose new targets for the copy": "ActionList([CreateTriggerUntil(WhenAPlayerCastsASpell(SinglePlayer(You), And([IsCardtype(Instant), IsCardtype(Sorcery)])), ActionList([CopySpellAndMayChooseNewTargets(Trigger_ThatSpell)]), UntilEndOfTurn)])",
    "Until your next turn, {{Creatures}} have base power and toughness {{PT}} and lose all abilities": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [SetPT({{PT[0]}}), LosesAllAbilities], UntilPlayersNextTurn(You))])",
    "Until your next turn, {{PotentialSpells}} your opponents cast cost {{ManaCost}} more to cast": "ActionList([CreateEachPlayerEffectUntil(Opponent, [IncreaseSpellCost({{PotentialSpells[0]}}, PayMana({{ManaCost[0]}}))], UntilPlayersNextTurn(You))])",
    "Up to one target {{Creature}} perpetually gets {{PTMod}} and gains {{PerpetualHasable}}": "Targeted([UptoOneTargetPermanent({{Creature[0]}})], ActionList([CreatePerpetualPermanentEffect(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{PerpetualHasable[0]}}])])]))",
    "You draw a card and lose {{Digits}} life": "ActionList([DrawACard, LoseLife({{Digits[0]}})])",
    "You draw a card and you lose {{Digits}} life": "ActionList([DrawACard, LoseLife({{Digits[0]}})])",
    "You gain X life, where X is {{GameNumber}}": "ActionList([GainLife({{GameNumber[0]}})])",
    "You gain life equal to {{GameNumber}}": "ActionList([GainLife({{GameNumber[0]}})])",
    "You gain {{Digits}} life": "ActionList([GainLife({{Digits[0]}})])",
    "You gain {{Digits}} life and scry {{Digits}}": "ActionList([GainLife({{Digits[0]}}), Scry({{Digits[0]}})])",
    "You gain {{Digits}} life and surveil {{Digits}}": "ActionList([GainLife({{Digits[0]}}), Surveil({{Digits[0]}})])",
    "You get a one-time boon with \"{{OneTimeBoonQuotedAbility}}\"": "ActionList([GetOneTimeBoon({{OneTimeBoonQuotedAbility[0]}})])",
    "You get {{Energy}}": "ActionList([GetEnergy(Integer({{Energy[0]}}))])",
    "You get {{Tickets}}": "ActionList([GetNumberTickets({{Tickets[0]}})])",
    "You lose the game": "ActionList([LoseTheGame])",
    "You may put a sticker on {{a}} {{Permanent}}": "ActionList([MayAction(PutAStickerOnAPermanent({{Permanent[0]}}))])",
    "You may put {{a}} {{SpecificCard}} from your hand onto the battlefield": "ActionList([MayAction(PutACardFromHandOnBattlefield({{SpecificCard[0]}}, [EntersNormally]))])",
    "You may put {{a}} {{SpecificCard}} from your hand onto the battlefield tapped": "ActionList([MayAction(PutACardFromHandOnBattlefield({{SpecificCard[0]}}, [EntersTapped]))])",
    "You may put {{a}} {{SpecificCard}} from your hand or graveyard onto the battlefield with {{a}} {{CounterType}} counter on it": "ActionList([MayAction(PutACardFromHandOrGraveyardOnBattlefield({{SpecificCard[0]}}, You, [EntersWithACounter({{CounterType[0]}})]))])",
    "You may tap or untap target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([MayAction(TapOrUntapPermanent(Ref_TargetPermanent))]))",
