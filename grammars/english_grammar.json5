    "{{~Permanent}} deals damage equal to {{GameNumber(ThatPermanent)}} to any target": "Targeted([AnyTarget], ActionList([PermanentDealsDamage({{~Permanent}}, {{GameNumber(ThatPermanent=^~Permanent)[0]}}, Ref_AnyTarget)]))",
    "{{~Permanent}} deals damage equal to {{GameNumber}} to target opponent": "Targeted([TargetPlayer(Opponent)], ActionList([PermanentDealsDamage({{~Permanent}}, {{GameNumber[0]}}, Player(Ref_TargetPlayer))]))",
    "{{~Permanent}} deals {{Digits}} damage to any target": "Targeted([AnyTarget], ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Ref_AnyTarget)]))",
    "{{~Permanent}} deals {{Digits}} damage to target player": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Player(Ref_TargetPlayer))]))",
    "{{~Permanent}} deals {{Digits}} damage to each opponent": "ActionList([PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, EachPlayer(Opponent))])",
