    "Whenever {{~Permanent}} and at least two {{Creatures}} attack, {{TriggerActions(~Permanent)}}": "TriggerA(WhenASingleCreatureAndANumberOfOtherCreaturesAttack({{~Permanent}}, GreaterThanOrEqualTo(Integer(2)), {{Creatures[0]}}), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "Whenever {{~Permanent}} and/or one or more other {{Permanents}} enter, if none of them were cast or no mana was spent to cast them, {{TriggerActions}}": "TriggerI(WhenAnyNumberOfPermanentsEnterTheBattlefield(Or([SinglePermanent({{~Permanent}}), And([Other({{~Permanent}}), {{Permanents[0]}}])])), Or([NoPermanentsPassFilter(Trigger_ThosePermanents, ItWasCast), AllPermanentsPassFilter(Trigger_ThosePermanents, NoManaWasSpentToCastIt)]), {{TriggerActions[0]}})",
    "Whenever {{~Permanent}} and/or one or more other {{Permanents}} enter, {{TriggerActions}}. This ability triggers only once each turn": "TriggerOnceEachTurn(Or([WhenAPermanentEntersTheBattlefield(SinglePermanent({{~Permanent}})), WhenAPermanentEntersTheBattlefield(And([Other({{~Permanent}}), {{Permanents[0]}}]))]), {{TriggerActions[0]}})",
    "Whenever {{~Permanent}} attacks a player, for each other opponent, create a token that's a copy of {{~Permanent}} tapped and attacking that player, except it isn't legendary. Sacrifice those tokens at end of combat": "TriggerA(WhenACreatureAttacksAPlayer(SinglePermanent({{~Permanent}}), AnyPlayer), ActionList([ForEachPlayerCreateTokensWithFlags(And([Other(Trigger_ThatPlayer), Opponent]), [TokenCopyOfPermanent(ThisPermanent, TokenCopyEffects([RemoveSupertypes([Legendary])]))], [EntersTapped, EntersAttackingPlayer(EachablePlayer)]), CreateFutureTrigger(AtTheEndOfThisCombat, ActionList([SacrificeEachPermanent(TheTokensCreatedThisWay)]))]))",
