    "sacrifice {{a}} {{Permanent}}. Then conjure {{Number}} cards named {{NamedCard}} onto the battlefield tapped": "ActionList([SacrificeAPermanent({{Permanent[0]}}), ConjureNumberCardsOntoBattlefield({{Number[0]}}, {{NamedCard[0]}}, [EntersTapped])])",
    "sacrifice {{a}} {{Permanent}}. You gain life equal to {{GameNumber[ThatSacrificedPermanent]}}": "ActionList([SacrificeAPermanent({{Permanent[0]}}), GainLife({{GameNumber[ThatSacrificedPermanent][0]}})])",
