    "that player loses {{Digits}} life unless they sacrifice {{a}} {{Permanent}} of their choice or discard a card": "ActionList([PlayerMayCost({{ThatPlayer}}, Or([SacrificeAPermanent({{Permanent[0]}}), DiscardACard])), Unless(CostWasPaid, [PlayerAction({{ThatPlayer}}, LoseLife({{Digits[0]}}))])])",
    "that player loses {{Digits}} life, searches their library for a card, puts it into their hand, then shuffles": "ActionList([PlayerActions({{ThatPlayer}}, [LoseLife({{Digits[0]}}), SearchLibrary([FindAGenericCard, PutFoundCardsIntoHand, Shuffle])])])",
    "that player may choose any number of {{Creatures}} they control and pay {{ManaCost}} for each creature chosen this way. If the player does, untap those creatures": "ActionList([PlayerAction({{ThatPlayer}}, ChooseAnyNumberPermanentsAndPayManaForEach(And([{{Creatures[0]}}, ControlledByPlayer(PlayerAction_ThatPlayer)]), {{ManaCost[0]}})), PlayerAction({{ThatPlayer}}, UntapEachPermanent(TheChosenPermanents))])",
    "that player may draw a card": "ActionList([PlayerMayAction({{ThatPlayer}}, DrawACard)])",
    "that player may draw a card if {{Condition}}": "ActionList([If({{Condition[0]}}, [PlayerMayAction({{ThatPlayer}}, DrawACard)])])",
    "that player may draw an additional card. If they do, spells they cast this turn cost {{ManaCost}} more to cast": "ActionList([PlayerMayCost({{ThatPlayer}}, DrawACard), If(CostWasPaid, [CreatePlayerEffectUntil({{ThatPlayer}}, [IncreaseSpellCost(AnySpell, PayMana({{ManaCost[0]}}))], UntilEndOfTurn)])])",
    "that player may exile a card from their graveyard. If the player doesn't, creatures they control can't attack you this turn": "ActionList([PlayerMayCost({{ThatPlayer}}, Exile([AGraveyardCard(InAPlayersGraveyard(SinglePlayer({{ThatPlayer}})))])), Unless(CostWasPaid, [CreatePlayerEffectUntil({{ThatPlayer}}, [CantAttackPlayer(You)], UntilEndOfTurn)])])",
    "that player may gain {{Digits}} life": "ActionList([PlayerMayAction({{ThatPlayer}}, GainLife({{Digits[0]}}))])",
    "that player may pay {{Digits}} life. If they don't, they return a permanent they control to its owner's hand": "ActionList([PlayerMayCost({{ThatPlayer}}, PayLife({{Digits[0]}})), Unless(CostWasPaid, [PlayerAction({{ThatPlayer}}, PutAPermanentIntoItsOwnersHand(ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))))])])",
    "that player may pay {{ManaCost}} for each {{Eachable(ThatPlayer)}}. If they don't, creatures can't attack this combat": "ActionList([PlayerMayCost({{ThatPlayer}}, PayManaForEach({{ManaCost[0]}}, {{Eachable(ThatPlayer=^ThatPlayer)[0]}})), Unless(CostWasPaid, [CreateEachPermanentRuleEffectUntil(IsCardtype(Creature), [CantAttack], UntilEndOfCombat)])])",
    "that player may pay {{ManaCost}}. If the player does, they draw a card": "ActionList([PlayerMayCost({{ThatPlayer}}, PayMana({{ManaCost[0]}})), If(CostWasPaid, [PlayerAction({{ThatPlayer}}, DrawACard)])])",
    "that player may pay {{ManaCost}}. If the player doesn't, you create a Treasure token": "ActionList([PlayerMayCost({{ThatPlayer}}, PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [CreateTokens([TreasureToken])])])",
    "that player may put {{a}} {{CounterType}} counter on target {{Permanent}} of their choice": "Targeted([TargetPermanentOfPlayersChoice({{Permanent[0]}}, {{ThatPlayer}})], ActionList([PlayerMayAction({{ThatPlayer}}, PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent))]))",
    "that player may put {{a}} {{SpecificCard}} from their hand onto the battlefield": "ActionList([PlayerMayAction({{ThatPlayer}}, PutACardFromHandOnBattlefield({{SpecificCard[0]}}, [EntersNormally]))])",
    "that player mills X cards, where X is {{GameNumber(ThatPlayer)}}": "ActionList([PlayerAction({{ThatPlayer}}, MillNumberCards({{GameNumber(ThatPlayer=^ThatPlayer)[0]}}))])",
    "that player mills a card": "ActionList([PlayerAction({{ThatPlayer}}, MillACard)])",
    "that player mills a card. Then they create X {{PT}} {{CreatureTokens}}, where X is the milled card's mana value": "ActionList([MillACard, CreateTokens([NumberTokens(ManaValueOfTheCardMilledThisWay, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])])",
    "that player mills {{Number}} cards": "ActionList([PlayerAction({{ThatPlayer}}, MillNumberCards({{Number[0]}}))])",
    "that player puts a card from their hand on top of their library": "ActionList([PlayerAction({{ThatPlayer}}, PutACardFromHandOnTopOfLibrary)])",
    "that player puts the cards in their hand on the bottom of their library in any order, then draws that many cards": "ActionList([PlayerActions({{ThatPlayer}}, [PutAllCardsFromHandOnBottomOfLibraryAnyOrder, DrawNumberCards(NumCardsPutIntoLibraryThisWay)])])",
    "that player puts {{a}} {{CounterType}} counter on target non-{{Swamp}} land they control of their choice. That land is {{a}} {{Swamp}} for as long as it has {{a}} {{CounterType}} counter on it": "Targeted([TargetPermanentOfPlayersChoice(And([IsNonLandType({{Swamp[0]}}), IsCardtype(Land), ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]), {{ThatPlayer}})], ActionList([PlayerAction({{ThatPlayer}}, PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent)), CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [SetLandType({{Swamp[1]}})], UntilPermanentNoLongerHasACounterOfType(Ref_TargetPermanent, {{CounterType[1]}}))]))",
    "that player returns a permanent they control to its owner's hand unless they pay {{Digits}} life": "ActionList([PlayerMayCost({{ThatPlayer}}, PayLife({{Digits[0]}})), Unless(CostWasPaid, [PutAPermanentIntoItsOwnersHand(ControlledByAPlayer(SinglePlayer({{ThatPlayer}})))])])",
    "that player returns {{a}} {{Permanent}} they control to its owner's hand": "ActionList([PlayerAction({{ThatPlayer}}, PutAPermanentIntoItsOwnersHand(And([{{Permanent[0]}}, ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))])))])",
    "that player reveals a card at random from their hand": "ActionList([PlayerAction({{ThatPlayer}}, RevealACardFromHandAtRandom)])",
    "that player reveals a card at random from their hand. If it's {{a}} {{SpecificCard}}, the player puts it onto the battlefield. Otherwise, the player casts it without paying its mana cost if able": "ActionList([PlayerAction({{ThatPlayer}}, RevealACardFromHandAtRandom), IfElse(ACardWasRevealedThisWay({{SpecificCard[0]}}), [PlayerAction({{ThatPlayer}}, PutCardFromHandOnBattlefield(TheCardRevealedThisWay, [EntersNormally]))], [PlayerMayAction({{ThatPlayer}}, CastTheCardRevealedThisWayWithoutPaying)])])",
    "that player reveals cards from the top of their library until they reveal {{Number}} {{SpecificCards}}, then puts those cards into their graveyard": "ActionList([PlayerAction({{ThatPlayer}}, RevealCardsFromTheTopOfLibraryUntilANumberOfCardsOfTypeAreRevealed({{Number[0]}}, {{SpecificCards[0]}}, [PutTheRemainingCardsIntoGraveyard]))])",
    "that player reveals cards from the top of their library until they reveal {{a}} {{SpecificCard}}. Put that card onto the battlefield under your control. That player puts the rest of the revealed cards into their graveyard": "ActionList([PlayerAction({{ThatPlayer}}, RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed({{SpecificCard[0]}}, [PutTheCardFoundThisWayOntoTheBattlefield([EntersUnderPlayersControl(You)]), PutTheRemainingCardsIntoGraveyard]))])",
    "that player reveals the top card of their library. If it's {{a}} {{SpecificCard}}, the player may put it onto the battlefield": "ActionList([PlayerAction({{ThatPlayer}}, RevealTopCardOfLibrary), If(ACardWasRevealedThisWay({{SpecificCard[0]}}), [PlayerMayAction({{ThatPlayer}}, PutTopOfLibraryOnBattlefield([EntersNormally]))])])",
    "that player reveals the top two cards of their library. You choose one of those cards and put it into their graveyard": "ActionList([PlayerAction({{ThatPlayer}}, RevealTheTopNumberCardsOfLibrary(Integer(2), [APlayerPutsAGenericCardIntoGraveyard(SinglePlayer(You)), LeaveTheRemainingCardsOnTopOfLibraryInTheSameOrder]))])",
    "that player reveals their hand. You choose a card from it. That player exiles that card": "ActionList([PlayerAction({{ThatPlayer}}, RevealHand), ChooseACardFromPlayersRevealedHand(AnyCard, {{ThatPlayer}}), PlayerAction({{ThatPlayer}}, ExileCardFromHand(TheCardInHandChosenThisWay))])",
    "that player reveals their hand. You choose {{a}} {{SpecificCard}} from it. Search that player's graveyard, hand, and library for all cards with the same name as that card and exile them. Then that player shuffles": "ActionList([PlayerAction({{ThatPlayer}}, RevealHandAndPlayerChoosesACard(You, {{SpecificCard[0]}})), SearchPlayersLibraryAndGraveyardAndHand({{ThatPlayer}}, [FindAllCardsOfType(SharesANameWithTheCardChosenThisWay), ExileFoundCards, Shuffle])])",
    "that player sacrifices a creature of their choice that they controlled since the beginning of the turn": "ActionList([PlayerAction({{ThatPlayer}}, SacrificeAPermanent(And([IsCardtype(Creature), ControlledSinceBeginningOfTurn])))])",
    "that player sacrifices half the {{Permanents}} they control of their choice, rounded up": "ActionList([PlayerAction({{ThatPlayer}}, SacrificeHalfOfThePermanentsRoundedUp({{Permanents[0]}}))])",
    "that player sacrifices {{Number}} {{Permanents}} of their choice": "ActionList([PlayerAction({{ThatPlayer}}, SacrificeNumberPermanents({{Number[0]}}, {{Permanents[0]}}))])",
    "that player sacrifices {{a}} {{Permanent}} of their choice": "ActionList([PlayerAction({{ThatPlayer}}, SacrificeAPermanent({{Permanent[0]}}))])",
    "that player sacrifices {{a}} {{Permanent}} of their choice and loses {{Digits}} life": "ActionList([PlayerActions({{ThatPlayer}}, [SacrificeAPermanent({{Permanent[0]}}), LoseLife({{Digits[0]}})])])",
    "that player sacrifices {{a}} {{Permanent}} of their choice unless they pay {{ManaCost}}": "ActionList([PlayerMayCost({{ThatPlayer}}, PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [PlayerAction({{ThatPlayer}}, SacrificeAPermanent({{Permanent[0]}}))])])",
    "that player sacrifices {{a}} {{Permanent}} of their choice. If the player can't, they lose {{Digits}} life": "ActionList([PlayerMustCost({{ThatPlayer}}, SacrificeAPermanent({{Permanent[0]}})), Unless(CostWasPaid, [LoseLife({{Digits[0]}})])])",
    "that player sacrifices {{a}} {{Permanent}} of their choice. If the player can't, you create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}}": "ActionList([PlayerMustCost({{ThatPlayer}}, SacrificeAPermanent({{Permanent[0]}})), Unless(CostWasPaid, [CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])])])])",
    "that player simultaneously untaps each tapped artifact, creature, and land they control and taps each untapped artifact, creature, and land they control": "ActionList([PlayerAction({{ThatPlayer}}, SimultaneouslyTapEachPermanentAndUntapEachPermanent(And([IsUntapped, Or([IsCardtype(Artifact), IsCardtype(Creature), IsCardtype(Land)]), ControlledByAPlayer(SinglePlayer(ActionPlayer))]), And([IsTapped, Or([IsCardtype(Artifact), IsCardtype(Creature), IsCardtype(Land)]), ControlledByAPlayer(SinglePlayer(ActionPlayer))])))])",
    "that player skips their next combat phase": "ActionList([PlayerAction({{ThatPlayer}}, SkipNextCombatPhase)])",
    "that player skips their next untap step": "ActionList([PlayerAction({{ThatPlayer}}, SkipNextUntapStep)])",
    "that player untaps a land they control": "ActionList([PlayerAction({{ThatPlayer}}, UntapAPermanent(And([IsCardtype(Land), ControlledByPlayer(PlayerAction_ThatPlayer)])))])",
    "the next time they would draw a card this turn, instead they exile the top card of their library. They may play it this turn": "ActionList([CreateFutureReplaceWouldDraw(NextTimePlayerWouldDrawACardThisTurn({{ThatPlayer}}), [PlayerAction({{ThatPlayer}}, ExileTopCardOfLibrary), CreatePlayerEffectUntil({{ThatPlayer}}, [MayPlayExiledCard(TheCardExiledThisWay)], UntilEndOfTurn)])])",
    "the player creates {{a}} {{PT}} {{CreatureToken}}": "ActionList([PlayerAction({{ThatPlayer}}, CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])]))])",
    "they can't attack you or planeswalkers you control this turn": "ActionList([CreatePlayerEffectUntil({{ThatPlayer}}, [CantAttackPlayerOrPlaneswalkerControlledBy(You)], UntilEndOfTurn)])",
    "they create a Treasure token": "ActionList([PlayerAction({{ThatPlayer}}, CreateTokens([TreasureToken]))])",
    "they gain {{Digits}} life": "ActionList([PlayerAction({{ThatPlayer}}, GainLife({{Digits[0]}}))])",
    "they get {{Number}} rad counters": "ActionList([PlayerAction({{ThatPlayer}}, GetNumberRadCounters({{Number[0]}}))])",
    "they lose half their life, rounded up": "ActionList([PlayerAction({{ThatPlayer}}, LoseLife(HalfRoundedUp(LifeTotalOfPlayer({{ThatPlayer}}))))])",
    "they lose the game": "ActionList([PlayerAction({{ThatPlayer}}, LoseTheGame)])",
    "they lose {{Digits}} life": "ActionList([PlayerAction({{ThatPlayer}}, LoseLife({{Digits[0]}}))])",
    "they lose {{Digits}} life and you draw a card": "ActionList([PlayerAction({{ThatPlayer}}, LoseLife({{Digits[0]}})), DrawACard])",
    "they lose {{Digits}} life and you gain {{Digits}} life": "ActionList([PlayerAction({{ThatPlayer}}, LoseLife({{Digits[0]}})), GainLife({{Digits[1]}})])",
    "they lose {{Digits}} life and you put {{a}} {{CounterType}} counter on up to one target creature they control": "Targeted([UptoOneTargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))], ActionList([PlayerAction({{ThatPlayer}}, LoseLife({{Digits[0]}})), PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent)]))",
    "they lose {{Digits}} life for each {{Eachable(ThatPlayer)}}": "ActionList([PlayerAction({{ThatPlayer}}, LoseLifeForEach({{Digits[0]}}, {{Eachable(ThatPlayer=PlayerAction_ThatPlayer)[0]}}))])",
    "they may pay {{ManaCost}}. If the player does, they draw a card at the beginning of the next end step": "ActionList([PlayerMayCost({{ThatPlayer}}, PayMana({{ManaCost[0]}})), If(CostWasPaid, [CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PlayerAction({{ThatPlayer}}, DrawACard)]))])])",
    "they mill {{Number}} cards and you get {{Energy}}": "ActionList([PlayerAction({{ThatPlayer}}, MillNumberCards({{Number[0]}})), GetEnergy(Integer({{Energy[0]}}))])",
    "they return a land they control to its owner's hand": "ActionList([PlayerAction({{ThatPlayer}}, PutAPermanentIntoItsOwnersHand(And([IsCardtype(Land), ControlledByAPlayer(SinglePlayer(ActionPlayer))])))])",
    "untap all {{Permanents}}. Each opponent attacking that player untaps all {{Permanents}} they control": "ActionList([UntapEachPermanent({{Permanents[0]}}), EachPlayerAction(And([Opponent, IsAttackingPlayer({{ThatPlayer}})]), UntapEachPermanent(And([{{Permanents[1]}}, ControlledByAPlayer(SinglePlayer(EachablePlayer))])))])",
    "until your next turn, if a source would deal damage to that player or a permanent that player controls, it deals double that damage instead": "ActionList([CreateReplaceWouldDealDamageUntil(DamageWouldBeDealtByASourceToARecipient(AnyDamageSource, APlayerOrAPermanent(SinglePlayer({{ThatPlayer}}), And([IsPermanent, ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))), [DealDamageInstead(Twice(WouldDealDamage_ThatMuchDamage))], UntilPlayersNextTurn(You))])",
    "you and that player each draw a card": "ActionList([EachPlayerAction(Or([SinglePlayer(You), SinglePlayer({{ThatPlayer}})]), DrawACard)])",
    "you create a Treasure token for each {{Eachable(ThatPlayer)}}": "ActionList([CreateTokens([NumberTokens({{Eachable(ThatPlayer=^ThatPlayer)[0]}}, TreasureToken)])])",
    "you create {{a}} {{PT}} {{CreatureToken}} and that player mills {{Number}} cards": "ActionList([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])]), PlayerAction({{ThatPlayer}}, MillNumberCards({{Number[0]}}))])",
    "you draw a card and that opponent discards a card": "ActionList([DrawACard, PlayerAction({{ThatPlayer}}, DiscardACard)])",
    "you draw a card. Each opponent attacking that player does the same": "ActionList([DrawACard, EachPlayerAction(And([Opponent, IsAttackingPlayer({{ThatPlayer}})]), DrawACard)])",
    "you gain life equal to {{GameNumber(ThatPlayer)}}": "ActionList([GainLife({{GameNumber(ThatPlayer=^ThatPlayer)[0]}})])",
    "you gain {{Digits}} life and that player loses {{Digits}} life": "ActionList([GainLife({{Digits[0]}}), PlayerAction({{ThatPlayer}}, LoseLife({{Digits[1]}}))])",
    "you gain {{Digits}} life for each {{Eachable(ThatPlayer)}}": "ActionList([GainLifeForEach({{Digits[0]}}, {{Eachable(ThatPlayer=^ThatPlayer)[0]}})])",
    "you gain {{Digits}} life. Each opponent attacking that player does the same": "ActionList([GainLife({{Digits[0]}}), EachPlayerAction(And([Opponent, IsAttackingPlayer({{ThatPlayer}})]), GainLife({{Digits[0]}}))])",
    "you manifest the top card of that player's library": "ActionList([ManifestTheTopCardOfPlayersLibrary({{ThatPlayer}})])",
    "you may cast target {{SpecificCard}} from that player's graveyard without paying its mana cost. If that spell would be put into a graveyard, exile it instead": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer({{ThatPlayer}}))]))], ActionList([MayAction(CastGraveyardCardWithoutPayingIntoExile(Ref_TargetGraveyardCard))]))",
    "you may cast target {{SpecificCard}} from that player's graveyard, and mana of any type can be spent to cast that spell": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer({{ThatPlayer}}))]))], ActionList([MayCastGraveyardCardAndMaySpendManaAsThoughAnyType(Ref_TargetGraveyardCard)]))",
    "you may cast {{a}} {{PotentialSpell}} from that player's graveyard this turn, and you may spend mana as though it were mana of any color to cast that spell": "ActionList([CreatePlayerEffectUntil(You, [MayCastASpellFromGraveyardIntoExileAndMaySpendManaAsThoughAnyColorToCastOnce({{PotentialSpell[0]}}, {{ThatPlayer}})], UntilEndOfTurn)])",
    "you may destroy target {{Permanent}} that opponent controls": "Targeted([TargetPermanent(And([{{Permanent[0]}}, ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))], ActionList([MayAction(DestroyPermanent(Ref_TargetPermanent))]))",
    "you may destroy target {{Permanent}} that player controls": "Targeted([TargetPermanent(And([{{Permanent[0]}}, ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))], ActionList([MayAction(DestroyPermanent(Ref_TargetPermanent))]))",
    "you may discard a card. When you do, destroy target creature or planeswalker that player controls": "ActionList([MayCost(DiscardACard), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPermanent(And([Or([IsCardtype(Creature), IsCardtype(Planeswalker)]), ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))], ActionList([DestroyPermanent(Ref_TargetPermanent)])))])])",
    "you may discard {{a}} {{SpecificCard}}. When you do, destroy target creature or planeswalker that player controls": "ActionList([MayCost(DiscardACardOfType({{SpecificCard[0]}})), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPermanent(And([Or([IsCardtype(Creature), IsCardtype(Planeswalker)]), ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))], ActionList([DestroyPermanent(Ref_TargetPermanent)])))])])",
    "you may draw a card unless that player pays {{ManaCost}}": "ActionList([PlayerMayCost({{ThatPlayer}}, PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [MayAction(DrawACard)])])",
    "you may exile target card from that player's graveyard": "Targeted([TargetGraveyardCard(InAPlayersGraveyard(SinglePlayer({{ThatPlayer}})))], ActionList([MayAction(ExileGraveyardCard(Ref_TargetGraveyardCard))]))",
    "you may exile target {{Permanent}} that player controls": "Targeted([TargetPermanent(And([{{Permanent[0]}}, ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))], ActionList([MayAction(ExilePermanent(Ref_TargetPermanent))]))",
    "you may have that player discard a card": "ActionList([MayAction(HavePlayerTakeAction({{ThatPlayer}}, DiscardACard))])",
    "you may have that player lose {{Digits}} life": "ActionList([MayAction(HavePlayerTakeAction({{ThatPlayer}}, LoseLife({{Digits[0]}})))])",
    "you may have that player lose {{Digits}} life. If you do, you gain {{Digits}} life": "ActionList([MayCost(HavePlayerTakeAction({{ThatPlayer}}, LoseLife({{Digits[0]}}))), If(CostWasPaid, [GainLife({{Digits[0]}})])])",
    "you may have that player return target {{SpecificCard}} from their graveyard to their hand. If you do, that player chooses {{a}} {{SpecificCard}} in your graveyard, then you put it onto the battlefield under your control": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer({{ThatPlayer}}))]))], ActionList([MayCost(HavePlayerTakeAction({{ThatPlayer}}, PutGraveyardCardIntoHand(Ref_TargetGraveyardCard))), If(CostWasPaid, [PlayerAction({{ThatPlayer}}, ChooseACardInPlayersGraveyard({{SpecificCard[1]}}, You)), PutGraveyardCardOntoBattlefield(TheChosenGraveyardCard, [EntersUnderPlayersControl(You)])])]))",
    "you may look at that player's hand. If you do, you may cast a spell from among those cards without paying its mana cost": "ActionList([MayAction(LookAtPlayersHandAndMayChooseACardToCastWithoutPaying({{ThatPlayer}}, AnyCard))])",
    "you may pay {{ManaCostX}}. If you do, that player reveals X cards from their hand and you choose one of them. That player discards that card": "ActionList([MayCost(PayManaAnyX({{ManaCostX[0]}})), If(CostWasPaid, [PlayerAction({{ThatPlayer}}, RevealANumberOfCardsFromHandAndPlayerChoosesACardToDiscard(ValueX, You))])])",
    "you may pay {{ManaCostX}}. When you do, put any number of target creature cards with total mana value X or less from that player's graveyard onto the battlefield under your control": "ActionList([MayCost(PayManaAnyX({{ManaCostX[0]}})), If(CostWasPaid, [ReflexiveTrigger(Targeted([AnyNumberOfTargetGroupGraveyardCards(And([IsCardtype(Creature), InAPlayersGraveyard(SinglePlayer({{ThatPlayer}}))]), TotalManaValueIs(EqualTo(ValueX)))], ActionList([MayAction(PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersUnderPlayersControl(You)]))])))])])",
    "you may pay {{ManaCost}} if {{Condition(ThatPlayer)}}. When you do, that player loses the game": "ActionList([If({{Condition(ThatPlayer=^ThatPlayer)[0]}}, [MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [ReflexiveTrigger(ActionList([PlayerAction({{ThatPlayer}}, LoseTheGame)]))])])])",
    "you may pay {{ManaCost}}. If you do, choose a color, then that player reveals their hand and discards all cards of that color": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [ChooseAColor(AnyColor), PlayerAction({{ThatPlayer}}, RevealHandAndDiscardEachCard(IsColor(TheChosenColor)))])])",
    "you may pay {{ManaCost}}. If you do, look at that player's hand and choose a card from it. The player discards that card": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [LookAtPlayersHandAndChooseACardToDiscard({{ThatPlayer}}, AnyCard)])])",
    "you may pay {{ManaCost}}. If you do, search that player's library for a card and exile it, then the player shuffles": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [SearchPlayersLibrary({{ThatPlayer}}, [FindAGenericCard, ExileFoundCards, Shuffle])])])",
    "you may put target {{SpecificCard}} from that player's graveyard onto the battlefield under your control": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer({{ThatPlayer}}))]))], ActionList([MayAction(PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersUnderPlayersControl(You)]))]))",
    "you may put {{a}} {{SpecificCard}} from your hand onto the battlefield tapped and attacking that opponent": "ActionList([MayAction(PutACardFromHandOnBattlefield({{SpecificCard[0]}}, [EntersTapped, EntersAttackingPlayer({{ThatPlayer}})]))])",
    "you may remove {{a}} {{CounterType}} counter from a card that player owns in exile. If you do, draw a card and create {{Number}} Treasure tokens": "ActionList([MayCost(RemoveACounterOfTypeFromAnExiledCard({{CounterType[0]}}, OwnedByAPlayer(SinglePlayer({{ThatPlayer}})))), If(CostWasPaid, [DrawACard, CreateTokens([NumberTokens({{Number[0]}}, TreasureToken)])])])",
    "you may return target {{Permanent}} that player controls to its owner's hand": "Targeted([TargetPermanent(And([{{Permanent[0]}}, ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))], ActionList([MayAction(PutPermanentIntoItsOwnersHand(Ref_TargetPermanent))]))",
    "you may reveal your hand. If cards with at least {{Number}} different mana values are revealed this way, that player loses the game": "ActionList([MayCost(RevealHand), If(CostWasPaid, [If(NumCardsFromHandRevealedThisWayPassGroupFilter(GreaterThanOrEqualTo({{Number[0]}}), AnyCard, DifferentManaValues), [PlayerAction({{ThatPlayer}}, LoseTheGame)])])])",
    "you may tap {{Number}} {{Permanents}}. When you do, target creature that player controls gets {{PTMod}} and gains {{Hasable}} until end of turn. Goad that creature": "ActionList([MayCost(TapNumberPermanents({{Number[0]}}, {{Permanents[0]}})), If(CostWasPaid, [ReflexiveTrigger(Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), GoadCreature(Ref_TargetPermanent)])))])])"
  },
  "{{TriggerActions(ThatPlayer,ThatCreature)}}": {
    "for each other opponent, you may create a token that's a copy of that creature, tapped and attacking that opponent. Exile those tokens at the beginning of the next end step": "ActionList([ActionForEachPlayer(Opponent, [MayActions([CreateTokensWithFlags([TokenCopyOfPermanent({{ThatCreature}}, NoTokenCopyEffects)], [EntersTapped, EntersAttackingPlayer(EachablePlayer)]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([ExileEachPermanent(ThePermanentsPutOnTheBattlefieldThisWay)]))])])])",
    "that player exiles the top card of their library. Until end of turn, that creature's controller may play that card and they may spend mana as though it were mana of any color to cast that spell": "ActionList([PlayerAction({{ThatPlayer}}, ExileTopCardOfLibrary), CreatePlayerEffectUntil({{ThatPlayer}}, [MayPlayExiledCardAndMaySpendManaAsThoughAnyColorToCast(TheCardExiledThisWay)], UntilEndOfTurn)])",
    "that player may discard a card at random. If the player does, untap that creature": "ActionList([PlayerMayCost({{ThatPlayer}}, DiscardACardAtRandom), If(CostWasPaid, [UntapPermanent({{ThatCreature}})])])",
    "that player may pay {{ManaCost}}. If the player does, untap that creature": "ActionList([PlayerMayCost({{ThatPlayer}}, PayMana({{ManaCost[0]}})), If(CostWasPaid, [UntapPermanent({{ThatCreature}})])])",
    "that player may pay {{ManaCost}}. If the player does, untap the creature": "ActionList([PlayerMayCost({{ThatPlayer}}, PayMana({{ManaCost[0]}})), If(CostWasPaid, [UntapPermanent({{ThatCreature}})])])",
    "that player reveals the top card of their library. If that card is {{a}} {{SpecificCard}}, destroy that creature. Otherwise, it gets {{PTMod}} until end of turn": "ActionList([PlayerAction({{ThatPlayer}}, RevealTopCardOfLibrary), IfElse(ACardWasRevealedThisWay({{SpecificCard[0]}}), [DestroyPermanent({{ThatCreature}})], [CreatePermanentLayerEffectUntil({{ThatCreature}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])])",
    "that player sacrifices that creature": "ActionList([PlayerAction({{ThatPlayer}}, SacrificePermanent({{ThatCreature}}))])",
    "that player sacrifices that creature unless they pay {{ManaCost}}": "ActionList([PlayerMayCost({{ThatPlayer}}, PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [PlayerAction({{ThatPlayer}}, SacrificePermanent({{ThatCreature}}))])])"
  },
  "{{TriggerActions(ThatPlayer,ThatLand)}}": {
    "destroy that land unless that player pays {{ManaCost}} or {{Digits}} life": "ActionList([PlayerMayCost({{ThatPlayer}}, Or([PayMana({{ManaCost[0]}}), PayLife({{Digits[0]}})])), Unless(CostWasPaid, [DestroyPermanent({{ThatLand}})])])"
  },
  "{{TriggerActions(ThatPlayer,ThatMuch)}}": {
    "create a Treasure token. Then exile from that player's library a random card with mana value equal to the damage dealt. You may cast that card this turn": "ActionList([CreateTokens([TreasureToken]), ExileACardOfTypeFromPlayersLibraryAtRandom(ManaValueIs(EqualTo({{ThatMuch}})), {{ThatPlayer}}), CreatePlayerEffectUntil(You, [MayCastExiledCard(TheCardExiledThisWay)], UntilEndOfTurn)])",
    "exile the top X cards of their library, where X is the amount of damage dealt. You may cast any number of spells with mana value X or less from among them without paying their mana costs": "ActionList([ExileTheTopNumberCardsOfPlayersLibrary({{ThatMuch}}, {{ThatPlayer}}), CastAnyNumberOfSpellsFromExileWithoutPaying(ManaValueIs(LessThanOrEqualTo({{ThatMuch}})), TheCardsExiledThisWay)])",
    "that player creates that many {{PT}} {{CreatureTokens}}": "ActionList([PlayerAction({{ThatPlayer}}, CreateTokens([NumberTokens({{ThatMuch}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))]))])",
    "that player discards cards equal to the damage": "ActionList([PlayerAction({{ThatPlayer}}, DiscardNumberCards({{ThatMuch}}))])",
    "that player discards that many cards": "ActionList([PlayerAction({{ThatPlayer}}, DiscardNumberCards({{ThatMuch}}))])",
    "that player exiles that many cards from the top of their library. You may play lands from among those cards for as long as they remain exiled": "ActionList([PlayerAction({{ThatPlayer}}, ExileTheTopNumberCardsOfLibrary({{ThatMuch}})), CreatePlayerEffect(You, [MayPlayLandsFromAmongExiled(TheCardsExiledThisWay)])])",
    "that player gets twice that many rad counters": "ActionList([PlayerAction({{ThatPlayer}}, GetNumberRadCounters(Twice({{ThatMuch}})))])",
    "that player mills a card for each 1 damage dealt to them. If the player mills at least one {{SpecificCard}} this way, you draw a card": "ActionList([PlayerAction({{ThatPlayer}}, MillNumberCards({{ThatMuch}})), If(ACardWasMilledThisWay({{SpecificCard[0]}}), [DrawACard])])",
    "that player mills that many cards": "ActionList([PlayerAction({{ThatPlayer}}, MillNumberCards({{ThatMuch}}))])",
    "that player mills twice that many cards": "ActionList([PlayerAction({{ThatPlayer}}, MillNumberCards(Twice({{ThatMuch}})))])",
    "they get that many poison counters": "ActionList([PlayerAction({{ThatPlayer}}, GetNumberPoisonCounters({{ThatMuch}}))])",
    "they get that many rad counters": "ActionList([PlayerAction({{ThatPlayer}}, GetNumberRadCounters({{ThatMuch}}))])",
    "you and that player each draw that many cards": "ActionList([EachPlayerAction(Or([SinglePlayer(You), SinglePlayer({{ThatPlayer}})]), DrawNumberCards({{ThatMuch}}))])",
    "you and that player each gain that much life": "ActionList([EachPlayerAction(Or([SinglePlayer(You), SinglePlayer({{ThatPlayer}})]), GainLife({{ThatMuch}}))])"
  },
  "{{TriggerActions(ThatPlayer,ThatPermanent)}}": {
    "it deals {{Digits}} damage to each creature that player controls": "ActionList([PermanentDealsDamage({{ThatPermanent}}, {{Digits[0]}}, EachPermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))])))])",
    "it deals {{Digits}} damage to each creature without {{CheckHasable}} that player controls": "ActionList([PermanentDealsDamage({{ThatPermanent}}, {{Digits[0]}}, EachPermanent(And([IsCardtype(Creature), DoesntHaveAbility({{CheckHasable[0]}}), ControlledByAPlayer(SinglePlayer({{ThatPlayer}}))])))])",
    "that player sacrifices it unless they pay {{ManaCostX}}, where X is {{GameNumber(ThatPermanent)}}": "ActionList([PlayerMayCost({{ThatPlayer}}, PayManaX({{ManaCostX[0]}}, {{GameNumber(ThatPermanent=^ThatPermanent)[0]}})), Unless(CostWasPaid, [PlayerAction({{ThatPlayer}}, SacrificePermanent({{ThatPermanent}}))])])",
    "you may sacrifice it. If you do, that player discards a card for each {{Eachable(ThatPlayer)}}": "ActionList([MayCost(SacrificePermanent({{ThatPermanent}})), If(CostWasPaid, [PlayerAction({{ThatPlayer}}, DiscardNumberCards({{Eachable(ThatPlayer=^ThatPlayer)[0]}}))])])",
    "you may sacrifice it. If you do, that player discards {{Number}} cards": "ActionList([MayCost(SacrificePermanent({{ThatPermanent}})), If(CostWasPaid, [PlayerAction({{ThatPlayer}}, DiscardNumberCards({{Number[0]}}))])])"
  },
  "{{TriggerActions(ThatSacrificedPermanent)}}": {
    "exile cards equal to its mana value from the top of target player's library. Until your next end step, you may play those cards, and mana of any type can be spent to cast those spells": "Targeted([TargetPlayer(AnyPlayer)], ActionList([ExileTheTopNumberCardsOfPlayersLibrary(ManaValueOfPermanent({{ThatSacrificedPermanent}}), Ref_TargetPlayer), CreatePlayerEffectUntil(You, [MayPlayExiledCardsAndMaySpendManaAsThoughAnyTypeToCast(TheCardsExiledThisWay)], UntilPlayersNextEndStep(You))]))",
    "exile it": "ActionList([ExileGraveyardCard({{ThatSacrificedPermanent}})])",
    "it deals {{Digits}} damage to any target": "Targeted([AnyTarget], ActionList([PermanentDealsDamage({{ThatSacrificedPermanent}}, {{Digits[0]}}, Ref_AnyTarget)]))",
    "it perpetually gains \"{{PerpetualQuotedAbility}}\"": "ActionList([CreatePerpetualSacrificedCardEffect([AddAbility([{{PerpetualQuotedAbility[0]}}])])])",
    "put that card onto the battlefield under your control": "ActionList([PutGraveyardCardOntoBattlefield({{ThatSacrificedPermanent}}, [EntersUnderPlayersControl(You)])])",
    "return it to the battlefield transformed under its owner's control at the beginning of the next end step": "ActionList([CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutGraveyardCardOntoBattlefield({{ThatSacrificedPermanent}}, [EntersTransformed, EntersUnderOwnersControl])]))])"
  },
  "{{TriggerActions(ThatScheme)}}": {
    "it deals damage equal to {{GameNumber}} to each {{Creature}}": "ActionList([SchemeDealsDamage({{ThatScheme}}, {{GameNumber[0]}}, EachPermanent({{Creature[0]}}))])",
    "it deals damage to each opponent equal to {{GameNumber(ThatPlayer)}}": "ActionList([SchemeDealsDamage({{ThatScheme}}, {{GameNumber(ThatPlayer=DealsDamage_ThatPlayer)[0]}}, EachPlayer(Opponent))])",
    "it deals {{Digits}} damage to up to one target {{Creature}}. Create {{a}} {{PT}} {{CreatureToken}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([SchemeDealsDamage({{ThatScheme}}, {{Digits[0]}}, Permanent(Ref_TargetPermanent)), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])]))"
  },
  "{{TriggerActions(ThatSpell)}}": {
    "amass Orcs X, where X is that spell's mana value": "ActionList([Amass(ManaValueOfSpell({{ThatSpell}}), Orc)])",
    "change the target to {{EnchantedCreature}} if able": "ActionList([ChangeTheTargetOfSpellToPermanent({{ThatSpell}}, HostPermanent)])",
    "choose one -\n* {{TriggerActions_Modal(ThatSpell)}}.\n* {{TriggerActions_Modal}}": "Modal_ChooseOne([{{TriggerActions_Modal(ThatSpell=^ThatSpell)[0]}}, {{TriggerActions_Modal[0]}}])",
    "conjure a duplicate of it into your hand. The duplicate perpetually gains {{PerpetualHasable}}": "ActionList([ConjureDuplicateOfSpellIntoHand({{ThatSpell}}), CreatePerpetualCardInHandEffect(TheCardConjuredIntoHandThisWay, [AddAbility([{{PerpetualHasable[0]}}])])])",
    "copy it": "ActionList([CopySpell({{ThatSpell}})])",
    "copy it for each other {{Spell}} you've cast before it this turn. You may choose new targets for the copies": "ActionList([CopySpellForEachAndMayChooseNewTargets({{ThatSpell}}, NumSpellsCastByPlayerBeforeSpellThisTurn({{Spell[0]}}, You, {{ThatSpell}}))])",
    "copy it for each other {{Spell}} you've cast this turn. You may choose new targets for the copies": "ActionList([CopySpellForEachAndMayChooseNewTargets({{ThatSpell}}, NumSpellsCastByPlayerThisTurn(And([Other({{ThatSpell}}), {{Spell[0]}}]), You))])",
    "copy it for each {{Eachable}}": "ActionList([CopySpellForEach({{ThatSpell}}, {{Eachable[0]}})])",
    "copy it for each {{Eachable}}. You may choose new targets for the copies": "ActionList([CopySpellForEachAndMayChooseNewTargets({{ThatSpell}}, {{Eachable[0]}})])",
    "copy it if {{Condition}}": "ActionList([If({{Condition[0]}}, [CopySpell({{ThatSpell}})])])",
    "copy it if {{Condition}}, then copy it if {{Condition}}. You may choose new targets for the copies": "ActionList([If({{Condition[0]}}, [CopySpellAndMayChooseNewTargets({{ThatSpell}})]), If({{Condition[1]}}, [CopySpellAndMayChooseNewTargets({{ThatSpell}})])])",
    "copy it if {{Condition}}. You may choose new targets for the copy": "ActionList([If({{Condition[0]}}, [CopySpellAndMayChooseNewTargets({{ThatSpell}})])])",
    "copy it twice. You may choose new targets for the copies": "ActionList([CopySpellNumberTimesAndMayChooseNewTargets({{ThatSpell}}, Integer(2))])",
    "copy it, except the copy isn't legendary": "ActionList([CopySpellWithModifiers({{ThatSpell}}, [RemoveSupertypes([Legendary])])])",
    "copy it, except the copy isn't legendary. You may choose new targets for the copy": "ActionList([CopySpellAndMayChooseNewTargetsWithEffects({{ThatSpell}}, [RemoveSupertypes([Legendary])])])",
    "copy it, then exile the spell you cast with {{Number}} {{CounterType}} counters on it. If it doesn't have suspend, it gains suspend": "ActionList([CopySpell(Trigger_ThatSpell), ExileSpellWithANumberOfCountersOnIt(Trigger_ThatSpell, {{Number[0]}}, {{CounterType[0]}}), CreateExiledCardEffect(TheCardExiledThisWay, [AddAbility([BasicSuspend])])])",
    "copy it. If {{Condition}}, copy that spell twice instead. You may choose new targets for the copies": "ActionList([IfElse({{Condition[0]}}, [CopySpellNumberTimesAndMayChooseNewTargets({{ThatSpell}}, Integer(2))], [CopySpellAndMayChooseNewTargets({{ThatSpell}})])])",
    "copy it. You may choose new targets for the copy": "ActionList([CopySpellAndMayChooseNewTargets({{ThatSpell}})])",
    "copy it. You may choose new targets for the copy. If it's a permanent spell, the copy gains {{Hasable}} and \"{{QuotedAbility}}\"": "ActionList([CopySpellAndMayChooseNewTargetsWithEffects({{ThatSpell}}, [IfPermanentSpell([AddAbility([{{Hasable[0]}}]), AddAbility([{{QuotedAbility[0]}}])])])])",
    "copy that spell": "ActionList([CopySpell({{ThatSpell}})])",
    "copy that spell if it targets a permanent or player, and you may choose new targets for the copy. If you don't copy a spell this way, draw a card": "ActionList([IfElse(SpellPassesFilter(Trigger_ThatSpell, Or([TargetsAPermanent(AnyPermanent), TargetsAPlayer(AnyPlayer)])), [MustCost(CopySpellAndMayChooseNewTargets(Trigger_ThatSpell)), If(CostWasntPaid, [DrawACard])], [DrawACard])])",
    "copy that spell. You may choose new targets for the copy": "ActionList([CopySpellAndMayChooseNewTargets({{ThatSpell}})])",
    "counter it": "ActionList([CounterSpell({{ThatSpell}})])",
    "counter it if a card with the same name is in a graveyard or a nontoken permanent with the same name is on the battlefield": "ActionList([If(Or([AnyCardInAnyPlayersGraveyardPassesFilter(SharesANameWithSpell({{ThatSpell}}), AnyPlayer), APermanentPassesFilter(And([IsNonToken, SharesANameWithSpell({{ThatSpell}})]), OnTheBattlefield)]), [CounterSpell({{ThatSpell}})])])",
    "counter it unless you sacrifice {{a}} {{Permanent}}": "ActionList([MayCost(SacrificeAPermanent({{Permanent[0]}})), Unless(CostWasPaid, [CounterSpell({{ThatSpell}})])])",
    "counter that spell": "ActionList([CounterSpell({{ThatSpell}})])",
    "counter that spell unless its controller discards a card": "ActionList([PlayerMayCost(ControllerOfSpell({{ThatSpell}}), DiscardACard), Unless(CostWasPaid, [CounterSpell({{ThatSpell}})])])",
    "counter that spell unless you sacrifice {{a}} {{Permanent}}": "ActionList([MayCost(SacrificeAPermanent({{Permanent[0]}})), Unless(CostWasPaid, [CounterSpell({{ThatSpell}})])])",
    "create X {{PT}} {{CreatureTokens}} named {{NamedCard}}, where X is {{GameNumber(ThatSpell)}}": "ActionList([CreateTokens([NumberTokens({{GameNumber(ThatSpell=^ThatSpell)[0]}}, NamedTokenWithPT({{NamedCard[0]}}, {{PT[0]}}, {{CreatureTokens[0]}}, []))])])",
    "create X {{PT}} {{CreatureTokens}}, where X is {{GameNumber(ThatSpell)}}": "ActionList([CreateTokens([NumberTokens({{GameNumber(ThatSpell=^ThatSpell)[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])])",
    "create X {{PT}} {{CreatureTokens}}, where X is {{GameNumber(ThatSpell)}}. They gain {{Hasable}} until end of turn": "ActionList([CreateTokens([NumberTokens({{GameNumber(ThatSpell=^ThatSpell)[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))]), CreateEachPermanentLayerEffectUntil(TheCreatedTokens, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "create {{a}} {{PTX}} {{CreatureToken}} with {{Hasable}} and {{Hasable}}, where X is {{GameNumber(ThatSpell)}}. Exile that token at the beginning of the next end step": "ActionList([CreateTokens([TokenWithPT(PTX({{PTX[0]}}, {{GameNumber(ThatSpell=^ThatSpell)[0]}}), {{CreatureToken[0]}}, [{{Hasable[0]}}, {{Hasable[1]}}])]), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([ExilePermanent(TheCreatedToken)]))])",
    "create {{a}} {{PTX}} {{CreatureToken}} with {{Hasable}}, where X is {{GameNumber(ThatSpell)}}": "ActionList([CreateTokens([TokenWithPT(PTX({{PTX[0]}}, {{GameNumber(ThatSpell=^ThatSpell)[0]}}), {{CreatureToken[0]}}, [{{Hasable[0]}}])])])",
    "create {{a}} {{PTX}} {{CreatureToken}}, where X is {{GameNumber(ThatSpell)}}": "ActionList([CreateTokens([TokenWithPT(PTX({{PTX[0]}}, {{GameNumber(ThatSpell=^ThatSpell)[0]}}), {{CreatureToken[0]}}, [])])])",
    "create {{a}} {{PT}} {{CreatureToken}}. If {{Condition(ThatSpell)}}, create {{Number}} of those tokens instead": "ActionList([IfElse({{Condition(ThatSpell=^ThatSpell)[0]}}, [CreateTokens([NumberTokens({{Number[0]}}, TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, []))])], [CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])])])])",
    "create {{a}} {{PT}} {{CreatureToken}}. Put X {{CounterType}} counters on it, where X is {{GameNumber(ThatSpell)}}": "ActionList([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])]), PutNumberCountersOfTypeOnPermanent({{GameNumber(ThatSpell=^ThatSpell)[0]}}, {{CounterType[0]}}, TheCreatedToken)])",
    "destroy all permanents with that spell's mana value": "ActionList([DestroyEachPermanent(ManaValueIs(EqualTo(ManaValueOfSpell({{ThatSpell}}))))])",
    "discover X, where X is that spell's mana value": "ActionList([Discover(ManaValueOfSpell({{ThatSpell}}))])",
    "double the value of X": "ActionList([DoubleXValueOfSpell({{ThatSpell}})])",
    "each opponent mills {{Number}} cards. When one or more cards are milled this way, exile target {{SpecificCard}} with equal or lesser mana value than that spell from an opponent's graveyard. Copy the exiled card. You may cast the copy without paying its mana cost": "ActionList([EachPlayerAction(Opponent, MillNumberCards({{Number[0]}})), If(ACardWasMilledThisWay(AnyCard), [ReflexiveTrigger(Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, ManaValueIs(LessThanOrEqualTo(ManaValueOfSpell({{ThatSpell}}))), InAPlayersGraveyard(Opponent)]))], ActionList([ExileGraveyardCard(Ref_TargetGraveyardCard), CopyExiledCard(TheCardExiledThisWay), MayAction(CastCopiedCardWithoutPaying)])))])])",
    "each opponent reveals the top card of their library. If any of those cards shares a card type with that spell, copy that spell, you may choose new targets for the copy, and each opponent draws a card. Otherwise, you draw a card": "ActionList([EachPlayerAction(Opponent, RevealTopCardOfLibrary), IfElse(ACardWasRevealedThisWay(SharesACardtypeWithSpell({{ThatSpell}})), [CopySpellAndMayChooseNewTargets({{ThatSpell}}), EachPlayerAction(Opponent, DrawACard)], [DrawACard])])",
    "each player returns all {{Cards(ThatSpell)}} from their graveyard to the battlefield": "ActionList([EachPlayerAction(AnyPlayer, ReturnEachCardFromPlayersGraveyardToBattlefield({{Cards(ThatSpell=^ThatSpell)[0]}}, ActionPlayer, [EntersNormally]))])",
    "exile cards from the top of your library until you exile {{a}} {{SpecificCard}} with lesser mana value. You may cast that card without paying its mana cost. Put the rest on the bottom of your library in a random order": "ActionList([ExileCardsFromTheTopOfLibraryUntilACardOfTypeIsExiled(And([{{SpecificCard[0]}}, ManaValueIs(LessThan(ManaValueOfSpell({{ThatSpell}})))])), MayAction(CastExiledCardWithoutPaying(TheExiledCardFoundThisWay)), PutEachExiledCardOnTheBottomOfTheirOwnersLibraryInARandomOrder(TheCardsExiledThisWay)])",
    "exile it instead of putting it into a graveyard as it resolves": "ActionList([CreateSpellEffect({{ThatSpell}}, [ResolvesIntoExileInsteadOfGraveyard])])",
    "exile it with {{Number}} {{CounterType}} counters on it. It gains suspend. Then investigate": "ActionList([ExileSpellWithANumberOfCountersOnIt({{ThatSpell}}, {{Number[0]}}, {{CounterType[0]}}), CreateExiledCardEffect(TheCardExiledThisWay, [AddAbility([BasicSuspend])]), Investigate])",
    "exile that card instead of putting it into your graveyard as it resolves. If you do, return it to your hand at the beginning of the next end step": "ActionList([CreateSpellEffect({{ThatSpell}}, [AsResolves([ExileResolvingSpell, CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutExiledCardIntoOwnersHand(TheCardExiledThisWay)]))])])])",
    "exile that card with {{Number}} {{CounterType}} counters on it instead of putting it into your graveyard as it resolves. Then if the exiled card doesn't have suspend, it gains suspend": "ActionList([CreateSpellEffect({{ThatSpell}}, [AsResolves([ExileResolvingSpellWithNumberCountersOfTypeAndEffects({{Number[0]}}, {{CounterType[0]}}, [AddAbility([BasicSuspend])])])])])",
    "exile that spell. If you do, create a token that's a copy of a random {{Card(ThatSpell)}}": "ActionList([MustCost(ExileSpell({{ThatSpell}})), If(CostWasPaid, [CreateTokens([TokenCopyOfACardAtRandom({{Card(ThatSpell=^ThatSpell)[0]}})])])])",
    "flip a coin. If you lose the flip, return that spell to its owner's hand. If you win the flip, copy that spell, and you may choose new targets for the copy": "ActionList([FlipACoin_OnWinAndLose([CopySpellAndMayChooseNewTargets({{ThatSpell}})], [ReturnSpellToOwnersHand({{ThatSpell}})])])",
    "for each of that spell's colors, each opponent loses 1 life and you gain 1 life": "ActionList([EachPlayerAction(Opponent, LoseLife(TheNumberOfColorsSpellIs({{ThatSpell}}))), GainLife(TheNumberOfColorsSpellIs({{ThatSpell}}))])",
    "incubate X, where X is that spell's mana value": "ActionList([Incubate(ManaValueOfSpell({{ThatSpell}}))])",
    "it becomes {{a}} {{Black}} {{Zombie}} in addition to its other colors and types, has {{Hasable}}, and has base power and toughness {{PT}}": "ActionList([CreateSpellEffect({{ThatSpell}}, [AddColor(SimpleColorList([{{Black[0]}}])), AddCreatureType({{Zombie[0]}}), AddAbility([{{Hasable[0]}}]), SetPT({{PT[0]}})])])",
    "it becomes {{a}} {{Black}} {{Zombie}} {{Zombie}}": "ActionList([CreateSpellEffect({{ThatSpell}}, [AddColor(SimpleColorList([{{Black[0]}}])), AddCreatureType({{Zombie[0]}}), AddCreatureType({{Zombie[1]}})])])",
    "it gains \"{{QuotedAbility}}\"": "ActionList([CreateSpellEffect({{ThatSpell}}, [AddAbility([{{QuotedAbility[0]}}])])])",
    "it gains '{{QuotedAbility}}'": "ActionList([CreateSpellEffect({{ThatSpell}}, [AddAbility([{{QuotedAbility[0]}}])])])",
    "it gains bloodthirst {{Digits}}": "ActionList([CreateSpellEffect({{ThatSpell}}, [Bloodthirst({{Digits[0]}})])])",
    "it gains devour {{Digits}}": "ActionList([CreateSpellEffect({{ThatSpell}}, [Devour(IsCardtype(Creature), {{Digits[0]}})])])",
    "it gains rebound": "ActionList([CreateSpellEffect({{ThatSpell}}, [Rebound])])",
    "it gains sunburst": "ActionList([CreateSpellEffect({{ThatSpell}}, [Sunburst])])",
    "it perpetually gains {{PerpetualHasable}}": "ActionList([CreatePerpetualSpellEffect({{ThatSpell}}, [AddAbility([{{PerpetualHasable[0]}}])])])",
    "it perpetually gets {{PTModX}}, where X is its power": "ActionList([CreatePerpetualSpellEffect({{ThatSpell}}, [AdjustPTX({{PTModX[0]}}, PowerOfSpell({{ThatSpell}}))])])",
    "it perpetually gets {{PTModX}}, where X is the noted number": "ActionList([CreatePerpetualSpellEffect({{ThatSpell}}, [AdjustPTX({{PTModX[0]}}, TheNotedNumber)])])",
    "it perpetually gets {{PTMod}}": "ActionList([CreatePerpetualSpellEffect({{ThatSpell}}, [AdjustPT({{PTMod[0]}})])])",
    "it perpetually gets {{PTMod}} and gains {{PerpetualHasable}}": "ActionList([CreatePerpetualSpellEffect({{ThatSpell}}, [AdjustPT({{PTMod[0]}}), AddAbility([{{PerpetualHasable[0]}}])])])",
    "look at the top X cards of your library, where X is that spell's mana value. You may cast a spell with mana value less than X from among them without paying its mana cost. Put the rest on the bottom of your library in a random order": "ActionList([LookAtTheTopNumberCardsOfLibrary(ManaValueOfSpell({{ThatSpell}}), [MayCastASpellFromAmongThemWithoutPaying(ManaValueIs(LessThan(ManaValueOfSpell({{ThatSpell}})))), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "put a number of {{CounterType}} counters equal to that spell's mana value on up to one target {{Permanent}}": "Targeted([UptoOneTargetPermanent({{Permanent[0]}})], ActionList([PutNumberCountersOfTypeOnPermanent(ManaValueOfSpell({{ThatSpell}}), {{CounterType[0]}}, Ref_TargetPermanent)]))",
    "return up to one target nonland permanent an opponent controls with mana value less than or equal to that spell's mana value to its owner's hand": "Targeted([UptoOneTargetPermanent(And([IsNonCardtype(Land), IsPermanent, ControlledByAPlayer(Opponent), ManaValueIs(LessThanOrEqualTo(ManaValueOfSpell(Trigger_ThatSpell)))]))], ActionList([PutPermanentIntoItsOwnersHand(Ref_TargetPermanent)]))",
    "reveal the top X cards of your library, where X is {{GameNumber(ThatSpell)}}. You may cast a spell with mana value X or less from among cards revealed this way without paying its mana cost. Put the rest on the bottom of your library in a random order": "ActionList([CreateValueX({{GameNumber(ThatSpell=^ThatSpell)[0]}}), RevealTheTopNumberCardsOfLibrary(ValueX, [MayCastASpellFromAmongThemWithoutPaying(ManaValueIs(LessThanOrEqualTo(ValueX))), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "reveal the top card of your library. You may cast it without paying its mana cost if it's a spell with lesser mana value. If you don't cast it, put it into your hand": "ActionList([RevealTopCardOfLibrary, MayCost(CastTopSpellOfLibraryWithoutPaying(ManaValueIs(LessThan(ManaValueOfSpell({{ThatSpell}}))))), Unless(CostWasPaid, [PutTopOfLibraryInHand])])",
    "roll a d20.\n{{RawDigits}}-{{RawDigits}} | Each player draws a card.\n{{RawDigits}}-{{RawDigits}} | You draw a card.\n{{RawDigits}} | Copy that spell. You may choose new targets for the copy": "ActionList([RollAD20, ValueActions(TheDiceResult, [ValueAction(BetweenValues({{RawDigits[0]}}, {{RawDigits[1]}}), [EachPlayerAction(AnyPlayer, DrawACard)]), ValueAction(BetweenValues({{RawDigits[2]}}, {{RawDigits[3]}}), [DrawACard]), ValueAction(ExactValue({{RawDigits[4]}}), [CopySpellAndMayChooseNewTargets({{ThatSpell}})])])])",
    "scry {{Digits}}. If {{Condition(ThatSpell)}}, create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}} and {{Hasable}}": "ActionList([Scry({{Digits[0]}}), If({{Condition(ThatSpell=^ThatSpell)[0]}}, [CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}, {{Hasable[1]}}])])])])",
    "search your library for a colored artifact card chosen at random whose mana value is less than {{GameNumber(ThatSpell)}}. You may play that card without paying its mana cost. If you don't, put that card on the bottom of your library": "ActionList([DigitallySearchLibrary([FindACardOfTypeAtRandom(And([IsColored, IsCardtype(Artifact), ManaValueIs(LessThanOrEqualTo({{GameNumber(ThatSpell=^ThatSpell)[0]}}))])), MayPlayFoundCardsWithoutPaying, PutFoundCardsOnBottomOfLibrary, DontShuffle])])",
    "seek {{a}} {{SpecificCard}} with lesser mana value, then put it onto the battlefield": "ActionList([SeekACard(And([{{SpecificCard[0]}}, ManaValueIs(LessThan(ManaValueOfSpell({{ThatSpell}})))])), PutCardFromHandOnBattlefield(TheCardSeekedThisWay, [EntersNormally])])",
    "target player reveals their hand and discards all cards with that spell's mana value": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, RevealHandAndDiscardEachCard(ManaValueIs(EqualTo(ManaValueOfSpell({{ThatSpell}})))))]))",
    "target {{Creature}} gets {{PTModX}} until end of turn, where X is {{GameNumber(ThatSpell)}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTX({{PTModX[0]}}, {{GameNumber(ThatSpell=^ThatSpell)[0]}})], UntilEndOfTurn)]))",
    "that creature enters the battlefield with an additional {{CounterType}} counter, {{CounterType}} counter, and {{CounterType}} counter on it": "ActionList([CreateSpellEffect({{ThatSpell}}, [EntersWithACounter({{CounterType[0]}}), EntersWithACounter({{CounterType[1]}}), EntersWithACounter({{CounterType[2]}})])])",
    "that creature enters with an additional {{CounterType}} counter, {{CounterType}} counter, and {{CounterType}} counter on it": "ActionList([CreateSpellEffect({{ThatSpell}}, [EntersWithACounter({{CounterType[0]}}), EntersWithACounter({{CounterType[1]}}), EntersWithACounter({{CounterType[2]}})])])",
    "that creature enters the battlefield with your choice of {{a}} {{CounterType}} counter, {{a}} {{CounterType}} counter, or {{a}} {{CounterType}} counter on it": "ActionList([CreateSpellEffect({{ThatSpell}}, [EntersWithACounterOfChoice([{{CounterType[0]}}, {{CounterType[1]}}, {{CounterType[2]}}])])])",
    "that creature enters with X additional {{CounterType}} counters on it, where X is its mana value minus {{Digits}}": "ActionList([CreateSpellEffect({{ThatSpell}}, [EntersWithNumberCounters(Minus(ManaValueOfSpell({{ThatSpell}}), {{Digits[0]}}), {{CounterType[0]}})])])",
    "that creature enters with an additional {{CounterType}} counter and {{CounterType}} counter on it": "ActionList([CreateSpellEffect({{ThatSpell}}, [EntersWithACounter({{CounterType[0]}}), EntersWithACounter({{CounterType[1]}})])])",
    "that creature enters with an additional {{CounterType}} counter on it": "ActionList([CreateSpellEffect({{ThatSpell}}, [EntersWithACounter({{CounterType[0]}})])])",
    "that creature enters with an additional {{CounterType}} counter on it for each {{Eachable}}": "ActionList([CreateSpellEffect({{ThatSpell}}, [EntersWithNumberCounters({{Eachable[0]}}, {{CounterType[0]}})])])",
    "that creature enters with {{a}} {{CounterType}} counter on it": "ActionList([CreateSpellEffect({{ThatSpell}}, [EntersWithACounter({{CounterType[0]}})])])",
    "that spell deals damage to each opponent equal to {{GameNumber}}": "ActionList([SpellDealsDamage({{ThatSpell}}, {{GameNumber[0]}}, EachPlayer(Opponent))])",
    "that spell gains mobilize {{Digits}}": "ActionList([CreateSpellEffect({{ThatSpell}}, [AddAbility([Mobilize({{Digits[0]}})])])])",
    "that spell gains rebound": "ActionList([CreateSpellEffect({{ThatSpell}}, [Rebound])])",
    "that spell's controller loses {{Digits}} life": "ActionList([PlayerAction(ControllerOfSpell({{ThatSpell}}), LoseLife({{Digits[0]}}))])",
    "up to one target opponent may also copy that spell. They may choose new targets for that copy": "Targeted([UptoOneTargetPlayer(Opponent)], ActionList([PlayerMayAction(Ref_TargetPlayer, CopySpellAndMayChooseNewTargets({{ThatSpell}}))]))",
    "you get an amount of {{EnergyCounters}} equal to {{GameNumber(ThatSpell)}}": "ActionList([MayAction(GetEnergy({{GameNumber(ThatSpell=^ThatSpell)[0]}}))])",
    "you lose life equal to its mana value": "ActionList([LoseLife(ManaValueOfSpell(Trigger_ThatSpell))])",
    "you may cast a permanent spell with equal or lesser mana value from your hand without paying its mana cost. If you don't, you may put a land card from your hand onto the battlefield": "ActionList([MayCost(CastASpellFromHandWithoutPaying(And([IsPermanent, ManaValueIs(LessThanOrEqualTo(ManaValueOfSpell({{ThatSpell}})))]))), If(CostWasntPaid, [MayAction(PutACardFromHandOnBattlefield(IsCardtype(Land), [EntersNormally]))])])",
    "you may cast a spell with lesser mana value that shares a card type with it from your hand without paying its mana cost. If you don't, create {{NamedCard}}, a legendary {{PT}} {{Black}} {{Zombie}} {{Zombie}} creature token. It gains {{Hasable}} until end of turn": "ActionList([MayCost(CastASpellFromHandWithoutPaying(And([ManaValueIs(LessThan(ManaValueOfSpell({{ThatSpell}}))), SharesACardtypeWithSpell({{ThatSpell}})]))), Unless(CostWasPaid, [CreateTokens([NamedTokenWithPT({{NamedCard[0]}}, {{PT[0]}}, Colors([{{Black[0]}}]), [Legendary], [Creature], SubtypesList([{{Zombie[0]}}]), [])]), CreatePermanentLayerEffectUntil(TheCreatedToken, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])])",
    "you may cast target {{Card(ThatSpell)}} from your graveyard": "Targeted([TargetGraveyardCard(And([{{Card(ThatSpell=^ThatSpell)[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([MayAction(CastGraveyardCard(Ref_TargetGraveyardCard))]))",
    "you may copy it, except the copy is an artifact in addition to its other types": "ActionList([CopySpellWithModifiers({{ThatSpell}}, [AddCardtype(Artifact)])])",
    "you may copy it. If you do, those spells gain wither. You may choose new targets for the copy": "ActionList([MayCost(CopySpellAndMayChooseNewTargets({{ThatSpell}})), If(CostWasPaid, [CreateEachSpellEffect(Or([SingleSpell(Trigger_ThatSpell), SingleSpell(TheCopiedSpell)]), [Wither], UntilEndOfGame)])])",
    "you may copy it. You may choose new targets for the copy": "ActionList([MayAction(CopySpellAndMayChooseNewTargets({{ThatSpell}}))])",
    "you may copy that spell and may choose new targets for the copy": "ActionList([MayAction(CopySpellAndMayChooseNewTargets({{ThatSpell}}))])",
    "you may copy that spell. You may choose new targets for the copy": "ActionList([MayAction(CopySpellAndMayChooseNewTargets({{ThatSpell}}))])",
    "you may discard your hand. If you do, draw a card for each of that spell's colors": "ActionList([MayCost(DiscardHand), If(CostWasPaid, [DrawNumberCards(TheNumberOfColorsSpellIs({{ThatSpell}}))])])",
    "you may gain control of target creature with that spell's mana value until end of turn": "Targeted([TargetPermanent(And([IsCardtype(Creature), ManaValueIs(EqualTo(ManaValueOfSpell({{ThatSpell}})))]))], ActionList([MayAction(GainControlOfPermanentUntil(Ref_TargetPermanent, UntilEndOfTurn))]))",
    "you may gain life equal to {{GameNumber(ThatSpell)}}": "ActionList([MayAction(GainLife({{GameNumber(ThatSpell=^ThatSpell)[0]}}))])",
    "you may have target opponent draw a card. If you do, copy that spell. You may choose new targets for the copy": "Targeted([TargetPlayer(Opponent)], ActionList([MayCost(HavePlayerTakeAction(Ref_TargetPlayer, DrawACard)), If(CostWasPaid, [CopySpellAndMayChooseNewTargets({{ThatSpell}})])]))",
    "you may have target player mill X cards, where X is {{GameNumber(ThatSpell)}}": "Targeted([TargetPlayer(AnyPlayer)], ActionList([MayHavePlayerAction(Ref_TargetPlayer, MillNumberCards({{GameNumber(ThatSpell=^ThatSpell)[0]}}))]))",
    "you may pay {{ManaCost}}. If you do, copy it": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [CopySpell({{ThatSpell}})])])",
    "you may pay {{ManaCost}}. If you do, copy that spell and you may choose new targets for the copy. If the copy is a permanent spell, it gains {{Hasable}} and \"{{QuotedAbility}}\"": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [CopySpellAndMayChooseNewTargetsWithEffects({{ThatSpell}}, [IfPermanentSpell([AddAbility([{{Hasable[0]}}]), AddAbility([{{QuotedAbility[0]}}])])])])])",
    "you may pay {{ManaCost}}. If you do, copy that spell. You may choose new targets for the copy": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [CopySpellAndMayChooseNewTargets({{ThatSpell}})])])",
    "you may put it on the bottom of its owner's library. If you do, reveal cards from the top of your library until you reveal {{a}} {{SpecificCard}}. You may cast that card without paying its mana cost. Then put all revealed cards not cast this way on the bottom of your library in a random order": "ActionList([MayCost(PutSpellOnBottomOfOwnersLibrary({{ThatSpell}})), If(CostWasPaid, [RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed({{SpecificCard[0]}}, [MayCastTheCardFoundThisWayWithoutPaying, PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])])",
    "you may reveal the top card of your library. If it shares a card type with that spell, counter that spell and that opponent may cast the revealed card without paying its mana cost": "ActionList([MayCost(RevealTopCardOfLibrary), If(CostWasPaid, [If(ACardWasRevealedThisWay(SharesACardtypeWithSpell({{ThatSpell}})), [CounterSpell({{ThatSpell}}), PlayerMayAction(ControllerOfSpell({{ThatSpell}}), CastTopCardOfPlayersLibraryWithoutPaying(You))])])])",
    "you may reveal the top card of your library. If you do, counter that spell if it has the same mana value as the revealed card": "ActionList([MayCost(RevealTopCardOfLibrary), If(CostWasPaid, [If(ACardWasRevealedThisWay(SharesAManaValueWithSpell({{ThatSpell}})), [CounterSpell({{ThatSpell}})])])])",
    "you may reveal the top card of your library. If you do, you may cast that card without paying its mana cost if the two spells have the same mana value": "ActionList([MayCost(RevealTopCardOfLibrary), If(CostWasPaid, [MayAction(CastASpellFromTopOfLibraryWithoutPaying(SharesAManaValueWithSpell({{ThatSpell}})))])])",
    "you may sacrifice {{a}} {{Permanent}}. If you do, copy that spell and you may choose new targets for the copy": "ActionList([MayCost(SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [CopySpellAndMayChooseNewTargets({{ThatSpell}})])])",
    "you may search your graveyard, hand, and/or library for a card with the same name as that spell and put it onto the battlefield. If you search your library this way, shuffle": "ActionList([MayAction(SearchLibraryAndOrGraveyardAndOrHand([FindACardOfType(SharesANameWithSpell({{ThatSpell}})), PutFoundCardsOntoBattlefield([EntersNormally]), ShuffleLibraryIfSearched]))])",
    "you may tap {{Number}} {{Permanents}}. If you do, copy that spell. You may choose new targets for the copy": "ActionList([MayCost(TapNumberPermanents({{Number[0]}}, {{Permanents[0]}})), If(CostWasPaid, [CopySpellAndMayChooseNewTargets({{ThatSpell}})])])",
    "your opponents can't cast spells with the same mana value as that spell until your next turn": "ActionList([CreateEachPlayerEffectUntil(Opponent, [CantCastSpells(SharesANameWithSpell({{ThatSpell}}))], UntilPlayersNextTurn(You))])",
    "{{Creatures}} get {{PTMod}} until end of turn for each color of mana spent to cast that spell": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPTForEach({{PTMod[0]}}, NumColorsManaSpentToCastSpell({{ThatSpell}}))], UntilEndOfTurn)])"
  },
  "{{TriggerActions(ThatSpell,ThatPlayer)}}": {
    "any other player may pay that spell's mana cost. If a player does, counter the spell": "ActionList([AnyPlayerMayCost(Other({{ThatPlayer}}), PayManaCostOfSpell({{ThatSpell}})), If(CostWasPaid, [CounterSpell({{ThatSpell}})])])",
    "counter it unless that player pays {{ManaCostX}}, where X is {{GameNumber(ThatSpell)}}": "ActionList([PlayerMayCost({{ThatPlayer}}, PayManaX({{ManaCostX[0]}}, {{GameNumber(ThatSpell=^ThatSpell)[0]}})), Unless(CostWasPaid, [CounterSpell({{ThatSpell}})])])",
    "counter it unless that player pays {{ManaCost}}": "ActionList([PlayerMayCost({{ThatPlayer}}, PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [CounterSpell({{ThatSpell}})])])",
    "counter that spell unless that player pays {{ManaCostX}}, where X is {{GameNumber(ThatSpell)}}": "ActionList([PlayerMayCost({{ThatPlayer}}, PayManaX({{ManaCostX[0]}}, {{GameNumber(ThatSpell=^ThatSpell)[0]}})), Unless(CostWasPaid, [CounterSpell({{ThatSpell}})])])",
    "counter that spell unless that player pays {{ManaCost}}": "ActionList([PlayerMayCost({{ThatPlayer}}, PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [CounterSpell({{ThatSpell}})])])",
    "counter that spell. That player creates X {{PT}} {{CreatureTokens}} with {{Hasable}}, where X is {{GameNumber(ThatSpell)}}": "ActionList([CounterSpell({{ThatSpell}}), PlayerAction({{ThatPlayer}}, CreateTokens([NumberTokens({{GameNumber(ThatSpell=^ThatSpell)[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}]))]))])",
    "destroy all {{Permanents}}. Then that player creates {{a}} {{PTX}} {{CreatureToken}}, where X is {{GameNumber(ThatSpell)}}": "ActionList([DestroyEachPermanent({{Permanents[0]}}), PlayerAction({{ThatPlayer}}, CreateTokens([TokenWithPT(PTX({{PTX[0]}}, {{GameNumber(ThatSpell=^ThatSpell)[0]}}), {{CreatureToken[0]}}, [])]))])",
    "each other player copies that spell. Each of those players may choose new targets for their copy": "ActionList([EachPlayerAction(Other({{ThatPlayer}}), CopySpellAndMayChooseNewTargets({{ThatSpell}}))])",
    "each other player may copy that spell and may choose new targets for the copy they control": "ActionList([EachPlayerMayAction(Other({{ThatPlayer}}), CopySpellAndMayChooseNewTargets({{ThatSpell}}))])",
    "that player copies it. The player may choose new targets for the copy": "ActionList([PlayerAction({{ThatPlayer}}, CopySpellAndMayChooseNewTargets({{ThatSpell}}))])",
    "that player copies that spell for each other spell, permanent, card not on the battlefield, and/or player the spell could target. Each copy targets a different one of them": "ActionList([CopySpellForEachSpellPermanentCardAndOrPlayerItCouldTarget({{ThatSpell}})])",
    "that player creates X {{PT}} {{CreatureTokens}}, where X is {{GameNumber(ThatSpell)}}": "ActionList([PlayerAction({{ThatPlayer}}, CreateTokens([NumberTokens({{GameNumber(ThatSpell=^ThatSpell)[0]}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))]))])",
    "that player discards X cards, where X is {{GameNumber(ThatSpell)}}": "ActionList([PlayerAction({{ThatPlayer}}, DiscardNumberCards({{GameNumber(ThatSpell=^ThatSpell)[0]}}))])",
    "that player flips a coin. If the player loses the flip, counter that spell": "ActionList([PlayerAction({{ThatPlayer}}, FlipACoin_OnLose([CounterSpell({{ThatSpell}})]))])",
    "that player flips a coin. If they lose the flip, counter that spell": "ActionList([PlayerAction({{ThatPlayer}}, FlipACoin_OnLose([CounterSpell({{ThatSpell}})]))])",
    "that player gains X life, where X is {{GameNumber(ThatSpell)}}": "ActionList([PlayerAction({{ThatPlayer}}, GainLife({{GameNumber(ThatSpell=^ThatSpell)[0]}}))])",
    "they may pay {{ManaCost}}. If they don't, you may copy that spell. You may choose new targets for the copy": "ActionList([PlayerMayCost({{ThatPlayer}}, PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [CopySpellAndMayChooseNewTargets({{ThatSpell}})])])"
  },
  "{{TriggerActions(ThatSpellOrAbility)}}": {
    "copy that spell or ability. You may choose new targets for the copy": "ActionList([CopySpellOrAbilityAndMayChooseNewTargets({{ThatSpellOrAbility}})])",
    "counter that spell or ability": "ActionList([CounterSpellOrAbility({{ThatSpellOrAbility}})])",
    "counter that spell or ability unless its controller pays {{ManaCost}}": "ActionList([PlayerMayCost(ControllerOfSpellOrAbility({{ThatSpellOrAbility}}), PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [CounterSpellOrAbility({{ThatSpellOrAbility}})])])",
    "counter that spell or ability unless that player pays {{Digits}} life": "ActionList([PlayerMayCost(ControllerOfSpellOrAbility({{ThatSpellOrAbility}}), PayLife({{Digits[0]}})), Unless(CostWasPaid, [CounterSpellOrAbility({{ThatSpellOrAbility}})])])",
    "reselect its target at random": "ActionList([ReselectTargetOfSpellOrAbilityAtRandom({{ThatSpellOrAbility}})])",
    "that spell or ability's controller sacrifices {{a}} {{Permanent}} of their choice": "ActionList([PlayerAction(ControllerOfSpellOrAbility({{ThatSpellOrAbility}}), SacrificeAPermanent({{Permanent[0]}}))])"
  },
  "{{TriggerActions(ThatSpellOrAbility,ThatCreature)}}": {
    "that spell or ability's controller gains control of that creature": "ActionList([PlayerAction(ControllerOfSpellOrAbility({{ThatSpellOrAbility}}), GainControlOfPermanent({{ThatCreature}}))])"
  },
  "{{TriggerActions(ThatTriggeredAbility)}}": {
    "counter that ability unless its controller pays {{ManaCost}}": "ActionList([PlayerMayCost(ControllerOfTriggeredAbility({{ThatTriggeredAbility}}), PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [CounterAbility({{ThatTriggeredAbility}})])])",
    "you may copy that ability. You may choose new targets for the copy": "ActionList([CopyAbilityAndMayChooseNewTargets({{ThatTriggeredAbility}})])"
  },
  "{{TriggerActions(TheAttackingPlayer)}}": {
    "that attacking player may create a tapped {{PT}} {{CreatureToken}}": "ActionList([PlayerMayAction({{TheAttackingPlayer}}, CreateTokensWithFlags([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])], [EntersTapped]))])",
    "that attacking player may discard a card. If the player does, they draw a card": "ActionList([PlayerMayCost({{TheAttackingPlayer}}, DiscardACard), If(CostWasPaid, [PlayerAction({{TheAttackingPlayer}}, DrawACard)])])",
    "you and the attacking player each draw a card and lose {{Digits}} life": "ActionList([EachPlayerActions(Or([SinglePlayer(You), SinglePlayer({{TheAttackingPlayer}})]), [DrawACard, LoseLife({{Digits[0]}})])])"
  },
  "{{TriggerActions(TheOtherCreature)}}": {
    "destroy the other creature": "ActionList([DestroyPermanent({{TheOtherCreature}})])",
    "destroy the other creature. It can't be regenerated": "ActionList([DestroyPermanentNoRegen({{TheOtherCreature}})])"
  },
  "{{TriggerActions(ThosePermanents)}}": {
    "choose one of those creatures. Conjure a duplicate of the chosen creature into your hand": "ActionList([ChooseAPermanent({{ThosePermanents}}), ConjureDuplicateOfPermanentIntoHand(ThePermanentChosenThisWay)])",
    "create {{a}} {{CreatureToken}} with base power and toughness each equal to the total power of those creatures": "ActionList([CreateTokens([TokenWithPT(ManualPT(TotalPowerOfPermanents({{ThosePermanents}}), TotalPowerOfPermanents({{ThosePermanents}})), {{CreatureToken[0]}}, [])])])",
    "exile the top X cards of your library, where X is their total power. You may play those cards this turn": "ActionList([ExileTheTopNumberCardsOfLibrary(TotalPowerOfPermanents({{ThosePermanents}})), CreatePlayerEffectUntil(You, [MayPlayExiledCards(TheCardsExiledThisWay)], UntilEndOfTurn)])",
    "for each of them, conjure a duplicate of it onto the battlefield": "ActionList([ConjureADuplicateOfEachPermanentOntoTheBattlefield({{ThosePermanents}}, [EntersNormally])])",
    "for each of them, create a tapped token that's a copy of it": "ActionList([CreateTokensWithFlags([TokenCopyOfEachPermanent({{ThosePermanents}}, NoTokenCopyEffects)], [EntersTapped])])",
    "put {{a}} {{CounterType}} counter on each of them": "ActionList([PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, {{ThosePermanents}})])",
    "put {{a}} {{CounterType}} counter on each of those creatures": "ActionList([PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, {{ThosePermanents}})])",
    "put {{a}} {{CounterType}} counter on each of those creatures and draw a card": "ActionList([PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, {{ThosePermanents}}), DrawACard])",
    "return target {{SpecificCard}} from your graveyard to the battlefield if its mana value is less than or equal to their total power": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([If(GraveyardCardPassesFilter(Ref_TargetGraveyardCard, ManaValueIs(LessThanOrEqualTo(TotalPowerOfPermanents({{ThosePermanents}})))), [PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersNormally])])]))",
    "their controllers sacrifice them": "ActionList([ControllersSacrificeEachPermanent({{ThosePermanents}})])",
    "they gain {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{ThosePermanents}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "those creatures gain {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{ThosePermanents}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "those creatures get {{PTMod}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{ThosePermanents}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])",
    "untap up to X {{Permanents}}, where X is the greatest power among those creatures": "ActionList([UntapUptoNumberPermanents(TheGreatestPowerAmongPermanents({{ThosePermanents}}), {{Permanents[0]}})])",
    "you may exile one of those creatures": "ActionList([MayAction(ExileAPermanent({{ThosePermanents}}))])",
    "you may sacrifice one of them. If you do, reveal cards from the top of your library until you reveal a creature card that shares a creature type with the sacrificed creature. Put that card onto the battlefield and the rest on the bottom of your library in a random order": "ActionList([MayCost(SacrificeAPermanent({{ThosePermanents}})), If(CostWasPaid, [RevealCardsFromTheTopOfLibraryUntilACardOfTypeIsRevealed(And([IsCardtype(Creature), SharesACreatureTypeWithPermanent(ThePermanentSacrificedThisWay)]), [PutTheCardFoundThisWayOntoTheBattlefield([EntersNormally]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])])"
  },
  "{{TriggerActions(X)}}": {
    "choose up to X -\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal}}":
      "Modal_ChooseUptoNumber({{X}}, [{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal[1]}}, {{TriggerActions_Modal[2]}}, {{TriggerActions_Modal[3]}}])",
    "conjure a random creature card with mana value X onto the battlefield": "ActionList([ConjureDuplicateOfARandomCardOfTypeOntoBattlefield(And([IsCardtype(Creature), ManaValueIs(EqualTo(ValueX))]), [EntersNormally])])",
    "all {{Creatures}} get {{PTModX}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPTX({{PTModX[0]}}, {{X}})], UntilEndOfTurn)])",
    "create X Mutagen tokens": "ActionList([CreateTokens([NumberTokens({{X}}, MutagenToken)])])",
    "create X Shard tokens": "ActionList([CreateTokens([NumberTokens({{X}}, ShardToken)])])",
    "create X {{PTX}} {{CreatureTokens}}": "ActionList([CreateTokens([NumberTokens({{X}}, TokenWithPT(PTX({{PTX[0]}}, {{X}}), {{CreatureTokens[0]}}, []))])])",
    "create X {{PT}} {{CreatureTokens}}": "ActionList([CreateTokens([NumberTokens({{X}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, []))])])",
    "create X {{PT}} {{CreatureTokens}} and X Food tokens": "ActionList([CreateTokens([NumberTokens({{X}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [])), NumberTokens({{X}}, FoodToken)])])",
    "create X {{PT}} {{CreatureTokens}} with \"{{TokenQuotedAbility}}\"": "ActionList([CreateTokens([NumberTokens({{X}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{TokenQuotedAbility[0]}}]))])])",
    "create X {{PT}} {{CreatureTokens}} with {{Hasable}}": "ActionList([CreateTokens([NumberTokens({{X}}, TokenWithPT({{PT[0]}}, {{CreatureTokens[0]}}, [{{Hasable[0]}}]))])])",
    "create half X Food tokens, rounded up": "ActionList([CreateTokens([NumberTokens(HalfRoundedUp({{X}}), FoodToken)])])",
    "create {{a}} {{PTX}} {{CreatureToken}}": "ActionList([CreateTokens([TokenWithPT(PTX({{PTX[0]}}, {{X}}), {{CreatureToken[0]}}, [])])])",
    "create {{a}} {{PTX}} {{CreatureToken}} with {{Hasable}}": "ActionList([CreateTokens([TokenWithPT(PTX({{PTX[0]}}, {{X}}), {{CreatureToken[0]}}, [{{Hasable[0]}}])])])",
    "create {{a}} {{PT}} {{CreatureToken}}, then put X {{CounterType}} counters on it": "ActionList([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [])]), PutNumberCountersOfTypeOnPermanent({{X}}, {{CounterType[0]}}, TheCreatedToken)])",
    "destroy any number of target {{Permanents}} with total mana value X or less": "Targeted([AnyNumberOfTargetGroupPermanents({{Permanents[0]}}, TotalManaValueIs(LessThanOrEqualTo({{X}})))], ActionList([DestroyEachPermanent(Ref_TargetPermanents)]))",
    "destroy up to X target {{Permanents}}": "Targeted([UptoNumberTargetPermanents({{X}}, {{Permanents[0]}})], ActionList([DestroyEachPermanent(Ref_TargetPermanents)]))",
    "destroy up to one target artifact or enchantment with mana value X": "Targeted([UptoOneTargetPermanent(And([Or([IsCardtype(Artifact), IsCardtype(Enchantment)]), ManaValueIs(EqualTo({{X}}))]))], ActionList([DestroyPermanent(Ref_TargetPermanent)]))",
    "destroy up to one target artifact or enchantment with mana value X or less. If X is {{Digits}} or more, you draw a card. If X is {{Digits}} or more, double the number of {{CounterType}} counters on any number of other target creatures": "Targeted([UptoOneTargetPermanent(And([Or([IsCardtype(Artifact), IsCardtype(Enchantment)]), ManaValueIs(LessThanOrEqualTo({{X}}))])), AnyNumberOfTargetPermanents(And([Other(ThisPermanent), IsCardtype(Creature)]))], ActionList([DestroyPermanent(Ref_TargetPermanent), If(TriggerXIs(GreaterThanOrEqualTo({{Digits[0]}})), [DrawACard]), If(TriggerXIs(GreaterThanOrEqualTo({{Digits[1]}})), [DoubleCountersOfTypeOnEachPermanent({{CounterType[0]}}, Ref_TargetPermanents)])]))",
    "draw X cards": "ActionList([DrawNumberCards({{X}})])",
    "each opponent mills X cards. Put all {{SpecificCards}} milled this way onto the battlefield face down under your control. They're {{PT}} {{Zombie}} artifact creatures": "ActionList([EachPlayerAction(Opponent, MillNumberCards({{X}})), PutEachCardOfTypeMilledThisWayOntoTheBattlefieldAsFaceDownArtifactCreatures({{SpecificCards[0]}}, {{PT[0]}}, {{Zombie[0]}})])",
    "each player sacrifices X {{Permanents}} of their choice": "ActionList([EachPlayerAction(AnyPlayer, SacrificeNumberPermanents({{X}}, {{Permanents[0]}}))])",
    "each {{Creature}} gets {{PTModX}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creature[0]}}, [AdjustPTX({{PTModX[0]}}, {{X}})], UntilEndOfTurn)])",
    "exile the top X cards of your library. Until the end of your next turn, you may play those cards": "ActionList([ExileTheTopNumberCardsOfLibrary({{X}}), CreatePlayerEffectUntil(You, [MayPlayExiledCards(TheCardsExiledThisWay)], UntilTheEndOfPlayersNextTurn(You))])",
    "exile up to X target {{Permanents}}. For each of those cards, its owner may play it for as long as it remains exiled": "Targeted([UptoNumberTargetPermanents({{X}}, {{Permanents[0]}})], ActionList([ExileEachPermanent(Ref_TargetPermanents), CreateEachPlayerEffectUntil(AnyPlayer, [MayPlayExiledCards(And([WasExiledThisWay, OwnedByAPlayer(SinglePlayer(EachablePlayer))]))], UntilCardsAreNoLongerExiled(TheCardsExiledThisWay))]))",
    "goad up to X target {{Creatures}}": "Targeted([UptoNumberTargetPermanents({{X}}, {{Creatures[0]}})], ActionList([GoadEachCreature(Ref_TargetPermanents)]))",
    "incubate {{Digits}} X times": "ActionList([IncubateNumberTimes({{X}}, {{Digits[0]}})])",
    "put {{a}} {{CounterType}} counter on each of up to X target {{Permanents}}": "Targeted([UptoNumberTargetPermanents({{X}}, {{Permanents[0]}})], ActionList([PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, Ref_TargetPermanents)]))",
    "return target artifact or creature card with mana value X or less from your graveyard to the battlefield": "Targeted([TargetGraveyardCard(And([Or([IsCardtype(Artifact), IsCardtype(Creature)]), ManaValueIs(LessThanOrEqualTo({{X}})), InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutGraveyardCardOntoBattlefield(Ref_TargetGraveyardCard, [EntersNormally])]))",
    "reveal cards from the top of your library until you reveal X creature cards. Put all creature cards revealed this way into your graveyard, then put the rest on the bottom of your library in a random order": "ActionList([RevealCardsFromTheTopOfLibraryUntilANumberOfCardsOfTypeAreRevealed({{X}}, IsCardtype(Creature), [PutTheCardsFoundThisWayIntoGraveyard, PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "reveal the top X cards of your library. You may put a nonland permanent card with mana value X or less from among them onto the battlefield. Then shuffle the rest into your library": "ActionList([RevealTheTopNumberCardsOfLibrary({{X}}, [MayPutACardOfTypeOntoTheBattlefield(And([IsNonCardtype(Land), IsPermanent, ManaValueIs(LessThanOrEqualTo({{X}}))]), [EntersNormally]), PutTheRemainingCardsBackIntoLibraryAndShuffle])])",
    "reveal the top X cards of your library. You may put any number of Aura cards with mana value X or less from among them onto the battlefield. Then put all cards revealed this way that weren't put onto the battlefield on the bottom of your library in a random order": "ActionList([RevealTheTopNumberCardsOfLibrary({{X}}, [MayPutAnyNumberOfCardsOfTypeOntoTheBattlefield(And([IsEnchantmentType(Aura), ManaValueIs(LessThanOrEqualTo({{X}}))]), [EntersNormally]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",
    "search your library and/or graveyard for a non-{{Zombie}} creature card with mana value X or less and put it onto the battlefield. If you search your library this way, shuffle": "ActionList([SearchLibraryAndOrGraveyard([FindACardOfType(And([IsNonCreatureType({{Zombie[0]}}), IsCardtype(Creature), ManaValueIs(LessThanOrEqualTo({{X}}))])), PutFoundCardsOntoBattlefield([EntersNormally]), ShuffleLibraryIfSearched])])",
    "search your library for up to X {{SpecificCards}}, put them onto the battlefield tapped, then shuffle": "ActionList([SearchLibrary([FindNumberCardsOfType({{X}}, {{SpecificCards[0]}}), PutFoundCardsOntoBattlefield([EntersTapped]), Shuffle])])",
    "support X": "Targeted([UptoNumberTargetPermanents({{X}}, IsCardtype(Creature))], ActionList([Support(Ref_TargetPermanents)]))",
    "tap X target creatures. Put {{a}} {{CounterType}} counter on each of those creatures you don't control": "Targeted([NumberTargetPermanents(ValueX, IsCardtype(Creature))], ActionList([TapEachPermanent(Ref_TargetPermanents), PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, And([ThePermanentsTappedThisWay, IsCardtype(Creature), ControlledByAPlayer(Other(You))]))]))",
    "you gain half X life and draw half X cards. Round down each time": "ActionList([GainLife(HalfRoundedDown({{X}})), DrawNumberCards(HalfRoundedDown({{X}}))])",
    "you may search your library for a creature card with mana value X or less, put it onto the battlefield, then shuffle": "ActionList([SearchLibrary([FindACardOfType(And([IsCardtype(Creature), ManaValueIs(LessThanOrEqualTo({{X}}))])), PutFoundCardsOntoBattlefield([EntersNormally]), Shuffle])])"
  },
  "{{TriggerActions(~Exiled)}}": {
    "remove {{a}} {{CounterType}} counter from it. If there are no more {{CounterType}} counters on it, put it into your graveyard and each player returns all {{SpecificCards}} from their graveyard to the battlefield": "ActionList([RemoveACounterOfTypeFromExiledCard({{CounterType[0]}}, {{~Exiled}}), If(ExiledCardPassesFilter({{~Exiled}}, HasNoCountersOfType({{CounterType[1]}})), [PutExiledCardIntoOwnersGraveyard({{~Exiled}}), PutEachCardFromEachPlayersGraveyardOntoTheBattlefield({{SpecificCards[0]}}, AnyPlayer, [EntersNormally])])])",
    "remove {{a}} {{CounterType}} counter from it. Then if this card has no {{CounterType}} counters on it, return it to the battlefield": "ActionList([RemoveACounterOfTypeFromExiledCard({{CounterType[0]}}, {{~Exiled}}), If(ExiledCardPassesFilter({{~Exiled}}, HasNoCountersOfType({{CounterType[1]}})), [PutExiledCardOntoBattlefield({{~Exiled}}, [EntersNormally])])])"
  },
  "{{TriggerActions(~GraveyardCard)}}": {
    "return this card from your graveyard to the battlefield": "ActionList([PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersNormally])])",
    "return this card from your graveyard to the battlefield tapped": "ActionList([PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersTapped])])",
    "return this card from your graveyard to the battlefield tapped at the beginning of the next end step": "ActionList([CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersTapped])]))])",
    "return this card from your graveyard to the battlefield under its owner's control. It perpetually gets {{PTMod}}": "ActionList([PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersUnderOwnersControl]), CreatePerpetualPermanentEffect(ThePermanentPutOnTheBattlefieldThisWay, [AdjustPT({{PTMod[0]}})])])",
    "return this card from your graveyard to the battlefield with {{a}} {{CounterType}} counter on it at the beginning of the next end step": "ActionList([CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersWithACounter({{CounterType[0]}})])]))])",
    "return this card from your graveyard to your hand": "ActionList([ReturnGraveyardCardToHand({{~GraveyardCard}})])",
    "return this card from your graveyard to your hand at the beginning of the next end step": "ActionList([CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([ReturnGraveyardCardToHand({{~GraveyardCard}})]))])",
    "return {{~GraveyardCard}} from your graveyard to your hand at the beginning of the next end step": "ActionList([CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([ReturnGraveyardCardToHand({{~GraveyardCard}})]))])",
    "you gain {{Digits}} life, and you return this card from your graveyard to your hand at the beginning of the next end step": "ActionList([GainLife({{Digits[0]}}), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([ReturnGraveyardCardToHand({{~GraveyardCard}})]))])",
    "you may cast this card from your graveyard": "ActionList([MayAction(CastGraveyardCard({{~GraveyardCard}}))])",
    "you may discard a card. If you do, return this card from your graveyard to your hand": "ActionList([MayCost(DiscardACard), If(CostWasPaid, [ReturnGraveyardCardToHand({{~GraveyardCard}})])])",
    "you may discard {{Number}} cards. If you do, return this card from your graveyard to your hand": "ActionList([MayCost(DiscardNumberCards({{Number[0]}})), If(CostWasPaid, [ReturnGraveyardCardToHand({{~GraveyardCard}})])])",
    "you may exile this card from your graveyard. If you do, draw a card": "ActionList([MayCost(ExileGraveyardCard({{~GraveyardCard}})), If(CostWasPaid, [DrawACard])])",
    "you may exile this card from your graveyard. If you do, this card deals {{Digits}} damage to each {{Creature}}": "ActionList([MayCost(ExileGraveyardCard({{~GraveyardCard}})), If(CostWasPaid, [GraveyardCardDealsDamage({{~GraveyardCard}}, {{Digits[0]}}, EachPermanent({{Creature[0]}}))])])",
    "you may exile this card from your graveyard. When you do, return each {{Permanent}} to its owner's hand": "ActionList([MayReflexiveAction(ExileGraveyardCard({{~GraveyardCard}})), ReflexiveTrigger(ActionList([PutEachPermanentIntoItsOwnersHand({{Permanent[0]}})]))])",
    "you may pay {{ManaCostX}}, where X is {{~GraveyardCard}}'s power. If you do, return it from your graveyard to the battlefield": "ActionList([MayCost(PayManaX({{ManaCostX[0]}}, PowerOfGraveyardCard({{~GraveyardCard}}))), If(CostWasPaid, [PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersNormally])])])",
    "you may pay {{ManaCost}}. If you do, return this card from your graveyard to the battlefield": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersNormally])])])",
    "you may pay {{ManaCost}}. If you do, return this card from your graveyard to the battlefield tapped": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersTapped])])])",
    "you may pay {{ManaCost}}. If you do, return this card from your graveyard to the battlefield tapped and attacking": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersTapped, EntersAttacking])])])",
    "you may pay {{ManaCost}}. If you do, return this card from your graveyard to the battlefield tapped and attacking with {{a}} {{CounterType}} counter on it": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersTapped, EntersAttacking, EntersWithACounter({{CounterType[0]}})])])])",
    "you may pay {{ManaCost}}. If you do, return this card from your graveyard to the battlefield with {{a}} {{CounterType}} counter on it": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersWithACounter({{CounterType[0]}})])])])",
    "you may pay {{ManaCost}}. If you do, return this card from your graveyard to the battlefield. It gains {{Hasable}} until end of turn": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersNormally]), CreatePermanentLayerEffect(ThePermanentPutOnTheBattlefieldThisWay, [AddAbility([{{Hasable[0]}}])])])])",
    "you may pay {{ManaCost}}. If you do, return this card from your graveyard to your hand": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [ReturnGraveyardCardToHand({{~GraveyardCard}})])])",
    "you may pay {{ManaCost}}. If you do, return {{~GraveyardCard}} from your graveyard to the battlefield tapped and it perpetually gets {{PTMod}}": "ActionList([MayCost(PayMana({{ManaCost[0]}})), If(CostWasPaid, [PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersTapped]), CreatePerpetualPermanentEffect(ThePermanentPutOnTheBattlefieldThisWay, [AdjustPT({{PTMod[0]}})])])])",
    "you may put this card from your graveyard on top of your library": "ActionList([MayAction(PutGraveyardCardOnTopOfLibrary({{~GraveyardCard}}))])",
    "you may return this card from your graveyard to the battlefield": "ActionList([MayAction(PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersNormally]))])",
    "you may return this card from your graveyard to the battlefield face up or face down": "ActionList([MayAction(PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [MayActions([EntersFaceDown])]))])",
    "you may return this card from your graveyard to your hand": "ActionList([MayAction(ReturnGraveyardCardToHand({{~GraveyardCard}}))])",
    "you may sacrifice {{a}} {{Permanent}}. If you do, return {{~GraveyardCard}} from your graveyard to the battlefield": "ActionList([MayCost(SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersNormally])])])"
  },
  "{{TriggerActions(~GraveyardCard,ThatCreature)}}": {
    "you may return this card from your graveyard to the battlefield attached to that creature": "ActionList([PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersAttachedToPermanent({{ThatCreature}})])])",
    "you may return this card from your graveyard to the battlefield, then attach it to that creature": "ActionList([PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersNormally]), AttachPermanentToPermanent(ThePermanentPutOnTheBattlefieldThisWay, {{ThatCreature}})])"
  },
  "{{TriggerActions(~Permanent)}}": {
    "tap target creature an opponent controls. That creature can't become untapped for as long as you control {{~Permanent}}":
      "Targeted([TargetPermanent(And([IsCardtype(Creature), ControlledByAPlayer(Opponent)]))], ActionList([TapPermanent(Ref_TargetPermanent), CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [CantBecomeUntapped], UntilPermanentChangesControl(You, ThisPermanent))]))",
    "you draw a card, lose {{Digits}} life, and put {{a}} {{CounterType}} counter on {{ThisPermanent}}":
      "ActionList([DrawACard, LoseLife({{Digits[0]}}), PutACounterOfTypeOnPermanent({{CounterType[0]}}, ThisPermanent)])",
    "put {{a}} {{CounterType}} counter on target {{Permanent}} and {{a}} {{CounterType}} counter on {{ThisPermanent}}":
      "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutCounters([ACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent), ACounterOfTypeOnPermanent({{CounterType[1]}}, ThisPermanent)])]))",
    "you may pay {{ManaCost}} up to three times. When you do, choose up to that many.\n* {{FlavorWord}} - {{TriggerActions_Modal}}.\n* {{FlavorWord}} - {{TriggerActions_Modal(~Permanent)}}.\n* {{FlavorWord}} - {{TriggerActions_Modal}}":
      "ActionList([MayCost(PayManaUptoNumberTimes({{ManaCost[0]}}, Integer(3))), If(CostWasPaid, [ReflexiveTrigger(Modal_ChooseUptoNumber(NumTimesPaidMana, [{{TriggerActions_Modal[0]}}, {{TriggerActions_Modal(~Permanent=^~Permanent)[0]}}, {{TriggerActions_Modal[1]}}]))])])",
    "draw a card. Until end of turn, {{~Permanent}} gains \"{{QuotedAbility(~Permanent)}}\"": "ActionList([DrawACard, CreatePermanentLayerEffectUntil({{~Permanent}}, [AddAbility([{{QuotedAbility(~Permanent=^~Permanent)[0]}}])], UntilEndOfTurn)])",
    "create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}} and \"{{TokenQuotedAbility}}\". Put {{a}} {{CounterType}} counter on it for each {{CounterType}} counter on {{ThisPermanent}}, then put {{a}} {{CounterType}} counter on {{ThisPermanent}}":
      "ActionList([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}, {{TokenQuotedAbility[0]}}])]), PutNumberCountersOfTypeOnEachPermanent(NumCountersOfTypeOnPermanent({{CounterType[1]}}, ThisPermanent), {{CounterType[0]}}, TheTokensCreatedThisWay), PutACounterOfTypeOnPermanent({{CounterType[2]}}, ThisPermanent)])",

    "add {{ManaProduceSymbol}} for each {{Eachable(~Permanent)}}": "ActionList([AddManaRepeated({{ManaProduceSymbol[0]}}, {{Eachable(~Permanent=^~Permanent)[0]}})])",
    "an opponent chooses {{a}} {{Permanent(~Permanent)}} and exiles it": "ActionList([ChooseAPlayer(Opponent), PlayerAction(TheChosenPlayer, ExileAPermanent({{Permanent(~Permanent=^~Permanent)[0]}}))])",
    "any number of target opponents each draw a card. Put {{a}} {{CounterType}} counter on this enchantment, then put {{a}} {{CounterType}} counter on it for each card drawn this way": "Targeted([AnyNumberOfTargetPlayers(Opponent)], ActionList([EachPlayerAction(Ref_TargetPlayers, DrawACard), PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{~Permanent}}), PutNumberCountersOfTypeOnPermanent(NumberOfCardsDrawnThisWay, {{CounterType[1]}}, {{~Permanent}})]))",
    "any opponent may sacrifice {{a}} {{Permanent}} of their choice. If a player does, tap this creature and put {{a}} {{CounterType}} counter on it": "ActionList([AnyPlayerMayCost(Opponent, SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [TapPermanent({{~Permanent}}), PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{~Permanent}})])])",
    "any opponent may sacrifice {{a}} {{Permanent}} of their choice. If a player does, tap this creature, you gain {{Digits}} life, and you draw a card": "ActionList([AnyPlayerMayCost(Opponent, SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [TapPermanent({{~Permanent}}), GainLife({{Digits[0]}}), DrawACard])])",
    "any opponent may sacrifice {{a}} {{Permanent}} of their choice. If no one does, transform this creature": "ActionList([AnyPlayerMayCost(Opponent, SacrificeAPermanent({{Permanent[0]}})), Unless(CostWasPaid, [TransformPermanent({{~Permanent}})])])",
    "any opponent may sacrifice {{a}} {{Permanent}}. If they do, tap {{~Permanent}}, then seek {{a}} {{SpecificCard}} and put it onto the battlefield tapped": "ActionList([AnyPlayerMayCost(Opponent, SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [TapPermanent({{~Permanent}}), SeekACard({{SpecificCard[0]}}), PutCardFromHandOnBattlefield(TheCardSeekedThisWay, [EntersTapped])])])",
    "any opponent may tap {{a}} {{Permanent}} they control. If they do, tap this creature and create {{a}} {{PT}} {{CreatureToken}} with \"{{TokenQuotedAbility}}\"": "ActionList([AnyPlayerMayCost(Opponent, TapAPermanent(And([{{Permanent[0]}}, ControlledByAPlayer(SinglePlayer(ActionPlayer))]))), If(CostWasPaid, [TapPermanent({{~Permanent}}), CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{TokenQuotedAbility[0]}}])])])])",
    "any player may exile a card from their graveyard. If a player does, this creature assigns no combat damage this turn": "ActionList([AnyPlayerMayCost(AnyPlayer, Exile([AGraveyardCard(InAPlayersGraveyard(SinglePlayer(ActionPlayer)))])), If(CostWasPaid, [CreatePermanentRuleEffectUntil({{~Permanent}}, [AssignsNoCombatDamage], UntilEndOfTurn)])])",
    "any player may exile {{Number}} cards from their graveyard. If a player does, this creature assigns no combat damage this turn": "ActionList([AnyPlayerMayCost(AnyPlayer, ExileNumberGraveyardCards({{Number[0]}}, InAPlayersGraveyard(SinglePlayer(EachablePlayer)))), If(CostWasPaid, [CreatePermanentRuleEffectUntil({{~Permanent}}, [AssignsNoCombatDamage], UntilEndOfTurn)])])",
    "any player may sacrifice {{Number}} {{Permanents}} of their choice or have this enchantment deal {{Digits}} damage to that player. If a player does either, destroy this enchantment": "ActionList([AnyPlayerMayCost(AnyPlayer, Or([SacrificeNumberPermanents({{Number[0]}}, {{Permanents[0]}}), HavePermanentDealDamage({{~Permanent}}, {{Digits[0]}}, Player(ActionPlayer))])), If(CostWasPaid, [DestroyPermanent({{~Permanent}})])])",
    "any player may sacrifice {{Number}} {{Permanents}} of their choice. If a player does, sacrifice this creature": "ActionList([AnyPlayerMayCost(AnyPlayer, SacrificeNumberPermanents({{Number[0]}}, {{Permanents[0]}})), If(CostWasPaid, [SacrificePermanent({{~Permanent}})])])",
    "any player may sacrifice {{a}} {{Permanent}} of their choice. If a player does, put this creature on top of its owner's library": "ActionList([AnyPlayerMayCost(AnyPlayer, SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [PutPermanentOnTopOfOwnersLibrary({{~Permanent}})])])",
    "attach this Equipment to target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([AttachPermanentToPermanent({{~Permanent}}, Ref_TargetPermanent)]))",
    "attach this Equipment to up to one target {{Permanent}}": "Targeted([UptoOneTargetPermanent({{Permanent[0]}})], ActionList([AttachPermanentToPermanent({{~Permanent}}, Ref_TargetPermanent)]))",
    "attach up to one target Equipment to it. Then amass Orcs X, where X is {{GameNumber(~Permanent)}}": "Targeted([UptoOneTargetPermanent(IsArtifactType(Equipment))], ActionList([AttachPermanentToPermanent(Ref_TargetPermanent, {{~Permanent}}), Amass({{GameNumber(~Permanent=^~Permanent)[0]}}, Orc)]))",
    "attach up to one target {{Artifact}} to {{~Permanent}}": "Targeted([UptoOneTargetPermanent({{Artifact[0]}})], ActionList([AttachPermanentToPermanent(Ref_TargetPermanent, {{~Permanent}})]))",
    "bolster {{Digits}}. The chosen creature gains {{Hasable}} until end of turn. When that creature deals combat damage to a player this turn, convert {{~Permanent}}": "ActionList([Bolster({{Digits[0]}}), CreatePermanentLayerEffectUntil(TheCreatureBolsteredThisWay, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), CreateTriggerUntil(WhenACreatureDealsCombatDamageToAPlayer(SinglePermanent(TheCreatureBolsteredThisWay), AnyPlayer), ActionList([ConvertPermanent({{~Permanent}})]), UntilEndOfTurn)])",
    "cards you own named {{NamedCard}} intensify by {{Digits}}. Then you draw X cards and lose X life, where X is {{~Permanent}}'s intensity": "ActionList([PerpetuallyIncreaseIntensityOfCardsOwnedByPlayer(IsNamed(NamedCard({{NamedCard[0]}})), You, {{Digits[0]}}), DrawNumberCards(IntensityOfPermanent({{~Permanent}})), LoseLife(IntensityOfPermanent({{~Permanent}}))])",
    "change the target of target {{Spell}} to this creature": "Targeted([TargetSpell({{Spell[0]}})], ActionList([ChangeTheTargetOfSpellToPermanent(Ref_TargetSpell, {{~Permanent}})]))",
    "change this creature's base toughness to {{Digits}} plus {{GameNumber}}": "ActionList([CreatePermanentLayerEffect({{~Permanent}}, [SetToughness(Plus({{Digits[0]}}, {{GameNumber[0]}}))])])",
    "change {{~Permanent}}'s base power and toughness to the power and toughness of target {{Permanent(~Permanent)}} until the end of your next upkeep": "Targeted([TargetPermanent({{Permanent(~Permanent=^~Permanent)[0]}})], ActionList([CreatePermanentLayerEffectUntil({{~Permanent}}, [SetPT(ManualPT(PowerOfPermanent(Ref_TargetPermanent), ToughnessOfPermanent(Ref_TargetPermanent)))], UntilNextUpkeep(You))]))",
    "choose a card at random exiled with this enchantment and put it onto the battlefield tapped": "ActionList([ChooseAnExiledCardAtRandom(TheExiledCards), PutExiledCardOntoBattlefield(TheExiledCardChosenThisWay, [EntersTapped])])",
    "choose a kind of counter at random that this creature doesn't have on it from among {{CounterType}}, {{CounterType}}, {{CounterType}}, {{CounterType}}, {{CounterType}}, {{CounterType}}, {{CounterType}}, {{CounterType}}, {{CounterType}}, and {{CounterType}}. Put a counter of that kind on this creature": "ActionList([ChooseCounterAtRandomPermanentDoesntHave({{~Permanent}}, [{{CounterType[0]}}, {{CounterType[1]}}, {{CounterType[2]}}, {{CounterType[3]}}, {{CounterType[4]}}, {{CounterType[5]}}, {{CounterType[6]}}, {{CounterType[7]}}, {{CounterType[8]}}, {{CounterType[9]}}]), PutACounterOfTypeOnPermanent(TheChosenCounterType, {{~Permanent}})])",
    "choose a land type. This creature gains landwalk of the chosen type until end of turn": "ActionList([ChooseALandType, CreatePermanentLayerEffectUntil({{~Permanent}}, [AddAbility([Landwalk(IsLandTypeVariable(TheChosenLandType))])], UntilEndOfTurn)])",
    "choose a letter. This Vehicle gets {{PTMod}} until end of turn for each name sticker on it that begins with the chosen letter": "ActionList([ChooseALetter, CreatePermanentLayerEffectUntil(ThisPermanent, [AdjustPTForEach({{PTMod[0]}}, TheNumberOfNameStickersOnPermanentThatBeginWithLetter(ThisPermanent, TheChosenLetter))], UntilEndOfTurn)])",
