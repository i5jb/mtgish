    "Max speed - {{ManaCost}}, {{ExileSelfGraveyardCost}}: {{ActivatedActions}}": "FromGraveyard(MaxSpeed(Activated(And([PayMana({{ManaCost[0]}}), {{ExileSelfGraveyardCost[0]}}]), {{ActivatedActions[0]}})))",
    "{{DiscardCardsCost}}: {{ActivatedActions(~GraveyardCard)}}": "FromGraveyard(Activated({{DiscardCardsCost[0]}}, {{ActivatedActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
    "{{ExileGraveyardCost}}: {{ActivatedActions(~GraveyardCard)}}": "FromGraveyard(Activated({{ExileGraveyardCost[0]}}, {{ActivatedActions(~GraveyardCard=^~GraveyardCard)[0]}}))",
