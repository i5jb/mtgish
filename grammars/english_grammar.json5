    "+{{RawDigits}}/-{{RawDigits}}": "+{{RawDigits[0]}}, -{{RawDigits[1]}}",
    "-{{RawDigits}}/+{{RawDigits}}": "-{{RawDigits[0]}}, +{{RawDigits[1]}}",
