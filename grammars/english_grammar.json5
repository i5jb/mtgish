    "Other {{Creatures}} get {{PTMod}} and gain {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil(And([Other({{ThatPermanent}}), {{Creatures[0]}}]), [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "Other {{Creatures}} get {{PTMod}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil(And([Other({{ThatPermanent}}), {{Creatures[0]}}]), [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])",
    "Put {{a}} {{CounterType}} counter on another target {{Permanent}}": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))], ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, Ref_TargetPermanent)]))",
    "Put {{a}} {{CounterType}} counter on each other creature target player controls": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PutACounterOfTypeOnEachPermanent({{CounterType[0]}}, And([Other({{ThatPermanent}}), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]))]))",
    "Put {{a}} {{CounterType}} counter on that creature": "ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{ThatPermanent}})])",
    "Return another target {{Permanent}} to its owner's hand": "Targeted([TargetPermanent(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))], ActionList([PutPermanentIntoItsOwnersHand(Ref_TargetPermanent)]))",
    "You may sacrifice another {{Permanent}}. If you do, scry {{Digits}}, then draw a card": "ActionList([MayCost(SacrificeAPermanent(And([Other({{ThatPermanent}}), {{Permanent[0]}}]))), If(CostWasPaid, [Scry({{Digits[0]}}), DrawACard])])"
  },
  "{{TriggerActions_Modal(ThatPermanent,X)}}": {
    "Each other {{Creature}} gets {{PTModX}} until end of turn. You lose X life": "ActionList([CreateEachPermanentLayerEffectUntil(And([Other({{ThatPermanent}}), {{Creature[0]}}]), [AdjustPTX({{PTModX[0]}}, {{X}})], UntilEndOfTurn), LoseLife({{X}})])"
