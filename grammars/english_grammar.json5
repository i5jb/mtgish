    "{{Zombie}} or {{Zombie}} you control": "And([Or([IsCreatureType({{Zombie[0]}}), IsCreatureType({{Zombie[1]}})]), ControlledByAPlayer(SinglePlayer(You))])",
    "{{Zombie}} token": "And([IsCreatureType({{Zombie[0]}}), IsToken])",
    "{{Zombie}} token you control with power {{Digits}} or greater": "And([IsCreatureType({{Zombie[0]}}), IsToken, ControlledByAPlayer(SinglePlayer(You)), PowerIs(GreaterThanOrEqualTo({{Digits[0]}}))])",
    "{{Zombie}} you control": "And([IsCreatureType({{Zombie[0]}}), ControlledByAPlayer(SinglePlayer(You))])",
    "{{Zombie}} you control with {{CheckHasable}}": "And([IsCreatureType({{Zombie[0]}}), ControlledByAPlayer(SinglePlayer(You)), HasAbility({{CheckHasable[0]}})])",
    "{{Zombie}} your team controls": "And([IsCreatureType({{Zombie[0]}}), ControlledByAPlayer(YourTeam)])",
    "{{Zombie}} {{Zombie}}": "And([IsCreatureType({{Zombie[0]}}), IsCreatureType({{Zombie[1]}})])",
    "{{Zombie}}, {{Zombie}}, and {{Zombie}} you control": "And([Or([IsCreatureType({{Zombie[0]}}), IsCreatureType({{Zombie[1]}}), IsCreatureType({{Zombie[2]}})]), ControlledByAPlayer(SinglePlayer(You))])",
    "{{Zombie}}, {{Zombie}}, or {{Zombie}}": "Or([IsCreatureType({{Zombie[0]}}), IsCreatureType({{Zombie[1]}}), IsCreatureType({{Zombie[2]}})])",
    "{{Zombie}}, {{Zombie}}, or {{Zombie}} you control": "And([Or([IsCreatureType({{Zombie[0]}}), IsCreatureType({{Zombie[1]}}), IsCreatureType({{Zombie[2]}})]), ControlledByAPlayer(SinglePlayer(You))])",
    "{{Zombie}}, {{Zombie}}, {{Zombie}}, or {{Zombie}}": "Or([IsCreatureType({{Zombie[0]}}), IsCreatureType({{Zombie[1]}}), IsCreatureType({{Zombie[2]}}), IsCreatureType({{Zombie[3]}})])",
    "{{Zombie}}, {{Zombie}}, {{Zombie}}, or {{Zombie}} you control": "And([Or([IsCreatureType({{Zombie[0]}}), IsCreatureType({{Zombie[1]}}), IsCreatureType({{Zombie[2]}}), IsCreatureType({{Zombie[3]}})]), ControlledByAPlayer(SinglePlayer(You))])",
    "{{Zombie}}, {{Zombie}}, {{Zombie}}, or {{Zombie}} you control that entered the battlefield this turn": "And([Or([IsCreatureType({{Zombie[0]}}), IsCreatureType({{Zombie[1]}}), IsCreatureType({{Zombie[2]}}), IsCreatureType({{Zombie[3]}})]), ControlledByAPlayer(SinglePlayer(You)), EnteredTheBattlefieldThisTurn])",
    "{{Zombie}}, {{Zombie}}, {{Zombie}}, {{Zombie}}, and {{Zombie}} you control": "And([Or([IsCreatureType({{Zombie[0]}}), IsCreatureType({{Zombie[1]}}), IsCreatureType({{Zombie[2]}}), IsCreatureType({{Zombie[3]}}), IsCreatureType({{Zombie[4]}})]), ControlledByAPlayer(SinglePlayer(You))])",
    "{{Zombie}}, {{Zombie}}, {{Zombie}}, {{Zombie}}, or {{Zombie}}": "Or([IsCreatureType({{Zombie[0]}}), IsCreatureType({{Zombie[1]}}), IsCreatureType({{Zombie[2]}}), IsCreatureType({{Zombie[3]}}), IsCreatureType({{Zombie[4]}})])",
    "{{Zombie}}, {{Zombie}}, {{Zombie}}, {{Zombie}}, {{Zombie}}, or {{Zombie}}": "Or([IsCreatureType({{Zombie[0]}}), IsCreatureType({{Zombie[1]}}), IsCreatureType({{Zombie[2]}}), IsCreatureType({{Zombie[3]}}), IsCreatureType({{Zombie[4]}}), IsCreatureType({{Zombie[5]}})])",
    "{{Zombie}}, {{Zombie}}, {{Zombie}}, {{Zombie}}, {{Zombie}}, {{Zombie}}, or {{Zombie}}": "Or([IsCreatureType({{Zombie[0]}}), IsCreatureType({{Zombie[1]}}), IsCreatureType({{Zombie[2]}}), IsCreatureType({{Zombie[3]}}), IsCreatureType({{Zombie[4]}}), IsCreatureType({{Zombie[5]}}), IsCreatureType({{Zombie[6]}})])"
  },
  "{{DamageSource(~Permanent)}}": {
    "source you control other than this artifact": "And([ControlledByAPlayer(SinglePlayer(You)), IsNotPermanentSource({{~Permanent}})])"
  },
  "{{DamageSources}}": {
    "artifact sources": "IsCardtype(Artifact)",
    "colorless sources": "IsColor(Colorless)",
    "non-{{Zombie}} sources": "IsNonCreatureType({{Zombie[0]}})",
    "sources you control": "ControlledByAPlayer(SinglePlayer(You))",
    "sources you don't control": "ControlledByAPlayer(Other(You))",
    "{{Black}} and/or {{Black}} sources": "Or([IsColor({{Black[0]}}), IsColor({{Black[1]}})])",
    "{{Black}} sources": "IsColor({{Black[0]}})"
  },
  "{{DamageSource}}": {
    "artifact source": "IsCardtype(Artifact)",
    "instant or sorcery source": "Or([IsCardtype(Instant), IsCardtype(Sorcery)])",
    "instant or sorcery source you control": "And([Or([IsCardtype(Instant), IsCardtype(Sorcery)]), ControlledByAPlayer(SinglePlayer(You))])",
    "land source": "IsCardtype(Land)",
    "noncreature source you control": "IsNonCardtype(Creature)",
    "source": "AnyDamageSource",
    "source an opponent controls": "ControlledByAPlayer(Opponent)",
    "source you control": "ControlledByAPlayer(SinglePlayer(You))",
    "source you control with an odd mana value": "And([ControlledByAPlayer(SinglePlayer(You)), ManaValueIs(Odd)])",
    "{{Black}} or artifact source you control": "And([Or([IsColor({{Black[0]}}), IsCardtype(Artifact)]), ControlledByAPlayer(SinglePlayer(You))])",
    "{{Black}} or {{Black}} source": "Or([IsColor({{Black[0]}}), IsColor({{Black[1]}})])",
    "{{Black}} source": "IsColor({{Black[0]}})",
    "{{Black}} source you control": "And([IsColor({{Black[0]}}), ControlledByAPlayer(SinglePlayer(You))])",
    "{{Zombie}} source you control": "And([IsCreatureType({{Zombie[0]}}), ControlledByAPlayer(SinglePlayer(You))])"
  },
  "{{DeckConstruction}}": {
    "A deck can have any number of cards named {{~DeckCard}}": "DeckConstruction(CanHaveAnyNumberOfThisCard)",
    "A deck can have up to {{Number}} cards named {{~DeckCard}}": "DeckConstruction(CanHaveUptoNumberOfThisCard({{Number[0]}}))",
    "Companion - Each creature card in your starting deck is {{a}} {{Zombie}}, {{Zombie}}, {{Zombie}}, {{Zombie}}, or {{Zombie}} card": "Companion(EachCardPassesFilter(IsCardtype(Creature), Or([IsCreatureType({{Zombie[0]}}), IsCreatureType({{Zombie[1]}}), IsCreatureType({{Zombie[2]}}), IsCreatureType({{Zombie[3]}}), IsCreatureType({{Zombie[4]}})])))",
    "Companion - Each nonland card in your starting deck has a different name": "Companion(EachCardPassesGroupFilter(IsNonCardtype(Land), DifferentNames))",
    "Companion - Each nonland card in your starting deck shares a card type": "Companion(EachCardPassesGroupFilter(IsNonCardtype(Land), ShareACardType))",
    "Companion - Each permanent card in your starting deck has an activated ability": "Companion(EachCardPassesFilter(IsPermanent, HasAbility(ActivatedAbility)))",
    "Companion - Each permanent card in your starting deck has mana value {{Digits}} or less": "Companion(EachCardPassesFilter(IsPermanent, ManaValueIs(LessThanOrEqualTo({{Digits[0]}}))))",
    "Companion - No card in your starting deck has more than one of the same mana symbol in its mana cost": "Companion(NoCardPassesFilter(HasMoreThanOneOfTheSameManaSymbolInCost))",
    "Companion - Your starting deck contains at least {{Number}} cards more than the minimum deck size": "Companion(IncreaseStartingDeckSize({{Number[0]}}))",
    "Companion - Your starting deck contains only cards with even mana values": "Companion(AllCardsPassFilter(ManaValueIs(Even)))",
    "Companion - Your starting deck contains only cards with mana value {{Digits}} or greater and land cards": "Companion(AllCardsPassFilter(Or([ManaValueIs(GreaterThanOrEqualTo({{Digits[0]}})), IsCardtype(Land)])))",
    "Companion - Your starting deck contains only cards with odd mana values and land cards": "Companion(AllCardsPassFilter(Or([ManaValueIs(Even), IsCardtype(Land)])))",
    "Remove this card from your deck before playing if you're not playing for ante": "DeckConstruction(RemoveFromDeckIfNotPlayingForAnte)",
    "This card is banned": "DeckConstruction(ThisCardIsBanned)",
    "Your minimum deck size is reduced by {{Number}}": "ConspiracyDeck(ReduceStartingDeckSize({{Number[0]}}))",
    "Your starting deck can't have basic land cards and your starting hand size is five": "ConspiracyDeck(NoCardPassesFilter(And([IsSupertype(Basic), IsCardtype(Land)]))), StartingHandSizeIs(Integer(5))",
    "{{~DeckCard}} can be your commander": "DeckConstruction(CanBeYourCommander)"
  },
