    "Target opponent reveals the top X cards of their library. You may put a nonland permanent card with mana value X or less from among them onto the battlefield under your control. That player puts the rest on the bottom of their library in a random order": "Targeted([TargetPlayer(Opponent)], ActionList([PlayerAction(Ref_TargetPlayer, RevealTheTopNumberCardsOfLibrary({{X}}, [APlayerMayPutACardOfTypeOntoTheBattlefield(SinglePlayer(You), And([IsNonCardtype(Land), IsPermanent, ManaValueIs(LessThanOrEqualTo({{X}}))]), [EntersUnderPlayersControl(You)]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder]))]))",
    "Target player discards X cards at random": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, DiscardNumberCardsAtRandom({{X}}))]))",
    "Target player mills X cards": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, MillNumberCards({{X}}))]))",
    "Target player mills three times X cards": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, MillNumberCards(Thrice({{X}})))]))",
    "Target player reveals X cards from their hand and you choose one of them. That player discards that card": "Targeted([TargetPlayer(AnyPlayer)], ActionList([PlayerAction(Ref_TargetPlayer, RevealHandAndPlayerChoosesACardToDiscard(You, AnyCard))]))",
    "Target {{Creature}} gets {{PTModX}} until end of turn": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTX({{PTModX[0]}}, {{X}})], UntilEndOfTurn)]))",
    "Target {{Creature}} gets {{PTModX}} until end of turn. Destroy it at the beginning of the next end step": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTX({{PTModX[0]}}, {{X}})], UntilEndOfTurn), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([DestroyPermanent(Ref_TargetPermanent)]))]))",
    "Target {{Creature}} with power X or less can't be blocked this turn": "Targeted([TargetPermanent(And([{{Creature[0]}}, PowerIs(LessThanOrEqualTo({{X}}))]))], ActionList([CreatePermanentRuleEffectUntil(Ref_TargetPermanent, [CantBeBlocked], UntilEndOfTurn)]))",
    "Target {{Permanent}} gets {{PTModX}} and gains {{Hasable}} until end of turn": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AdjustPTX({{PTModX[0]}}, {{X}})], UntilEndOfTurn)]))",
    "The next time you would draw a card this turn, instead look at the top X cards of your library, put all but one of them on the bottom of your library in a random order, then draw a card": "ActionList([CreateFutureReplaceWouldDraw(NextTimePlayerWouldDrawACardThisTurn(You), [LookAtTheTopNumberCardsOfLibrary({{X}}, [PutAGenericCardOnTopOfLibrary, PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder]), DrawACard])])",
    "This turn, {{Creatures}} can't attack unless their controller pays {{ManaCostX}} for each attacking creature they control": "ActionList([CreateEachPermanentRuleEffectUntil({{Creatures[0]}}, [CantAttackUnlessCost(PayManaX({{ManaCostX[0]}}, {{X}}))], UntilEndOfTurn)])",
    "This turn, {{Creatures}} can't block unless their controller pays {{ManaCostX}} for each blocking creature they control": "ActionList([CreateEachPermanentRuleEffectUntil({{Creatures[0]}}, [CantBlockUnlessCost(PayManaX({{ManaCostX[0]}}, {{X}}))], UntilEndOfTurn)])",
    "Untap X target {{Permanents}}": "Targeted([NumberTargetPermanents({{X}}, {{Permanents[0]}})], ActionList([UntapEachPermanent(Ref_TargetPermanents)]))",
    "Until end of turn, target {{Creature}} has base power and toughness {{PTX}} and becomes {{a}} {{Zombie}} in addition to its other types": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [SetPT(PTX({{PTX[0]}}, {{X}})), AddCreatureType({{Zombie[0]}})], UntilEndOfTurn)]))",
    "Until end of turn, {{Creatures}} have base power and toughness {{PTX}} and gain all creature types": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [SetPT(PTX({{PTX[0]}}, {{X}})), HasAllCreatureTypes], UntilEndOfTurn)])",
    "X target {{Creatures}} can't be blocked this turn": "Targeted([NumberTargetPermanents({{X}}, {{Creatures[0]}})], ActionList([CreateEachPermanentRuleEffectUntil(Ref_TargetPermanents, [CantBeBlocked], UntilEndOfTurn)]))",
    "X target {{Lands}} become {{Swamps}} until end of turn": "Targeted([NumberTargetPermanents({{X}}, {{Lands[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [SetLandType({{Swamps[0]}})], UntilEndOfTurn)]))",
    "X target {{Permanents}} gain {{Hasable}} until end of turn": "Targeted([NumberTargetPermanents({{X}}, {{Permanents[0]}})], ActionList([CreateEachPermanentLayerEffectUntil(Ref_TargetPermanents, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "You draw X cards and gain X life": "ActionList([DrawNumberCards({{X}}), GainLife({{X}})])",
    "You gain X life": "ActionList([GainLife({{X}})])",
    "You gain three times X life": "ActionList([GainLife(Thrice({{X}}))])",
    "You may choose a creature card in your hand whose mana cost could be paid by some amount of, or all of, the mana you spent on {X}. If you do, you may cast that card face down as {{a}} {{PT}} creature spell without paying its mana cost. If the creature that spell becomes as it resolves has not been turned face up and would assign or deal damage, be dealt damage, or become tapped, instead it's turned face up and assigns or deals damage, is dealt damage, or becomes tapped": "ActionList([MayCost(ChooseACardInHand(And([IsCardtype(Creature), ManaCostIsSubsetOfManaPaidForThisAbility]))), If(CostWasPaid, [CastCardInHandWithoutPayingAsAFacedownCreatureSpell(TheCardInHandChosenThisWay, {{PT[0]}}), CreateReplaceWouldMaskUntil(PermanentWouldAssignDamageDealDamageBeDealDamageOrBecomeTapped(ThePermanentSpellResolvedThisWay), [TurnItFaceUpInstead], UntilPermanentIsTurnedFaceUp(ThePermanentSpellResolvedThisWay))])])",
    "You may exile an instant or sorcery card with mana value X from your hand": "ActionList([MayAction(ExileACardOfTypeFromHand(And([Or([IsCardtype(Instant), IsCardtype(Sorcery)]), ManaValueIs(EqualTo({{X}}))])))])",
    "You may put {{a}} {{SpecificCard}} with mana value X from your hand onto the battlefield": "ActionList([MayAction(PutACardFromHandOnBattlefield(And([{{SpecificCard[0]}}, ManaValueIs(EqualTo({{X}}))]), [EntersNormally]))])",
    "{{Creatures}} get {{PTModX}} and gain {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPTX({{PTModX[0]}}, {{X}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTModX}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPTX({{PTModX[0]}}, {{X}})], UntilEndOfTurn)])",
    "{{Creatures}} have base power and toughness {{PTX}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [SetPT(PTX({{PTX[0]}}, {{X}}))], UntilEndOfTurn)])"
  },
  "{{ActivatedActions(~Exiled)}}": {
    "Create {{a}} {{PT}} {{CreatureToken}} with {{Hasable}}. Return {{~Exiled}} to the battlefield under its owner's control when that token dies": "ActionList([CreateTokens([TokenWithPT({{PT[0]}}, {{CreatureToken[0]}}, [{{Hasable[0]}}])]), CreateFutureTrigger(WhenCreatureOrPlaneswalkerDies(TheCreatedToken), ActionList([PutExiledCardOntoBattlefield({{~Exiled}}, [EntersUnderOwnersControl])]))])",
    "Put this card from exile onto the battlefield tapped": "ActionList([PutExiledCardOntoBattlefield({{~Exiled}}, [EntersTapped])])",
    "Remove {{a}} {{CounterType}} counter from this card": "ActionList([RemoveACounterOfTypeFromExiledCard({{CounterType[0]}}, {{~Exiled}})])",
    "Target {{Permanent}} gains \"{{QuotedAbility}}\" until this card is cast from exile. You may cast this card for as long as it remains exiled": "ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{QuotedAbility[0]}}])], UntilCardIsCastFromExile({{~Exiled}})), CreatePlayerEffect(You, [MayCastExiledCard({{~Exiled}})])])",
    "Target {{Permanent}} gains \"{{QuotedAbility}}\" until {{~Exiled}} is cast from exile. You may cast {{~Exiled}} for as long as it remains exiled": "ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{QuotedAbility[0]}}])], UntilCardIsCastFromExile({{~Exiled}})), CreatePlayerEffect(You, [MayCastExiledCard({{~Exiled}})])])",
    "You may put {{a}} {{CreatureCard}} from your hand onto the battlefield. If you do, that creature gains {{Hasable}} until end of turn. At the beginning of the next end step, sacrifice that creature. If you do, return this card to the battlefield": "ActionList([MayCost(PutACardFromHandOnBattlefield({{CreatureCard[0]}}, [EntersNormally])), If(CostWasPaid, [CreatePermanentLayerEffectUntil(ThePermanentPutOnTheBattlefieldThisWay, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([MustCost(SacrificePermanent(TheCreatedToken)), If(CostWasPaid, [PutExiledCardOntoBattlefield({{~Exiled}}, [EntersNormally])])]))])])"
  },
  "{{ActivatedActions(~ExiledPermanent)}}": {
    "Create {{NamedCard}}, a legendary {{PT}} {{Zombie}} artifact creature token with {{Hasable}}, {{Hasable}}, {{Hasable}}, {{Hasable}}, and {{Hasable}} that's all colors. When that token leaves the battlefield, return all cards exiled with this Vehicle except this card to the battlefield tapped under their owners' control": "ActionList([CreateTokens([NamedTokenWithPT({{NamedCard[0]}}, {{PT[0]}}, AllColors, [Legendary], [Artifact, Creature], SubtypesList([{{Zombie[0]}}]), [{{Hasable[0]}}])]), CreateFutureTrigger(WhenPermanentLeavesTheBattlefield(TheCreatedToken), ActionList([PutEachExiledCardOntoTheBattlefield(And([WasExiledWithPermanent({{~ExiledPermanent}}), Not(SingleExiledCard({{~ExiledPermanent}}))]), [EntersTapped, EntersUnderOwnersControl])]))])"
  },
  "{{ActivatedActions(~GraveyardCard)}}": {
    "Exile this card and target {{Creature}} unless that creature's controller pays {{ManaCost}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([PlayerMayCost(ControllerOfPermanent(Ref_TargetPermanent), PayMana({{ManaCost[0]}})), Unless(CostWasPaid, [ExileGraveyardCard({{~GraveyardCard}}), ExilePermanent(Ref_TargetPermanent)])]))",
    "Exile {{Number}} target cards from an opponent's graveyard. Return this card from your graveyard to your hand": "Targeted([NumberTargetGroupGraveyardCards({{Number[0]}}, InAPlayersGraveyard(Opponent), ShareAGraveyard)], ActionList([ExileEachGraveyardCard(Ref_TargetGraveyardCards), ReturnGraveyardCardToHand({{~GraveyardCard}})]))",
    "Put this card from your graveyard into your library {{Nth}} from the top": "ActionList([PutGraveyardCardInOwnersLibraryNthFromTheTop({{~GraveyardCard}}, {{Nth[0]}})])",
    "Put this card from your graveyard on top of your library": "ActionList([PutGraveyardCardOnTopOfLibrary({{~GraveyardCard}})])",
    "Put this card from your graveyard onto the battlefield transformed": "ActionList([PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersTransformed])])",
    "Return this card and target {{SpecificCard}} from your graveyard to the battlefield tapped": "Targeted([TargetGraveyardCard(And([{{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutEachGraveyardCardOntoBattlefield(Or([SingleGraveyardCard({{~GraveyardCard}}), SingleGraveyardCard(Ref_TargetGraveyardCard)]), [EntersNormally])]))",
    "Return this card and up to one other target {{SpecificCard}} from your graveyard to the battlefield": "Targeted([UptoOneTargetGraveyardCard(And([Other({{~GraveyardCard}}), {{SpecificCard[0]}}, InAPlayersGraveyard(SinglePlayer(You))]))], ActionList([PutEachGraveyardCardOntoBattlefield(Or([SingleGraveyardCard({{~GraveyardCard}}), SingleGraveyardCard(Ref_TargetGraveyardCard)]), [EntersNormally])]))",
    "Return this card from your graveyard to the battlefield": "ActionList([PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersNormally])])",
    "Return this card from your graveyard to the battlefield attached to target {{Permanent}}": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersAttachedToPermanent(Ref_TargetPermanent)])]))",
    "Return this card from your graveyard to the battlefield tapped": "ActionList([PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersTapped])])",
    "Return this card from your graveyard to the battlefield tapped and attacking": "ActionList([PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersTapped, EntersAttacking])])",
    "Return this card from your graveyard to the battlefield tapped with {{Number}} {{CounterType}} counters on it": "ActionList([PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersTapped, EntersWithNumberCounters({{Number[0]}}, {{CounterType[0]}})])])",
    "Return this card from your graveyard to the battlefield tapped with {{a}} {{CounterType}} counter on it": "ActionList([PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersTapped, EntersWithACounter({{CounterType[0]}})])])",
    "Return this card from your graveyard to the battlefield tapped. It gains \"{{QuotedAbility}}\"": "ActionList([PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersTapped]), CreatePermanentLayerEffect(ThePermanentPutOnTheBattlefieldThisWay, [AddAbility([{{QuotedAbility[0]}}])])])",
    "Return this card from your graveyard to the battlefield tapped. You lose {{Digits}} life": "ActionList([PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersTapped]), LoseLife({{Digits[0]}})])",
    "Return this card from your graveyard to the battlefield tapped. You skip your next turn": "ActionList([PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersTapped]), SkipNextTurn])",
    "Return this card from your graveyard to the battlefield transformed": "ActionList([PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersTransformed])])",
    "Return this card from your graveyard to the battlefield with {{a}} {{CounterType}} counter on him. Then you may attach {{a}} {{Permanent}} to him":
      "ActionList([PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersWithACounter({{CounterType[0]}})]), MayAction(AttachAPermanentToPermanent({{Permanent[0]}}, ThePermanentPutOnTheBattlefieldThisWay))])",
    "Return this card from your graveyard to the battlefield with {{a}} {{CounterType}} counter on it": "ActionList([PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersWithACounter({{CounterType[0]}})])])",
    "Return this card from your graveyard to the battlefield, then sacrifice {{a}} {{Permanent}}": "ActionList([PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersNormally]), SacrificeAPermanent({{Permanent[0]}})])",
    "Return this card from your graveyard to your hand": "ActionList([ReturnGraveyardCardToHand({{~GraveyardCard}})])",
    "Return {{~GraveyardCard}} from your graveyard to the battlefield": "ActionList([PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersNormally])])",
    "Return {{~GraveyardCard}} from your graveyard to the battlefield attached to target {{Permanent}}. {{~Permanent}} perpetually gains \"{{PerpetualQuotedAbility}}\"": "Targeted([TargetPermanent({{Permanent[0]}})], ActionList([PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersAttachedToPermanent(Ref_TargetPermanent)]), CreatePerpetualPermanentEffect(ThePermanentPutOnTheBattlefieldThisWay, [AddAbility([{{PerpetualQuotedAbility[0]}}])])]))",
    "Return {{~GraveyardCard}} from your graveyard to the battlefield tapped": "ActionList([PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersTapped])])",
    "Return {{~GraveyardCard}} from your graveyard to the battlefield tapped with {{a}} {{CounterType}} counter on it": "ActionList([PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersTapped, EntersWithACounter({{CounterType[0]}})])])",
    "Return {{~GraveyardCard}} from your graveyard to the battlefield tapped. It perpetually gets {{PTMod}}": "ActionList([PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersTapped]), CreatePerpetualPermanentEffect(ThePermanentPutOnTheBattlefieldThisWay, [AdjustPT({{PTMod[0]}})])])",
    "Return {{~GraveyardCard}} from your graveyard to your hand": "ActionList([ReturnGraveyardCardToHand({{~GraveyardCard}})])",
    "{{~GraveyardCard}} perpetually gets {{PTMod}}, then return it to the battlefield": "ActionList([CreatePerpetualGraveyardCardEffect({{~GraveyardCard}}, [AdjustPT({{PTMod[0]}})]), PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersNormally])])"
  },
  "{{ActivatedActions(~GraveyardCard,X)}}": {
    "Return this card from your graveyard to the battlefield. You may put {{a}} {{SpecificCard}} with mana value X or less from your hand onto the battlefield attached to it. If you don't, exile this creature": "ActionList([PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersNormally]), MayCost(PutACardFromHandOnBattlefield(And([{{SpecificCard[0]}}, ManaValueIs(LessThanOrEqualTo({{X}}))]), [EntersAttachedToPermanent(ThePermanentPutOnTheBattlefieldThisWay)])), Unless(CostWasPaid, [ExilePermanent(ThePermanentPutOnTheBattlefieldThisWay)])])"
  },
  "{{ActivatedActions(~HandCard)}}": {
    "Put this card from your hand onto the battlefield": "ActionList([PutCardFromHandOnBattlefield({{~HandCard}}, [EntersNormally])])",
    "Put this card from your hand onto the battlefield tapped and attacking": "ActionList([PutCardFromHandOnBattlefield({{~HandCard}}, [EntersTapped, EntersAttacking])])",
    "{{~HandCard}} perpetually becomes {{a}} {{Zombie}}, gets {{PTMod}}, and gains {{Hasable}}": "ActionList([CreatePerpetualCardInHandEffect({{~HandCard}}, [SetCreatureType({{Zombie[0]}}), AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])])])"
  },
  "{{ActivatedActions(~Permanent)}}": {
    "Put {{Number}} {{CounterType}} counters on {{~Permanent}}. Choose odd or even. Destroy each other creature with mana value of the chosen quality":
      "ActionList([PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[0]}}, ThisPermanent), ChooseEvenOrOdd, DestroyEachPermanent(And([Other(ThisPermanent), IsCardtype(Creature), ManaValueIs(TheChosenQuality)]))])",
    "Put {{a}} {{CounterType}} counter on {{~Permanent}} and create {{NamedCard}}, a legendary {{PT}} {{Black}} {{Zombie}} {{Zombie}} creature token with \"{{TokenQuotedAbility}}\"":
      "ActionList([PutACounterOfTypeOnPermanent({{CounterType[0]}}, ThisPermanent), CreateTokens([NamedTokenWithPT({{NamedCard[0]}}, {{PT[0]}}, Colors([{{Black[0]}}]), [Legendary], [Creature], SubtypesList([{{Zombie[0]}}, {{Zombie[1]}}]), [{{TokenQuotedAbility[0]}}])])])",
    "Exile the top X cards of your library, where X is {{GameNumber(~Permanent)}}. You may play those cards this turn":
      "ActionList([ExileTheTopNumberCardsOfLibrary({{GameNumber(~Permanent=^~Permanent)[0]}}), CreatePlayerEffectUntil(You, [MayPlayExiledCards(TheCardsExiledThisWay)], UntilEndOfTurn)])",
    "Put {{Number}} {{CounterType}} counters on {{~Permanent}}, then look at the top {{Number}} cards of your library. You may put {{a}} {{SpecificCard}} from among them onto the battlefield. If it's a double-faced card, you may transform it. Put the rest on the bottom of your library in a random order":
      "ActionList([PutNumberCountersOfTypeOnPermanent({{Number[0]}}, {{CounterType[0]}}, ThisPermanent), LookAtTheTopNumberCardsOfLibrary({{Number[0]}}, [MayPutACardOfTypeOntoTheBattlefield({{SpecificCard[0]}}, [EntersNormally]), If(APermanentWasPutOntoTheBattlefieldThisWay(IsDoubleFaced), [MayAction(TransformPermanent(ThePermanentPutOnTheBattlefieldThisWay))]), PutTheRemainingCardsOnTheBottomOfLibraryInARandomOrder])])",

    "Adapt {{Digits}}": "ActionList([Adapt({{Digits[0]}})])",
    "Add X mana in any combination of {{ManaProduceSymbol}} and/or {{ManaProduceSymbol}}, where X is {{GameNumber(~Permanent)}}": "ActionList([AddCombinationMana(Or([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}]), {{GameNumber(~Permanent=^~Permanent)[0]}})])",
    "Add X mana of any one color, where X is {{GameNumber(~Permanent)}}": "ActionList([AddManaRepeated(AnyManaColor, {{GameNumber(~Permanent=^~Permanent)[0]}})])",
    "Add X mana of any one color, where X is {{GameNumber(~Permanent)}}. Spend this mana only to activate abilities": "ActionList([AddManaRepeatedWithModifiers(AnyManaColor, {{GameNumber(~Permanent=^~Permanent)[0]}}, CanOnlySpendToActivateAbilities)])",
    "Add X mana of any one color, where X is {{GameNumber(~Permanent)}}. Spend this mana only to cast {{PotentialSpells}}": "ActionList([AddManaRepeatedWithModifiers(AnyManaColor, {{GameNumber(~Permanent=^~Permanent)[0]}}, CanOnlySpendOnSpells({{PotentialSpells[0]}}))])",
    "Add X mana of any one color, where X is {{GameNumber(~Permanent)}}. Spend this mana only to cast {{PotentialSpells}} or {{PotentialSpells}}": "ActionList([AddManaRepeatedWithModifiers(AnyManaColor, {{GameNumber(~Permanent=^~Permanent)[0]}}, CanOnlySpendOnSpells(Or([{{PotentialSpells[0]}}, {{PotentialSpells[1]}}])))])",
    "Add an amount of {{ManaProduceSymbol}} equal to {{GameNumber(~Permanent)}}": "ActionList([AddManaRepeated({{ManaProduceSymbol[0]}}, {{GameNumber(~Permanent=^~Permanent)[0]}})])",
    "Add an amount of {{ManaProduceSymbol}} equal to {{GameNumber(~Permanent)}}. This mana can't be spent to cast spells from your hand": "ActionList([AddManaRepeatedWithModifiers({{ManaProduceSymbol[0]}}, {{GameNumber(~Permanent=^~Permanent)[0]}}, CantSpendOnSpells(WasCastFromTheirHand))])",
    "Add one mana of any color. An opponent gains control of this land at the beginning of the next end step": "ActionList([AddMana(AnyManaColor), CreateFutureTrigger(AtTheBeginningOfTheNextEndStep, ActionList([ChooseAPlayer(Opponent), PlayerAction(TheChosenPlayer, GainControlOfPermanent(ThisPermanent))]))])",
    "Add one mana of any color. During your next untap step, as you untap your permanents, return this land to its owner's hand": "ActionList([AddMana(AnyManaColor), DuringNextUntap(You, [PutPermanentIntoItsOwnersHand(ThisPermanent)])])",
    "Add one mana of any color. If {{Condition(~Permanent)}}, sacrifice it": "ActionList([AddMana(AnyManaColor), If({{Condition(~Permanent=^~Permanent)[0]}}, [SacrificePermanent({{~Permanent}})])])",
    "Add one mana of any color. Put {{a}} {{CounterType}} counter on this artifact": "ActionList([AddMana(AnyManaColor), PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{~Permanent}})])",
    "Add one mana of any color. Put {{a}} {{CounterType}} counter on this creature": "ActionList([AddMana(AnyManaColor), PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{~Permanent}})])",
    "Add one mana of any color. This land deals {{Digits}} damage to you": "ActionList([AddMana(AnyManaColor), PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Player(You))])",
    "Add one mana of any color. {{ThisPermanent}} becomes that color until end of turn": "ActionList([AddMana(AnyManaColor), CreatePermanentLayerEffectUntil(ThisPermanent, [SetColor(TheManaColorChosenThisWay)], UntilEndOfTurn)])",
    "Add one mana of any type that {{a}} {{Permanent}} could produce. If {{Condition(~Permanent)}}, add {{Number}} mana of that type instead": "ActionList([IfElse({{Condition(~Permanent=^~Permanent)[0]}}, [AddManaRepeated(AnyManaTypeAPermanentCouldProduce({{Permanent[0]}}), {{Number[0]}})], [AddMana(AnyManaTypeAPermanentCouldProduce({{Permanent[0]}}))])])",
    "Add one mana of this artifact's last noted type": "ActionList([AddMana(ManaOfTheLastNotedType)])",
    "Add this artifact's last noted type and amount of mana. Spend this mana only to cast the last card exiled with this artifact": "ActionList([AddManaWithModifiers(LastNotedManaTypeAndAmount, CanOnlySpendToCastExiledCard(TheExiledCard))])",
    "Add {{ManaProduceSymbol}} for each {{Eachable(~Permanent)}}": "ActionList([AddManaRepeated({{ManaProduceSymbol[0]}}, {{Eachable(~Permanent=^~Permanent)[0]}})])",
    "Add {{ManaProduceSymbol}} for each {{Eachable(~Permanent)}}. Spend this mana only on costs that contain {X}": "ActionList([AddManaRepeatedWithModifiers({{ManaProduceSymbol[0]}}, {{Eachable(~Permanent=^~Permanent)[0]}}, CanOnlySpendOnXCost)])",
    "Add {{ManaProduceSymbol}} for each {{Eachable(~Permanent)}}. Spend this mana only to cast {{PotentialSpells}}": "ActionList([AddManaRepeatedWithModifiers({{ManaProduceSymbol[0]}}, {{Eachable(~Permanent=^~Permanent)[0]}}, CanOnlySpendOnSpells({{PotentialSpells[0]}}))])",
    "Add {{ManaProduceSymbol}} or {{ManaProduceSymbol}}. Put {{a}} {{CounterType}} counter on this land": "ActionList([AddMana(Or([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}])), PutACounterOfTypeOnPermanent({{CounterType[0]}}, {{~Permanent}})])",
    "Add {{ManaProduceSymbol}} or {{ManaProduceSymbol}}. This artifact deals {{Digits}} damage to you": "ActionList([AddMana(Or([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}])), PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Player(You))])",
    "Add {{ManaProduceSymbol}} or {{ManaProduceSymbol}}. This land deals {{Digits}} damage to you": "ActionList([AddMana(Or([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}])), PermanentDealsDamage({{~Permanent}}, {{Digits[0]}}, Player(You))])",
    "Add {{ManaProduceSymbol}} or {{ManaProduceSymbol}}. This land doesn't untap during your next untap step": "ActionList([AddMana(Or([{{ManaProduceSymbol[0]}}, {{ManaProduceSymbol[1]}}])), PermanentDoesntUntapDuringControllersNextUntap({{~Permanent}})])",
