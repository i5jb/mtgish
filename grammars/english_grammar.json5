    "{{Creatures}} can't block this turn": "ActionList([CreateEachPermanentRuleEffectUntil({{Creatures[0]}}, [CantBlock], UntilEndOfTurn)])",
    "{{Creatures}} gain {{Hasable}} and get {{PTModX}} until end of turn, where X is {{GameNumber}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AddAbility([{{Hasable[0]}}]), AdjustPTX({{PTModX[0]}}, {{GameNumber[0]}})], UntilEndOfTurn)])",
    "{{Creatures}} gain {{Hasable}} and {{Hasable}} until end of turn and can't be blocked by {{Creatures}} this turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn), CreateEachPermanentRuleEffectUntil({{Creatures[0]}}, [CantBeBlockedByDefenders({{Creatures[1]}})], UntilEndOfTurn)])",
    "{{Creatures}} gain {{Hasable}} until end of turn if {{a}} {{Creature}} has {{CheckHasable}}. The same is true for {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, and {{CheckHasable}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AddAbilityFromEachPermanentHasable({{Creature[0]}}, [{{CheckHasable[0]}}, {{CheckHasable[1]}}, {{CheckHasable[2]}}, {{CheckHasable[3]}}, {{CheckHasable[4]}}, {{CheckHasable[5]}}, {{CheckHasable[6]}}, {{CheckHasable[7]}}, {{CheckHasable[8]}}, {{CheckHasable[9]}}, {{CheckHasable[10]}}, {{CheckHasable[11]}}, {{CheckHasable[12]}}])], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTMod}} and gain {{Hasable}} and {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTMod}} and gain {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}}), AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTMod}} and {{Creatures}} get {{PTMod}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), CreateEachPermanentLayerEffectUntil({{Creatures[1]}}, [AdjustPT({{PTMod[1]}})], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTMod}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTMod}} until end of turn for each {{Eachable}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPTForEach({{PTMod[0]}}, {{Eachable[0]}})], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTMod}} until end of turn if {{Condition}}. Otherwise, you become the monarch": "ActionList([IfElse({{Condition[0]}}, [CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)], [BecomeTheMonarch])])",
    "{{Creatures}} get {{PTMod}} until end of turn. If {{Condition}}, untap those creatures and they get an additional {{PTMod}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), If({{Condition[0]}}, [UntapEachPermanent(ThePermanentsAffectedThisWay), CreateEachPermanentLayerEffectUntil(ThePermanentsAffectedThisWay, [AdjustPT({{PTMod[1]}})], UntilEndOfTurn)])])",
    "{{Creatures}} get {{PTMod}} until end of turn. If {{Condition}}, {{Creatures}} get {{PTMod}} until end of turn instead": "ActionList([IfElse({{Condition[0]}}, [CreateEachPermanentLayerEffectUntil({{Creatures[1]}}, [AdjustPT({{PTMod[1]}})], UntilEndOfTurn)], [CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn)])])",
    "{{Creatures}} get {{PTMod}} until end of turn. Scry {{Digits}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), Scry({{Digits[0]}})])",
    "{{Creatures}} get {{PTMod}} until end of turn. Untap them": "ActionList([CreateEachPermanentLayerEffectUntil(ThePermanentsList, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), UntapEachPermanent(ThePermanentsAffectedThisWay)])",
    "{{Creatures}} get {{PTMod}} until end of turn. Untap those creatures": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), UntapEachPermanent(ThePermanentsAffectedThisWay)])",
    "{{Creatures}} get {{PTMod}} until end of turn. {{Creatures}} also gain {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), CreateEachPermanentLayerEffectUntil({{Creatures[1]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "{{Creatures}} get {{PTMod}} until your next turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})], UntilPlayersNextTurn(You))])",
    "{{Creatures}} lose all abilities and have base power and toughness {{PT}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [LosesAllAbilities, SetPT({{PT[0]}})], UntilEndOfTurn)])",
    "{{Creatures}} perpetually gain \"{{PerpetualQuotedAbility}}\"": "ActionList([CreatePerpetualEachPermanentEffect({{Creatures[0]}}, [AddAbility([{{PerpetualQuotedAbility[0]}}])])])",
    "{{Creatures}} perpetually get {{PTMod}}": "ActionList([CreatePerpetualEachPermanentEffect({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})])])",
    "{{Creatures}} target player controls get {{PTMod}} until end of turn. Untap them": "Targeted([TargetPlayer(AnyPlayer)], ActionList([CreatePermanentsList(And([{{Creatures[0]}}, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))])), CreateEachPermanentLayerEffectUntil(ThePermanentsList, [AdjustPT({{PTMod[0]}})], UntilEndOfTurn), UntapEachPermanent(ThePermanentsList)]))",
    "{{EnchantedCreature}} fights up to one target {{Creature}}": "Targeted([TargetPermanent({{Creature[0]}})], ActionList([Fight(HostPermanent, Ref_TargetPermanent)]))",
    "{{Permanents}} can't be the targets of {{PotentialSpellsOrAbilities}} this turn": "ActionList([CreateGameEffect(UntilEndOfTurn, SpellsAndAbilitiesCantTargetPermanents({{PotentialSpellsOrAbilities[0]}}, {{Permanents[0]}}))])",
    "{{Permanents}} gain \"{{QuotedAbility}}\" until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{QuotedAbility[0]}}])], UntilEndOfTurn)])",
    "{{Permanents}} gain {{Hasable}} and {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])], UntilEndOfTurn)])",
    "{{Permanents}} gain {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)])",
    "{{Permanents}} gain {{Hasable}} until end of turn if {{a}} {{Permanent}} has {{CheckHasable}}. The same is true for {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, and {{CheckHasable}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbilityFromEachPermanentHasable({{Permanent[0]}}, [{{CheckHasable[0]}}, {{CheckHasable[1]}}, {{CheckHasable[2]}}, {{CheckHasable[3]}}, {{CheckHasable[4]}}, {{CheckHasable[5]}}, {{CheckHasable[6]}}, {{CheckHasable[7]}}])], UntilEndOfTurn)])",
    "{{Permanents}} gain {{Hasable}} until end of turn if {{a}} {{SpecificCard}} in your graveyard has {{CheckHasable}}. The same is true for {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, {{CheckHasable}}, and {{CheckHasable}}": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbilityFromCardsInPlayersGraveyardHasable({{SpecificCard[0]}}, You, [{{CheckHasable[0]}}, {{CheckHasable[1]}}, {{CheckHasable[2]}}, {{CheckHasable[3]}}, {{CheckHasable[4]}}, {{CheckHasable[5]}}, {{CheckHasable[6]}}, {{CheckHasable[7]}}, {{CheckHasable[8]}}, {{CheckHasable[9]}}, {{CheckHasable[10]}}])], UntilEndOfTurn)])",
    "{{Permanents}} gain {{Hasable}} until end of turn. Untap them": "ActionList([CreateEachPermanentLayerEffectUntil({{Permanents[0]}}, [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn), UntapEachPermanent(ThePermanentsAffectedThisWay)])",
    "{{Permanents}} perpetually gain your choice of {{Hasable}}, {{Hasable}}, or {{Hasable}}": "ActionList([ChooseAnAbility([{{Hasable[0]}}, {{Hasable[1]}}, {{Hasable[2]}}]), CreatePerpetualEachPermanentEffect({{Permanents[0]}}, [AddAbilityVariable(TheChosenAbility)])])",
    "{{Permanents}} perpetually gain {{PerpetualHasable}}": "ActionList([CreatePerpetualEachPermanentEffect({{Permanents[0]}}, [AddAbility([{{PerpetualHasable[0]}}])])])",
    "{{Permanents}} target opponent controls don't untap during that player's next untap step": "Targeted([TargetPlayer(Opponent)], ActionList([EachPermanentDoesntUntapDuringControllersNextUntap(And([{{Permanents[0]}}, ControlledByAPlayer(SinglePlayer(Ref_TargetPlayer))]))]))",
    "{{PotentialSpells}} you cast this turn cost {{CostReduce}} less to cast": "ActionList([CreatePlayerEffectUntil(You, [DecreaseSpellCost({{PotentialSpells[0]}}, {{CostReduce[0]}})], UntilEndOfTurn)])",
    "{{SpecificCards}} in your hand perpetually gain \"{{PerpetualQuotedAbility}}\"": "ActionList([CreatePerpetualCardsInPlayersHandEffect({{SpecificCards[0]}}, You, [AddAbility([{{PerpetualQuotedAbility[0]}}])])])",
    "{{SpecificCards}} in your library perpetually get {{PTMod}}": "ActionList([CreatePerpetualCardsInPlayersGraveyardEffect({{SpecificCards[0]}}, You, [AdjustPT({{PTMod[0]}})])])",
    "{{Swamp}} cards in your hand and library perpetually become {{PT}} {{Zombie}} creatures in addition to their other types and gain {{Hasable}} and {{Hasable}}": "ActionList([CreatePerpetualCardsInPlayersHandAndCardsInPlayersLibraryEffect(IsLandType({{Swamp[0]}}), SinglePlayer(You), IsLandType({{Swamp[0]}}), SinglePlayer(You), [SetPT({{PT[0]}}), AddCreatureType({{Zombie[0]}}), AddCardtype(Creature), AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}])])])"
  },
  "{{TriggerEffect(~Card)}}": {
    "Covercast - Whenever you cast another {{Spell}}, if {{Number}} or more mana was spent to cast it, this card intensifies": "TriggerI_Covercast(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), SpellPassesFilter(Trigger_ThatSpell, AnAmountOfManaWasSpentToCastIt(GreaterThanOrEqualTo({{Number[0]}}))), ActionList([IntensifyCard(ThisCard)]))",
    "When this card specializes from any zone, {{TriggerActions[WhenCardSpecializesFromAnyZone]}}": "FromAnyZone(TriggerA(WhenCardSpecializes({{~Card}}), {{TriggerActions[WhenCardSpecializesFromAnyZone][0]}}))",
    "When this card specializes from any zone, {{TriggerActions}}": "FromAnyZone(TriggerA(WhenCardSpecializes({{~Card}}), {{TriggerActions[0]}}))",
    "When you cast or cycle {{~Card}}, {{TriggerActions}}": "FromStack(TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), SingleSpell(ThisSpell)), {{TriggerActions[0]}})), TriggerA(WhenAPlayerCyclesACard(SinglePlayer(You), SingleCardInHand(ThisCardInHand)), {{TriggerActions[0]}})",
    "When you cycle this card and when this creature dies, you may have it deal {{Digits}} damage to any target": "FromAnyZone(TriggerA(WhenAPlayerCyclesACard(SinglePlayer(You), SingleCardInHand(ThisCardInHand)), Targeted([AnyTarget], ActionList([DiscardedCardDealsDamage(Trigger_ThatCardInHand, {{Digits[0]}}, Ref_AnyTarget)])))), TriggerA(WhenACreatureOrPlaneswalkerDies(SinglePermanent(ThisPermanent)), Targeted([AnyTarget], ActionList([PermanentDealsDamage(Trigger_ThatPermanent, {{Digits[0]}}, Ref_AnyTarget)])))",
    "When you cycle this card and when this creature dies, {{TriggerActions}}": "FromAnyZone(TriggerA(WhenAPlayerCyclesACard(SinglePlayer(You), SingleCardInHand(ThisCardInHand)), {{TriggerActions[0]}})), TriggerA(WhenACreatureOrPlaneswalkerDies(SinglePermanent(ThisPermanent)), {{TriggerActions[0]}})",
    "When you cycle this card, it deals {{Digits}} damage to any target": "FromAnyZone(TriggerA(WhenAPlayerCyclesACard(SinglePlayer(You), SingleCardInHand(ThisCardInHand)), Targeted([AnyTarget], ActionList([DiscardedCardDealsDamage(Trigger_ThatCardInHand, {{Digits[0]}}, Ref_AnyTarget)]))))",
    "When you cycle this card, it deals {{Digits}} damage to each opponent": "FromAnyZone(TriggerA(WhenAPlayerCyclesACard(SinglePlayer(You), SingleCardInHand(ThisCardInHand)), ActionList([DiscardedCardDealsDamage(Trigger_ThatCardInHand, {{Digits[0]}}, EachPlayer(Opponent))])))",
    "When you cycle this card, shuffle it into your library from your graveyard. If {{Condition}}, put it onto the battlefield from your graveyard instead": "FromAnyZone(TriggerA(WhenAPlayerCyclesACard(SinglePlayer(You), SingleCardInHand(ThisCardInHand)), ActionList([IfElse({{Condition[0]}}, [PutGraveyardCardOntoBattlefield(Trigger_ThatGraveyardCard, [EntersNormally])], [ShuffleGraveyardCardIntoLibrary(Trigger_ThatGraveyardCard)])])))",
    "When you cycle this card, you may have it deal X damage to target {{Creature}}, where X is {{GameNumber}}": "FromAnyZone(TriggerA(WhenAPlayerCyclesACard(SinglePlayer(You), SingleCardInHand(ThisCardInHand)), Targeted([TargetPermanent({{Creature[0]}})], ActionList([MayAction(HaveDiscardedCardDealDamage(Trigger_ThatCardInHand, {{GameNumber[0]}}, Permanent(Ref_TargetPermanent)))]))))",
    "When you cycle this card, you may have it deal {{Digits}} damage to any target": "FromAnyZone(TriggerA(WhenAPlayerCyclesACard(SinglePlayer(You), SingleCardInHand(ThisCardInHand)), Targeted([AnyTarget], ActionList([MayAction(HaveDiscardedCardDealDamage(Trigger_ThatCardInHand, {{Digits[0]}}, Ref_AnyTarget))]))))",
    "When you cycle this card, you may have it deal {{Digits}} damage to each {{Creature}}": "FromAnyZone(TriggerA(WhenAPlayerCyclesACard(SinglePlayer(You), SingleCardInHand(ThisCardInHand)), ActionList([MayAction(HaveDiscardedCardDealDamage(Trigger_ThatCardInHand, {{Digits[0]}}, EachPermanent({{Creature[0]}})))])))",
    "When you cycle this card, you may have it deal {{Digits}} damage to target {{Creature}}": "FromAnyZone(TriggerA(WhenAPlayerCyclesACard(SinglePlayer(You), SingleCardInHand(ThisCardInHand)), Targeted([TargetPermanent({{Creature[0]}})], ActionList([MayAction(HaveDiscardedCardDealDamage(Trigger_ThatCardInHand, {{Digits[0]}}, Permanent(Ref_TargetPermanent)))]))))",
    "When you cycle this card, {{TriggerActions(X)}}": "FromAnyZone(TriggerA(WhenAPlayerCyclesACard(SinglePlayer(You), SingleCardInHand(ThisCardInHand)), {{TriggerActions(X=ValueX)[0]}}))",
    "When you cycle this card, {{TriggerActions}}": "FromAnyZone(TriggerA(WhenAPlayerCyclesACard(SinglePlayer(You), SingleCardInHand(ThisCardInHand)), {{TriggerActions[0]}}))",
    "When you cycle {{~Card}}, if {{Condition}}, {{TriggerActions}}": "FromAnyZone(TriggerI(WhenAPlayerCyclesACard(SinglePlayer(You), SingleCardInHand(ThisCardInHand)), {{Condition[0]}}, {{TriggerActions[0]}}))",
    "When {{~Card}} is put into a graveyard from anywhere, its owner shuffles their graveyard into their library": "FromGraveyard(TriggerA(WhenACardIsPutIntoAPlayersGraveyardFromAnywhere(SingleCard(ThisCard), AnyPlayer), ActionList([PlayerAction(OwnerOfGraveyrdCard(Trigger_ThatGraveyardCard), ShuffleGraveyardIntoLibrary)])))",
    "When {{~Card}} is put into a graveyard from anywhere, shuffle it into its owner's library": "FromGraveyard(TriggerA(WhenACardIsPutIntoAPlayersGraveyardFromAnywhere(SingleCard(ThisCard), AnyPlayer), ActionList([ShuffleGraveyardCardIntoLibrary(Trigger_ThatGraveyardCard)])))"
  },
  "{{TriggerEffect(~Command)}}": {
    "At the beginning of your upkeep, if {{~Command}} is in the command zone, {{TriggerActions}}": "FromCommandZone(TriggerI(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), ThisCardIsInTheCommandZone, {{TriggerActions[0]}}))"
  },
  "{{TriggerEffect(~Exiled)}}": {
    "At the beginning of each player's upkeep, if this card is suspended, that player may sacrifice {{a}} {{Permanent}} of their choice. If the player does, put {{Number}} {{CounterType}} counters on this card": "FromExile(TriggerI(AtTheBeginningOfAPlayersUpkeep(AnyPlayer), ExiledCardPassesFilter({{~Exiled}}, IsSuspended), ActionList([PlayerMayCost(Trigger_ThatPlayer, SacrificeAPermanent({{Permanent[0]}})), If(CostWasPaid, [PutNumberCountersOnExiledCard({{Number[0]}}, {{CounterType[0]}}, {{~Exiled}})])])))",
    "At the beginning of your upkeep, if this card is exiled with {{a}} {{CounterType}} counter on it, {{TriggerActions(~Exiled)}}": "FromExile(TriggerI(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), ExiledCardPassesFilter({{~Exiled}}, HasACounterOfType({{CounterType[0]}})), {{TriggerActions(~Exiled=^~Exiled)[0]}}))",
    "When the last {{CounterType}} counter is removed from this card while it's exiled, {{TriggerActions}}": "FromExile(TriggerA(WhenTheLastCounterOfTypeIsRemovedFromAnExiledCard({{CounterType[0]}}, SingleExiledCard({{~Exiled}})), {{TriggerActions[0]}}))",
    "When {{a}} {{Creature}} attacks and isn't blocked, if this card is exiled, put it onto the battlefield attacking": "FromExile(TriggerI(WhenACreatureAttacksAndIsntBlocked({{Creature[0]}}), CardIsExiled({{~Exiled}}), ActionList([PutExiledCardOntoBattlefield({{~Exiled}}, [EntersAttacking])])))",
    "Whenever a card is put into an opponent's graveyard from anywhere, if this card is suspended, you may remove {{a}} {{CounterType}} counter from this card": "FromExile(TriggerI(WhenACardIsPutIntoAPlayersGraveyardFromAnywhere(AnyCard, AnyPlayer), ExiledCardPassesFilter({{~Exiled}}, IsSuspended), ActionList([MayAction(RemoveACounterOfTypeFromExiledCard({{CounterType[0]}}, {{~Exiled}}))])))",
    "Whenever an opponent casts a spell, if this card is suspended, remove {{a}} {{CounterType}} counter from it": "FromExile(TriggerI(WhenAPlayerCastsASpell(Opponent, AnySpell), ExiledCardPassesFilter({{~Exiled}}, IsSuspended), ActionList([RemoveACounterOfTypeFromExiledCard({{CounterType[0]}}, {{~Exiled}})])))",
    "Whenever an opponent casts a spell, if this card is suspended, that player may put {{a}} {{CounterType}} counter on this card": "FromExile(TriggerI(WhenAPlayerCastsASpell(Opponent, AnySpell), ExiledCardPassesFilter({{~Exiled}}, IsSuspended), ActionList([PlayerMayAction(Trigger_ThatPlayer, RemoveACounterOfTypeFromExiledCard({{CounterType[0]}}, {{~Exiled}}))])))",
    "Whenever you attack, {{~Card}} perpetually gets {{PTMod}}. This ability also triggers if {{~Card}} is in exile": "TriggerA(WhenAPlayerAttacks(SinglePlayer(You)), ActionList([CreatePerpetualPermanentEffect(ThisPermanent, [AdjustPT({{PTMod[0]}})])])), FromExile(TriggerA(WhenAPlayerAttacks(SinglePlayer(You)), ActionList([CreatePerpetualExiledCardEffect(ThisExiledCard, [AdjustPT({{PTMod[0]}})])])))",
    "Whenever you cast {{a}} {{Spell}} from exile, if {{~Card}} is in exile with {{a}} {{CounterType}} counter on it, put it onto the battlefield": "FromExile(TriggerI(WhenAPlayerCastsASpell(SinglePlayer(You), And([{{Spell[0]}}, WasCastFromExile])), ExiledCardPassesFilter({{~Exiled}}, HasACounterOfType({{CounterType[0]}})), ActionList([PutExiledCardOntoBattlefield(ThisExiledCard, [EntersNormally])])))",
    "Whenever you cast {{a}} {{Spell}}, if {{~Card}} is on the battlefield or in exile, it perpetually gets {{PTMod}}. Then if it's on the battlefield, exile it with {{a}} {{CounterType}} counter on it": "FromExileOrBattlefield(TriggerI(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), ThisCardIsInExileOrOnTheBattlefield, ActionList([IfElse(PermanentPassesFilter(ThisPermanent, OnTheBattlefield), [CreatePerpetualPermanentEffect(ThisPermanent, [AdjustPT({{PTMod[0]}})])], [CreatePerpetualExiledCardEffect(ThisExiledCard, [AdjustPT({{PTMod[0]}})]), If(PermanentPassesFilter(ThisPermanent, OnTheBattlefield), [ExilePermanentWithACounter(ThisPermanent, {{CounterType[0]}})])])])))",
    "Whenever you cast {{a}} {{Spell}}, {{~Card}} perpetually gets {{PTMod}}. This ability also triggers if {{~Card}} is in exile": "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), ActionList([CreatePerpetualPermanentEffect(ThisPermanent, [AdjustPT({{PTMod[0]}})])])), FromExile(TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), ActionList([CreatePerpetualExiledCardEffect(ThisExiledCard, [AdjustPT({{PTMod[0]}})])])))",
    "Whenever you remove {{a}} {{CounterType}} counter from this card while it's exiled, {{TriggerActions}}": "FromExile(TriggerA(WhenAPlayerRemovesACounterOfTypeFromAnExiledCard(SinglePlayer(You), {{CounterType[0]}}, SingleExiledCard({{~Exiled}})), {{TriggerActions[0]}}))",
    "Whenever you sacrifice {{a}} {{Permanent}}, {{~Permanent}} perpetually gets {{PTMod}}. This ability also triggers if {{~Card}} is in exile": "TriggerA(WhenAPlayerSacrificesAPermanent(SinglePlayer(You), {{Permanent[0]}}), ActionList([CreatePerpetualPermanentEffect(ThisPermanent, [AdjustPT({{PTMod[0]}})])])), FromExile(TriggerA(WhenAPlayerSacrificesAPermanent(SinglePlayer(You), {{Permanent[0]}}), ActionList([CreatePerpetualExiledCardEffect(ThisExiledCard, [AdjustPT({{PTMod[0]}})])])))",
    "Whenever {{a}} {{CounterType}} counter is removed from this card while it's exiled, {{TriggerActions}}": "FromExile(TriggerA(WhenACounterOfTypeIsRemovedFromAnExiledCard({{CounterType[0]}}, SingleExiledCard({{~Exiled}})), {{TriggerActions[0]}}))"
  },
  "{{TriggerEffect(~GraveyardCard)}}": {
    "At the beginning of your end step, if {{Condition}}, {{~PermanentOrGraveyardCard}} perpetually gets {{PTModX}} where X is {{GameNumber}}. This ability also triggers if {{~GraveyardCard}} is in your graveyard": "TriggerI(AtTheBeginningOfAPlayersEndStep(SinglePlayer(You)), {{Condition[0]}}, ActionList([CreatePerpetualPermanentEffect(ThisPermanent, [AdjustPTX({{PTModX[0]}}, {{GameNumber[0]}})])])), FromGraveyard(TriggerI(AtTheBeginningOfAPlayersEndStep(SinglePlayer(You)), {{Condition[0]}}, ActionList([CreatePerpetualGraveyardCardEffect(ThisGraveyardCard, [AdjustPTX({{PTModX[0]}}, {{GameNumber[0]}})])])))",
    "When this card specializes from your graveyard, return it from your graveyard to the battlefield. It perpetually gains \"{{PerpetualQuotedAbility}}\"": "FromGraveyard(TriggerA(WhenAGraveyardCardSpecializes(SingleGraveyardCard(ThisGraveyardCard)), ActionList([PutGraveyardCardOntoBattlefield({{~GraveyardCard}}, [EntersNormally]), CreatePerpetualPermanentEffect(ThePermanentPutOnTheBattlefieldThisWay, [AddAbility([{{PerpetualQuotedAbility[0]}}])])])))",
    "When you cast {{a}} {{Liliana}} planeswalker spell, exile this card from your graveyard. That planeswalker enters with an additional {{CounterType}} counter on it": "FromGraveyard(TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), And([IsPlaneswalkerType({{Liliana[0]}}), IsCardtype(Planeswalker)])), ActionList([ExileGraveyardCard(ThisGraveyardCard), CreateSpellEffect(Trigger_ThatSpell, [EntersWithACounter({{CounterType[0]}})])])))",
    "Whenever you conjure one or more other cards, {{~Card}} perpetually gets {{PTMod}}. This ability also triggers if {{~Card}} is in your graveyard": "TriggerA(WhenAPlayerConjuresAnyNumberOfOtherCards(SinglePlayer(You)), ActionList([CreatePerpetualPermanentEffect(ThisPermanent, [AdjustPT({{PTMod[0]}})])])), FromGraveyard(TriggerA(WhenAPlayerConjuresAnyNumberOfOtherCards(SinglePlayer(You)), ActionList([CreatePerpetualGraveyardCardEffect(ThisGraveyardCard, [AdjustPT({{PTMod[0]}})])])))",
    "{{TriggerEffect[GraveyardActions](~GraveyardCard)}}": "{{TriggerEffect[GraveyardActions](~GraveyardCard=^~GraveyardCard)[0]}}",
    "{{TriggerEffect[GraveyardCondition](~GraveyardCard)}}": "{{TriggerEffect[GraveyardCondition](~GraveyardCard=^~GraveyardCard)[0]}}",
    "{{TriggerEffect[GraveyardZoneChange](~GraveyardCard)}}": "{{TriggerEffect[GraveyardZoneChange](~GraveyardCard=^~GraveyardCard)[0]}}"
  },
  "{{TriggerEffect(~GraveyardCardOrPermanent)}}": {
    "Whenever you cast {{a}} {{Spell}}, {{~GraveyardCardOrPermanent}} perpetually gets {{PTMod}}. If {{Number}} or more mana was spent to cast that spell, you may exile {{~GraveyardCardOrPermanent}}, then return it to the battlefield tapped under its owner's control. This ability also triggers if this card is in your graveyard":
      "TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), ActionList([CreatePerpetualPermanentEffect(ThisPermanent, [AdjustPT({{PTMod[0]}})]), If(SpellPassesFilter(Trigger_ThatSpell, AnAmountOfManaWasSpentToCastIt(GreaterThanOrEqualTo({{Number[0]}}))), [MayActions([ExilePermanent(ThisPermanent), PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersTapped, EntersUnderOwnersControl])])])])), FromGraveyard(TriggerA(WhenAPlayerCastsASpell(SinglePlayer(You), {{Spell[0]}}), ActionList([CreatePerpetualGraveyardCardEffect(ThisGraveyardCard, [AdjustPT({{PTMod[0]}})]), If(SpellPassesFilter(Trigger_ThatSpell, AnAmountOfManaWasSpentToCastIt(GreaterThanOrEqualTo({{Number[0]}}))), [MayActions([ExileGraveyardCard(ThisGraveyardCard), PutExiledCardOntoBattlefield(TheCardExiledThisWay, [EntersTapped, EntersUnderOwnersControl])])])])))",
    "At the beginning of your upkeep, if {{~GraveyardCardOrPermanent}} is in your graveyard or on the battlefield, {{TriggerActions}}": "FromGraveyardOrBattlefield(TriggerI(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), Or([ThisCardIsInYourGraveyard, ThisCardIsOnTheBattlefield]), {{TriggerActions[0]}}))",
    "At the beginning of your upkeep, {{~GraveyardCardOrPermanent}} deals {{Digits}} damage to each opponent. This ability triggers only if {{~Permanent}} is on the battlefield or if {{~GraveyardCard}} is in your graveyard and you control {{a}} {{Zombie}}": "TriggerA(AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You)), ActionList([PermanentDealsDamage(ThisPermanent, {{Digits[0]}}, EachPlayer(Opponent))])), FromGraveyard(TriggerA(If(PlayerPassesFilter(You, ControlsA(IsCreatureType({{Zombie[0]}}))), AtTheBeginningOfAPlayersUpkeep(SinglePlayer(You))), ActionList([GraveyardCardDealsDamage(ThisGraveyardCard, {{Digits[0]}}, EachPlayer(Opponent))])))",
    "Whenever one or more other {{Creatures}} die, {{~GraveyardCardOrPermanent}} perpetually gets {{PTMod}}. This ability also triggers if {{~GraveyardCard}} is in your graveyard": "FromGraveyardOrBattlefield(TriggerA(WhenACreatureOrPlaneswalkerDies(And([Other(ThisPermanent), {{Creatures[0]}}])), ActionList([CreatePerpetualPermanentOrGraveyardCardEffect(ThisPermanent, ThisGraveyardCard, [AdjustPT({{PTMod[0]}})])])))",
    "Whenever you proliferate, if {{~GraveyardCardOrPermanent}} is in your graveyard or on the battlefield, {{~GraveyardCardOrPermanent}} perpetually gets {{PTMod}}. You may cast it from your graveyard this turn": "FromGraveyardOrBattlefield(TriggerI(WhenAPlayerProliferates(SinglePlayer(You)), Or([ThisCardIsInYourGraveyard, ThisCardIsOnTheBattlefield]), ActionList([IfElse(CardIsInPlayersGraveyard(ThisGraveyardCard, You), [CreatePerpetualGraveyardCardEffect(ThisGraveyardCard, [AdjustPT({{PTMod[0]}})]), CreatePlayerEffectUntil(You, [MayCastGraveyardCard(ThisGraveyardCard)], UntilEndOfTurn)], [CreatePerpetualPermanentEffect(ThisPermanent, [AdjustPT({{PTMod[0]}})])])])))"
  },
  "{{TriggerEffect(~HandCard)}}": {
    "When a spell or ability an opponent controls causes you to discard this card, if {{Condition}}, {{TriggerActions}}": "FromAnyZone(TriggerI(WhenASpellOrAbilityCausesAPlayerToDiscardACard(ControlledByAPlayer(Opponent), SinglePlayer(You), SingleCardInHand(ThisCardInHand)), {{Condition[0]}}, {{TriggerActions[0]}}))",
    "When a spell or ability an opponent controls causes you to discard this card, it deals {{Digits}} damage to any target": "FromAnyZone(TriggerA(WhenASpellOrAbilityCausesAPlayerToDiscardACard(ControlledByAPlayer(Opponent), SinglePlayer(You), SingleCardInHand({{~HandCard}})), Targeted([AnyTarget], ActionList([DiscardedCardDealsDamage(Trigger_ThatCardInHand, {{Digits[0]}}, Ref_AnyTargets)]))))",
    "When a spell or ability an opponent controls causes you to discard this card, return it to your hand": "FromAnyZone(TriggerA(WhenASpellOrAbilityCausesAPlayerToDiscardACard(ControlledByAPlayer(Opponent), SinglePlayer(You), SingleCardInHand({{~HandCard}})), ActionList([ReturnGraveyardCardToHand(Trigger_ThatGraveyardCard)])))",
    "When a spell or ability an opponent controls causes you to discard this card, {{TriggerActions(ThatPlayer)}}": "FromAnyZone(TriggerA(WhenASpellOrAbilityCausesAPlayerToDiscardACard(ControlledByAPlayer(Opponent), SinglePlayer(You), SingleCardInHand({{~HandCard}})), {{TriggerActions(ThatPlayer=Trigger_ControllerOfThatSpellOrAbility)[0]}}))",
    "When a spell or ability an opponent controls causes you to discard this card, {{TriggerActions(~GraveyardCard)}}": "FromAnyZone(TriggerA(WhenASpellOrAbilityCausesAPlayerToDiscardACard(ControlledByAPlayer(Opponent), SinglePlayer(You), SingleCardInHand({{~HandCard}})), {{TriggerActions(~GraveyardCard=ThisGraveyardCard)[0]}}))",
    "When a spell or ability an opponent controls causes you to discard this card, {{TriggerActions}}": "FromAnyZone(TriggerA(WhenASpellOrAbilityCausesAPlayerToDiscardACard(ControlledByAPlayer(Opponent), SinglePlayer(You), SingleCardInHand(ThisCardInHand)), {{TriggerActions[0]}}))",
    "When this card becomes plotted, it deals {{Digits}} damage to any target": "FromAnyZone(TriggerA(WhenACardBecomesPlotted(SingleCardInHand({{~HandCard}})), Targeted([AnyTarget], ActionList([ExiledCardDealsDamage(ThisExiledCard, {{Digits[0]}}, Ref_AnyTarget)]))))",
    "When this card becomes plotted, {{TriggerActions}}": "FromAnyZone(TriggerA(WhenACardBecomesPlotted(SingleCardInHand({{~HandCard}})), {{TriggerActions[0]}}))",
    "When you discard this card, {{TriggerActions}}": "FromAnyZone(TriggerA(WhenAPlayerDiscardsACard(SinglePlayer(You), SingleCardInHand({{~HandCard}})), {{TriggerActions[0]}}))",
    "When you discard {{~HandCard}}, {{TriggerActions}}": "FromAnyZone(TriggerA(WhenAPlayerDiscardsACard(SinglePlayer(You), SingleCardInHand({{~HandCard}})), {{TriggerActions[0]}}))",
    "Whenever you cycle this card or cycle another card while this enchantment is on the battlefield, {{TriggerActions}}": "FromAnyZone(TriggerA(WhenAPlayerCyclesACard(SinglePlayer(You), SingleCardInHand({{~HandCard}})), {{TriggerActions[0]}})), TriggerA(WhenAPlayerCyclesACard(SinglePlayer(You), AnyCard), {{TriggerActions[0]}})"
  },
  "{{TriggerEffect(~Permanent)}}": {
    "Whenever {{~Permanent}} attacks, he connives":
      "TriggerA(WhenACreatureAttacks(SinglePermanent(ThisPermanent)), ActionList([CreatureConnives(ThisPermanent)]))",
    "Whenever {{~Permanent}} attacks, until end of turn, another target attacking creature gains {{Hasable}} and gets {{PTModX}}, where X is {{~Permanent}}'s power":
      "TriggerA(WhenACreatureAttacks(SinglePermanent(ThisPermanent)), Targeted([TargetPermanent(And([Other(ThisPermanent), IsAttacking, IsCardtype(Creature)]))], ActionList([CreatePermanentLayerEffectUntil(Ref_TargetPermanent, [AddAbility([{{Hasable[0]}}]), AdjustPTX({{PTModX[0]}}, PowerOfPermanent(ThisPermanent))], UntilEndOfTurn)])))",
    "Whenever {{a}} {{Creature}} attacks you, {{~Permanent}} deals damage equal to her power to that creature":
      "TriggerA(WhenACreatureAttacksAPlayer({{Creature[0]}}, SinglePlayer(You)), ActionList([PermanentDealsDamage(ThisPermanent, PowerOfPermanent(ThisPermanent), Permanent(Trigger_ThatPermanent))]))",
    "Whenever one or more {{Permanents}} become tapped, {{TriggerActions(~Permanent)}}": "TriggerA(WhenAnyNumberOfPermanentsBecomeTapped({{Permanents[0]}}), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "At end of combat, if {{Condition[ThisCombat](~Permanent)}}, {{TriggerActions(ThatPermanent)}}": "TriggerI(AtTheEndOfCombat, {{Condition[ThisCombat](~Permanent=^~Permanent)[0]}}, {{TriggerActions(ThatPermanent=^~Permanent)[0]}})",
    "At end of combat, if {{Condition[ThisCombat](~Permanent)}}, {{TriggerActions(~Permanent)}}": "TriggerI(AtTheEndOfCombat, {{Condition[ThisCombat](~Permanent=^~Permanent)[0]}}, {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "At end of combat, {{TriggerActions(~Permanent)}}": "TriggerA(AtTheEndOfCombat, {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "At the beginning of combat on your turn, choose one at random -\n* {{TriggerActions_Modal(ThatPermanent)}}.\n* {{TriggerActions_Modal}}.\n* {{TriggerActions_Modal(~Permanent)}}": "TriggerA(AtTheBeginningOfCombatDuringAPlayersTurn(SinglePlayer(You)), Modal_ChooseOneAtRandom([{{TriggerActions_Modal(ThatPermanent=ThisPermanent)[0]}}, {{TriggerActions_Modal[0]}}, {{TriggerActions_Modal(~Permanent=^~Permanent)[0]}}]))",
    "At the beginning of combat on your turn, if you both own and control this creature and a creature named {{NamedCard}}, exile them, then meld them into {{NamedCard}}": "TriggerI(AtTheBeginningOfCombatDuringAPlayersTurn(SinglePlayer(You)), PlayerPassesFilter(You, And([OwnsAndControls({{~Permanent}}), OwnsAndControlsA(And([IsCardtype(Creature), IsNamed(NamedCard({{NamedCard[0]}}))]))])), ActionList([ExilePermanentsAndMeldIntoNewPermanent({{~Permanent}}, And([IsCardtype(Creature), IsNamed(NamedCard({{NamedCard[0]}}))]), {{NamedCard[1]}}, [EntersNormally])]))",
    "At the beginning of combat on your turn, if you control your commander, prevent all combat damage that would be dealt to creatures you control this turn. Other creatures you control gain {{Hasable}} until end of turn": "TriggerI(AtTheBeginningOfCombatDuringAPlayersTurn(SinglePlayer(You)), PlayerPassesFilter(You, ControlsA(IsYourCommander)), ActionList([CreatePreventDamageUntil(CombatDamageWouldBeDealtToARecipient(APermanent(And([IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]))), [PreventThatDamage], UntilEndOfTurn), CreateEachPermanentLayerEffectUntil(And([Other({{~Permanent}}), IsCardtype(Creature), ControlledByAPlayer(SinglePlayer(You))]), [AddAbility([{{Hasable[0]}}])], UntilEndOfTurn)]))",
    "At the beginning of combat on your turn, if {{Condition(ThatPermanent)}}, {{TriggerActions(~Permanent)}}": "TriggerI(AtTheBeginningOfCombatDuringAPlayersTurn(SinglePlayer(You)), {{Condition(ThatPermanent=^~Permanent)[0]}}, {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "At the beginning of combat on your turn, if {{Condition(ThatPermanent)}}, {{TriggerActions}}": "TriggerI(AtTheBeginningOfCombatDuringAPlayersTurn(SinglePlayer(You)), {{Condition(ThatPermanent=ThisPermanent)[0]}}, {{TriggerActions[0]}})",
    "At the beginning of combat on your turn, if {{Condition(~Permanent)}}, {{TriggerActions(~Permanent)}}": "TriggerI(AtTheBeginningOfCombatDuringAPlayersTurn(SinglePlayer(You)), {{Condition(~Permanent=^~Permanent)[0]}}, {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "At the beginning of combat on your turn, if {{Condition}}, {{TriggerActions(~Permanent)}}": "TriggerI(AtTheBeginningOfCombatDuringAPlayersTurn(SinglePlayer(You)), {{Condition[0]}}, {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "At the beginning of combat on your turn, you may have {{~Permanent}} gain \"{{QuotedAbility(~Permanent)}}\" until end of combat. If you do, attacking doesn't cause creatures you control to tap this combat if {{~Permanent}} is untapped": "TriggerA(AtTheBeginningOfCombatDuringAPlayersTurn(SinglePlayer(You)), ActionList([MayCost(CreatePermanentLayerEffectUntil({{~Permanent}}, [AddAbility([{{QuotedAbility(~Permanent=^~Permanent)[0]}}])], UntilEndOfCombat)), If(CostWasPaid, [CreatePlayerEffectUntil(You, [AttackingDoesntCauseCreaturesToTapIf(IsCardtype(Creature), PermanentPassesFilter({{~Permanent}}, IsUntapped))], UntilEndOfCombat)])]))",
    "At the beginning of combat on your turn, {{TriggerActions(ThatPermanent)}}": "TriggerA(AtTheBeginningOfCombatDuringAPlayersTurn(SinglePlayer(You)), {{TriggerActions(ThatPermanent=^~Permanent)[0]}})",
    "At the beginning of combat on your turn, {{TriggerActions(~Permanent)}}": "TriggerA(AtTheBeginningOfCombatDuringAPlayersTurn(SinglePlayer(You)), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "At the beginning of each combat, if {{Condition(~Permanent)}}, {{TriggerActions(~Permanent)}}": "TriggerI(AtTheBeginningOfCombatDuringAPlayersTurn(AnyPlayer), {{Condition(~Permanent=^~Permanent)[0]}}, {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "At the beginning of each combat, if {{Condition}}, {{TriggerActions(~Permanent)}}": "TriggerI(AtTheBeginningOfCombatDuringAPlayersTurn(AnyPlayer), {{Condition[0]}}, {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "At the beginning of each combat, {{TriggerActions(ThatPermanent)}}": "TriggerA(AtTheBeginningOfCombatDuringAPlayersTurn(AnyPlayer), {{TriggerActions(ThatPermanent=^~Permanent)[0]}})",
    "At the beginning of each combat, {{TriggerActions(~Permanent)}}": "TriggerA(AtTheBeginningOfCombatDuringAPlayersTurn(AnyPlayer), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "At the beginning of each end step and when this enchantment leaves the battlefield, {{TriggerActions(~Permanent)}}": "TriggerA(AtTheBeginningOfAPlayersEndStep(AnyPlayer), {{TriggerActions(~Permanent=^~Permanent)[0]}}), TriggerA(WhenAPermanentLeavesTheBattlefield(SinglePermanent({{~Permanent}})), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "At the beginning of each end step, if any creatures dealt damage by this creature this turn died, put those cards onto the battlefield under your control. Sacrifice them when you lose control of this creature": "TriggerI(AtTheBeginningOfAPlayersEndStep(AnyPlayer), ACreatureOrPlaneswalkerDiedThisTurn(And([IsCardtype(Creature), WasDealtDamageByPermanentThisTurn({{~Permanent}})])), ActionList([ReturnEachGraveyardCardToBattlefield(DiedThisTurn(And([IsCardtype(Creature), WasDealtDamageByPermanentThisTurn({{~Permanent}})])), [EntersUnderPlayersControl(You)]), CreateFutureTrigger(WhenPlayerLosesControlOfPermanent(You, {{~Permanent}}), ActionList([SacrificeEachPermanent(ThePermanentsPutOnTheBattlefieldThisWay)]))]))",
    "At the beginning of each end step, if you gained life this turn, distribute up to that many {{CounterType}} counters among any number of other target {{Permanents}}": "TriggerI(AtTheBeginningOfAPlayersEndStep(AnyPlayer), PlayerPassesFilter(You, GainedLifeThisTurn), TargetedDistributed([UptoNumberTargetPermanents(LifeGainedByPlayerThisTurn(You), And([Other({{~Permanent}}), {{Permanents[0]}}]))], DistributeNumberAmongTargets(LifeGainedByPlayerThisTurn(You)), ActionList([PutDistributedCounters({{CounterType[0]}})])))",
    "At the beginning of each end step, if {{Condition(ThatPermanent)}}, {{TriggerActions(~Permanent)}}": "TriggerI(AtTheBeginningOfAPlayersEndStep(AnyPlayer), {{Condition(ThatPermanent=^~Permanent)[0]}}, {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "At the beginning of each end step, if {{Condition(~Permanent)}}, {{TriggerActions(ThatPermanent)}}": "TriggerI(AtTheBeginningOfAPlayersEndStep(AnyPlayer), {{Condition(~Permanent=^~Permanent)[0]}}, {{TriggerActions(ThatPermanent=^~Permanent)[0]}})",
    "At the beginning of each end step, if {{Condition(~Permanent)}}, {{TriggerActions}}": "TriggerI(AtTheBeginningOfAPlayersEndStep(AnyPlayer), {{Condition(~Permanent=^~Permanent)[0]}}, {{TriggerActions[0]}})",
    "At the beginning of each end step, if {{Condition}}, {{TriggerActions(~Permanent)}}": "TriggerI(AtTheBeginningOfAPlayersEndStep(AnyPlayer), {{Condition[0]}}, {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "At the beginning of each end step, {{TriggerActions(~Permanent)}}": "TriggerA(AtTheBeginningOfAPlayersEndStep(AnyPlayer), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "At the beginning of each of your postcombat main phases, if {{Condition}}, {{TriggerActions(~Permanent)}}": "TriggerI(AtTheBeginningOfAPlayersPostcombatMainPhase(SinglePlayer(You)), {{Condition[0]}}, {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "At the beginning of each of your postcombat main phases, {{TriggerActions(~Permanent)}}": "TriggerA(AtTheBeginningOfAPlayersPostcombatMainPhase(SinglePlayer(You)), {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "At the beginning of each opponent's draw step, {{TriggerActions(~Permanent,ThatPlayer)}}": "TriggerA(AtTheBeginningOfAPlayersDrawStep(Opponent), {{TriggerActions(~Permanent=^~Permanent,ThatPlayer=Trigger_ThatPlayer)[0]}})",
    "At the beginning of each opponent's end step, if {{Condition}}, {{TriggerActions(~Permanent)}}": "TriggerI(AtTheBeginningOfAPlayersEndStep(Opponent), {{Condition[0]}}, {{TriggerActions(~Permanent=^~Permanent)[0]}})",
    "At the beginning of each opponent's upkeep, if {{Condition(ThatPlayer)}}, {{TriggerActions(~Permanent,ThatPlayer)}}": "TriggerI(AtTheBeginningOfAPlayersUpkeep(Opponent), {{Condition(ThatPlayer=Trigger_ThatPlayer)[0]}}, {{TriggerActions(~Permanent=^~Permanent,ThatPlayer=Trigger_ThatPlayer)[0]}})",
