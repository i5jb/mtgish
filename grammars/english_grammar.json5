    "{{Creatures}} and {{CreatureCards}} in your graveyard, hand, and library perpetually gain {{PerpetualHasable}}": "ActionList([CreatePerpetualEachPermanentEffect({{Creatures[0]}}, [AddAbility([{{PerpetualHasable[0]}}])]), CreatePerpetualCardsInPlayersHandEffect({{CreatureCards[0]}}, You, [AddAbility([{{PerpetualHasable[0]}}])]), CreatePerpetualCardsInPlayersGraveyardEffect({{CreatureCards[0]}}, You, [AddAbility([{{PerpetualHasable[0]}}])]), CreatePerpetualCardsInPlayersLibraryEffect({{CreatureCards[0]}}, You, [AddAbility([{{PerpetualHasable[0]}}])])])",
    "{{Creatures}} and {{CreatureCards}} in your hand perpetually gain \"{{PerpetualQuotedAbility}}\"": "ActionList([CreatePerpetualEachPermanentEffect({{Creatures[0]}}, [AddAbility([{{PerpetualQuotedAbility[0]}}])]), CreatePerpetualCardsInPlayersHandEffect({{CreatureCards[0]}}, You, [AddAbility([{{PerpetualQuotedAbility[0]}}])])])",
    "{{Creatures}} and {{CreatureCards}} in your hand, library, and graveyard perpetually get {{PTMod}}": "ActionList([CreatePerpetualEachPermanentEffect({{Creatures[0]}}, [AdjustPT({{PTMod[0]}})]), CreatePerpetualCardsInPlayersHandEffect({{CreatureCards[0]}}, You, [AdjustPT({{PTMod[0]}})]), CreatePerpetualCardsInPlayersGraveyardEffect({{CreatureCards[0]}}, You, [AdjustPT({{PTMod[0]}})]), CreatePerpetualCardsInPlayersLibraryEffect({{CreatureCards[0]}}, You, [AdjustPT({{PTMod[0]}})])])",
    "{{Creatures}} become artifacts in addition to their other types until end of turn. Then each {{Permanent}} gains {{Hasable}}, {{Hasable}}, and {{Hasable}} until end of turn": "ActionList([CreateEachPermanentLayerEffectUntil({{Creatures[0]}}, [AddCardtype(Artifact)], UntilEndOfTurn), CreateEachPermanentLayerEffectUntil({{Permanent[0]}}, [AddAbility([{{Hasable[0]}}]), AddAbility([{{Hasable[1]}}]), AddAbility([{{Hasable[2]}}])], UntilEndOfTurn)])",
    "{{Creatures}} can't attack you until a player planeswalks": "ActionList([CreateEachPermanentRuleEffectUntil({{Creatures[0]}}, [CantAttackPlayer(You)], UntilAPlayerPlaneswalks(AnyPlayer))])",
