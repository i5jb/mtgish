  "{{TOKEN_COPY_EFFECT}}": {
    // Text: "Create a token that’s a copy of target artifact or enchantment
    //        you control, except it’s legendary"
    // Card: [[Adagia, Windswept Bastion]]
    "AddSupertypes([{{SUPERTYPE}}])": "",

    // Text: "Create a token that’s a copy of target creature you control,
    //        except it isn’t legendary"
    // Card: [[Multiversal Recruitment]]
    "RemoveSupertypes([{{SUPERTYPE}}])": "",

    // Text: "you may create a tapped and attacking token that’s a copy of
    //        target attacking legendary creature you control other than
    //        Shaun, except it’s not legendary and it’s a Synth artifact
    //        creature in addition to its other types"
    // Card: [[Shaun, Father of Synths]]
    "AddCardtypes([Artifact, Creature])": "",

    // Text: "create a token that’s a copy of it, except it’s an artifact in
    //        addition to its other types"
    // Card: [[Vaultborn Tyrant]]
    "AddCardtypes([Artifact])": "",

    // Text: "Create a token that’s a copy of another target creature you
    //        control, except it’s a 1/1 red Balloon creature in addition to
    //        its other colors and types and it has flying and haste"
    // Card: [[The Jolly Balloon Man]]
    "AddCardtypes([Creature])": "",

    // Text: "create a token that’s a copy of another target creature, except
    //        it’s an enchantment in addition to its other types"
    // Card: [[Felhide Spiritbinder]]
    "AddCardtypes([Enchantment])": "",

    // Text: "Create a token that’s a copy of target creature card exiled with
    //        this artifact, except it’s a 6/6 green Dinosaur creature with
    //        trample"
    // Card: [[Dino DNA]]
    "SetCardtypes([Creature])": "",

    // Text: "Create a token that’s a copy of that card, except it’s an
    //        artifact and it loses all other card types"
    // Card: [[Espers to Magicite]]
    "SetCardtypes([Artifact])": "",

    // Text: "create a token that’s a copy of that card, except it’s an
    //        enchantment and loses all other card types"
    // Card: [[Myrkul, Lord of Bones]]
    "SetCardtypes([Enchantment])": "",

    // Text: "Create a token that’s a copy of that card, except it’s a 1/1
    //        enchantment creature"
    // Card: [[Fear of Ridicule]]
    "SetCardtypes([Enchantment, Creature])": "",

    // Text: "create a token that's a copy of that creature, except it's a 1/1
    //        Food Golem artifact creature in addition to its other types and
    //        it has "{2}, {T}, Sacrifice this token: You gain 3 life.""
    // Card: [[Brenard, Ginger Sculptor]]
    "AddArtifactTypes([Food])": "",

    // Text: "create a token that's a copy of that creature, except it's a
    //        Food artifact with "{2}, {T}, Sacrifice this token: You gain 3
    //        life," and it loses all other card types"
    // Card: [[Shelob, Child of Ungoliant]]
    "SetArtifactTypes([Food])": "",

    // Text: "create a token that’s a copy of that creature, except it’s not
    //        legendary and it’s a 2/2 black Zombie in addition to its other
    //        colors and types"
    // Card: [[Ratadrabik of Urborg]]
    "AddCreatureTypes([{{ZOMBIE}}])": "",

    // Text: "create a token that’s a copy of that creature, except it’s a
    //        0/1 white Illusion"
    // Card: [[Preston, the Vanisher]]
    "SetCreatureTypes([{{ZOMBIE}}])": "",

    // Text: "Create a token that’s a copy of target nonlegendary creature you
    //        control, except it has haste. Sacrifice it at the beginning of
    //        the next end step"
    // Card: [[Kiki-Jiki, Mirror Breaker]]
    "AddAbility([{{RULE}}])": "",

    // Text: "create a token that’s a copy of this creature, except it has
    //        haste and loses soulbond"
    // Card: [[Mirage Phalanx]]
    "LosesAbility({{CHECK_HASABLE}})": "",

    // Text: "create a token that’s a copy of Inchblade Companion, except it
    //        doesn’t have this ability"
    // Card: [[Inchblade Companion]]
    "RemoveThisAbility": "",

    // Text: "Create Vecna, a legendary 8/8 black Zombie God creature token
    //        with indestructible and all triggered abilities of the exiled
    //        cards"
    // Card: [[The Book of Vile Darkness]]
    "AddAbilityFromEachExiledHasable({{CARDS_IN_EXILE}}, {{CHECK_HASABLE_LIST}})": "",

    // Text: "Create a token that’s a copy of another target creature you
    //        control, except it’s a 1/1 red Balloon creature in addition to
    //        its other colors and types and it has flying and haste"
    // Card: [[The Jolly Balloon Man]]
    "AddColor(SimpleColorList([{{SIMPLE_COLOR}}]))": "",

    // Text: "Create a token that’s a copy of it, except it’s a 4/4 black
    //        Zombie"
    // Card: [[Lazotep Quarry]]
    "SetColor(SimpleColorList([{{SIMPLE_COLOR}}]))": "",

    // Text: "For each creature card in your graveyard, create a token
    //        that’s a copy of it, except it’s a 1/1 black and green Insect"
    // Card: [[Grist, Voracious Larva // Grist, the Plague Swarm]]
    "SetColor(SimpleColorList([{{SIMPLE_COLOR}}, {{SIMPLE_COLOR}}]))": "",

    // Text: "Create a token that’s a copy of one of those creatures, except
    //        its power is equal to the total power of those creatures, its
    //        toughness is equal to the total toughness of those creatures,
    //        and it’s a colorless Eldrazi creature"
    // Card: [[Benthic Anomaly]]
    "SetColor(Colorless)": "",

    // Text: "Create a token that’s a copy of target creature, except it’s a
    //        legendary Alien named Prisoner Zero"
    // Card: [[The Eleventh Hour]]
    "SetName({{QUOTED_NAMED_CARD}})": "",

    // Text: "Create a token that’s a copy of it, except it’s a 4/4 black
    //        Zombie"
    // Card: [[Lazotep Quarry]]
    "SetPT({{PT}})": "",

    // Text: "create a token that’s a copy of Jace, except it’s not legendary
    //        and its starting loyalty is 1"
    // Card: [[Jace, Mirror Mage]]
    "SetLoyalty({{NUMBER}})": "",
  },

  "{{TOKEN_FLAGS}}": {
    // Text: "Create a Food token"
    // Card: [[Gilded Goose]]
    "[]": "",

    // Text: "When one or more creatures enter under your control, create a
    //        Wicked Role token attached to one of them"
    // Card: [[Dunbarrow Revivalist]]
    "[EntersAttachedToAPermanent({{PERMANENTS}})]": "",

    // Text: "Create a Wicked Role token attached to up to one target creature"
    // Card: [[Eriette's Whisper]]
    "[EntersAttachedToPermanent({{PERMANENT}})]": "",

    // Text: "create a legendary black Aura Curse enchantment token named
    //        Selenia's Curse attached to target opponent"
    // Card: [[Selenia, the Cursed Heart]]
    "[EntersAttachedToPlayer({{PLAYER}})]": "",

    // Text: "create a 1/1 white Cat Soldier creature token with vigilance
    //        that’s attacking"
    // Card: [[Brimaz, King of Oreskos]]
    "[EntersAttacking]": "",

    // Text: "Create a 1/1 green Saproling creature token that’s blocking
    //        target creature attacking you"
    // Card: [[Flash Foliage]]
    "[EntersBlockingAttacker({{PERMANENT}})]": "",

    // Text: "create a 4/4 white Angel creature token with flying that’s
    //        tapped and attacking that player"
    // Card: [[Seraphic Greatsword]]
    "[EntersTapped, EntersAttackingPlayer({{PLAYER}})]": "",

    // Text: "for each opponent, create a 1/1 white Human creature token
    //        that’s tapped and attacking that player or a planeswalker
    //        they control"
    // Card: [[Adeline, Resplendent Cathar]]
    "[EntersTapped, EntersAttackingPlayerOrPlaneswalkerControlledBy({{PLAYER}})]": "",

    // Text: "create a 2/2 colorless Robot artifact creature token that’s
    //        tapped and attacking"
    // Card: [[Kavaron Harrier]]
    "[EntersTapped, EntersAttacking]": "",

    // Text: "create a tapped Powerstone token"
    // Card: [[Stone Retrieval Unit]]
    "[EntersTapped]": "",

    // Text: "Create a token that’s a copy of target creature you control,
    //        except it enters with an additional +1/+1 counter on it"
    // Card: [[Littjara Mirrorlake]]
    "[EntersWithACounter({{COUNTER_TYPE}})]": "",

    // Text: "create a 0/0 green Ooze creature token with trample. The token
    //        enters with X +1/+1 counters on it, where X is the number of
    //        other creatures you control"
    // Card: [[Printlifter Ooze]]
    "[EntersWithNumberCounters({{NUMBER}}, {{COUNTER_TYPE}})]": "",

    // Text: "For each opponent, create two 3/3 blue and red Elemental creature
    //        tokens with flying that attack that opponent this turn if able"
    // Card: [[Furygale Flocking]]
    "[EntersWithRuleEffectUntil({{PERMANENT_RULE_LIST}}, {{EXPIRATION}})]": "",
  },

  "{{CREATABLE_TOKEN[Number]}}": {
    // Text: "create two 1/1 blue Fish creature tokens"
    // Text: "create two tapped Treasure tokens"
    // Card: [[Frost Fair Lure Fish]]
    "NumberTokens({{NUMBER}}, {{CREATABLE_TOKEN}})": "",

    // Text: "Create two 1/1 green Saproling creature tokens for each card of
    //        the chosen type revealed this way"
    // Card: [[Fertile Imagination]]
    "NumberTokensForEach({{NUMBER}}, {{NUMBER}}, {{CREATABLE_TOKEN}})": "",
  },

  "{{CREATABLE_TOKEN[TokenCopies]}}": {
    // Text: "copy a random card with the same mana cost as that creature.
    //        You may pay {3}. If you do, choose one of those copies. If
    //        a copy of a permanent card is chosen, you may create a token
    //        that’s a copy of that card."
    // Card: [[Maelstrom Archangel Avatar]]
    "TokenFromCopy": "",

    // Text: "Whenever you discard a creature card, ... create a tapped
    //        token that’s a copy of that card"
    // Card: [[Hashaton, Scarab's Fist]]
    "TokenCopyOfDiscardedCard(Trigger_ThatDiscardedCard, {{TOKEN_COPY_EFFECT_LIST}})": "",

    // Text: "Each friend creates a token that’s a copy of a creature they
    //        control"
    // Card: [[Zndrsplt's Judgment]]
    "TokenCopyOfAPermanent({{PERMANENTS}}, {{TOKEN_COPY_EFFECT_LIST}})": "",

    // Text: "Create a token that’s a copy of a card exiled with this artifact"
    // Card: [[Mimic Vat]]
    "TokenCopyOfAnExiledCard({{CARDS_IN_EXILE}}, {{TOKEN_COPY_EFFECT_LIST}})": "",

    // Text: "When you cast this spell, create a token that’s a copy of it,
    //        except it isn’t legendary."
    // Card: [[Osgood, Operation Double]]
    "TokenCopyOfSpell({{SPELL}}, {{TOKEN_COPY_EFFECT_LIST}})": "",

    // Text: "Each player reveals the top card of their library. For each
    //        creature card revealed this way, create a token that’s a copy
    //        of that card"
    // Card: [[Haunting Imitation]]
    "TokenCopyOfEachCardInLibrary({{CARDS_IN_LIBRARY}}, {{TOKEN_COPY_EFFECT_LIST}})": "",

    // Text: "create a token that’s a copy of your commander"
    // Card: [[I Am Never Alone]]
    // Text: "Create a token that’s a copy of one of your commanders"
    // Card: [[Baldur's Gate Wilderness]]
    "TokenCopyOfCommander({{TOKEN_COPY_EFFECT_LIST}})": "",

    // Text: "create a token that’s a copy of this creature"
    // Card: [[Homunculus Horde]]
    "TokenCopyOfPermanent({{PERMANENT}}, {{TOKEN_COPY_EFFECT_LIST}})": "",

    // Text: "For each creature target player controls, create a token that’s
    //        a copy of that creature."
    // Card: [[Clone Legion]]
    // Text: "create Stangg Twin, a legendary 3/4 red and green Human Warrior
    //        creature token. It enters tapped and attacking. For each Aura
    //        and Equipment attached to Stangg, create a token that’s a copy
    //        of it attached to Stangg Twin"
    // Card: [[Stangg, Echo Warrior]]
    "TokenCopyOfEachPermanent({{PERMANENTS}}, {{TOKEN_COPY_EFFECT_LIST}})": "",

    // Text: "For each creature card in your graveyard, create a token
    //        that’s a copy of it"
    // Card: [[Grist, Voracious Larva // Grist, the Plague Swarm]]
    "TokenCopyOfEachGraveyardCard({{CARDS_IN_GRAVEYARDS}}, {{TOKEN_COPY_EFFECT_LIST}})": "",

    // Text: "For each creature card exiled this way, create a token that’s
    //        a copy of it"
    // Card: [[Foggy Swamp Visions]]
    "TokenCopyOfEachExiledCard({{CARDS_IN_EXILE}}, {{TOKEN_COPY_EFFECT_LIST}})": "",

    // Text: "Create a token that’s a copy of target creature card in your
    //        graveyard"
    // Card: [[Feldon of the Third Path]]
    "TokenCopyOfGraveyardCard({{CARD_IN_GRAVEYARDS}}, {{TOKEN_COPY_EFFECT_LIST}})": "",

    // Text: "Create a token that’s a copy of target creature card exiled
    //        with this artifact"
    // Card: [[Dino DNA]]
    "TokenCopyOfExiledCard({{CARD_IN_EXILE}}, {{TOKEN_COPY_EFFECT_LIST}})": "",

    // Text: "create a token that’s a copy of a card named Arrest"
    // Card: [[Peacekeeper Avatar]]
    "TokenCopyOfNamedCard({{QUOTED_NAMED_CARD}}, {{TOKEN_COPY_EFFECT_LIST}})": "",

    // Text: "Create a token that’s a copy of a random creature card with
    //        mana value X"
    // Card: [[Pool of Vigorous Growth]]
    "TokenCopyOfACardAtRandom({{CARDS_IN_ORACLE}})": "",
  },

