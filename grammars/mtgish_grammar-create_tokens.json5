{
  "{{TOKEN_COPY_EFFECT}}": {
    "AddSupertypes([{{SUPERTYPE}}])": "",
    "RemoveSupertypes([{{SUPERTYPE}}])": "",

    "AddCardtypes([Artifact, Creature])": "",
    "AddCardtypes([Artifact])": "",
    "AddCardtypes([Creature])": "",
    "AddCardtypes([Enchantment])": "",
    "SetCardtypes([Creature])": "",
    "SetCardtypes([Artifact])": "",
    "SetCardtypes([Enchantment])": "",
    "SetCardtypes([Enchantment, Creature])": "",

    "AddArtifactTypes([Food])": "",
    "SetArtifactTypes([Food])": "",
    "AddCreatureTypes([{{ZOMBIE}}])": "",
    "SetCreatureTypes([{{ZOMBIE}}])": "",

    "AddAbility([{{RULE}}])": "",
    "LosesAbility({{CHECK_HASABLE}})": "",
    "RemoveThisAbility": "",
    "AddAbilityFromEachExiledHasable({{CARDS_IN_EXILE}}, {{CHECK_HASABLE_LIST}})": "",

    "AddColor(SimpleColorList([{{SIMPLE_COLOR}}]))": "",
    "SetColor(SimpleColorList([{{SIMPLE_COLOR}}]))": "",
    "SetColor(SimpleColorList([{{SIMPLE_COLOR}}, {{SIMPLE_COLOR}}]))": "",
    "SetColor(Colorless)": "",

    "SetName({{QUOTED_NAMED_CARD}})": "",

    "SetPT({{PT}})": "",

    "SetLoyalty({{NUMBER}})": "",
  },

  "{{TOKEN_COPY_EFFECT_LIST}}": {
    "TokenCopyEffects([{{TOKEN_COPY_EFFECT}}, {{TOKEN_COPY_EFFECT}}, {{TOKEN_COPY_EFFECT}}, {{TOKEN_COPY_EFFECT}}, {{TOKEN_COPY_EFFECT}}, {{TOKEN_COPY_EFFECT}}])": "",
    "TokenCopyEffects([{{TOKEN_COPY_EFFECT}}, {{TOKEN_COPY_EFFECT}}, {{TOKEN_COPY_EFFECT}}, {{TOKEN_COPY_EFFECT}}, {{TOKEN_COPY_EFFECT}}])": "",
    "TokenCopyEffects([{{TOKEN_COPY_EFFECT}}, {{TOKEN_COPY_EFFECT}}, {{TOKEN_COPY_EFFECT}}, {{TOKEN_COPY_EFFECT}}])": "",
    "TokenCopyEffects([{{TOKEN_COPY_EFFECT}}, {{TOKEN_COPY_EFFECT}}, {{TOKEN_COPY_EFFECT}}])": "",
    "TokenCopyEffects([{{TOKEN_COPY_EFFECT}}, {{TOKEN_COPY_EFFECT}}])": "",
    "TokenCopyEffects([{{TOKEN_COPY_EFFECT}}])": "",
    "NoTokenCopyEffects": "",
  },

  "{{TOKEN_FLAGS}}": {
    "[EntersAttachedToAPermanent({{PERMANENTS}})]": "",
    "[EntersAttachedToPermanent({{PERMANENT}})]": "",
    "[EntersAttacking]": "",
    "[EntersBlockingAttacker({{PERMANENT}})]": "",
    "[EntersAttackingPlayer({{PLAYER}})]": "",
    "[EntersTapped, EntersAttackingPlayer({{PLAYER}})]": "",
    "[EntersTapped, EntersAttackingPlayerOrPlaneswalkerControlledBy({{PLAYER}})]": "",
    "[EntersTapped, EntersAttacking]": "",
    "[EntersTapped]": "",
    "[EntersWithACounter({{COUNTER_TYPE}})]": "",
    "[EntersWithNumberCounters({{NUMBER}}, {{COUNTER_TYPE}})]": "",
    "[EntersWithRuleEffectUntil({{PERMANENT_RULE_LIST}}, {{EXPIRATION}})]": "",
  },

  "{{CREATABLE_TOKEN}}": {
    "NumberTokens({{NUMBER}}, {{CREATABLE_TOKEN}})": "",
    "NumberTokensForEach({{NUMBER}}, {{NUMBER}}, {{CREATABLE_TOKEN}})": "",

    "TokenFromCopy": "",

    "TokenCopyOfDiscardedCard(Trigger_ThatDiscardedCard, {{TOKEN_COPY_EFFECT_LIST}})": "",

    "TokenCopyOfAPermanent({{PERMANENTS}}, {{TOKEN_COPY_EFFECT_LIST}})": "",
    "TokenCopyOfAnExiledCard({{CARDS_IN_EXILE}}, {{TOKEN_COPY_EFFECT_LIST}})": "",

    "TokenCopyOfAnEnteringPermanent({{PERMANENTS}}, {{TOKEN_COPY_EFFECT_LIST}})": "",
    "TokenCopyOfSpell({{SPELL}}, {{TOKEN_COPY_EFFECT_LIST}})": "",
    "TokenCopyOfEachCardOfTypeRevealedThisWay({{CARDS}}, {{TOKEN_COPY_EFFECT_LIST}})": "",
    "TokenCopyOfCommander({{TOKEN_COPY_EFFECT_LIST}})": "",
    "TokenCopyOfPermanent({{PERMANENT}}, {{TOKEN_COPY_EFFECT_LIST}})": "",
    "TokenCopyOfEachPermanent({{PERMANENTS}}, {{TOKEN_COPY_EFFECT_LIST}})": "",
    "TokenCopyOfEachGraveyardCard({{CARDS_IN_GRAVEYARDS}}, {{TOKEN_COPY_EFFECT_LIST}})": "",
    "TokenCopyOfEachExiledCard({{CARDS_IN_EXILE}}, {{TOKEN_COPY_EFFECT_LIST}})": "",
    "TokenCopyOfGraveyardCard({{CARD_IN_GRAVEYARDS}}, {{TOKEN_COPY_EFFECT_LIST}})": "",
    "TokenCopyOfExiledCard({{CARD_IN_EXILE}}, {{TOKEN_COPY_EFFECT_LIST}})": "",
    "TokenCopyOfEachPermanentDestroyedThisWay({{TOKEN_COPY_EFFECT_LIST}})": "",

    "TokenCopyOfNamedCard({{QUOTED_NAMED_CARD}}, {{TOKEN_COPY_EFFECT_LIST}})": "",
    "TokenCopyOfACardAtRandom({{CARDS_IN_ORACLE}})": "",

    // Defined Tokens (111.10)
    "TreasureToken": "",
    "FoodToken": "",
    "GoldToken": "",
    "WalkerToken": "",
    "ShardToken": "",
    "ClueToken": "",
    "BloodToken": "",
    "PowerstoneToken": "",
    // "IncubatorToken": "",
    "CursedRoleToken": "",
    "MonsterRoleToken": "",
    "RoyalRoleToken": "",
    "SorcererRoleToken": "",
    "VirtuousRoleToken": "",
    "WickedRoleToken": "",
    "YoungHeroRoleToken": "",
    "MapToken": "",
    "JunkToken": "",
    "LanderToken": "",
    "MutagenToken": "",
    "HeartwoodToken": "",

    // Oracle tokens (111.11)
    "OracleToken({{QUOTED_ORACLE_TOKEN}})": "",

    // Gift tokens (207.174)
    "FishToken": "",
    "OctopusToken": "",

    // Spoiler tokens
    "VibraniumToken": "",

    // Normal Tokens
    "Token({{COLOR_LIST}}, {{SUPERTYPE_LIST}}, {{CARDTYPE_LIST}}, {{TOKEN_SUBTYPES}}, {{RULES}})": "",
    "TokenWithPT({{PT}}, {{COLOR_LIST}}, {{SUPERTYPE_LIST}}, {{CARDTYPE_LIST}}, {{TOKEN_SUBTYPES}}, {{RULES}})": "",
    "NamedToken({{QUOTED_NAMED_CARD}}, {{COLOR_LIST}}, {{SUPERTYPE_LIST}}, {{CARDTYPE_LIST}}, {{TOKEN_SUBTYPES}}, {{RULES}})": "",
    "NamedTokenWithPT({{QUOTED_NAMED_CARD}}, {{PT}}, {{COLOR_LIST}}, {{SUPERTYPE_LIST}}, {{CARDTYPE_LIST}}, {{TOKEN_SUBTYPES}}, {{RULES}})": "",
    "NamedTokenWithPTAndWithCopyEffects({{QUOTED_NAMED_CARD}}, {{PT}}, {{COLOR_LIST}}, {{SUPERTYPE_LIST}}, {{CARDTYPE_LIST}}, {{TOKEN_SUBTYPES}}, {{RULES}}, {{TOKEN_COPY_EFFECT_LIST}})": "",
    "TransformingToken({{CREATABLE_TOKEN}}, {{CREATABLE_TOKEN}})": "",
  },

  "{{TOKEN_SUBTYPES}}": {
    "SubtypesList({{SUBTYPE_LIST}})": "",
    "TheChosenCreatureType": "",
    "AllBasicLandTypes": ""
  },

  "{{CREATABLE_TOKEN_LIST}}": {
    "[{{CREATABLE_TOKEN}}, {{CREATABLE_TOKEN}}, {{CREATABLE_TOKEN}}]": "",
    "[{{CREATABLE_TOKEN}}, {{CREATABLE_TOKEN}}]": "",
    "[{{CREATABLE_TOKEN}}]": "",
  },

  "{{_PLAYER_ACTION[CreateTokens]}}": {
    "CreateTokens({{CREATABLE_TOKEN_LIST}})": "",
    "CreateTokensWithFlags({{CREATABLE_TOKEN_LIST}}, {{TOKEN_FLAGS}})": "",
    "ForEachPlayerCreateTokens({{PLAYERS}}, {{CREATABLE_TOKEN_LIST}})": "",
    "ForEachPlayerCreateTokensWithFlags({{PLAYERS}}, {{CREATABLE_TOKEN_LIST}}, {{TOKEN_FLAGS}})": "",
    "ForEachPermanentCreateTokens({{PERMANENTS}}, {{CREATABLE_TOKEN_LIST}})": "",
    "ForEachPermanentCreateTokensWithFlags({{PERMANENTS}}, {{CREATABLE_TOKEN_LIST}}, {{TOKEN_FLAGS}})": "",
  },

  "{{_COST[CreateTokens]}}": {
    "CreateTokens({{CREATABLE_TOKEN_LIST}})": "",
    "CreateTokensWithFlags({{CREATABLE_TOKEN_LIST}}, {{TOKEN_FLAGS}})": "",

    "HaveAPlayerTakeAction({{PLAYERS}}, CreateTokens({{CREATABLE_TOKEN_LIST}}))": "",
    "HavePlayerTakeAction({{PLAYER}}, CreateTokens({{CREATABLE_TOKEN_LIST}}))": "",
  },

  // --------
  // Triggers
  // --------

  "{{_TRIGGER[CreateTokens]}}": {
    // Text: "Whenever you create a token, [...]"
    // Card: [[Rosie Cotton of South Lane]]
    "WhenAPlayerCreatesAToken({{PLAYERS}}, {{PERMANENTS}})": "",

    // Text: "Whenever you create one or more creature tokens, [...]"
    // Card: [[Staff of the Storyteller]]
    "WhenAPlayerCreatesAnyNumberOfTokens({{PLAYERS}}, {{PERMANENTS}})": "",

    // Text: "Whenever you create one or more tokens for the first time each turn, [...]"
    // Card: [[Akim, the Soaring Wind]]
    "WhenAPlayerCreatesAnyNumberOfTokensForTheFirstTimeEachTurn({{PLAYERS}}, {{PERMANENTS}})": ""
  },

  // -------
  // Filters
  // -------

  "{{_PLAYERS[CreateTokens]}}": {
    // Text: "Activate only if you created a token this turn"
    // Card: [[Idol of Oblivion]]
    "CreatedATokenThisTurn": "",
  },

  "{{_PERMANENTS[CreateTokens]}}": {
    // Text: "Exile all nontoken permanents."
    // Card: [[Thieves' Auction]]
    "IsNonToken": "",

    // Text: "As long as you control a token, ..."
    // Card: [[Druid of the Spade]]
    "IsToken": "",

    // Text: "Create two ... tokens. They gain .... Sacrifice them at the beginning of the next end step"
    // Card: [[Chandra, Acolyte of Flame]]
    "TheTokensCreatedThisWay": "",

    // Text: "Each player creates a ... token and puts a number of ... counters on it equal to ..."
    // Card: [[Oversimplify]]
    "TheTokensCreatedByAPlayerThisWay({{PLAYERS}})": "",

    // Text: "When the token leaves the battlefield, " / "exile the token"
    // Card: [[Dance of Many]]
    "TheCreatedTokens": "",
  },

  // ----------
  // Conditions
  // ----------

  "{{_CONDITION[CreateTokens]}}": {
    // Text: "If you created fewer than two tokens this way, ..."
    // Card: [[Your Own Face Mocks You]]
    "ANumberOfTokensWereCreatedThisWay({{COMPARISON}})": "",

    // Text: "If you didn't create a token this way, ..."
    // Card: [[Springheart Nantuko]]
    "ATokenWasCreatedThisWay": "",
  },

  // -------
  // Numbers
  // -------

  "{{_NUMBER[CreateTokens]}}": {
    // Text: "the number of Treasure tokens you created this turn"
    // Card: [[Vazi, Keen Negotiator]]
    "TheTotalNumberOfTokensPlayersCreatedThisTurn({{PERMANENTS}}, {{PLAYERS}})": "",

    // Text: "If you created fewer than two tokens this way, create a number of ... tokens ... equal to the difference."
    // Card: [[Your Own Face Mocks You]]
    "TheNumberOfTokensCreatedThisWay": "",

    // Text: "The first time you would create one or more tokens each turn, you may instead create that many ..."
    // Card: [[Moonlit Meditation]]
    "WouldCreateTokens_NumberTokens": "",
  },

  // -------------------
  // Replacement Effects
  // -------------------

  // Each token that would be created under an opponent's control this turn is created under your control instead
  "{{_PLAYER_ACTION[CreateTokens][TokensWouldBeCreatedUnderAPlayersControl]}}": {
    // Text: "each token that would be created under an opponent's control this turn is created under your control instead"
    // Card: [[Crafty Cutpurse]]
    "CreateReplaceTokensWouldBeCreatedUnderAPlayersControlUntil(TokensWouldBeCreatedUnderAPlayersControl({{PLAYERS}}), [CreateTokensUnderPlayersControlInstead([ThoseTokens], {{PLAYER}})], {{EXPIRATION}})": "",
  },

  // If you would create a Fish token, create {{a}} {{PT}} {{CreatureToken}} instead
  // If you would create a Shark token, create {{a}} {{PT}} {{CreatureToken}} instead
  // If you would create a Clue, Food, or Treasure token, instead create one of each
  "{{_STATIC_EFFECT[CreateTokens][APlayerWouldCreateAToken]}}": {
    // Text: "If you would create a Food token, instead create a Food token and a Treasure token"
    // Card: [[Bilbo, Fellow Conspirator]]
    // Text: "If you would create a Clue, Food, or Treasure token, instead create one of each."
    // Card: [[Academy Manufactor]]
    // Text: "If you would create a Fish token, create a 3/3 blue Shark creature token instead."
    // Card: [[Fisher's Talent]]
    // Text: "If you would create a Shark token, create an 8/8 blue Octopus creature token instead."
    // Card: [[Fisher's Talent]]
    "ReplaceAPlayerWouldCreateAToken(APlayerWouldCreateAToken({{PLAYERS}}, {{PERMANENTS}}), [CreateTokensInstead({{CREATABLE_TOKEN_LIST}})])": "",
  },

  // If you would create one or more Treasure tokens, instead create those tokens plus an additional Treasure token
  // If you would create one or more artifact tokens, instead create those tokens plus an additional Map token
  // If you would create one or more tokens, you may instead create that many {{PT}} {{CreatureTokens}} with {{Hasable}} or that many {{PT}} {{CreatureTokens}} with {{Hasable}}
  // The first time you would create one or more tokens during each of your turns, you may instead choose a creature other than {{~Permanent}} and create that many tokens that are copies of that creature
  "{{_STATIC_EFFECT[CreateTokens][APlayerWouldCreateTokens]}}": {
    // Text: "If you would create one or more tokens, instead create those tokens plus an additional Food token"
    // Card: [[Tippy-Toe, Terrific Partner]]
    // Text: "If you would create one or more Treasure tokens, instead create those tokens plus an additional Treasure token."
    // Card: [[Jolene, the Plunder Queen]], [[Xorn]]
    // Text: "If you would create one or more artifact tokens, instead create those tokens plus an additional Map token."
    // Card: [[Worldwalker Helm]]
    "ReplaceAPlayerWouldCreateTokens(APlayerWouldCreateTokens({{PLAYERS}}, {{PERMANENTS}}), [CreateTokensInstead([ThoseTokens, {{CREATABLE_TOKEN}}])])": "",

    // Text: "If you would create one or more tokens, you may instead create that many 2/2 green Cat creature tokens with haste or that many 3/1 green Dog creature tokens with vigilance."
    // Card: [[Jinnie Fay, Jetmir's Second]]
    "ReplaceAPlayerWouldCreateTokens(APlayerWouldCreateTokens({{PLAYERS}}, {{PERMANENTS}}), [ChooseAnAction([[CreateTokensInstead([{{CREATABLE_TOKEN}}])], [CreateTokensInstead([{{CREATABLE_TOKEN}}])], [CreateTokensInstead([ThoseTokens])]])])": "",

    // Text: "the first time you would create one or more tokens each turn, you may instead create that many tokens that are copies of equipped creature
    // Card: [[Mirrormind Crown]]
    // Text: "The first time you would create one or more tokens each turn, you may instead create that many tokens that are copies of enchanted permanent"
    // Card: [[Moonlit Meditation]]
    "ReplaceAPlayerWouldCreateTokens(APlayerWouldCreateTokensForTheFirstTimeEachTurn({{PLAYERS}}, {{PERMANENTS}}), [ChooseAnAction([[CreateTokensInstead([{{CREATABLE_TOKEN}}])], [CreateTokensInstead([ThoseTokens])]])])": "",

    // Text: "The first time you would create one or more tokens during each of your turns, you may instead choose a creature other than Esix and create that many tokens that are copies of that creature."
    // Card: [[Esix, Fractal Bloom]]
    "ReplaceAPlayerWouldCreateTokens(APlayerWouldCreateTokensForTheFirstTimeEachTurn({{PLAYERS}}, {{PERMANENTS}}), [MayCost(ChooseAPermanent({{PERMANENTS}})), IfElse(CostWasPaid, [CreateTokensInstead([{{CREATABLE_TOKEN}}])], [CreateTokensInstead([ThoseTokens])])])": "",
  },

  //                    If one or more          tokens would be created                   , twice that many of those tokens are created instead
  // Until end of turn, if one or more          tokens would be created under your control, twice that many of those tokens are created instead
  //                    If one or more          tokens would be created under your control, twice that many of those tokens are created instead
  //                    If one or more creature tokens would be created under your control, three times that many of those tokens are created instead
  //                    If one or more creature tokens would be created under your control, those tokens plus {{a}} {{PT}} {{CreatureToken}} are created instead
  //                    If one or more          tokens would be created under your control, those tokens plus an additional Food token are created instead
  //                    If one or more          tokens would be created under your control, those tokens plus that many {{PT}} {{CreatureTokens}} are created instead
  //                    If one or more          tokens would be created under your control, those tokens plus a Clue token are created instead
  //                    If one or more creature tokens would be created under your control, that many {{PT}} {{CreatureTokens}} with {{Hasable}} and {{Hasable}} are created instead
  "{{_STATIC_EFFECT[CreateTokens][AnyNumberOfTokensWouldBeCreated]}}": {
    // Text: "If one or more tokens would be created, twice that many of those tokens are created instead"
    // Card: [[Primal Vigor]]
    "ReplaceAnyNumberOfTokensWouldBeCreated(AnyNumberOfTokensWouldBeCreated({{PERMANENTS}}), [CreateTokensInstead([ThoseTokens, ThoseTokens])])": "",

    // Text: "If one or more tokens would be created under your control, twice that many of those tokens are created instead"
    // Card: [[Adrix and Nev, Twincasters]], [[Bard, King of Dale]], [[Elspeth, Storm Slayer]], [[Exalted Sunborn]], [[Mondrak, Glory Dominus]]
    "ReplaceAnyNumberOfTokensWouldBeCreated(AnyNumberOfTokensWouldBeCreatedUnderAPlayersControl({{PERMANENTS}}, {{PLAYERS}}), [CreateTokensInstead([ThoseTokens, ThoseTokens])])": "",

    // Text: "If one or more creature tokens would be created under your control, three times that many of those tokens are created instead"
    // Card: [[Ojer Taq, Deepest Foundation]]
    "ReplaceAnyNumberOfTokensWouldBeCreated(AnyNumberOfTokensWouldBeCreatedUnderAPlayersControl({{PERMANENTS}}, {{PLAYERS}}), [CreateTokensInstead([ThoseTokens, ThoseTokens, ThoseTokens])])": "",

    // Text: "If one or more tokens would be created under your control, those tokens plus a Clue token are created instead"
    // Card: [[Case of the Pilfered Proof]]
    // Text: "If one or more tokens would be created under your control, those tokens plus a Mutagen token are created instead"
    // Card: [[Donatello, the Brains]]
    // Text: "If one or more tokens would be created under your control, those tokens plus an additional Food token are created instead"
    // Card: [[Peregrin Took]]
    // Text: "If one or more creature tokens would be created under your control, those tokens plus a 1/1 white Soldier creature token are created instead"
    // Card: [[Queen Allenal of Ruadach]]
    // Text: "If one or more tokens would be created under your control, those tokens plus a 1/1 green Frog creature token are created instead"
    // Card: [[Quina, Qu Gourmet]]
    // Text: "If one or more artifact tokens would be created under your control, those tokens plus an additional 1/1 colorless Thopter artifact creature token with flying are created instead"
    // Card: [[Stridehangar Automaton]]
    "ReplaceAnyNumberOfTokensWouldBeCreated(AnyNumberOfTokensWouldBeCreatedUnderAPlayersControl({{PERMANENTS}}, {{PLAYERS}}), [CreateTokensInstead([ThoseTokens, {{CREATABLE_TOKEN}}])])": "",

    // Text: "If one or more tokens would be created under your control, those tokens plus that many 1/1 green Squirrel creature tokens are created instead"
    // Card: [[Chatterfang, Squirrel General]]
    // Text: "If one or more creature tokens would be created under your control, that many 4/4 white Angel creature tokens with flying and vigilance are created instead"
    // Card: [[Divine Visitation]]
    "ReplaceAnyNumberOfTokensWouldBeCreated(AnyNumberOfTokensWouldBeCreatedUnderAPlayersControl({{PERMANENTS}}, {{PLAYERS}}), [CreateTokensInstead({{CREATABLE_TOKEN_LIST}})])": "",

  },
  "{{_PLAYER_ACTION[CreateTokens][AnyNumberOfTokensWouldBeCreated]}}": {
    // Text: "Until end of turn, if one or more tokens would be created under your control, twice that many of those tokens are created instead."
    // Card: [[Kaya, Geist Hunter]]
    "CreateReplaceAnyNumberOfTokensWouldBeCreatedUntil(AnyNumberOfTokensWouldBeCreatedUnderAPlayersControl({{PERMANENTS}}, {{PLAYERS}}), [CreateTokensInstead([ThoseTokens, ThoseTokens])], {{EXPIRATION}})": "",
  },

  // If an effect would create one or more tokens under your control, it creates twice that many of those tokens instead
  // If an effect would create one or more tokens                   , it creates twice that many of those tokens instead
  "{{_STATIC_EFFECT[CreateTokens][AnEffectWouldCreateAnyNumberOfTokens]}}": {
    // Text: "If an effect would create one or more tokens under your control, it creates twice that many of those tokens instead"
    // Card: [[Anointed Procession]], [[Doubling Season]], [[Parallel Lives]]
    "ReplaceAnEffectWouldCreateAnyNumberOfTokens(AnEffectWouldCreateAnyNumberOfTokensUnderAPlayersControl({{PERMANENTS}}, {{PLAYERS}}), [CreateTokensInstead([ThoseTokens, ThoseTokens])])": "",

    // Text: "If an effect would create one or more tokens, it creates twice that many of those tokens instead"
    // Card: [[Selesnya Loft Gardens]]
    "ReplaceAnEffectWouldCreateAnyNumberOfTokens(AnEffectWouldCreateAnyNumberOfTokens({{PERMANENTS}}), [CreateTokensInstead([ThoseTokens, ThoseTokens])])": "",
  },
}
